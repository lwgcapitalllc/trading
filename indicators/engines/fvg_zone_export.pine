// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/ MPL-2.0
//@version=6
// ============================================================================
//  FVG ZONE EXPORT — parity harness for the FVG cap's ENTRY-BAND exemption
// ============================================================================
// 🔴 WHY THIS FILE IS SEPARATE FROM fvg_export.pine, AND WHY IT IS SO LARGE.
// The entry-band exemption cannot be tested by fvg_export.pine, and not for want of trying: the
// band is not an input, it is the live fib's 0.382-0.886 recomputed every bar from the current
// leg. Reproducing it needs the market-structure engine AND the Structure fib in the same script.
// So this harness carries all four blocks — structure, fib, EQ, FVG — because that is what the
// coupling is.
//
// It is a SECOND file rather than an extension of fvg_export.pine for two reasons, both measured:
//   1. fib_export.pine already uses 63 of TradingView's 64 plot slots, so the FVG columns cannot
//      go there. That direction is closed, not merely unattractive.
//   2. fvg_export.pine gates what every CONSUMER of the engine actually runs today — a plain FVG
//      engine with no band — and its golden export regression-tests exactly that. Folding 1,100
//      lines of structure into it would make the cheap, universal gate depend on the fib. The
//      pattern here is the one eq_export.pine/fvg_export.pine already set: one harness for the
//      engine alone, a second for the coupling.
//
// ⚠ THE COST IS A TENTH PINE COPY OF THE FVG BLOCK, and it is stated rather than hidden.
//    scripts/check_pine_blocks.py is what stops it drifting; if you change an FVG rule anywhere,
//    that step is the thing that tells you which of the ten files you missed.
//
// COMPOSITION — every block is byte-lifted, never retyped:
//   1. Market structure, external + internal .... from fib_export.pine (which took it from
//      structure_engine_export.pine). Validated at 100% Python parity in its own gate.
//   2. EQ + FVG detection / cap / mitigate ...... from fvg_export.pine, unchanged apart from the
//      band exemption composed into the two cap loops.
//   3. The Structure fib ........................ from fib_export.pine, plus the band publish
//      copied from mpc_jarvis.pine:4896-4907.
//
// 🔴 BLOCK ORDER IS THE POINT AND MUST NOT BE "TIDIED". The FVG block sits BEFORE the fib block,
//    exactly as it does in mpc_jarvis.pine (~3830 vs ~4810). That is what gives the cap last bar's
//    band, which is mpc's deliberate behaviour. Moving the fib above the FVG would produce a
//    harness that is self-consistent, green, and describing an indicator nobody runs.
//
// Diffed by engines/fair_value_gaps/tools/compare_fvg.py. Export above the 1-minute timeframe
// (see the publish site for why). Do NOT trade off this file.
// ============================================================================
indicator("FVG Zone Export", overlay = false, max_bars_back = 2000, max_labels_count = 500, max_lines_count = 500)

//  SMC SETTINGS (hardcoded)
//============================================================
int   majorLength = 15
color bullColor   = color.blue
color bearColor   = color.red
color iBullColor  = bullColor
color iBearColor  = bearColor

//============================================================
//  MARKET STRUCTURE LABEL SIZE
//============================================================
var GRP_STRUCT = "Market Structure"
string structLabelSize  = input.string("Small", "Structure Label Size",    group = GRP_STRUCT, options = ["Tiny", "Small", "Normal", "Large", "Huge"], display = display.none)
bool   showInternal     = input.bool(true,      "Show Internal Structure", group = GRP_STRUCT, display = display.none)
float  pbBuffer         = 0.0

f_structSize() =>
    structLabelSize == "Tiny" ? size.tiny : structLabelSize == "Normal" ? size.normal : structLabelSize == "Large" ? size.large : structLabelSize == "Huge" ? size.huge : size.small

//============================================================
//  SMC STRUCTURE TYPE
//============================================================
type SMCStructure
    int    length
    float  ash             = na
    int    ash_loc         = na
    string ash_type        = ""
    line   ash_line        = na
    label  ash_lbl         = na
    float  asl             = na
    int    asl_loc         = na
    string asl_type        = ""
    line   asl_line        = na
    label  asl_lbl         = na
    float  last_conf_high     = na
    int    last_conf_high_loc = na
    float  last_conf_low      = na
    int    last_conf_low_loc  = na
    int    dir            = 0
    bool   choch_lock     = false
    line   choch_ref      = na
    int    pb_mode        = 0
    int    pb_count       = 0
    float  pb_level       = na
    float  pb_extreme     = na
    int    pb_extreme_loc = na
    line   pb_line        = na
    bool   pb_started     = false
    float  pb_last_qualify_close = na
    float  pb_last_qualify_high  = na
    float  pb_extreme_close      = na
    float  prev_close     = na
    float  prev_high      = na
    float  prev_low       = na
    bool   seeded         = false
    bool   bull_bos       = false
    float  bull_bos_high  = na
    int    bull_bos_h_loc = na
    float  bull_bos_low   = na
    int    bull_bos_l_loc = na
    bool   bear_bos       = false
    float  bear_bos_high  = na
    int    bear_bos_h_loc = na
    float  bear_bos_low   = na
    int    bear_bos_l_loc = na
    bool   new_swing_high = false
    bool   new_swing_low  = false
    bool   bull_sos       = false
    bool   bear_sos       = false

// prefix: "" for external, "i" for internal
// bull_col / bear_col allow per-instance colors
method create_ash(SMCStructure st, float val, int loc, color col, bool solid, string prefix) =>
    if not na(st.ash_line)
        line.delete(st.ash_line)
    if not na(st.ash_lbl)
        label.delete(st.ash_lbl)
        st.ash_lbl := na
    st.ash      := val
    st.ash_loc  := loc
    st.ash_type := ""
    st.ash_lbl  := label.new(loc, val, prefix + "ASH\n", color=color(na), textcolor=col, style=label.style_label_down, size=f_structSize())
    st.ash_line := line.new(loc, val, bar_index, val, color=col, style=solid ? line.style_solid : line.style_dashed, width=solid ? 2 : 1)

method create_asl(SMCStructure st, float val, int loc, color col, bool solid, string prefix) =>
    if not na(st.asl_line)
        line.delete(st.asl_line)
    if not na(st.asl_lbl)
        label.delete(st.asl_lbl)
        st.asl_lbl := na
    st.asl      := val
    st.asl_loc  := loc
    st.asl_type := ""
    st.asl_lbl  := label.new(loc, val, "\n" + prefix + "ASL", color=color(na), textcolor=col, style=label.style_label_up, size=f_structSize())
    st.asl_line := line.new(loc, val, bar_index, val, color=col, style=solid ? line.style_solid : line.style_dashed, width=solid ? 2 : 1)

// process() now accepts prefix + bull/bear colors so both instances share one method
method process(SMCStructure st, float ph_val, float pl_val, string prefix, color bull_col, color bear_col) =>

    st.bull_bos := false
    st.bear_bos := false
    st.new_swing_high := false
    st.new_swing_low  := false
    st.bull_sos := false
    st.bear_sos := false

    bool is_inside = false
    if not na(st.prev_high) and not na(st.prev_low)
        is_inside := high < st.prev_high and low > st.prev_low

    if st.choch_lock
        if st.dir == 1 and not na(pl_val)
            st.choch_lock := false
        else if st.dir == -1 and not na(ph_val)
            st.choch_lock := false

    if st.pb_mode == 1
        if not st.pb_started
            st.pb_started            := true
            st.pb_extreme            := high
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_count              := 0
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
        else
            bool extreme_updated_1 = false
            if na(st.pb_extreme) or high > st.pb_extreme
                st.pb_extreme            := high
                st.pb_extreme_loc        := bar_index
                st.pb_extreme_close      := na
                st.pb_count              := 0
                st.pb_last_qualify_close := na
                st.pb_last_qualify_high  := na
                extreme_updated_1        := true
            bool extreme_is_bearish_1 = extreme_updated_1 and close < open
            bool is_candle1_1 = na(st.pb_last_qualify_close) and not extreme_updated_1
            if (not is_inside or is_candle1_1) and (not extreme_updated_1 or extreme_is_bearish_1)
                float threshold = na(st.pb_last_qualify_high) ? st.pb_extreme : st.pb_last_qualify_high
                if close < threshold - pbBuffer
                    st.pb_count              += 1
                    st.pb_last_qualify_close := close
                    st.pb_last_qualify_high  := low
            if st.pb_count >= 3 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
                if not na(st.ash_line)
                    line.delete(st.ash_line)
                if not na(st.ash_lbl)
                    label.delete(st.ash_lbl)
                st.ash      := st.pb_extreme
                st.ash_loc  := st.pb_extreme_loc
                st.ash_type := "LOCKED"
                st.ash_line := line.new(st.pb_extreme_loc, st.pb_extreme, bar_index, st.pb_extreme, color=bear_col, style=line.style_solid, width=1)
                st.ash_lbl  := label.new(st.pb_extreme_loc, st.pb_extreme, prefix + "ASH\n", color=color(na), textcolor=bear_col, style=label.style_label_down, size=f_structSize())
                st.new_swing_high := true
                st.pb_mode    := 0
                st.pb_count   := 0
                st.choch_lock := false

    else if st.pb_mode == -1
        if not st.pb_started
            st.pb_started            := true
            st.pb_extreme            := low
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_count              := 0
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
        else
            bool extreme_updated_m1 = false
            if na(st.pb_extreme) or low < st.pb_extreme
                st.pb_extreme            := low
                st.pb_extreme_loc        := bar_index
                st.pb_extreme_close      := na
                st.pb_count              := 0
                st.pb_last_qualify_close := na
                st.pb_last_qualify_high  := na
                extreme_updated_m1       := true
            bool extreme_is_bullish_m1 = extreme_updated_m1 and close > open
            bool is_candle1_m1 = na(st.pb_last_qualify_close) and not extreme_updated_m1
            if (not is_inside or is_candle1_m1) and (not extreme_updated_m1 or extreme_is_bullish_m1)
                float threshold = na(st.pb_last_qualify_high) ? st.pb_extreme : st.pb_last_qualify_high
                if close > threshold + pbBuffer
                    st.pb_count              += 1
                    st.pb_last_qualify_close := close
                    st.pb_last_qualify_high  := high
            if st.pb_count >= 3 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
                if not na(st.asl_line)
                    line.delete(st.asl_line)
                if not na(st.asl_lbl)
                    label.delete(st.asl_lbl)
                st.asl      := st.pb_extreme
                st.asl_loc  := st.pb_extreme_loc
                st.asl_type := "LOCKED"
                st.asl_line := line.new(st.pb_extreme_loc, st.pb_extreme, bar_index, st.pb_extreme, color=bull_col, style=line.style_solid, width=1)
                st.asl_lbl  := label.new(st.pb_extreme_loc, st.pb_extreme, "\n" + prefix + "ASL", color=color(na), textcolor=bull_col, style=label.style_label_up, size=f_structSize())
                st.new_swing_low := true
                st.pb_mode    := 0
                st.pb_count   := 0
                st.choch_lock := false

    st.prev_close := close
    st.prev_high  := high
    st.prev_low   := low

    if na(st.ash) and na(st.asl) and not st.seeded
        if not na(ph_val)
            st.create_ash(ph_val, bar_index[st.length], bear_col, false, prefix)
            st.dir := -1
        else if not na(pl_val)
            st.create_asl(pl_val, bar_index[st.length], bull_col, false, prefix)
            st.dir := 1

    if not st.seeded
        if not na(st.ash) and na(st.asl)
            float seed_low = low
            int   seed_loc = bar_index
            int   lb       = math.min(bar_index, 500)
            for i = 0 to lb
                if low[i] < seed_low
                    seed_low := low[i]
                    seed_loc := bar_index - i
            if seed_low < st.ash
                st.asl      := seed_low
                st.asl_loc  := seed_loc
                st.asl_type := ""
                st.asl_line := line.new(seed_loc, seed_low, bar_index, seed_low, color=bull_col, style=line.style_dashed, width=1)
                st.asl_lbl  := label.new(seed_loc, seed_low, "\n" + prefix + "ASL", color=color(na), textcolor=bull_col, style=label.style_label_up, size=f_structSize())
                st.seeded := true
        else if not na(st.asl) and na(st.ash)
            float seed_high = high
            int   seed_loc  = bar_index
            int   lb        = math.min(bar_index, 500)
            for i = 0 to lb
                if high[i] > seed_high
                    seed_high := high[i]
                    seed_loc  := bar_index - i
            if seed_high > st.asl
                st.ash      := seed_high
                st.ash_loc  := seed_loc
                st.ash_type := ""
                st.ash_line := line.new(seed_loc, seed_high, bar_index, seed_high, color=bear_col, style=line.style_dashed, width=1)
                st.ash_lbl  := label.new(seed_loc, seed_high, prefix + "ASH\n", color=color(na), textcolor=bear_col, style=label.style_label_down, size=f_structSize())
                st.seeded := true
        else if not na(st.ash) and not na(st.asl)
            st.seeded := true

    if na(st.last_conf_high) and na(st.last_conf_low)
        if not na(ph_val) and not na(st.ash) and st.ash_type == "" and st.pb_mode == 0
            if ph_val > st.ash
                st.create_ash(ph_val, bar_index[st.length], bear_col, false, prefix)
        if not na(pl_val) and not na(st.asl) and st.asl_type == "" and st.pb_mode == 0
            if pl_val < st.asl
                st.create_asl(pl_val, bar_index[st.length], bull_col, false, prefix)

    bool ash_broken = not na(st.ash) and close > st.ash
    bool asl_broken = not na(st.asl) and close < st.asl

    if ash_broken
        st.bull_bos := true
        st.bull_bos_high  := st.ash
        st.bull_bos_h_loc := st.ash_loc

        bool was_in_bear_pb = st.pb_mode == -1 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
        st.pb_mode  := 0
        st.pb_count := 0

        bool   is_choch    = st.dir == -1
        string brk_lbl_txt = is_choch ? prefix + "SOS" : prefix + "BOS"
        if is_choch
            st.bull_sos := true
        int    mid_x       = math.round((st.ash_loc + bar_index) / 2)
        label.new(mid_x, st.ash, "\n" + brk_lbl_txt, color=color(na), textcolor=bull_col, style=label.style_label_down, size=size.tiny)

        if is_choch
            st.choch_lock := true

        bool brk_already_conf_high = (st.ash == st.last_conf_high and st.ash_loc == st.last_conf_high_loc)
        if not na(st.ash_lbl)
            label.delete(st.ash_lbl)
        if not brk_already_conf_high
            bool   brk_is_hh  = na(st.last_conf_high) or st.ash >= st.last_conf_high
            string brk_high_t = brk_is_hh ? prefix + "HH" : prefix + "LH"
            color  brk_high_c = brk_is_hh ? bull_col : bear_col
            label.new(st.ash_loc, st.ash, brk_high_t + "\n", color=color(na), textcolor=brk_high_c, style=label.style_label_down, size=f_structSize())

        if not na(st.ash_line)
            line.set_style(st.ash_line, line.style_solid)
            line.set_color(st.ash_line, bull_col)
            line.set_width(st.ash_line, 2)
            line.set_x2(st.ash_line, bar_index)
            st.ash_line := na

        st.last_conf_high     := st.ash
        st.last_conf_high_loc := st.ash_loc
        st.ash_lbl            := na
        st.ash                := na
        st.dir                := 1

        if was_in_bear_pb
            st.bull_bos_low   := st.pb_extreme
            st.bull_bos_l_loc := st.pb_extreme_loc
            if not na(st.asl_line)
                line.delete(st.asl_line)
            if not na(st.asl_lbl)
                label.delete(st.asl_lbl)
            bool   pb_is_hl = is_choch ? false : (na(st.last_conf_low) or st.pb_extreme >= st.last_conf_low)
            // On an SOS (fast reversal) the extreme is only the ACTIVE swing low —
            // it prints as ASL and is confirmed to HL/LL by the NEXT bullish break.
            string pb_low_t = is_choch ? prefix + "ASL" : (pb_is_hl ? prefix + "HL" : prefix + "LL")
            color  pb_low_c = is_choch ? bull_col : (pb_is_hl ? bull_col : bear_col)
            st.asl      := st.pb_extreme
            st.asl_loc  := st.pb_extreme_loc
            st.asl_type := "LOCKED"
            st.asl_line := line.new(st.pb_extreme_loc, st.pb_extreme, bar_index, st.pb_extreme, color=bull_col, style=line.style_solid, width=1)
            st.asl_lbl  := label.new(st.pb_extreme_loc, st.pb_extreme, "\n" + pb_low_t, color=color(na), textcolor=pb_low_c, style=label.style_label_up, size=f_structSize())
            if not is_choch
                st.last_conf_low     := st.pb_extreme
                st.last_conf_low_loc := st.pb_extreme_loc
            st.pb_extreme            := high
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_mode               := 1
            st.pb_started            := true
        else
            if not na(st.asl)
                bool already_conf_low = (st.asl == st.last_conf_low and st.asl_loc == st.last_conf_low_loc)
                if not already_conf_low
                    bool   old_is_hl = is_choch ? false : (na(st.last_conf_low) or st.asl >= st.last_conf_low)
                    string old_low_t = old_is_hl ? prefix + "HL" : prefix + "LL"
                    color  old_low_c = old_is_hl ? bull_col : bear_col
                    if not na(st.asl_lbl)
                        label.delete(st.asl_lbl)
                    label.new(st.asl_loc, st.asl, "\n" + old_low_t, color=color(na), textcolor=old_low_c, style=label.style_label_up, size=f_structSize())
                    st.last_conf_low     := st.asl
                    st.last_conf_low_loc := st.asl_loc
                else
                    if not na(st.asl_lbl)
                        label.delete(st.asl_lbl)
                if not na(st.asl_line)
                    line.delete(st.asl_line)
                st.asl_line := na
                st.asl_lbl  := na
                st.asl      := na

            float lowest_val = low
            int   lowest_loc = bar_index
            int   bars_back  = na(st.last_conf_high_loc) ? bar_index : bar_index - st.last_conf_high_loc
            if bars_back > 0
                int max_lb = math.min(math.min(bars_back, 1490), bar_index)
                for i = 0 to max_lb
                    if low[i] < lowest_val
                        lowest_val := low[i]
                        lowest_loc := bar_index - i

            // 🔴 KEEP THE ORIGINAL ANCHOR WHEN TWO BARS TIE FOR THE LOW. The scan above runs
            // newest-to-oldest with a strict `<`, so on an identical low it lands on the LATER bar
            // while this swing's label is already anchored on the EARLIER one — `already_conf_low`
            // compares bar index as well as price, misses, and a SECOND label is drawn at the same
            // price. Pine never deletes those, so they stack (the LL beside an HL, 2026-08-20).
            // Full story + measurements: engines/market_structure/CLAUDE.md -> tied-extreme fix.
            // 🔴 …AND THE SAME SNAP WHEN IT IS MORE EXTREME BUT NOT NEWER — A REFUSED WICK
            // (2026-08-21). Structure BREAKS ON A CLOSE, but this scan reads the raw `low` over a
            // window bounded by `last_conf_high_loc` — the OPPOSITE side — which reaches back BEFORE
            // the swing just confirmed. So it can resurrect a bar that pierced the level, closed back
            // inside and was correctly refused, and install it as the new active swing: EARLIER than
            // and LOWER than the swing just labelled. Full mechanism + the measurements:
            // `indicators/engines/mpc_jarvis.pine`, same block.
            if not na(st.last_conf_low_loc) and (lowest_val == st.last_conf_low or (lowest_val < st.last_conf_low and lowest_loc <= st.last_conf_low_loc))
                lowest_val := st.last_conf_low
                lowest_loc := st.last_conf_low_loc
            st.bull_bos_low   := lowest_val
            st.bull_bos_l_loc := lowest_loc

            st.asl      := lowest_val
            st.asl_loc  := lowest_loc
            st.asl_type := ""
            st.asl_line := line.new(lowest_loc, lowest_val, bar_index, lowest_val, color=bull_col, style=line.style_solid, width=1)
            if lowest_val != st.last_conf_low
                st.asl_lbl := label.new(lowest_loc, lowest_val, "\n" + prefix + "ASL", color=color(na), textcolor=bull_col, style=label.style_label_up, size=f_structSize())
            else
                st.asl_lbl := na

            st.pb_mode               := 1
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_extreme            := high
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true

    else if asl_broken
        st.bear_bos := true
        st.bear_bos_low   := st.asl
        st.bear_bos_l_loc := st.asl_loc

        bool was_in_bull_pb = st.pb_mode == 1 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
        st.pb_mode  := 0
        st.pb_count := 0

        bool   is_choch    = st.dir == 1
        string brk_lbl_txt = is_choch ? prefix + "SOS" : prefix + "BOS"
        if is_choch
            st.bear_sos := true
        int    mid_x       = math.round((st.asl_loc + bar_index) / 2)
        label.new(mid_x, st.asl, brk_lbl_txt + "\n", color=color(na), textcolor=bear_col, style=label.style_label_up, size=size.tiny)

        if is_choch
            st.choch_lock := true

        bool brk_already_conf_low = (st.asl == st.last_conf_low and st.asl_loc == st.last_conf_low_loc)
        if not na(st.asl_lbl)
            label.delete(st.asl_lbl)
        if not brk_already_conf_low
            bool   brk_is_hl = na(st.last_conf_low) or st.asl >= st.last_conf_low
            string brk_low_t = brk_is_hl ? prefix + "HL" : prefix + "LL"
            label.new(st.asl_loc, st.asl, "\n" + brk_low_t, color=color(na), textcolor=bear_col, style=label.style_label_up, size=f_structSize())

        if not na(st.asl_line)
            line.set_style(st.asl_line, line.style_solid)
            line.set_color(st.asl_line, bear_col)
            line.set_width(st.asl_line, 2)
            line.set_x2(st.asl_line, bar_index)
            st.asl_line := na

        st.last_conf_low     := st.asl
        st.last_conf_low_loc := st.asl_loc
        st.asl_lbl           := na
        st.asl               := na
        st.dir               := -1

        if was_in_bull_pb
            st.bear_bos_high  := st.pb_extreme
            st.bear_bos_h_loc := st.pb_extreme_loc
            if not na(st.ash_line)
                line.delete(st.ash_line)
            if not na(st.ash_lbl)
                label.delete(st.ash_lbl)
            bool   pb_is_hh  = na(st.last_conf_high) or st.pb_extreme >= st.last_conf_high
            // On an SOS (fast reversal) the extreme is only the ACTIVE swing high —
            // it prints as ASH and is confirmed to HH/LH by the NEXT bearish break.
            string pb_high_t = is_choch ? prefix + "ASH" : (pb_is_hh ? prefix + "HH" : prefix + "LH")
            color  pb_high_c = is_choch ? bear_col : (pb_is_hh ? bull_col : bear_col)
            st.ash      := st.pb_extreme
            st.ash_loc  := st.pb_extreme_loc
            st.ash_type := "LOCKED"
            st.ash_line := line.new(st.pb_extreme_loc, st.pb_extreme, bar_index, st.pb_extreme, color=bear_col, style=line.style_solid, width=1)
            st.ash_lbl  := label.new(st.pb_extreme_loc, st.pb_extreme, pb_high_t + "\n", color=color(na), textcolor=pb_high_c, style=label.style_label_down, size=f_structSize())
            if not is_choch
                st.last_conf_high     := st.pb_extreme
                st.last_conf_high_loc := st.pb_extreme_loc
            st.pb_extreme            := low
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_mode               := -1
            st.pb_started            := true
        else
            float highest_val = high
            int   highest_loc = bar_index
            int   bars_back   = na(st.last_conf_low_loc) ? bar_index : bar_index - st.last_conf_low_loc
            if bars_back > 0
                int max_lb = math.min(math.min(bars_back, 1490), bar_index)
                for i = 0 to max_lb
                    if high[i] > highest_val
                        highest_val := high[i]
                        highest_loc := bar_index - i

            if not na(st.ash)
                bool already_conf_high = (st.ash == st.last_conf_high and st.ash_loc == st.last_conf_high_loc)
                if not already_conf_high
                    bool   old_is_hh  = is_choch ? true : (na(st.last_conf_high) or st.ash >= st.last_conf_high)
                    string old_high_t = old_is_hh ? prefix + "HH" : prefix + "LH"
                    color  old_high_c = old_is_hh ? bull_col : bear_col
                    if not na(st.ash_lbl)
                        label.delete(st.ash_lbl)
                    label.new(st.ash_loc, st.ash, old_high_t + "\n", color=color(na), textcolor=old_high_c, style=label.style_label_down, size=f_structSize())
                    st.last_conf_high     := st.ash
                    st.last_conf_high_loc := st.ash_loc
                else
                    if not na(st.ash_lbl)
                        label.delete(st.ash_lbl)
                if not na(st.ash_line)
                    line.delete(st.ash_line)
                st.ash_line := na
                st.ash_lbl  := na
                st.ash      := na
            else
                // Neither an active pullback high nor a confirmed ASH was available to
                // promote — use the actual highest point since the last confirmed low so
                // a genuine swing high still gets confirmed instead of silently vanishing.
                bool   fallback_is_hh  = na(st.last_conf_high) or highest_val >= st.last_conf_high
                string fallback_high_t = fallback_is_hh ? prefix + "HH" : prefix + "LH"
                color  fallback_high_c = fallback_is_hh ? bull_col : bear_col
                if highest_val != st.last_conf_high
                    label.new(highest_loc, highest_val, fallback_high_t + "\n", color=color(na), textcolor=fallback_high_c, style=label.style_label_down, size=f_structSize())
                    st.last_conf_high     := highest_val
                    st.last_conf_high_loc := highest_loc

            // 🔴 Mirror of the low-side tie guard above. This side stacks HH on HH rather than LL on
            // HL, which is why it went unnoticed far longer despite being the MORE common of the two.
            // ⚠ IT MUST SIT HERE, AFTER THE PROMOTION, NOT BESIDE THE SCAN — placed by the scan it
            // reads a `last_conf_high` the promotion has not written yet and silently does nothing.
            // 🔴 Mirror of the low side's refused-wick snap (2026-08-21) — see the note there.
            // This side is the `ASH` printed beside an `HH`, and the bogus `HH` that follows once
            // that ASH is broken. Must stay AFTER the promotion, same as the tie guard it replaces.
            if not na(st.last_conf_high_loc) and (highest_val == st.last_conf_high or (highest_val > st.last_conf_high and highest_loc <= st.last_conf_high_loc))
                highest_val := st.last_conf_high
                highest_loc := st.last_conf_high_loc
            st.bear_bos_high  := highest_val
            st.bear_bos_h_loc := highest_loc

            st.ash      := highest_val
            st.ash_loc  := highest_loc
            st.ash_type := ""
            st.ash_line := line.new(highest_loc, highest_val, bar_index, highest_val, color=bear_col, style=line.style_solid, width=1)
            if highest_val != st.last_conf_high
                st.ash_lbl := label.new(highest_loc, highest_val, prefix + "ASH\n", color=color(na), textcolor=bear_col, style=label.style_label_down, size=f_structSize())
            else
                st.ash_lbl := na

            st.pb_mode               := -1
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_extreme            := low
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true

    if not na(st.ash_line)
        line.set_x2(st.ash_line, bar_index)
    if not na(st.asl_line)
        line.set_x2(st.asl_line, bar_index)

//============================================================
//  EXECUTION — EXTERNAL STRUCTURE
//============================================================
// External structure — majorLength=15, blue/red, prefix ""
var st = SMCStructure.new(majorLength)
ph = ta.pivothigh(high, majorLength, majorLength)
pl = ta.pivotlow(low,  majorLength, majorLength)
st.process(ph, pl, "", bullColor, bearColor)

//============================================================
//  EXECUTION — INTERNAL STRUCTURE
//  Lifted from structure_engine_export.pine (byte-identical, validated internal detection) PLUS
//  the two mpc_jarvis.pine capture additions the Internal fib needs: i_confirmed_high/low_*
//  (at each iSH/iSL confirm) and the iFib_* seed anchors (at each of the six iBOS/iSOS sites).
//  Detection logic is unchanged — only the capture lines and iFib state vars are added.
//============================================================
bool showIFib = true

// ── State ─────────────────────────────────────────────────
var int   i_mode           = 0
var bool  i_seeded         = false

var float i_pb_extreme     = na
var int   i_pb_extreme_loc = na
var int   i_pb_count       = 0
var bool  i_pb_started     = false
var float i_pb_lqc         = na
var float i_pb_lqh         = na
var float i_prev_high      = na
var float i_prev_low       = na

var float i_sw_price       = na
var int   i_sw_loc         = na
var line  i_sw_line        = na
var label i_sw_lbl         = na

var bool  i_ext_chg        = false
var bool  i_is_inside      = false
var bool  i_ext_dir        = false
var bool  i_is_c1          = false
var float i_thresh         = na

var float i_tracked_ext     = na
var int   i_tracked_ext_loc = na
var int   i_last_mode       = 0
var bool  i_had_bos         = false
var int   i_bos_dir         = 0
var string i_h_lbl          = ""
var color  i_h_col          = color.black
var string i_l_lbl          = ""
var color  i_l_col          = color.black
var int   i_mid             = 0
var int   i_mid2            = 0
var float i_last_hl         = na
var float i_last_lh         = na
var int   i_last_hl_loc     = na
var int   i_last_lh_loc     = na

var float i_sos_watch_hh    = na
var int   i_sos_watch_hh_loc= na
var float i_sos_watch_ll    = na
var int   i_sos_watch_ll_loc= na

float i_lbl_y_offset = syminfo.mintick * 100

// ── iFib state (mpc_jarvis.pine) — confirmed-internal-swing anchors + the internal fib itself ──
var float i_confirmed_low_price  = na
var int   i_confirmed_low_loc    = na
var float i_confirmed_high_price = na
var int   i_confirmed_high_loc   = na

var float iFib_asl     = na
var int   iFib_asl_loc = na
var float iFib_ash     = na
var int   iFib_ash_loc = na
var int   iFib_dir     = 0
var bool iFib0Touched     = false
var bool iFib382Touched   = false
var bool iFib50Touched    = false
var bool iFib618Touched   = false
var bool iFib702Touched   = false
var bool iFib786Touched   = false
var bool iFib886Touched   = false
var bool iFib100Touched   = false
var bool iFib618EverReached = false
var float iFib_tp3_hit_price = na
var bool  iFibResetActive    = false
var float iFibPrevAsh = na   // last bar's anchors — the extend-changed guard (mpc 2705)
var float iFibPrevAsl = na

// ── Stop internal tracking on external BOS/SOS ───────────
if showInternal and (st.bull_bos or st.bear_bos or st.bull_sos or st.bear_sos)
    if not na(i_sw_line)
        line.set_x2(i_sw_line, bar_index)
        i_sw_line := na
    i_sw_lbl          := na
    i_sw_price        := na
    i_mode            := 0
    i_seeded          := false
    i_pb_count        := 0
    i_pb_started      := false
    i_tracked_ext     := na
    i_tracked_ext_loc := na
    i_last_hl         := na
    i_last_lh         := na
    i_had_bos         := false
    i_sos_watch_hh    := na
    i_sos_watch_ll    := na

// ── Track prev bar ────────────────────────────────────────
if showInternal
    i_prev_high := high
    i_prev_low  := low

// ── Seed on new external swing ────────────────────────────
if showInternal
    if st.new_swing_low and not st.bull_sos and not st.bear_sos
        i_mode            := 1
        i_seeded          := true
        i_had_bos         := false
        i_bos_dir         := 0
        i_pb_started      := false
        i_pb_extreme      := na
        i_pb_count        := 0
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_mode       := 1
        i_last_hl         := na
        i_last_lh         := na
        i_sos_watch_hh    := na
        i_sos_watch_ll    := na
    else if st.new_swing_high and not st.bull_sos and not st.bear_sos
        i_mode            := -1
        i_seeded          := true
        i_had_bos         := false
        i_bos_dir         := 0
        i_pb_started      := false
        i_pb_extreme      := na
        i_pb_count        := 0
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_mode       := -1
        i_last_hl         := na
        i_last_lh         := na
        i_sos_watch_hh    := na
        i_sos_watch_ll    := na

// ── Mode 1: track upward move → confirm iSH ──────────────
if showInternal and i_seeded and i_mode == 1
    if not i_pb_started
        i_pb_started     := true
        i_pb_extreme     := high
        i_pb_extreme_loc := bar_index
        i_pb_count       := 0
        i_pb_lqc         := na
        i_pb_lqh         := na
    else
        i_ext_chg := false
        if high > i_pb_extreme
            i_pb_extreme     := high
            i_pb_extreme_loc := bar_index
            i_pb_count       := 0
            i_pb_lqc         := na
            i_pb_lqh         := na
            i_ext_chg        := true
        i_is_inside := not na(i_prev_high) and not na(i_prev_low) and high < i_prev_high and low > i_prev_low
        i_ext_dir   := i_ext_chg and close < open
        i_is_c1     := na(i_pb_lqc) and not i_ext_chg
        if (not i_is_inside or i_is_c1) and (not i_ext_chg or i_ext_dir)
            i_thresh := na(i_pb_lqh) ? i_pb_extreme : i_pb_lqh
            if close < i_thresh - pbBuffer
                i_pb_count += 1
                i_pb_lqc   := close
                i_pb_lqh   := low
        if i_pb_count >= 3 and not na(i_pb_extreme)
            if not na(i_sw_line)
                line.set_x2(i_sw_line, bar_index)
            i_sw_line  := na
            i_sw_lbl   := na
            i_sw_price := i_pb_extreme
            i_sw_loc   := i_pb_extreme_loc
            i_h_lbl := not i_had_bos ? "iSH" : "iHH"
            i_h_col := not i_had_bos ? iBearColor : iBullColor
            i_confirmed_high_price := i_sw_price
            i_confirmed_high_loc   := i_sw_loc
            i_sw_line  := line.new(i_sw_loc, i_sw_price, bar_index, i_sw_price, color = color.new(i_h_col, 15), style = line.style_dotted, width = 1)
            i_sw_lbl   := label.new(i_sw_loc, i_sw_price, i_h_lbl + "\n", color = color(na), textcolor = color.new(i_h_col, 15), style = label.style_label_down, size = size.tiny)
            i_mode       := 0
            i_pb_count   := 0
            i_pb_started := false

// ── Mode -1: track downward move → confirm iSL ───────────
if showInternal and i_seeded and i_mode == -1
    if not i_pb_started
        i_pb_started     := true
        i_pb_extreme     := low
        i_pb_extreme_loc := bar_index
        i_pb_count       := 0
        i_pb_lqc         := na
        i_pb_lqh         := na
    else
        i_ext_chg := false
        if low < i_pb_extreme
            i_pb_extreme     := low
            i_pb_extreme_loc := bar_index
            i_pb_count       := 0
            i_pb_lqc         := na
            i_pb_lqh         := na
            i_ext_chg        := true
        i_is_inside := not na(i_prev_high) and not na(i_prev_low) and high < i_prev_high and low > i_prev_low
        i_ext_dir   := i_ext_chg and close > open
        i_is_c1     := na(i_pb_lqc) and not i_ext_chg
        if (not i_is_inside or i_is_c1) and (not i_ext_chg or i_ext_dir)
            i_thresh := na(i_pb_lqh) ? i_pb_extreme : i_pb_lqh
            if close > i_thresh + pbBuffer
                i_pb_count += 1
                i_pb_lqc   := close
                i_pb_lqh   := high
        if i_pb_count >= 3 and not na(i_pb_extreme)
            if not na(i_sw_line)
                line.set_x2(i_sw_line, bar_index)
            i_sw_line  := na
            i_sw_lbl   := na
            i_sw_price := i_pb_extreme
            i_sw_loc   := i_pb_extreme_loc
            i_l_lbl := not i_had_bos ? "iSL" : "iLL"
            i_l_col := not i_had_bos ? iBullColor : iBearColor
            i_confirmed_low_price := i_sw_price
            i_confirmed_low_loc   := i_sw_loc
            i_sw_line  := line.new(i_sw_loc, i_sw_price, bar_index, i_sw_price, color = color.new(i_l_col, 15), style = line.style_dotted, width = 1)
            i_sw_lbl   := label.new(i_sw_loc, i_sw_price, "\n" + i_l_lbl, color = color(na), textcolor = color.new(i_l_col, 15), style = label.style_label_up, size = size.tiny)
            i_mode       := 0
            i_pb_count   := 0
            i_pb_started := false

// ── Track extreme while watching (mode 0) ────────────────
if showInternal and i_seeded and i_mode == 0
    if i_last_mode == 1
        if na(i_tracked_ext) or low < i_tracked_ext
            i_tracked_ext     := low
            i_tracked_ext_loc := bar_index
    else if i_last_mode == -1
        if na(i_tracked_ext) or high > i_tracked_ext
            i_tracked_ext     := high
            i_tracked_ext_loc := bar_index

// ── iBOS / iSOS detection ────────────────────────────────
bool int_bull_break = false
bool int_bear_break = false
int  int_break_origin_loc = na

if showInternal and i_mode == 0 and i_seeded and not na(i_sw_price) and barstate.isconfirmed
    if close > i_sw_price and i_last_mode == 1
        i_mid := math.round((i_sw_loc + bar_index) / 2)
        label.new(i_mid, i_sw_price + i_lbl_y_offset, "iBOS", color = color(na), textcolor = iBullColor, style = label.style_none, size = size.tiny, textalign = text.align_center)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sw_line := na
        i_sw_lbl := na
        if not na(i_tracked_ext)
            line.new(i_tracked_ext_loc, i_tracked_ext, bar_index, i_tracked_ext, color = color.new(iBullColor, 15), style = line.style_dotted, width = 1)
            label.new(i_tracked_ext_loc, i_tracked_ext, "\niHL", color = color(na), textcolor = color.new(iBullColor, 15), style = label.style_label_up, size = size.tiny)
            i_last_hl     := i_tracked_ext
            i_last_hl_loc := i_tracked_ext_loc

        int_bull_break := true
        int_break_origin_loc := i_tracked_ext_loc
        // iFib seed — bull iBOS: bottom = i_last_hl, top = i_sw_price, dir 1
        if showIFib and not na(i_last_hl) and not na(i_sw_price)
            iFib_asl := i_last_hl,  iFib_asl_loc := i_last_hl_loc
            iFib_ash := i_sw_price, iFib_ash_loc := i_sw_loc
            iFib_dir := 1
            iFib0Touched := false, iFib382Touched := false, iFib50Touched := false
            iFib618Touched := false, iFib702Touched := false, iFib786Touched := false
            iFib886Touched := false, iFib100Touched := false, iFib618EverReached := false
            iFib_tp3_hit_price := na, iFibResetActive := false

        i_sw_price       := na
        i_tracked_ext    := na
        i_tracked_ext_loc := na
        i_pb_count       := 0
        i_pb_started     := false
        i_pb_lqc         := na
        i_pb_lqh         := na
        i_had_bos        := true
        i_bos_dir        := 1
        i_last_mode      := 1
        i_mode           := 1
        i_sos_watch_ll   := na

    else if close < i_sw_price and i_last_mode == -1
        i_mid2 := math.round((i_sw_loc + bar_index) / 2)
        label.new(i_mid2, i_sw_price - i_lbl_y_offset, "iBOS", color = color(na), textcolor = iBearColor, style = label.style_none, size = size.tiny, textalign = text.align_center)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sw_line := na
        i_sw_lbl := na
        if not na(i_tracked_ext)
            line.new(i_tracked_ext_loc, i_tracked_ext, bar_index, i_tracked_ext, color = color.new(iBearColor, 15), style = line.style_dotted, width = 1)
            label.new(i_tracked_ext_loc, i_tracked_ext, "iLH\n", color = color(na), textcolor = color.new(iBearColor, 15), style = label.style_label_down, size = size.tiny)
            i_last_lh     := i_tracked_ext
            i_last_lh_loc := i_tracked_ext_loc

        int_bear_break := true
        int_break_origin_loc := i_tracked_ext_loc
        // iFib seed — bear iBOS: bottom = i_sw_price, top = i_last_lh, dir -1
        if showIFib and not na(i_sw_price) and not na(i_last_lh)
            iFib_asl := i_sw_price,  iFib_asl_loc := i_sw_loc
            iFib_ash := i_last_lh,   iFib_ash_loc := i_last_lh_loc
            iFib_dir := -1
            iFib0Touched := false, iFib382Touched := false, iFib50Touched := false
            iFib618Touched := false, iFib702Touched := false, iFib786Touched := false
            iFib886Touched := false, iFib100Touched := false, iFib618EverReached := false
            iFib_tp3_hit_price := na, iFibResetActive := false

        i_sw_price        := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_pb_count        := 0
        i_pb_started      := false
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_had_bos         := true
        i_bos_dir         := -1
        i_last_mode       := -1
        i_mode            := -1
        i_sos_watch_hh    := na

// ── iSOS detection (watches last iHL / iLH) ──────────────
if showInternal and i_seeded and i_had_bos and barstate.isconfirmed
    if i_last_mode == 1 and not na(i_last_hl) and close < i_last_hl and i_mode == 0
        i_mid2 := math.round((i_last_hl_loc + bar_index) / 2)
        label.new(i_mid2, i_last_hl - i_lbl_y_offset, "iSOS", color = color(na), textcolor = iBearColor, style = label.style_none, size = size.tiny, textalign = text.align_center)
        line.new(i_last_hl_loc, i_last_hl, bar_index, i_last_hl, color = color.new(iBearColor, 15), style = line.style_dotted, width = 1)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sw_line := na

        i_sos_watch_hh     := i_sw_price
        i_sos_watch_hh_loc := i_sw_loc
        i_sos_watch_ll     := na

        int_bear_break := true
        int_break_origin_loc := i_sw_loc
        // iFib seed — bear iSOS: bottom = i_tracked_ext, top = i_sw_price, dir -1
        if showIFib and not na(i_tracked_ext) and not na(i_sw_price)
            iFib_asl := i_tracked_ext, iFib_asl_loc := i_tracked_ext_loc
            iFib_ash := i_sw_price,    iFib_ash_loc := i_sw_loc
            iFib_dir := -1
            iFib0Touched := false, iFib382Touched := false, iFib50Touched := false
            iFib618Touched := false, iFib702Touched := false, iFib786Touched := false
            iFib886Touched := false, iFib100Touched := false, iFib618EverReached := false
            iFib_tp3_hit_price := na, iFibResetActive := false

        i_sw_lbl          := na
        i_sw_price        := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_hl         := na
        i_pb_count        := 0
        i_pb_started      := false
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_last_mode       := -1
        i_mode            := -1

    else if i_last_mode == -1 and not na(i_last_lh) and close > i_last_lh and i_mode == 0
        i_mid := math.round((i_last_lh_loc + bar_index) / 2)
        label.new(i_mid, i_last_lh + i_lbl_y_offset, "iSOS", color = color(na), textcolor = iBullColor, style = label.style_none, size = size.tiny, textalign = text.align_center)
        line.new(i_last_lh_loc, i_last_lh, bar_index, i_last_lh, color = color.new(iBullColor, 15), style = line.style_dotted, width = 1)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sw_line := na

        i_sos_watch_ll     := i_sw_price
        i_sos_watch_ll_loc := i_sw_loc
        i_sos_watch_hh     := na

        int_bull_break := true
        int_break_origin_loc := i_sw_loc
        // iFib seed — bull iSOS: bottom = i_sw_price, top = i_last_lh, dir 1
        if showIFib and not na(i_sw_price) and not na(i_last_lh)
            iFib_asl := i_sw_price, iFib_asl_loc := i_sw_loc
            iFib_ash := i_last_lh,  iFib_ash_loc := i_last_lh_loc
            iFib_dir := 1
            iFib0Touched := false, iFib382Touched := false, iFib50Touched := false
            iFib618Touched := false, iFib702Touched := false, iFib786Touched := false
            iFib886Touched := false, iFib100Touched := false, iFib618EverReached := false
            iFib_tp3_hit_price := na, iFibResetActive := false

        i_sw_lbl          := na
        i_sw_price        := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_lh         := na
        i_pb_count        := 0
        i_pb_started      := false
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_last_mode       := 1
        i_mode            := 1

    else if i_last_mode == -1 and not na(i_sos_watch_hh) and close > i_sos_watch_hh and i_mode == 0
        i_mid := math.round((i_sos_watch_hh_loc + bar_index) / 2)
        label.new(i_mid, i_sos_watch_hh + i_lbl_y_offset, "iSOS", color = color(na), textcolor = iBullColor, style = label.style_none, size = size.tiny, textalign = text.align_center)
        line.new(i_sos_watch_hh_loc, i_sos_watch_hh, bar_index, i_sos_watch_hh, color = color.new(iBullColor, 15), style = line.style_dotted, width = 1)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sw_line := na

        i_sos_watch_ll     := i_sw_price
        i_sos_watch_ll_loc := i_sw_loc

        int_bull_break := true
        int_break_origin_loc := i_sw_loc
        // iFib seed — bull iSOS (2nd-level watch): bottom = i_sw_price, top = i_sos_watch_hh, dir 1
        if showIFib and not na(i_sw_price) and not na(i_sos_watch_hh)
            iFib_asl := i_sw_price,      iFib_asl_loc := i_sw_loc
            iFib_ash := i_sos_watch_hh,  iFib_ash_loc := i_sos_watch_hh_loc
            iFib_dir := 1
            iFib0Touched := false, iFib382Touched := false, iFib50Touched := false
            iFib618Touched := false, iFib702Touched := false, iFib786Touched := false
            iFib886Touched := false, iFib100Touched := false, iFib618EverReached := false
            iFib_tp3_hit_price := na, iFibResetActive := false

        i_sw_lbl          := na
        i_sw_price        := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_lh         := na
        i_pb_count        := 0
        i_pb_started      := false
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_last_mode       := 1
        i_mode            := 1
        i_sos_watch_hh    := na

    else if i_last_mode == 1 and not na(i_sos_watch_ll) and close < i_sos_watch_ll and i_mode == 0
        i_mid2 := math.round((i_sos_watch_ll_loc + bar_index) / 2)
        label.new(i_mid2, i_sos_watch_ll - i_lbl_y_offset, "iSOS", color = color(na), textcolor = iBearColor, style = label.style_none, size = size.tiny, textalign = text.align_center)
        line.new(i_sos_watch_ll_loc, i_sos_watch_ll, bar_index, i_sos_watch_ll, color = color.new(iBearColor, 15), style = line.style_dotted, width = 1)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sw_line := na

        i_sos_watch_hh     := i_sw_price
        i_sos_watch_hh_loc := i_sw_loc

        int_bear_break := true
        int_break_origin_loc := i_sw_loc
        // iFib seed — bear iSOS (2nd-level watch): bottom = i_sos_watch_ll, top = i_sw_price, dir -1
        if showIFib and not na(i_sos_watch_ll) and not na(i_sw_price)
            iFib_asl := i_sos_watch_ll,     iFib_asl_loc := i_sos_watch_ll_loc
            iFib_ash := i_sw_price,         iFib_ash_loc := i_sw_loc
            iFib_dir := -1
            iFib0Touched := false, iFib382Touched := false, iFib50Touched := false
            iFib618Touched := false, iFib702Touched := false, iFib786Touched := false
            iFib886Touched := false, iFib100Touched := false, iFib618EverReached := false
            iFib_tp3_hit_price := na, iFibResetActive := false

        i_sw_lbl          := na
        i_sw_price        := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_hl         := na
        i_pb_count        := 0
        i_pb_started      := false
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_last_mode       := -1
        i_mode            := -1
        i_sos_watch_ll    := na

// ── Update last_mode when mode changes ───────────────────
if showInternal and i_mode != 0
    i_last_mode := i_mode

// ── Extend active swing line every bar ────────────────────
if showInternal and not na(i_sw_line)
    line.set_x2(i_sw_line, bar_index)

//============================================================

// Defaults MIRROR mpc_jarvis.pine:410-414 exactly.
//
// The size floor is TIMEFRAME-AWARE in mpc and this file now reproduces that split rather than
// carrying one flat number. It matters: a %-of-price floor does not scale down, so 0.04% of gold at
// $3,300 is $1.32 — a real filter on a 15m bar, but wider than many whole 5m bars. A harness pinned
// to the sub-15m floor and then exported on a 15m chart would have been diffing Python against a
// Pine running a DIFFERENT rule from the indicator it is supposed to mirror.
//
// Both floors are inputs so a run can be taken at a non-default setting, but `cfg_fvg_thresh` carries
// the EFFECTIVE value, so compare_fvg.py always configures Python to whatever this chart really used.
float fvgThreshLTF    = input.float(0.0,  "Min Gap Size, below 15m (% of price)",  minval = 0.0, maxval = 5.0, step = 0.01)
float fvgThreshHTF    = input.float(0.04, "Min Gap Size, 15m and above (% of price)", minval = 0.0, maxval = 5.0, step = 0.01)
float fvgThreshPct    = timeframe.in_seconds() < 900 ? fvgThreshLTF : fvgThreshHTF
// 🔴 THIS INPUT STOPPED BOUNDING THE LIVE LIST ON 2026-08-03 AND THE HARNESS DID NOT NOTICE FOR
// FIVE WEEKS. Once a gap can be EXEMPT from the cap it rides on top of the count, so the live total
// is bounded by the EQ engine (eqMax per side), not by this number. The file plotted 10 slots and
// tied its own maxval to them, which reads as coverage — MEASURED on the committed golden export
// (20,155 M15 bars): the live list reaches 17 and exceeds 10 on 52.2% of bars, every one of which
// the parity diff reported green while never looking at gaps 11 and up.
// Two changes, and BOTH are needed. The slots go to 18, which covers the observed range with room;
// and px_fvg_topsum/botsum/bulltotal aggregate the WHOLE array, so a list longer than the slots is
// still compared rather than silently dropped. ⚠ The slots give ORDER (which is what proves the
// FIFO evicts the right gap); the sums give MEMBERSHIP at any length. Neither alone is the check.
int   fvgMaxCount     = input.int(8, "Max Active FVGs", minval = 1, maxval = 18)
bool  fvgRequireClose = input.bool(false, "Require Displacement Close")

// ── EQ coupling (mpc eqExemptFvg): an FVG behind an active EQH/EQL level is exempt from the cap.
//    The EQ block below is embedded ONLY to reproduce that exemption; its own detection is validated
//    separately by eq_export.pine. Defaults MIRROR mpc's GRP_EQ — 🔴 and they did NOT until
//    2026-09-09: 0.1/6 here against mpc's 0.25/14, the SEVENTH copy of those three numbers and the
//    one nobody counted. It was found only by reading this file for another reason. Exported as cfg_eq_* so compare_fvg.py
//    drives the Python EqualHighsLowsEngine with the same settings. ──
int   eqPivotLen  = input.int(2,   "EQ Pivot Length",       minval = 1, maxval = 20)
float eqAtrMult   = input.float(0.25, "EQ Tolerance (x ATR)", minval = 0.0, maxval = 2.0, step = 0.05)
int   eqMax       = input.int(14,  "Max Active EQ (per side)", minval = 1, maxval = 20)
bool  eqExemptFvg = input.bool(true, "Keep FVGs behind EQH/EQL until mitigated")

// ── Entry-band coupling (mpc fvgExemptZone): an FVG sitting in the live fib's 0.382-0.886 band,
//    ON THE TRADE'S OWN SIDE, is exempt from the cap. This is the reason this harness exists and
//    the reason it carries a whole structure + fib engine above: the band cannot be an input,
//    it is recomputed every bar from the live leg.
//    🔴 The band read here is LAST BAR'S, and that lag is mpc's, not an artefact of this file.
//    In mpc the FVG block runs ~800 lines ABOVE the fib block, so it can only ever see the
//    previous bar's publish. It is deliberate there ("this decides which gap to THROW AWAY,
//    never which one to trade"), so the harness reproduces the ordering rather than the result:
//    the FVG block below sits BEFORE the fib block, exactly as it does in the indicator. ──
bool  fvgExemptZone = input.bool(true, "Keep FVGs in the live fib entry band until mitigated")
var float fvgZoneLo  = na
var float fvgZoneHi  = na
var int   fvgZoneDir = 0

// State arrays (the Pine fvgBoxes drawing array is intentionally dropped).
var array<float> fvgTops   = array.new<float>()
var array<float> fvgBots   = array.new<float>()
var array<bool>  fvgIsBull = array.new<bool>()
var array<int>   fvgBorn   = array.new<int>()

// Per-bar pulse counters (reset each bar) — how many gaps formed / were mitigated THIS bar.
int fvgFormed = 0
int fvgMit    = 0

// ── EQ block (runs BEFORE FVG, exactly the mpc order) — kept only for the FVG cap exemption. ──
float eqAtr = ta.atr(50)
float eqTol = na(eqAtr) ? 0.0 : eqAtr * eqAtrMult
var array<float> eqhPx = array.new<float>()
var array<float> eqlPx = array.new<float>()
float eqPh = ta.pivothigh(high, eqPivotLen, eqPivotLen)
float eqPl = ta.pivotlow(low,  eqPivotLen, eqPivotLen)
var float eqPrevPh = na
var float eqPrevPl = na
if not na(eqPh)
    if not na(eqPrevPh) and math.abs(eqPh - eqPrevPh) <= eqTol
        array.push(eqhPx, math.max(eqPh, eqPrevPh))
        while array.size(eqhPx) > eqMax
            array.shift(eqhPx)
    eqPrevPh := eqPh
if not na(eqPl)
    if not na(eqPrevPl) and math.abs(eqPl - eqPrevPl) <= eqTol
        array.push(eqlPx, math.min(eqPl, eqPrevPl))
        while array.size(eqlPx) > eqMax
            array.shift(eqlPx)
    eqPrevPl := eqPl
// 🔴 WICK, not close (2026-09-09) — mirrors mpc and eq_export.pine. This embedded copy was
// MISSED when the engine moved on the same day, and the miss is instructive: the EQ rule lives in
// FOUR places (mpc, eq_export, this harness, the Python engine) and only three were named in the
// note that recorded the split. A gate embedding another engine's block owns a copy of that
// engine's rules, and nothing points at it from the engine's own directory.
if array.size(eqhPx) > 0
    for i = array.size(eqhPx) - 1 to 0
        if high > array.get(eqhPx, i)
            array.remove(eqhPx, i)
if array.size(eqlPx) > 0
    for i = array.size(eqlPx) - 1 to 0
        if low < array.get(eqlPx, i)
            array.remove(eqlPx, i)

// True when an FVG (gTop..gBot) sits within `prox` of any active EQH/EQL level (mpc f_fvgNearEq).
f_fvgNearEq(float gTop, float gBot, float prox) =>
    bool near = false
    if array.size(eqhPx) > 0
        for i = 0 to array.size(eqhPx) - 1
            float lvl = array.get(eqhPx, i)
            if lvl >= gBot - prox and lvl <= gTop + prox
                near := true
    if array.size(eqlPx) > 0
        for i = 0 to array.size(eqlPx) - 1
            float lvl = array.get(eqlPx, i)
            if lvl >= gBot - prox and lvl <= gTop + prox
                near := true
    near

// True when a gap sits in the live fib ENTRY BAND on the trade's own side (mpc f_fvgZoneKeep,
// copied from mpc_jarvis.pine:3833-3835). Read by the cap below both to COUNT and to CHOOSE what
// to drop, so a protected gap never holds a slot and is never the one evicted.
f_fvgZoneKeep(float gTop, float gBot, bool isBull) =>
    fvgExemptZone and fvgZoneDir != 0 and isBull == (fvgZoneDir == 1) and not na(fvgZoneLo)
      and gTop >= fvgZoneLo and gBot <= fvgZoneHi

// ── The band as the cap ACTUALLY SAW IT this bar, captured before the fib block below can move
//    it. Exported as px_fvgzone_*, so compare_fvg.py feeds Python the same numbers the Pine used
//    and no off-by-one can hide inside the comparison tool. The band the fib PUBLISHES this bar is
//    exported separately (px_fibband_*), and the tool asserts consumed[i] == published[i-1] — that
//    turns the one-bar lag from a sentence in a comment into a checked fact. ──
float fvgZoneLoUsed  = fvgZoneLo
float fvgZoneHiUsed  = fvgZoneHi
int   fvgZoneDirUsed = fvgZoneDir

// ── Detection (confirmed bars only; needs the two-bars-back candle) ──
// LuxAlgo 3-candle imbalance: outer candles don't overlap and the gap is at least fvgThreshPct% of
// price. The middle-bar close-cleared check is OPTIONAL — gated by fvgRequireClose, byte-identical to
// mpc's `(not fvgRequireClose or close[1] > high[2])`. No clean-impulse rule.
float fvgThreshold = fvgThreshPct
if barstate.isconfirmed and bar_index >= 2
    bool bullFvg = low > high[2] and (not fvgRequireClose or close[1] > high[2]) and (low - high[2]) / high[2] * 100 > fvgThreshold
    bool bearFvg = high < low[2] and (not fvgRequireClose or close[1] < low[2]) and (low[2] - high) / low[2] * 100 > fvgThreshold
    if bullFvg
        array.push(fvgTops, low)
        array.push(fvgBots, high[2])
        array.push(fvgIsBull, true)
        array.push(fvgBorn, bar_index)
        fvgFormed := fvgFormed + 1
    if bearFvg
        array.push(fvgTops, low[2])
        array.push(fvgBots, high)
        array.push(fvgIsBull, false)
        array.push(fvgBorn, bar_index)
        fvgFormed := fvgFormed + 1
    // Cap: `fvgMaxCount` bounds the ORDINARY gaps only, and an EQ-exempt gap rides ON TOP of them
    // (mpc byte-for-byte since 2026-08-03). If every gap is exempt, none are dropped.
    // ⚠ THE COUNT MUST EXCLUDE THE EXEMPT GAPS. This harness counted `array.size(fvgTops)` — every
    // gap — until 2026-08-06 while the drop scan below skipped the exempt ones, which is the
    // self-cancelling SWAP the indicator fixed three days earlier. It had gone stale relative to
    // BOTH the Pine it mirrors and the Python engine it validates, so the next export would have
    // put `compare_fvg.py` red against a correct engine.
    int _nonEq = 0
    if array.size(fvgTops) > 0
        for _di = 0 to array.size(fvgTops) - 1
            if not ((eqExemptFvg and f_fvgNearEq(array.get(fvgTops, _di), array.get(fvgBots, _di), eqTol)) or f_fvgZoneKeep(array.get(fvgTops, _di), array.get(fvgBots, _di), array.get(fvgIsBull, _di)))
                _nonEq += 1
    while _nonEq > fvgMaxCount
        int _dropIdx = -1
        for _di = 0 to array.size(fvgTops) - 1
            if not ((eqExemptFvg and f_fvgNearEq(array.get(fvgTops, _di), array.get(fvgBots, _di), eqTol)) or f_fvgZoneKeep(array.get(fvgTops, _di), array.get(fvgBots, _di), array.get(fvgIsBull, _di)))
                _dropIdx := _di
                break
        if _dropIdx == -1
            break
        array.remove(fvgTops, _dropIdx)
        array.remove(fvgBots, _dropIdx)
        array.remove(fvgIsBull, _dropIdx)
        array.remove(fvgBorn, _dropIdx)
        _nonEq -= 1

// ── Mitigate: a candle CLOSES fully past the far edge (bull close <= bottom, bear
//    close >= top). A wick into the gap no longer removes it. Skipped on creation bar. ──
if array.size(fvgTops) > 0
    for i = array.size(fvgTops) - 1 to 0
        bool  isBull = array.get(fvgIsBull, i)
        float gTop   = array.get(fvgTops, i)
        float gBot   = array.get(fvgBots, i)
        bool closedPast = barstate.isconfirmed and bar_index > array.get(fvgBorn, i) and (isBull ? close <= gBot : close >= gTop)
        if closedPast
            array.remove(fvgTops, i)
            array.remove(fvgBots, i)
            array.remove(fvgIsBull, i)
            array.remove(fvgBorn, i)
            fvgMit := fvgMit + 1


//  STRUCTURE FIBONACCI  (lifted from mpc_jarvis.pine GRP_FIBO, ~2009-2114)
//  Compute + touched state machine ONLY — every line.new/label.new drawing removed. Reads the
//  external structure engine's st.* above (byte-identical to structure_engine.pine). This is the
//  SOURCE-OF-TRUTH fib logic; the Python port in fibonacci/ is validated against the px_fib_*
//  plots at the bottom of this file via fibonacci/tools/compare_fib.py.
//  The ONLY deviation from mpc_jarvis.pine is fiboOriginChanged uses ':=' (outer var) instead
//  of '=' so its value is observable by the px_fib_origin plot — this does not change the touched
//  state machine, which reads the same value in the same scope right after.
//============================================================
float fibo1Value  = 0.382
float fibo2Value  = 0.500
float fibo3Value  = 0.618
float fibo4Value  = 0.702
float fibo5Value  = 0.786
float fibo6Value  = 0.886
float fibo7Value  = 0.000
float fibo10Value = 1.000

var float fibo_ash     = na
var float fibo_asl     = na
var int   fibo_ash_loc = na
var int   fibo_asl_loc = na
var int   fibo_dir     = 0

var bool fiboOriginChanged = false
fiboOriginChanged := false
var bool fibo1Touched  = false
var bool fibo2Touched  = false
var bool fibo3Touched  = false
var bool fibo4Touched  = false
var bool fibo5Touched  = false
var bool fibo6Touched  = false
var bool fibo7Touched  = false
var bool fibo10Touched = false
var bool fibo618EverReached = false
var bool fiboResetActive    = false   // declared + reset on origin change; TP3 setter dropped 2026-07-09
var bool fiboHalfReached    = false   // inbound 0.5 (fiboP2) tap, UNGATED — SOS FADE EARLY tier (mpc 2313/2443)

var float fiboP1  = na, var float fiboP2  = na, var float fiboP3  = na
var float fiboP4  = na, var float fiboP5  = na, var float fiboP6  = na
var float fiboP7  = na
var float fiboP10 = na
var int   fiboStartIndexPrev = na
var float fiboPrevAsh = na   // last bar's anchors — the extend-changed guard (mpc 2303-2309)
var float fiboPrevAsl = na

if not na(st.ash)
    fibo_ash     := st.ash
    fibo_ash_loc := st.ash_loc
if not na(st.asl)
    fibo_asl     := st.asl
    fibo_asl_loc := st.asl_loc
if st.dir != 0
    fibo_dir := st.dir

if st.pb_mode == 1 and not na(st.pb_extreme)
    fibo_ash     := st.pb_extreme
    fibo_ash_loc := st.pb_extreme_loc
if st.pb_mode == -1 and not na(st.pb_extreme)
    fibo_asl     := st.pb_extreme
    fibo_asl_loc := st.pb_extreme_loc

// Adopt a more-extreme confirmed internal swing for the fib pull only (mpc 2277-2282).
if fibo_dir == 1 and not na(i_confirmed_low_price) and not na(fibo_asl) and i_confirmed_low_price < fibo_asl
    fibo_asl     := i_confirmed_low_price
    fibo_asl_loc := i_confirmed_low_loc
if fibo_dir == -1 and not na(i_confirmed_high_price) and not na(fibo_ash) and i_confirmed_high_price > fibo_ash
    fibo_ash     := i_confirmed_high_price
    fibo_ash_loc := i_confirmed_high_loc

bool fibActive = not na(fibo_ash) and not na(fibo_asl) and fibo_dir != 0

if fibActive
    fiboRange      = fibo_ash - fibo_asl
    fiboStartIndex = fibo_dir == 1 ? fibo_asl_loc : fibo_ash_loc

    fiboP1  := fibo_dir == 1 ? fibo_ash - fiboRange * fibo1Value  : fibo_asl + fiboRange * fibo1Value
    fiboP2  := fibo_dir == 1 ? fibo_ash - fiboRange * fibo2Value  : fibo_asl + fiboRange * fibo2Value
    fiboP3  := fibo_dir == 1 ? fibo_ash - fiboRange * fibo3Value  : fibo_asl + fiboRange * fibo3Value
    fiboP4  := fibo_dir == 1 ? fibo_ash - fiboRange * fibo4Value  : fibo_asl + fiboRange * fibo4Value
    fiboP5  := fibo_dir == 1 ? fibo_ash - fiboRange * fibo5Value  : fibo_asl + fiboRange * fibo5Value
    fiboP6  := fibo_dir == 1 ? fibo_ash - fiboRange * fibo6Value  : fibo_asl + fiboRange * fibo6Value
    fiboP7  := fibo_dir == 1 ? fibo_ash - fiboRange * fibo7Value  : fibo_asl + fiboRange * fibo7Value
    fiboP10 := fibo_dir == 1 ? fibo_ash - fiboRange * fibo10Value : fibo_asl + fiboRange * fibo10Value

    fiboOriginChanged := fiboStartIndex != fiboStartIndexPrev
    if fiboOriginChanged
        fibo1Touched  := false
        fibo2Touched  := false
        fibo3Touched  := false
        fibo4Touched  := false
        fibo5Touched  := false
        fibo6Touched  := false
        fibo7Touched  := false
        fibo10Touched := false
        fibo618EverReached := false
        fiboResetActive    := false
        fiboHalfReached    := false
        i_confirmed_low_price  := na
        i_confirmed_low_loc    := na
        i_confirmed_high_price := na
        i_confirmed_high_loc   := na
    fiboStartIndexPrev := fiboStartIndex

    // Skip touched-checks on the bar the origin changed OR the bar the extending anchor itself moved
    // (a live pullback wick, not a confirmed close) — mpc 2303-2309.
    bool fiboExtChanged = (not na(fiboPrevAsh) and fibo_ash != fiboPrevAsh) or (not na(fiboPrevAsl) and fibo_asl != fiboPrevAsl)
    if not fiboOriginChanged and not fiboExtChanged
        bool fibo618Reached = fibo_dir == 1 ? low <= fiboP3 : high >= fiboP3

        // Inbound 0.5 (fiboP2) tap — UNGATED SOS FADE EARLY tier (mpc 2443). Retracement-side, latched.
        if not fiboHalfReached and (fibo_dir == 1 ? low <= fiboP2 : high >= fiboP2)
            fiboHalfReached := true

        if fibo618Reached
            if not fibo3Touched
                fibo3Touched := true
            if not fibo4Touched and not na(fiboP4)
                if fibo_dir == 1 ? low <= fiboP4 : high >= fiboP4
                    fibo4Touched := true
            if not fibo5Touched and not na(fiboP5)
                if fibo_dir == 1 ? low <= fiboP5 : high >= fiboP5
                    fibo5Touched := true
            if not fibo6Touched and not na(fiboP6)
                if fibo_dir == 1 ? low <= fiboP6 : high >= fiboP6
                    fibo6Touched := true
            if not fibo10Touched and not na(fiboP10)
                if fibo_dir == 1 ? low <= fiboP10 : high >= fiboP10
                    fibo10Touched := true

        if fibo618EverReached
            if not fibo2Touched and not na(fiboP2)
                if fibo_dir == 1 ? high >= fiboP2 : low <= fiboP2
                    fibo2Touched := true
            if not fibo1Touched and not na(fiboP1)
                if fibo_dir == 1 ? high >= fiboP1 : low <= fiboP1
                    fibo1Touched := true
            if not fibo7Touched and not na(fiboP7)
                if fibo_dir == 1 ? high >= fiboP7 : low <= fiboP7
                    fibo7Touched := true

        if fibo618Reached and not fibo618EverReached
            fibo618EverReached := true

    // Remember this bar's anchors for next bar's extend-changed check (mpc 2336-2337).
    fiboPrevAsh := fibo_ash
    fiboPrevAsl := fibo_asl

//============================================================

    // ── PUBLISH THE ENTRY BAND FOR THE FVG CAP — copied from mpc_jarvis.pine:4896-4907 ──
    // Read on the NEXT bar by the FVG cap above, which is why this is the last thing the fib
    // block does. 0.382 → 0.886, ordered with min/max so a short's band (which runs the other
    // way) still compares correctly.
    // ⚠ fvgZoneDir is `fiboResetActive ? 0 : fibo_dir` in mpc. `fiboResetActive` is only ever set
    //   true on a 1-MINUTE chart there (mpc:4893 `if _fibOneMin and (fibo7Touched or rTp50)`), and
    //   reaching that needs the whole MTF-alignment block. So on any timeframe above 1m this term
    //   is `fibo_dir` in mpc too, and this harness reproduces mpc-above-1m faithfully rather than
    //   pretending to cover a branch it cannot reach. Export above 1m. The Python engine's
    //   dir == 0 branch IS exercised — it is every bar before the first leg confirms.
    fvgZoneLo  := math.min(fiboP1, fiboP6)
    fvgZoneHi  := math.max(fiboP1, fiboP6)
    fvgZoneDir := fiboResetActive ? 0 : fibo_dir

// ── Parity columns (slot 1 = oldest, mirroring the array order) ──
// NOTE: use a fully-transparent COLOUR (alpha 100), NOT `display = display.none`.
// TradingView's "Export chart data" excludes display.none plots from the CSV, so hidden
// columns never make it into the export. Transparent plots stay invisible on the chart but
// DO export (same trick fib_export.pine uses).
//
// 🔴 THE COLUMN SET IS SHAPED BY TRADINGVIEW'S 64-PLOT CEILING, AND THE SHAPE IS THE POINT.
// Three columns per slot (top/bot/bull) buys 21 slots and nothing else; two per slot plus ONE
// packed direction mask buys 18 slots AND the whole-array aggregates that make a longer list
// visible at all. The second is strictly more coverage per plot, so that is what this is.

plot(array.size(fvgTops) > 0 ? array.get(fvgTops, 0) : na, "px_fvg_top_1", color = color.new(color.green, 100))
plot(array.size(fvgTops) > 1 ? array.get(fvgTops, 1) : na, "px_fvg_top_2", color = color.new(color.green, 100))
plot(array.size(fvgTops) > 2 ? array.get(fvgTops, 2) : na, "px_fvg_top_3", color = color.new(color.green, 100))
plot(array.size(fvgTops) > 3 ? array.get(fvgTops, 3) : na, "px_fvg_top_4", color = color.new(color.green, 100))
plot(array.size(fvgTops) > 4 ? array.get(fvgTops, 4) : na, "px_fvg_top_5", color = color.new(color.green, 100))
plot(array.size(fvgTops) > 5 ? array.get(fvgTops, 5) : na, "px_fvg_top_6", color = color.new(color.green, 100))
plot(array.size(fvgTops) > 6 ? array.get(fvgTops, 6) : na, "px_fvg_top_7", color = color.new(color.green, 100))
plot(array.size(fvgTops) > 7 ? array.get(fvgTops, 7) : na, "px_fvg_top_8", color = color.new(color.green, 100))
plot(array.size(fvgTops) > 8 ? array.get(fvgTops, 8) : na, "px_fvg_top_9", color = color.new(color.green, 100))
plot(array.size(fvgTops) > 9 ? array.get(fvgTops, 9) : na, "px_fvg_top_10", color = color.new(color.green, 100))
plot(array.size(fvgTops) > 10 ? array.get(fvgTops, 10) : na, "px_fvg_top_11", color = color.new(color.green, 100))
plot(array.size(fvgTops) > 11 ? array.get(fvgTops, 11) : na, "px_fvg_top_12", color = color.new(color.green, 100))
plot(array.size(fvgTops) > 12 ? array.get(fvgTops, 12) : na, "px_fvg_top_13", color = color.new(color.green, 100))
plot(array.size(fvgTops) > 13 ? array.get(fvgTops, 13) : na, "px_fvg_top_14", color = color.new(color.green, 100))
plot(array.size(fvgTops) > 14 ? array.get(fvgTops, 14) : na, "px_fvg_top_15", color = color.new(color.green, 100))
plot(array.size(fvgTops) > 15 ? array.get(fvgTops, 15) : na, "px_fvg_top_16", color = color.new(color.green, 100))
plot(array.size(fvgTops) > 16 ? array.get(fvgTops, 16) : na, "px_fvg_top_17", color = color.new(color.green, 100))
plot(array.size(fvgTops) > 17 ? array.get(fvgTops, 17) : na, "px_fvg_top_18", color = color.new(color.green, 100))
plot(array.size(fvgBots) > 0 ? array.get(fvgBots, 0) : na, "px_fvg_bot_1", color = color.new(color.green, 100))
plot(array.size(fvgBots) > 1 ? array.get(fvgBots, 1) : na, "px_fvg_bot_2", color = color.new(color.green, 100))
plot(array.size(fvgBots) > 2 ? array.get(fvgBots, 2) : na, "px_fvg_bot_3", color = color.new(color.green, 100))
plot(array.size(fvgBots) > 3 ? array.get(fvgBots, 3) : na, "px_fvg_bot_4", color = color.new(color.green, 100))
plot(array.size(fvgBots) > 4 ? array.get(fvgBots, 4) : na, "px_fvg_bot_5", color = color.new(color.green, 100))
plot(array.size(fvgBots) > 5 ? array.get(fvgBots, 5) : na, "px_fvg_bot_6", color = color.new(color.green, 100))
plot(array.size(fvgBots) > 6 ? array.get(fvgBots, 6) : na, "px_fvg_bot_7", color = color.new(color.green, 100))
plot(array.size(fvgBots) > 7 ? array.get(fvgBots, 7) : na, "px_fvg_bot_8", color = color.new(color.green, 100))
plot(array.size(fvgBots) > 8 ? array.get(fvgBots, 8) : na, "px_fvg_bot_9", color = color.new(color.green, 100))
plot(array.size(fvgBots) > 9 ? array.get(fvgBots, 9) : na, "px_fvg_bot_10", color = color.new(color.green, 100))
plot(array.size(fvgBots) > 10 ? array.get(fvgBots, 10) : na, "px_fvg_bot_11", color = color.new(color.green, 100))
plot(array.size(fvgBots) > 11 ? array.get(fvgBots, 11) : na, "px_fvg_bot_12", color = color.new(color.green, 100))
plot(array.size(fvgBots) > 12 ? array.get(fvgBots, 12) : na, "px_fvg_bot_13", color = color.new(color.green, 100))
plot(array.size(fvgBots) > 13 ? array.get(fvgBots, 13) : na, "px_fvg_bot_14", color = color.new(color.green, 100))
plot(array.size(fvgBots) > 14 ? array.get(fvgBots, 14) : na, "px_fvg_bot_15", color = color.new(color.green, 100))
plot(array.size(fvgBots) > 15 ? array.get(fvgBots, 15) : na, "px_fvg_bot_16", color = color.new(color.green, 100))
plot(array.size(fvgBots) > 16 ? array.get(fvgBots, 16) : na, "px_fvg_bot_17", color = color.new(color.green, 100))
plot(array.size(fvgBots) > 17 ? array.get(fvgBots, 17) : na, "px_fvg_bot_18", color = color.new(color.green, 100))

// Direction for the first 18 slots, packed one bit per slot (slot 1 = bit 0). One column instead
// of 18; 2^18 is exactly representable in the float64 a CSV cell carries, so nothing rounds.
float fvgBullMask = 0.0
if array.size(fvgIsBull) > 0
    for _bi = 0 to math.min(array.size(fvgIsBull), 18) - 1
        if array.get(fvgIsBull, _bi)
            fvgBullMask += math.pow(2, _bi)

// ── WHOLE-ARRAY aggregates. These are what make a list longer than 18 slots CHECKABLE rather
//    than invisible: they run to array.size(), so a gap in slot 19 still moves a compared number.
//    ⚠ They prove MEMBERSHIP, not ORDER — that is why the per-slot columns above are kept. ──
float fvgTopSum = 0.0
float fvgBotSum = 0.0
int   fvgBullTot = 0
if array.size(fvgTops) > 0
    for _si = 0 to array.size(fvgTops) - 1
        fvgTopSum += array.get(fvgTops, _si)
        fvgBotSum += array.get(fvgBots, _si)
        if array.get(fvgIsBull, _si)
            fvgBullTot += 1

plot(fvgBullMask,          "px_fvg_bullmask",  color = color.new(color.gray, 100))
plot(array.size(fvgTops),  "px_fvg_count",     color = color.new(color.gray, 100))
plot(fvgFormed,            "px_fvg_formed",    color = color.new(color.gray, 100))
plot(fvgMit,               "px_fvg_mit",       color = color.new(color.gray, 100))
plot(fvgTopSum,            "px_fvg_topsum",    color = color.new(color.gray, 100))
plot(fvgBotSum,            "px_fvg_botsum",    color = color.new(color.gray, 100))
plot(fvgBullTot,           "px_fvg_bulltotal", color = color.new(color.gray, 100))

// ── cfg_* columns: the exact settings this export ran with, so compare_fvg.py configures the Python
//    engine to match (never a hardcoded guess). Constant every bar; the tool reads them once. ──
plot(fvgThreshPct,               "cfg_fvg_thresh",       color = color.new(color.gray, 100))
plot(fvgMaxCount,                "cfg_fvg_maxcount",     color = color.new(color.gray, 100))
plot(fvgRequireClose ? 1.0 : 0.0, "cfg_fvg_requireclose", color = color.new(color.gray, 100))
// EQ-coupling settings (so compare_fvg.py drives the Python EQ engine + exemption identically).
plot(eqPivotLen,             "cfg_eq_pivotlen", color = color.new(color.gray, 100))
plot(eqAtrMult,              "cfg_eq_atrmult",  color = color.new(color.gray, 100))
plot(eqMax,                  "cfg_eq_max",      color = color.new(color.gray, 100))
plot(eqExemptFvg ? 1.0 : 0.0, "cfg_eq_exempt",  color = color.new(color.gray, 100))
// ── Entry-band columns ──
// px_fvgzone_* is the band the cap CONSUMED on this bar; px_fibband_* is what the fib PUBLISHED
// on it. compare_fvg.py drives Python off the consumed set and self-tests the one-bar lag against
// the published set.
plot(fvgZoneLoUsed,  "px_fvgzone_lo",  color = color.new(color.gray, 100))
plot(fvgZoneHiUsed,  "px_fvgzone_hi",  color = color.new(color.gray, 100))
plot(fvgZoneDirUsed, "px_fvgzone_dir", color = color.new(color.gray, 100))
plot(fvgZoneLo,      "px_fibband_lo",  color = color.new(color.gray, 100))
plot(fvgZoneHi,      "px_fibband_hi",  color = color.new(color.gray, 100))
plot(fvgZoneDir,     "px_fibband_dir", color = color.new(color.gray, 100))
plot(fvgExemptZone ? 1.0 : 0.0, "cfg_fvg_exemptzone", color = color.new(color.gray, 100))
