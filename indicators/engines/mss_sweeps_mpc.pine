// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/ MPL-2.0
//@version=6
// MSS Sweeps (MPC) — the sweep-and-reclaim TRIGGER, driven by OUR market structure.
//
// WHAT THIS IS. The idea comes from "MSS Sweeps [LuxAlgo]" (kept alongside as
// mss_sweeps_luxalgo.pine, third-party, read-only): after a continuation break, remember the
// protected swing that break left behind, and signal when price WICKS through that swing and
// CLOSES back on the right side of it. This file keeps that trigger and throws away their
// structure entirely.
//
// WHAT CHANGED, and it is all of the structure. Their internal structure is a one-sided leg
// detector at length 5 with its own CHOCH/BOS state machine. Ours is the canonical
// pivot-seeded, pullback-confirmed engine. Consequences worth knowing before reading a chart:
//   - the protected level is our iHL / iLH, confirmed by the pullback rule, not their leg flip
//   - their BOS reads the LIVE close, so it can appear and vanish intrabar; every one of our
//     iBOS/iSOS fires under barstate.isconfirmed, so nothing here repaints
//   - we have a SECOND DEGREE of structure (external, majorLength 15) and they have none.
//     That is what the trend filter below is built on
//
// ⚠ THE ENGINE BLOCK IS BYTE-IDENTICAL TO indicators/engines/structure_engine.pine, lines
// 27-1044. Regenerate with:  sed -n '27,1044p' structure_engine.pine
// Any structure change lands there FIRST and flows here line-for-line. Never fix a structure
// bug in this file — engines/market_structure/ is canonical and this file must not become a
// second implementation of it.
//
// ⚠ "Show Internal Structure" IS TRADE-CRITICAL HERE, NOT COSMETIC. The engine gates its whole
// internal state machine on that display toggle (internalActive = showInternal), so turning it
// off silently stops every signal in this file. It is left byte-identical rather than patched,
// and the MSS layer draws a visible warning on the chart instead of failing quietly.
//
// ⚠ NOTHING HERE IS MEASURED. No compile, no Strategy Tester run, no parity gate, no Python
// port. Every default below is a starting point chosen to be legible, not an optimum. The
// stats table exists so the trend filter can be judged from a real chart rather than argued
// about — read "raw" against "signalled" before believing the filter helps.
indicator("MSS Sweeps (MPC)", "MSS Sweeps (MPC)", overlay = true, max_labels_count = 500, max_lines_count = 500)

//============================================================
//  SMC SETTINGS (hardcoded)
//============================================================
int   majorLength = 15
color bullColor   = color.blue
color bearColor   = color.red
color iBullColor  = bullColor
color iBearColor  = bearColor

//============================================================
//  MARKET STRUCTURE — input selection (mirrors mpc_assistant.pine's GRP_STRUCT)
//============================================================
var GRP_STRUCT = "Market Structure"
string structLabelSize  = input.string("Small", "Structure Label Size",    group = GRP_STRUCT, options = ["Tiny", "Small", "Normal", "Large", "Huge"], display = display.none)
bool   showExternal     = input.bool(true,      "Show External Structure", group = GRP_STRUCT, display = display.none)
bool   showInternal     = input.bool(true,      "Show Internal Structure", group = GRP_STRUCT, display = display.none)
bool   showHistoricalInternal = input.bool(false, "Show Historic Internal Structure", group = GRP_STRUCT, tooltip = "Keep internal structure labels and lines from previous swing ranges on the chart. Off = only show current swing range internals.", display = display.none)
bool   showSwingLabels  = input.bool(true, "Show Swing Point Labels", group = GRP_STRUCT, tooltip = "Off = hide ASH/ASL, HH/HL, LH/LL and the internal swing point labels, leaving only BOS/SOS and iBOS/iSOS on the chart. The structure engine keeps running exactly as before — fibs, order blocks and the confirmation table are unaffected.", display = display.none)
float  pbBuffer         = 0.0

f_structSize() =>
    not showExternal ? size.auto : structLabelSize == "Tiny" ? size.tiny : structLabelSize == "Normal" ? size.normal : structLabelSize == "Large" ? size.large : structLabelSize == "Huge" ? size.huge : size.small

// Swing-point labels are hidden by making their text transparent, not by skipping
// their creation. The label objects still exist and the engine's state is untouched,
// so structure tracking, fibs, OBs and the table behave identically either way.
f_swingCol(color c) =>
    showSwingLabels ? c : color(na)

//============================================================
//  SMC STRUCTURE TYPE
//============================================================
type SMCStructure
    int    length
    float  ash             = na
    int    ash_loc         = na
    string ash_type        = ""
    line   ash_line        = na
    label  ash_lbl         = na
    float  asl             = na
    int    asl_loc         = na
    string asl_type        = ""
    line   asl_line        = na
    label  asl_lbl         = na
    float  last_conf_high     = na
    int    last_conf_high_loc = na
    float  last_conf_low      = na
    int    last_conf_low_loc  = na
    int    dir            = 0
    bool   choch_lock     = false
    line   choch_ref      = na
    int    pb_mode        = 0
    int    pb_count       = 0
    float  pb_level       = na
    float  pb_extreme     = na
    int    pb_extreme_loc = na
    line   pb_line        = na
    bool   pb_started     = false
    float  pb_last_qualify_close = na
    float  pb_last_qualify_high  = na
    float  pb_extreme_close      = na
    float  prev_close     = na
    float  prev_high      = na
    float  prev_low       = na
    bool   seeded         = false
    bool   bull_bos       = false
    float  bull_bos_high  = na
    int    bull_bos_h_loc = na
    float  bull_bos_low   = na
    int    bull_bos_l_loc = na
    bool   bear_bos       = false
    float  bear_bos_high  = na
    int    bear_bos_h_loc = na
    float  bear_bos_low   = na
    int    bear_bos_l_loc = na
    bool   new_swing_high = false
    bool   new_swing_low  = false
    bool   bull_sos       = false
    bool   bear_sos       = false

// prefix: "" for external, "i" for internal
// bull_col / bear_col allow per-instance colors
method create_ash(SMCStructure st, float val, int loc, color col, bool solid, string prefix) =>
    if not na(st.ash_line)
        line.delete(st.ash_line)
    if not na(st.ash_lbl)
        label.delete(st.ash_lbl)
        st.ash_lbl := na
    st.ash      := val
    st.ash_loc  := loc
    st.ash_type := ""
    st.ash_lbl  := label.new(loc, val, prefix + "ASH\n", color=color(na), textcolor=f_swingCol(col), style=label.style_label_down, size=f_structSize())
    st.ash_line := line.new(loc, val, bar_index, val, color=col, style=solid ? line.style_solid : line.style_dashed, width=solid ? 2 : 1)

method create_asl(SMCStructure st, float val, int loc, color col, bool solid, string prefix) =>
    if not na(st.asl_line)
        line.delete(st.asl_line)
    if not na(st.asl_lbl)
        label.delete(st.asl_lbl)
        st.asl_lbl := na
    st.asl      := val
    st.asl_loc  := loc
    st.asl_type := ""
    st.asl_lbl  := label.new(loc, val, "\n" + prefix + "ASL", color=color(na), textcolor=f_swingCol(col), style=label.style_label_up, size=f_structSize())
    st.asl_line := line.new(loc, val, bar_index, val, color=col, style=solid ? line.style_solid : line.style_dashed, width=solid ? 2 : 1)

// process() now accepts prefix + bull/bear colors so both instances share one method
method process(SMCStructure st, float ph_val, float pl_val, string prefix, color bull_col, color bear_col) =>

    st.bull_bos := false
    st.bear_bos := false
    st.new_swing_high := false
    st.new_swing_low  := false
    st.bull_sos := false
    st.bear_sos := false

    bool is_inside = false
    if not na(st.prev_high) and not na(st.prev_low)
        is_inside := high < st.prev_high and low > st.prev_low

    if st.choch_lock
        if st.dir == 1 and not na(pl_val)
            st.choch_lock := false
        else if st.dir == -1 and not na(ph_val)
            st.choch_lock := false

    if st.pb_mode == 1
        if not st.pb_started
            st.pb_started            := true
            st.pb_extreme            := high
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_count              := 0
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
        else
            bool extreme_updated_1 = false
            if na(st.pb_extreme) or high > st.pb_extreme
                st.pb_extreme            := high
                st.pb_extreme_loc        := bar_index
                st.pb_extreme_close      := na
                st.pb_count              := 0
                st.pb_last_qualify_close := na
                st.pb_last_qualify_high  := na
                extreme_updated_1        := true
            bool extreme_is_bearish_1 = extreme_updated_1 and close < open
            bool is_candle1_1 = na(st.pb_last_qualify_close) and not extreme_updated_1
            if (not is_inside or is_candle1_1) and (not extreme_updated_1 or extreme_is_bearish_1)
                float threshold = na(st.pb_last_qualify_high) ? st.pb_extreme : st.pb_last_qualify_high
                if close < threshold - pbBuffer
                    st.pb_count              += 1
                    st.pb_last_qualify_close := close
                    st.pb_last_qualify_high  := low
            if st.pb_count >= 3 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
                if not na(st.ash_line)
                    line.delete(st.ash_line)
                if not na(st.ash_lbl)
                    label.delete(st.ash_lbl)
                st.ash      := st.pb_extreme
                st.ash_loc  := st.pb_extreme_loc
                st.ash_type := "LOCKED"
                st.ash_line := line.new(st.pb_extreme_loc, st.pb_extreme, bar_index, st.pb_extreme, color=bear_col, style=line.style_solid, width=1)
                st.ash_lbl  := label.new(st.pb_extreme_loc, st.pb_extreme, prefix + "ASH\n", color=color(na), textcolor=f_swingCol(bear_col), style=label.style_label_down, size=f_structSize())
                st.new_swing_high := true
                st.pb_mode    := 0
                st.pb_count   := 0
                st.choch_lock := false

    else if st.pb_mode == -1
        if not st.pb_started
            st.pb_started            := true
            st.pb_extreme            := low
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_count              := 0
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
        else
            bool extreme_updated_m1 = false
            if na(st.pb_extreme) or low < st.pb_extreme
                st.pb_extreme            := low
                st.pb_extreme_loc        := bar_index
                st.pb_extreme_close      := na
                st.pb_count              := 0
                st.pb_last_qualify_close := na
                st.pb_last_qualify_high  := na
                extreme_updated_m1       := true
            bool extreme_is_bullish_m1 = extreme_updated_m1 and close > open
            bool is_candle1_m1 = na(st.pb_last_qualify_close) and not extreme_updated_m1
            if (not is_inside or is_candle1_m1) and (not extreme_updated_m1 or extreme_is_bullish_m1)
                float threshold = na(st.pb_last_qualify_high) ? st.pb_extreme : st.pb_last_qualify_high
                if close > threshold + pbBuffer
                    st.pb_count              += 1
                    st.pb_last_qualify_close := close
                    st.pb_last_qualify_high  := high
            if st.pb_count >= 3 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
                if not na(st.asl_line)
                    line.delete(st.asl_line)
                if not na(st.asl_lbl)
                    label.delete(st.asl_lbl)
                st.asl      := st.pb_extreme
                st.asl_loc  := st.pb_extreme_loc
                st.asl_type := "LOCKED"
                st.asl_line := line.new(st.pb_extreme_loc, st.pb_extreme, bar_index, st.pb_extreme, color=bull_col, style=line.style_solid, width=1)
                st.asl_lbl  := label.new(st.pb_extreme_loc, st.pb_extreme, "\n" + prefix + "ASL", color=color(na), textcolor=f_swingCol(bull_col), style=label.style_label_up, size=f_structSize())
                st.new_swing_low := true
                st.pb_mode    := 0
                st.pb_count   := 0
                st.choch_lock := false

    st.prev_close := close
    st.prev_high  := high
    st.prev_low   := low

    if na(st.ash) and na(st.asl) and not st.seeded
        if not na(ph_val)
            st.create_ash(ph_val, bar_index[st.length], bear_col, false, prefix)
            st.dir := -1
        else if not na(pl_val)
            st.create_asl(pl_val, bar_index[st.length], bull_col, false, prefix)
            st.dir := 1

    if not st.seeded
        if not na(st.ash) and na(st.asl)
            float seed_low = low
            int   seed_loc = bar_index
            int   lb       = math.min(bar_index, 500)
            for i = 0 to lb
                if low[i] < seed_low
                    seed_low := low[i]
                    seed_loc := bar_index - i
            if seed_low < st.ash
                st.asl      := seed_low
                st.asl_loc  := seed_loc
                st.asl_type := ""
                st.asl_line := line.new(seed_loc, seed_low, bar_index, seed_low, color=bull_col, style=line.style_dashed, width=1)
                st.asl_lbl  := label.new(seed_loc, seed_low, "\n" + prefix + "ASL", color=color(na), textcolor=f_swingCol(bull_col), style=label.style_label_up, size=f_structSize())
                st.seeded := true
        else if not na(st.asl) and na(st.ash)
            float seed_high = high
            int   seed_loc  = bar_index
            int   lb        = math.min(bar_index, 500)
            for i = 0 to lb
                if high[i] > seed_high
                    seed_high := high[i]
                    seed_loc  := bar_index - i
            if seed_high > st.asl
                st.ash      := seed_high
                st.ash_loc  := seed_loc
                st.ash_type := ""
                st.ash_line := line.new(seed_loc, seed_high, bar_index, seed_high, color=bear_col, style=line.style_dashed, width=1)
                st.ash_lbl  := label.new(seed_loc, seed_high, prefix + "ASH\n", color=color(na), textcolor=f_swingCol(bear_col), style=label.style_label_down, size=f_structSize())
                st.seeded := true
        else if not na(st.ash) and not na(st.asl)
            st.seeded := true

    if na(st.last_conf_high) and na(st.last_conf_low)
        if not na(ph_val) and not na(st.ash) and st.ash_type == "" and st.pb_mode == 0
            if ph_val > st.ash
                st.create_ash(ph_val, bar_index[st.length], bear_col, false, prefix)
        if not na(pl_val) and not na(st.asl) and st.asl_type == "" and st.pb_mode == 0
            if pl_val < st.asl
                st.create_asl(pl_val, bar_index[st.length], bull_col, false, prefix)

    bool ash_broken = not na(st.ash) and close > st.ash
    bool asl_broken = not na(st.asl) and close < st.asl

    if ash_broken
        st.bull_bos := true
        st.bull_bos_high  := st.ash
        st.bull_bos_h_loc := st.ash_loc

        bool was_in_bear_pb = st.pb_mode == -1 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
        st.pb_mode  := 0
        st.pb_count := 0

        bool   is_choch    = st.dir == -1
        string brk_lbl_txt = is_choch ? prefix + "SOS" : prefix + "BOS"
        if is_choch
            st.bull_sos := true
        int    mid_x       = math.round((st.ash_loc + bar_index) / 2)
        label.new(mid_x, st.ash, "\n" + brk_lbl_txt, color=color(na), textcolor=bull_col, style=label.style_label_down, size=size.tiny)

        if is_choch
            st.choch_lock := true

        bool brk_already_conf_high = (st.ash == st.last_conf_high and st.ash_loc == st.last_conf_high_loc)
        if not na(st.ash_lbl)
            label.delete(st.ash_lbl)
        if not brk_already_conf_high
            bool   brk_is_hh  = na(st.last_conf_high) or st.ash >= st.last_conf_high
            string brk_high_t = brk_is_hh ? prefix + "HH" : prefix + "LH"
            color  brk_high_c = brk_is_hh ? bull_col : bear_col
            label.new(st.ash_loc, st.ash, brk_high_t + "\n", color=color(na), textcolor=f_swingCol(brk_high_c), style=label.style_label_down, size=f_structSize())

        if not na(st.ash_line)
            line.set_style(st.ash_line, line.style_solid)
            line.set_color(st.ash_line, bull_col)
            line.set_width(st.ash_line, 2)
            line.set_x2(st.ash_line, bar_index)
            st.ash_line := na

        st.last_conf_high     := st.ash
        st.last_conf_high_loc := st.ash_loc
        st.ash_lbl            := na
        st.ash                := na
        st.dir                := 1

        if was_in_bear_pb
            st.bull_bos_low   := st.pb_extreme
            st.bull_bos_l_loc := st.pb_extreme_loc
            if not na(st.asl_line)
                line.delete(st.asl_line)
            if not na(st.asl_lbl)
                label.delete(st.asl_lbl)
            bool   pb_is_hl = is_choch ? false : (na(st.last_conf_low) or st.pb_extreme >= st.last_conf_low)
            // On an SOS (fast reversal) the extreme is only the ACTIVE swing low —
            // it prints as ASL and is confirmed to HL/LL by the NEXT bullish break.
            string pb_low_t = is_choch ? prefix + "ASL" : (pb_is_hl ? prefix + "HL" : prefix + "LL")
            color  pb_low_c = is_choch ? bull_col : (pb_is_hl ? bull_col : bear_col)
            st.asl      := st.pb_extreme
            st.asl_loc  := st.pb_extreme_loc
            st.asl_type := "LOCKED"
            st.asl_line := line.new(st.pb_extreme_loc, st.pb_extreme, bar_index, st.pb_extreme, color=bull_col, style=line.style_solid, width=1)
            st.asl_lbl  := label.new(st.pb_extreme_loc, st.pb_extreme, "\n" + pb_low_t, color=color(na), textcolor=f_swingCol(pb_low_c), style=label.style_label_up, size=f_structSize())
            if not is_choch
                st.last_conf_low     := st.pb_extreme
                st.last_conf_low_loc := st.pb_extreme_loc
            st.pb_extreme            := high
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_mode               := 1
            st.pb_started            := true
        else
            if not na(st.asl)
                bool already_conf_low = (st.asl == st.last_conf_low and st.asl_loc == st.last_conf_low_loc)
                if not already_conf_low
                    bool   old_is_hl = is_choch ? false : (na(st.last_conf_low) or st.asl >= st.last_conf_low)
                    string old_low_t = old_is_hl ? prefix + "HL" : prefix + "LL"
                    color  old_low_c = old_is_hl ? bull_col : bear_col
                    if not na(st.asl_lbl)
                        label.delete(st.asl_lbl)
                    label.new(st.asl_loc, st.asl, "\n" + old_low_t, color=color(na), textcolor=f_swingCol(old_low_c), style=label.style_label_up, size=f_structSize())
                    st.last_conf_low     := st.asl
                    st.last_conf_low_loc := st.asl_loc
                else
                    if not na(st.asl_lbl)
                        label.delete(st.asl_lbl)
                if not na(st.asl_line)
                    line.delete(st.asl_line)
                st.asl_line := na
                st.asl_lbl  := na
                st.asl      := na

            float lowest_val = low
            int   lowest_loc = bar_index
            int   bars_back  = na(st.last_conf_high_loc) ? bar_index : bar_index - st.last_conf_high_loc
            if bars_back > 0
                int max_lb = math.min(math.min(bars_back, 1490), bar_index)
                for i = 0 to max_lb
                    if low[i] < lowest_val
                        lowest_val := low[i]
                        lowest_loc := bar_index - i

            st.bull_bos_low   := lowest_val
            st.bull_bos_l_loc := lowest_loc

            st.asl      := lowest_val
            st.asl_loc  := lowest_loc
            st.asl_type := ""
            st.asl_line := line.new(lowest_loc, lowest_val, bar_index, lowest_val, color=bull_col, style=line.style_solid, width=1)
            if lowest_val != st.last_conf_low
                st.asl_lbl := label.new(lowest_loc, lowest_val, "\n" + prefix + "ASL", color=color(na), textcolor=f_swingCol(bull_col), style=label.style_label_up, size=f_structSize())
            else
                st.asl_lbl := na

            st.pb_mode               := 1
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_extreme            := high
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true

    else if asl_broken
        st.bear_bos := true
        st.bear_bos_low   := st.asl
        st.bear_bos_l_loc := st.asl_loc

        bool was_in_bull_pb = st.pb_mode == 1 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
        st.pb_mode  := 0
        st.pb_count := 0

        bool   is_choch    = st.dir == 1
        string brk_lbl_txt = is_choch ? prefix + "SOS" : prefix + "BOS"
        if is_choch
            st.bear_sos := true
        int    mid_x       = math.round((st.asl_loc + bar_index) / 2)
        label.new(mid_x, st.asl, brk_lbl_txt + "\n", color=color(na), textcolor=bear_col, style=label.style_label_up, size=size.tiny)

        if is_choch
            st.choch_lock := true

        bool brk_already_conf_low = (st.asl == st.last_conf_low and st.asl_loc == st.last_conf_low_loc)
        if not na(st.asl_lbl)
            label.delete(st.asl_lbl)
        if not brk_already_conf_low
            bool   brk_is_hl = na(st.last_conf_low) or st.asl >= st.last_conf_low
            string brk_low_t = brk_is_hl ? prefix + "HL" : prefix + "LL"
            label.new(st.asl_loc, st.asl, "\n" + brk_low_t, color=color(na), textcolor=f_swingCol(bear_col), style=label.style_label_up, size=f_structSize())

        if not na(st.asl_line)
            line.set_style(st.asl_line, line.style_solid)
            line.set_color(st.asl_line, bear_col)
            line.set_width(st.asl_line, 2)
            line.set_x2(st.asl_line, bar_index)
            st.asl_line := na

        st.last_conf_low     := st.asl
        st.last_conf_low_loc := st.asl_loc
        st.asl_lbl           := na
        st.asl               := na
        st.dir               := -1

        if was_in_bull_pb
            st.bear_bos_high  := st.pb_extreme
            st.bear_bos_h_loc := st.pb_extreme_loc
            if not na(st.ash_line)
                line.delete(st.ash_line)
            if not na(st.ash_lbl)
                label.delete(st.ash_lbl)
            bool   pb_is_hh  = na(st.last_conf_high) or st.pb_extreme >= st.last_conf_high
            // On an SOS (fast reversal) the extreme is only the ACTIVE swing high —
            // it prints as ASH and is confirmed to HH/LH by the NEXT bearish break.
            string pb_high_t = is_choch ? prefix + "ASH" : (pb_is_hh ? prefix + "HH" : prefix + "LH")
            color  pb_high_c = is_choch ? bear_col : (pb_is_hh ? bull_col : bear_col)
            st.ash      := st.pb_extreme
            st.ash_loc  := st.pb_extreme_loc
            st.ash_type := "LOCKED"
            st.ash_line := line.new(st.pb_extreme_loc, st.pb_extreme, bar_index, st.pb_extreme, color=bear_col, style=line.style_solid, width=1)
            st.ash_lbl  := label.new(st.pb_extreme_loc, st.pb_extreme, pb_high_t + "\n", color=color(na), textcolor=f_swingCol(pb_high_c), style=label.style_label_down, size=f_structSize())
            if not is_choch
                st.last_conf_high     := st.pb_extreme
                st.last_conf_high_loc := st.pb_extreme_loc
            st.pb_extreme            := low
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_mode               := -1
            st.pb_started            := true
        else
            float highest_val = high
            int   highest_loc = bar_index
            int   bars_back   = na(st.last_conf_low_loc) ? bar_index : bar_index - st.last_conf_low_loc
            if bars_back > 0
                int max_lb = math.min(math.min(bars_back, 1490), bar_index)
                for i = 0 to max_lb
                    if high[i] > highest_val
                        highest_val := high[i]
                        highest_loc := bar_index - i

            if not na(st.ash)
                bool already_conf_high = (st.ash == st.last_conf_high and st.ash_loc == st.last_conf_high_loc)
                if not already_conf_high
                    bool   old_is_hh  = is_choch ? true : (na(st.last_conf_high) or st.ash >= st.last_conf_high)
                    string old_high_t = old_is_hh ? prefix + "HH" : prefix + "LH"
                    color  old_high_c = old_is_hh ? bull_col : bear_col
                    if not na(st.ash_lbl)
                        label.delete(st.ash_lbl)
                    label.new(st.ash_loc, st.ash, old_high_t + "\n", color=color(na), textcolor=f_swingCol(old_high_c), style=label.style_label_down, size=f_structSize())
                    st.last_conf_high     := st.ash
                    st.last_conf_high_loc := st.ash_loc
                else
                    if not na(st.ash_lbl)
                        label.delete(st.ash_lbl)
                if not na(st.ash_line)
                    line.delete(st.ash_line)
                st.ash_line := na
                st.ash_lbl  := na
                st.ash      := na
            else
                // Neither an active pullback high nor a confirmed ASH was available to
                // promote — use the actual highest point since the last confirmed low so
                // a genuine swing high still gets confirmed instead of silently vanishing.
                bool   fallback_is_hh  = na(st.last_conf_high) or highest_val >= st.last_conf_high
                string fallback_high_t = fallback_is_hh ? prefix + "HH" : prefix + "LH"
                color  fallback_high_c = fallback_is_hh ? bull_col : bear_col
                if highest_val != st.last_conf_high
                    label.new(highest_loc, highest_val, fallback_high_t + "\n", color=color(na), textcolor=f_swingCol(fallback_high_c), style=label.style_label_down, size=f_structSize())
                    st.last_conf_high     := highest_val
                    st.last_conf_high_loc := highest_loc

            st.bear_bos_high  := highest_val
            st.bear_bos_h_loc := highest_loc

            st.ash      := highest_val
            st.ash_loc  := highest_loc
            st.ash_type := ""
            st.ash_line := line.new(highest_loc, highest_val, bar_index, highest_val, color=bear_col, style=line.style_solid, width=1)
            if highest_val != st.last_conf_high
                st.ash_lbl := label.new(highest_loc, highest_val, prefix + "ASH\n", color=color(na), textcolor=f_swingCol(bear_col), style=label.style_label_down, size=f_structSize())
            else
                st.ash_lbl := na

            st.pb_mode               := -1
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_extreme            := low
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true

    if not na(st.ash_line)
        line.set_x2(st.ash_line, bar_index)
        if not showExternal
            line.set_color(st.ash_line, color(na))
    if not na(st.asl_line)
        line.set_x2(st.asl_line, bar_index)
        if not showExternal
            line.set_color(st.asl_line, color(na))
    if not showExternal
        if not na(st.ash_lbl)
            label.set_textcolor(st.ash_lbl, color(na))
        if not na(st.asl_lbl)
            label.set_textcolor(st.asl_lbl, color(na))

//============================================================
//  EXECUTION — EXTERNAL STRUCTURE
//============================================================
// External structure engine — majorLength=15, blue/red, prefix ""
var st = SMCStructure.new(majorLength)
ph = ta.pivothigh(high, majorLength, majorLength)
pl = ta.pivotlow(low,  majorLength, majorLength)
// showExternal off → pass color(na) so ALL lines and labels hidden inside process
// showExternal off but showExternal on → pass color(na) for labels only — handled via ASH/ASL override below
color extBullCol = showExternal ? (showExternal ? bullColor : color(na)) : color(na)
color extBearCol = showExternal ? (showExternal ? bearColor : color(na)) : color(na)
st.process(ph, pl, "", extBullCol, extBearCol)

// After process runs — restore line colors when labels are hidden but structure is visible
if not na(st.ash_line)
    line.set_x2(st.ash_line, bar_index)
    if showExternal and not showExternal
        line.set_color(st.ash_line, bullColor)
if not na(st.asl_line)
    line.set_x2(st.asl_line, bar_index)
    if showExternal and not showExternal
        line.set_color(st.asl_line, bearColor)
if not na(st.ash_lbl)
    label.set_textcolor(st.ash_lbl, showExternal ? f_swingCol(bearColor) : color(na))
if not na(st.asl_lbl)
    label.set_textcolor(st.asl_lbl, showExternal ? f_swingCol(bullColor) : color(na))

//============================================================
//  EXECUTION — INTERNAL STRUCTURE
//============================================================
// Internal structure — Step 2: pullback tracking to confirm iSH / iSL

// ── State ─────────────────────────────────────────────────
var int   i_mode           = 0
var bool  i_seeded         = false

// Pullback tracking
var float i_pb_extreme     = na
var int   i_pb_extreme_loc = na
var int   i_pb_count       = 0
var bool  i_pb_started     = false
var float i_pb_lqc         = na
var float i_pb_lqh         = na
var float i_prev_high      = na
var float i_prev_low       = na

// Active swing level (iSH or iSL)
var float i_sw_price       = na
var int   i_sw_loc         = na
var line  i_sw_line        = na
var label i_sw_lbl         = na

// Pre-declared locals (Pine v6)
var bool  i_ext_chg        = false
var bool  i_is_inside      = false
var bool  i_ext_dir        = false
var bool  i_is_c1          = false
var float i_thresh         = na

var float i_tracked_ext     = na
var int   i_tracked_ext_loc = na
var int   i_last_mode       = 0   // remembers what mode confirmed the swing
var bool  i_had_bos         = false
var int   i_bos_dir         = 0
var string i_h_lbl          = ""
var color  i_h_col          = color.black
var string i_l_lbl          = ""
var color  i_l_col          = color.black
var int   i_mid             = 0
var int   i_mid2            = 0
var float i_last_hl         = na   // last confirmed iHL price (for iSOS in bullish cycle)

var float i_last_lh         = na   // last confirmed iLH price (for iSOS in bearish cycle)
var int   i_last_hl_loc     = na
var int   i_last_lh_loc     = na

var float i_sos_watch_hh    = na
var int   i_sos_watch_hh_loc= na
var float i_sos_watch_ll    = na
var int   i_sos_watch_ll_loc= na

float i_lbl_y_offset = syminfo.mintick * 20   // vertical offset for iBOS/iSOS (smaller number = closer to the line)

// Internal structure is naturally scoped to the current active external swing —
// it resets on every external SOS/CHoCH (see block right below).
bool internalActive = showInternal

// Tracks every internal-structure label/line drawn during the current external
// swing, so they can be wiped when a new swing starts (unless showHistoricalInternal is on).
var array<label> intHistLabels = array.new<label>()
var array<line>  intHistLines  = array.new<line>()

// ── Stop internal tracking on external SOS ───────────────

if internalActive and (st.bull_bos or st.bear_bos or st.bull_sos or st.bear_sos)
    if not na(i_sw_line)
        line.set_x2(i_sw_line, bar_index)
        i_sw_line := na
    i_sw_lbl          := na
    i_sw_price        := na
    i_mode            := 0
    i_seeded          := false
    i_pb_count        := 0
    i_pb_started      := false
    i_tracked_ext     := na
    i_tracked_ext_loc := na
    i_last_hl         := na
    i_last_lh         := na
    i_had_bos         := false
    i_sos_watch_hh    := na
    i_sos_watch_ll    := na
    // Past swing just ended — wipe its internal structure unless history is enabled
    if not showHistoricalInternal
        if array.size(intHistLabels) > 0
            for i = 0 to array.size(intHistLabels) - 1
                label.delete(array.get(intHistLabels, i))
        if array.size(intHistLines) > 0
            for i = 0 to array.size(intHistLines) - 1
                line.delete(array.get(intHistLines, i))
    array.clear(intHistLabels)
    array.clear(intHistLines)

// ── Track prev bar ────────────────────────────────────────
if internalActive
    i_prev_high := high
    i_prev_low  := low


// ── Seed on new external swing ────────────────────────────
if internalActive
    if st.new_swing_low and not st.bull_sos and not st.bear_sos
        i_mode            := 1
        i_seeded          := true
        i_had_bos         := false
        i_bos_dir         := 0
        i_pb_started      := false
        i_pb_extreme      := na
        i_pb_count        := 0
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_mode       := 1
        i_last_hl         := na
        i_last_lh         := na
        i_sos_watch_hh    := na
        i_sos_watch_ll    := na
    else if st.new_swing_high and not st.bull_sos and not st.bear_sos
        i_mode            := -1
        i_seeded          := true
        i_had_bos         := false
        i_bos_dir         := 0
        i_pb_started      := false
        i_pb_extreme      := na
        i_pb_count        := 0
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_mode       := -1
        i_last_hl         := na
        i_last_lh         := na
        i_sos_watch_hh    := na
        i_sos_watch_ll    := na

// ── Mode 1: track upward move → confirm iSH ──────────────
if internalActive and i_seeded and i_mode == 1
    if not i_pb_started
        i_pb_started     := true
        i_pb_extreme     := high
        i_pb_extreme_loc := bar_index
        i_pb_count       := 0
        i_pb_lqc         := na
        i_pb_lqh         := na
    else
        // Update extreme if new high
        i_ext_chg := false
        if high > i_pb_extreme
            i_pb_extreme     := high
            i_pb_extreme_loc := bar_index
            i_pb_count       := 0
            i_pb_lqc         := na
            i_pb_lqh         := na
            i_ext_chg        := true
        // is_inside and qualifying bar checks (exact external rule)
        i_is_inside := not na(i_prev_high) and not na(i_prev_low) and high < i_prev_high and low > i_prev_low
        i_ext_dir   := i_ext_chg and close < open
        i_is_c1     := na(i_pb_lqc) and not i_ext_chg
        if (not i_is_inside or i_is_c1) and (not i_ext_chg or i_ext_dir)
            i_thresh := na(i_pb_lqh) ? i_pb_extreme : i_pb_lqh
            if close < i_thresh - pbBuffer
                i_pb_count += 1
                i_pb_lqc   := close
                i_pb_lqh   := low
        // 3 bars confirmed → iSH
        if i_pb_count >= 3 and not na(i_pb_extreme)
            if not na(i_sw_line)
                line.set_x2(i_sw_line, bar_index)
            i_sw_line  := na
            i_sw_lbl   := na
            i_sw_price := i_pb_extreme
            i_sw_loc   := i_pb_extreme_loc
            // Label: iSH if first swing, iHH if higher than last, iLH if lower
            i_h_lbl := not i_had_bos ? "iSH" : "iHH"
            i_h_col := not i_had_bos ? iBearColor : iBullColor
            i_sw_line  := line.new(i_sw_loc, i_sw_price, bar_index, i_sw_price, color = showInternal ? color.new(i_h_col, 15) : color(na), style = line.style_dotted, width = 1)
            i_sw_lbl   := label.new(i_sw_loc, i_sw_price, i_h_lbl + "\n", color = color(na), textcolor=f_swingCol(color.new(i_h_col, 15)), style = label.style_label_down, size = size.tiny)
            array.push(intHistLines, i_sw_line)
            array.push(intHistLabels, i_sw_lbl)
            i_mode       := 0
            i_pb_count   := 0
            i_pb_started := false

// ── Mode -1: track downward move → confirm iSL ───────────
if internalActive and i_seeded and i_mode == -1
    if not i_pb_started
        i_pb_started     := true
        i_pb_extreme     := low
        i_pb_extreme_loc := bar_index
        i_pb_count       := 0
        i_pb_lqc         := na
        i_pb_lqh         := na
    else
        // Update extreme if new low
        i_ext_chg := false
        if low < i_pb_extreme
            i_pb_extreme     := low
            i_pb_extreme_loc := bar_index
            i_pb_count       := 0
            i_pb_lqc         := na
            i_pb_lqh         := na
            i_ext_chg        := true
        // is_inside and qualifying bar checks
        i_is_inside := not na(i_prev_high) and not na(i_prev_low) and high < i_prev_high and low > i_prev_low
        i_ext_dir   := i_ext_chg and close > open
        i_is_c1     := na(i_pb_lqc) and not i_ext_chg
        if (not i_is_inside or i_is_c1) and (not i_ext_chg or i_ext_dir)
            i_thresh := na(i_pb_lqh) ? i_pb_extreme : i_pb_lqh
            if close > i_thresh + pbBuffer
                i_pb_count += 1
                i_pb_lqc   := close
                i_pb_lqh   := high
        // 3 bars confirmed → iSL
        if i_pb_count >= 3 and not na(i_pb_extreme)
            if not na(i_sw_line)
                line.set_x2(i_sw_line, bar_index)
            i_sw_line  := na
            i_sw_lbl   := na
            i_sw_price := i_pb_extreme
            i_sw_loc   := i_pb_extreme_loc
            // Label: iSL if first swing, iLL if lower than last, iHL if higher
            i_l_lbl := not i_had_bos ? "iSL" : "iLL"
            i_l_col := not i_had_bos ? iBullColor : iBearColor
            i_sw_line  := line.new(i_sw_loc, i_sw_price, bar_index, i_sw_price, color = showInternal ? color.new(i_l_col, 15) : color(na), style = line.style_dotted, width = 1)
            i_sw_lbl   := label.new(i_sw_loc, i_sw_price, "\n" + i_l_lbl, color = color(na), textcolor=f_swingCol(color.new(i_l_col, 15)), style = label.style_label_up, size = size.tiny)
            array.push(intHistLines, i_sw_line)
            array.push(intHistLabels, i_sw_lbl)
            i_mode       := 0
            i_pb_count   := 0
            i_pb_started := false

// ── Track extreme while watching (mode 0) ────────────────
if internalActive and i_seeded and i_mode == 0
    if i_last_mode == 1
        if na(i_tracked_ext) or low < i_tracked_ext
            i_tracked_ext     := low
            i_tracked_ext_loc := bar_index
    else if i_last_mode == -1
        if na(i_tracked_ext) or high > i_tracked_ext
            i_tracked_ext     := high
            i_tracked_ext_loc := bar_index

// ── iBOS / iSOS detection ────────────────────────────────
bool int_bull_break = false
bool int_bear_break = false
bool int_bull_bos   = false
bool int_bull_sos   = false
bool int_bear_bos   = false
bool int_bear_sos   = false
int  int_break_origin_loc = na

if internalActive and i_mode == 0 and i_seeded and not na(i_sw_price) and barstate.isconfirmed
    if close > i_sw_price and i_last_mode == 1
        i_mid := math.round((i_sw_loc + bar_index) / 2)
        label iBullBOSLbl = label.new(i_mid, i_sw_price + i_lbl_y_offset, "iBOS", color = color(na), textcolor = showInternal ? iBullColor : color(na), style = label.style_none, size = size.tiny, textalign = text.align_center)
        array.push(intHistLabels, iBullBOSLbl)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sw_line := na
        i_sw_lbl := na
        if not na(i_tracked_ext)
            line  iHLLine = line.new(i_tracked_ext_loc, i_tracked_ext, bar_index, i_tracked_ext, color = showInternal ? color.new(iBullColor, 15) : color(na), style = line.style_dotted, width = 1)
            label iHLLbl  = label.new(i_tracked_ext_loc, i_tracked_ext, "\niHL", color = color(na), textcolor=f_swingCol(color.new(iBullColor, 15)), style = label.style_label_up, size = size.tiny)
            array.push(intHistLines, iHLLine)
            array.push(intHistLabels, iHLLbl)
            i_last_hl     := i_tracked_ext
            i_last_hl_loc := i_tracked_ext_loc
        
        int_bull_break := true
        int_bull_bos   := true
        int_break_origin_loc := i_tracked_ext_loc

        i_sw_price       := na
        i_tracked_ext    := na
        i_tracked_ext_loc := na
        i_pb_count       := 0
        i_pb_started     := false
        i_pb_lqc         := na
        i_pb_lqh         := na
        i_had_bos        := true
        i_bos_dir        := 1
        i_last_mode      := 1
        i_mode           := 1
        i_sos_watch_ll   := na

    else if close < i_sw_price and i_last_mode == -1
        i_mid2 := math.round((i_sw_loc + bar_index) / 2)
        label iBearBOSLbl = label.new(i_mid2, i_sw_price, "iBOS", color = color(na), textcolor = showInternal ? iBearColor : color(na), style = label.style_label_up, size = size.tiny, textalign = text.align_center)
        array.push(intHistLabels, iBearBOSLbl)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sw_line := na
        i_sw_lbl := na
        if not na(i_tracked_ext)
            line  iLHLine = line.new(i_tracked_ext_loc, i_tracked_ext, bar_index, i_tracked_ext, color = showInternal ? color.new(iBearColor, 15) : color(na), style = line.style_dotted, width = 1)
            label iLHLbl  = label.new(i_tracked_ext_loc, i_tracked_ext, "iLH\n", color = color(na), textcolor=f_swingCol(color.new(iBearColor, 15)), style = label.style_label_down, size = size.tiny)
            array.push(intHistLines, iLHLine)
            array.push(intHistLabels, iLHLbl)
            i_last_lh     := i_tracked_ext
            i_last_lh_loc := i_tracked_ext_loc
            
        int_bear_break := true
        int_bear_bos   := true
        int_break_origin_loc := i_tracked_ext_loc

        i_sw_price        := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_pb_count        := 0
        i_pb_started      := false
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_had_bos         := true
        i_bos_dir         := -1
        i_last_mode       := -1
        i_mode            := -1
        i_sos_watch_hh    := na



// ── iSOS detection (watches last iHL / iLH) ──────────────
if internalActive and i_seeded and i_had_bos and barstate.isconfirmed
    if i_last_mode == 1 and not na(i_last_hl) and close < i_last_hl and i_mode == 0
        i_mid2 := math.round((i_last_hl_loc + bar_index) / 2)
        label iSOS1Lbl = label.new(i_mid2, i_last_hl, "iSOS", color = color(na), textcolor = showInternal ? iBearColor : color(na), style = label.style_label_up, size = size.tiny, textalign = text.align_center)
        line  iSOS1Line = line.new(i_last_hl_loc, i_last_hl, bar_index, i_last_hl, color = showInternal ? color.new(iBearColor, 15) : color(na), style = line.style_dotted, width = 1)
        array.push(intHistLabels, iSOS1Lbl)
        array.push(intHistLines, iSOS1Line)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sw_line := na
        
        i_sos_watch_hh     := i_sw_price
        i_sos_watch_hh_loc := i_sw_loc
        i_sos_watch_ll     := na
        
        int_bear_break := true
        int_bear_sos   := true
        int_break_origin_loc := i_sw_loc

        i_sw_lbl          := na
        i_sw_price        := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_hl         := na
        i_pb_count        := 0
        i_pb_started      := false
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_last_mode       := -1
        i_mode            := -1

    else if i_last_mode == -1 and not na(i_last_lh) and close > i_last_lh and i_mode == 0
        i_mid := math.round((i_last_lh_loc + bar_index) / 2)
        label iSOS2Lbl = label.new(i_mid, i_last_lh + i_lbl_y_offset, "iSOS", color = color(na), textcolor = showInternal ? iBullColor : color(na), style = label.style_none, size = size.tiny, textalign = text.align_center)
        line  iSOS2Line = line.new(i_last_lh_loc, i_last_lh, bar_index, i_last_lh, color = showInternal ? color.new(iBullColor, 15) : color(na), style = line.style_dotted, width = 1)
        array.push(intHistLabels, iSOS2Lbl)
        array.push(intHistLines, iSOS2Line)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sw_line := na
            
        i_sos_watch_ll     := i_sw_price
        i_sos_watch_ll_loc := i_sw_loc
        i_sos_watch_hh     := na
        
        int_bull_break := true
        int_bull_sos   := true
        int_break_origin_loc := i_sw_loc

        i_sw_lbl          := na
        i_sw_price        := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_lh         := na
        i_pb_count        := 0
        i_pb_started      := false
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_last_mode       := 1
        i_mode            := 1

    else if i_last_mode == -1 and not na(i_sos_watch_hh) and close > i_sos_watch_hh and i_mode == 0
        i_mid := math.round((i_sos_watch_hh_loc + bar_index) / 2)
        label iSOS3Lbl = label.new(i_mid, i_sos_watch_hh + i_lbl_y_offset, "iSOS", color = color(na), textcolor = showInternal ? iBullColor : color(na), style = label.style_none, size = size.tiny, textalign = text.align_center)
        line  iSOS3Line = line.new(i_sos_watch_hh_loc, i_sos_watch_hh, bar_index, i_sos_watch_hh, color = showInternal ? color.new(iBullColor, 15) : color(na), style = line.style_dotted, width = 1)
        array.push(intHistLabels, iSOS3Lbl)
        array.push(intHistLines, iSOS3Line)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sw_line := na
            
        i_sos_watch_ll     := i_sw_price
        i_sos_watch_ll_loc := i_sw_loc
        
        int_bull_break := true
        int_bull_sos   := true
        int_break_origin_loc := i_sw_loc

        i_sw_lbl          := na
        i_sw_price        := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_lh         := na
        i_pb_count        := 0
        i_pb_started      := false
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_last_mode       := 1
        i_mode            := 1
        i_sos_watch_hh    := na

    else if i_last_mode == 1 and not na(i_sos_watch_ll) and close < i_sos_watch_ll and i_mode == 0
        i_mid2 := math.round((i_sos_watch_ll_loc + bar_index) / 2)
        label iSOS4Lbl = label.new(i_mid2, i_sos_watch_ll, "iSOS", color = color(na), textcolor = showInternal ? iBearColor : color(na), style = label.style_label_up, size = size.tiny, textalign = text.align_center)
        line  iSOS4Line = line.new(i_sos_watch_ll_loc, i_sos_watch_ll, bar_index, i_sos_watch_ll, color = showInternal ? color.new(iBearColor, 15) : color(na), style = line.style_dotted, width = 1)
        array.push(intHistLabels, iSOS4Lbl)
        array.push(intHistLines, iSOS4Line)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sw_line := na
            
        i_sos_watch_hh     := i_sw_price
        i_sos_watch_hh_loc := i_sw_loc
        
        int_bear_break := true
        int_bear_sos   := true
        int_break_origin_loc := i_sw_loc

        i_sw_lbl          := na
        i_sw_price        := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_hl         := na
        i_pb_count        := 0
        i_pb_started      := false
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_last_mode       := -1
        i_mode            := -1
        i_sos_watch_ll    := na

// ── Update last_mode when mode changes ───────────────────
if internalActive and i_mode != 0
    i_last_mode := i_mode

// ── Extend active swing line every bar ────────────────────
if internalActive and not na(i_sw_line)
    line.set_x2(i_sw_line, bar_index)

//============================================================
//  MSS SWEEPS — the trigger layer
//============================================================
// Everything below this line is new. Everything above it is structure_engine.pine.
//
// The sequence, stated once so the code can be read against it:
//   1. our internal engine prints an iBOS (a CONTINUATION break, not a character change)
//   2. that break leaves a protected swing behind it — the iHL under a bull iBOS, the iLH
//      above a bear iBOS. That level is where the stops are
//   3. price WICKS through it and CLOSES back on the original side, with a real body
//   4. that is the signal
// A close THROUGH the level and staying there is not a sweep, it is a failure, and it disarms.

var string GRP_MSS   = "MSS Sweeps"
var string GRP_TREND = "MSS Trend Filter"
var string GRP_MSSTY = "MSS Style"

// ── Trigger shape ────────────────────────────────────────
bool  msShow          = input.bool(true,  "Show MSS sweeps",                group = GRP_MSS, tooltip = "The signal itself. Off leaves the protected levels drawn but prints nothing.")
bool  msShowLevel     = input.bool(true,  "Show protected level",           group = GRP_MSS, tooltip = "Extend the iHL/iLH the last iBOS left behind, until it is swept, failed, or invalidated.")
bool  msShowFiltered  = input.bool(true,  "Show filtered-out sweeps (grey)",group = GRP_MSS, tooltip = "Draw the sweeps the trend filter REJECTED, in grey. This is how you judge whether the filter is helping or just cutting the sample. Turn it off once you have decided.")
int   msMaxBars       = input.int(60, "Protected level expires after (bars)", minval = 0, maxval = 500, group = GRP_MSS, tooltip = "A level nobody has come back to for this many bars is no longer the level the market is defending. 0 = never expire. UNMEASURED — 60 is a legible starting point, not an optimum.")
float msMaxDepthAtr   = input.float(1.0, "Max sweep depth (ATR)",  minval = 0.0, step = 0.1, group = GRP_MSS, tooltip = "How far price may go BEYOND the level and still count as a sweep. Deeper than this is a breakdown wearing a sweep's clothes. 0 = no cap.")
float msMinReclaimAtr = input.float(0.1, "Min reclaim beyond level (ATR)", minval = 0.0, step = 0.05, group = GRP_MSS, tooltip = "The close must reclaim the level by this much, so a bar closing one tick back over it does not count. 0 = any close on the right side.")

// ── Trend filter — the whole point of this fork ──────────
// LuxAlgo's version has ONE degree of structure and therefore cannot ask this question.
// Ours has two, so the filter is our own external engine rather than a bolted-on average.
string msTrendMode = input.string("External structure", "Trend filter", options = ["Off", "External structure", "External + internal agree"], group = GRP_TREND, tooltip = "Off = every sweep prints (this is roughly what the LuxAlgo original does). External structure = the sweep must point the same way as our external engine's direction, st.dir. External + internal agree = both degrees must point that way.")
int    msMinBos    = input.int(1, "Min continuation breaks in trend", minval = 0, maxval = 10, group = GRP_TREND, tooltip = "How many iBOS the current internal run must have printed before its sweeps count. A trend is a SEQUENCE of continuation breaks, not one. 0 = off. This gate is independent of the dropdown above, so each can be judged on its own.")
bool   msBlockOnExt = input.bool(true, "Disarm on opposing external SOS", group = GRP_TREND, tooltip = "An external change of character against the armed direction throws the level away. This is the case the LuxAlgo original gets wrong: there, only the opposite BOS disarms, so a stale level stays live through a whole counter-leg.")

// ── Style / diagnostics ──────────────────────────────────
color msBullCol  = input.color(#089981, "Bullish sweep",  group = GRP_MSSTY)
color msBearCol  = input.color(#f23645, "Bearish sweep",  group = GRP_MSSTY)
color msLevelCol = input.color(#5b9cf6, "Protected level", group = GRP_MSSTY)
bool  msShowStats = input.bool(true, "Show stats table", group = GRP_MSSTY, tooltip = "Counts raw sweeps against signalled ones. Read them together — 'signalled' alone says nothing about whether the filter earned its place.")

float msAtr = ta.atr(14)

// ── Trend run tracking ───────────────────────────────────
// An iSOS is a change of character, so it STARTS a run at zero. Each iBOS after it is one
// continuation. This is the same shape as mpc_d_strategy.pine's dTrendBos and is deliberately
// counted here rather than read off the engine, which does not expose a run length.
var int msRunDir   = 0
var int msRunCount = 0

if int_bull_sos
    msRunDir   := 1
    msRunCount := 0
if int_bear_sos
    msRunDir   := -1
    msRunCount := 0
if int_bull_bos
    msRunCount := msRunDir == 1 ? msRunCount + 1 : 1
    msRunDir   := 1
if int_bear_bos
    msRunCount := msRunDir == -1 ? msRunCount + 1 : 1
    msRunDir   := -1

// ── Armed state ──────────────────────────────────────────
var int   msArmDir   = 0
var float msArmLevel = na
var int   msArmLoc   = na
var int   msArmBar   = na
var line  msArmLine  = na

// ── Counters, for the stats table ────────────────────────
var int msCntArmed    = 0
var int msCntRaw      = 0
var int msCntSignal   = 0
var int msCntFiltered = 0
var int msCntFailed   = 0
var int msCntExpired  = 0

// ── Sweep test ───────────────────────────────────────────
// ⚠ THIS BLOCK RUNS BEFORE THE ARM BLOCK ON PURPOSE. On an iBOS bar the level being armed is
// brand new, and price on that same bar has usually already traded through where it sits. If
// the order were reversed, a fresh level would sweep itself on the bar it was created.
bool msWickLow  = msArmDir ==  1 and not na(msArmLevel) and low  < msArmLevel
bool msWickHigh = msArmDir == -1 and not na(msArmLevel) and high > msArmLevel

float msDepthLow  = msWickLow  ? msArmLevel - low  : na
float msDepthHigh = msWickHigh ? high - msArmLevel : na
bool  msDepthOkLo = msMaxDepthAtr <= 0 or na(msAtr) or msDepthLow  <= msMaxDepthAtr * msAtr
bool  msDepthOkHi = msMaxDepthAtr <= 0 or na(msAtr) or msDepthHigh <= msMaxDepthAtr * msAtr

float msReclaimBuf = na(msAtr) ? 0.0 : msMinReclaimAtr * msAtr
bool  msReclaimLo  = close > msArmLevel + msReclaimBuf and close > open
bool  msReclaimHi  = close < msArmLevel - msReclaimBuf and close < open

bool msSweepLow  = barstate.isconfirmed and msWickLow  and msDepthOkLo and msReclaimLo
bool msSweepHigh = barstate.isconfirmed and msWickHigh and msDepthOkHi and msReclaimHi
bool msFailLow   = barstate.isconfirmed and msWickLow  and not msSweepLow
bool msFailHigh  = barstate.isconfirmed and msWickHigh and not msSweepHigh

// ── The trend gate ───────────────────────────────────────
// Evaluated at SWEEP time, never at arm time. The trend has to still be intact when the
// signal prints, and arming unconditionally is what lets the stats table report what the
// filter actually removed.
bool msExtOkLong  = msTrendMode == "Off" ? true : msTrendMode == "External structure" ? st.dir ==  1 : (st.dir ==  1 and msRunDir ==  1)
bool msExtOkShort = msTrendMode == "Off" ? true : msTrendMode == "External structure" ? st.dir == -1 : (st.dir == -1 and msRunDir == -1)
bool msRunOk      = msRunCount >= msMinBos

bool msSignalLow  = msSweepLow  and msExtOkLong  and msRunOk
bool msSignalHigh = msSweepHigh and msExtOkShort and msRunOk

// ── Draw and disarm ──────────────────────────────────────
f_msCloseLine() =>
    if not na(msArmLine)
        line.set_x2(msArmLine, bar_index)
        line.set_extend(msArmLine, extend.none)
    int _done = 0

if msSweepLow
    msCntRaw += 1
    if msSignalLow
        msCntSignal += 1
        if msShow
            label.new(bar_index, low, "HL sweep", style = label.style_label_up, color = msBullCol, textcolor = chart.fg_color, size = size.small, tooltip = "Bullish MSS sweep\nProtected iHL: " + str.tostring(msArmLevel, format.mintick) + "\nHeld for " + str.tostring(bar_index - msArmBar) + " bars\nContinuation breaks in run: " + str.tostring(msRunCount))
    else
        msCntFiltered += 1
        if msShowFiltered
            label.new(bar_index, low, "hl", style = label.style_label_up, color = color.new(color.gray, 45), textcolor = chart.fg_color, size = size.tiny, tooltip = "REJECTED by the trend filter.\nExternal direction: " + (st.dir == 1 ? "bullish" : st.dir == -1 ? "bearish" : "none") + "\nContinuation breaks in run: " + str.tostring(msRunCount) + " (need " + str.tostring(msMinBos) + ")")
    f_msCloseLine()
    msArmDir := 0
    msArmLevel := na
    msArmLoc := na
    msArmBar := na
    msArmLine := na
else if msFailLow
    msCntFailed += 1
    f_msCloseLine()
    msArmDir := 0
    msArmLevel := na
    msArmLoc := na
    msArmBar := na
    msArmLine := na

if msSweepHigh
    msCntRaw += 1
    if msSignalHigh
        msCntSignal += 1
        if msShow
            label.new(bar_index, high, "LH sweep", style = label.style_label_down, color = msBearCol, textcolor = chart.fg_color, size = size.small, tooltip = "Bearish MSS sweep\nProtected iLH: " + str.tostring(msArmLevel, format.mintick) + "\nHeld for " + str.tostring(bar_index - msArmBar) + " bars\nContinuation breaks in run: " + str.tostring(msRunCount))
    else
        msCntFiltered += 1
        if msShowFiltered
            label.new(bar_index, high, "lh", style = label.style_label_down, color = color.new(color.gray, 45), textcolor = chart.fg_color, size = size.tiny, tooltip = "REJECTED by the trend filter.\nExternal direction: " + (st.dir == 1 ? "bullish" : st.dir == -1 ? "bearish" : "none") + "\nContinuation breaks in run: " + str.tostring(msRunCount) + " (need " + str.tostring(msMinBos) + ")")
    f_msCloseLine()
    msArmDir := 0
    msArmLevel := na
    msArmLoc := na
    msArmBar := na
    msArmLine := na
else if msFailHigh
    msCntFailed += 1
    f_msCloseLine()
    msArmDir := 0
    msArmLevel := na
    msArmLoc := na
    msArmBar := na
    msArmLine := na

// ── Invalidation that is NOT a sweep ─────────────────────
// 🔴 This is the defect in the LuxAlgo original, fixed. There, the armed direction survives an
// opposite CHOCH and is only overwritten by an opposite BOS — which needs a character change
// PLUS a second break — so a stale bullish level stays live through an entire confirmed
// bearish leg and can print a long signal into it. Here any shift against the armed direction,
// at either degree, throws the level away.
bool msShiftAgainst = (msArmDir ==  1 and (int_bear_sos or int_bear_bos)) or (msArmDir == -1 and (int_bull_sos or int_bull_bos))
bool msExtAgainst   = msBlockOnExt and ((msArmDir == 1 and st.bear_sos) or (msArmDir == -1 and st.bull_sos))
bool msStale        = msMaxBars > 0 and msArmDir != 0 and not na(msArmBar) and (bar_index - msArmBar) > msMaxBars

if msArmDir != 0 and (msShiftAgainst or msExtAgainst or msStale)
    if msStale and not msShiftAgainst and not msExtAgainst
        msCntExpired += 1
    f_msCloseLine()
    msArmDir := 0
    msArmLevel := na
    msArmLoc := na
    msArmBar := na
    msArmLine := na

// ── Arm on a continuation break ──────────────────────────
// Armed UNCONDITIONALLY — the trend filter is applied to the signal, not to the arming, so
// that the stats table can report what it removed. i_last_hl / i_last_lh are the engine's own
// confirmed pullback extremes; they are read rather than re-derived, so this file cannot
// disagree with the structure drawn on the chart.
// ⚠ The freshness test is not defensive noise. The engine writes i_last_hl only when it has a
// tracked pullback extreme to write; when it does not, the variable KEEPS ITS PREVIOUS VALUE
// rather than going na, so `not na(i_last_hl)` alone would happily arm on an iHL left over from
// an earlier internal cycle. Requiring the LOCATION to have moved this bar is what makes the
// level the one this break actually left behind. Stale-level arming is the exact defect this
// fork exists to fix; it must not be reintroduced from the other end.
bool msArmBull = int_bull_bos and not na(i_last_hl) and (na(i_last_hl_loc[1]) or i_last_hl_loc != i_last_hl_loc[1])
bool msArmBear = int_bear_bos and not na(i_last_lh) and (na(i_last_lh_loc[1]) or i_last_lh_loc != i_last_lh_loc[1])

if msArmBull
    f_msCloseLine()
    msArmDir   := 1
    msArmLevel := i_last_hl
    msArmLoc   := i_last_hl_loc
    msArmBar   := bar_index
    msCntArmed += 1
    msArmLine  := msShowLevel ? line.new(msArmLoc, msArmLevel, bar_index, msArmLevel, xloc = xloc.bar_index, extend = extend.right, color = msLevelCol, style = line.style_dashed, width = 1) : na

if msArmBear
    f_msCloseLine()
    msArmDir   := -1
    msArmLevel := i_last_lh
    msArmLoc   := i_last_lh_loc
    msArmBar   := bar_index
    msCntArmed += 1
    msArmLine  := msShowLevel ? line.new(msArmLoc, msArmLevel, bar_index, msArmLevel, xloc = xloc.bar_index, extend = extend.right, color = msLevelCol, style = line.style_dashed, width = 1) : na

// ── Stats table ──────────────────────────────────────────
// Read "raw" against "signalled". A filter that removes most of the sample and leaves the same
// hit rate has not helped; it has just made the sample smaller. That question is settled by
// replaying it, not by this table — the table only tells you how big the difference IS.
var table msTbl = table.new(position.top_right, 2, 8, border_width = 1)

if barstate.islast and msShowStats
    table.cell(msTbl, 0, 0, "MSS Sweeps (MPC)", text_color = chart.fg_color, text_size = size.small, bgcolor = color.new(msLevelCol, 70))
    table.cell(msTbl, 1, 0, msTrendMode == "Off" ? "filter OFF" : "filter ON", text_color = chart.fg_color, text_size = size.small, bgcolor = color.new(msLevelCol, 70))
    table.cell(msTbl, 0, 1, "Levels armed",   text_color = chart.fg_color, text_size = size.small)
    table.cell(msTbl, 1, 1, str.tostring(msCntArmed),  text_color = chart.fg_color, text_size = size.small)
    table.cell(msTbl, 0, 2, "Sweeps (raw)",   text_color = chart.fg_color, text_size = size.small)
    table.cell(msTbl, 1, 2, str.tostring(msCntRaw),    text_color = chart.fg_color, text_size = size.small)
    table.cell(msTbl, 0, 3, "Signalled",      text_color = msBullCol, text_size = size.small)
    table.cell(msTbl, 1, 3, str.tostring(msCntSignal), text_color = msBullCol, text_size = size.small)
    table.cell(msTbl, 0, 4, "Cut by filter",  text_color = color.gray, text_size = size.small)
    table.cell(msTbl, 1, 4, str.tostring(msCntFiltered) + (msCntRaw > 0 ? "  (" + str.tostring(math.round(100.0 * msCntFiltered / msCntRaw)) + "%)" : ""), text_color = color.gray, text_size = size.small)
    table.cell(msTbl, 0, 5, "Failed reclaim", text_color = msBearCol, text_size = size.small)
    table.cell(msTbl, 1, 5, str.tostring(msCntFailed), text_color = msBearCol, text_size = size.small)
    table.cell(msTbl, 0, 6, "Expired unused", text_color = chart.fg_color, text_size = size.small)
    table.cell(msTbl, 1, 6, str.tostring(msCntExpired), text_color = chart.fg_color, text_size = size.small)
    table.cell(msTbl, 0, 7, "Armed now",      text_color = chart.fg_color, text_size = size.small)
    table.cell(msTbl, 1, 7, msArmDir == 1 ? "bullish @ " + str.tostring(msArmLevel, format.mintick) : msArmDir == -1 ? "bearish @ " + str.tostring(msArmLevel, format.mintick) : "—", text_color = chart.fg_color, text_size = size.small)

// ── The silent-failure guard ─────────────────────────────
// internalActive = showInternal in the engine block above, so the display toggle switches off
// the state machine this whole file reads. Rather than patch the engine (it stays byte-
// identical) or fail quietly, say so on the chart.
var label msWarnLbl = na
if barstate.islast
    if not na(msWarnLbl)
        label.delete(msWarnLbl)
        msWarnLbl := na
    if not showInternal
        msWarnLbl := label.new(bar_index, high, "MSS SWEEPS DISABLED\nturn on \"Show Internal Structure\"", style = label.style_label_down, color = color.new(color.orange, 20), textcolor = color.white, size = size.normal)

// ── Alerts ───────────────────────────────────────────────
// Every one of these is confirmed-bar only. The engine's breaks already require
// barstate.isconfirmed and the sweep test requires it again, so nothing here can fire on a
// signal that later un-prints.
alertcondition(msSignalLow,  "MSS Bullish HL Sweep", "Protected higher low swept and reclaimed, with the trend filter passing.")
alertcondition(msSignalHigh, "MSS Bearish LH Sweep", "Protected lower high swept and reclaimed, with the trend filter passing.")
alertcondition(int_bull_bos, "Internal Bullish BOS", "Bullish iBOS — a protected higher low is now armed.")
alertcondition(int_bear_bos, "Internal Bearish BOS", "Bearish iBOS — a protected lower high is now armed.")

if msSignalLow
    alert("MSS Sweeps (MPC): bullish HL sweep on " + syminfo.ticker + " (" + timeframe.period + ") @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

if msSignalHigh
    alert("MSS Sweeps (MPC): bearish LH sweep on " + syminfo.ticker + " (" + timeframe.period + ") @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
