//@version=6
// ============================================================================
//  ob_export.pine — ORDER-BLOCK PARITY EXPORT BUILD
// ============================================================================
//  Instrumented copy of the ORDER BLOCKS blocks from `mpc_assistant.pine`, with
//  the drawing reduced to invisible boxes and `px_*` / `cfg_*` plot columns
//  added. Put it on a chart, "Export chart data" -> CSV, and diff that CSV
//  against the Python engine with:
//      engines/order_blocks/tools/compare_ob.py <that.csv> --warmup N
//
//  REBUILT 2026-07-31 — this file used to EMBED the whole structure engine
//  (1148 lines), because every order block was born on a BOS/SOS/iBOS/iSOS. The
//  mpc rework commented out all four of those creation sites: blocks now come
//  from short pivots (turns) alone, so the structure engine is not needed here
//  at all and has been removed. That also means this file no longer has to be
//  re-synced whenever the structure block changes — which was the single
//  biggest maintenance trap in the old build (it silently went stale twice).
//
//  THE BOXES ARE KEPT (invisible). `extendOBs` reads `box.get_left(ob.bg)` for
//  its age check, so keeping real boxes is what lets the ported logic stay
//  byte-identical to mpc rather than being paraphrased around a substitute
//  field. They are drawn with `color(na)` throughout, so nothing renders.
//
//  KEEP THE LOGIC BYTE-IDENTICAL TO `mpc_assistant.pine`. If the mpc OB blocks
//  change, re-sync this file FIRST, then re-export, then re-run compare_ob.py.
// ============================================================================
indicator("OB Export", overlay = true, max_boxes_count = 500, max_lines_count = 500)

// ── Settings, mirroring the mpc constants (mpc_assistant.pine:97-189, 2269-2280,
//    2626-2638, 2717 area). Exposed as inputs HERE ONLY so a parity run can be
//    taken at a non-default setting; the `cfg_ob_*` columns below carry whatever
//    was used, and compare_ob.py configures the Python engine FROM them. That is
//    the "let the file carry the settings" rule the FVG harness proved out —
//    parity then survives any Pine tweak instead of silently diffing two
//    different configurations.
var GRP = "OB Parity"
int   maxActiveOB     = input.int(10,    "Max Active OBs (per direction)",    minval = 1,   maxval = 20,   group = GRP)
bool  obBodyOnly      = input.bool(false, "Use Body Only for OB",             group = GRP)
int   OB_MAX_AGE      = input.int(500,   "Max age (bars)",                    minval = 10,  maxval = 5000, group = GRP)
float OB_MAX_ATR      = input.float(2.0, "Max height (x ATR14)",              minval = 0.1, maxval = 10.0, step = 0.1,  group = GRP)
float OB_DUPE_OVERLAP = input.float(0.5, "Dupe overlap (x candidate height)", minval = 0.0, maxval = 1.0,  step = 0.05, group = GRP)
float OB_DISP_MULT    = input.float(1.0, "Displacement (x ATR14)",            minval = 0.0, maxval = 5.0,  step = 0.1,  group = GRP)
float OB_PUSH_MULT    = input.float(0.3, "Push noise floor (x ATR14)",        minval = 0.0, maxval = 5.0,  step = 0.05, group = GRP)
int   OB_TURN_WAIT    = input.int(10,    "Turn read-late (bars)",             minval = 0,   maxval = 60,   group = GRP)
int   OB_PUSH_WAIT    = input.int(10,    "Push read-late (bars)",             minval = 0,   maxval = 60,   group = GRP)

// These stay PINNED constants, exactly as in mpc — they are not panel inputs
// there either. If any of them is ever turned into an mpc input, give it a
// `cfg_ob_*` column here and a flag in compare_ob.py IN THE SAME COMMIT.
int OB_MIN_BACK  = 3
int OB_TURN_LEN  = 2
int OB_TURN_SCAN = 8
int OB_PUSH_LOOK = 5

// Drawing is inert — every colour is na. Kept only so box.get_left works.
color OB_NA = color(na)

// ── The OrderBlock type (mpc 191-208) ───────────────────────────────────────
type OrderBlock
    box   bg
    float top
    float bottom
    bool  isBullish
    bool  fromBreak = true
    bool  entered   = false

var array<OrderBlock> activeBullOBs = array.new<OrderBlock>()
var array<OrderBlock> activeBearOBs = array.new<OrderBlock>()

// Per-bar parity counters (not in mpc — export only).
//
// PINE GOTCHA (CE10088): a function or method body may READ a global but may
// NOT assign to one. So these can only ever be written from the top-level
// script body. `extendOBs` therefore RETURNS its mitigation count instead of
// incrementing, and the creation counters are bumped at `f_obAdd`'s CALL SITES
// off its existing bool return. Neither is a logic change — the counters do not
// exist in mpc at all, they are pure instrumentation.
var int obBullCreated = 0
var int obBearCreated = 0
var int obBullMit     = 0
var int obBearMit     = 0
obBullCreated := 0
obBearCreated := 0

// ── manageOBs (mpc 221-225) — plain oldest-out at the cap ───────────────────
method manageOBs(array<OrderBlock> arr, OrderBlock newOB) =>
    array.push(arr, newOB)
    if array.size(arr) > maxActiveOB
        OrderBlock oldest = array.remove(arr, 0)
        box.delete(oldest.bg)

// ── extendOBs (mpc 284-393) — mitigation. Drawing stripped; the enter/leave/
//    tap/through/age rules are byte-identical. ─────────────────────────────
// Returns the number MITIGATED this bar (an aged-out block is removed but is not
// counted as mitigated — same split the Python engine reports).
method extendOBs(array<OrderBlock> arr) =>
    int obMitCnt = 0
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            OrderBlock ob = array.get(arr, i)
            int  obLeft   = box.get_left(ob.bg)
            bool obInside = close <= ob.top and close >= ob.bottom
            bool obTouch  = low <= ob.top and high >= ob.bottom
            if not ob.entered and obInside
                ob.entered := true
            bool obStale     = bar_index - obLeft > OB_MAX_AGE
            bool obThrough   = ob.isBullish ? close < ob.bottom : close > ob.top
            bool obMitigated = obThrough or (not obInside and (obTouch or ob.entered))
            if obStale or obMitigated
                if obMitigated
                    obMitCnt += 1
                box.delete(ob.bg)
                array.remove(arr, i)
    obMitCnt

// ── ATR read in GLOBAL scope (mpc 2269) ─────────────────────────────────────
// f_obAdd is called conditionally, and a ta.* call on a conditional path gets an
// inconsistent history — the value would be wrong on exactly the bars it is
// asked for. A global series is evaluated every bar and is safe to read inside.
float obAtr = ta.atr(14)

// ── f_obAdd (mpc 2282-2550) ─────────────────────────────────────────────────
f_obAdd(array<OrderBlock> arr, int off, int dir, bool vis, bool isBrk) =>
    float obTop = obBodyOnly ? math.max(open[off], close[off]) : high[off]
    float obBot = obBodyOnly ? math.min(open[off], close[off]) : low[off]
    bool obHuge = not na(obAtr) and (obTop - obBot) > obAtr * OB_MAX_ATR
    bool  obDead   = false
    bool  obLeft   = false
    bool  obTapped = false
    float obTravel = 0.0
    if off >= OB_MIN_BACK
        for j = off - 1 to 1
            if dir == 1 ? close[j] < obBot : close[j] > obTop
                obDead := true
                break
            if obLeft
                if low[j] <= obTop and high[j] >= obBot and (close[j] > obTop or close[j] < obBot)
                    obTapped := true
                    break
            float obAway = dir == 1 ? close[j] - obTop : obBot - close[j]
            if obAway > obTravel
                obTravel := obAway
            if not obLeft and not na(obAtr) and obTravel >= obAtr * OB_DISP_MULT
                obLeft := true
    bool obGone = not na(obAtr) and obTravel >= obAtr * OB_DISP_MULT
    bool obDupe = false
    if array.size(arr) > 0
        for k = 0 to array.size(arr) - 1
            OrderBlock oX = array.get(arr, k)
            float obOvH = math.min(obTop, oX.top) - math.max(obBot, oX.bottom)
            if obOvH > 0 and obOvH >= (obTop - obBot) * OB_DUPE_OVERLAP
                obDupe := true
                break
    bool obMade = false
    if obGone and not obDead and not obTapped and not obDupe and not obHuge
        box nb = box.new(bar_index - off, obTop, bar_index, obBot, border_color = OB_NA, border_width = 1, bgcolor = OB_NA)
        arr.manageOBs(OrderBlock.new(nb, obTop, obBot, dir == 1, isBrk, false))
        obMade := true
    obMade

// ── MITIGATE FIRST (mpc 2158-2160) ──────────────────────────────────────────
// Runs BEFORE any creation, which is what guarantees a block is never
// mitigation-checked on the bar it is born.
obBullMit := activeBullOBs.extendOBs()
obBearMit := activeBearOBs.extendOBs()

// ── The shared TURN pivot (mpc 2626-2635) ───────────────────────────────────
float obPvLo = ta.pivotlow(low,   OB_TURN_LEN, OB_TURN_LEN)
float obPvHi = ta.pivothigh(high, OB_TURN_LEN, OB_TURN_LEN)
var int obPvLoBar = na
var int obPvHiBar = na
if not na(obPvLo)
    obPvLoBar := bar_index - OB_TURN_LEN
if not na(obPvHi)
    obPvHiBar := bar_index - OB_TURN_LEN

// ── PUSH source (mpc 2636-2715) — the engulf reading of a turn ──────────────
float obPushAtr  = ta.atr(14)[OB_PUSH_WAIT]
float obPushBody = math.abs(close[OB_PUSH_WAIT] - open[OB_PUSH_WAIT])
bool  obPushUp   = close[OB_PUSH_WAIT] > open[OB_PUSH_WAIT]
bool  obPushOk   = barstate.isconfirmed and not na(obPushAtr) and obPushBody > obPushAtr * OB_PUSH_MULT
int obPushIdx = na
if obPushOk
    for j = OB_PUSH_WAIT + 1 to OB_PUSH_WAIT + OB_PUSH_LOOK
        if obPushUp ? close[j] < open[j] : close[j] > open[j]
            obPushIdx := j
            break
bool obPushEng = false
if not na(obPushIdx)
    float obPushPrev = math.abs(close[obPushIdx] - open[obPushIdx])
    bool  obPushReal = obPushPrev > obPushAtr * OB_PUSH_MULT
    obPushEng := obPushReal and obPushBody > obPushPrev and (obPushUp ? close[OB_PUSH_WAIT] > open[obPushIdx] : close[OB_PUSH_WAIT] < open[obPushIdx])
bool obPushAtTurn = false
if not na(obPushIdx)
    int obPushBar = bar_index - obPushIdx
    int obPvBar   = obPushUp ? obPvLoBar : obPvHiBar
    obPushAtTurn := not na(obPvBar) and obPushBar >= obPvBar and obPushBar - obPvBar <= OB_TURN_SCAN
var int obTurnUsedL = na
var int obTurnUsedS = na
if obPushEng and obPushAtTurn and obPushUp
    if f_obAdd(activeBullOBs, obPushIdx, 1, true, false)
        obTurnUsedL   := obPvLoBar
        obBullCreated += 1
if obPushEng and obPushAtTurn and not obPushUp
    if f_obAdd(activeBearOBs, obPushIdx, -1, true, false)
        obTurnUsedS   := obPvHiBar
        obBearCreated += 1

// ── TURN source (mpc 2717-2881) — the no-engulf reading of a turn ───────────
int   obTurnBase = OB_TURN_LEN + OB_TURN_WAIT
float obTurnLo   = obPvLo[OB_TURN_WAIT]
float obTurnHi   = obPvHi[OB_TURN_WAIT]
int   obTurnOffL = obTurnBase
int   obTurnOffS = obTurnBase
bool  obTurnFndL = false
bool  obTurnFndS = false
float obTurnRunH = math.max(open[obTurnBase], close[obTurnBase])
float obTurnRunL = math.min(open[obTurnBase], close[obTurnBase])
for j = obTurnBase - 1 to math.max(3, obTurnBase - OB_TURN_SCAN)
    if not obTurnFndL
        if close[j] > obTurnRunH
            obTurnOffL := j + 1
            obTurnFndL := true
        else
            obTurnRunH := math.max(obTurnRunH, open[j], close[j])
    if not obTurnFndS
        if close[j] < obTurnRunL
            obTurnOffS := j + 1
            obTurnFndS := true
        else
            obTurnRunL := math.min(obTurnRunL, open[j], close[j])
int obTurnPvBar = bar_index - obTurnBase
if not na(obTurnLo) and obTurnPvBar != obTurnUsedL
    if f_obAdd(activeBullOBs, obTurnOffL, 1, true, false)
        obBullCreated += 1
if not na(obTurnHi) and obTurnPvBar != obTurnUsedS
    if f_obAdd(activeBearOBs, obTurnOffS, -1, true, false)
        obBearCreated += 1

// ============================================================================
//  PARITY EXPORT COLUMNS
// ============================================================================
//  GOTCHA (learned on fvg_export.pine, 2026-07-10): the parity plots MUST use a
//  fully-transparent COLOUR (color.new(..., 100)), NOT `display = display.none`
//  — TradingView's "Export chart data" silently EXCLUDES display.none plots from
//  the CSV, so the columns never make it into the file.
// ============================================================================

// Config — read back by compare_ob.py so the Python engine is configured FROM
// the export rather than from its own defaults.
plot(maxActiveOB,        "cfg_ob_maxactive",   color = color.new(color.gray, 100))
plot(obBodyOnly ? 1 : 0, "cfg_ob_bodyonly",    color = color.new(color.gray, 100))
plot(OB_MAX_AGE,         "cfg_ob_maxage",      color = color.new(color.gray, 100))
plot(OB_MAX_ATR,         "cfg_ob_maxatr",      color = color.new(color.gray, 100))
plot(OB_DUPE_OVERLAP,    "cfg_ob_dupeoverlap", color = color.new(color.gray, 100))
plot(OB_DISP_MULT,       "cfg_ob_dispmult",    color = color.new(color.gray, 100))
plot(OB_PUSH_MULT,       "cfg_ob_pushmult",    color = color.new(color.gray, 100))
plot(OB_TURN_WAIT,       "cfg_ob_turnwait",    color = color.new(color.gray, 100))
plot(OB_PUSH_WAIT,       "cfg_ob_pushwait",    color = color.new(color.gray, 100))

// Counts + per-bar pulses.
plot(array.size(activeBullOBs), "px_ob_bull_count",   color = color.new(color.blue, 100))
plot(array.size(activeBearOBs), "px_ob_bear_count",   color = color.new(color.red,  100))
plot(obBullCreated,             "px_ob_bull_created", color = color.new(color.blue, 100))
plot(obBearCreated,             "px_ob_bear_created", color = color.new(color.red,  100))
plot(obBullMit,                 "px_ob_bull_mit",     color = color.new(color.blue, 100))
plot(obBearMit,                 "px_ob_bear_mit",     color = color.new(color.red,  100))

// The live arrays, slot-by-slot oldest-first. Comparing these proves creation,
// mitigation, expiry AND eviction at once. Ten slots per side = the cap.
plot(array.size(activeBullOBs) > 0 ? array.get(activeBullOBs, 0).top    : na, "px_ob_bull_top_1",  color = color.new(color.blue, 100))
plot(array.size(activeBullOBs) > 0 ? array.get(activeBullOBs, 0).bottom : na, "px_ob_bull_bot_1",  color = color.new(color.blue, 100))
plot(array.size(activeBullOBs) > 1 ? array.get(activeBullOBs, 1).top    : na, "px_ob_bull_top_2",  color = color.new(color.blue, 100))
plot(array.size(activeBullOBs) > 1 ? array.get(activeBullOBs, 1).bottom : na, "px_ob_bull_bot_2",  color = color.new(color.blue, 100))
plot(array.size(activeBullOBs) > 2 ? array.get(activeBullOBs, 2).top    : na, "px_ob_bull_top_3",  color = color.new(color.blue, 100))
plot(array.size(activeBullOBs) > 2 ? array.get(activeBullOBs, 2).bottom : na, "px_ob_bull_bot_3",  color = color.new(color.blue, 100))
plot(array.size(activeBullOBs) > 3 ? array.get(activeBullOBs, 3).top    : na, "px_ob_bull_top_4",  color = color.new(color.blue, 100))
plot(array.size(activeBullOBs) > 3 ? array.get(activeBullOBs, 3).bottom : na, "px_ob_bull_bot_4",  color = color.new(color.blue, 100))
plot(array.size(activeBullOBs) > 4 ? array.get(activeBullOBs, 4).top    : na, "px_ob_bull_top_5",  color = color.new(color.blue, 100))
plot(array.size(activeBullOBs) > 4 ? array.get(activeBullOBs, 4).bottom : na, "px_ob_bull_bot_5",  color = color.new(color.blue, 100))
plot(array.size(activeBullOBs) > 5 ? array.get(activeBullOBs, 5).top    : na, "px_ob_bull_top_6",  color = color.new(color.blue, 100))
plot(array.size(activeBullOBs) > 5 ? array.get(activeBullOBs, 5).bottom : na, "px_ob_bull_bot_6",  color = color.new(color.blue, 100))
plot(array.size(activeBullOBs) > 6 ? array.get(activeBullOBs, 6).top    : na, "px_ob_bull_top_7",  color = color.new(color.blue, 100))
plot(array.size(activeBullOBs) > 6 ? array.get(activeBullOBs, 6).bottom : na, "px_ob_bull_bot_7",  color = color.new(color.blue, 100))
plot(array.size(activeBullOBs) > 7 ? array.get(activeBullOBs, 7).top    : na, "px_ob_bull_top_8",  color = color.new(color.blue, 100))
plot(array.size(activeBullOBs) > 7 ? array.get(activeBullOBs, 7).bottom : na, "px_ob_bull_bot_8",  color = color.new(color.blue, 100))
plot(array.size(activeBullOBs) > 8 ? array.get(activeBullOBs, 8).top    : na, "px_ob_bull_top_9",  color = color.new(color.blue, 100))
plot(array.size(activeBullOBs) > 8 ? array.get(activeBullOBs, 8).bottom : na, "px_ob_bull_bot_9",  color = color.new(color.blue, 100))
plot(array.size(activeBullOBs) > 9 ? array.get(activeBullOBs, 9).top    : na, "px_ob_bull_top_10", color = color.new(color.blue, 100))
plot(array.size(activeBullOBs) > 9 ? array.get(activeBullOBs, 9).bottom : na, "px_ob_bull_bot_10", color = color.new(color.blue, 100))
plot(array.size(activeBearOBs) > 0 ? array.get(activeBearOBs, 0).top    : na, "px_ob_bear_top_1",  color = color.new(color.red, 100))
plot(array.size(activeBearOBs) > 0 ? array.get(activeBearOBs, 0).bottom : na, "px_ob_bear_bot_1",  color = color.new(color.red, 100))
plot(array.size(activeBearOBs) > 1 ? array.get(activeBearOBs, 1).top    : na, "px_ob_bear_top_2",  color = color.new(color.red, 100))
plot(array.size(activeBearOBs) > 1 ? array.get(activeBearOBs, 1).bottom : na, "px_ob_bear_bot_2",  color = color.new(color.red, 100))
plot(array.size(activeBearOBs) > 2 ? array.get(activeBearOBs, 2).top    : na, "px_ob_bear_top_3",  color = color.new(color.red, 100))
plot(array.size(activeBearOBs) > 2 ? array.get(activeBearOBs, 2).bottom : na, "px_ob_bear_bot_3",  color = color.new(color.red, 100))
plot(array.size(activeBearOBs) > 3 ? array.get(activeBearOBs, 3).top    : na, "px_ob_bear_top_4",  color = color.new(color.red, 100))
plot(array.size(activeBearOBs) > 3 ? array.get(activeBearOBs, 3).bottom : na, "px_ob_bear_bot_4",  color = color.new(color.red, 100))
plot(array.size(activeBearOBs) > 4 ? array.get(activeBearOBs, 4).top    : na, "px_ob_bear_top_5",  color = color.new(color.red, 100))
plot(array.size(activeBearOBs) > 4 ? array.get(activeBearOBs, 4).bottom : na, "px_ob_bear_bot_5",  color = color.new(color.red, 100))
plot(array.size(activeBearOBs) > 5 ? array.get(activeBearOBs, 5).top    : na, "px_ob_bear_top_6",  color = color.new(color.red, 100))
plot(array.size(activeBearOBs) > 5 ? array.get(activeBearOBs, 5).bottom : na, "px_ob_bear_bot_6",  color = color.new(color.red, 100))
plot(array.size(activeBearOBs) > 6 ? array.get(activeBearOBs, 6).top    : na, "px_ob_bear_top_7",  color = color.new(color.red, 100))
plot(array.size(activeBearOBs) > 6 ? array.get(activeBearOBs, 6).bottom : na, "px_ob_bear_bot_7",  color = color.new(color.red, 100))
plot(array.size(activeBearOBs) > 7 ? array.get(activeBearOBs, 7).top    : na, "px_ob_bear_top_8",  color = color.new(color.red, 100))
plot(array.size(activeBearOBs) > 7 ? array.get(activeBearOBs, 7).bottom : na, "px_ob_bear_bot_8",  color = color.new(color.red, 100))
plot(array.size(activeBearOBs) > 8 ? array.get(activeBearOBs, 8).top    : na, "px_ob_bear_top_9",  color = color.new(color.red, 100))
plot(array.size(activeBearOBs) > 8 ? array.get(activeBearOBs, 8).bottom : na, "px_ob_bear_bot_9",  color = color.new(color.red, 100))
plot(array.size(activeBearOBs) > 9 ? array.get(activeBearOBs, 9).top    : na, "px_ob_bear_top_10", color = color.new(color.red, 100))
plot(array.size(activeBearOBs) > 9 ? array.get(activeBearOBs, 9).bottom : na, "px_ob_bear_bot_10", color = color.new(color.red, 100))
