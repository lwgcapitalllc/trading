// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/ MPL-2.0
//@version=6
// Structure Engine — market-structure-only extraction from indicators/mpc_assistant.pine.
// Everything non-structure (Order Blocks, Sessions, Kill Zones/NY Range, VWAP, Liquidity
// Levels, Fibonacci, Sniper Fib, SVP) has been removed. The detection logic itself is
// byte-for-byte identical to mpc_assistant.pine so this stays validated against the same
// chart reference.
//
// NOTE — this intentionally uses ta.pivothigh/ta.pivotlow to seed swing candidates, which
// breaks the "no pivot lookback" rule in indicators/STRUCTURE_OS_BUILD.md /
// indicators/smc_engine_v2.pine. That from-scratch rebuild is a separate, still-in-progress
// effort. This file is the pragmatic version: pivot-seeded candidates + pullback-confirmed
// break-gated re-locking, which is what got mpc_assistant.pine to ~99.99% parity with the
// original indicator. Do not merge this file's approach into smc_engine_v2.pine.
//
// Planned next step: port this engine to Python for use in an algos/ bot, once validated
// on a real chart against mpc_assistant.pine.
// ── PARITY-EXPORT BUILD (ORDER BLOCKS) ───────────────────────────────────────
// Instrumented build used ONLY to validate the Python port (order_blocks/) against
// this Pine source. It is structure_engine_export.pine (the byte-for-byte structure
// engine, external + internal) with the Order-Block blocks from mpc_assistant.pine
// bolted on — the type + manageOBs/extendOBs (mpc 38-66), external-break creation
// (mpc 863-895) and internal-break creation (mpc 1290-1317) — drawing removed, plus
// plot() columns for the active OB arrays / counts / created+mitigated pulses and the
// internal-break origin. Runs in its own pane (overlay=false). Export chart data to
// CSV and diff with order_blocks/tools/compare_ob.py. Do NOT trade off this file or
// let its structure logic drift from structure_engine.pine or its OB logic from
// mpc_assistant.pine.
indicator("Order Block Engine EXPORT", overlay = false, max_labels_count = 500, max_lines_count = 500)

//============================================================
//  SMC SETTINGS (hardcoded)
//============================================================
int   majorLength = 15
color bullColor   = color.blue
color bearColor   = color.red
color iBullColor  = bullColor
color iBearColor  = bearColor

//============================================================
//  MARKET STRUCTURE LABEL SIZE
//============================================================
var GRP_STRUCT = "Market Structure"
string structLabelSize  = input.string("Small", "Structure Label Size",    group = GRP_STRUCT, options = ["Tiny", "Small", "Normal", "Large", "Huge"], display = display.none)
bool   showInternal     = input.bool(true,      "Show Internal Structure", group = GRP_STRUCT, display = display.none)
float  pbBuffer         = 0.0

f_structSize() =>
    structLabelSize == "Tiny" ? size.tiny : structLabelSize == "Normal" ? size.normal : structLabelSize == "Large" ? size.large : structLabelSize == "Huge" ? size.huge : size.small

//============================================================
//  ORDER BLOCKS  (ported from mpc_assistant.pine 27-66; drawing removed)
//  The `box bg` field and every box.* call are dropped — only the top/bottom/
//  isBullish array bookkeeping (creation, close-through mitigation, FIFO eviction)
//  is kept, which is exactly the state order_blocks/ reproduces. Defaults mirror the
//  Python engine: 6 active per direction, full candle high/low (not body-only).
//============================================================
int  maxActiveOB = 2       // mpc default 2 (was 6 before the 2026-07-14 paste)
bool obBodyOnly  = false   // mpc default false

type OrderBlock
    float top
    float bottom
    bool  isBullish

var array<OrderBlock> activeBullOBs = array.new<OrderBlock>()
var array<OrderBlock> activeBearOBs = array.new<OrderBlock>()

method manageOBs(array<OrderBlock> arr, OrderBlock newOB) =>
    array.push(arr, newOB)
    if array.size(arr) > maxActiveOB
        array.shift(arr)                 // mpc deletes the oldest box; here we just drop it

// Returns the count of OBs mitigated (closed through) this bar. Same backward scan +
// array.remove(i) as mpc extendOBs (53-66); only box.set_right / box.delete are gone.
method extendOBs(array<OrderBlock> arr) =>
    int mit = 0
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            OrderBlock ob = array.get(arr, i)
            if ob.isBullish
                if close < ob.bottom
                    array.remove(arr, i)
                    mit += 1
            else
                if close > ob.top
                    array.remove(arr, i)
                    mit += 1
    mit

//============================================================
//  SMC STRUCTURE TYPE
//============================================================
type SMCStructure
    int    length
    float  ash             = na
    int    ash_loc         = na
    string ash_type        = ""
    line   ash_line        = na
    label  ash_lbl         = na
    float  asl             = na
    int    asl_loc         = na
    string asl_type        = ""
    line   asl_line        = na
    label  asl_lbl         = na
    float  last_conf_high     = na
    int    last_conf_high_loc = na
    float  last_conf_low      = na
    int    last_conf_low_loc  = na
    int    dir            = 0
    bool   choch_lock     = false
    line   choch_ref      = na
    int    pb_mode        = 0
    int    pb_count       = 0
    float  pb_level       = na
    float  pb_extreme     = na
    int    pb_extreme_loc = na
    line   pb_line        = na
    bool   pb_started     = false
    float  pb_last_qualify_close = na
    float  pb_last_qualify_high  = na
    float  pb_extreme_close      = na
    float  prev_close     = na
    float  prev_high      = na
    float  prev_low       = na
    bool   seeded         = false
    bool   bull_bos       = false
    float  bull_bos_high  = na
    int    bull_bos_h_loc = na
    float  bull_bos_low   = na
    int    bull_bos_l_loc = na
    bool   bear_bos       = false
    float  bear_bos_high  = na
    int    bear_bos_h_loc = na
    float  bear_bos_low   = na
    int    bear_bos_l_loc = na
    bool   new_swing_high = false
    bool   new_swing_low  = false
    bool   bull_sos       = false
    bool   bear_sos       = false

// prefix: "" for external, "i" for internal
// bull_col / bear_col allow per-instance colors
method create_ash(SMCStructure st, float val, int loc, color col, bool solid, string prefix) =>
    if not na(st.ash_line)
        line.delete(st.ash_line)
    if not na(st.ash_lbl)
        label.delete(st.ash_lbl)
        st.ash_lbl := na
    st.ash      := val
    st.ash_loc  := loc
    st.ash_type := ""
    st.ash_lbl  := label.new(loc, val, prefix + "ASH\n", color=color(na), textcolor=col, style=label.style_label_down, size=f_structSize())
    st.ash_line := line.new(loc, val, bar_index, val, color=col, style=solid ? line.style_solid : line.style_dashed, width=solid ? 2 : 1)

method create_asl(SMCStructure st, float val, int loc, color col, bool solid, string prefix) =>
    if not na(st.asl_line)
        line.delete(st.asl_line)
    if not na(st.asl_lbl)
        label.delete(st.asl_lbl)
        st.asl_lbl := na
    st.asl      := val
    st.asl_loc  := loc
    st.asl_type := ""
    st.asl_lbl  := label.new(loc, val, "\n" + prefix + "ASL", color=color(na), textcolor=col, style=label.style_label_up, size=f_structSize())
    st.asl_line := line.new(loc, val, bar_index, val, color=col, style=solid ? line.style_solid : line.style_dashed, width=solid ? 2 : 1)

// process() now accepts prefix + bull/bear colors so both instances share one method
method process(SMCStructure st, float ph_val, float pl_val, string prefix, color bull_col, color bear_col) =>

    st.bull_bos := false
    st.bear_bos := false
    st.new_swing_high := false
    st.new_swing_low  := false
    st.bull_sos := false
    st.bear_sos := false

    bool is_inside = false
    if not na(st.prev_high) and not na(st.prev_low)
        is_inside := high < st.prev_high and low > st.prev_low

    if st.choch_lock
        if st.dir == 1 and not na(pl_val)
            st.choch_lock := false
        else if st.dir == -1 and not na(ph_val)
            st.choch_lock := false

    if st.pb_mode == 1
        if not st.pb_started
            st.pb_started            := true
            st.pb_extreme            := high
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_count              := 0
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
        else
            bool extreme_updated_1 = false
            if na(st.pb_extreme) or high > st.pb_extreme
                st.pb_extreme            := high
                st.pb_extreme_loc        := bar_index
                st.pb_extreme_close      := na
                st.pb_count              := 0
                st.pb_last_qualify_close := na
                st.pb_last_qualify_high  := na
                extreme_updated_1        := true
            bool extreme_is_bearish_1 = extreme_updated_1 and close < open
            bool is_candle1_1 = na(st.pb_last_qualify_close) and not extreme_updated_1
            if (not is_inside or is_candle1_1) and (not extreme_updated_1 or extreme_is_bearish_1)
                float threshold = na(st.pb_last_qualify_high) ? st.pb_extreme : st.pb_last_qualify_high
                if close < threshold - pbBuffer
                    st.pb_count              += 1
                    st.pb_last_qualify_close := close
                    st.pb_last_qualify_high  := low
            if st.pb_count >= 3 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
                if not na(st.ash_line)
                    line.delete(st.ash_line)
                if not na(st.ash_lbl)
                    label.delete(st.ash_lbl)
                st.ash      := st.pb_extreme
                st.ash_loc  := st.pb_extreme_loc
                st.ash_type := "LOCKED"
                st.ash_line := line.new(st.pb_extreme_loc, st.pb_extreme, bar_index, st.pb_extreme, color=bear_col, style=line.style_solid, width=1)
                st.ash_lbl  := label.new(st.pb_extreme_loc, st.pb_extreme, prefix + "ASH\n", color=color(na), textcolor=bear_col, style=label.style_label_down, size=f_structSize())
                st.new_swing_high := true
                st.pb_mode    := 0
                st.pb_count   := 0
                st.choch_lock := false

    else if st.pb_mode == -1
        if not st.pb_started
            st.pb_started            := true
            st.pb_extreme            := low
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_count              := 0
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
        else
            bool extreme_updated_m1 = false
            if na(st.pb_extreme) or low < st.pb_extreme
                st.pb_extreme            := low
                st.pb_extreme_loc        := bar_index
                st.pb_extreme_close      := na
                st.pb_count              := 0
                st.pb_last_qualify_close := na
                st.pb_last_qualify_high  := na
                extreme_updated_m1       := true
            bool extreme_is_bullish_m1 = extreme_updated_m1 and close > open
            bool is_candle1_m1 = na(st.pb_last_qualify_close) and not extreme_updated_m1
            if (not is_inside or is_candle1_m1) and (not extreme_updated_m1 or extreme_is_bullish_m1)
                float threshold = na(st.pb_last_qualify_high) ? st.pb_extreme : st.pb_last_qualify_high
                if close > threshold + pbBuffer
                    st.pb_count              += 1
                    st.pb_last_qualify_close := close
                    st.pb_last_qualify_high  := high
            if st.pb_count >= 3 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
                if not na(st.asl_line)
                    line.delete(st.asl_line)
                if not na(st.asl_lbl)
                    label.delete(st.asl_lbl)
                st.asl      := st.pb_extreme
                st.asl_loc  := st.pb_extreme_loc
                st.asl_type := "LOCKED"
                st.asl_line := line.new(st.pb_extreme_loc, st.pb_extreme, bar_index, st.pb_extreme, color=bull_col, style=line.style_solid, width=1)
                st.asl_lbl  := label.new(st.pb_extreme_loc, st.pb_extreme, "\n" + prefix + "ASL", color=color(na), textcolor=bull_col, style=label.style_label_up, size=f_structSize())
                st.new_swing_low := true
                st.pb_mode    := 0
                st.pb_count   := 0
                st.choch_lock := false

    st.prev_close := close
    st.prev_high  := high
    st.prev_low   := low

    if na(st.ash) and na(st.asl) and not st.seeded
        if not na(ph_val)
            st.create_ash(ph_val, bar_index[st.length], bear_col, false, prefix)
            st.dir := -1
        else if not na(pl_val)
            st.create_asl(pl_val, bar_index[st.length], bull_col, false, prefix)
            st.dir := 1

    if not st.seeded
        if not na(st.ash) and na(st.asl)
            float seed_low = low
            int   seed_loc = bar_index
            int   lb       = math.min(bar_index, 500)
            for i = 0 to lb
                if low[i] < seed_low
                    seed_low := low[i]
                    seed_loc := bar_index - i
            if seed_low < st.ash
                st.asl      := seed_low
                st.asl_loc  := seed_loc
                st.asl_type := ""
                st.asl_line := line.new(seed_loc, seed_low, bar_index, seed_low, color=bull_col, style=line.style_dashed, width=1)
                st.asl_lbl  := label.new(seed_loc, seed_low, "\n" + prefix + "ASL", color=color(na), textcolor=bull_col, style=label.style_label_up, size=f_structSize())
                st.seeded := true
        else if not na(st.asl) and na(st.ash)
            float seed_high = high
            int   seed_loc  = bar_index
            int   lb        = math.min(bar_index, 500)
            for i = 0 to lb
                if high[i] > seed_high
                    seed_high := high[i]
                    seed_loc  := bar_index - i
            if seed_high > st.asl
                st.ash      := seed_high
                st.ash_loc  := seed_loc
                st.ash_type := ""
                st.ash_line := line.new(seed_loc, seed_high, bar_index, seed_high, color=bear_col, style=line.style_dashed, width=1)
                st.ash_lbl  := label.new(seed_loc, seed_high, prefix + "ASH\n", color=color(na), textcolor=bear_col, style=label.style_label_down, size=f_structSize())
                st.seeded := true
        else if not na(st.ash) and not na(st.asl)
            st.seeded := true

    if na(st.last_conf_high) and na(st.last_conf_low)
        if not na(ph_val) and not na(st.ash) and st.ash_type == "" and st.pb_mode == 0
            if ph_val > st.ash
                st.create_ash(ph_val, bar_index[st.length], bear_col, false, prefix)
        if not na(pl_val) and not na(st.asl) and st.asl_type == "" and st.pb_mode == 0
            if pl_val < st.asl
                st.create_asl(pl_val, bar_index[st.length], bull_col, false, prefix)

    bool ash_broken = not na(st.ash) and close > st.ash
    bool asl_broken = not na(st.asl) and close < st.asl

    if ash_broken
        st.bull_bos := true
        st.bull_bos_high  := st.ash
        st.bull_bos_h_loc := st.ash_loc

        bool was_in_bear_pb = st.pb_mode == -1 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
        st.pb_mode  := 0
        st.pb_count := 0

        bool   is_choch    = st.dir == -1
        string brk_lbl_txt = is_choch ? prefix + "SOS" : prefix + "BOS"
        if is_choch
            st.bull_sos := true
        int    mid_x       = math.round((st.ash_loc + bar_index) / 2)
        label.new(mid_x, st.ash, "\n" + brk_lbl_txt, color=color(na), textcolor=bull_col, style=label.style_label_down, size=size.tiny)

        if is_choch
            st.choch_lock := true

        bool brk_already_conf_high = (st.ash == st.last_conf_high and st.ash_loc == st.last_conf_high_loc)
        if not na(st.ash_lbl)
            label.delete(st.ash_lbl)
        if not brk_already_conf_high
            bool   brk_is_hh  = na(st.last_conf_high) or st.ash >= st.last_conf_high
            string brk_high_t = brk_is_hh ? prefix + "HH" : prefix + "LH"
            color  brk_high_c = brk_is_hh ? bull_col : bear_col
            label.new(st.ash_loc, st.ash, brk_high_t + "\n", color=color(na), textcolor=brk_high_c, style=label.style_label_down, size=f_structSize())

        if not na(st.ash_line)
            line.set_style(st.ash_line, line.style_solid)
            line.set_color(st.ash_line, bull_col)
            line.set_width(st.ash_line, 2)
            line.set_x2(st.ash_line, bar_index)
            st.ash_line := na

        st.last_conf_high     := st.ash
        st.last_conf_high_loc := st.ash_loc
        st.ash_lbl            := na
        st.ash                := na
        st.dir                := 1

        if was_in_bear_pb
            st.bull_bos_low   := st.pb_extreme
            st.bull_bos_l_loc := st.pb_extreme_loc
            if not na(st.asl_line)
                line.delete(st.asl_line)
            if not na(st.asl_lbl)
                label.delete(st.asl_lbl)
            bool   pb_is_hl = is_choch ? false : (na(st.last_conf_low) or st.pb_extreme >= st.last_conf_low)
            // On an SOS (fast reversal) the extreme is only the ACTIVE swing low —
            // it prints as ASL and is confirmed to HL/LL by the NEXT bullish break.
            string pb_low_t = is_choch ? prefix + "ASL" : (pb_is_hl ? prefix + "HL" : prefix + "LL")
            color  pb_low_c = is_choch ? bull_col : (pb_is_hl ? bull_col : bear_col)
            st.asl      := st.pb_extreme
            st.asl_loc  := st.pb_extreme_loc
            st.asl_type := "LOCKED"
            st.asl_line := line.new(st.pb_extreme_loc, st.pb_extreme, bar_index, st.pb_extreme, color=bull_col, style=line.style_solid, width=1)
            st.asl_lbl  := label.new(st.pb_extreme_loc, st.pb_extreme, "\n" + pb_low_t, color=color(na), textcolor=pb_low_c, style=label.style_label_up, size=f_structSize())
            if not is_choch
                st.last_conf_low     := st.pb_extreme
                st.last_conf_low_loc := st.pb_extreme_loc
            st.pb_extreme            := high
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_mode               := 1
            st.pb_started            := true
        else
            if not na(st.asl)
                bool already_conf_low = (st.asl == st.last_conf_low and st.asl_loc == st.last_conf_low_loc)
                if not already_conf_low
                    bool   old_is_hl = is_choch ? false : (na(st.last_conf_low) or st.asl >= st.last_conf_low)
                    string old_low_t = old_is_hl ? prefix + "HL" : prefix + "LL"
                    color  old_low_c = old_is_hl ? bull_col : bear_col
                    if not na(st.asl_lbl)
                        label.delete(st.asl_lbl)
                    label.new(st.asl_loc, st.asl, "\n" + old_low_t, color=color(na), textcolor=old_low_c, style=label.style_label_up, size=f_structSize())
                    st.last_conf_low     := st.asl
                    st.last_conf_low_loc := st.asl_loc
                else
                    if not na(st.asl_lbl)
                        label.delete(st.asl_lbl)
                if not na(st.asl_line)
                    line.delete(st.asl_line)
                st.asl_line := na
                st.asl_lbl  := na
                st.asl      := na

            float lowest_val = low
            int   lowest_loc = bar_index
            int   bars_back  = na(st.last_conf_high_loc) ? bar_index : bar_index - st.last_conf_high_loc
            if bars_back > 0
                int max_lb = math.min(math.min(bars_back, 1490), bar_index)
                for i = 0 to max_lb
                    if low[i] < lowest_val
                        lowest_val := low[i]
                        lowest_loc := bar_index - i

            st.bull_bos_low   := lowest_val
            st.bull_bos_l_loc := lowest_loc

            st.asl      := lowest_val
            st.asl_loc  := lowest_loc
            st.asl_type := ""
            st.asl_line := line.new(lowest_loc, lowest_val, bar_index, lowest_val, color=bull_col, style=line.style_solid, width=1)
            if lowest_val != st.last_conf_low
                st.asl_lbl := label.new(lowest_loc, lowest_val, "\n" + prefix + "ASL", color=color(na), textcolor=bull_col, style=label.style_label_up, size=f_structSize())
            else
                st.asl_lbl := na

            st.pb_mode               := 1
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_extreme            := high
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true

    else if asl_broken
        st.bear_bos := true
        st.bear_bos_low   := st.asl
        st.bear_bos_l_loc := st.asl_loc

        bool was_in_bull_pb = st.pb_mode == 1 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
        st.pb_mode  := 0
        st.pb_count := 0

        bool   is_choch    = st.dir == 1
        string brk_lbl_txt = is_choch ? prefix + "SOS" : prefix + "BOS"
        if is_choch
            st.bear_sos := true
        int    mid_x       = math.round((st.asl_loc + bar_index) / 2)
        label.new(mid_x, st.asl, brk_lbl_txt + "\n", color=color(na), textcolor=bear_col, style=label.style_label_up, size=size.tiny)

        if is_choch
            st.choch_lock := true

        bool brk_already_conf_low = (st.asl == st.last_conf_low and st.asl_loc == st.last_conf_low_loc)
        if not na(st.asl_lbl)
            label.delete(st.asl_lbl)
        if not brk_already_conf_low
            bool   brk_is_hl = na(st.last_conf_low) or st.asl >= st.last_conf_low
            string brk_low_t = brk_is_hl ? prefix + "HL" : prefix + "LL"
            label.new(st.asl_loc, st.asl, "\n" + brk_low_t, color=color(na), textcolor=bear_col, style=label.style_label_up, size=f_structSize())

        if not na(st.asl_line)
            line.set_style(st.asl_line, line.style_solid)
            line.set_color(st.asl_line, bear_col)
            line.set_width(st.asl_line, 2)
            line.set_x2(st.asl_line, bar_index)
            st.asl_line := na

        st.last_conf_low     := st.asl
        st.last_conf_low_loc := st.asl_loc
        st.asl_lbl           := na
        st.asl               := na
        st.dir               := -1

        if was_in_bull_pb
            st.bear_bos_high  := st.pb_extreme
            st.bear_bos_h_loc := st.pb_extreme_loc
            if not na(st.ash_line)
                line.delete(st.ash_line)
            if not na(st.ash_lbl)
                label.delete(st.ash_lbl)
            bool   pb_is_hh  = na(st.last_conf_high) or st.pb_extreme >= st.last_conf_high
            // On an SOS (fast reversal) the extreme is only the ACTIVE swing high —
            // it prints as ASH and is confirmed to HH/LH by the NEXT bearish break.
            string pb_high_t = is_choch ? prefix + "ASH" : (pb_is_hh ? prefix + "HH" : prefix + "LH")
            color  pb_high_c = is_choch ? bear_col : (pb_is_hh ? bull_col : bear_col)
            st.ash      := st.pb_extreme
            st.ash_loc  := st.pb_extreme_loc
            st.ash_type := "LOCKED"
            st.ash_line := line.new(st.pb_extreme_loc, st.pb_extreme, bar_index, st.pb_extreme, color=bear_col, style=line.style_solid, width=1)
            st.ash_lbl  := label.new(st.pb_extreme_loc, st.pb_extreme, pb_high_t + "\n", color=color(na), textcolor=pb_high_c, style=label.style_label_down, size=f_structSize())
            if not is_choch
                st.last_conf_high     := st.pb_extreme
                st.last_conf_high_loc := st.pb_extreme_loc
            st.pb_extreme            := low
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_mode               := -1
            st.pb_started            := true
        else
            float highest_val = high
            int   highest_loc = bar_index
            int   bars_back   = na(st.last_conf_low_loc) ? bar_index : bar_index - st.last_conf_low_loc
            if bars_back > 0
                int max_lb = math.min(math.min(bars_back, 1490), bar_index)
                for i = 0 to max_lb
                    if high[i] > highest_val
                        highest_val := high[i]
                        highest_loc := bar_index - i

            if not na(st.ash)
                bool already_conf_high = (st.ash == st.last_conf_high and st.ash_loc == st.last_conf_high_loc)
                if not already_conf_high
                    bool   old_is_hh  = is_choch ? true : (na(st.last_conf_high) or st.ash >= st.last_conf_high)
                    string old_high_t = old_is_hh ? prefix + "HH" : prefix + "LH"
                    color  old_high_c = old_is_hh ? bull_col : bear_col
                    if not na(st.ash_lbl)
                        label.delete(st.ash_lbl)
                    label.new(st.ash_loc, st.ash, old_high_t + "\n", color=color(na), textcolor=old_high_c, style=label.style_label_down, size=f_structSize())
                    st.last_conf_high     := st.ash
                    st.last_conf_high_loc := st.ash_loc
                else
                    if not na(st.ash_lbl)
                        label.delete(st.ash_lbl)
                if not na(st.ash_line)
                    line.delete(st.ash_line)
                st.ash_line := na
                st.ash_lbl  := na
                st.ash      := na
            else
                // Neither an active pullback high nor a confirmed ASH was available to
                // promote — use the actual highest point since the last confirmed low so
                // a genuine swing high still gets confirmed instead of silently vanishing.
                bool   fallback_is_hh  = na(st.last_conf_high) or highest_val >= st.last_conf_high
                string fallback_high_t = fallback_is_hh ? prefix + "HH" : prefix + "LH"
                color  fallback_high_c = fallback_is_hh ? bull_col : bear_col
                if highest_val != st.last_conf_high
                    label.new(highest_loc, highest_val, fallback_high_t + "\n", color=color(na), textcolor=fallback_high_c, style=label.style_label_down, size=f_structSize())
                    st.last_conf_high     := highest_val
                    st.last_conf_high_loc := highest_loc

            st.bear_bos_high  := highest_val
            st.bear_bos_h_loc := highest_loc

            st.ash      := highest_val
            st.ash_loc  := highest_loc
            st.ash_type := ""
            st.ash_line := line.new(highest_loc, highest_val, bar_index, highest_val, color=bear_col, style=line.style_solid, width=1)
            if highest_val != st.last_conf_high
                st.ash_lbl := label.new(highest_loc, highest_val, prefix + "ASH\n", color=color(na), textcolor=bear_col, style=label.style_label_down, size=f_structSize())
            else
                st.ash_lbl := na

            st.pb_mode               := -1
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_extreme            := low
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true

    if not na(st.ash_line)
        line.set_x2(st.ash_line, bar_index)
    if not na(st.asl_line)
        line.set_x2(st.asl_line, bar_index)

//============================================================
//  EXECUTION — EXTERNAL STRUCTURE
//============================================================
// External structure — majorLength=15, blue/red, prefix ""
var st = SMCStructure.new(majorLength)
ph = ta.pivothigh(high, majorLength, majorLength)
pl = ta.pivotlow(low,  majorLength, majorLength)
st.process(ph, pl, "", bullColor, bearColor)

// ── Order Blocks: extend + mitigate every bar, then create on EXTERNAL breaks ──
// (mpc_assistant.pine 863-895). extendOBs runs BEFORE creation, so a freshly created
// OB is never mitigated on its own creation bar. Counters feed the parity plots.
int obBullCreated = 0
int obBearCreated = 0
int obBullMit = activeBullOBs.extendOBs()
int obBearMit = activeBearOBs.extendOBs()

if (st.bull_bos or st.bull_sos)
    int lookbackIdx = bar_index - st.bull_bos_l_loc
    if lookbackIdx >= 0 and lookbackIdx < 500
        int obIdx = na
        for i = lookbackIdx to math.min(lookbackIdx + 20, bar_index)
            if close[i] < open[i]
                obIdx := i
                break
        if not na(obIdx)
            float obTop = obBodyOnly ? math.max(open[obIdx], close[obIdx]) : high[obIdx]
            float obBot = obBodyOnly ? math.min(open[obIdx], close[obIdx]) : low[obIdx]
            activeBullOBs.manageOBs(OrderBlock.new(obTop, obBot, true))
            obBullCreated += 1

if (st.bear_bos or st.bear_sos)
    int lookbackIdx = bar_index - st.bear_bos_h_loc
    if lookbackIdx >= 0 and lookbackIdx < 500
        int obIdx = na
        for i = lookbackIdx to math.min(lookbackIdx + 20, bar_index)
            if close[i] > open[i]
                obIdx := i
                break
        if not na(obIdx)
            float obTop = obBodyOnly ? math.max(open[obIdx], close[obIdx]) : high[obIdx]
            float obBot = obBodyOnly ? math.min(open[obIdx], close[obIdx]) : low[obIdx]
            activeBearOBs.manageOBs(OrderBlock.new(obTop, obBot, false))
            obBearCreated += 1

//============================================================
//  EXECUTION — INTERNAL STRUCTURE
//============================================================
// Internal structure: pullback tracking to confirm iSH / iSL, scoped inside the
// current external swing range, reset whenever the external structure prints a SOS.

// ── State ─────────────────────────────────────────────────
var int   i_mode           = 0
var bool  i_seeded         = false

// Pullback tracking
var float i_pb_extreme     = na
var int   i_pb_extreme_loc = na
var int   i_pb_count       = 0
var bool  i_pb_started     = false
var float i_pb_lqc         = na
var float i_pb_lqh         = na
var float i_prev_high      = na
var float i_prev_low       = na

// Active swing level (iSH or iSL)
var float i_sw_price       = na
var int   i_sw_loc         = na
var line  i_sw_line        = na
var label i_sw_lbl         = na

// Pre-declared locals (Pine v6)
var bool  i_ext_chg        = false
var bool  i_is_inside      = false
var bool  i_ext_dir        = false
var bool  i_is_c1          = false
var float i_thresh         = na

var float i_tracked_ext     = na
var int   i_tracked_ext_loc = na
var int   i_last_mode       = 0   // remembers what mode confirmed the swing
var bool  i_had_bos         = false
var int   i_bos_dir         = 0
var string i_h_lbl          = ""
var color  i_h_col          = color.black
var string i_l_lbl          = ""
var color  i_l_col          = color.black
var int   i_mid             = 0
var int   i_mid2            = 0
var float i_last_hl         = na   // last confirmed iHL price (for iSOS in bullish cycle)
var float i_last_lh         = na   // last confirmed iLH price (for iSOS in bearish cycle)
var int   i_last_hl_loc     = na
var int   i_last_lh_loc     = na

var float i_sos_watch_hh    = na
var int   i_sos_watch_hh_loc= na
var float i_sos_watch_ll    = na
var int   i_sos_watch_ll_loc= na

float i_lbl_y_offset = syminfo.mintick * 100   // vertical offset for iBOS/iSOS (smaller number = closer to the line)

// ── Stop internal tracking on external SOS ───────────────
if showInternal and (st.bull_bos or st.bear_bos or st.bull_sos or st.bear_sos)
    if not na(i_sw_line)
        line.set_x2(i_sw_line, bar_index)
        i_sw_line := na
    i_sw_lbl          := na
    i_sw_price        := na
    i_mode            := 0
    i_seeded          := false
    i_pb_count        := 0
    i_pb_started      := false
    i_tracked_ext     := na
    i_tracked_ext_loc := na
    i_last_hl         := na
    i_last_lh         := na
    i_had_bos         := false
    i_sos_watch_hh    := na
    i_sos_watch_ll    := na

// ── Track prev bar ────────────────────────────────────────
if showInternal
    i_prev_high := high
    i_prev_low  := low


// ── Seed on new external swing ────────────────────────────
if showInternal
    if st.new_swing_low and not st.bull_sos and not st.bear_sos
        i_mode            := 1
        i_seeded          := true
        i_had_bos         := false
        i_bos_dir         := 0
        i_pb_started      := false
        i_pb_extreme      := na
        i_pb_count        := 0
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_mode       := 1
        i_last_hl         := na
        i_last_lh         := na
        i_sos_watch_hh    := na
        i_sos_watch_ll    := na
    else if st.new_swing_high and not st.bull_sos and not st.bear_sos
        i_mode            := -1
        i_seeded          := true
        i_had_bos         := false
        i_bos_dir         := 0
        i_pb_started      := false
        i_pb_extreme      := na
        i_pb_count        := 0
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_mode       := -1
        i_last_hl         := na
        i_last_lh         := na
        i_sos_watch_hh    := na
        i_sos_watch_ll    := na

// ── Mode 1: track upward move → confirm iSH ──────────────
if showInternal and i_seeded and i_mode == 1
    if not i_pb_started
        i_pb_started     := true
        i_pb_extreme     := high
        i_pb_extreme_loc := bar_index
        i_pb_count       := 0
        i_pb_lqc         := na
        i_pb_lqh         := na
    else
        // Update extreme if new high
        i_ext_chg := false
        if high > i_pb_extreme
            i_pb_extreme     := high
            i_pb_extreme_loc := bar_index
            i_pb_count       := 0
            i_pb_lqc         := na
            i_pb_lqh         := na
            i_ext_chg        := true
        // is_inside and qualifying bar checks (exact external rule)
        i_is_inside := not na(i_prev_high) and not na(i_prev_low) and high < i_prev_high and low > i_prev_low
        i_ext_dir   := i_ext_chg and close < open
        i_is_c1     := na(i_pb_lqc) and not i_ext_chg
        if (not i_is_inside or i_is_c1) and (not i_ext_chg or i_ext_dir)
            i_thresh := na(i_pb_lqh) ? i_pb_extreme : i_pb_lqh
            if close < i_thresh - pbBuffer
                i_pb_count += 1
                i_pb_lqc   := close
                i_pb_lqh   := low
        // 3 bars confirmed → iSH
        if i_pb_count >= 3 and not na(i_pb_extreme)
            if not na(i_sw_line)
                line.set_x2(i_sw_line, bar_index)
            i_sw_line  := na
            i_sw_lbl   := na
            i_sw_price := i_pb_extreme
            i_sw_loc   := i_pb_extreme_loc
            // Label: iSH if first swing, iHH if higher than last, iLH if lower
            i_h_lbl := not i_had_bos ? "iSH" : "iHH"
            i_h_col := not i_had_bos ? iBearColor : iBullColor
            i_sw_line  := line.new(i_sw_loc, i_sw_price, bar_index, i_sw_price, color = color.new(i_h_col, 15), style = line.style_dotted, width = 1)
            i_sw_lbl   := label.new(i_sw_loc, i_sw_price, i_h_lbl + "\n", color = color(na), textcolor = color.new(i_h_col, 15), style = label.style_label_down, size = size.tiny)
            i_mode       := 0
            i_pb_count   := 0
            i_pb_started := false

// ── Mode -1: track downward move → confirm iSL ───────────
if showInternal and i_seeded and i_mode == -1
    if not i_pb_started
        i_pb_started     := true
        i_pb_extreme     := low
        i_pb_extreme_loc := bar_index
        i_pb_count       := 0
        i_pb_lqc         := na
        i_pb_lqh         := na
    else
        // Update extreme if new low
        i_ext_chg := false
        if low < i_pb_extreme
            i_pb_extreme     := low
            i_pb_extreme_loc := bar_index
            i_pb_count       := 0
            i_pb_lqc         := na
            i_pb_lqh         := na
            i_ext_chg        := true
        // is_inside and qualifying bar checks
        i_is_inside := not na(i_prev_high) and not na(i_prev_low) and high < i_prev_high and low > i_prev_low
        i_ext_dir   := i_ext_chg and close > open
        i_is_c1     := na(i_pb_lqc) and not i_ext_chg
        if (not i_is_inside or i_is_c1) and (not i_ext_chg or i_ext_dir)
            i_thresh := na(i_pb_lqh) ? i_pb_extreme : i_pb_lqh
            if close > i_thresh + pbBuffer
                i_pb_count += 1
                i_pb_lqc   := close
                i_pb_lqh   := high
        // 3 bars confirmed → iSL
        if i_pb_count >= 3 and not na(i_pb_extreme)
            if not na(i_sw_line)
                line.set_x2(i_sw_line, bar_index)
            i_sw_line  := na
            i_sw_lbl   := na
            i_sw_price := i_pb_extreme
            i_sw_loc   := i_pb_extreme_loc
            // Label: iSL if first swing, iLL if lower than last, iHL if higher
            i_l_lbl := not i_had_bos ? "iSL" : "iLL"
            i_l_col := not i_had_bos ? iBullColor : iBearColor
            i_sw_line  := line.new(i_sw_loc, i_sw_price, bar_index, i_sw_price, color = color.new(i_l_col, 15), style = line.style_dotted, width = 1)
            i_sw_lbl   := label.new(i_sw_loc, i_sw_price, "\n" + i_l_lbl, color = color(na), textcolor = color.new(i_l_col, 15), style = label.style_label_up, size = size.tiny)
            i_mode       := 0
            i_pb_count   := 0
            i_pb_started := false

// ── Track extreme while watching (mode 0) ────────────────
if showInternal and i_seeded and i_mode == 0
    if i_last_mode == 1
        if na(i_tracked_ext) or low < i_tracked_ext
            i_tracked_ext     := low
            i_tracked_ext_loc := bar_index
    else if i_last_mode == -1
        if na(i_tracked_ext) or high > i_tracked_ext
            i_tracked_ext     := high
            i_tracked_ext_loc := bar_index

// ── iBOS / iSOS detection ────────────────────────────────
bool int_bull_break = false
bool int_bear_break = false
int  int_break_origin_loc = na

if showInternal and i_mode == 0 and i_seeded and not na(i_sw_price) and barstate.isconfirmed
    if close > i_sw_price and i_last_mode == 1
        i_mid := math.round((i_sw_loc + bar_index) / 2)
        label.new(i_mid, i_sw_price + i_lbl_y_offset, "iBOS", color = color(na), textcolor = iBullColor, style = label.style_none, size = size.tiny, textalign = text.align_center)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sw_line := na
        i_sw_lbl := na
        if not na(i_tracked_ext)
            line.new(i_tracked_ext_loc, i_tracked_ext, bar_index, i_tracked_ext, color = color.new(iBullColor, 15), style = line.style_dotted, width = 1)
            label.new(i_tracked_ext_loc, i_tracked_ext, "\niHL", color = color(na), textcolor = color.new(iBullColor, 15), style = label.style_label_up, size = size.tiny)
            i_last_hl     := i_tracked_ext
            i_last_hl_loc := i_tracked_ext_loc

        int_bull_break := true
        int_break_origin_loc := i_tracked_ext_loc

        i_sw_price       := na
        i_tracked_ext    := na
        i_tracked_ext_loc := na
        i_pb_count       := 0
        i_pb_started     := false
        i_pb_lqc         := na
        i_pb_lqh         := na
        i_had_bos        := true
        i_bos_dir        := 1
        i_last_mode      := 1
        i_mode           := 1
        i_sos_watch_ll   := na

    else if close < i_sw_price and i_last_mode == -1
        i_mid2 := math.round((i_sw_loc + bar_index) / 2)
        label.new(i_mid2, i_sw_price - i_lbl_y_offset, "iBOS", color = color(na), textcolor = iBearColor, style = label.style_none, size = size.tiny, textalign = text.align_center)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sw_line := na
        i_sw_lbl := na
        if not na(i_tracked_ext)
            line.new(i_tracked_ext_loc, i_tracked_ext, bar_index, i_tracked_ext, color = color.new(iBearColor, 15), style = line.style_dotted, width = 1)
            label.new(i_tracked_ext_loc, i_tracked_ext, "iLH\n", color = color(na), textcolor = color.new(iBearColor, 15), style = label.style_label_down, size = size.tiny)
            i_last_lh     := i_tracked_ext
            i_last_lh_loc := i_tracked_ext_loc

        int_bear_break := true
        int_break_origin_loc := i_tracked_ext_loc

        i_sw_price        := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_pb_count        := 0
        i_pb_started      := false
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_had_bos         := true
        i_bos_dir         := -1
        i_last_mode       := -1
        i_mode            := -1
        i_sos_watch_hh    := na



// ── iSOS detection (watches last iHL / iLH) ──────────────
if showInternal and i_seeded and i_had_bos and barstate.isconfirmed
    if i_last_mode == 1 and not na(i_last_hl) and close < i_last_hl and i_mode == 0
        i_mid2 := math.round((i_last_hl_loc + bar_index) / 2)
        label.new(i_mid2, i_last_hl - i_lbl_y_offset, "iSOS", color = color(na), textcolor = iBearColor, style = label.style_none, size = size.tiny, textalign = text.align_center)
        line.new(i_last_hl_loc, i_last_hl, bar_index, i_last_hl, color = color.new(iBearColor, 15), style = line.style_dotted, width = 1)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sw_line := na

        i_sos_watch_hh     := i_sw_price
        i_sos_watch_hh_loc := i_sw_loc
        i_sos_watch_ll     := na

        int_bear_break := true
        int_break_origin_loc := i_sw_loc

        i_sw_lbl          := na
        i_sw_price        := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_hl         := na
        i_pb_count        := 0
        i_pb_started      := false
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_last_mode       := -1
        i_mode            := -1

    else if i_last_mode == -1 and not na(i_last_lh) and close > i_last_lh and i_mode == 0
        i_mid := math.round((i_last_lh_loc + bar_index) / 2)
        label.new(i_mid, i_last_lh + i_lbl_y_offset, "iSOS", color = color(na), textcolor = iBullColor, style = label.style_none, size = size.tiny, textalign = text.align_center)
        line.new(i_last_lh_loc, i_last_lh, bar_index, i_last_lh, color = color.new(iBullColor, 15), style = line.style_dotted, width = 1)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sw_line := na

        i_sos_watch_ll     := i_sw_price
        i_sos_watch_ll_loc := i_sw_loc
        i_sos_watch_hh     := na

        int_bull_break := true
        int_break_origin_loc := i_sw_loc

        i_sw_lbl          := na
        i_sw_price        := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_lh         := na
        i_pb_count        := 0
        i_pb_started      := false
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_last_mode       := 1
        i_mode            := 1

    else if i_last_mode == -1 and not na(i_sos_watch_hh) and close > i_sos_watch_hh and i_mode == 0
        i_mid := math.round((i_sos_watch_hh_loc + bar_index) / 2)
        label.new(i_mid, i_sos_watch_hh + i_lbl_y_offset, "iSOS", color = color(na), textcolor = iBullColor, style = label.style_none, size = size.tiny, textalign = text.align_center)
        line.new(i_sos_watch_hh_loc, i_sos_watch_hh, bar_index, i_sos_watch_hh, color = color.new(iBullColor, 15), style = line.style_dotted, width = 1)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sw_line := na

        i_sos_watch_ll     := i_sw_price
        i_sos_watch_ll_loc := i_sw_loc

        int_bull_break := true
        int_break_origin_loc := i_sw_loc

        i_sw_lbl          := na
        i_sw_price        := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_lh         := na
        i_pb_count        := 0
        i_pb_started      := false
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_last_mode       := 1
        i_mode            := 1
        i_sos_watch_hh    := na

    else if i_last_mode == 1 and not na(i_sos_watch_ll) and close < i_sos_watch_ll and i_mode == 0
        i_mid2 := math.round((i_sos_watch_ll_loc + bar_index) / 2)
        label.new(i_mid2, i_sos_watch_ll - i_lbl_y_offset, "iSOS", color = color(na), textcolor = iBearColor, style = label.style_none, size = size.tiny, textalign = text.align_center)
        line.new(i_sos_watch_ll_loc, i_sos_watch_ll, bar_index, i_sos_watch_ll, color = color.new(iBearColor, 15), style = line.style_dotted, width = 1)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sw_line := na

        i_sos_watch_hh     := i_sw_price
        i_sos_watch_hh_loc := i_sw_loc

        int_bear_break := true
        int_break_origin_loc := i_sw_loc

        i_sw_lbl          := na
        i_sw_price        := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_hl         := na
        i_pb_count        := 0
        i_pb_started      := false
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_last_mode       := -1
        i_mode            := -1
        i_sos_watch_ll    := na

// ── Update last_mode when mode changes ───────────────────
if showInternal and i_mode != 0
    i_last_mode := i_mode

// ── Order Blocks: create on INTERNAL breaks ── (mpc_assistant.pine 1290-1317). Runs
// AFTER the external path, pushing into the SAME shared arrays, so an internal OB can
// evict an external one (and vice versa). int_bull_break / int_bear_break /
// int_break_origin_loc are finalized above by the iBOS/iSOS detection.
if int_bull_break and not na(int_break_origin_loc)
    int lookbackIdx = bar_index - int_break_origin_loc
    if lookbackIdx >= 0 and lookbackIdx < 500
        int obIdx = na
        for i = lookbackIdx to math.min(lookbackIdx + 20, bar_index)
            if close[i] < open[i]
                obIdx := i
                break
        if not na(obIdx)
            float obTop = obBodyOnly ? math.max(open[obIdx], close[obIdx]) : high[obIdx]
            float obBot = obBodyOnly ? math.min(open[obIdx], close[obIdx]) : low[obIdx]
            activeBullOBs.manageOBs(OrderBlock.new(obTop, obBot, true))
            obBullCreated += 1

if int_bear_break and not na(int_break_origin_loc)
    int lookbackIdx = bar_index - int_break_origin_loc
    if lookbackIdx >= 0 and lookbackIdx < 500
        int obIdx = na
        for i = lookbackIdx to math.min(lookbackIdx + 20, bar_index)
            if close[i] > open[i]
                obIdx := i
                break
        if not na(obIdx)
            float obTop = obBodyOnly ? math.max(open[obIdx], close[obIdx]) : high[obIdx]
            float obBot = obBodyOnly ? math.min(open[obIdx], close[obIdx]) : low[obIdx]
            activeBearOBs.manageOBs(OrderBlock.new(obTop, obBot, false))
            obBearCreated += 1

// ── Extend active swing line every bar ────────────────────
if showInternal and not na(i_sw_line)
    line.set_x2(i_sw_line, bar_index)

// ═══════════════════════════════════════════════════════════════════════════
//  PARITY-EXPORT PLOTS  (added for Python-vs-Pine validation only)
//  Read AFTER the engine has fully processed the bar, so each series holds this
//  bar's final value. Colors are fully transparent (alpha 100) so they don't
//  clutter the pane — transparency does NOT remove them from the data export,
//  unlike display.none (which WOULD, so it is deliberately not used here).
//  Export: chart menu (…) → Export chart data → CSV, then run
//  market_structure/tools/compare_tradingview.py <that file>.
// ═══════════════════════════════════════════════════════════════════════════
plot(st.ash,                    "px_ash",          color = color.new(color.red,    100))
plot(st.asl,                    "px_asl",          color = color.new(color.blue,   100))
plot(st.dir,                    "px_dir",          color = color.new(color.gray,   100))
plot(st.last_conf_high,         "px_lch",          color = color.new(color.red,    100))
plot(st.last_conf_low,          "px_lcl",          color = color.new(color.blue,   100))
plot(st.bull_bos       ? 1 : 0, "px_bull_bos",     color = color.new(color.green,  100))
plot(st.bear_bos       ? 1 : 0, "px_bear_bos",     color = color.new(color.green,  100))
plot(st.bull_sos       ? 1 : 0, "px_bull_sos",     color = color.new(color.green,  100))
plot(st.bear_sos       ? 1 : 0, "px_bear_sos",     color = color.new(color.green,  100))
plot(st.new_swing_high ? 1 : 0, "px_new_sh",       color = color.new(color.green,  100))
plot(st.new_swing_low  ? 1 : 0, "px_new_sl",       color = color.new(color.green,  100))
plot(i_sw_price,                "px_i_sw",         color = color.new(color.orange, 100))
plot(i_mode,                    "px_i_mode",       color = color.new(color.gray,   100))
plot(int_bull_break    ? 1 : 0, "px_i_bull_break", color = color.new(color.green,  100))
plot(int_bear_break    ? 1 : 0, "px_i_bear_break", color = color.new(color.green,  100))

// Break-leg endpoints — emitted ONLY on the break bar (na otherwise) so they line up with the
// Python event fields, which are None except on the break bar. Prices compare directly; the
// _loc columns are exported as "bars ago" (bar_index - loc) so they match despite Pine's
// absolute bar_index differing from the Python engine's 0-based row index by a constant offset.
plot(st.bull_bos ? st.bull_bos_high : na,                "px_bull_bos_high",  color = color.new(color.green, 100))
plot(st.bull_bos ? (bar_index - st.bull_bos_h_loc) : na, "px_bull_bos_h_ago", color = color.new(color.green, 100))
plot(st.bull_bos ? st.bull_bos_low : na,                 "px_bull_bos_low",   color = color.new(color.green, 100))
plot(st.bull_bos ? (bar_index - st.bull_bos_l_loc) : na, "px_bull_bos_l_ago", color = color.new(color.green, 100))
plot(st.bear_bos ? st.bear_bos_high : na,                "px_bear_bos_high",  color = color.new(color.green, 100))
plot(st.bear_bos ? (bar_index - st.bear_bos_h_loc) : na, "px_bear_bos_h_ago", color = color.new(color.green, 100))
plot(st.bear_bos ? st.bear_bos_low : na,                 "px_bear_bos_low",   color = color.new(color.green, 100))
plot(st.bear_bos ? (bar_index - st.bear_bos_l_loc) : na, "px_bear_bos_l_ago", color = color.new(color.green, 100))

// ── ORDER-BLOCK PARITY COLUMNS ──────────────────────────────────────────────
// The active arrays are the PRIMARY parity signal: compared slot-by-slot (slot 1 =
// oldest, matching Pine's array index 0 / Python's active_*[0]) they encode creation,
// mitigation AND FIFO eviction in one. Counts + created/mitigated pulses are secondary
// localisers. The internal-break origin is emitted as bars-ago on internal-break bars
// only (na otherwise), same convention as the break-leg columns above.
plot(not na(int_break_origin_loc) ? (bar_index - int_break_origin_loc) : na, "px_i_break_origin_ago", color = color.new(color.green, 100))
plot(array.size(activeBullOBs), "px_ob_bull_count", color = color.new(color.blue, 100))
plot(array.size(activeBearOBs), "px_ob_bear_count", color = color.new(color.red,  100))
plot(obBullCreated,             "px_ob_bull_created", color = color.new(color.blue, 100))
plot(obBearCreated,             "px_ob_bear_created", color = color.new(color.red,  100))
plot(obBullMit,                 "px_ob_bull_mit",     color = color.new(color.blue, 100))
plot(obBearMit,                 "px_ob_bear_mit",     color = color.new(color.red,  100))
plot(array.size(activeBullOBs) > 0 ? array.get(activeBullOBs, 0).top    : na, "px_ob_bull_top_1", color = color.new(color.blue, 100))
plot(array.size(activeBullOBs) > 0 ? array.get(activeBullOBs, 0).bottom : na, "px_ob_bull_bot_1", color = color.new(color.blue, 100))
plot(array.size(activeBullOBs) > 1 ? array.get(activeBullOBs, 1).top    : na, "px_ob_bull_top_2", color = color.new(color.blue, 100))
plot(array.size(activeBullOBs) > 1 ? array.get(activeBullOBs, 1).bottom : na, "px_ob_bull_bot_2", color = color.new(color.blue, 100))
plot(array.size(activeBullOBs) > 2 ? array.get(activeBullOBs, 2).top    : na, "px_ob_bull_top_3", color = color.new(color.blue, 100))
plot(array.size(activeBullOBs) > 2 ? array.get(activeBullOBs, 2).bottom : na, "px_ob_bull_bot_3", color = color.new(color.blue, 100))
plot(array.size(activeBullOBs) > 3 ? array.get(activeBullOBs, 3).top    : na, "px_ob_bull_top_4", color = color.new(color.blue, 100))
plot(array.size(activeBullOBs) > 3 ? array.get(activeBullOBs, 3).bottom : na, "px_ob_bull_bot_4", color = color.new(color.blue, 100))
plot(array.size(activeBullOBs) > 4 ? array.get(activeBullOBs, 4).top    : na, "px_ob_bull_top_5", color = color.new(color.blue, 100))
plot(array.size(activeBullOBs) > 4 ? array.get(activeBullOBs, 4).bottom : na, "px_ob_bull_bot_5", color = color.new(color.blue, 100))
plot(array.size(activeBullOBs) > 5 ? array.get(activeBullOBs, 5).top    : na, "px_ob_bull_top_6", color = color.new(color.blue, 100))
plot(array.size(activeBullOBs) > 5 ? array.get(activeBullOBs, 5).bottom : na, "px_ob_bull_bot_6", color = color.new(color.blue, 100))
plot(array.size(activeBearOBs) > 0 ? array.get(activeBearOBs, 0).top    : na, "px_ob_bear_top_1", color = color.new(color.red, 100))
plot(array.size(activeBearOBs) > 0 ? array.get(activeBearOBs, 0).bottom : na, "px_ob_bear_bot_1", color = color.new(color.red, 100))
plot(array.size(activeBearOBs) > 1 ? array.get(activeBearOBs, 1).top    : na, "px_ob_bear_top_2", color = color.new(color.red, 100))
plot(array.size(activeBearOBs) > 1 ? array.get(activeBearOBs, 1).bottom : na, "px_ob_bear_bot_2", color = color.new(color.red, 100))
plot(array.size(activeBearOBs) > 2 ? array.get(activeBearOBs, 2).top    : na, "px_ob_bear_top_3", color = color.new(color.red, 100))
plot(array.size(activeBearOBs) > 2 ? array.get(activeBearOBs, 2).bottom : na, "px_ob_bear_bot_3", color = color.new(color.red, 100))
plot(array.size(activeBearOBs) > 3 ? array.get(activeBearOBs, 3).top    : na, "px_ob_bear_top_4", color = color.new(color.red, 100))
plot(array.size(activeBearOBs) > 3 ? array.get(activeBearOBs, 3).bottom : na, "px_ob_bear_bot_4", color = color.new(color.red, 100))
plot(array.size(activeBearOBs) > 4 ? array.get(activeBearOBs, 4).top    : na, "px_ob_bear_top_5", color = color.new(color.red, 100))
plot(array.size(activeBearOBs) > 4 ? array.get(activeBearOBs, 4).bottom : na, "px_ob_bear_bot_5", color = color.new(color.red, 100))
plot(array.size(activeBearOBs) > 5 ? array.get(activeBearOBs, 5).top    : na, "px_ob_bear_top_6", color = color.new(color.red, 100))
plot(array.size(activeBearOBs) > 5 ? array.get(activeBearOBs, 5).bottom : na, "px_ob_bear_bot_6", color = color.new(color.red, 100))
