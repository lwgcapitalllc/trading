//============================================================
//  LIQUIDITY LEVELS INPUTS
//============================================================
var GRP_LIQ = "Liquidity Levels"
var i_showLiquidityInput    = input.bool(true,  "Show All Liquidity Levels (REQUIRED — arms sweeps)",  group = GRP_LIQ, display = display.none)
bool i_showLiquidity = marketStructureOnly ? false : i_showLiquidityInput
var i_showLabels       = input.bool(true,  "Show Labels",                group = GRP_LIQ, active = i_showLiquidityInput, display = display.none)
string liqLabelSize    = input.string("Small", "Liquidity Label Size",   group = GRP_LIQ, options = ["Tiny", "Small", "Normal", "Large", "Huge"], active = i_showLiquidityInput, display = display.none)
bool i_currentDayOnly  = true   // always hide mitigated on new day
bool i_showMitigated   = false  // never show mitigated dotted lines

f_liqSize() =>
    liqLabelSize == "Tiny" ? size.tiny : liqLabelSize == "Normal" ? size.normal : liqLabelSize == "Large" ? size.large : liqLabelSize == "Huge" ? size.huge : size.small

var i_isDailyEnabled   = input.bool(true,  "Previous Day H/L",            group = GRP_LIQ, active = i_showLiquidityInput, display = display.none)
var i_isWeeklyEnabled  = input.bool(true,  "Previous Week H/L",           group = GRP_LIQ, active = i_showLiquidityInput, display = display.none)
var i_showSessionHL    = input.bool(true,  "Sessions H/L",                group = GRP_LIQ, active = i_showLiquidityInput, tooltip = "Shows Asia, London and New York session highs and lows.", display = display.none)

// Single toggle drives all three session H/L sets — kept as separate internal
// flags so the drawing/mitigation logic below stays unchanged.
bool i_showAsiaHL      = i_showSessionHL
bool i_showLondonHL    = i_showSessionHL
bool i_showNYHL        = i_showSessionHL
var i_showPWC          = input.bool(true,  "Previous Week Close (PWC)",   group = GRP_LIQ, active = i_showLiquidityInput, display = display.none)
var i_showH4Sweep      = input.bool(true,  "H4 High/Low Sweep (SSH/BSL)", group = GRP_LIQ, active = i_showLiquidityInput, display = display.none)
var i_lblOffset        = input.int(300,    "Label Y Offset (ticks)",       group = GRP_LIQ, minval = 0, maxval = 5000, step = 50, tooltip = "Moves HIGH labels up and LOW labels down by this many ticks to reduce overlap", display = display.none)
var i_lineExtend       = input.int(50,     "Line Extension (bars)",         group = GRP_LIQ, minval = 5, maxval = 200, display = display.none)

color i_dailyColor    = color.black
color i_weeklyColor   = color.black
color i_asiaHLColor   = color.black
color i_londonHLColor = color.black
color i_nyHLColor     = color.black

