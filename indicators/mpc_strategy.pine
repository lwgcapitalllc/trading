//@version=6
// ============================================================================
//  MPC A+ STRATEGY — backtest wrapper around the MPC-JARVIS engine
// ============================================================================
// Same market-structure / fib / liquidity / FVG / RSI-divergence engine as
// mpc_assistant.pine (kept byte-identical so the A+ sequence stays at parity),
// converted from indicator() to strategy() and given an execution layer at the
// end of the file. It trades ONLY the confirmed A+ reversal sequence:
//   sweep-or-divergence  ->  SOS (shift of structure)  ->  retrace into the
//   0.5-0.886 fib of that leg WITH a live FVG overlapping the zone.
// Exits: SL beyond fib 1.0 (leg origin), scaled fib-target ladder 30/30/40 at
// TP1 (0.5) / TP2 (0.382) / TP3 (0.0 = swing extreme). Sizing: fixed % risk.
// The execution block is the ONLY addition — do not let the engine above it
// drift from mpc_assistant.pine.
// ----------------------------------------------------------------------------
// TRADE-CRITICAL INPUTS — these compute the values the execution block reads, so
// turning ANY of them off stops trades (they are marked "(REQUIRED)" in the
// settings panel). Keep ALL of them ON:
//   • "Hide Everything Except Market Structure"  -> must stay OFF (it force-kills every feature)
//   • "Show External Fib (REQUIRED)"             -> SL / TP / entry price levels
//   • "Show FVG (REQUIRED)"                      -> the entry edges (limit price)
//   • "Show All Liquidity Levels (REQUIRED)"     -> arms setups via sweeps
//   • "Track RSI Divergence (REQUIRED)"          -> arms setups via divergence + veto
// Everything else (Sessions, Kill Zones, VWAP, MV, Order Blocks, Internal/Cycle
// Fib, Sniper, structure labels) is cosmetic and defaults OFF — safe to toggle
// freely, it never affects trade firing.
// ============================================================================
strategy("MPC A+ Strategy", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500, max_bars_back = 2000, initial_capital = 10000, default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 0, calc_on_every_tick = false, process_orders_on_close = false, commission_type = strategy.commission.cash_per_contract, commission_value = 0, slippage = 0, margin_long = 0.2, margin_short = 0.2)
var GRP_TABLE = "Confirmation Table"
bool showConfTable = input.bool(false, "Show Confirmation Table", group = GRP_TABLE, display = display.none)
string tablePositionInput = input.string("Top Center", "Table Position", group = GRP_TABLE, options = ["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], display = display.none)
string tableSizeInput = input.string("Tiny", "Table Text Size", group = GRP_TABLE, options = ["Tiny", "Small", "Normal", "Large", "Huge"], display = display.none)

f_tablePosition(string opt) =>
    switch opt
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Top Right"     => position.top_right
        "Middle Left"   => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right"  => position.middle_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        "Bottom Right"  => position.bottom_right
        => position.top_right

f_tableSize(string opt) =>
    switch opt
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge
        => size.tiny


//============================================================
//  SMC SETTINGS (hardcoded)
//============================================================
int   majorLength = 15
color bullColor   = color.blue
color bearColor   = color.red
color iBullColor  = bullColor
color iBearColor  = bearColor

//============================================================
//  MARKET STRUCTURE LABEL SIZE
//============================================================
var GRP_STRUCT = "Market Structure"
bool   marketStructureOnly = input.bool(false, "Hide Everything Except Market Structure", group = GRP_STRUCT, tooltip = "On = show ONLY the structure engine (BOS/SOS/iBOS/iSOS); every other feature is force-disabled regardless of its own toggle. Off (default) = every feature works per its own toggle.", display = display.none)
string structLabelSize  = input.string("Small", "Structure Label Size",    group = GRP_STRUCT, options = ["Tiny", "Small", "Normal", "Large", "Huge"], display = display.none)
bool   showExternal     = input.bool(true,      "Show External Structure", group = GRP_STRUCT, display = display.none)
bool   showInternal     = input.bool(false,     "Show Internal Structure", group = GRP_STRUCT, display = display.none)
bool   showHistoricalInternal = input.bool(false, "Show Historic Internal Structure", group = GRP_STRUCT, tooltip = "Keep internal structure labels and lines from previous swing ranges on the chart. Off = only show current swing range internals.", display = display.none)
bool   showSwingLabels  = input.bool(false, "Show Swing Point Labels", group = GRP_STRUCT, tooltip = "Off = hide ASH/ASL, HH/HL, LH/LL and the internal swing point labels, leaving only BOS/SOS and iBOS/iSOS on the chart. The structure engine keeps running exactly as before — fibs, order blocks and the confirmation table are unaffected.", display = display.none)
float  pbBuffer         = 0.0

f_structSize() =>
    not showExternal ? size.auto : structLabelSize == "Tiny" ? size.tiny : structLabelSize == "Normal" ? size.normal : structLabelSize == "Large" ? size.large : structLabelSize == "Huge" ? size.huge : size.small

// Swing-point labels are hidden by making their text transparent, not by skipping
// their creation. The label objects still exist and the engine's state is untouched,
// so structure tracking, fibs, OBs and the table behave identically either way.
f_swingCol(color c) =>
    showSwingLabels ? c : color(na)

// (ORDER BLOCKS, VWAP and the Session Volume Profile / MV line were REMOVED
//  2026-07-25 — the script had gone over Pine's compiled-token cap again
//  (CE10117: 101484 > 100256) after the blocked-trade marker landed. All three
//  were purely cosmetic, defaulted OFF, and were read by NOTHING in the
//  execution layer — verified by grep: zero references after the STRATEGY
//  EXECUTION header. The B-LEG fork dropped the same three on 2026-07-24 for
//  the same reason. They live on in mpc_assistant.pine if the drawing is ever
//  wanted back.)
//============================================================
//  FAIR VALUE GAPS (FVG) INPUTS
//============================================================
var GRP_FVG = "Fair Value Gaps"
bool  showFVGInput      = input.bool(true, "Show FVG (REQUIRED — feeds entries)", group = GRP_FVG, tooltip = "Detects fair value gaps: any 3-candle imbalance where bar A and bar C never overlap (the LuxAlgo definition). The minimum gap size and the middle-bar close test are BOTH split by timeframe — below 15m they match mpc_assistant.pine (no floor, no close test); at 15m and above they are unchanged. See the two FVG Min Gap inputs.", display = display.none)
bool showFVG = marketStructureOnly ? false : showFVGInput
bool  fvgDirOnly   = input.bool(false, "Directional FVGs Only", group = GRP_FVG, active = showFVGInput, tooltip = "Only show FVGs aligned with the current external structure direction — bullish gaps while structure is bullish, bearish gaps while bearish. Misaligned gaps are hidden, not deleted, so they reappear if direction flips back.", display = display.none)
color fvgBullColor = input.color(color.new(color.gray, 80), "Bullish FVG", group = GRP_FVG, inline = "fvgB", active = showFVGInput, display = display.none)
color fvgBearColor = input.color(color.new(color.gray, 80), "Bearish FVG", group = GRP_FVG, inline = "fvgS", active = showFVGInput, display = display.none)
// Minimum gap size floor: a gap must be at least this % of price to count.
// No Auto-Threshold volatility scaling — a fixed floor, now user-tunable.
// FVG minimum-gap floor, SPLIT BY TIMEFRAME — ported from mpc_assistant.pine
// (its lines 149-151). This is why the assistant draws 5m gaps this file did not:
// a %-of-price floor does not scale down. 0.1% of gold at $3,300 is $3.30, wider
// than most WHOLE 5m bars, so one flat floor silently erased nearly every gap
// below 15m. 900 seconds = 15m.
// The 15m-and-above value stays 0.1 and is deliberately NOT the assistant's 0.04:
// at 15m this file's behaviour must not move — it is the A+ baseline and the
// mpc_sos_fade parity reference. ONLY sub-15m changes.
bool  fvgIsLTF     = timeframe.in_seconds() < 900
float fvgThreshLTF = input.float(0.0, "FVG Min Gap - below 15m (% of price)", minval = 0.0, step = 0.01, group = GRP_FVG, active = showFVGInput, tooltip = "Minimum gap size on 1m/3m/5m charts, as a percent of price. Default 0.0 = every 3-candle imbalance counts, which is what mpc_assistant.pine does. Raise it only if the low timeframes get too noisy.", display = display.none)
float fvgThreshHTF = input.float(0.1, "FVG Min Gap - 15m and above (% of price)", minval = 0.0, step = 0.01, group = GRP_FVG, active = showFVGInput, tooltip = "Minimum gap size on 15m and higher, as a percent of price. Default 0.1% — UNCHANGED from before the timeframe split, so every 15m result still reproduces. Note mpc_assistant.pine uses 0.04 here; matching it would move this strategy's baseline, so it is deliberately not matched.", display = display.none)
float fvgThreshPct = fvgIsLTF ? fvgThreshLTF : fvgThreshHTF
// Middle-bar close-cleared test. mpc_assistant.pine has this OFF at every
// timeframe (fvgRequireClose = false); this file hardcoded it ON. Split the same
// way as the floor: forced off below 15m so low-timeframe gaps match the
// assistant, on at 15m+ so the A+ baseline and the Python parity pin
// (EngineConfig.fvg_require_close = True) are untouched.
bool  fvgReqCloseHTF  = input.bool(true, "FVG: middle bar must close past the gap (15m+)", group = GRP_FVG, active = showFVGInput, tooltip = "The classic FVG needs only that bar A and bar C do not overlap. This adds a stricter test: bar B must also CLOSE past the gap. It has always been on in this file and stays on at 15m and above, so results reproduce and the mpc_sos_fade parity pin still holds. Below 15m it is forced OFF regardless of this setting, matching mpc_assistant.pine.", display = display.none)
bool  fvgRequireClose = fvgIsLTF ? false : fvgReqCloseHTF
int   fvgMaxCount  = input.int(7, "Max Active FVGs", minval = 1, maxval = 20, group = GRP_FVG, active = showFVGInput, tooltip = "Only the newest gaps up to this count are kept; oldest are dropped first.", display = display.none)
bool  fvgKeepUntilBroken = input.bool(true, "FVG: keep until broken through (not on tap)", group = GRP_FVG, active = showFVGInput, tooltip = "OFF (default) = a gap is removed the moment price taps its near edge. ON = a tap no longer removes it; the gap stays alive until a candle CLOSES fully through it on the opposite (far) side. A gap that lives longer keeps its resting entry limit alive longer, so flip this to test whether it changes which entries fire.")

//============================================================
//  A+ SETUP SEQUENCE INPUTS
//============================================================
var GRP_APLUS = "A+ Setup"
// (5 dead A+ inputs removed 2026-07-21 — aplusDivOnly / aplusHtfWarn /
//  aplusHtfBlock / aplusReqInt / aplusIgnoreWindow were declared but never
//  read anywhere in this file. Deleted to buy compile tokens for the
//  post-SOS divergence veto exemption. Arming is controlled by the
//  execArmSweep / execArmDiv toggles in the Execution group instead.)
int aplusWindow = input.int(4320, "Max Time: Sweep → SOS (minutes)", minval = 5, maxval = 20160, group = GRP_APLUS, tooltip = "Staleness backstop in TIME: the SOS must fire within this many minutes of the sweep. The real kill switch is narrative (an opposite SOS disarms it), so this only filters extremely old sweeps. Default 4320 = 3 days; ceiling 20160 = 14 days (raised from 4320 on 2026-07-29 — the old ceiling EQUALLED the default, so the field could only be lowered, and typing anything above it was silently clamped).", display = display.none)

//============================================================
//  A+ DEBUG (bar-replay diagnostics — no effect on trades)
//============================================================
var GRP_DEBUG = "A+ Debug"
bool debugShow23 = input.bool(true, "Show missed setups (2 of 3 or better)", group = GRP_DEBUG, tooltip = "Drops one orange callout on every 2-of-3-or-better setup that never became a trade, listing MET / MISSING confluences and the would-be entry price in its tooltip. Which confluences count is read from your inputs. Purely cosmetic — never changes trade results.")
bool debugShow23Disarmed = input.bool(false, "…include ones armed by a disabled source", group = GRP_DEBUG, tooltip = "Off (default) = only show missed setups whose arm source you actually have enabled. On = also show setups armed by the source you switched off, so you can see what the other arm trigger would have caught. Expect a lot more boxes with this on.")
string debug23Filter = input.string("Near misses only", "Which misses to draw", options = ["Near misses only", "All misses", "3-of-3 only"], group = GRP_DEBUG, tooltip = "Near misses only (default) = reached the zone and failed on the FVG, or met all three and still did not fill. 3-of-3 only = fully qualified but no trade. All misses = everything from 2 of 3 up.")
int    debugDays = input.int(3, "Only draw debug callouts from the last N days (0 = all)", group = GRP_DEBUG, minval = 0, maxval = 365, tooltip = "Callouts older than this are not drawn. You are almost never studying a miss from three weeks ago while reading this week's price action, and the old ones are what turn the chart into a wall of boxes. Set 0 to draw the entire history. Applies ONLY to the missed-setup callouts — every real trade always gets its label, however old.")

//============================================================
//  RSI DIVERGENCE INPUTS
//============================================================
var GRP_DIV = "RSI Divergence"
bool showDivInput     = input.bool(true, "Track RSI Divergence (REQUIRED — arms setups + veto)", group = GRP_DIV, tooltip = "Detects regular divergence at the extremes: price makes a lower low while RSI makes a higher low from oversold (bullish), or price a higher high while RSI a lower high from overbought (bearish). Drawn on the chart and tagged as confluence on the A+ setup row. Pivot confirmation lags by the pivot width — the signal prints a few bars after the actual extreme.", display = display.none)
bool showDiv = marketStructureOnly ? false : showDivInput
bool showDivHistory   = input.bool(true, "Show Divergence History", group = GRP_DIV, active = showDivInput, tooltip = "Off = only show divergences from the last 3 days. On = show as far back as possible.", display = display.none)
int  divMaxCount = 10
int  divRsiLen   = input.int(14, "RSI Length", minval = 2, maxval = 50, group = GRP_DIV, active = showDivInput, display = display.none)
int  divPivotLen = input.int(5,  "Pivot Width (bars)", minval = 1, maxval = 20, group = GRP_DIV, active = showDivInput, display = display.none)
int  divOS       = input.int(25, "Oversold Level", minval = 5, maxval = 50, group = GRP_DIV, active = showDivInput, display = display.none)
int  divOB       = input.int(75, "Overbought Level", minval = 50, maxval = 95, group = GRP_DIV, active = showDivInput, display = display.none)
int  divValidBars = input.int(100, "Divergence Valid For (bars)", minval = 10, maxval = 500, group = GRP_DIV, active = showDivInput, tooltip = "How long a divergence counts as live confluence for the A+ setup row.", display = display.none)
bool divVeto      = input.bool(true, "Veto Setups on Extreme/Divergence", group = GRP_DIV, active = showDivInput, tooltip = "Suppresses LONG setups when there's live bearish divergence or RSI is extremely overbought — shows 'Extreme / Possible Reversal' instead. Mirrored for SHORT setups on bullish divergence or extreme oversold.", display = display.none)
int  divExtremeOB = input.int(80, "Extreme Overbought", minval = 50, maxval = 100, group = GRP_DIV, active = showDivInput, display = display.none)
int  divExtremeOS = input.int(20, "Extreme Oversold", minval = 0, maxval = 50, group = GRP_DIV, active = showDivInput, display = display.none)

//============================================================
//  TRADING SESSIONS INPUTS
//============================================================
var GRP_SESS = "Trading Sessions"
bool showSessionsInput         = input.bool(false,  "Show Sessions",      group = GRP_SESS, display = display.none)
bool showSessions = marketStructureOnly ? false : showSessionsInput
bool showSessionNames     = input.bool(false,  "Show session names", group = GRP_SESS, active = showSessionsInput, display = display.none)
bool showHistoricSessions = input.bool(false,  "Show All History", group = GRP_SESS, tooltip = "Off = only show sessions from the current week. On = show sessions as far back as possible.", display = display.none)

bool showSessionOC        = false
bool showSessionTickRange = false
bool showSessionAverage   = false

const string TZ_TOOLTIP_TEXT = "The session's time zone, specified in either GMT notation (e.g., 'GMT-5') or as an IANA time zone database name (e.g., 'America/New_York')."
 + " We recommend the latter since it includes other time-related changes, such as daylight savings."

const string FIRST_SESSION_GROUP = "First Session"
showFirst         = input.bool(true,                         "Show session",     group = FIRST_SESSION_GROUP, display = display.none)
firstSessionName  = input.string("Tokyo",                    "Displayed name",   group = FIRST_SESSION_GROUP, display = display.none, active = showFirst)
firstSessionTime  = input.session("0900-1800",               "Session time",     group = FIRST_SESSION_GROUP, active = showFirst)
firstSessionTZ    = input.string("Asia/Tokyo",               "Session timezone", group = FIRST_SESSION_GROUP, tooltip = TZ_TOOLTIP_TEXT, active = showFirst)
firstSessionColor = input.color(color.new(#FF5252, 92),      "Session color",    group = FIRST_SESSION_GROUP, active = showFirst)

const string SECOND_SESSION_GROUP = "Second Session"
showSecond         = input.bool(true,                        "Show session",     group = SECOND_SESSION_GROUP, display = display.none)
secondSessionName  = input.string("London",                  "Displayed name",   group = SECOND_SESSION_GROUP, display = display.none, active = showSecond)
secondSessionTime  = input.session("0800-1700",              "Session time",     group = SECOND_SESSION_GROUP, active = showSecond)
secondSessionTZ    = input.string("Europe/London",           "Session timezone", group = SECOND_SESSION_GROUP, tooltip = TZ_TOOLTIP_TEXT, active = showSecond)
secondSessionColor = input.color(color.new(#2962FF, 92),     "Session color",    group = SECOND_SESSION_GROUP, active = showSecond)

const string THIRD_SESSION_GROUP = "Third Session"
showThird         = input.bool(true,                         "Show session",     group = THIRD_SESSION_GROUP, display = display.none)
thirdSessionName  = input.string("New York",                 "Displayed name",   group = THIRD_SESSION_GROUP, display = display.none, active = showThird)
thirdSessionTime  = input.session("0800-1700",               "Session time",     group = THIRD_SESSION_GROUP, active = showThird)
thirdSessionTZ    = input.string("America/New_York",         "Session timezone", group = THIRD_SESSION_GROUP, tooltip = TZ_TOOLTIP_TEXT, active = showThird)
thirdSessionColor = input.color(color.new(#FFEB3B, 90),      "Session color",    group = THIRD_SESSION_GROUP, active = showThird)

// (Kill Zones & NY Range were REMOVED 2026-07-22 — the script had gone over
//  Pine's compiled-token cap (CE10117) and both were purely cosmetic, default
