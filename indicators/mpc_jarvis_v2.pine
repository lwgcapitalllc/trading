indicator("MPC JARVIS v1", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500, max_bars_back = 2000)

var GRP_MASTER = "Display"
bool showTradeTools = input.bool(true, "Show FVG, Order Blocks, Sessions & Liquidity", group = GRP_MASTER, tooltip = "Master switch for the discretionary tools: Fair Value Gaps, Order Blocks, Trading Sessions, Kill Zones and Liquidity Levels. Off by default for a clean market-structure-only chart.", display = display.none)

//============================================================
//  SMC SETTINGS (hardcoded)
//============================================================
int   majorLength = 15
color bullColor   = color.blue
color bearColor   = color.red
color iBullColor  = bullColor
color iBearColor  = bearColor

//============================================================
//  MARKET STRUCTURE LABEL SIZE
//============================================================
var GRP_STRUCT = "Market Structure"
bool   marketStructureOnly = not showTradeTools
string structLabelSize  = input.string("Small", "Structure Label Size",    group = GRP_STRUCT, options = ["Tiny", "Small", "Normal", "Large", "Huge"], display = display.none)
bool   showExternal     = input.bool(true,      "Show External Structure", group = GRP_STRUCT, display = display.none)
bool   showInternal     = input.bool(true,      "Show Internal Structure", group = GRP_STRUCT, display = display.none)
bool   showHistoricalInternal = input.bool(false, "Show Historic Internal Structure", group = GRP_STRUCT, tooltip = "Keep internal structure labels and lines from previous swing ranges on the chart. Off = only show current swing range internals.", display = display.none)
bool   showSwingLabels  = input.bool(false, "Show Swing Point Labels", group = GRP_STRUCT, tooltip = "Off = hide ASH/ASL, HH/HL, LH/LL and the internal swing point labels, leaving only BOS/SOS and iBOS/iSOS on the chart. The structure engine keeps running exactly as before — fibs, order blocks and the confirmation table are unaffected.", display = display.none)
int    internalLength   = 5
float  pbBuffer         = 0.0

f_structSize() =>
    not showExternal ? size.auto : structLabelSize == "Tiny" ? size.tiny : structLabelSize == "Normal" ? size.normal : structLabelSize == "Large" ? size.large : structLabelSize == "Huge" ? size.huge : size.small

// Swing-point labels are hidden by making their text transparent, not by skipping
// their creation. The label objects still exist and the engine's state is untouched,
// so structure tracking, fibs, OBs and the table behave identically either way.
f_swingCol(color c) =>
    showSwingLabels ? c : color(na)

//============================================================
//  FAIR VALUE GAPS (FVG) INPUTS
//============================================================
var GRP_FVG = "Fair Value Gaps"
bool  showFVGInput      = input.bool(true, "Show FVG", group = GRP_FVG, tooltip = "Detects fair value gaps: any 3-candle imbalance where bar A and bar C never overlap and the middle bar closed past the gap (the LuxAlgo definition). Gaps below the size threshold are ignored. A gap is removed only when a candle CLOSES fully past it.", display = display.none)
bool showFVG = showTradeTools and showFVGInput
// Logic settings LOCKED to tuned defaults — hidden from the panel so students can't alter detection.
bool  fvgDirOnly      = false
color fvgBullColor    = color.new(color.gray, 80)
color fvgBearColor    = color.new(color.gray, 80)
float fvgThreshLTF    = 0.0
float fvgThreshHTF    = 0.04
float fvgThreshPct    = timeframe.in_seconds() < 900 ? fvgThreshLTF : fvgThreshHTF
bool  fvgRequireClose = false
int   fvgMaxCount     = 10

