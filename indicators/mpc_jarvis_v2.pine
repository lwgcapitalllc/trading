bool  eqShowInput = input.bool(true, "Show Equal Highs/Lows", group = GRP_EQ, tooltip = "Marks EQH (two swing highs at nearly the same price = buy-side liquidity resting above) and EQL (equal lows = sell-side liquidity below), each drawn as a horizontal line until a candle CLOSES through it. Part of the trade-tools master switch.", display = display.none)
// Logic settings LOCKED to tuned defaults — hidden from the panel so students can't alter detection.
int   eqPivotLen  = 2
float eqAtrMult   = 0.1
int   eqMax       = 6
bool  eqExemptFvg = true
color eqhColor    = color.new(color.black, 0)
color eqlColor    = color.new(color.black, 0)

