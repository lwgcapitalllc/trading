// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/ MPL-2.0
//@version=6
// [doc 1] MPC BOS STRATEGY — the break-of-structure CONTINUATION setup  -> docs/mpc_bos_strategy.md
strategy("MPC BOS Strategy Export", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500, max_bars_back = 2000, initial_capital = 10000, default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 0, calc_on_every_tick = false, process_orders_on_close = false, commission_type = strategy.commission.cash_per_contract, commission_value = 0, slippage = 0, margin_long = 0.2, margin_short = 0.2)
// [doc 2] THE INPUT PANEL — one consolidated block, twelve numbered sections  -> docs/mpc_bos_strategy.md
var string G2 = "2 · Market structure"
var string G3 = "3 · What trades"
var string G4 = "4 · What arms it"
var string G5 = "5 · Entry"
var string G6 = "6 · Stop & targets"
var string G7 = "7 · Filters"
var string G8 = "8 · Chart annotations"
var string G9 = "9 · Drawing: fibs"
var string G10 = "10 · Drawing: sessions"

// ── 2 · Market structure ────────────────────────────────────────
bool   showExternal     = input.bool(true,      "Show External Structure", group = G2, display = display.none)
bool   showInternal     = input.bool(false,     "Show Internal Structure", group = G2, display = display.none)
bool   showHistoricalInternal = input.bool(false, "Show Historic Internal Structure", group = G2, tooltip = "Keep internal structure labels and lines from previous swing ranges on the chart. Off = only show current swing range internals.", display = display.none)
bool   showSwingLabels  = input.bool(false, "Show Swing Point Labels", group = G2, tooltip = "Off = hide ASH/ASL, HH/HL, LH/LL and the internal swing point labels, leaving only BOS/SOS and iBOS/iSOS on the chart. The structure engine keeps running exactly as before — fibs, order blocks and the confirmation table are unaffected.", display = display.none)

// ── 3 · What trades ─────────────────────────────────────────────
bool   execLongs   = input.bool(true,  "Trade longs",  group = G3)
bool   execShorts  = input.bool(true,  "Trade shorts", group = G3)
float  execRiskPct = input.float(10, "Risk % per trade", group = G3, minval = 0.1, maxval = 100, step = 0.1, tooltip = "How much of the account each trade risks. Position size is worked out from this and the stop distance, so a wider stop automatically buys a smaller position.")

// ── 4 · What arms it ────────────────────────────────────────────
string bosWhich    = input.string("All", "Which break after the shift", options = ["1st only", "1st + 2nd", "All"], group = G4, tooltip = "Which break after the turn to trade. The first break is the initial push; the rest are continuations. All is the default — taking every break tested better. Note a new break always cancels an older setup still waiting for its pullback.")
float  bosMinDispAtr = input.float(0.0, "   Break must clear the swing by (x ATR)", minval = 0, maxval = 5, step = 0.1, group = G4, tooltip = "How far the breaking candle must close past the level it broke, measured in ATR. A one-tick poke through a high is a stop run, not a break. 0 = accept any break.")
float  bosMinLegAtr  = input.float(0.0, "   Break leg must be at least (x ATR)", minval = 0, maxval = 10, step = 0.25, group = G4, tooltip = "The smallest move that counts as a break. A tiny move leaves a pullback inside the noise, with a stop too tight to survive and targets inside the spread. 0 = no minimum.")
float  bosMaxDays  = input.float(3.0, "   Drop an armed break after (days)", minval = 0.25, maxval = 10, step = 0.25, group = G4, tooltip = "How long a setup waits for its pullback before it is dropped. Counted in bars rather than clock time, so weekends and the daily close do not use it up.")
int    bosMaxPerRegime = input.int(10, "   Max trades between shifts", minval = 1, maxval = 20, group = G4, tooltip = "Stop taking new trades after this many fills since the last turn, until the next one. 10 is effectively off. Lower it to 2 or 3 to stop losses stacking up in one choppy stretch.")
bool   bosReqHold    = input.bool(false, "   Broken level must hold", group = G4, tooltip = "On = a candle closing back through the broken level kills the setup. Careful: with the entry this deep, price normally has to close back through that level to reach the order at all, so the setup usually dies just before it would have filled. It only makes sense with a much shallower entry.")
bool showDivInput     = input.bool(true, "Track RSI divergence (REQUIRED — arms setups + veto)", group = G4, tooltip = "Detects regular divergence at the extremes: price makes a lower low while RSI makes a higher low from oversold (bullish), or price a higher high while RSI a lower high from overbought (bearish). Drawn on the chart and tagged as confluence on the A+ setup row. Pivot confirmation lags by the pivot width — the signal prints a few bars after the actual extreme.", display = display.none)

// ── 5 · Entry ───────────────────────────────────────────────────
string bosFibAnchor = input.string("Break leg", "Measure levels on", options = ["Expansion leg", "Break leg"], group = G5, tooltip = "Which move the entry, the stop and the targets are measured on. Break leg freezes them at the break. Expansion leg keeps measuring while price runs, so the levels move until the pullback starts. Break leg is the default because every tested number here was produced that way — the two have never been compared.")
string bosEntryTop = input.string("0.5", "Shallowest the entry may rest", options = ["0.5", "0.382"], group = G5, tooltip = "The shallowest pullback the strategy will accept. Shallow entries fill far more often and pay far less, because the stop stays where it is while the targets come closer, so the whole ladder compresses. The deep end does not move. Not measured — this is a lever to test.")
bool bosUseFvg    = input.bool(false, "Price the entry off a gap", group = G5, tooltip = "On = the order is placed on a gap inside the pullback. Off is the default = a plain level, and the five settings below grey out. Off, because pricing the entry off a gap was the losing half of the book: the gap decides where the order rests, and it rests too shallow.")
bool execReqFVG   = input.bool(true, "   ↳ ...and require one (no gap = no trade)", group = G5, active = bosUseFvg, tooltip = "On = if no gap qualifies, the setup does not trade at all. Off = it still trades, at the plain level further down. The shallow pocket counts as a gap here, so a setup that has one is not refused.")
bool execFvgDeepOnly = input.bool(true, "   ↳ ...gap must sit fully past the shallow end", group = G5, active = bosUseFvg, tooltip = "On = the whole gap has to sit on the deep side of the shallow end set above. Off = a gap lying across that line also counts. Deeper entries are better prices but are reached less often.")
bool execDeepFib  = input.bool(true, "   ↳ ...deep gap enters at the nearest fib", group = G5, active = bosUseFvg, tooltip = "For a gap sitting deeper than 0.618: rest the order at the nearest level just above the gap — the price you reach first — instead of chasing the gap's own edge, which price may never touch.")
bool execFvg50    = input.bool(false, "   ↳ ...gap across the shallow end enters at it", group = G5, active = bosUseFvg, tooltip = "Last resort: a gap lying across the shallow end of the band rests the order exactly on that line. Ranked below every other source, so it only ever prices a setup nothing better could.")
string bosEntryFib = input.string("0.786", "Fallback entry level", options = ["0.382", "0.5", "0.618", "0.702", "0.786", "0.886"], group = G5, active = not (bosUseFvg and execReqFVG), tooltip = "How deep in the pullback the order rests. This is what actually trades, since pricing off a gap is off by default — the name is left over. Deeper tested clearly better. Do not pair a deep entry with a tighter stop: the stop ends up so small that the spread eats most of the trade.")
bool execConfSZ = input.bool(true, "Compute the Sniper Zone", group = G5, tooltip = "Leave this ON. It only decides whether the Sniper Zone gets CALCULATED at all — turn it off and the zone is never worked out, so the '...Sniper Zone counts as a gap' entry rule in section 3 silently has nothing to use. Whether the zone actually prices an entry is that setting's job, not this one.")
bool execConfSZ2  = input.bool(true,  "   ↳ ...Sniper Zone counts as a gap", group = G5, active = bosUseFvg, tooltip = "Lets the shallow pocket of the break stand in for a gap on a setup that had none. Off = a real gap is strictly required. It can price a trade; it is never something the trade waits for.")
float fvgThreshLTF = input.float(0.0, "FVG Min Gap - below 15m (% of price)", minval = 0.0, step = 0.01, group = G5, tooltip = "Minimum gap size on 1m/3m/5m charts, as a percent of price. Default 0.0 = every 3-candle imbalance counts, which is what mpc_assistant.pine does. Raise it only if the low timeframes get too noisy.", display = display.none)
float fvgThreshHTF = input.float(0.04, "FVG Min Gap - 15m and above (% of price)", minval = 0.0, step = 0.01, group = G5, tooltip = "Minimum gap size on 15m and higher, as a percent of price. Default 0.04% — the SAME floor mpc_assistant.pine draws with, so a gap you can see on the chart is a gap this strategy can trade. On gold at $4,155 that is a $1.66 minimum; the old 0.1% default demanded $4.16 and silently threw away most real 15m gaps. Raise it if the entries get too noisy. ⚠ Not the A+ value — mpc_strategy.pine keeps 0.1 there on purpose.", display = display.none)
bool  fvgReqCloseHTF  = input.bool(false, "FVG: middle bar must close past the gap (15m+)", group = G5, tooltip = "The classic FVG needs only that bar A and bar C do not overlap — that is what mpc_assistant.pine draws, and this now matches it. ON adds a stricter test: bar B must also CLOSE past the gap, which refuses gaps the chart shows. Below 15m it is forced OFF regardless of this setting. ⚠ Not the A+ value — mpc_strategy.pine keeps this ON, and its Python parity pin (EngineConfig.fvg_require_close = True) depends on it.", display = display.none)
int   fvgMaxCount  = input.int(8, "Max Active FVGs", minval = 1, maxval = 20, group = G5, tooltip = "Only the newest gaps up to this count are kept; oldest are dropped first. Default 8 — the SAME cap mpc_assistant.pine keeps, so a gap still drawn on the chart is a gap this strategy still holds. ⚠ Not a full match: the assistant EXEMPTS a gap sitting on an equal-high/low (eqExemptFvg) from this cap, and this file has no EQH/EQL engine, so such a gap is evicted here when the assistant would keep it.", display = display.none)
bool  fvgKeepUntilBroken = input.bool(true, "FVG: keep until broken through (not on tap)", group = G5, tooltip = "OFF (default) = a gap is removed the moment price taps its near edge. ON = a tap no longer removes it; the gap stays alive until a candle CLOSES fully through it on the opposite (far) side. A gap that lives longer keeps its resting entry limit alive longer, so flip this to test whether it changes which entries fire.")
bool eqExemptFvg = input.bool(false, "   ↳ A gap on an EQ level survives the FVG cap", group = G5, tooltip = "ON = a fair value gap sitting on an EQH/EQL is exempt from the Max Active FVGs cap and from the directional filter, so it persists until mitigated instead of being evicted by newer gaps. The idea: a gap backed by resting liquidity is worth more than a gap that is merely recent. ⚠ This is the ONE setting here that changes trades — it changes which gaps exist, so it changes which entries fire. It also puts this file out of sync with its Python port and its export, neither of which model the exemption. OFF by default so nothing historical moves; treat any run with it on as an experiment, not a baseline.")

// ── 6 · Stop & targets ──────────────────────────────────────────
string bosSlModel = input.string("ATR", "Stop model", options = ["Fib 1.0 (leg origin)", "Broken swing level", "Fib 0.886", "Last confirmed swing", "ATR"], group = G6, tooltip = "Where the stop sits. ATR is a fixed distance from the entry and is the default: it was the biggest improvement measured here, because a level-based stop shrinks with the move and can end up inside the spread. Broken swing level sits the wrong side of the entry, so it refuses almost every order.")
float  bosSlAtr   = input.float(1.3, "   ↳ ATR multiple", minval = 0.1, maxval = 10, step = 0.1, group = G6, active = bosSlModel == "ATR", tooltip = "How far the stop sits from the entry, in ATR, when the stop model above is ATR. Anything from about 1.2 to 1.5 gives the same answer, so read it as a range rather than an exact number. Below 1.0 the stop starts landing inside the spread again, which is the problem this stop model exists to remove.")
float  execSlBufTk = input.float(0.0, "Extra room beyond the stop (ticks)", group = G6, minval = 0, tooltip = "Pushes the stop this many ticks further away than the level chosen above, so a wick through it does not take you out.")
string execMoveStop    = input.string("Off", "Moving stop (trails from entry)", options = ["Off", "$ of price", "Structure (swing)"], group = G6, tooltip = "A trailing stop that starts as soon as you are filled, instead of waiting for the second target. It follows the best price the trade has seen and can only ever tighten. Off = the stop stays put until the first target moves it to breakeven.")
float  execMoveStopVal = input.float(5.0, "   ↳ trail distance (unit = mode above)", group = G6, minval = 0.1, step = 0.5, active = execMoveStop != "Off", tooltip = "How far the moving stop sits behind the best price seen. Dollars of price in dollar mode — on gold 1 pip is 10 cents, so 5.0 is 50 pips — or ticks behind the last swing in structure mode. Too tight and normal noise scratches every trade before it can work, so start wide and walk it in.")
float  execTp1Pct  = input.float(0, "TP1 size %", group = G6, minval = 0, maxval = 100, tooltip = "How much of the position the first target banks. 0 is the default and banking here tested worse. Touching the target still moves the stop to breakeven whatever this is set to, so 0 keeps the protection and gives up only the partial.")
float  execTp2Pct  = input.float(0, "TP2 size %", group = G6, minval = 0, maxval = 100, tooltip = "How much of the position the second target banks. 0 by default, for the same reason. Touching it still lifts the stop to its floor and hands the rest onward, so the targets drive the stop whatever the sizes are.")
float  execTp3Pct  = input.float(100, "TP3 size %", group = G6, minval = 0, maxval = 100, tooltip = "How much of the position the last target banks. That target is the far end of the move. 100 is the default, so there is no runner: the whole position leaves there or at the stop climbing behind it, which tested best. Anything under 100 turns the rest into a runner again.")
bool   bosTp3Measured = input.bool(false, "TP3 = measured move", group = G6, tooltip = "Replaces the last target with the classic continuation target: the size of the break projected forward from the level it broke. That sits further out than the end of the move. Ignored when it would land behind the second target. On a shallow entry it is what creates a last target at all.")
float  execBeBufTk = input.float(30, "Breakeven buffer (ticks)", group = G6, minval = 0, tooltip = "The breakeven stop sits this far beyond the entry, so a scratch still covers costs instead of losing a few cents. It is also why TradingView reports no breakevens — those exits book a tiny profit, so it files them as wins. The trade label counts them honestly.")
string execRunnerTrail = input.string("Structure (swing)", "Runner trail method", options = ["Fixed step", "Structure (swing)"], group = G6, tooltip = "How the last part of the position is trailed once the second target is hit. Structure parks the stop at the last swing — it breathes with the trend and usually rides further, but a swing lags, so it hands some back at the turn. Fixed step ratchets on the grid set below.")
float  execStructTrailBufTk = input.float(20, "   ↳ Structure trail buffer (ticks)", group = G6, minval = 0, active = execRunnerTrail == "Structure (swing)", tooltip = "Structure method only. The trailing stop sits this many ticks beyond the swing it is following, so a wick through it does not clip the trade.")
float  execTrailStep = input.float(5.0, "Runner trail step ($ of price)", group = G6, minval = 0.01, step = 0.5, tooltip = "The step size in dollars. Read by two settings, so it is never greyed out: the fixed-step trail ratchets on this grid, and the one-step-behind floor sits this far under the best price seen. On gold 1 pip is 10 cents, so 50 pips = 5.0.")
string execTp2StopMode = input.string("TP1 price", "TP2 → stop floor", options = ["TP1 price", "Breakeven", "One trail step behind"], group = G6, tooltip = "Where the stop jumps to the moment the second target is hit, before the trail takes over. TP1 price is tight and can scratch the trade on the first pullback. Breakeven gives it the most room. The trail can still tighten past this, never loosen it.")
bool bosCloseOppDiv  = input.bool(false, "Close an open trade on opposing divergence", group = G6, tooltip = "On = close the trade when a divergence confirms against it, rather than waiting for the stop or a target — it says the move is overstretched and the next turn is building. It fires on a confirmed divergence only, never on a plain overbought reading.")

// ── 7 · Filters ─────────────────────────────────────────────────
bool bosRespectVeto  = input.bool(false, "Divergence blocks a new entry", group = G7, tooltip = "On = a long will not open while a bearish divergence is live or momentum is extremely overbought, and the mirror for shorts. It is re-checked every bar, so a divergence appearing while the setup waits pulls the order, and the order can go back if it fades.")
string bosVwapReq = input.string("Trend's side", "Session VWAP filter", options = ["Off", "Trend's side"], group = G7, tooltip = "Only trade while price is closing on the trend's own side of the session average price — above it for a long, below for a short. It asks which side price is on, not whether it crossed. It looked good in testing, but on a simplified version of this setup, so treat it as a hint.")
string execHtfWeekly = input.string("Ignore", "Weekly bias requirement", options = ["Ignore", "Must agree", "Must not oppose", "Must oppose (reversal)"], group = G7, tooltip = "Whether the weekly trend has to agree with the trade. Ignore = no filter. Must agree = the weekly has to match. Must not oppose = neutral is fine, only an opposing weekly blocks. For a trend-following setup, Must agree is the natural one to try.")
string execHtfDaily  = input.string("Ignore", "Daily bias requirement",  options = ["Ignore", "Must agree", "Must not oppose", "Must oppose (reversal)"], group = G7, tooltip = "The same four choices, judged on the daily trend. Ignore = off.")
bool execNoLateDay = input.bool(true, "No entries in the final hour (16:00-18:00 NY)", group = G7, tooltip = "Blocks new entries in the last hour before the daily close. Gold closes at 17:00 New York and reopens at 18:00, so a trade opened late can be gapped out over the break. That is a fact about market hours rather than a strategy opinion.")
string execMinStopMode = input.string("% of price", "Minimum stop distance", options = ["Off", "% of price", "Fixed $", "x ATR(14)"], group = G7, tooltip = "Refuse a setup whose stop lands too close to the entry. Size is risk divided by stop distance, so a stop that collapses onto the entry does not risk less — it buys an enormous position that ordinary noise runs straight through. With the ATR stop above it rarely fires, so treat it as a second line of defence.")
float  execMinStopVal  = input.float(0.10, "   ↳ Minimum stop floor (unit = mode above)", group = G7, minval = 0, step = 0.05, active = execMinStopMode != "Off", tooltip = "The floor itself. A percent in percent-of-price mode, dollars of price in fixed mode, a multiple in ATR mode.")

// ── 8 · Chart annotations ───────────────────────────────────────
bool   execShowConfLabel = input.bool(false, "Show entry label", group = G8, tooltip = "One label per trade. Hover it for the full breakdown — which break number armed it, what priced the entry, the stop and both targets. On close it recolours by result and appends the R. Off greys out the two settings below.")
string execLabelWhich = input.string("All", "   ↳ keep labels for which results", options = ["All", "Wins only", "Losses only", "Losses + breakevens", "None"], group = G8, active = execShowConfLabel, tooltip = "Which trades keep their label once the result is known; the rest are deleted on the bar they close. 'Losses + breakevens' is the review view — the trades worth auditing and nothing else.")
float  execLabelOff = input.float(6, "   ↳ label distance from price (ATR)", group = G8, minval = 1, maxval = 40, step = 1, active = execShowConfLabel, tooltip = "How far the label sits from the entry. Raise it so the hover tooltip opens over empty space instead of on top of the candles. A line always connects it back to the entry.")
bool   execShowPosBox = input.bool(false, "Show position box (result)", group = G8, tooltip = "One box per trade, growing to the right while it is open. On close it paints the result: green from entry to the furthest price actually filled, red to the stop fill if it lost, an orange line at entry for a scratch. Off greys out the band labels below.")
bool   execShowExitLines = input.bool(false, "   ↳ Label the TP bands (TP1/TP2/TP3)", group = G8, active = execShowPosBox, tooltip = "Tags each banked exit at its REAL fill price on the right edge of the trade. Off = the coloured bands still paint, just untagged. The prices are always in the entry label's tooltip either way.")
float execBeBandR = input.float(0.15, "Breakeven band (R)", group = G8, minval = 0, step = 0.05, tooltip = "A closed trade landing within this many R of flat is counted as a BREAKEVEN rather than a win or a loss — price went out, came back to entry, and the trade paid nothing. Only affects how results are LABELLED, never the trades themselves.")
bool showBlockTag = input.bool(false, "Mark blocked trades (pink)", group = G8, tooltip = "Drops a pink tag whenever a setup was completely ready to place its order and one of YOUR OWN settings stopped it. These are the only trades invisible everywhere else — no order is placed, so the Strategy Tester cannot know they existed. Hover for the reason and the price the limit would have rested at. This is how you find out whether a filter is saving money or costing it: count the tags, turn the filter off, re-run, compare.")

// ── 9 · Drawing: fibs ───────────────────────────────────────────
bool drawFibs = input.bool(false, "Draw the fib levels", group = G9, tooltip = "Draws the external fib ladder — the entry, stop and target levels — on the chart. OFF by default: the levels are COMPUTED whatever this says, because they price every trade, and this only decides whether you look at them. The old Show External Fib (REQUIRED) checkbox is gone — it gated the calculation, so switching it off stopped the bot trading.")

// ── 10 · Drawing: sessions ──────────────────────────────────────
bool showSessionsInput         = input.bool(false,  "Show Sessions",      group = G10, display = display.none)

// [doc 3] (The "Confirmation Table" group — 3 inputs + f_tablePosition + f_tableSi  -> docs/mpc_bos_strategy.md

// [doc 4] SMC SETTINGS (hardcoded)  -> docs/mpc_bos_strategy.md
int   majorLength = 15
color bullColor   = color.blue
color bearColor   = color.red
color iBullColor  = bullColor
color iBearColor  = bearColor

// [doc 5] MARKET STRUCTURE LABEL SIZE  -> docs/mpc_bos_strategy.md
string structLabelSize  = "Small"
float  pbBuffer         = 0.0

f_structSize() =>
    not showExternal ? size.auto : structLabelSize == "Tiny" ? size.tiny : structLabelSize == "Normal" ? size.normal : structLabelSize == "Large" ? size.large : structLabelSize == "Huge" ? size.huge : size.small

// [doc 6] Swing-point labels are hidden by making their text transparent, not by s  -> docs/mpc_bos_strategy.md
f_swingCol(color c) =>
    showSwingLabels ? c : color(na)

// [doc 7] (ORDER BLOCKS, VWAP and the Session Volume Profile / MV line were REMOVE  -> docs/mpc_bos_strategy.md
bool showFVG = true   // CALCULATION, permanently on — the gap boxes ARE the entry storage
bool  fvgDirOnly   = false
color fvgBullColor = color.new(color.gray, 80)
color fvgBearColor = color.new(color.gray, 80)
// [doc 8] Minimum gap size floor: a gap must be at least this % of price to count.  -> docs/mpc_bos_strategy.md
bool  fvgIsLTF     = timeframe.in_seconds() < 900
float fvgThreshPct = fvgIsLTF ? fvgThreshLTF : fvgThreshHTF
// [doc 9] Middle-bar close-cleared test — the SECOND reason a gap on the chart was  -> docs/mpc_bos_strategy.md
bool  fvgRequireClose = fvgIsLTF ? false : fvgReqCloseHTF

// [doc 10] (DELETED 2026-07-31 — two whole groups that did nothing here)  -> docs/mpc_bos_strategy.md

// [doc 11] RSI DIVERGENCE INPUTS  -> docs/mpc_bos_strategy.md
bool showDiv = showDivInput
bool showDivHistory   = true
int  divMaxCount = 10
int  divRsiLen   = 14
int  divPivotLen = 5
int  divOS       = 25
int  divOB       = 75
int  divValidBars = 100
// [doc 12] (`divVeto` deleted 2026-07-31 — it was the A+'s veto switch and nothing   -> docs/mpc_bos_strategy.md
int  divExtremeOB = 80
int  divExtremeOS = 20

// [doc 13] TRADING SESSIONS INPUTS  -> docs/mpc_bos_strategy.md
bool showSessions = showSessionsInput
bool showSessionNames     = false
bool showHistoricSessions = false

bool showSessionOC        = false
bool showSessionTickRange = false
bool showSessionAverage   = false

const string TZ_TOOLTIP_TEXT = "The session's time zone, specified in either GMT notation (e.g., 'GMT-5') or as an IANA time zone database name (e.g., 'America/New_York')."
 + " We recommend the latter since it includes other time-related changes, such as daylight savings."

showFirst         = true
firstSessionName  = "Tokyo"
firstSessionTime  = "0900-1800"
firstSessionTZ    = "Asia/Tokyo"
firstSessionColor = color.new(#FF5252, 92)

showSecond         = true
secondSessionName  = "London"
secondSessionTime  = "0800-1700"
secondSessionTZ    = "Europe/London"
secondSessionColor = color.new(#2962FF, 92)

showThird         = true
thirdSessionName  = "New York"
thirdSessionTime  = "0800-1700"
thirdSessionTZ    = "America/New_York"
thirdSessionColor = color.new(#FFEB3B, 90)

// [doc 14] (Kill Zones & NY Range were REMOVED 2026-07-22 — the script had gone ove  -> docs/mpc_bos_strategy.md

// [doc 15] LIQUIDITY LEVELS INPUTS  -> docs/mpc_bos_strategy.md
bool i_showLiquidity = true   // CALCULATION, permanently on — it arms every sweep
var i_showLabels       = true
string liqLabelSize    = "Small"
bool i_currentDayOnly  = true   // always hide mitigated on new day
bool i_showMitigated   = false  // never show mitigated dotted lines

f_liqSize() =>
    liqLabelSize == "Tiny" ? size.tiny : liqLabelSize == "Normal" ? size.normal : liqLabelSize == "Large" ? size.large : liqLabelSize == "Huge" ? size.huge : size.small

var i_isDailyEnabled   = true
var i_isWeeklyEnabled  = true
var i_showSessionHL    = true

// Single toggle drives all three session H/L sets — kept as separate internal
// flags so the drawing/mitigation logic below stays unchanged.
bool i_showAsiaHL      = i_showSessionHL
bool i_showLondonHL    = i_showSessionHL
bool i_showNYHL        = i_showSessionHL
var i_showPWC          = true
var i_showH4Sweep      = true
var i_lblOffset        = 300
var i_lineExtend       = 50

color i_dailyColor    = color.black
color i_weeklyColor   = color.black
color i_asiaHLColor   = color.black
color i_londonHLColor = color.black
color i_nyHLColor     = color.black

// [doc 16] INTERNAL FIB INPUTS  -> docs/mpc_bos_strategy.md
bool showIFibInput     = false
bool showIFib = showIFibInput
int  iFibExtend   = 30

color  iFibo1Color    = #4caf50
