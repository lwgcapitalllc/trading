color  macro100Color     = #2196F3
string macro100Style     = "─"

// [doc 19] SNIPER FIB INPUTS  -> docs/mpc_bos_strategy.md
bool showSniperFib = false

// [doc 20] Entry-confirmation toggle, declared HERE (not down in the Strategy Execu  -> docs/mpc_bos_strategy.md

// [doc 21] MARKET STRUCTURE OVERRIDE — applied after every other toggle above is  -> docs/mpc_bos_strategy.md

// [doc 22] SMC STRUCTURE TYPE  -> docs/mpc_bos_strategy.md
type SMCStructure
    int    length
    float  ash             = na
    int    ash_loc         = na
    string ash_type        = ""
    line   ash_line        = na
    label  ash_lbl         = na
    float  asl             = na
    int    asl_loc         = na
    string asl_type        = ""
    line   asl_line        = na
    label  asl_lbl         = na
    float  last_conf_high     = na
    int    last_conf_high_loc = na
    float  last_conf_low      = na
    int    last_conf_low_loc  = na
    int    dir            = 0
    bool   choch_lock     = false
    line   choch_ref      = na
    int    pb_mode        = 0
    int    pb_count       = 0
    float  pb_level       = na
    float  pb_extreme     = na
    int    pb_extreme_loc = na
    line   pb_line        = na
    bool   pb_started     = false
    float  pb_last_qualify_close = na
    float  pb_last_qualify_high  = na
    float  pb_extreme_close      = na
    float  prev_close     = na
    float  prev_high      = na
    float  prev_low       = na
    bool   seeded         = false
    bool   bull_bos       = false
    float  bull_bos_high  = na
    int    bull_bos_h_loc = na
    float  bull_bos_low   = na
    int    bull_bos_l_loc = na
    bool   bear_bos       = false
    float  bear_bos_high  = na
    int    bear_bos_h_loc = na
    float  bear_bos_low   = na
    int    bear_bos_l_loc = na
    bool   new_swing_high = false
    bool   new_swing_low  = false
    bool   bull_sos       = false
    bool   bear_sos       = false

// prefix: "" for external, "i" for internal
// bull_col / bear_col allow per-instance colors
method create_ash(SMCStructure st, float val, int loc, color col, bool solid, string prefix) =>
    if not na(st.ash_line)
        line.delete(st.ash_line)
    if not na(st.ash_lbl)
        label.delete(st.ash_lbl)
        st.ash_lbl := na
    st.ash      := val
    st.ash_loc  := loc
    st.ash_type := ""
    st.ash_lbl  := label.new(loc, val, prefix + "ASH\n", color=color(na), textcolor=f_swingCol(col), style=label.style_label_down, size=f_structSize())
    st.ash_line := line.new(loc, val, bar_index, val, color=col, style=solid ? line.style_solid : line.style_dashed, width=solid ? 2 : 1)

method create_asl(SMCStructure st, float val, int loc, color col, bool solid, string prefix) =>
    if not na(st.asl_line)
        line.delete(st.asl_line)
    if not na(st.asl_lbl)
        label.delete(st.asl_lbl)
        st.asl_lbl := na
    st.asl      := val
    st.asl_loc  := loc
    st.asl_type := ""
    st.asl_lbl  := label.new(loc, val, "\n" + prefix + "ASL", color=color(na), textcolor=f_swingCol(col), style=label.style_label_up, size=f_structSize())
    st.asl_line := line.new(loc, val, bar_index, val, color=col, style=solid ? line.style_solid : line.style_dashed, width=solid ? 2 : 1)

// process() now accepts prefix + bull/bear colors so both instances share one method
method process(SMCStructure st, float ph_val, float pl_val, string prefix, color bull_col, color bear_col) =>

    st.bull_bos := false
    st.bear_bos := false
    st.new_swing_high := false
    st.new_swing_low  := false
    st.bull_sos := false
    st.bear_sos := false

    bool is_inside = false
    if not na(st.prev_high) and not na(st.prev_low)
        is_inside := high < st.prev_high and low > st.prev_low

    if st.choch_lock
        if st.dir == 1 and not na(pl_val)
            st.choch_lock := false
        else if st.dir == -1 and not na(ph_val)
            st.choch_lock := false

    if st.pb_mode == 1
        if not st.pb_started
            st.pb_started            := true
            st.pb_extreme            := high
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_count              := 0
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
        else
            bool extreme_updated_1 = false
            if na(st.pb_extreme) or high > st.pb_extreme
                st.pb_extreme            := high
                st.pb_extreme_loc        := bar_index
                st.pb_extreme_close      := na
                st.pb_count              := 0
                st.pb_last_qualify_close := na
                st.pb_last_qualify_high  := na
                extreme_updated_1        := true
            bool extreme_is_bearish_1 = extreme_updated_1 and close < open
            bool is_candle1_1 = na(st.pb_last_qualify_close) and not extreme_updated_1
            if (not is_inside or is_candle1_1) and (not extreme_updated_1 or extreme_is_bearish_1)
                float threshold = na(st.pb_last_qualify_high) ? st.pb_extreme : st.pb_last_qualify_high
                if close < threshold - pbBuffer
                    st.pb_count              += 1
                    st.pb_last_qualify_close := close
                    st.pb_last_qualify_high  := low
            if st.pb_count >= 3 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
                if not na(st.ash_line)
                    line.delete(st.ash_line)
                if not na(st.ash_lbl)
                    label.delete(st.ash_lbl)
                st.ash      := st.pb_extreme
                st.ash_loc  := st.pb_extreme_loc
                st.ash_type := "LOCKED"
                st.ash_line := line.new(st.pb_extreme_loc, st.pb_extreme, bar_index, st.pb_extreme, color=bear_col, style=line.style_solid, width=1)
                st.ash_lbl  := label.new(st.pb_extreme_loc, st.pb_extreme, prefix + "ASH\n", color=color(na), textcolor=f_swingCol(bear_col), style=label.style_label_down, size=f_structSize())
                st.new_swing_high := true
                st.pb_mode    := 0
                st.pb_count   := 0
                st.choch_lock := false

    else if st.pb_mode == -1
        if not st.pb_started
            st.pb_started            := true
            st.pb_extreme            := low
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_count              := 0
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
        else
            bool extreme_updated_m1 = false
            if na(st.pb_extreme) or low < st.pb_extreme
                st.pb_extreme            := low
                st.pb_extreme_loc        := bar_index
                st.pb_extreme_close      := na
                st.pb_count              := 0
                st.pb_last_qualify_close := na
                st.pb_last_qualify_high  := na
                extreme_updated_m1       := true
            bool extreme_is_bullish_m1 = extreme_updated_m1 and close > open
            bool is_candle1_m1 = na(st.pb_last_qualify_close) and not extreme_updated_m1
            if (not is_inside or is_candle1_m1) and (not extreme_updated_m1 or extreme_is_bullish_m1)
                float threshold = na(st.pb_last_qualify_high) ? st.pb_extreme : st.pb_last_qualify_high
                if close > threshold + pbBuffer
                    st.pb_count              += 1
                    st.pb_last_qualify_close := close
                    st.pb_last_qualify_high  := high
            if st.pb_count >= 3 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
                if not na(st.asl_line)
                    line.delete(st.asl_line)
                if not na(st.asl_lbl)
                    label.delete(st.asl_lbl)
                st.asl      := st.pb_extreme
                st.asl_loc  := st.pb_extreme_loc
                st.asl_type := "LOCKED"
                st.asl_line := line.new(st.pb_extreme_loc, st.pb_extreme, bar_index, st.pb_extreme, color=bull_col, style=line.style_solid, width=1)
                st.asl_lbl  := label.new(st.pb_extreme_loc, st.pb_extreme, "\n" + prefix + "ASL", color=color(na), textcolor=f_swingCol(bull_col), style=label.style_label_up, size=f_structSize())
                st.new_swing_low := true
                st.pb_mode    := 0
                st.pb_count   := 0
                st.choch_lock := false

    st.prev_close := close
    st.prev_high  := high
    st.prev_low   := low

    if na(st.ash) and na(st.asl) and not st.seeded
        if not na(ph_val)
            st.create_ash(ph_val, bar_index[st.length], bear_col, false, prefix)
            st.dir := -1
        else if not na(pl_val)
            st.create_asl(pl_val, bar_index[st.length], bull_col, false, prefix)
            st.dir := 1

    if not st.seeded
        if not na(st.ash) and na(st.asl)
            float seed_low = low
            int   seed_loc = bar_index
            int   lb       = math.min(bar_index, 500)
            for i = 0 to lb
                if low[i] < seed_low
                    seed_low := low[i]
                    seed_loc := bar_index - i
            if seed_low < st.ash
                st.asl      := seed_low
                st.asl_loc  := seed_loc
                st.asl_type := ""
                st.asl_line := line.new(seed_loc, seed_low, bar_index, seed_low, color=bull_col, style=line.style_dashed, width=1)
                st.asl_lbl  := label.new(seed_loc, seed_low, "\n" + prefix + "ASL", color=color(na), textcolor=f_swingCol(bull_col), style=label.style_label_up, size=f_structSize())
                st.seeded := true
        else if not na(st.asl) and na(st.ash)
            float seed_high = high
            int   seed_loc  = bar_index
            int   lb        = math.min(bar_index, 500)
            for i = 0 to lb
                if high[i] > seed_high
                    seed_high := high[i]
                    seed_loc  := bar_index - i
            if seed_high > st.asl
                st.ash      := seed_high
                st.ash_loc  := seed_loc
                st.ash_type := ""
                st.ash_line := line.new(seed_loc, seed_high, bar_index, seed_high, color=bear_col, style=line.style_dashed, width=1)
                st.ash_lbl  := label.new(seed_loc, seed_high, prefix + "ASH\n", color=color(na), textcolor=f_swingCol(bear_col), style=label.style_label_down, size=f_structSize())
                st.seeded := true
        else if not na(st.ash) and not na(st.asl)
            st.seeded := true

    if na(st.last_conf_high) and na(st.last_conf_low)
        if not na(ph_val) and not na(st.ash) and st.ash_type == "" and st.pb_mode == 0
            if ph_val > st.ash
                st.create_ash(ph_val, bar_index[st.length], bear_col, false, prefix)
        if not na(pl_val) and not na(st.asl) and st.asl_type == "" and st.pb_mode == 0
            if pl_val < st.asl
                st.create_asl(pl_val, bar_index[st.length], bull_col, false, prefix)

    bool ash_broken = not na(st.ash) and close > st.ash
    bool asl_broken = not na(st.asl) and close < st.asl

    if ash_broken
        st.bull_bos := true
        st.bull_bos_high  := st.ash
        st.bull_bos_h_loc := st.ash_loc

        bool was_in_bear_pb = st.pb_mode == -1 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
        st.pb_mode  := 0
        st.pb_count := 0

        bool   is_choch    = st.dir == -1
        string brk_lbl_txt = is_choch ? prefix + "SOS" : prefix + "BOS"
        if is_choch
            st.bull_sos := true
        int    mid_x       = math.round((st.ash_loc + bar_index) / 2)
        label.new(mid_x, st.ash, "\n" + brk_lbl_txt, color=color(na), textcolor=bull_col, style=label.style_label_down, size=size.tiny)

        if is_choch
            st.choch_lock := true

        bool brk_already_conf_high = (st.ash == st.last_conf_high and st.ash_loc == st.last_conf_high_loc)
        if not na(st.ash_lbl)
            label.delete(st.ash_lbl)
        if not brk_already_conf_high
            bool   brk_is_hh  = na(st.last_conf_high) or st.ash >= st.last_conf_high
            string brk_high_t = brk_is_hh ? prefix + "HH" : prefix + "LH"
            color  brk_high_c = brk_is_hh ? bull_col : bear_col
            label.new(st.ash_loc, st.ash, brk_high_t + "\n", color=color(na), textcolor=f_swingCol(brk_high_c), style=label.style_label_down, size=f_structSize())

        if not na(st.ash_line)
            line.set_style(st.ash_line, line.style_solid)
            line.set_color(st.ash_line, bull_col)
            line.set_width(st.ash_line, 2)
            line.set_x2(st.ash_line, bar_index)
            st.ash_line := na

        st.last_conf_high     := st.ash
        st.last_conf_high_loc := st.ash_loc
        st.ash_lbl            := na
        st.ash                := na
        st.dir                := 1

        if was_in_bear_pb
            st.bull_bos_low   := st.pb_extreme
            st.bull_bos_l_loc := st.pb_extreme_loc
            if not na(st.asl_line)
                line.delete(st.asl_line)
            if not na(st.asl_lbl)
                label.delete(st.asl_lbl)
            bool   pb_is_hl = is_choch ? false : (na(st.last_conf_low) or st.pb_extreme >= st.last_conf_low)
            // On an SOS (fast reversal) the extreme is only the ACTIVE swing low —
            // it prints as ASL and is confirmed to HL/LL by the NEXT bullish break.
            string pb_low_t = is_choch ? prefix + "ASL" : (pb_is_hl ? prefix + "HL" : prefix + "LL")
            color  pb_low_c = is_choch ? bull_col : (pb_is_hl ? bull_col : bear_col)
            st.asl      := st.pb_extreme
            st.asl_loc  := st.pb_extreme_loc
            st.asl_type := "LOCKED"
            st.asl_line := line.new(st.pb_extreme_loc, st.pb_extreme, bar_index, st.pb_extreme, color=bull_col, style=line.style_solid, width=1)
            st.asl_lbl  := label.new(st.pb_extreme_loc, st.pb_extreme, "\n" + pb_low_t, color=color(na), textcolor=f_swingCol(pb_low_c), style=label.style_label_up, size=f_structSize())
            if not is_choch
                st.last_conf_low     := st.pb_extreme
                st.last_conf_low_loc := st.pb_extreme_loc
            st.pb_extreme            := high
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_mode               := 1
            st.pb_started            := true
        else
            if not na(st.asl)
                bool already_conf_low = (st.asl == st.last_conf_low and st.asl_loc == st.last_conf_low_loc)
                if not already_conf_low
                    bool   old_is_hl = is_choch ? false : (na(st.last_conf_low) or st.asl >= st.last_conf_low)
                    string old_low_t = old_is_hl ? prefix + "HL" : prefix + "LL"
                    color  old_low_c = old_is_hl ? bull_col : bear_col
                    if not na(st.asl_lbl)
                        label.delete(st.asl_lbl)
                    label.new(st.asl_loc, st.asl, "\n" + old_low_t, color=color(na), textcolor=f_swingCol(old_low_c), style=label.style_label_up, size=f_structSize())
                    st.last_conf_low     := st.asl
                    st.last_conf_low_loc := st.asl_loc
                else
                    if not na(st.asl_lbl)
                        label.delete(st.asl_lbl)
                if not na(st.asl_line)
                    line.delete(st.asl_line)
                st.asl_line := na
                st.asl_lbl  := na
                st.asl      := na

            float lowest_val = low
            int   lowest_loc = bar_index
            int   bars_back  = na(st.last_conf_high_loc) ? bar_index : bar_index - st.last_conf_high_loc
            if bars_back > 0
                int max_lb = math.min(math.min(bars_back, 1490), bar_index)
                for i = 0 to max_lb
                    if low[i] < lowest_val
                        lowest_val := low[i]
                        lowest_loc := bar_index - i

            st.bull_bos_low   := lowest_val
            st.bull_bos_l_loc := lowest_loc

            st.asl      := lowest_val
            st.asl_loc  := lowest_loc
            st.asl_type := ""
            st.asl_line := line.new(lowest_loc, lowest_val, bar_index, lowest_val, color=bull_col, style=line.style_solid, width=1)
            if lowest_val != st.last_conf_low
                st.asl_lbl := label.new(lowest_loc, lowest_val, "\n" + prefix + "ASL", color=color(na), textcolor=f_swingCol(bull_col), style=label.style_label_up, size=f_structSize())
            else
                st.asl_lbl := na

            st.pb_mode               := 1
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_extreme            := high
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true

    else if asl_broken
        st.bear_bos := true
        st.bear_bos_low   := st.asl
        st.bear_bos_l_loc := st.asl_loc

        bool was_in_bull_pb = st.pb_mode == 1 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
        st.pb_mode  := 0
        st.pb_count := 0

        bool   is_choch    = st.dir == 1
        string brk_lbl_txt = is_choch ? prefix + "SOS" : prefix + "BOS"
        if is_choch
            st.bear_sos := true
        int    mid_x       = math.round((st.asl_loc + bar_index) / 2)
        label.new(mid_x, st.asl, brk_lbl_txt + "\n", color=color(na), textcolor=bear_col, style=label.style_label_up, size=size.tiny)

        if is_choch
            st.choch_lock := true

        bool brk_already_conf_low = (st.asl == st.last_conf_low and st.asl_loc == st.last_conf_low_loc)
        if not na(st.asl_lbl)
            label.delete(st.asl_lbl)
        if not brk_already_conf_low
            bool   brk_is_hl = na(st.last_conf_low) or st.asl >= st.last_conf_low
            string brk_low_t = brk_is_hl ? prefix + "HL" : prefix + "LL"
            label.new(st.asl_loc, st.asl, "\n" + brk_low_t, color=color(na), textcolor=f_swingCol(bear_col), style=label.style_label_up, size=f_structSize())

        if not na(st.asl_line)
            line.set_style(st.asl_line, line.style_solid)
            line.set_color(st.asl_line, bear_col)
            line.set_width(st.asl_line, 2)
            line.set_x2(st.asl_line, bar_index)
            st.asl_line := na

        st.last_conf_low     := st.asl
        st.last_conf_low_loc := st.asl_loc
        st.asl_lbl           := na
        st.asl               := na
        st.dir               := -1

        if was_in_bull_pb
            st.bear_bos_high  := st.pb_extreme
            st.bear_bos_h_loc := st.pb_extreme_loc
            if not na(st.ash_line)
                line.delete(st.ash_line)
            if not na(st.ash_lbl)
                label.delete(st.ash_lbl)
            bool   pb_is_hh  = na(st.last_conf_high) or st.pb_extreme >= st.last_conf_high
            // On an SOS (fast reversal) the extreme is only the ACTIVE swing high —
            // it prints as ASH and is confirmed to HH/LH by the NEXT bearish break.
            string pb_high_t = is_choch ? prefix + "ASH" : (pb_is_hh ? prefix + "HH" : prefix + "LH")
            color  pb_high_c = is_choch ? bear_col : (pb_is_hh ? bull_col : bear_col)
            st.ash      := st.pb_extreme
            st.ash_loc  := st.pb_extreme_loc
            st.ash_type := "LOCKED"
            st.ash_line := line.new(st.pb_extreme_loc, st.pb_extreme, bar_index, st.pb_extreme, color=bear_col, style=line.style_solid, width=1)
            st.ash_lbl  := label.new(st.pb_extreme_loc, st.pb_extreme, pb_high_t + "\n", color=color(na), textcolor=f_swingCol(pb_high_c), style=label.style_label_down, size=f_structSize())
            if not is_choch
                st.last_conf_high     := st.pb_extreme
                st.last_conf_high_loc := st.pb_extreme_loc
            st.pb_extreme            := low
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_mode               := -1
            st.pb_started            := true
        else
            float highest_val = high
            int   highest_loc = bar_index
            int   bars_back   = na(st.last_conf_low_loc) ? bar_index : bar_index - st.last_conf_low_loc
            if bars_back > 0
                int max_lb = math.min(math.min(bars_back, 1490), bar_index)
                for i = 0 to max_lb
                    if high[i] > highest_val
                        highest_val := high[i]
                        highest_loc := bar_index - i

            if not na(st.ash)
                bool already_conf_high = (st.ash == st.last_conf_high and st.ash_loc == st.last_conf_high_loc)
                if not already_conf_high
                    bool   old_is_hh  = is_choch ? true : (na(st.last_conf_high) or st.ash >= st.last_conf_high)
                    string old_high_t = old_is_hh ? prefix + "HH" : prefix + "LH"
                    color  old_high_c = old_is_hh ? bull_col : bear_col
                    if not na(st.ash_lbl)
                        label.delete(st.ash_lbl)
                    label.new(st.ash_loc, st.ash, old_high_t + "\n", color=color(na), textcolor=f_swingCol(old_high_c), style=label.style_label_down, size=f_structSize())
                    st.last_conf_high     := st.ash
                    st.last_conf_high_loc := st.ash_loc
                else
                    if not na(st.ash_lbl)
                        label.delete(st.ash_lbl)
                if not na(st.ash_line)
                    line.delete(st.ash_line)
                st.ash_line := na
                st.ash_lbl  := na
                st.ash      := na
            else
                // [doc 23] Neither an active pullback high nor a confirmed ASH was available to  -> docs/mpc_bos_strategy.md
                bool   fallback_is_hh  = na(st.last_conf_high) or highest_val >= st.last_conf_high
                string fallback_high_t = fallback_is_hh ? prefix + "HH" : prefix + "LH"
                color  fallback_high_c = fallback_is_hh ? bull_col : bear_col
                if highest_val != st.last_conf_high
                    label.new(highest_loc, highest_val, fallback_high_t + "\n", color=color(na), textcolor=f_swingCol(fallback_high_c), style=label.style_label_down, size=f_structSize())
                    st.last_conf_high     := highest_val
                    st.last_conf_high_loc := highest_loc

            st.bear_bos_high  := highest_val
            st.bear_bos_h_loc := highest_loc

            st.ash      := highest_val
            st.ash_loc  := highest_loc
            st.ash_type := ""
            st.ash_line := line.new(highest_loc, highest_val, bar_index, highest_val, color=bear_col, style=line.style_solid, width=1)
            if highest_val != st.last_conf_high
                st.ash_lbl := label.new(highest_loc, highest_val, prefix + "ASH\n", color=color(na), textcolor=f_swingCol(bear_col), style=label.style_label_down, size=f_structSize())
            else
                st.ash_lbl := na

            st.pb_mode               := -1
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_extreme            := low
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true

    if not na(st.ash_line)
        line.set_x2(st.ash_line, bar_index)
        if not showExternal
            line.set_color(st.ash_line, color(na))
    if not na(st.asl_line)
        line.set_x2(st.asl_line, bar_index)
        if not showExternal
            line.set_color(st.asl_line, color(na))
    if not showExternal
        if not na(st.ash_lbl)
            label.set_textcolor(st.ash_lbl, color(na))
        if not na(st.asl_lbl)
            label.set_textcolor(st.asl_lbl, color(na))

// [doc 24] TRADING SESSIONS TYPES & METHODS  -> docs/mpc_bos_strategy.md
type SessionDisplay
    box   sessionBox
    label sessionLabel
    line  openLine
    line  avgLine
    line  closeLine
    float sumClose
    int   numOfBars

type SessionInfo
    color  color
    string name
    string session
    string timezone
    SessionDisplay active = na

method setName(SessionDisplay this, string name) =>
    sessionLabel = this.sessionLabel
    sessionBox   = this.sessionBox
    boxText      = array.new<string>()
    if showSessionTickRange
        boxText.push("Range: " + str.tostring((sessionBox.get_top() - sessionBox.get_bottom()) / syminfo.mintick, format.mintick))
    if showSessionAverage
        boxText.push("Avg: " + str.tostring(this.sumClose / this.numOfBars, format.mintick))
    if showSessionNames
        boxText.push(name)
    sessionLabel.set_y(sessionBox.get_bottom())
    sessionLabel.set_text(array.join(boxText, "\n"))

method createSessionDisplay(SessionInfo this) =>
    boxColor    = this.color
    opaqueColor = color.new(boxColor, 0)
    dis = SessionDisplay.new(
      sessionBox   = box.new(bar_index, high, bar_index, low, bgcolor = boxColor, border_color = color.new(boxColor, 40), border_width = 1, border_style = line.style_dotted),
      sessionLabel = label.new(bar_index + 2, low, "", style = label.style_label_upper_left, textalign = text.align_left, textcolor = opaqueColor, color = color(na)),
      openLine     = showSessionOC      ? line.new(bar_index, open,  bar_index, open,  color = opaqueColor, style = line.style_dashed, width = 1) : na,
      closeLine    = showSessionOC      ? line.new(bar_index, close, bar_index, close, color = opaqueColor, style = line.style_dashed, width = 1) : na,
      avgLine      = showSessionAverage ? line.new(bar_index, close, bar_index, close, style = line.style_dotted, width = 2, color = opaqueColor) : na,
      sumClose     = close,
      numOfBars    = 1)
    if showSessionOC
        linefill.new(dis.openLine, dis.closeLine, boxColor)
    dis.setName(this.name)
    this.active := dis

method updateSessionDisplay(SessionInfo this) =>
    sessionDisp = this.active
    sessionBox  = sessionDisp.sessionBox
    openLine    = sessionDisp.openLine
    closeLine   = sessionDisp.closeLine
    avgLine     = sessionDisp.avgLine
    sessionDisp.sumClose  += close
    sessionDisp.numOfBars += 1
    sessionBox.set_top(math.max(sessionBox.get_top(), high))
    sessionBox.set_bottom(math.min(sessionBox.get_bottom(), low))
    sessionBox.set_right(bar_index)
    sessionDisp.setName(this.name)
    if showSessionOC
        openLine.set_x2(bar_index)
        closeLine.set_x2(bar_index)
        closeLine.set_y1(close)
        closeLine.set_y2(close)
    if showSessionAverage
        avgLine.set_x2(bar_index)
        avg = sessionDisp.sumClose / sessionDisp.numOfBars
        avgLine.set_y1(avg)
        avgLine.set_y2(avg)
    sessionDisp

method update(SessionInfo this) =>
    bool isChange = timeframe.change("1D")
    if not na(time("", this.session, this.timezone))
        if na(this.active) or isChange
            this.createSessionDisplay()
        else
            this.updateSessionDisplay()
    else if not na(this.active)
        this.active := na

getSessionInfos() =>
    array<SessionInfo> sessionInfos = array.new<SessionInfo>()
    if showFirst and showSessions
        sessionInfos.push(SessionInfo.new(firstSessionColor, firstSessionName, firstSessionTime, firstSessionTZ))
    if showSecond and showSessions
        sessionInfos.push(SessionInfo.new(secondSessionColor, secondSessionName, secondSessionTime, secondSessionTZ))
    if showThird and showSessions
        sessionInfos.push(SessionInfo.new(thirdSessionColor, thirdSessionName, thirdSessionTime, thirdSessionTZ))
    sessionInfos

// [doc 25] SHARED CONSTANTS & SECURITY CALLS  -> docs/mpc_bos_strategy.md
newDay           = dayofweek(time, "America/New_York") != dayofweek(time[1], "America/New_York")

[dailyTime,   dailyHigh,   dailyLow,   isLastDaily]   = request.security(syminfo.tickerid, "D", [time, high, low, barstate.islast], lookahead = barmerge.lookahead_on)
[weeklyTime,  weeklyHigh,  weeklyLow,  isLastWeekly]  = request.security(syminfo.tickerid, "W", [time, high, low, barstate.islast], lookahead = barmerge.lookahead_off)
pwcSecurity = timeframe.isweekly or timeframe.ismonthly ? request.security(syminfo.tickerid, "W", close, lookahead = barmerge.lookahead_off) : request.security(syminfo.tickerid, "W", close[1], lookahead = barmerge.lookahead_on)
[h4Time, h4PrevHigh, h4PrevLow] = request.security(syminfo.tickerid, "240", [time, high[1], low[1]], lookahead = barmerge.lookahead_on)
h4BarChanged = ta.change(h4Time) != 0

hasDailyTimeChanged   = dailyTime   != dailyTime[1]
hasWeeklyTimeChanged  = weeklyTime  != weeklyTime[1]

// [doc 26] ── HTF Directional Bias (adapted from LuxAlgo's HTF Bias Tracker) ──  -> docs/mpc_bos_strategy.md
f_biasState(float highAction, float lowAction, float closeAction, float highContext, float lowContext, string tfPrefix) =>
    string state = "Neutral"
    string desc  = "Inside " + tfPrefix + " Range"

    bool bullishClosure = closeAction > highContext
    bool bearishClosure = closeAction < lowContext
    bool bearishSweep   = highAction > highContext and closeAction <= highContext
    bool bullishSweep   = lowAction < lowContext and closeAction >= lowContext

    if bullishClosure
        state := "Bullish"
        desc  := "Close > Prev " + tfPrefix + " High"
    else if bearishClosure
        state := "Bearish"
        desc  := "Close < Prev " + tfPrefix + " Low"
    else if bearishSweep
        state := "Bearish"
        desc  := "Swept " + tfPrefix + " High"
    else if bullishSweep
        state := "Bullish"
        desc  := "Swept " + tfPrefix + " Low"

    [state, desc]

f_htfBias(string htf, string tfPrefix) =>
    // One security call fetching both closed periods at once. (The old version made
    // three calls and also computed a "current forming" bias that was never consumed.)
    [high1, low1, close1, high2, low2] = request.security(syminfo.tickerid, htf, [high[1], low[1], close[1], high[2], low[2]])

    // Established Context (Closed[1] vs Closed[2])
    [estState, estDesc] = f_biasState(high1, low1, close1, high2, low2, tfPrefix)
    [estState, estDesc]

[dEstState, dEstDesc] = f_htfBias("D", "D")
[wEstState, wEstDesc] = f_htfBias("W", "W")

var canShowDaily   = i_isDailyEnabled   and i_showLiquidity and timeframe.isintraday
var canShowWeekly  = i_isWeeklyEnabled  and i_showLiquidity and (timeframe.isintraday or timeframe.isdaily)

color  MITIGATED_COLOR = color.new(#666666, 25)
string MITIGATED_STYLE = line.style_dotted
float  lblOff          = syminfo.mintick * i_lblOffset

var a_lastHighs = array.new_float(2)
var a_lastLows  = array.new_float(2)

f_labelText(string txt) => i_showLabels and i_showLiquidity ? txt : ""

// [doc 27] Shared by Daily/Weekly/Monthly/Asia/London/NY liquidity levels: checks f  -> docs/mpc_bos_strategy.md
f_liqMitigate(line lineId, label lblId, bool mit, int mitBar, int barOrigin, bool breachCond, color baseColor, bool enabledFlag) =>
    bool newMit    = mit
    int  newMitBar = mitBar
    if not newMit and breachCond
        newMit    := true
        newMitBar := bar_index
    bool showLvl = (i_showMitigated or not newMit) and i_showLiquidity and enabledFlag
    line.set_color(lineId, newMit ? MITIGATED_COLOR : baseColor)
    line.set_style(lineId, newMit ? MITIGATED_STYLE : line.style_solid)
    label.set_textcolor(lblId, newMit ? color(na) : baseColor)
    int x2 = newMit ? newMitBar : bar_index + i_lineExtend
    line.set_x2(lineId, showLvl ? x2 : barOrigin)
    label.set_x(lblId, showLvl ? x2 : bar_index)
    [newMit, newMitBar]

inAsia   = not na(time("", firstSessionTime,  firstSessionTZ))
inLondon = not na(time("", secondSessionTime, secondSessionTZ))
inNY     = not na(time("", thirdSessionTime,  thirdSessionTZ))

nyMidnightToday   = timestamp("America/New_York", year(timenow, "America/New_York"), month(timenow, "America/New_York"), dayofmonth(timenow, "America/New_York"), 0, 0)

// [doc 28] Sessions: current week only by default (from Sunday 00:00 New York), or  -> docs/mpc_bos_strategy.md
int  nyDayOfWeek       = dayofweek(timenow, "America/New_York")
int  daysSinceSunday   = nyDayOfWeek - dayofweek.sunday
int  weekStartTime     = nyMidnightToday - daysSinceSunday * 86400000
bool withinSessionDays = showHistoricSessions or time >= weekStartTime

// [doc 29] EXECUTION — EXTERNAL + INTERNAL STRUCTURE  -> docs/mpc_bos_strategy.md
var st = SMCStructure.new(majorLength)
ph = ta.pivothigh(high, majorLength, majorLength)
pl = ta.pivotlow(low,  majorLength, majorLength)
// showExternal off → pass color(na) so ALL lines and labels hidden inside process
// showExternal off but showExternal on → pass color(na) for labels only — handled via ASH/ASL override below
color extBullCol = showExternal ? (showExternal ? bullColor : color(na)) : color(na)
color extBearCol = showExternal ? (showExternal ? bearColor : color(na)) : color(na)
st.process(ph, pl, "", extBullCol, extBearCol)

// After process runs — restore line colors when labels are hidden but structure is visible
if not na(st.ash_line)
    line.set_x2(st.ash_line, bar_index)
    if showExternal and not showExternal
        line.set_color(st.ash_line, bullColor)
if not na(st.asl_line)
    line.set_x2(st.asl_line, bar_index)
    if showExternal and not showExternal
        line.set_color(st.asl_line, bearColor)
if not na(st.ash_lbl)
    label.set_textcolor(st.ash_lbl, showExternal ? f_swingCol(bearColor) : color(na))
if not na(st.asl_lbl)
    label.set_textcolor(st.asl_lbl, showExternal ? f_swingCol(bullColor) : color(na))

// Internal structure — Step 2: pullback tracking to confirm iSH / iSL

// ── State ─────────────────────────────────────────────────
var int   i_mode           = 0
var bool  i_seeded         = false

// Pullback tracking
var float i_pb_extreme     = na
var int   i_pb_extreme_loc = na
var int   i_pb_count       = 0
var bool  i_pb_started     = false
var float i_pb_lqc         = na
var float i_pb_lqh         = na
var float i_prev_high      = na
var float i_prev_low       = na

// Active swing level (iSH or iSL)
var float i_sw_price       = na
var int   i_sw_loc         = na
var line  i_sw_line        = na
var label i_sw_lbl         = na

// Pre-declared locals (Pine v6)
var bool  i_ext_chg        = false
var bool  i_is_inside      = false
var bool  i_ext_dir        = false
var bool  i_is_c1          = false
var float i_thresh         = na

var float i_tracked_ext     = na
var int   i_tracked_ext_loc = na
var int   i_last_mode       = 0   // remembers what mode confirmed the swing
var bool  i_had_bos         = false
var int   i_bos_dir         = 0
var string i_h_lbl          = ""
var color  i_h_col          = color.black
var string i_l_lbl          = ""
var color  i_l_col          = color.black
var int   i_mid             = 0
var int   i_mid2            = 0
var float i_last_hl         = na   // last confirmed iHL price (for iSOS in bullish cycle)

// [doc 30] Captures the latest confirmed internal swing point (price + location), s  -> docs/mpc_bos_strategy.md
var float i_confirmed_low_price  = na
var int   i_confirmed_low_loc    = na
var float i_confirmed_high_price = na
var int   i_confirmed_high_loc   = na
var float i_last_lh         = na   // last confirmed iLH price (for iSOS in bearish cycle)
var int   i_last_hl_loc     = na
var int   i_last_lh_loc     = na

var float i_sos_watch_hh    = na
var int   i_sos_watch_hh_loc= na
var float i_sos_watch_ll    = na
var int   i_sos_watch_ll_loc= na

// Internal fib anchor vars — declared before internal structure block so captures work
var float iFib_asl     = na
var int   iFib_asl_loc = na
var float iFib_ash     = na
var int   iFib_ash_loc = na
var int   iFib_dir     = 0

// Internal fib touched tracking — same system as micro fib
color IFIB_GREY           = color.new(#888888, 0)
var bool iFib0Touched     = false   // 0.0
var bool iFib382Touched   = false   // 0.382 TP2
var bool iFib50Touched    = false   // 0.5  FFT
var bool iFib618Touched   = false   // 0.618 E1 — gate
var bool iFib702Touched   = false   // 0.702 E2
var bool iFib786Touched   = false   // 0.786 E3
var bool iFib886Touched   = false   // 0.886 E4
var bool iFib100Touched   = false   // 1.0
var bool iFib618EverReached = false  // gate flag
var float iFib_tp3_hit_price = na    // frozen price level TP3 was hit at (for detecting a later break-through)
var float iFibPrevAsh = na   // detects when the extending anchor itself changed this bar
var float iFibPrevAsl = na   // (a live wick), so touched-checks don't self-trigger off it
var bool  iFibResetActive    = false // true once TP3 has been hit — resets this internal fib immediately

float i_lbl_y_offset = syminfo.mintick * 20   // vertical offset for iBOS/iSOS (smaller number = closer to the line)

// Internal structure is naturally scoped to the current active external swing —
// it resets on every external SOS/CHoCH (see block right below).
bool internalActive = showInternal

// Tracks every internal-structure label/line drawn during the current external
// swing, so they can be wiped when a new swing starts (unless showHistoricalInternal is on).
var array<label> intHistLabels = array.new<label>()
var array<line>  intHistLines  = array.new<line>()

// [doc 31] ── Stop internal tracking on external SOS ───────────────  -> docs/mpc_bos_strategy.md
bool extBreakThisBar = st.bull_bos or st.bear_bos or st.bull_sos or st.bear_sos

if internalActive and (st.bull_bos or st.bear_bos or st.bull_sos or st.bear_sos)
    if not na(i_sw_line)
        line.set_x2(i_sw_line, bar_index)
        i_sw_line := na
    i_sw_lbl          := na
    i_sw_price        := na
    i_mode            := 0
    i_seeded          := false
    i_pb_count        := 0
    i_pb_started      := false
    i_tracked_ext     := na
    i_tracked_ext_loc := na
    i_last_hl         := na
    i_last_lh         := na
    i_had_bos         := false
    i_sos_watch_hh    := na
    i_sos_watch_ll    := na
    // Past swing just ended — wipe its internal structure unless history is enabled
    if not showHistoricalInternal
        if array.size(intHistLabels) > 0
            for i = 0 to array.size(intHistLabels) - 1
                label.delete(array.get(intHistLabels, i))
        if array.size(intHistLines) > 0
            for i = 0 to array.size(intHistLines) - 1
                line.delete(array.get(intHistLines, i))
    array.clear(intHistLabels)
    array.clear(intHistLines)

// ── Track prev bar ────────────────────────────────────────
if internalActive
    i_prev_high := high
    i_prev_low  := low


// ── Seed on new external swing ────────────────────────────
if internalActive
    if st.new_swing_low and not st.bull_sos and not st.bear_sos
        i_mode            := 1
        i_seeded          := true
        i_had_bos         := false
        i_bos_dir         := 0
        i_pb_started      := false
        i_pb_extreme      := na
        i_pb_count        := 0
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_mode       := 1
        i_last_hl         := na
        i_last_lh         := na
        i_sos_watch_hh    := na
        i_sos_watch_ll    := na
    else if st.new_swing_high and not st.bull_sos and not st.bear_sos
        i_mode            := -1
        i_seeded          := true
        i_had_bos         := false
        i_bos_dir         := 0
        i_pb_started      := false
        i_pb_extreme      := na
        i_pb_count        := 0
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_mode       := -1
        i_last_hl         := na
        i_last_lh         := na
        i_sos_watch_hh    := na
        i_sos_watch_ll    := na

// ── Mode 1: track upward move → confirm iSH ──────────────
if internalActive and i_seeded and i_mode == 1
    if not i_pb_started
        i_pb_started     := true
        i_pb_extreme     := high
        i_pb_extreme_loc := bar_index
        i_pb_count       := 0
        i_pb_lqc         := na
        i_pb_lqh         := na
    else
        // Update extreme if new high
        i_ext_chg := false
        if high > i_pb_extreme
            i_pb_extreme     := high
            i_pb_extreme_loc := bar_index
            i_pb_count       := 0
            i_pb_lqc         := na
            i_pb_lqh         := na
            i_ext_chg        := true
        // is_inside and qualifying bar checks (exact external rule)
        i_is_inside := not na(i_prev_high) and not na(i_prev_low) and high < i_prev_high and low > i_prev_low
        i_ext_dir   := i_ext_chg and close < open
        i_is_c1     := na(i_pb_lqc) and not i_ext_chg
        if (not i_is_inside or i_is_c1) and (not i_ext_chg or i_ext_dir)
            i_thresh := na(i_pb_lqh) ? i_pb_extreme : i_pb_lqh
            if close < i_thresh - pbBuffer
                i_pb_count += 1
                i_pb_lqc   := close
                i_pb_lqh   := low
        // 3 bars confirmed → iSH
        if i_pb_count >= 3 and not na(i_pb_extreme)
            if not na(i_sw_line)
                line.set_x2(i_sw_line, bar_index)
            i_sw_line  := na
            i_sw_lbl   := na
            i_sw_price := i_pb_extreme
            i_sw_loc   := i_pb_extreme_loc
            // Label: iSH if first swing, iHH if higher than last, iLH if lower
            i_h_lbl := not i_had_bos ? "iSH" : "iHH"
            i_h_col := not i_had_bos ? iBearColor : iBullColor
            i_confirmed_high_price := i_sw_price
            i_confirmed_high_loc   := i_sw_loc
            i_sw_line  := line.new(i_sw_loc, i_sw_price, bar_index, i_sw_price, color = showInternal ? color.new(i_h_col, 15) : color(na), style = line.style_dotted, width = 1)
            i_sw_lbl   := label.new(i_sw_loc, i_sw_price, i_h_lbl + "\n", color = color(na), textcolor=f_swingCol(color.new(i_h_col, 15)), style = label.style_label_down, size = size.tiny)
            array.push(intHistLines, i_sw_line)
            array.push(intHistLabels, i_sw_lbl)
            i_mode       := 0
            i_pb_count   := 0
            i_pb_started := false

// ── Mode -1: track downward move → confirm iSL ───────────
if internalActive and i_seeded and i_mode == -1
    if not i_pb_started
        i_pb_started     := true
        i_pb_extreme     := low
        i_pb_extreme_loc := bar_index
        i_pb_count       := 0
        i_pb_lqc         := na
        i_pb_lqh         := na
    else
        // Update extreme if new low
        i_ext_chg := false
        if low < i_pb_extreme
            i_pb_extreme     := low
            i_pb_extreme_loc := bar_index
            i_pb_count       := 0
            i_pb_lqc         := na
            i_pb_lqh         := na
            i_ext_chg        := true
        // is_inside and qualifying bar checks
        i_is_inside := not na(i_prev_high) and not na(i_prev_low) and high < i_prev_high and low > i_prev_low
        i_ext_dir   := i_ext_chg and close > open
        i_is_c1     := na(i_pb_lqc) and not i_ext_chg
        if (not i_is_inside or i_is_c1) and (not i_ext_chg or i_ext_dir)
            i_thresh := na(i_pb_lqh) ? i_pb_extreme : i_pb_lqh
            if close > i_thresh + pbBuffer
                i_pb_count += 1
                i_pb_lqc   := close
                i_pb_lqh   := high
        // 3 bars confirmed → iSL
        if i_pb_count >= 3 and not na(i_pb_extreme)
            if not na(i_sw_line)
                line.set_x2(i_sw_line, bar_index)
            i_sw_line  := na
            i_sw_lbl   := na
            i_sw_price := i_pb_extreme
            i_sw_loc   := i_pb_extreme_loc
            // Label: iSL if first swing, iLL if lower than last, iHL if higher
            i_l_lbl := not i_had_bos ? "iSL" : "iLL"
            i_l_col := not i_had_bos ? iBullColor : iBearColor
            i_confirmed_low_price := i_sw_price
            i_confirmed_low_loc   := i_sw_loc
            i_sw_line  := line.new(i_sw_loc, i_sw_price, bar_index, i_sw_price, color = showInternal ? color.new(i_l_col, 15) : color(na), style = line.style_dotted, width = 1)
            i_sw_lbl   := label.new(i_sw_loc, i_sw_price, "\n" + i_l_lbl, color = color(na), textcolor=f_swingCol(color.new(i_l_col, 15)), style = label.style_label_up, size = size.tiny)
            array.push(intHistLines, i_sw_line)
            array.push(intHistLabels, i_sw_lbl)
            i_mode       := 0
            i_pb_count   := 0
            i_pb_started := false

// ── Track extreme while watching (mode 0) ────────────────
if internalActive and i_seeded and i_mode == 0
    if i_last_mode == 1
        if na(i_tracked_ext) or low < i_tracked_ext
            i_tracked_ext     := low
            i_tracked_ext_loc := bar_index
    else if i_last_mode == -1
        if na(i_tracked_ext) or high > i_tracked_ext
            i_tracked_ext     := high
            i_tracked_ext_loc := bar_index

// ── iBOS / iSOS detection ────────────────────────────────
bool int_bull_break = false
bool int_bear_break = false
bool int_bull_bos   = false
bool int_bull_sos   = false
bool int_bear_bos   = false
bool int_bear_sos   = false
int  int_break_origin_loc = na

if internalActive and i_mode == 0 and i_seeded and not na(i_sw_price) and barstate.isconfirmed
    if close > i_sw_price and i_last_mode == 1
        i_mid := math.round((i_sw_loc + bar_index) / 2)
        label iBullBOSLbl = label.new(i_mid, i_sw_price + i_lbl_y_offset, "iBOS", color = color(na), textcolor = showInternal ? iBullColor : color(na), style = label.style_none, size = size.tiny, textalign = text.align_center)
        array.push(intHistLabels, iBullBOSLbl)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sw_line := na
        i_sw_lbl := na
        if not na(i_tracked_ext)
            line  iHLLine = line.new(i_tracked_ext_loc, i_tracked_ext, bar_index, i_tracked_ext, color = showInternal ? color.new(iBullColor, 15) : color(na), style = line.style_dotted, width = 1)
            label iHLLbl  = label.new(i_tracked_ext_loc, i_tracked_ext, "\niHL", color = color(na), textcolor=f_swingCol(color.new(iBullColor, 15)), style = label.style_label_up, size = size.tiny)
            array.push(intHistLines, iHLLine)
            array.push(intHistLabels, iHLLbl)
            i_last_hl     := i_tracked_ext
            i_last_hl_loc := i_tracked_ext_loc
        
        int_bull_break := true
        int_bull_bos   := true
        int_break_origin_loc := i_tracked_ext_loc
        // Bull BOS: bottom=i_last_hl (just set above), top=i_sw_price (high being broken)
        if showIFib and not na(i_last_hl) and not na(i_sw_price)
            iFib_asl := i_last_hl,  iFib_asl_loc := i_last_hl_loc
            iFib_ash := i_sw_price, iFib_ash_loc := i_sw_loc
            iFib_dir := 1
            iFib0Touched := false, iFib382Touched := false, iFib50Touched := false
            iFib618Touched := false, iFib702Touched := false, iFib786Touched := false
            iFib886Touched := false, iFib100Touched := false, iFib618EverReached := false
            iFib_tp3_hit_price := na, iFibResetActive := false

        i_sw_price       := na
        i_tracked_ext    := na
        i_tracked_ext_loc := na
        i_pb_count       := 0
        i_pb_started     := false
        i_pb_lqc         := na
        i_pb_lqh         := na
        i_had_bos        := true
        i_bos_dir        := 1
        i_last_mode      := 1
        i_mode           := 1
        i_sos_watch_ll   := na

    else if close < i_sw_price and i_last_mode == -1
        i_mid2 := math.round((i_sw_loc + bar_index) / 2)
        label iBearBOSLbl = label.new(i_mid2, i_sw_price, "iBOS", color = color(na), textcolor = showInternal ? iBearColor : color(na), style = label.style_label_up, size = size.tiny, textalign = text.align_center)
        array.push(intHistLabels, iBearBOSLbl)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sw_line := na
        i_sw_lbl := na
        if not na(i_tracked_ext)
            line  iLHLine = line.new(i_tracked_ext_loc, i_tracked_ext, bar_index, i_tracked_ext, color = showInternal ? color.new(iBearColor, 15) : color(na), style = line.style_dotted, width = 1)
            label iLHLbl  = label.new(i_tracked_ext_loc, i_tracked_ext, "iLH\n", color = color(na), textcolor=f_swingCol(color.new(iBearColor, 15)), style = label.style_label_down, size = size.tiny)
            array.push(intHistLines, iLHLine)
            array.push(intHistLabels, iLHLbl)
            i_last_lh     := i_tracked_ext
            i_last_lh_loc := i_tracked_ext_loc
            
        int_bear_break := true
        int_bear_bos   := true
        int_break_origin_loc := i_tracked_ext_loc
        // Bear BOS: bottom=i_sw_price (low being broken), top=i_last_lh (just set above)
        if showIFib and not na(i_sw_price) and not na(i_last_lh)
            iFib_asl := i_sw_price,  iFib_asl_loc := i_sw_loc
            iFib_ash := i_last_lh,   iFib_ash_loc := i_last_lh_loc
            iFib_dir := -1
            iFib0Touched := false, iFib382Touched := false, iFib50Touched := false
            iFib618Touched := false, iFib702Touched := false, iFib786Touched := false
            iFib886Touched := false, iFib100Touched := false, iFib618EverReached := false
            iFib_tp3_hit_price := na, iFibResetActive := false

        i_sw_price        := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_pb_count        := 0
        i_pb_started      := false
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_had_bos         := true
        i_bos_dir         := -1
        i_last_mode       := -1
        i_mode            := -1
        i_sos_watch_hh    := na



// ── iSOS detection (watches last iHL / iLH) ──────────────
if internalActive and i_seeded and i_had_bos and barstate.isconfirmed
    if i_last_mode == 1 and not na(i_last_hl) and close < i_last_hl and i_mode == 0
        i_mid2 := math.round((i_last_hl_loc + bar_index) / 2)
        label iSOS1Lbl = label.new(i_mid2, i_last_hl, "iSOS", color = color(na), textcolor = showInternal ? iBearColor : color(na), style = label.style_label_up, size = size.tiny, textalign = text.align_center)
        line  iSOS1Line = line.new(i_last_hl_loc, i_last_hl, bar_index, i_last_hl, color = showInternal ? color.new(iBearColor, 15) : color(na), style = line.style_dotted, width = 1)
        array.push(intHistLabels, iSOS1Lbl)
        array.push(intHistLines, iSOS1Line)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sw_line := na
        
        i_sos_watch_hh     := i_sw_price
        i_sos_watch_hh_loc := i_sw_loc
        i_sos_watch_ll     := na
        
        int_bear_break := true
        int_bear_sos   := true
        int_break_origin_loc := i_sw_loc
        // Bear iSOS: bottom=i_tracked_ext, top=i_sw_price (iLH being confirmed as ASH)
        if showIFib and not na(i_tracked_ext) and not na(i_sw_price)
            iFib_asl := i_tracked_ext, iFib_asl_loc := i_tracked_ext_loc
            iFib_ash := i_sw_price,    iFib_ash_loc := i_sw_loc
            iFib_dir := -1
            iFib0Touched := false, iFib382Touched := false, iFib50Touched := false
            iFib618Touched := false, iFib702Touched := false, iFib786Touched := false
            iFib886Touched := false, iFib100Touched := false, iFib618EverReached := false
            iFib_tp3_hit_price := na, iFibResetActive := false

        i_sw_lbl          := na
        i_sw_price        := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_hl         := na
        i_pb_count        := 0
        i_pb_started      := false
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_last_mode       := -1
        i_mode            := -1

    else if i_last_mode == -1 and not na(i_last_lh) and close > i_last_lh and i_mode == 0
        i_mid := math.round((i_last_lh_loc + bar_index) / 2)
        label iSOS2Lbl = label.new(i_mid, i_last_lh + i_lbl_y_offset, "iSOS", color = color(na), textcolor = showInternal ? iBullColor : color(na), style = label.style_none, size = size.tiny, textalign = text.align_center)
        line  iSOS2Line = line.new(i_last_lh_loc, i_last_lh, bar_index, i_last_lh, color = showInternal ? color.new(iBullColor, 15) : color(na), style = line.style_dotted, width = 1)
        array.push(intHistLabels, iSOS2Lbl)
        array.push(intHistLines, iSOS2Line)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sw_line := na
            
        i_sos_watch_ll     := i_sw_price
        i_sos_watch_ll_loc := i_sw_loc
        i_sos_watch_hh     := na
        
        int_bull_break := true
        int_bull_sos   := true
        int_break_origin_loc := i_sw_loc
        // Bull iSOS: bottom=i_sw_price (iHL), top=i_last_lh (LH being broken)
        if showIFib and not na(i_sw_price) and not na(i_last_lh)
            iFib_asl := i_sw_price, iFib_asl_loc := i_sw_loc
            iFib_ash := i_last_lh,  iFib_ash_loc := i_last_lh_loc
            iFib_dir := 1
            iFib0Touched := false, iFib382Touched := false, iFib50Touched := false
            iFib618Touched := false, iFib702Touched := false, iFib786Touched := false
            iFib886Touched := false, iFib100Touched := false, iFib618EverReached := false
            iFib_tp3_hit_price := na, iFibResetActive := false

        i_sw_lbl          := na
        i_sw_price        := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_lh         := na
        i_pb_count        := 0
        i_pb_started      := false
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_last_mode       := 1
        i_mode            := 1

    else if i_last_mode == -1 and not na(i_sos_watch_hh) and close > i_sos_watch_hh and i_mode == 0
        i_mid := math.round((i_sos_watch_hh_loc + bar_index) / 2)
        label iSOS3Lbl = label.new(i_mid, i_sos_watch_hh + i_lbl_y_offset, "iSOS", color = color(na), textcolor = showInternal ? iBullColor : color(na), style = label.style_none, size = size.tiny, textalign = text.align_center)
        line  iSOS3Line = line.new(i_sos_watch_hh_loc, i_sos_watch_hh, bar_index, i_sos_watch_hh, color = showInternal ? color.new(iBullColor, 15) : color(na), style = line.style_dotted, width = 1)
        array.push(intHistLabels, iSOS3Lbl)
        array.push(intHistLines, iSOS3Line)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sw_line := na
            
        i_sos_watch_ll     := i_sw_price
        i_sos_watch_ll_loc := i_sw_loc
        
        int_bull_break := true
        int_bull_sos   := true
        int_break_origin_loc := i_sw_loc
        // Bull iSOS: bottom=i_sw_price (last iHL), top=i_sos_watch_hh (level being broken)
        if showIFib and not na(i_sw_price) and not na(i_sos_watch_hh)
            iFib_asl := i_sw_price,      iFib_asl_loc := i_sw_loc
            iFib_ash := i_sos_watch_hh,  iFib_ash_loc := i_sos_watch_hh_loc
            iFib_dir := 1
            iFib0Touched := false, iFib382Touched := false, iFib50Touched := false
            iFib618Touched := false, iFib702Touched := false, iFib786Touched := false
            iFib886Touched := false, iFib100Touched := false, iFib618EverReached := false
            iFib_tp3_hit_price := na, iFibResetActive := false

        i_sw_lbl          := na
        i_sw_price        := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_lh         := na
        i_pb_count        := 0
        i_pb_started      := false
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_last_mode       := 1
        i_mode            := 1
        i_sos_watch_hh    := na

    else if i_last_mode == 1 and not na(i_sos_watch_ll) and close < i_sos_watch_ll and i_mode == 0
        i_mid2 := math.round((i_sos_watch_ll_loc + bar_index) / 2)
        label iSOS4Lbl = label.new(i_mid2, i_sos_watch_ll, "iSOS", color = color(na), textcolor = showInternal ? iBearColor : color(na), style = label.style_label_up, size = size.tiny, textalign = text.align_center)
        line  iSOS4Line = line.new(i_sos_watch_ll_loc, i_sos_watch_ll, bar_index, i_sos_watch_ll, color = showInternal ? color.new(iBearColor, 15) : color(na), style = line.style_dotted, width = 1)
        array.push(intHistLabels, iSOS4Lbl)
        array.push(intHistLines, iSOS4Line)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sw_line := na
            
        i_sos_watch_hh     := i_sw_price
        i_sos_watch_hh_loc := i_sw_loc
        
        int_bear_break := true
        int_bear_sos   := true
        int_break_origin_loc := i_sw_loc
        // Bear iSOS: bottom=i_sos_watch_ll (level being broken), top=i_sw_price (last iLH)
        if showIFib and not na(i_sos_watch_ll) and not na(i_sw_price)
            iFib_asl := i_sos_watch_ll,     iFib_asl_loc := i_sos_watch_ll_loc
            iFib_ash := i_sw_price,         iFib_ash_loc := i_sw_loc
            iFib_dir := -1
            iFib0Touched := false, iFib382Touched := false, iFib50Touched := false
            iFib618Touched := false, iFib702Touched := false, iFib786Touched := false
            iFib886Touched := false, iFib100Touched := false, iFib618EverReached := false
            iFib_tp3_hit_price := na, iFibResetActive := false

        i_sw_lbl          := na
        i_sw_price        := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_hl         := na
        i_pb_count        := 0
        i_pb_started      := false
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_last_mode       := -1
        i_mode            := -1
        i_sos_watch_ll    := na

// ── Update last_mode when mode changes ───────────────────
if internalActive and i_mode != 0
    i_last_mode := i_mode

// ── Extend active swing line every bar ────────────────────
if internalActive and not na(i_sw_line)
    line.set_x2(i_sw_line, bar_index)

// [doc 32] EQUAL HIGHS / LOWS (EQH / EQL) — liquidity pools  -> docs/mpc_bos_strategy.md
int   eqPivotLen  = 2
float eqAtrMult   = 0.1
int   eqMax       = 6
color eqhColor    = color.new(color.black, 0)
color eqlColor    = color.new(color.black, 0)
// [doc 33] An unmitigated EQ level can outlive its pivot by thousands of bars, and   -> docs/mpc_bos_strategy.md
int   EQ_ORIGIN_CAP = 1500


bool  eqShow = true   // CALCULATION, permanently on — `eqExemptFvg` reads these levels
float eqAtr  = ta.atr(50)
float eqTol  = na(eqAtr) ? 0.0 : eqAtr * eqAtrMult

var array<line>  eqhLines = array.new<line>()
var array<label> eqhLbls  = array.new<label>()
var array<float> eqhPx    = array.new<float>()
var array<int>   eqhBar   = array.new<int>()
var array<line>  eqlLines = array.new<line>()
var array<label> eqlLbls  = array.new<label>()
var array<float> eqlPx    = array.new<float>()
var array<int>   eqlBar   = array.new<int>()

// True when an FVG (gTop..gBot) overlaps, or sits within `prox` of, any active EQ level.
f_fvgNearEq(float gTop, float gBot, float prox) =>
    bool near = false
    if array.size(eqhPx) > 0
        for i = 0 to array.size(eqhPx) - 1
            float lvl = array.get(eqhPx, i)
            if lvl >= gBot - prox and lvl <= gTop + prox
                near := true
    if array.size(eqlPx) > 0
        for i = 0 to array.size(eqlPx) - 1
            float lvl = array.get(eqlPx, i)
            if lvl >= gBot - prox and lvl <= gTop + prox
                near := true
    near

// Toggled off → clear anything drawn
if not eqShow and (array.size(eqhLines) > 0 or array.size(eqlLines) > 0)
    if array.size(eqhLines) > 0
        for i = 0 to array.size(eqhLines) - 1
            line.delete(array.get(eqhLines, i)), label.delete(array.get(eqhLbls, i))
    if array.size(eqlLines) > 0
        for i = 0 to array.size(eqlLines) - 1
            line.delete(array.get(eqlLines, i)), label.delete(array.get(eqlLbls, i))
    array.clear(eqhLines), array.clear(eqhLbls), array.clear(eqhPx), array.clear(eqhBar)
    array.clear(eqlLines), array.clear(eqlLbls), array.clear(eqlPx), array.clear(eqlBar)

// Wrapped in a function so the main body pays for ONE statement rather than ~40 —
// the same CE10295 budget trick f_liqLabels and f_diag use.
f_processEq() =>
    float eqPh = ta.pivothigh(high, eqPivotLen, eqPivotLen)
    float eqPl = ta.pivotlow(low,  eqPivotLen, eqPivotLen)
    var float eqPrevPh = na, var int eqPrevPhBar = na
    var float eqPrevPl = na, var int eqPrevPlBar = na

    if eqShow and not na(eqPh)
        int phBar = bar_index - eqPivotLen
        if not na(eqPrevPh) and math.abs(eqPh - eqPrevPh) <= eqTol
            float lvl = math.max(eqPh, eqPrevPh)
            line ln = line.new(eqPrevPhBar, lvl, bar_index + i_lineExtend, lvl, color = eqhColor, style = line.style_dotted, width = 1)
            label lb = label.new(bar_index + i_lineExtend, lvl, "EQH", style = label.style_none, textcolor = eqhColor, size = f_liqSize(), textalign = text.align_left)
            array.push(eqhLines, ln), array.push(eqhLbls, lb), array.push(eqhPx, lvl), array.push(eqhBar, eqPrevPhBar)
            while array.size(eqhLines) > eqMax
                line.delete(array.shift(eqhLines)), label.delete(array.shift(eqhLbls)), array.shift(eqhPx), array.shift(eqhBar)
        eqPrevPh := eqPh, eqPrevPhBar := phBar

    if eqShow and not na(eqPl)
        int plBar = bar_index - eqPivotLen
        if not na(eqPrevPl) and math.abs(eqPl - eqPrevPl) <= eqTol
            float lvl = math.min(eqPl, eqPrevPl)
            line ln = line.new(eqPrevPlBar, lvl, bar_index + i_lineExtend, lvl, color = eqlColor, style = line.style_dotted, width = 1)
            label lb = label.new(bar_index + i_lineExtend, lvl, "EQL", style = label.style_none, textcolor = eqlColor, size = f_liqSize(), textalign = text.align_left)
            array.push(eqlLines, ln), array.push(eqlLbls, lb), array.push(eqlPx, lvl), array.push(eqlBar, eqPrevPlBar)
            while array.size(eqlLines) > eqMax
                line.delete(array.shift(eqlLines)), label.delete(array.shift(eqlLbls)), array.shift(eqlPx), array.shift(eqlBar)
        eqPrevPl := eqPl, eqPrevPlBar := plBar

    // Mitigation + right-extend each bar: EQH taken on a close above, EQL on a close below.
    if eqShow and array.size(eqhLines) > 0
        for i = array.size(eqhLines) - 1 to 0
            float lvl = array.get(eqhPx, i)
            if close > lvl
                line.delete(array.get(eqhLines, i)), label.delete(array.get(eqhLbls, i))
                array.remove(eqhLines, i), array.remove(eqhLbls, i), array.remove(eqhPx, i), array.remove(eqhBar, i)
            else
                line ehl = array.get(eqhLines, i)
                // Read the origin from eqhBar, NOT line.get_x1 — querying an
                // already-aged line is the very thing that can throw.
                line.set_x1(ehl, math.max(array.get(eqhBar, i), bar_index - EQ_ORIGIN_CAP))
                line.set_x2(ehl, bar_index + i_lineExtend)
                label.set_x(array.get(eqhLbls, i), bar_index + i_lineExtend)
    if eqShow and array.size(eqlLines) > 0
        for i = array.size(eqlLines) - 1 to 0
            float lvl = array.get(eqlPx, i)
            if close < lvl
                line.delete(array.get(eqlLines, i)), label.delete(array.get(eqlLbls, i))
                array.remove(eqlLines, i), array.remove(eqlLbls, i), array.remove(eqlPx, i), array.remove(eqlBar, i)
            else
                line ell = array.get(eqlLines, i)
                line.set_x1(ell, math.max(array.get(eqlBar, i), bar_index - EQ_ORIGIN_CAP))
                line.set_x2(ell, bar_index + i_lineExtend)
                label.set_x(array.get(eqlLbls, i), bar_index + i_lineExtend)
    int _ret = 0
f_processEq()
// [doc 34] FAIR VALUE GAPS — persist until mitigated  -> docs/mpc_bos_strategy.md
var array<box>   fvgBoxes  = array.new<box>()
var array<float> fvgTops   = array.new<float>()
var array<float> fvgBots   = array.new<float>()
var array<bool>  fvgIsBull = array.new<bool>()
var array<int>   fvgBorn   = array.new<int>()

f_fvgClearAll() =>
    if array.size(fvgBoxes) > 0
        for i = 0 to array.size(fvgBoxes) - 1
            box.delete(array.get(fvgBoxes, i))
        array.clear(fvgBoxes)
        array.clear(fvgTops)
        array.clear(fvgBots)
        array.clear(fvgIsBull)
        array.clear(fvgBorn)

// Toggled off → remove anything on the chart
if not showFVG and array.size(fvgBoxes) > 0
    f_fvgClearAll()

// [doc 35] ── Detection (confirmed bars only, so live wicks can't paint phantom gap  -> docs/mpc_bos_strategy.md
float fvgThreshold = fvgThreshPct
if showFVG and barstate.isconfirmed and bar_index >= 2
    // Bullish: gap between two bars ago's high and this bar's low; middle bar closed above it
    bool bullFvg = low > high[2] and (not fvgRequireClose or close[1] > high[2]) and (low - high[2]) / high[2] * 100 > fvgThreshold
    // Bearish: mirror
    bool bearFvg = high < low[2] and (not fvgRequireClose or close[1] < low[2]) and (low[2] - high) / low[2] * 100 > fvgThreshold
    if bullFvg
        box b = box.new(bar_index - 1, low, bar_index, high[2], bgcolor = fvgBullColor, border_color = color(na), text = "FVG", text_color = color.new(color.gray, 30), text_size = size.tiny, text_halign = text.align_right)
        array.push(fvgBoxes, b)
        array.push(fvgTops, low)
        array.push(fvgBots, high[2])
        array.push(fvgIsBull, true)
        array.push(fvgBorn, bar_index)
    // Bearish: gap between two bars ago's low and this bar's high
    if bearFvg
        box b = box.new(bar_index - 1, low[2], bar_index, high, bgcolor = fvgBearColor, border_color = color(na), text = "FVG", text_color = color.new(color.gray, 30), text_size = size.tiny, text_halign = text.align_right)
        array.push(fvgBoxes, b)
        array.push(fvgTops, low[2])
        array.push(fvgBots, high)
        array.push(fvgIsBull, false)
        array.push(fvgBorn, bar_index)
    // [doc 36] Cap: drop oldest gaps beyond the limit  -> docs/mpc_bos_strategy.md
    while array.size(fvgBoxes) > fvgMaxCount
        int _dropIdx = -1
        for _di = 0 to array.size(fvgBoxes) - 1
            if not (eqExemptFvg and f_fvgNearEq(array.get(fvgTops, _di), array.get(fvgBots, _di), eqTol))
                _dropIdx := _di
                break
        if _dropIdx == -1
            break
        box.delete(array.get(fvgBoxes, _dropIdx))
        array.remove(fvgBoxes, _dropIdx)
        array.remove(fvgTops, _dropIdx)
        array.remove(fvgBots, _dropIdx)
        array.remove(fvgIsBull, _dropIdx)
        array.remove(fvgBorn, _dropIdx)

// ── Extend live gaps, delete tapped ones, apply directional visibility ──
if showFVG and array.size(fvgBoxes) > 0
    for i = array.size(fvgBoxes) - 1 to 0
        bool  isBull = array.get(fvgIsBull, i)
        float gTop   = array.get(fvgTops, i)
        float gBot   = array.get(fvgBots, i)
        // [doc 37] Kill condition depends on the "keep until broken" toggle:  -> docs/mpc_bos_strategy.md
        bool killed = bar_index > array.get(fvgBorn, i) and (fvgKeepUntilBroken ? (isBull ? close <= gBot : close >= gTop) : (isBull ? low <= gTop : high >= gBot))
        if killed
            box.delete(array.get(fvgBoxes, i))
            array.remove(fvgBoxes, i)
            array.remove(fvgTops, i)
            array.remove(fvgBots, i)
            array.remove(fvgIsBull, i)
            array.remove(fvgBorn, i)
        else
            box fb = array.get(fvgBoxes, i)
            box.set_right(fb, bar_index)
            // Directional filter: hide misaligned gaps (st.dir 0 = undecided, show all)
            // A gap backed by an EQH/EQL stays visible even when misaligned (eqExemptFvg).
            bool nearEq  = eqExemptFvg and f_fvgNearEq(gTop, gBot, eqTol)
            bool visible = nearEq or not fvgDirOnly or st.dir == 0 or (isBull ? st.dir == 1 : st.dir == -1)
            box.set_bgcolor(fb, visible ? (isBull ? fvgBullColor : fvgBearColor) : color(na))
            box.set_text_color(fb, visible ? color.new(color.gray, 30) : color(na))

// [doc 38] RSI DIVERGENCE — regular divergence at the extremes  -> docs/mpc_bos_strategy.md
float divRsi = ta.rsi(close, divRsiLen)
float divPlRsi = ta.pivotlow(divRsi, divPivotLen, divPivotLen)
float divPhRsi = ta.pivothigh(divRsi, divPivotLen, divPivotLen)

var float divPrevRsiLow    = na
var float divPrevPriceLow  = na
var int   divPrevLowBar    = na
var float divPrevRsiHigh   = na
var float divPrevPriceHigh = na
var int   divPrevHighBar   = na
var int   lastBullDivBar   = na
var int   lastBearDivBar   = na
var array<line>  bullDivLines  = array.new<line>()
var array<label> bullDivLabels = array.new<label>()
var array<line>  bearDivLines  = array.new<line>()
var array<label> bearDivLabels = array.new<label>()

if showDiv and not na(divPlRsi)
    float _pLow = low[divPivotLen]
    int   _pBar = bar_index - divPivotLen
    bool  _divRecent = showDivHistory or time[divPivotLen] >= time - 259200000
    if not na(divPrevRsiLow) and _divRecent
        // Lower low in price, higher low in RSI, from the oversold extreme
        if _pLow < divPrevPriceLow and divPlRsi > divPrevRsiLow and math.min(divPlRsi, divPrevRsiLow) <= divOS
            lastBullDivBar := _pBar
            array.push(bullDivLines, line.new(divPrevLowBar, divPrevPriceLow, _pBar, _pLow, color = color.new(#4caf50, 0), style = line.style_dotted, width = 2))
            array.push(bullDivLabels, label.new(_pBar, _pLow, "\nBull Div", color = color(na), textcolor = color.new(#4caf50, 0), style = label.style_label_up, size = size.tiny))
            // Cap: drop the oldest marker once past the limit — nothing here is
            // deleted for being "stale," only for exceeding the display cap.
            if array.size(bullDivLines) > divMaxCount
                line.delete(array.shift(bullDivLines))
                label.delete(array.shift(bullDivLabels))
    divPrevRsiLow   := divPlRsi
    divPrevPriceLow := _pLow
    divPrevLowBar   := _pBar

if showDiv and not na(divPhRsi)
    float _pHigh = high[divPivotLen]
    int   _pBar  = bar_index - divPivotLen
    bool  _divRecentH = showDivHistory or time[divPivotLen] >= time - 259200000
    if not na(divPrevRsiHigh) and _divRecentH
        // Higher high in price, lower high in RSI, from the overbought extreme
        if _pHigh > divPrevPriceHigh and divPhRsi < divPrevRsiHigh and math.max(divPhRsi, divPrevRsiHigh) >= divOB
            lastBearDivBar := _pBar
            array.push(bearDivLines, line.new(divPrevHighBar, divPrevPriceHigh, _pBar, _pHigh, color = color.new(#ff5252, 0), style = line.style_dotted, width = 2))
            array.push(bearDivLabels, label.new(_pBar, _pHigh, "Bear Div\n", color = color(na), textcolor = color.new(#ff5252, 0), style = label.style_label_down, size = size.tiny))
            if array.size(bearDivLines) > divMaxCount
                line.delete(array.shift(bearDivLines))
                label.delete(array.shift(bearDivLabels))
    divPrevRsiHigh   := divPhRsi
    divPrevPriceHigh := _pHigh
    divPrevHighBar   := _pBar

// [doc 39] Live confluence flags for the A+ setup row  -> docs/mpc_bos_strategy.md
var int lastExtBreakBar = na
if extBreakThisBar
    lastExtBreakBar := bar_index

bool bullDivStale = (not na(lastExtBreakBar) and not na(lastBullDivBar) and lastExtBreakBar > lastBullDivBar) or (not na(lastBearDivBar) and not na(lastBullDivBar) and lastBearDivBar > lastBullDivBar)
bool bearDivStale = (not na(lastExtBreakBar) and not na(lastBearDivBar) and lastExtBreakBar > lastBearDivBar) or (not na(lastBullDivBar) and not na(lastBearDivBar) and lastBullDivBar > lastBearDivBar)

bool bullDivActive = showDiv and not na(lastBullDivBar) and not bullDivStale and bar_index - lastBullDivBar <= divValidBars
bool bearDivActive = showDiv and not na(lastBearDivBar) and not bearDivStale and bar_index - lastBearDivBar <= divValidBars

// (The veto itself — longVetoA / shortVetoA — is built further down, next to
//  the A+ stage machine, because it needs the SOS bar. See the note there.)


var array<SessionInfo> sessionInfos = getSessionInfos()
if showSessions and timeframe.isintraday and withinSessionDays
    for info in sessionInfos
        info.update()

// [doc 40] DAILY LEVELS  -> docs/mpc_bos_strategy.md
var line  d_hLine  = na, var line  d_lLine  = na
var label d_hLbl   = na, var label d_lLbl   = na
var float d_hPrice = na, var float d_lPrice = na
var bool  d_hMit   = false, var bool  d_lMit = false
var int   d_hMitBar = na, var int  d_lMitBar = na
var int   d_hBar   = na, var int   d_lBar   = na

if newDay and i_currentDayOnly and i_showLiquidity
    if d_hMit
        line.delete(d_hLine), label.delete(d_hLbl)
        d_hLine := na, d_hLbl := na
    if d_lMit
        line.delete(d_lLine), label.delete(d_lLbl)
        d_lLine := na, d_lLbl := na

if canShowDaily and hasDailyTimeChanged and not isLastDaily and barstate.isconfirmed
    line.delete(d_hLine), line.delete(d_lLine)
    label.delete(d_hLbl), label.delete(d_lLbl)
    d_hBar   := bar_index
    d_lBar   := bar_index
    d_hLine  := line.new(d_hBar, dailyHigh[1], d_hBar + i_lineExtend, dailyHigh[1], color = i_dailyColor, style = line.style_solid, width = 1)
    d_lLine  := line.new(d_lBar, dailyLow[1],  d_lBar + i_lineExtend, dailyLow[1],  color = i_dailyColor, style = line.style_solid, width = 1)
    d_hLbl   := label.new(d_hBar + i_lineExtend, dailyHigh[1] + lblOff, f_labelText("PDH"), style = label.style_none, textcolor = i_dailyColor, size = f_liqSize(), textalign = text.align_left)
    d_lLbl   := label.new(d_lBar + i_lineExtend, dailyLow[1]  - lblOff, f_labelText("PDL"), style = label.style_none, textcolor = i_dailyColor, size = f_liqSize(), textalign = text.align_left)
    d_hPrice := dailyHigh[1]
    d_lPrice := dailyLow[1]
    d_hMit   := false
    d_lMit   := false
    array.set(a_lastHighs, 0, dailyHigh[1])
    array.set(a_lastLows,  0, dailyLow[1])

if not na(d_hLine)
    [newd_hMit, newd_hMitBar] = f_liqMitigate(d_hLine, d_hLbl, d_hMit, d_hMitBar, d_hBar, high > d_hPrice, i_dailyColor, i_isDailyEnabled)
    d_hMit := newd_hMit
    d_hMitBar := newd_hMitBar

if not na(d_lLine)
    [newd_lMit, newd_lMitBar] = f_liqMitigate(d_lLine, d_lLbl, d_lMit, d_lMitBar, d_lBar, low < d_lPrice, i_dailyColor, i_isDailyEnabled)
    d_lMit := newd_lMit
    d_lMitBar := newd_lMitBar

// [doc 41] WEEKLY LEVELS  -> docs/mpc_bos_strategy.md
var line  w_hLine  = na, var line  w_lLine  = na
var label w_hLbl   = na, var label w_lLbl   = na
var float w_hPrice = na, var float w_lPrice = na
var bool  w_hMit   = false, var bool  w_lMit = false
var int   w_hMitBar = na, var int  w_lMitBar = na
var int   w_hBar   = na, var int   w_lBar   = na

if newDay and i_currentDayOnly and i_showLiquidity
    if w_hMit
        line.delete(w_hLine), label.delete(w_hLbl)
        w_hLine := na, w_hLbl := na
    if w_lMit
        line.delete(w_lLine), label.delete(w_lLbl)
        w_lLine := na, w_lLbl := na

if canShowWeekly and hasWeeklyTimeChanged and not isLastWeekly and barstate.isconfirmed
    line.delete(w_hLine), line.delete(w_lLine)
    label.delete(w_hLbl), label.delete(w_lLbl)
    w_hBar   := bar_index
    w_lBar   := bar_index
    w_hLine  := line.new(w_hBar, weeklyHigh[1], w_hBar + i_lineExtend, weeklyHigh[1], color = i_weeklyColor, style = line.style_solid, width = 1)
    w_lLine  := line.new(w_lBar, weeklyLow[1],  w_lBar + i_lineExtend, weeklyLow[1],  color = i_weeklyColor, style = line.style_solid, width = 1)
    w_hLbl   := label.new(w_hBar + i_lineExtend, weeklyHigh[1] + lblOff, f_labelText("PWH"), style = label.style_none, textcolor = i_weeklyColor, size = f_liqSize(), textalign = text.align_left)
    w_lLbl   := label.new(w_lBar + i_lineExtend, weeklyLow[1]  - lblOff, f_labelText("PWL"), style = label.style_none, textcolor = i_weeklyColor, size = f_liqSize(), textalign = text.align_left)
    w_hPrice := weeklyHigh[1]
    w_lPrice := weeklyLow[1]
    w_hMit   := false
    w_lMit   := false
    array.set(a_lastHighs, 1, weeklyHigh[1])
    array.set(a_lastLows,  1, weeklyLow[1])

if not na(w_hLine)
    [neww_hMit, neww_hMitBar] = f_liqMitigate(w_hLine, w_hLbl, w_hMit, w_hMitBar, w_hBar, close > w_hPrice, i_weeklyColor, i_isWeeklyEnabled)
    w_hMit := neww_hMit
    w_hMitBar := neww_hMitBar

if not na(w_lLine)
    [neww_lMit, neww_lMitBar] = f_liqMitigate(w_lLine, w_lLbl, w_lMit, w_lMitBar, w_lBar, close < w_lPrice, i_weeklyColor, i_isWeeklyEnabled)
    w_lMit := neww_lMit
    w_lMitBar := neww_lMitBar

// [doc 42] PREVIOUS WEEKLY CLOSE (PWC)  -> docs/mpc_bos_strategy.md
var line  pwc_line  = na
var label pwc_lbl   = na
var float pwc_price = na
var int   pwc_bar   = na

if i_showPWC and i_showLiquidity and not na(pwcSecurity) and barstate.isconfirmed
    if na(pwc_price) or pwcSecurity != pwc_price
        if not na(pwc_line)
            line.delete(pwc_line)
        if not na(pwc_lbl)
            label.delete(pwc_lbl)
        pwc_price := pwcSecurity
        pwc_bar   := bar_index
        pwcCol    = close >= pwc_price ? color.blue : color.red
        pwc_line  := line.new(pwc_bar, pwc_price, pwc_bar + i_lineExtend, pwc_price, color = pwcCol, style = line.style_solid, width = 1)
        pwc_lbl   := label.new(pwc_bar + i_lineExtend, pwc_price + lblOff, f_labelText("PWC"), style = label.style_none, textcolor = pwcCol, size = f_liqSize(), textalign = text.align_left)

if not na(pwc_line) and i_showPWC and i_showLiquidity
    pwcCol = close >= pwc_price ? color.blue : color.red
    line.set_color(pwc_line, pwcCol)
    line.set_x2(pwc_line, bar_index + i_lineExtend)
    label.set_textcolor(pwc_lbl, pwcCol)
    label.set_x(pwc_lbl, bar_index + i_lineExtend)

// [doc 43] H4 LIQUIDITY SWEEP TRACKER  -> docs/mpc_bos_strategy.md
color H4_ACTIVE_COLOR = #FF6B35
color H4_SWEPT_COLOR  = color.new(#999999, 45)

var float h4TrackHigh    = na
var float h4TrackLow     = na
var int   h4TrackHighBar = na
var int   h4TrackLowBar  = na
var line  h4HighLine     = na
var label h4HighLbl      = na
var line  h4LowLine      = na
var label h4LowLbl       = na
var bool  h4HighSwept    = false
var bool  h4LowSwept     = false
var label h4SSHLbl       = na
var label h4BSLLbl       = na

if i_showH4Sweep and i_showLiquidity and h4BarChanged and not na(h4PrevHigh) and not na(h4PrevLow)
    line.delete(h4HighLine),  line.delete(h4LowLine)
    label.delete(h4HighLbl), label.delete(h4LowLbl)
    label.delete(h4SSHLbl),  label.delete(h4BSLLbl)
    h4SSHLbl       := na
    h4BSLLbl       := na
    h4TrackHigh    := h4PrevHigh
    h4TrackLow     := h4PrevLow
    h4TrackHighBar := bar_index
    h4TrackLowBar  := bar_index
    h4HighSwept    := false
    h4LowSwept     := false
    h4HighLine := line.new(h4TrackHighBar, h4TrackHigh, bar_index + i_lineExtend, h4TrackHigh, color = H4_ACTIVE_COLOR, style = line.style_solid, width = 1)
    h4HighLbl  := label.new(bar_index + i_lineExtend, h4TrackHigh + lblOff, f_labelText("H4 H"), style = label.style_none, textcolor = H4_ACTIVE_COLOR, size = f_liqSize(), textalign = text.align_left)
    h4LowLine  := line.new(h4TrackLowBar,  h4TrackLow,  bar_index + i_lineExtend, h4TrackLow,  color = H4_ACTIVE_COLOR, style = line.style_solid, width = 1)
    h4LowLbl   := label.new(bar_index + i_lineExtend, h4TrackLow  - lblOff, f_labelText("H4 L"), style = label.style_none, textcolor = H4_ACTIVE_COLOR, size = f_liqSize(), textalign = text.align_left)

if not na(h4HighLine) and i_showH4Sweep and i_showLiquidity
    if not h4HighSwept and high > h4TrackHigh and barstate.isconfirmed
        h4HighSwept := true
        h4SSHLbl    := na
    h4HCol = h4HighSwept ? H4_SWEPT_COLOR : H4_ACTIVE_COLOR
    line.set_color(h4HighLine, h4HCol)
    line.set_style(h4HighLine, h4HighSwept ? line.style_dotted : line.style_solid)
    line.set_x2(h4HighLine, bar_index + i_lineExtend)
    label.set_textcolor(h4HighLbl, h4HCol)
    label.set_x(h4HighLbl, bar_index + i_lineExtend)

if not na(h4LowLine) and i_showH4Sweep and i_showLiquidity
    if not h4LowSwept and low < h4TrackLow and barstate.isconfirmed
        h4LowSwept := true
        h4BSLLbl   := na
    h4LCol = h4LowSwept ? H4_SWEPT_COLOR : H4_ACTIVE_COLOR
    line.set_color(h4LowLine, h4LCol)
    line.set_style(h4LowLine, h4LowSwept ? line.style_dotted : line.style_solid)
    line.set_x2(h4LowLine, bar_index + i_lineExtend)
    label.set_textcolor(h4LowLbl, h4LCol)
    label.set_x(h4LowLbl, bar_index + i_lineExtend)

// [doc 44] SESSION H/L TRACKING  -> docs/mpc_bos_strategy.md
var float asiaHigh = na, var float asiaLow = na
var float londonHigh = na, var float londonLow = na
var float nyHigh = na, var float nyLow = na
var line  asiaHLine = na, var line  asiaLLine = na
var label asiaHLbl  = na, var label asiaLLbl  = na
var bool  asiaHMit = false, var bool  asiaLMit = false
var int   asiaHMitBar = na, var int  asiaLMitBar = na
var float asiaHPrice = na, var float asiaLPrice = na
var int   asiaHBar = na, var int   asiaLBar = na
var line  londonHLine = na, var line  londonLLine = na
var label londonHLbl  = na, var label londonLLbl  = na
var bool  londonHMit = false, var bool  londonLMit = false
var int   londonHMitBar = na, var int  londonLMitBar = na
var float londonHPrice = na, var float londonLPrice = na
var int   londonHBar = na, var int   londonLBar = na
var line  nyHLine = na, var line  nyLLine = na
var label nyHLbl  = na, var label nyLLbl  = na
var bool  nyHMit = false, var bool  nyLMit = false
var int   nyHMitBar = na, var int  nyLMitBar = na
var float nyHPrice = na, var float nyLPrice = na
var int   nyHBar = na, var int   nyLBar = na

if newDay and i_currentDayOnly and i_showLiquidity
    if asiaHMit
        line.delete(asiaHLine), label.delete(asiaHLbl)
        asiaHLine := na, asiaHLbl := na
    if asiaLMit
        line.delete(asiaLLine), label.delete(asiaLLbl)
        asiaLLine := na, asiaLLbl := na
    if londonHMit
        line.delete(londonHLine), label.delete(londonHLbl)
        londonHLine := na, londonHLbl := na
    if londonLMit
        line.delete(londonLLine), label.delete(londonLLbl)
        londonLLine := na, londonLLbl := na
    if nyHMit
        line.delete(nyHLine), label.delete(nyHLbl)
        nyHLine := na, nyHLbl := na
    if nyLMit
        line.delete(nyLLine), label.delete(nyLLbl)
        nyLLine := na, nyLLbl := na

if inAsia
    asiaHigh := (not inAsia[1]) ? high : math.max(asiaHigh, high)
    asiaLow  := (not inAsia[1]) ? low  : math.min(asiaLow,  low)
if inLondon
    londonHigh := (not inLondon[1]) ? high : math.max(londonHigh, high)
    londonLow  := (not inLondon[1]) ? low  : math.min(londonLow,  low)
if inNY
    nyHigh := (not inNY[1]) ? high : math.max(nyHigh, high)
    nyLow  := (not inNY[1]) ? low  : math.min(nyLow,  low)

if not inAsia and inAsia[1] and i_showAsiaHL and i_showLiquidity and not na(asiaHigh)
    line.delete(asiaHLine), line.delete(asiaLLine)
    label.delete(asiaHLbl), label.delete(asiaLLbl)
    asiaHBar   := bar_index
    asiaLBar   := bar_index
    asiaHLine  := line.new(asiaHBar, asiaHigh, asiaHBar + i_lineExtend, asiaHigh, color = i_asiaHLColor, style = line.style_solid, width = 1)
    asiaLLine  := line.new(asiaLBar, asiaLow,  asiaLBar + i_lineExtend, asiaLow,  color = i_asiaHLColor, style = line.style_solid, width = 1)
    asiaHLbl   := label.new(asiaHBar + i_lineExtend, asiaHigh + lblOff, f_labelText("Asia H"), style = label.style_none, textcolor = i_asiaHLColor, size = f_liqSize(), textalign = text.align_left)
    asiaLLbl   := label.new(asiaLBar + i_lineExtend, asiaLow  - lblOff, f_labelText("Asia L"), style = label.style_none, textcolor = i_asiaHLColor, size = f_liqSize(), textalign = text.align_left)
    asiaHPrice := asiaHigh
    asiaLPrice := asiaLow
    asiaHMit   := false
    asiaLMit   := false

if not inLondon and inLondon[1] and i_showLondonHL and i_showLiquidity and not na(londonHigh)
    line.delete(londonHLine), line.delete(londonLLine)
    label.delete(londonHLbl), label.delete(londonLLbl)
    londonHBar   := bar_index
    londonLBar   := bar_index
    londonHLine  := line.new(londonHBar, londonHigh, londonHBar + i_lineExtend, londonHigh, color = i_londonHLColor, style = line.style_solid, width = 1)
    londonLLine  := line.new(londonLBar, londonLow,  londonLBar + i_lineExtend, londonLow,  color = i_londonHLColor, style = line.style_solid, width = 1)
    londonHLbl   := label.new(londonHBar + i_lineExtend, londonHigh + lblOff, f_labelText("Ldn H"), style = label.style_none, textcolor = i_londonHLColor, size = f_liqSize(), textalign = text.align_left)
    londonLLbl   := label.new(londonLBar + i_lineExtend, londonLow  - lblOff, f_labelText("Ldn L"), style = label.style_none, textcolor = i_londonHLColor, size = f_liqSize(), textalign = text.align_left)
    londonHPrice := londonHigh
    londonLPrice := londonLow
    londonHMit   := false
    londonLMit   := false

if not inNY and inNY[1] and i_showNYHL and i_showLiquidity and not na(nyHigh)
    line.delete(nyHLine), line.delete(nyLLine)
    label.delete(nyHLbl), label.delete(nyLLbl)
    nyHBar   := bar_index
    nyLBar   := bar_index
    nyHLine  := line.new(nyHBar, nyHigh, nyHBar + i_lineExtend, nyHigh, color = i_nyHLColor, style = line.style_solid, width = 1)
    nyLLine  := line.new(nyLBar, nyLow,  nyLBar + i_lineExtend, nyLow,  color = i_nyHLColor, style = line.style_solid, width = 1)
    nyHLbl   := label.new(nyHBar + i_lineExtend, nyHigh + lblOff, f_labelText("NY H"), style = label.style_none, textcolor = i_nyHLColor, size = f_liqSize(), textalign = text.align_left)
    nyLLbl   := label.new(nyLBar + i_lineExtend, nyLow  - lblOff, f_labelText("NY L"), style = label.style_none, textcolor = i_nyHLColor, size = f_liqSize(), textalign = text.align_left)
    nyHPrice := nyHigh
    nyLPrice := nyLow
    nyHMit   := false
    nyLMit   := false

if not na(asiaHLine)
    [newasiaHMit, newasiaHMitBar] = f_liqMitigate(asiaHLine, asiaHLbl, asiaHMit, asiaHMitBar, asiaHBar, high > asiaHPrice, i_asiaHLColor, i_showAsiaHL)
    asiaHMit := newasiaHMit
    asiaHMitBar := newasiaHMitBar

if not na(asiaLLine)
    [newasiaLMit, newasiaLMitBar] = f_liqMitigate(asiaLLine, asiaLLbl, asiaLMit, asiaLMitBar, asiaLBar, low < asiaLPrice, i_asiaHLColor, i_showAsiaHL)
    asiaLMit := newasiaLMit
    asiaLMitBar := newasiaLMitBar

if not na(londonHLine)
    [newlondonHMit, newlondonHMitBar] = f_liqMitigate(londonHLine, londonHLbl, londonHMit, londonHMitBar, londonHBar, high > londonHPrice, i_londonHLColor, i_showLondonHL)
    londonHMit := newlondonHMit
    londonHMitBar := newlondonHMitBar

if not na(londonLLine)
    [newlondonLMit, newlondonLMitBar] = f_liqMitigate(londonLLine, londonLLbl, londonLMit, londonLMitBar, londonLBar, low < londonLPrice, i_londonHLColor, i_showLondonHL)
    londonLMit := newlondonLMit
    londonLMitBar := newlondonLMitBar

if not na(nyHLine)
    [newnyHMit, newnyHMitBar] = f_liqMitigate(nyHLine, nyHLbl, nyHMit, nyHMitBar, nyHBar, high > nyHPrice, i_nyHLColor, i_showNYHL)
    nyHMit := newnyHMit
    nyHMitBar := newnyHMitBar

if not na(nyLLine)
    [newnyLMit, newnyLMitBar] = f_liqMitigate(nyLLine, nyLLbl, nyLMit, nyLMitBar, nyLBar, low < nyLPrice, i_nyHLColor, i_showNYHL)
    nyLMit := newnyLMit
    nyLMitBar := newnyLMitBar

// [doc 45] LABEL COLLISION DETECTION  -> docs/mpc_bos_strategy.md
f_liqLabels() =>
    if i_showLiquidity and i_showLabels
        liq_y   = array.new_float()
        liq_lbl = array.new_label()

        // [doc 46] ── A LABEL NOBODY CAN SEE MAY NOT RESERVE A SLOT ─────────────────────  -> docs/mpc_bos_strategy.md
        float liqDupTol = syminfo.mintick
        // [doc 47] ⚠ And it defers only to a VISIBLE daily label. A mitigated PDH is  -> docs/mpc_bos_strategy.md
        bool  liqDupH   = i_isDailyEnabled and not na(d_hLbl) and not na(d_hPrice) and not d_hMit
        bool  liqDupL   = i_isDailyEnabled and not na(d_lLbl) and not na(d_lPrice) and not d_lMit

        if not na(d_hLbl)     and i_isDailyEnabled and not d_hMit
            array.push(liq_y, d_hPrice + lblOff),    array.push(liq_lbl, d_hLbl)
        if not na(w_hLbl)     and i_isWeeklyEnabled and not w_hMit
            array.push(liq_y, w_hPrice + lblOff),    array.push(liq_lbl, w_hLbl)
        if not na(pwc_lbl)    and i_showPWC
            array.push(liq_y, pwc_price + lblOff),   array.push(liq_lbl, pwc_lbl)
        if not na(h4HighLbl)  and i_showH4Sweep
            array.push(liq_y, h4TrackHigh + lblOff), array.push(liq_lbl, h4HighLbl)
        if not na(asiaHLbl)   and i_showAsiaHL and not asiaHMit
            if liqDupH and math.abs(asiaHPrice - d_hPrice) <= liqDupTol
                label.set_textcolor(asiaHLbl, color(na))
            else
                array.push(liq_y, asiaHPrice + lblOff),  array.push(liq_lbl, asiaHLbl)
        if not na(londonHLbl) and i_showLondonHL and not londonHMit
            if liqDupH and math.abs(londonHPrice - d_hPrice) <= liqDupTol
                label.set_textcolor(londonHLbl, color(na))
            else
                array.push(liq_y, londonHPrice + lblOff),array.push(liq_lbl, londonHLbl)
        if not na(nyHLbl)     and i_showNYHL and not nyHMit
            if liqDupH and math.abs(nyHPrice - d_hPrice) <= liqDupTol
                label.set_textcolor(nyHLbl, color(na))
            else
                array.push(liq_y, nyHPrice + lblOff),    array.push(liq_lbl, nyHLbl)

        if not na(d_lLbl)     and i_isDailyEnabled and not d_lMit
            array.push(liq_y, d_lPrice - lblOff),    array.push(liq_lbl, d_lLbl)
        if not na(w_lLbl)     and i_isWeeklyEnabled and not w_lMit
            array.push(liq_y, w_lPrice - lblOff),    array.push(liq_lbl, w_lLbl)
        if not na(h4LowLbl)   and i_showH4Sweep
            array.push(liq_y, h4TrackLow - lblOff),  array.push(liq_lbl, h4LowLbl)
        if not na(asiaLLbl)   and i_showAsiaHL and not asiaLMit
            if liqDupL and math.abs(asiaLPrice - d_lPrice) <= liqDupTol
                label.set_textcolor(asiaLLbl, color(na))
            else
                array.push(liq_y, asiaLPrice - lblOff),  array.push(liq_lbl, asiaLLbl)
        if not na(londonLLbl) and i_showLondonHL and not londonLMit
            if liqDupL and math.abs(londonLPrice - d_lPrice) <= liqDupTol
                label.set_textcolor(londonLLbl, color(na))
            else
                array.push(liq_y, londonLPrice - lblOff),array.push(liq_lbl, londonLLbl)
        if not na(nyLLbl)     and i_showNYHL and not nyLMit
            if liqDupL and math.abs(nyLPrice - d_lPrice) <= liqDupTol
                label.set_textcolor(nyLLbl, color(na))
            else
                array.push(liq_y, nyLPrice - lblOff),    array.push(liq_lbl, nyLLbl)

        n = array.size(liq_y)
        if n > 1
            sortIdx = array.sort_indices(liq_y, order.ascending)
            float prevY = array.get(liq_y, array.get(sortIdx, 0))
            label.set_y(array.get(liq_lbl, array.get(sortIdx, 0)), prevY)
            // [doc 48] prevY is advanced BEFORE the set_y call so the loop's last statement is  -> docs/mpc_bos_strategy.md
            for i = 1 to n - 1
                idx   = array.get(sortIdx, i)
                baseY = array.get(liq_y, idx)
                adjY  = math.max(baseY, prevY + lblOff)
                prevY := adjY
                label.set_y(array.get(liq_lbl, idx), adjY)
        else if n == 1
            label.set_y(array.get(liq_lbl, 0), array.get(liq_y, 0))

f_liqLabels()

// Kept from the deleted Kill Zones block — the execution layer's final-hour
// rule (lateDayBlock) reads it.
nyHour = hour(time, "America/New_York")

// [doc 49] FIBONACCI DRAWING  -> docs/mpc_bos_strategy.md
var float fiboE1Price = na
var float fiboE2Price = na
var float fiboE3Price = na
var float fiboE4Price = na

var line  fibo1Line  = na,  var label fibo1Label  = na
var line  fibo2Line  = na,  var label fibo2Label  = na
var line  fibo3Line  = na,  var label fibo3Label  = na
var line  fibo4Line  = na,  var label fibo4Label  = na
var line  fibo5Line  = na,  var label fibo5Label  = na
var line  fibo6Line  = na,  var label fibo6Label  = na
var line  fibo7Line  = na,  var label fibo7Label  = na
var line  fibo10Line = na,  var label fibo10Label = na

var array<box>   sniperBoxArr    = array.new<box>()
var array<line>  sniper382Arr    = array.new<line>()
var array<line>  sniper50Arr     = array.new<line>()
var array<label> sniperLbl382Arr = array.new<label>()
var float        sniperZoneTop    = na
var float        sniperZoneBot    = na
var bool         sniperZoneActive = false
var bool         sz_bullish       = true
var string       sz_status        = ""
var int          sz_bar           = na   // bar the current zone was anchored on

var float fibo_ash     = na
var float fibo_asl     = na
var int   fibo_ash_loc = na
var int   fibo_asl_loc = na
var int   fibo_dir     = 0

// ── Touched tracking: each level goes grey until price reaches it ──
color FIBO_GREY  = color.new(#888888, 0)
color MACRO_GREY = color.new(#888888, 0)
var bool fiboOriginChanged = false
fiboOriginChanged := false   // reset every bar — only true on the specific bar origin changes
var bool fibo1Touched  = false
var bool fibo2Touched  = false
var bool fibo3Touched  = false
var bool fibo4Touched  = false
var bool fibo5Touched  = false
var bool fibo6Touched  = false
var bool fibo7Touched  = false
var bool fibo10Touched = false
var bool fibo618EverReached = false  // persists true once 0.618 was hit — gates TP checks from NEXT bar
var bool fiboResetActive    = false  // true once TP3 has been hit — suppresses drawing until the next new leg
// [doc 50] Inbound touch of the 0.5 level during the RETRACEMENT toward the entry z  -> docs/mpc_bos_strategy.md
var bool fiboHalfReached    = false

// Prices of each level (persistent so touched check works outside the draw block)
var float fiboP1  = na, var float fiboP2  = na, var float fiboP3  = na
var float fiboP4  = na, var float fiboP5  = na, var float fiboP6  = na
var float fiboP7  = na
var float fiboP10 = na
var int   fiboStartIndexPrev = na
var float fiboPrevAsh = na   // detects when the extending anchor (ash/asl) itself
var float fiboPrevAsl = na   // changed this bar — e.g. a live wick during pb_mode —
                              // so touched-checks (esp. TP3) don't self-trigger off it
var int   fiboStartIndex     = na   // persistent — accessible outside if showFibo block

if not na(st.ash)
    fibo_ash     := st.ash
    fibo_ash_loc := st.ash_loc
if not na(st.asl)
    fibo_asl     := st.asl
    fibo_asl_loc := st.asl_loc
if st.dir != 0
    fibo_dir := st.dir

if st.pb_mode == 1 and not na(st.pb_extreme)
    fibo_ash     := st.pb_extreme
    fibo_ash_loc := st.pb_extreme_loc
if st.pb_mode == -1 and not na(st.pb_extreme)
    fibo_asl     := st.pb_extreme
    fibo_asl_loc := st.pb_extreme_loc

// If an internal swing confirmed a more extreme point than the external anchor,
// adopt it for the fib pull only — nothing else about structure changes.
if fibo_dir == 1 and not na(i_confirmed_low_price) and not na(fibo_asl) and i_confirmed_low_price < fibo_asl
    fibo_asl     := i_confirmed_low_price
    fibo_asl_loc := i_confirmed_low_loc
if fibo_dir == -1 and not na(i_confirmed_high_price) and not na(fibo_ash) and i_confirmed_high_price > fibo_ash
    fibo_ash     := i_confirmed_high_price
    fibo_ash_loc := i_confirmed_high_loc

// Shared by External/Internal/Cycle fib: a level is "touched" once it has been
// reached, and stays touched thereafter.
f_checkTouch(bool touched, float lvl, bool breachCond) =>
    touched or (not na(lvl) and breachCond)

f_fiboLabel(float val, string tpLabel, string entryLabel) =>
    sharedLabelMode == "TP/Entry"    ? tpLabel    + "  (" :
     str.tostring(val) + "  ("

// Shared by External/Internal/Cycle fib: creates a level's line+label on first use,
// updates them in place on later bars, or deletes+clears them when hidden/reset.
f_fibLevel(bool show, line lineId, label labelId, int x1, float y, int x2, color col, string lstyle, string txt) =>
    line  outLine  = lineId
    label outLabel = labelId
    if show
        if na(outLine)
            outLine  := line.new(x1, y, x2, y, xloc = xloc.bar_index, color = col, style = lstyle, width = 1)
            outLabel := label.new(x2 + 2, y, txt, style = label.style_none, textcolor = col, size = size.small, xloc = xloc.bar_index)
        else
            line.set_xy1(outLine, x1, y)
            line.set_xy2(outLine, x2, y)
            line.set_color(outLine, col)
            line.set_style(outLine, lstyle)
            label.set_xy(outLabel, x2 + 2, y)
            label.set_text(outLabel, txt)
            label.set_textcolor(outLabel, col)
    else
        if not na(outLine)
            line.delete(outLine)
            label.delete(outLabel)
            outLine  := na
            outLabel := na
    [outLine, outLabel]

if showFibo and not na(fibo_ash) and not na(fibo_asl) and fibo_dir != 0
    fiboRange      = fibo_ash - fibo_asl
    fiboStartIndex := fibo_dir == 1 ? fibo_asl_loc : fibo_ash_loc

    fiboE1Price := fibo_dir == 1 ? fibo_ash - fiboRange * fibo3Value : fibo_asl + fiboRange * fibo3Value
    fiboE2Price := fibo_dir == 1 ? fibo_ash - fiboRange * fibo4Value : fibo_asl + fiboRange * fibo4Value
    fiboE3Price := fibo_dir == 1 ? fibo_ash - fiboRange * fibo5Value : fibo_asl + fiboRange * fibo5Value
    fiboE4Price := fibo_dir == 1 ? fibo_ash - fiboRange * fibo6Value : fibo_asl + fiboRange * fibo6Value

    // Compute all level prices
    fiboP1  := fibo_dir == 1 ? fibo_ash - fiboRange * fibo1Value  : fibo_asl + fiboRange * fibo1Value
    fiboP2  := fibo_dir == 1 ? fibo_ash - fiboRange * fibo2Value  : fibo_asl + fiboRange * fibo2Value
    fiboP3  := fibo_dir == 1 ? fibo_ash - fiboRange * fibo3Value  : fibo_asl + fiboRange * fibo3Value
    fiboP4  := fibo_dir == 1 ? fibo_ash - fiboRange * fibo4Value  : fibo_asl + fiboRange * fibo4Value
    fiboP5  := fibo_dir == 1 ? fibo_ash - fiboRange * fibo5Value  : fibo_asl + fiboRange * fibo5Value
    fiboP6  := fibo_dir == 1 ? fibo_ash - fiboRange * fibo6Value  : fibo_asl + fiboRange * fibo6Value
    fiboP7  := fibo_dir == 1 ? fibo_ash - fiboRange * fibo7Value  : fibo_asl + fiboRange * fibo7Value
    fiboP10 := fibo_dir == 1 ? fibo_ash - fiboRange * fibo10Value : fibo_asl + fiboRange * fibo10Value

    // Reset touched flags when fib origin changes (new leg)
    fiboOriginChanged = fiboStartIndex != fiboStartIndexPrev
    if fiboOriginChanged
        fibo1Touched  := false
        fibo2Touched  := false
        fibo3Touched  := false
        fibo4Touched  := false
        fibo5Touched  := false
        fibo6Touched  := false
        fibo7Touched  := false
        fibo10Touched := false
        fibo618EverReached := false
        fiboResetActive    := false
        fiboHalfReached    := false
        i_confirmed_low_price  := na
        i_confirmed_low_loc    := na
        i_confirmed_high_price := na
        i_confirmed_high_loc   := na
    fiboStartIndexPrev := fiboStartIndex

    // [doc 51] Skip ALL touched checks on the same bar the origin changed, OR the same   -> docs/mpc_bos_strategy.md
    bool fiboExtChanged = (not na(fiboPrevAsh) and fibo_ash != fiboPrevAsh) or (not na(fiboPrevAsl) and fibo_asl != fiboPrevAsl)
    if not fiboOriginChanged and not fiboExtChanged
        // [doc 52] Gate: coloring only activates once 0.618 is reached.  -> docs/mpc_bos_strategy.md
        bool fibo618Reached = fibo_dir == 1 ? low <= fiboP3 : high >= fiboP3

        // Inbound 0.5 touch — ungated; A+ EARLY entry tier as price retraces in
        fiboHalfReached := f_checkTouch(fiboHalfReached, fiboP2, fibo_dir == 1 ? low <= fiboP2 : high >= fiboP2)

        if fibo618Reached
            // 0.618 — mark itself on the bar it's first hit
            if not fibo3Touched
                fibo3Touched := true

            // E levels (deeper retracements) — fire immediately when price goes through them
            fibo4Touched  := f_checkTouch(fibo4Touched,  fiboP4,  fibo_dir == 1 ? low <= fiboP4  : high >= fiboP4)
            fibo5Touched  := f_checkTouch(fibo5Touched,  fiboP5,  fibo_dir == 1 ? low <= fiboP5  : high >= fiboP5)
            fibo6Touched  := f_checkTouch(fibo6Touched,  fiboP6,  fibo_dir == 1 ? low <= fiboP6  : high >= fiboP6)
            fibo10Touched := f_checkTouch(fibo10Touched, fiboP10, fibo_dir == 1 ? low <= fiboP10 : high >= fiboP10)

        // TP levels — only checked AFTER 0.618 has been hit on a PREVIOUS bar
        if fibo618EverReached
            fibo2Touched := f_checkTouch(fibo2Touched, fiboP2, fibo_dir == 1 ? high >= fiboP2 : low <= fiboP2)
            fibo1Touched := f_checkTouch(fibo1Touched, fiboP1, fibo_dir == 1 ? high >= fiboP1 : low <= fiboP1)
            fibo7Touched := f_checkTouch(fibo7Touched, fiboP7, fibo_dir == 1 ? high >= fiboP7 : low <= fiboP7)

        // Set persistent flag AFTER all checks — so TP checks only run from NEXT bar
        if fibo618Reached and not fibo618EverReached
            fibo618EverReached := true

    fiboPrevAsh := fibo_ash
    fiboPrevAsl := fibo_asl

    color c1 = fibo1Touched ? fibo1Color : FIBO_GREY
    string tx1 = f_fiboLabel(fibo1Value, "TP2", "TP2") + str.tostring(fiboP1, format.mintick) + ")"
    [l1, lb1] = f_fibLevel(drawFibs and not fiboResetActive, fibo1Line, fibo1Label, fiboStartIndex, fiboP1, bar_index + fiboLineExtend, c1, f_fiboLineStyle(fibo1Style), tx1)
    fibo1Line := l1
    fibo1Label := lb1

    color c2 = fibo2Touched ? fibo2Color : FIBO_GREY
    string tx2 = (fibo2Touched ? "FFT  (" : f_fiboLabel(fibo2Value, "TP1", "TP1")) + str.tostring(fiboP2, format.mintick) + ")"
    [l2, lb2] = f_fibLevel(drawFibs and not fiboResetActive, fibo2Line, fibo2Label, fiboStartIndex, fiboP2, bar_index + fiboLineExtend, c2, f_fiboLineStyle(fibo2Style), tx2)
    fibo2Line := l2
    fibo2Label := lb2

    color c3 = fibo3Touched ? fibo3Color : FIBO_GREY
    string tx3 = f_fiboLabel(fibo3Value, "E1", "E1") + str.tostring(fiboP3, format.mintick) + ")"
    [l3, lb3] = f_fibLevel(drawFibs and not fiboResetActive, fibo3Line, fibo3Label, fiboStartIndex, fiboP3, bar_index + fiboLineExtend, c3, f_fiboLineStyle(fibo3Style), tx3)
    fibo3Line := l3
    fibo3Label := lb3

    color c4 = fibo4Touched ? fibo4Color : FIBO_GREY
    string tx4 = f_fiboLabel(fibo4Value, "E2", "E2") + str.tostring(fiboP4, format.mintick) + ")"
    [l4, lb4] = f_fibLevel(drawFibs and not fiboResetActive, fibo4Line, fibo4Label, fiboStartIndex, fiboP4, bar_index + fiboLineExtend, c4, f_fiboLineStyle(fibo4Style), tx4)
    fibo4Line := l4
    fibo4Label := lb4

    color c5 = fibo5Touched ? fibo5Color : FIBO_GREY
    string tx5 = f_fiboLabel(fibo5Value, "E3", "E3") + str.tostring(fiboP5, format.mintick) + ")"
    [l5, lb5] = f_fibLevel(drawFibs and not fiboResetActive, fibo5Line, fibo5Label, fiboStartIndex, fiboP5, bar_index + fiboLineExtend, c5, f_fiboLineStyle(fibo5Style), tx5)
    fibo5Line := l5
    fibo5Label := lb5

    color c6 = fibo6Touched ? fibo6Color : FIBO_GREY
    string tx6 = f_fiboLabel(fibo6Value, "E4", "E4") + str.tostring(fiboP6, format.mintick) + ")"
    [l6, lb6] = f_fibLevel(drawFibs and not fiboResetActive, fibo6Line, fibo6Label, fiboStartIndex, fiboP6, bar_index + fiboLineExtend, c6, f_fiboLineStyle(fibo6Style), tx6)
    fibo6Line := l6
    fibo6Label := lb6

    color c10 = fibo10Touched ? fibo10Color : FIBO_GREY
    string tx10 = f_fiboLabel(fibo10Value, "1.0", "1.0") + str.tostring(fiboP10, format.mintick) + ")"
    [l10, lb10] = f_fibLevel(drawFibs and not fiboResetActive, fibo10Line, fibo10Label, fiboStartIndex, fiboP10, bar_index + fiboLineExtend, c10, f_fiboLineStyle(fibo10Style), tx10)
    fibo10Line := l10
    fibo10Label := lb10

    color c7 = fibo7Touched ? fibo7Color : FIBO_GREY
    string tx7 = f_fiboLabel(fibo7Value, "TP3", "TP3") + str.tostring(fiboP7, format.mintick) + ")"
    [l7, lb7] = f_fibLevel(drawFibs and not fiboResetActive, fibo7Line, fibo7Label, fiboStartIndex, fiboP7, bar_index + fiboLineExtend, c7, f_fiboLineStyle(fibo7Style), tx7)
    fibo7Line := l7
    fibo7Label := lb7

f_macroLineStyle(string opt) =>
    opt == "┈" ? line.style_dotted : opt == "╌" ? line.style_dashed : line.style_solid

f_macroLabel(float val, string tpLabel, string entryLabel) =>
    sharedLabelMode == "TP/Entry"    ? tpLabel    + "  (" :
     str.tostring(val) + "  ("

// [doc 53] macro_dir tracks the OVERALL trend direction we are currently in.  -> docs/mpc_bos_strategy.md
var int   macro_dir         = 0
var int   macro_prev_st_dir = 0
var float macro_origin      = na   // fixed anchor: the extreme of the PRIOR opposite cycle
var int   macro_origin_loc  = na
var float macro_extreme     = na   // running extreme of the CURRENT cycle (keeps extending across multiple BOS)
var int   macro_extreme_loc = na

var line  macroLine0   = na, var label macroLabel0   = na
var line  macroLine382 = na, var label macroLabel382 = na
var line  macroLine50  = na, var label macroLabel50  = na
var line  macroLine618 = na, var label macroLabel618 = na
var line  macroLine702 = na, var label macroLabel702 = na
var line  macroLine786 = na, var label macroLabel786 = na
var line  macroLine886 = na, var label macroLabel886 = na
var line  macroLine100 = na, var label macroLabel100 = na

// ── Macro fib touched tracking ──
var bool macro0Touched    = false   // HH / 0.0
var bool macro382Touched  = false   // TP2
var bool macro50Touched   = false   // TP1 / FFT
var bool macro618Touched  = false   // E1
var bool macro702Touched  = false   // E2
var bool macro786Touched  = false   // E3
var bool macro886Touched  = false   // E4
var bool macro100Touched  = false   // LL / 1.0
var bool macro618EverReached = false  // gates TP checks from next bar after E1 hit
var float macro_prev_extreme = na   // detects when extreme changes (new HH)

// [doc 54] ── EXACT RULE (per latest instructions) ──  -> docs/mpc_bos_strategy.md

var bool  macro_origin_locked  = false
var float macro_last_conf_high = na
var bool  macro_visible        = false
var int   macro_last_bear_sos_bar = na
var float macro_ll_since_bear_sos = na   // lowest low seen since the last bearish SOS — used as bottom anchor
var int   macro_ll_since_bear_sos_bar = na

// [doc 55] Cycle Fib TRACKING always runs — its discount zone doubles as the HTF PO  -> docs/mpc_bos_strategy.md
bool macroFibAllowed = timeframe.in_seconds() <= macroMaxTfMin * 60

if bar_index >= 0

    // [doc 56] ── Track the most recent bearish SOS and start tracking the low from tha  -> docs/mpc_bos_strategy.md
    if st.bear_sos or na(macro_last_bear_sos_bar)
        macro_last_bear_sos_bar    := bar_index
        macro_ll_since_bear_sos    := low
        macro_ll_since_bear_sos_bar := bar_index

    // [doc 57] ── While waiting for a bullish SOS, keep updating the lowest low since b  -> docs/mpc_bos_strategy.md
    if not macro_origin_locked and not na(macro_last_bear_sos_bar)
        if low < macro_ll_since_bear_sos
            macro_ll_since_bear_sos     := low
            macro_ll_since_bear_sos_bar := bar_index

    // ── RESET: price closed below the locked bottom ──
    if macro_origin_locked and not na(macro_origin) and close < macro_origin
        line.delete(macroLine0),   label.delete(macroLabel0)
        line.delete(macroLine382), label.delete(macroLabel382)
        line.delete(macroLine50),  label.delete(macroLabel50)
        line.delete(macroLine618), label.delete(macroLabel618)
        line.delete(macroLine702), label.delete(macroLabel702)
        line.delete(macroLine786), label.delete(macroLabel786)
        line.delete(macroLine886), label.delete(macroLabel886)
        line.delete(macroLine100), label.delete(macroLabel100)
        macroLine0 := na,   macroLabel0 := na
        macroLine382 := na, macroLabel382 := na
        macroLine50 := na,  macroLabel50 := na
        macroLine618 := na, macroLabel618 := na
        macroLine702 := na, macroLabel702 := na
        macroLine786 := na, macroLabel786 := na
        macroLine886 := na, macroLabel886 := na
        macroLine100 := na, macroLabel100 := na
        macro_dir            := 0
        macro_origin          := na
        macro_origin_loc      := na
        macro_extreme         := na
        macro_extreme_loc     := na
        macro_origin_locked   := false
        macro_last_conf_high  := na
        macro_visible         := false
        // Restart tracking from current bar so next cycle can begin
        macro_last_bear_sos_bar    := bar_index
        macro_ll_since_bear_sos    := low
        macro_ll_since_bear_sos_bar := bar_index

    // ── BOTTOM LOCKS on bullish SOS — always the true extreme low since bear SOS ──
    float macroBottomAnchor    = macro_ll_since_bear_sos
    int   macroBottomAnchorBar = macro_ll_since_bear_sos_bar
    if st.bull_sos and not macro_origin_locked and not na(macroBottomAnchor) and not na(st.last_conf_high)
        macro_dir            := 1
        macro_origin          := macroBottomAnchor
        macro_origin_loc      := macroBottomAnchorBar
        macro_extreme         := st.last_conf_high
        macro_extreme_loc     := st.last_conf_high_loc
        macro_origin_locked   := true
        macro_last_conf_high  := st.last_conf_high
        macro_visible         := true
        macro_prev_extreme    := st.last_conf_high
        // Reset all touched flags for new cycle
        macro0Touched   := false
        macro382Touched := false
        macro50Touched  := false
        macro618Touched := false
        macro702Touched := false
        macro786Touched := false
        macro886Touched := false
        macro100Touched := false
        macro618EverReached := false

    // ── TOP EXTENDS on every new confirmed HH — reset touched flags, fib reappears ──
    bool macroNewHH = macro_origin_locked and not na(st.last_conf_high) and st.last_conf_high > macro_last_conf_high
    if macroNewHH
        macro_extreme         := st.last_conf_high
        macro_extreme_loc      := st.last_conf_high_loc
        macro_last_conf_high   := st.last_conf_high
        macro_visible         := true
        macro_prev_extreme    := st.last_conf_high
        // New HH = new fib range, reset all touched
        macro0Touched   := false
        macro382Touched := false
        macro50Touched  := false
        macro618Touched := false
        macro702Touched := false
        macro786Touched := false
        macro886Touched := false
        macro100Touched := false
        macro618EverReached := false

    // ── Macro touched tracking (same logic as regular fib) ──
    if macro_visible and macro_origin_locked and not na(macro_origin) and not na(macro_extreme)
        float mH = macro_extreme
        float mL = macro_origin
        float mR = mH - mL
        if mR > 0
            float mP618 = mH - mR * 0.618
            float mP702 = mH - mR * 0.702
            float mP786 = mH - mR * 0.786
            float mP886 = mH - mR * 0.886
            float mP100 = mH - mR * 1.0
            float mP50  = mH - mR * 0.5
            float mP382 = mH - mR * 0.382
            float mP0   = mH - mR * 0.0

            bool macroExtChanged = macro_extreme != macro_prev_extreme
            bool macro618Reached = low <= mP618

            if not macroExtChanged
                if macro618Reached
                    macro618Touched := true
                    macro702Touched := f_checkTouch(macro702Touched, mP702, low <= mP702)
                    macro786Touched := f_checkTouch(macro786Touched, mP786, low <= mP786)
                    macro886Touched := f_checkTouch(macro886Touched, mP886, low <= mP886)
                    macro100Touched := f_checkTouch(macro100Touched, mP100, low <= mP100)

                if macro618EverReached
                    macro50Touched  := f_checkTouch(macro50Touched,  mP50,  high >= mP50)
                    macro382Touched := f_checkTouch(macro382Touched, mP382, high >= mP382)
                    macro0Touched   := f_checkTouch(macro0Touched,   mP0,   high >= mP0)

                if macro618Reached and not macro618EverReached
                    macro618EverReached := true

    // ── HIDE when price closes back above the locked top ──
    if macro_origin_locked and macro_visible and not na(macro_extreme) and close > macro_extreme
        line.delete(macroLine0),   label.delete(macroLabel0)
        line.delete(macroLine382), label.delete(macroLabel382)
        line.delete(macroLine50),  label.delete(macroLabel50)
        line.delete(macroLine618), label.delete(macroLabel618)
        line.delete(macroLine702), label.delete(macroLabel702)
        line.delete(macroLine786), label.delete(macroLabel786)
        line.delete(macroLine886), label.delete(macroLabel886)
        line.delete(macroLine100), label.delete(macroLabel100)
        macroLine0 := na,   macroLabel0 := na
        macroLine382 := na, macroLabel382 := na
        macroLine50 := na,  macroLabel50 := na
        macroLine618 := na, macroLabel618 := na
        macroLine702 := na, macroLabel702 := na
        macroLine786 := na, macroLabel786 := na
        macroLine886 := na, macroLabel886 := na
        macroLine100 := na, macroLabel100 := na
        macro_visible         := false

macro_prev_st_dir := st.dir

// ── Draw / update the macro fib ──
if showMacroFib and macroFibAllowed and macro_visible and macro_origin_locked and not na(macro_origin) and not na(macro_extreme)
    float mHigh   = macro_extreme
    float mLow    = macro_origin
    float mRange  = mHigh - mLow
    int   mStart  = math.max(0, bar_index - macroLineExtend)
    int   mEnd    = bar_index + macroLineExtend

    if mRange > 0
        float p0 = mHigh - mRange * 0.0
        color cm0 = macro0Touched ? macro0Color : MACRO_GREY
        string txm0 = f_macroLabel(0.0, "TP3", "TP3") + str.tostring(p0, format.mintick) + ")"
        [nml0, nmlb0] = f_fibLevel(showMacro0, macroLine0, macroLabel0, mStart, p0, mEnd, cm0, f_macroLineStyle(macro0Style), txm0)
        macroLine0 := nml0, macroLabel0 := nmlb0

        float p382 = mHigh - mRange * 0.382
        color cm382 = macro382Touched ? macro382Color : MACRO_GREY
        string txm382 = f_macroLabel(0.382, "TP2", "TP2") + str.tostring(p382, format.mintick) + ")"
        [nml382, nmlb382] = f_fibLevel(showMacro382, macroLine382, macroLabel382, mStart, p382, mEnd, cm382, f_macroLineStyle(macro382Style), txm382)
        macroLine382 := nml382, macroLabel382 := nmlb382

        float p50 = mHigh - mRange * 0.5
        color cm50 = macro50Touched ? macro50Color : MACRO_GREY
        string txm50 = (macro50Touched ? "FFT  (" : f_macroLabel(0.5, "TP1", "TP1")) + str.tostring(p50, format.mintick) + ")"
        [nml50, nmlb50] = f_fibLevel(showMacro50, macroLine50, macroLabel50, mStart, p50, mEnd, cm50, f_macroLineStyle(macro50Style), txm50)
        macroLine50 := nml50, macroLabel50 := nmlb50

        float p618 = mHigh - mRange * 0.618
        color cm618 = macro618Touched ? macro618Color : MACRO_GREY
        string txm618 = f_macroLabel(0.618, "E1", "E1") + str.tostring(p618, format.mintick) + ")"
        [nml618, nmlb618] = f_fibLevel(showMacro618, macroLine618, macroLabel618, mStart, p618, mEnd, cm618, f_macroLineStyle(macro618Style), txm618)
        macroLine618 := nml618, macroLabel618 := nmlb618

        float p702 = mHigh - mRange * 0.702
        color cm702 = macro702Touched ? macro702Color : MACRO_GREY
        string txm702 = f_macroLabel(0.702, "E2", "E2") + str.tostring(p702, format.mintick) + ")"
        [nml702, nmlb702] = f_fibLevel(showMacro702, macroLine702, macroLabel702, mStart, p702, mEnd, cm702, f_macroLineStyle(macro702Style), txm702)
        macroLine702 := nml702, macroLabel702 := nmlb702

        float p786 = mHigh - mRange * 0.786
        color cm786 = macro786Touched ? macro786Color : MACRO_GREY
        string txm786 = f_macroLabel(0.786, "E3", "E3") + str.tostring(p786, format.mintick) + ")"
        [nml786, nmlb786] = f_fibLevel(showMacro786, macroLine786, macroLabel786, mStart, p786, mEnd, cm786, f_macroLineStyle(macro786Style), txm786)
        macroLine786 := nml786, macroLabel786 := nmlb786

        float p886 = mHigh - mRange * 0.886
        color cm886 = macro886Touched ? macro886Color : MACRO_GREY
        string txm886 = f_macroLabel(0.886, "E4", "E4") + str.tostring(p886, format.mintick) + ")"
        [nml886, nmlb886] = f_fibLevel(showMacro886, macroLine886, macroLabel886, mStart, p886, mEnd, cm886, f_macroLineStyle(macro886Style), txm886)
        macroLine886 := nml886, macroLabel886 := nmlb886

        float p100 = mHigh - mRange * 1.0
        color cm100 = macro100Touched ? macro100Color : MACRO_GREY
        string txm100 = f_macroLabel(1.0, "1.0", "1.0") + str.tostring(p100, format.mintick) + ")"
        [nml100, nmlb100] = f_fibLevel(showMacro100, macroLine100, macroLabel100, mStart, p100, mEnd, cm100, f_macroLineStyle(macro100Style), txm100)
        macroLine100 := nml100, macroLabel100 := nmlb100


// [doc 58] INTERNAL FIB  -> docs/mpc_bos_strategy.md
var line  iFL0   = na, var label ifLbl0   = na
var line  iFL382 = na, var label ifLbl382 = na
var line  iFL50  = na, var label ifLbl50  = na
var line  iFL618 = na, var label ifLbl618 = na
var line  iFL702 = na, var label ifLbl702 = na
var line  iFL786 = na, var label ifLbl786 = na
var line  iFL886 = na, var label ifLbl886 = na
var line  iFL100 = na, var label ifLbl100 = na

// Clear internal fib when external BOS/SOS fires — wait for new iBOS/iSOS
if st.bull_bos or st.bear_bos or st.bull_sos or st.bear_sos
    iFib_dir := 0, iFib_asl := na, iFib_asl_loc := na, iFib_ash := na, iFib_ash_loc := na
    iFibPrevAsh := na, iFibPrevAsl := na
    iFib0Touched := false, iFib382Touched := false, iFib50Touched := false
    iFib618Touched := false, iFib702Touched := false, iFib786Touched := false
    iFib886Touched := false, iFib100Touched := false, iFib618EverReached := false
    iFib_tp3_hit_price := na, iFibResetActive := false
    line.delete(iFL0),   label.delete(ifLbl0)
    line.delete(iFL382), label.delete(ifLbl382)
    line.delete(iFL50),  label.delete(ifLbl50)
    line.delete(iFL618), label.delete(ifLbl618)
    line.delete(iFL702), label.delete(ifLbl702)
    line.delete(iFL786), label.delete(ifLbl786)
    line.delete(iFL886), label.delete(ifLbl886)
    line.delete(iFL100), label.delete(ifLbl100)

// Track live low/high since iBOS fired — updates the moving anchor
if iFib_dir == -1 and not na(iFib_ash)
    if na(iFib_asl) or low < iFib_asl
        iFib_asl     := low
        iFib_asl_loc := bar_index
else if iFib_dir == 1 and not na(iFib_asl)
    if na(iFib_ash) or high > iFib_ash
        iFib_ash     := high
        iFib_ash_loc := bar_index

// Internal fib touched tracking — same logic as micro fib
bool iFibExtChanged = (not na(iFibPrevAsh) and iFib_ash != iFibPrevAsh) or (not na(iFibPrevAsl) and iFib_asl != iFibPrevAsl)
if iFib_dir != 0 and not na(iFib_asl) and not na(iFib_ash) and not iFibExtChanged
    float iFR  = iFib_ash - iFib_asl
    if iFR > 0
        // Level prices (same direction logic as micro fib)
        float iTP618 = iFib_dir == 1 ? iFib_ash - iFR*0.618 : iFib_asl + iFR*0.618
        float iTP702 = iFib_dir == 1 ? iFib_ash - iFR*0.702 : iFib_asl + iFR*0.702
        float iTP786 = iFib_dir == 1 ? iFib_ash - iFR*0.786 : iFib_asl + iFR*0.786
        float iTP886 = iFib_dir == 1 ? iFib_ash - iFR*0.886 : iFib_asl + iFR*0.886
        float iTP50  = iFib_dir == 1 ? iFib_ash - iFR*0.5   : iFib_asl + iFR*0.5
        float iTP382 = iFib_dir == 1 ? iFib_ash - iFR*0.382 : iFib_asl + iFR*0.382
        float iTP0   = iFib_dir == 1 ? iFib_ash              : iFib_asl
        float iTP100 = iFib_dir == 1 ? iFib_asl              : iFib_ash

        // Gate: 0.618 must be reached first
        bool iGate618 = iFib_dir == 1 ? low <= iTP618 : high >= iTP618
        if iGate618 and not iFib618Touched
            iFib618Touched := true

        if iFib618Touched
            iFib702Touched := f_checkTouch(iFib702Touched, iTP702, iFib_dir == 1 ? low <= iTP702 : high >= iTP702)
            iFib786Touched := f_checkTouch(iFib786Touched, iTP786, iFib_dir == 1 ? low <= iTP786 : high >= iTP786)
            iFib886Touched := f_checkTouch(iFib886Touched, iTP886, iFib_dir == 1 ? low <= iTP886 : high >= iTP886)
            iFib100Touched := f_checkTouch(iFib100Touched, iTP100, iFib_dir == 1 ? low <= iTP100 : high >= iTP100)

        if iFib618EverReached
            iFib50Touched  := f_checkTouch(iFib50Touched,  iTP50,  iFib_dir == 1 ? high >= iTP50  : low <= iTP50)
            iFib382Touched := f_checkTouch(iFib382Touched, iTP382, iFib_dir == 1 ? high >= iTP382 : low <= iTP382)
            bool iFib0WasTouched = iFib0Touched
            iFib0Touched := f_checkTouch(iFib0Touched, iTP0, iFib_dir == 1 ? high >= iTP0 : low <= iTP0)
            if iFib0Touched and not iFib0WasTouched
                iFib_tp3_hit_price := iTP0

        if iGate618 and not iFib618EverReached
            iFib618EverReached := true

if iFib_dir != 0
    iFibPrevAsh := iFib_ash
    iFibPrevAsl := iFib_asl

if showFibo and showIFib and iFib_dir != 0 and not na(iFib_asl) and not na(iFib_ash)
    float iH  = iFib_ash
    float iL  = iFib_asl
    int   iS  = iFib_asl_loc
    float iR  = iH - iL
    int   iE  = bar_index + iFibExtend

    if iR > 0
        // [doc 59] Direction aware levels  -> docs/mpc_bos_strategy.md
        float iP0   = iFib_dir == 1 ? iH : iL
        float iP382 = iFib_dir == 1 ? iH - iR*0.382 : iL + iR*0.382
        float iP50  = iFib_dir == 1 ? iH - iR*0.5   : iL + iR*0.5
        float iP618 = iFib_dir == 1 ? iH - iR*0.618 : iL + iR*0.618
        float iP702 = iFib_dir == 1 ? iH - iR*0.702 : iL + iR*0.702
        float iP786 = iFib_dir == 1 ? iH - iR*0.786 : iL + iR*0.786
        float iP886 = iFib_dir == 1 ? iH - iR*0.886 : iL + iR*0.886
        float iP100 = iFib_dir == 1 ? iL : iH

        // Colors — grey until touched, then the level's configured color
        color c0 = iFib0Touched ? iFibo0Color : IFIB_GREY
        color c382 = iFib382Touched ? iFibo1Color : IFIB_GREY
        color c50 = iFib50Touched ? iFibo2Color : IFIB_GREY
        color c618 = iFib618Touched ? iFibo3Color : IFIB_GREY
        color c702 = iFib702Touched ? iFibo4Color : IFIB_GREY
        color c786 = iFib786Touched ? iFibo5Color : IFIB_GREY
        color c886 = iFib886Touched ? iFibo6Color : IFIB_GREY
        color c100 = iFib100Touched ? iFibo100Color : IFIB_GREY

        // FFT label when 0.5 first touched, otherwise honor TP/Entry vs Fib Value label mode
        string tx0 = f_fiboLabel(0.0, "TP3", "TP3") + str.tostring(iP0, format.mintick) + ")"
        string tx382 = f_fiboLabel(0.382, "TP2", "TP2") + str.tostring(iP382, format.mintick) + ")"
        string tx50 = (iFib50Touched ? "FFT  (" : f_fiboLabel(0.5, "TP1", "TP1")) + str.tostring(iP50, format.mintick) + ")"
        string tx618 = f_fiboLabel(0.618, "E1", "E1") + str.tostring(iP618, format.mintick) + ")"
        string tx702 = f_fiboLabel(0.702, "E2", "E2") + str.tostring(iP702, format.mintick) + ")"
        string tx786 = f_fiboLabel(0.786, "E3", "E3") + str.tostring(iP786, format.mintick) + ")"
        string tx886 = f_fiboLabel(0.886, "E4", "E4") + str.tostring(iP886, format.mintick) + ")"
        string tx100 = f_fiboLabel(1.0, "1.0", "1.0") + str.tostring(iP100, format.mintick) + ")"

        bool ishow = not iFibResetActive
        [nl0, nlb0] = f_fibLevel(ishow, iFL0, ifLbl0, iS, iP0, iE, c0, f_fiboLineStyle(iFibo0Style), tx0)
        iFL0 := nl0, ifLbl0 := nlb0
        [nl382, nlb382] = f_fibLevel(ishow, iFL382, ifLbl382, iS, iP382, iE, c382, f_fiboLineStyle(iFibo1Style), tx382)
        iFL382 := nl382, ifLbl382 := nlb382
        [nl50, nlb50] = f_fibLevel(ishow, iFL50, ifLbl50, iS, iP50, iE, c50, f_fiboLineStyle(iFibo2Style), tx50)
        iFL50 := nl50, ifLbl50 := nlb50
        [nl618, nlb618] = f_fibLevel(ishow, iFL618, ifLbl618, iS, iP618, iE, c618, f_fiboLineStyle(iFibo3Style), tx618)
        iFL618 := nl618, ifLbl618 := nlb618
        [nl702, nlb702] = f_fibLevel(ishow, iFL702, ifLbl702, iS, iP702, iE, c702, f_fiboLineStyle(iFibo4Style), tx702)
        iFL702 := nl702, ifLbl702 := nlb702
        [nl786, nlb786] = f_fibLevel(ishow, iFL786, ifLbl786, iS, iP786, iE, c786, f_fiboLineStyle(iFibo5Style), tx786)
        iFL786 := nl786, ifLbl786 := nlb786
        [nl886, nlb886] = f_fibLevel(ishow, iFL886, ifLbl886, iS, iP886, iE, c886, f_fiboLineStyle(iFibo6Style), tx886)
        iFL886 := nl886, ifLbl886 := nlb886
        [nl100, nlb100] = f_fibLevel(ishow, iFL100, ifLbl100, iS, iP100, iE, c100, f_fiboLineStyle(iFibo100Style), tx100)
        iFL100 := nl100, ifLbl100 := nlb100
    else
        line.delete(iFL0),   label.delete(ifLbl0)
        line.delete(iFL382), label.delete(ifLbl382)
        line.delete(iFL50),  label.delete(ifLbl50)
        line.delete(iFL618), label.delete(ifLbl618)
        line.delete(iFL702), label.delete(ifLbl702)
        line.delete(iFL786), label.delete(ifLbl786)
        line.delete(iFL886), label.delete(ifLbl886)
        line.delete(iFL100), label.delete(ifLbl100)
        iFL0 := na, ifLbl0 := na
        iFL382 := na, ifLbl382 := na
        iFL50 := na, ifLbl50 := na
        iFL618 := na, ifLbl618 := na
        iFL702 := na, ifLbl702 := na
        iFL786 := na, ifLbl786 := na
        iFL886 := na, ifLbl886 := na
        iFL100 := na, ifLbl100 := na

// [doc 60] SNIPER FIB  -> docs/mpc_bos_strategy.md
bool _snTrack   = showSniperFib or execConfSZ
bool _snBearBOS = barstate.isconfirmed and showFibo and _snTrack and st.bear_bos
bool _snBullBOS = barstate.isconfirmed and showFibo and _snTrack and st.bull_bos

if _snBearBOS or _snBullBOS
    float _snh   = _snBullBOS ? st.bull_bos_high : st.bear_bos_high
    float _snl   = _snBullBOS ? st.bull_bos_low : st.bear_bos_low
    float _snr   = _snh - _snl
    int   _snS   = _snBullBOS ? st.bull_bos_l_loc : st.bear_bos_h_loc
    int   _snE   = bar_index + 25
    float _sn382 = _snBullBOS ? _snl + _snr * 0.382 : _snh - _snr * 0.382
    float _sn50  = _snBullBOS ? _snl + _snr * 0.500 : _snh - _snr * 0.500
    float _zTop  = math.max(_sn382, _sn50)
    float _zBot  = math.min(_sn382, _sn50)

    // Only keep one sniper zone at a time
    if array.size(sniperBoxArr) > 0
        for i = 0 to array.size(sniperBoxArr) - 1
            box.delete(array.get(sniperBoxArr, i))
            line.delete(array.get(sniper382Arr, i))
            line.delete(array.get(sniper50Arr, i))
            label.delete(array.get(sniperLbl382Arr, i))
        array.clear(sniperBoxArr)
        array.clear(sniper382Arr)
        array.clear(sniper50Arr)
        array.clear(sniperLbl382Arr)

    color _snColor = _snBullBOS ? color.new(#4caf50, 75) : color.new(#ff4444, 75)
    color _snLineColor = _snBullBOS ? color.new(#4caf50, 0) : color.new(#ff4444, 0)

    if showSniperFib
        array.push(sniperBoxArr,    box.new(_snS, _zTop, _snE, _zBot, bgcolor = _snColor, border_color = color(na)))
        array.push(sniper382Arr,    line.new(_snS, _sn382, _snE, _sn382, color = _snLineColor, style = line.style_dotted, width = 1))
        array.push(sniper50Arr,     line.new(_snS, _sn50,  _snE, _sn50,  color = _snLineColor, style = line.style_dotted, width = 1))
        array.push(sniperLbl382Arr, label.new(_snE + 2, (_sn382 + _sn50) / 2, "SZ", style = label.style_none, textcolor = _snLineColor, size = size.small, textalign = text.align_center))
    sniperZoneTop    := _zTop
    sniperZoneBot    := _zBot
    sniperZoneActive := false
    sz_status        := ""   // reset status on new zone
    sz_bullish       := _snBullBOS
    sz_bar           := bar_index

if showFibo and showSniperFib and array.size(sniperBoxArr) > 0
    for _sni = 0 to array.size(sniperBoxArr) - 1
        box.set_right(array.get(sniperBoxArr,    _sni), bar_index + fiboLineExtend)
        line.set_x2(array.get(sniper382Arr,      _sni), bar_index + fiboLineExtend)
        line.set_x2(array.get(sniper50Arr,       _sni), bar_index + fiboLineExtend)
        label.set_x(array.get(sniperLbl382Arr,   _sni), bar_index + fiboLineExtend + 2)

// [doc 61] PLOTTING  -> docs/mpc_bos_strategy.md
plot(array.get(a_lastHighs, 0), "DH", color.new(i_dailyColor,   100), editable = false, display = display.none)
plot(array.get(a_lastLows,  0), "DL", color.new(i_dailyColor,   100), editable = false, display = display.none)
plot(array.get(a_lastHighs, 1), "WH", color.new(i_weeklyColor,  100), editable = false, display = display.none)
plot(array.get(a_lastLows,  1), "WL", color.new(i_weeklyColor,  100), editable = false, display = display.none)

// [doc 62] MPC - JARVIS CONFIRMATION TABLE  -> docs/mpc_bos_strategy.md
color JARVIS_BLACK  = #000000

// ── 1. LIQUIDITY slots ──
var string liq_h4h = "", var string liq_h4l = ""
var string liq_dh  = "", var string liq_dl  = ""
var string liq_ash = "", var string liq_asl = ""
var string liq_ldh = "", var string liq_ldl = ""
var string liq_nyh = "", var string liq_nyl = ""

// Price levels at point of sweep confirmation — used to detect invalidation
var float liq_h4h_px = na, var float liq_h4l_px = na
var float liq_dh_px  = na, var float liq_dl_px  = na
var float liq_ash_px = na, var float liq_asl_px = na
var float liq_ldh_px = na, var float liq_ldl_px = na
var float liq_nyh_px = na, var float liq_nyl_px = na
// Bar timestamps for each sweep — used to find most recent BSL/SSL
var int liq_h4h_bar = na, var int liq_h4l_bar = na
var int liq_dh_bar  = na, var int liq_dl_bar  = na
var int liq_ash_bar = na, var int liq_asl_bar = na
var int liq_ldh_bar = na, var int liq_ldl_bar = na
var int liq_nyh_bar = na, var int liq_nyl_bar = na

// ── Activate on sweep — stays active until replaced by next sweep or session reset ──
if barstate.isconfirmed
    if i_showH4Sweep and i_showLiquidity
        if h4HighSwept and not h4HighSwept[1] and not na(h4TrackHigh)
            liq_h4h := "BSL", liq_h4h_px := h4TrackHigh, liq_h4h_bar := bar_index
        if h4LowSwept and not h4LowSwept[1] and not na(h4TrackLow)
            liq_h4l := "SSL", liq_h4l_px := h4TrackLow, liq_h4l_bar := bar_index
    if i_isDailyEnabled and i_showLiquidity
        if d_hMit and not d_hMit[1]
            liq_dh := "BSL", liq_dh_px := d_hPrice, liq_dh_bar := bar_index
        if d_lMit and not d_lMit[1]
            liq_dl := "SSL", liq_dl_px := d_lPrice, liq_dl_bar := bar_index
    if i_showAsiaHL and i_showLiquidity
        if asiaHMit and not asiaHMit[1]
            liq_ash := "BSL", liq_ash_px := asiaHPrice, liq_ash_bar := bar_index
        if asiaLMit and not asiaLMit[1]
            liq_asl := "SSL", liq_asl_px := asiaLPrice, liq_asl_bar := bar_index
    if i_showLondonHL and i_showLiquidity
        if londonHMit and not londonHMit[1]
            liq_ldh := "BSL", liq_ldh_px := londonHPrice, liq_ldh_bar := bar_index
        if londonLMit and not londonLMit[1]
            liq_ldl := "SSL", liq_ldl_px := londonLPrice, liq_ldl_bar := bar_index
    if i_showNYHL and i_showLiquidity
        if nyHMit and not nyHMit[1]
            liq_nyh := "BSL", liq_nyh_px := nyHPrice, liq_nyh_bar := bar_index
        if nyLMit and not nyLMit[1]
            liq_nyl := "SSL", liq_nyl_px := nyLPrice, liq_nyl_bar := bar_index

// H4 resets on new H4 bar
if h4BarChanged
    liq_h4h := "", liq_h4h_px := na, liq_h4h_bar := na
    liq_h4l := "", liq_h4l_px := na, liq_h4l_bar := na

// (STRUCTURE + SNIPER-ZONE table slots and the JARVIS table drawing were removed
//  2026-07-24 to free compile tokens — they only fed the confirmation table.)

// Most recent BSL/SSL source — priority: NY > London > Asia > Daily > H4
bool showSessH = liq_dh == ""
bool showSessL = liq_dl == ""

// Find most recent BSL — whichever was swept latest by bar_index
string recentBSL = ""
int    recentBSL_bar = -1
if liq_h4h != "" and not na(liq_h4h_bar) and liq_h4h_bar > recentBSL_bar
    recentBSL := "H4 High",   recentBSL_bar := liq_h4h_bar
if liq_dh != "" and not na(liq_dh_bar) and liq_dh_bar > recentBSL_bar
    recentBSL := "Day High",  recentBSL_bar := liq_dh_bar
if showSessH and liq_ash != "" and not na(liq_ash_bar) and liq_ash_bar > recentBSL_bar
    recentBSL := "Asia High", recentBSL_bar := liq_ash_bar
if showSessH and liq_ldh != "" and not na(liq_ldh_bar) and liq_ldh_bar > recentBSL_bar
    recentBSL := "Ldn High",  recentBSL_bar := liq_ldh_bar
if showSessH and liq_nyh != "" and not na(liq_nyh_bar) and liq_nyh_bar > recentBSL_bar
    recentBSL := "NY High",   recentBSL_bar := liq_nyh_bar

// Find most recent SSL — whichever was swept latest by bar_index
string recentSSL = ""
int    recentSSL_bar = -1
if liq_h4l != "" and not na(liq_h4l_bar) and liq_h4l_bar > recentSSL_bar
    recentSSL := "H4 Low",   recentSSL_bar := liq_h4l_bar
if liq_dl != "" and not na(liq_dl_bar) and liq_dl_bar > recentSSL_bar
    recentSSL := "Day Low",  recentSSL_bar := liq_dl_bar
if showSessL and liq_asl != "" and not na(liq_asl_bar) and liq_asl_bar > recentSSL_bar
    recentSSL := "Asia Low", recentSSL_bar := liq_asl_bar
if showSessL and liq_ldl != "" and not na(liq_ldl_bar) and liq_ldl_bar > recentSSL_bar
    recentSSL := "Ldn Low",  recentSSL_bar := liq_ldl_bar
if showSessL and liq_nyl != "" and not na(liq_nyl_bar) and liq_nyl_bar > recentSSL_bar
    recentSSL := "NY Low",   recentSSL_bar := liq_nyl_bar

// [doc 63] MPC- JARVIS WATERMARK  -> docs/mpc_bos_strategy.md
var table watermark = table.new(position.bottom_center, 1, 1)
if barstate.islast
    table.cell(watermark, 0, 0, "MPC- JARVIS",
      text_color  = color.new(#17578e, 20),
      text_size   = size.normal,
      bgcolor     = color.new(JARVIS_BLACK, 100),
      text_halign = text.align_center)


// [doc 64] STRATEGY EXECUTION — BOS continuation entries + the shared exit ladder  -> docs/mpc_bos_strategy.md


// ── 1. WHAT TRADES ─────────────────────────────────────────────────────────

// [doc 65] ── 2. WHAT ARMS IT (the break) ─────────────────────────────────────────  -> docs/mpc_bos_strategy.md

// [doc 66] ── 3. WHERE THE LIMIT RESTS (entry price) ──────────────────────────────  -> docs/mpc_bos_strategy.md

// ── 4. WHAT CAN REFUSE IT (filters) ────────────────────────────────────────

// ── 5. SIZE & STOP ─────────────────────────────────────────────────────────

// ── 6. TARGETS (the TP ladder) ─────────────────────────────────────────────

// ── 7. THE RUNNER — everything here starts only AFTER TP2 is hit ───────────

// ── 8. DRAWING (cosmetic — none of this changes a trade) ───────────────────

// [doc 67] ⚠ `bosVwapReq` IS A DROPDOWN RATHER THAN A CHECKBOX FOR A REASON THAT NO  -> docs/mpc_bos_strategy.md


// [doc 68] STAGE 0/1 — REGIME, then the BOS that arms it  -> docs/mpc_bos_strategy.md

float atr14 = ta.atr(14)

// [doc 69] Session-gap detector — the first bar after a market close (e.g. daily  -> docs/mpc_bos_strategy.md
int  barGap    = na(time[1]) ? 0 : time - time[1]
int  normalGap = na(time[1]) or na(time[2]) ? 0 : time[1] - time[2]
bool sessionGapBar = normalGap > 0 and barGap > normalGap * 2

var bool  bosRegL = false, var bool  bosRegS = false   // an SOS has set this side's regime
var int   bosCntL = 0,     var int   bosCntS = 0       // BOS ordinal since that SOS
var int   bosTrdL = 0,     var int   bosTrdS = 0       // filled trades this regime (F6)
var bool  bosL_on = false, var bool  bosS_on = false   // a leg is armed and watching
var float bosL_high = na,  var float bosL_low  = na    // the anchor break leg, frozen
var float bosS_high = na,  var float bosS_low  = na
var int   bosL_bar  = na,  var int   bosS_bar  = na
var int   bosL_n    = 0,   var int   bosS_n    = 0     // the anchor's BOS ordinal
var bool  bosL_half = false, var bool bosS_half = false // the per-anchor 0.5 latch
var string bosLwhy = "",   var string bosSwhy = ""     // why the last arm died — the [DEAD] log reads it

// [doc 70] Stage 0 — an SOS opens its own regime and closes the opposite one.  -> docs/mpc_bos_strategy.md
if st.bear_sos
    if bosL_on
        bosLwhy := "opposite SOS — the bullish regime is over"
    bosRegL := false, bosL_on := false
if st.bull_sos
    if bosS_on
        bosSwhy := "opposite SOS — the bearish regime is over"
    bosRegS := false, bosS_on := false
if st.bull_sos and not sessionGapBar
    bosRegL := true,  bosCntL := 0, bosTrdL := 0
if st.bear_sos and not sessionGapBar
    bosRegS := true,  bosCntS := 0, bosTrdS := 0

// [doc 71] Stage 1 — the BOS. The counter increments even when the filters refuse t  -> docs/mpc_bos_strategy.md
bool bosFireL = bosRegL and st.bull_bos and not st.bull_sos and not sessionGapBar and not na(st.bull_bos_high) and not na(st.bull_bos_low) and st.bull_bos_high > st.bull_bos_low
bool bosFireS = bosRegS and st.bear_bos and not st.bear_sos and not sessionGapBar and not na(st.bear_bos_high) and not na(st.bear_bos_low) and st.bear_bos_high > st.bear_bos_low

if bosFireL
    bosCntL := bosCntL + 1
    if bosL_on
        bosLwhy := "re-anchored — a newer BOS on this side took the setup"
    bosL_on := false
    bool _okWhichL = bosWhich == "All" or (bosWhich == "1st + 2nd" and bosCntL <= 2) or (bosWhich == "1st only" and bosCntL == 1)
    bool _okDispL  = bosMinDispAtr <= 0 or (close - st.bull_bos_high) >= bosMinDispAtr * atr14
    bool _okLegL   = bosMinLegAtr  <= 0 or (st.bull_bos_high - st.bull_bos_low) >= bosMinLegAtr * atr14
    if _okWhichL and _okDispL and _okLegL
        bosL_high := st.bull_bos_high
        bosL_low  := st.bull_bos_low
        bosL_bar  := bar_index
        bosL_n    := bosCntL
        bosL_half := false
        bosL_on   := true

if bosFireS
    bosCntS := bosCntS + 1
    if bosS_on
        bosSwhy := "re-anchored — a newer BOS on this side took the setup"
    bosS_on := false
    bool _okWhichS = bosWhich == "All" or (bosWhich == "1st + 2nd" and bosCntS <= 2) or (bosWhich == "1st only" and bosCntS == 1)
    bool _okDispS  = bosMinDispAtr <= 0 or (st.bear_bos_low - close) >= bosMinDispAtr * atr14
    bool _okLegS   = bosMinLegAtr  <= 0 or (st.bear_bos_high - st.bear_bos_low) >= bosMinLegAtr * atr14
    if _okWhichS and _okDispS and _okLegS
        bosS_high := st.bear_bos_high
        bosS_low  := st.bear_bos_low
        bosS_bar  := bar_index
        bosS_n    := bosCntS
        bosS_half := false
        bosS_on   := true

// [doc 72] THE ANCHOR FIB — the leg the whole ladder is priced off  -> docs/mpc_bos_strategy.md
f_lvl(float ext, float org, float v) => ext + (org - ext) * v

bool bosExpAnchor = bosFibAnchor == "Expansion leg"

float lExt = bosExpAnchor ? (fibo_dir ==  1 ? fibo_ash : na) : bosL_high
float lOrg = bosExpAnchor ? (fibo_dir ==  1 ? fibo_asl : na) : bosL_low
float sExt = bosExpAnchor ? (fibo_dir == -1 ? fibo_asl : na) : bosS_low
float sOrg = bosExpAnchor ? (fibo_dir == -1 ? fibo_ash : na) : bosS_high

float lP118 = f_lvl(lExt, lOrg, 0.118)  // the 0.382-entry ladder's TP2 — no fib line draws it
float lP236 = f_lvl(lExt, lOrg, 0.236)  // the 0.5-entry ladder's TP2 — no fib line draws it
float lP1  = f_lvl(lExt, lOrg, 0.382)   // deep TP2 · the OPTIONAL shallow band ceiling
float lP2  = f_lvl(lExt, lOrg, 0.500)   // the DEFAULT band ceiling / deep TP1
float lP3  = f_lvl(lExt, lOrg, 0.618)   // E1 — the deep/standard boundary
float lP4  = f_lvl(lExt, lOrg, 0.702)
float lP5  = f_lvl(lExt, lOrg, 0.786)
float lP6  = f_lvl(lExt, lOrg, 0.886)   // the entry-band floor (deep end) — never moves
float lP7  = f_lvl(lExt, lOrg, 0.000)   // the leg extreme
float lP10 = f_lvl(lExt, lOrg, 1.000)   // the leg origin — the default stop
float sP118 = f_lvl(sExt, sOrg, 0.118)
float sP236 = f_lvl(sExt, sOrg, 0.236)
float sP1  = f_lvl(sExt, sOrg, 0.382)
float sP2  = f_lvl(sExt, sOrg, 0.500)
float sP3  = f_lvl(sExt, sOrg, 0.618)
float sP4  = f_lvl(sExt, sOrg, 0.702)
float sP5  = f_lvl(sExt, sOrg, 0.786)
float sP6  = f_lvl(sExt, sOrg, 0.886)
float sP7  = f_lvl(sExt, sOrg, 0.000)
float sP10 = f_lvl(sExt, sOrg, 1.000)

// [doc 73] THE SHALLOW END OF THE ENTRY BAND, in price. Every rule that used to har  -> docs/mpc_bos_strategy.md
bool  bosShallow = bosEntryTop == "0.382"
float lTop = bosShallow ? lP1 : lP2
float sTop = bosShallow ? sP1 : sP2

bool lFibsReady = not na(lP1) and not na(lP2) and not na(lP3) and not na(lP6) and not na(lP7) and not na(lP10) and lP7 > lP10
bool sFibsReady = not na(sP1) and not na(sP2) and not na(sP3) and not na(sP6) and not na(sP7) and not na(sP10) and sP10 > sP7

// [doc 74] DEATH — the arm is dropped, no trade  -> docs/mpc_bos_strategy.md
int BOS_MAX = int(math.max(1, math.round(bosMaxDays * 86400 / timeframe.in_seconds())))

if bosL_on
    if lFibsReady and low <= lTop
        bosL_half := true
    string _wL = ""
    if bosL_half and lFibsReady and high >= lP7
        _wL := "cycle complete — retraced, then came back to the leg extreme"
    else if lFibsReady and close < lP10
        _wL := "closed past the anchor's fib 1.0 (leg origin) — leg invalidated"
    else if bosReqHold and close < bosL_high
        _wL := "F4 — closed back through the broken swing"
    else if bar_index - bosL_bar > BOS_MAX
        _wL := "stale — the F9 day cap expired before the retrace arrived"
    if _wL != ""
        bosL_on := false
        bosLwhy := _wL
if bosS_on
    if sFibsReady and high >= sTop
        bosS_half := true
    string _wS = ""
    if bosS_half and sFibsReady and low <= sP7
        _wS := "cycle complete — retraced, then came back to the leg extreme"
    else if sFibsReady and close > sP10
        _wS := "closed past the anchor's fib 1.0 (leg origin) — leg invalidated"
    else if bosReqHold and close > bosS_low
        _wS := "F4 — closed back through the broken swing"
    else if bar_index - bosS_bar > BOS_MAX
        _wS := "stale — the F9 day cap expired before the retrace arrived"
    if _wS != ""
        bosS_on := false
        bosSwhy := _wS

// [doc 75] STAGE 3 — ENTRY: the A+ ladder, unchanged, on the BOS leg  -> docs/mpc_bos_strategy.md

float execSlBuf = execSlBufTk * syminfo.mintick

f_minStopFloor(float px) =>
    switch execMinStopMode
        "% of price" => px * execMinStopVal / 100.0
        "Fixed $"    => execMinStopVal
        "x ATR(14)"  => execMinStopVal * atr14
        => 0.0

// [doc 76] Position size = risk / stop distance, and it MUST be guarded on equity.  -> docs/mpc_bos_strategy.md
f_qty(float slDist) =>
    float eq = strategy.equity
    eq > 0 and slDist > 0 ? (eq * execRiskPct / 100.0) / slDist : na

// [doc 77] Method 3 — the entry price for a DEEP gap whose NEAR EDGE sits past 0.61  -> docs/mpc_bos_strategy.md
f_deepFibEdge(float _gB, float _gT, bool _bull, float p3, float p4, float p5) =>
    float _out = na
    if _bull and _gT < p3
        _out := _gT >= p4 ? p3 : _gT >= p5 ? p4 : p5
    if (not _bull) and _gB > p3
        _out := _gB <= p4 ? p3 : _gB <= p5 ? p4 : p5
    _out

float longEdge   = na
float shortEdge  = na
bool  longEdgeSz  = false
bool  shortEdgeSz = false
bool  longFvgOk   = false
bool  shortFvgOk  = false

// [doc 78] The chosen fib entry price, per side, CLAMPED to the band's shallow end   -> docs/mpc_bos_strategy.md
float lFibRaw = bosEntryFib == "0.382" ? lP1 : bosEntryFib == "0.5" ? lP2 : bosEntryFib == "0.702" ? lP4 : bosEntryFib == "0.786" ? lP5 : bosEntryFib == "0.886" ? lP6 : lP3
float sFibRaw = bosEntryFib == "0.382" ? sP1 : bosEntryFib == "0.5" ? sP2 : bosEntryFib == "0.702" ? sP4 : bosEntryFib == "0.786" ? sP5 : bosEntryFib == "0.886" ? sP6 : sP3
float lFibEntry = na(lFibRaw) or na(lTop) ? lFibRaw : math.min(lFibRaw, lTop)
float sFibEntry = na(sFibRaw) or na(sTop) ? sFibRaw : math.max(sFibRaw, sTop)

if bosUseFvg and array.size(fvgTops) > 0
    for _i = 0 to array.size(fvgTops) - 1
        float _gT = array.get(fvgTops, _i)
        float _gB = array.get(fvgBots, _i)
        bool  _gBull = array.get(fvgIsBull, _i)
        if bosL_on and lFibsReady and _gBull and _gB <= lTop and _gT >= lP6 and (not execFvgDeepOnly or _gT <= lTop)
            longFvgOk := true
            float _df = execDeepFib ? f_deepFibEdge(_gB, _gT, true, lP3, lP4, lP5) : na
            float _e  = na(_df) ? math.min(_gT, lTop) : _df
            longEdge := na(longEdge) ? _e : math.max(longEdge, _e)   // the one price reaches FIRST
        if bosS_on and sFibsReady and (not _gBull) and _gT >= sTop and _gB <= sP6 and (not execFvgDeepOnly or _gB >= sTop)
            shortFvgOk := true
            float _df = execDeepFib ? f_deepFibEdge(_gB, _gT, false, sP3, sP4, sP5) : na
            float _e  = na(_df) ? math.max(_gB, sTop) : _df
            shortEdge := na(shortEdge) ? _e : math.min(shortEdge, _e)

// [doc 79] Sniper Zone — the break leg's 0.382-0.5 pocket, re-anchored on every BOS  -> docs/mpc_bos_strategy.md
if bosUseFvg and execConfSZ2 and execConfSZ and not na(sniperZoneTop) and not na(sniperZoneBot) and not na(sz_bar)
    if na(longEdge) and bosL_on and lFibsReady and sz_bullish and not na(bosL_bar) and sz_bar >= bosL_bar
        float _e = math.min(sniperZoneBot, lTop)
        if _e >= lP6
            longEdge   := _e
            longEdgeSz := true
    if na(shortEdge) and bosS_on and sFibsReady and (not sz_bullish) and not na(bosS_bar) and sz_bar >= bosS_bar
        float _e = math.max(sniperZoneTop, sTop)
        if _e <= sP6
            shortEdge   := _e
            shortEdgeSz := true

// [doc 80] The least-favorable gap entry: a gap whose body STRADDLES the band's sha  -> docs/mpc_bos_strategy.md
if bosUseFvg and execFvg50 and array.size(fvgTops) > 0
    for _j = 0 to array.size(fvgTops) - 1
        float _gT = array.get(fvgTops, _j)
        float _gB = array.get(fvgBots, _j)
        bool  _gBull = array.get(fvgIsBull, _j)
        if na(longEdge)  and bosL_on and lFibsReady and _gBull       and _gB <= lTop and _gT >= lTop
            longEdge  := lTop
            longFvgOk := true
        if na(shortEdge) and bosS_on and sFibsReady and (not _gBull) and _gB <= sTop and _gT >= sTop
            shortEdge  := sTop
            shortFvgOk := true

// [doc 81] ── THE DEFAULT ENTRY — the plain fib level, last in the ladder so any en  -> docs/mpc_bos_strategy.md
if not (bosUseFvg and execReqFVG)
    if na(longEdge)  and bosL_on and lFibsReady
        longEdge  := lFibEntry
    if na(shortEdge) and bosS_on and sFibsReady
        shortEdge := sFibEntry

// [doc 82] GATES — the filters that refuse a ready setup  -> docs/mpc_bos_strategy.md
bool bosVetoL = showDiv and (bearDivActive or divRsi >= divExtremeOB)
bool bosVetoS = showDiv and (bullDivActive or divRsi <= divExtremeOS)

// F7 — final hour. Gold closes 17:00 NY and reopens 18:00.
bool lateDayBlock = execNoLateDay and nyHour >= 16 and nyHour < 18

// F8 — HTF bias, Daily + Weekly working together. Returns TRUE = this TF blocks.
f_htfReqBlock(string req, string state, bool isLong) =>
    bool agreeDir  = isLong ? (state == "Bullish") : (state == "Bearish")
    bool opposeDir = isLong ? (state == "Bearish") : (state == "Bullish")
    req == "Must agree"              ? not agreeDir  :
     req == "Must not oppose"        ? opposeDir     :
     req == "Must oppose (reversal)" ? not opposeDir : false

bool htfBiasBlockLong  = f_htfReqBlock(execHtfWeekly, wEstState, true)  or f_htfReqBlock(execHtfDaily, dEstState, true)
bool htfBiasBlockShort = f_htfReqBlock(execHtfWeekly, wEstState, false) or f_htfReqBlock(execHtfDaily, dEstState, false)

// [doc 83] F10 — SESSION VWAP, the pro-trend side. Added 2026-08-06.  -> docs/mpc_bos_strategy.md
float bosVwap = ta.vwap(hlc3)

// [doc 84] ⚠ A `na` VWAP (no volume yet on the session's first bar) returns FALSE,   -> docs/mpc_bos_strategy.md
f_bosVwapOk(bool isLong) =>
    na(bosVwap) ? false : (isLong ? close > bosVwap : close < bosVwap)

bool vwapBlockLong  = bosVwapReq != "Off" and not f_bosVwapOk(true)
bool vwapBlockShort = bosVwapReq != "Off" and not f_bosVwapOk(false)

// [doc 85] ⚠ The line BREAKS at each trading-day anchor on its own — ta.vwap return  -> docs/mpc_bos_strategy.md
plot(bosVwapReq != "Off" ? bosVwap : na, title = "Session VWAP", color = color.new(#00E5FF, 25), linewidth = 1)

// [doc 86] ORDERS  -> docs/mpc_bos_strategy.md
var int   tradedBosL = na, var int  tradedBosS = na   // one trade per BOS leg
var int   pendBosL   = na, var int  pendBosS   = na
var int   pendOrdL   = 0,  var int  pendOrdS   = 0    // the BOS ordinal of the resting order
var float lSL = na, var float lTP1 = na, var float lTP2 = na, var float lTP3 = na
var float sSL = na, var float sTP1 = na, var float sTP2 = na, var float sTP3 = na
var float lEntry = na, var float sEntry = na
var float lMaxFav = na, var float sMaxFav = na
var int   lEntryBar = na, var int sEntryBar = na   // the fill bar — the moving stop stays dead on it
var int   lStage = 0,   var int   sStage = 0
var int   lOrd = 0,     var int   sOrd = 0            // the BOS ordinal of the OPEN trade
var float openRiskUsd = na
var float netAtEntry  = na
var string pendConfL = "", var string pendConfS = ""

// [doc 87] Stop anchor per the model dropdown, buffer applied outside. Split in two  -> docs/mpc_bos_strategy.md
f_bosSlRaw(bool isLong, float entryPx, float p6, float p10, float brokenLvl) =>
    switch bosSlModel
        "Broken swing level"   => brokenLvl
        "Fib 0.886"            => p6
        "Last confirmed swing" => isLong ? st.last_conf_low : st.last_conf_high
        "ATR"                  => isLong ? entryPx - bosSlAtr * atr14 : entryPx + bosSlAtr * atr14
        => p10

f_bosSl(bool isLong, float entryPx, float p6, float p10, float brokenLvl) =>
    float a = f_bosSlRaw(isLong, entryPx, p6, p10, brokenLvl)
    isLong ? a - execSlBuf : a + execSlBuf

// [doc 88] Entry DEPTH is derived from where the limit actually landed, never chose  -> docs/mpc_bos_strategy.md
int longTier  = na(longEdge)  ? 1 : longEdge  <= lP3 ? 2 : longEdge  > lP2 ? 0 : 1
int shortTier = na(shortEdge) ? 1 : shortEdge >= sP3 ? 2 : shortEdge < sP2 ? 0 : 1

// [doc 89] ⚠ `vwapBlock*` is re-read on every bar the limit rests, exactly like the  -> docs/mpc_bos_strategy.md
bool longArmed  = execLongs  and bosL_on and lFibsReady and not na(longEdge)  and not lateDayBlock and not htfBiasBlockLong  and not vwapBlockLong  and (not bosVetoL or not bosRespectVeto) and bosTrdL < bosMaxPerRegime and strategy.position_size == 0 and (na(tradedBosL) or bosL_bar != tradedBosL)
bool shortArmed = execShorts and bosS_on and sFibsReady and not na(shortEdge) and not lateDayBlock and not htfBiasBlockShort and not vwapBlockShort and (not bosVetoS or not bosRespectVeto) and bosTrdS < bosMaxPerRegime and strategy.position_size == 0 and (na(tradedBosS) or bosS_bar != tradedBosS)

// One label per trade, and the BOS ORDINAL is on it — that is what makes the F1
// cutoff readable straight off the run instead of guessed at.
f_conf(bool isLong, int ord, int bosAge, bool fvg, bool sz, bool liveDiv, int tier, float edgePx, float slPx, float tp1Px, float tp2Px, float tp3Px) =>
    string s = "──────────────"
    s := s + "\nArm     BOS #" + str.tostring(ord) + (ord == 1 ? " (expansion)" : " (continuation)")
    s := s + "\nBOS     " + str.tostring(bosAge) + " bars ago"
    s := s + "\nZone    " + (sz ? "Sniper Zone (no FVG)" : fvg ? "FVG ✓" : "fib only")
    s := s + "\nDiv     " + (liveDiv ? "live ✓" : "–")
    s := s + "\n──────────────"
    s := s + "\nEntry   " + (tier == 2 ? "0.618+ deep " : tier == 1 ? "0.5 standard" : "0.382 shallow") + "  " + str.tostring(edgePx, format.mintick)
    s := s + "\nStop    " + bosSlModel + "   " + str.tostring(slPx, format.mintick)
    s := s + "\nTP1     fib " + (tier == 2 ? "0.5" : tier == 1 ? "0.382" : "0.236") + "     " + str.tostring(tp1Px, format.mintick)
    s := s + "\nTP2     fib " + (tier == 2 ? "0.382" : tier == 1 ? "0.236" : "0.118") + "   " + str.tostring(tp2Px, format.mintick)
    s := s + "\nTP3     " + (bosTp3Measured ? "measured move" : "fib 0.0    ") + "  " + str.tostring(tp3Px, format.mintick)
    s := s + "\nRunner  what is left · trailing stop"
    s

// ── Long: rest / refresh a buy-limit at the edge (cancel when disarmed) ──
if longArmed
    lSL := f_bosSl(true, longEdge, lP6, lP10, bosL_high)
    float slDist = longEdge - lSL
    // [doc 90] TP3 is ALWAYS fib 0.000 — the leg extreme, the level the External Fib  -> docs/mpc_bos_strategy.md
    lTP1 := longTier == 2 ? lP2 : longTier == 1 ? lP1   : lP236
    lTP2 := longTier == 2 ? lP1 : longTier == 1 ? lP236 : lP118
    lTP3 := lP7
    if bosTp3Measured
        float _m = bosL_high + (bosL_high - bosL_low)
        lTP3 := _m > lTP2 ? _m : lTP3
    float qty = f_qty(slDist)
    if not na(qty) and qty > 0 and slDist >= f_minStopFloor(longEdge)
        pendBosL := bosL_bar
        pendOrdL := bosL_n
        pendConfL := f_conf(true, bosL_n, bar_index - bosL_bar, longFvgOk, longEdgeSz, bearDivActive, longTier, longEdge, lSL, lTP1, lTP2, lTP3)
        strategy.entry("Long", strategy.long, qty = qty, limit = longEdge)
    else
        strategy.cancel("Long")
else if strategy.position_size == 0
    strategy.cancel("Long")

// ── Short: rest / refresh a sell-limit at the edge ──
if shortArmed
    sSL := f_bosSl(false, shortEdge, sP6, sP10, bosS_low)
    float slDist = sSL - shortEdge
    sTP1 := shortTier == 2 ? sP2 : shortTier == 1 ? sP1   : sP236
    sTP2 := shortTier == 2 ? sP1 : shortTier == 1 ? sP236 : sP118
    sTP3 := sP7
    if bosTp3Measured
        float _m = bosS_low - (bosS_high - bosS_low)
        sTP3 := _m < sTP2 ? _m : sTP3
    float qty = f_qty(slDist)
    if not na(qty) and qty > 0 and slDist >= f_minStopFloor(shortEdge)
        pendBosS := bosS_bar
        pendOrdS := bosS_n
        pendConfS := f_conf(false, bosS_n, bar_index - bosS_bar, shortFvgOk, shortEdgeSz, bullDivActive, shortTier, shortEdge, sSL, sTP1, sTP2, sTP3)
        strategy.entry("Short", strategy.short, qty = qty, limit = shortEdge)
    else
        strategy.cancel("Short")
else if strategy.position_size == 0
    strategy.cancel("Short")

// [doc 91] BLOCKED-TRADE MARKER  -> docs/mpc_bos_strategy.md

color BLK_PINK  = color.new(#FF2E9A, 12)
color BLK_PINKL = color.new(#FF2E9A, 0)

// [doc 92] Reason PRECEDENCE — the first rule that would refuse the order is the on  -> docs/mpc_bos_strategy.md
f_blkCode(bool dirOff, bool late, bool veto, bool htfBias, bool vwap, bool capped, bool tight) =>
    dirOff ? 1 : late ? 2 : veto ? 3 : htfBias ? 4 : vwap ? 7 : capped ? 5 : tight ? 6 : 0

f_blkWhy(int c) =>
    switch c
        1 => "'Trade longs' / 'Trade shorts' is OFF for this side."
        2 => "Final-hour rule — no new entries 16:00-18:00 New York, ahead of the daily close."
        3 => "Divergence KILL — an opposing divergence is live, or RSI is at an extreme. For a continuation that is the fakeout signature."
        4 => "HTF bias requirement — your Weekly / Daily bias gate is not satisfied."
        5 => "Max trades per regime reached — standing down until the next SOS."
        6 => "Minimum stop distance — the stop sits closer to the entry than your floor, so this position would be oversized and noise-sensitive."
        7 => "Session VWAP — price is not closing on the trend's own side of the line. Re-checked every bar, so this setup can still arm if price closes back across before the leg dies."
        => ""

// Trailing `int _blkDone = 0` stops the drawing chain becoming the function's
// return expression (CE10235).
f_blkTag(array<int> ks, int slot, bool isLong, bool ready, int code, int bosBar, float edge, float y) =>
    if showBlockTag and ready and code != 0 and not na(bosBar) and not na(edge)
        int key = bosBar * 10 + code
        if key != array.get(ks, slot)
            array.set(ks, slot, key)
            line.new(bar_index, edge, bar_index, y, color = BLK_PINKL, style = line.style_dotted, width = 1)
            label.new(bar_index, y, (isLong ? "▲" : "▼") + " TRADE BLOCKED", tooltip = (isLong ? "▲ LONG" : "▼ SHORT") + " blocked\n──────────────────\n" + f_blkWhy(code) + "\n──────────────────\nBOS #" + str.tostring(isLong ? bosL_n : bosS_n) + " · limit would have rested at " + str.tostring(edge, format.mintick), color = BLK_PINK, textcolor = color.new(#101014, 0), style = isLong ? label.style_label_up : label.style_label_down, size = size.small)
    int _blkDone = 0

var array<int> blkKeys = array.from(-1, -1)

float _tagAtr = atr14
float _tagLo  = ta.lowest(low, 60)  - _tagAtr * 4
float _tagHi  = ta.highest(high, 60) + _tagAtr * 4

// "Ready" deliberately omits every toggle gate — those ARE the blockers we report.
bool lBlkReady = bosL_on and lFibsReady and not na(longEdge)  and strategy.position_size == 0 and (na(tradedBosL) or bosL_bar != tradedBosL)
bool sBlkReady = bosS_on and sFibsReady and not na(shortEdge) and strategy.position_size == 0 and (na(tradedBosS) or bosS_bar != tradedBosS)
float lBlkDist = na(longEdge)  ? na : longEdge - f_bosSl(true,  longEdge,  lP6, lP10, bosL_high)
float sBlkDist = na(shortEdge) ? na : f_bosSl(false, shortEdge, sP6, sP10, bosS_low) - shortEdge
bool  lBlkTight = not na(lBlkDist) and lBlkDist > 0 and lBlkDist < f_minStopFloor(longEdge)
bool  sBlkTight = not na(sBlkDist) and sBlkDist > 0 and sBlkDist < f_minStopFloor(shortEdge)
int   lBlkCode = f_blkCode(not execLongs,  lateDayBlock, bosVetoL and bosRespectVeto, htfBiasBlockLong,  vwapBlockLong,  bosTrdL >= bosMaxPerRegime, lBlkTight)
int   sBlkCode = f_blkCode(not execShorts, lateDayBlock, bosVetoS and bosRespectVeto, htfBiasBlockShort, vwapBlockShort, bosTrdS >= bosMaxPerRegime, sBlkTight)

f_blkTag(blkKeys, 0, true,  lBlkReady, lBlkCode, bosL_bar, longEdge,  _tagLo)
f_blkTag(blkKeys, 1, false, sBlkReady, sBlkCode, bosS_bar, shortEdge, _tagHi)

// [doc 93] FILL — mark the leg traded, freeze the trade's yardsticks  -> docs/mpc_bos_strategy.md
float _cOff = atr14 * execLabelOff

type TradeLbl
    label  lb   = na
    line   ln   = na
    string head = ""
    string body = ""
var TradeLbl tlbl = TradeLbl.new()

f_confOpen(TradeLbl t, int dir, float px, float off, string body, bool showIt) =>
    if execShowConfLabel and showIt
        float ly = dir > 0 ? px - off : px + off
        t.head := dir > 0 ? "▲ LONG" : "▼ SHORT"
        t.body := body
        t.ln   := line.new(bar_index, px, bar_index, ly, color = color.new(#787B86, 0), width = 1)
        t.lb   := label.new(bar_index, ly, t.head, tooltip = t.head + "\n" + body, color = color.new(#787B86, 12), textcolor = color.new(#101014, 0), style = dir > 0 ? label.style_label_up : label.style_label_down, size = size.small)

// [doc 94] On the bar the trade closes: recolour by RESULT and append the R. Green   -> docs/mpc_bos_strategy.md
f_confClose(TradeLbl t, float tradeR, float band) =>
    if not na(t.lb)
        bool   be   = math.abs(tradeR) <= band
        bool   won  = not be and tradeR > 0
        string res  = be ? "BREAKEVEN" : won ? "WIN" : "LOSS"
        bool   keep = execLabelWhich == "All" or (execLabelWhich == "Wins only" and won) or (execLabelWhich == "Losses only" and not won and not be) or (execLabelWhich == "Losses + breakevens" and not won)
        if keep
            string line1 = t.head + "  ·  " + res + "  " + (tradeR >= 0 ? "+" : "") + str.tostring(tradeR, "#.##") + "R"
            label.set_text(t.lb, line1)
            label.set_tooltip(t.lb, line1 + "\n" + t.body)
            label.set_color(t.lb, be ? color.new(#FF9800, 12) : won ? color.new(#26A69A, 12) : color.new(#EF5350, 12))
            line.set_color(t.ln, be ? color.new(#FF9800, 0) : won ? color.new(#26A69A, 0) : color.new(#EF5350, 0))
        else
            label.delete(t.lb)
            line.delete(t.ln)
        t.lb := na
        t.ln := na

if strategy.position_size > 0 and strategy.position_size[1] <= 0
    tradedBosL := pendBosL
    bosTrdL    := bosTrdL + 1
    lOrd       := pendOrdL
    lEntry     := strategy.position_avg_price
    lStage     := 0
    lMaxFav    := lEntry
    lEntryBar  := bar_index
    openRiskUsd := math.abs(strategy.position_size) * (lEntry - lSL)
    netAtEntry  := strategy.netprofit
    f_confOpen(tlbl, 1, lEntry, _cOff, pendConfL, execLabelWhich != "None")
if strategy.position_size < 0 and strategy.position_size[1] >= 0
    tradedBosS := pendBosS
    bosTrdS    := bosTrdS + 1
    sOrd       := pendOrdS
    sEntry     := strategy.position_avg_price
    sStage     := 0
    sMaxFav    := sEntry
    sEntryBar  := bar_index
    openRiskUsd := math.abs(strategy.position_size) * (sSL - sEntry)
    netAtEntry  := strategy.netprofit
    f_confOpen(tlbl, -1, sEntry, _cOff, pendConfS, execLabelWhich != "None")
if strategy.position_size == 0
    lStage := 0
    sStage := 0

float closedR = strategy.position_size == 0 and strategy.position_size[1] != 0 and not na(openRiskUsd) and openRiskUsd > 0 ? (strategy.netprofit - netAtEntry) / openRiskUsd : na
if not na(closedR)
    f_confClose(tlbl, closedR, execBeBandR)
    openRiskUsd := na

// [doc 95] POSITION BOX — the trade drawn as stacked bands  -> docs/mpc_bos_strategy.md
type PosBox
    box   bx       = na
    int   dir      = 0
    int   entryBar = na
    float entry    = na
    float sl       = na
    float t1       = na
    float openNet  = na
    int   seen     = 0
    int   fills    = 0
    float f1       = na
    float f2       = na
    float f3       = na
    float worst    = na
    float lastFill = na
var PosBox pbx = PosBox.new()

color POS_RED    = color.new(#EF5350, 62)
color POS_OPEN   = color.new(#787B86, 80)
color POS_ORANGE = color.new(#FF9800, 0)
color POS_GREENB = color.new(#26A69A, 0)
color POS_REDB   = color.new(#EF5350, 0)
color POS_G1     = color.new(#26A69A, 55)
color POS_G2     = color.new(#26A69A, 70)
color POS_G3     = color.new(#26A69A, 82)
color POS_DD     = color.new(#EF5350, 88)
color TP_ANNOT   = color.new(#26A69A, 40)

f_tpBand(int x1, int x2, int lx, float yA, float yB, color c, string tag) =>
    box.new(x1, math.max(yA, yB), x2, math.min(yA, yB), bgcolor = c, border_color = color(na))
    if execShowExitLines
        line.new(x1, yB, lx, yB, color = TP_ANNOT, style = line.style_dashed, width = 1)
        label.new(lx, yB, " " + tag, color = color(na), textcolor = TP_ANNOT, style = label.style_label_left, size = size.small)

f_posBox(PosBox p, float lE, float sE, float lS, float sS, float l1, float s1) =>
    if execShowPosBox
        if strategy.position_size != 0 and strategy.position_size[1] == 0
            p.dir      := strategy.position_size > 0 ? 1 : -1
            p.entryBar := bar_index
            p.entry    := p.dir > 0 ? lE : sE
            p.sl       := p.dir > 0 ? lS : sS
            p.t1       := p.dir > 0 ? l1 : s1
            p.openNet  := strategy.netprofit
            p.lastFill := na
            p.f1       := na
            p.f2       := na
            p.f3       := na
            p.fills    := 0
            p.worst    := p.dir > 0 ? low : high
            p.bx       := box.new(bar_index, math.max(p.entry, close), bar_index, math.min(p.entry, close), bgcolor = POS_OPEN, border_color = color.new(#787B86, 0), border_width = 1)
        if strategy.closedtrades > p.seen
            for i = p.seen to strategy.closedtrades - 1
                float xPx  = strategy.closedtrades.exit_price(i)
                int   xDir = strategy.closedtrades.size(i) > 0 ? 1 : -1
                if not na(p.t1) and (xDir > 0 ? xPx >= p.t1 : xPx <= p.t1)
                    p.fills := p.fills + 1
                    if p.fills == 1
                        p.f1 := xPx
                    else if p.fills == 2
                        p.f2 := xPx
                    else
                        p.f3 := xPx
                p.lastFill := xPx
            p.seen := strategy.closedtrades
        if strategy.position_size != 0 and not na(p.bx)
            p.worst := p.dir > 0 ? math.min(p.worst, low) : math.max(p.worst, high)
            box.set_right(p.bx, bar_index)
            box.set_top(p.bx, math.max(p.entry, close))
            box.set_bottom(p.bx, math.min(p.entry, close))
        if strategy.position_size == 0 and strategy.position_size[1] != 0 and not na(p.bx)
            box.delete(p.bx)
            p.bx := na
            int   xr  = bar_index
            int   lx  = xr + 4
            float net = strategy.netprofit - p.openNet
            if p.dir > 0 ? p.worst < p.entry : p.worst > p.entry
                box.new(p.entryBar, math.max(p.entry, p.worst), xr, math.min(p.entry, p.worst), bgcolor = POS_DD, border_color = color(na))
            if not na(p.f1)
                f_tpBand(p.entryBar, xr, lx, p.entry, p.f1, POS_G1, "TP1")
                if not na(p.f2)
                    f_tpBand(p.entryBar, xr, lx, p.f1, p.f2, POS_G2, "TP2")
                if not na(p.f3)
                    f_tpBand(p.entryBar, xr, lx, p.f2, p.f3, POS_G3, "TP3")
            else if net < 0
                float redTo = na(p.lastFill) ? p.sl : p.lastFill
                box.new(p.entryBar, math.max(p.entry, redTo), xr, math.min(p.entry, redTo), bgcolor = POS_RED, border_color = POS_REDB)
            else
                line.new(p.entryBar, p.entry, xr, p.entry, color = POS_ORANGE, width = 2)
        // [doc 96] A function's LAST statement is its return value, and the three branches  -> docs/mpc_bos_strategy.md
        int _pbDone = 0

f_posBox(pbx, lEntry, sEntry, lSL, sSL, lTP1, sTP1)

plotshape(execShowPosBox and strategy.position_size > 0 and strategy.position_size[1] <= 0, title = "Long entry",  style = shape.triangleup,   location = location.belowbar, color = POS_GREENB, size = size.small)
plotshape(execShowPosBox and strategy.position_size < 0 and strategy.position_size[1] >= 0, title = "Short entry", style = shape.triangledown, location = location.abovebar, color = POS_REDB,   size = size.small)

// [doc 97] EXITS — the shared ladder, unchanged  -> docs/mpc_bos_strategy.md
float beBuf     = execBeBufTk * syminfo.mintick
float trailStep = execTrailStep

f_trail(float maxFav, float tp2, int dir) =>
    float run = dir > 0 ? maxFav - tp2 : tp2 - maxFav
    float out = na
    if not na(run) and run >= trailStep
        float steps = math.floor((run - trailStep) / trailStep)
        out := dir > 0 ? tp2 + steps * trailStep : tp2 - steps * trailStep
    out

// [doc 98] ── The FILL bar cannot stage the stop (BUG_exit_fill_price_mismatch.md)   -> docs/mpc_bos_strategy.md
if strategy.position_size > 0 and strategy.position_size[1] > 0
    lMaxFav := na(lMaxFav) ? high : math.max(lMaxFav, high)
    if lStage < 1 and high >= lTP1
        lStage := 1
    if lStage < 2 and high >= lTP2
        lStage := 2
if strategy.position_size < 0 and strategy.position_size[1] < 0
    sMaxFav := na(sMaxFav) ? low : math.min(sMaxFav, low)
    if sStage < 1 and low <= sTP1
        sStage := 1
    if sStage < 2 and low <= sTP2
        sStage := 2

// [doc 99] ── the MOVING stop ─────────────────────────────────────────────────────  -> docs/mpc_bos_strategy.md
f_moveStop(bool isLong, float maxFav, int entryBar) =>
    float out = na
    if execMoveStop != "Off" and not na(entryBar) and bar_index > entryBar and not na(maxFav)
        if execMoveStop == "$ of price"
            out := isLong ? maxFav - execMoveStopVal : maxFav + execMoveStopVal
        else
            float sw = isLong ? st.last_conf_low : st.last_conf_high
            float bf = execMoveStopVal * syminfo.mintick
            out := na(sw) ? na : (isLong ? sw - bf : sw + bf)
    out

float lMove = f_moveStop(true,  lMaxFav, lEntryBar)
float sMove = f_moveStop(false, sMaxFav, sEntryBar)

float structBuf = execStructTrailBufTk * syminfo.mintick
bool  useStructTrail = execRunnerTrail == "Structure (swing)"
float lTrail = lStage >= 2 ? (useStructTrail ? (not na(st.last_conf_low)  ? st.last_conf_low  - structBuf : na) : f_trail(lMaxFav, lTP2, 1))  : na
float sTrail = sStage >= 2 ? (useStructTrail ? (not na(st.last_conf_high) ? st.last_conf_high + structBuf : na) : f_trail(sMaxFav, sTP2, -1)) : na

float lStage2Floor = execTp2StopMode == "Breakeven" ? lEntry + beBuf : execTp2StopMode == "One trail step behind" ? math.max(lEntry + beBuf, lMaxFav - trailStep) : lTP1
float sStage2Floor = execTp2StopMode == "Breakeven" ? sEntry - beBuf : execTp2StopMode == "One trail step behind" ? math.min(sEntry - beBuf, sMaxFav + trailStep) : sTP1

float lStopBase = lStage >= 2 ? (na(lTrail) ? lStage2Floor : math.max(lStage2Floor, lTrail)) : lStage >= 1 ? lEntry + beBuf : lSL
float sStopBase = sStage >= 2 ? (na(sTrail) ? sStage2Floor : math.min(sStage2Floor, sTrail)) : sStage >= 1 ? sEntry - beBuf : sSL

// The moving stop only ever tightens what the ladder already set.
float lStop = na(lMove) or na(lStopBase) ? lStopBase : math.max(lStopBase, lMove)
float sStop = na(sMove) or na(sStopBase) ? sStopBase : math.min(sStopBase, sMove)

// [doc 100] A rung sized 0% is SKIPPED, never placed. strategy.exit() treats qty_per  -> docs/mpc_bos_strategy.md
if strategy.position_size > 0
    if execTp1Pct > 0
        strategy.exit("L-TP1", from_entry = "Long", qty_percent = execTp1Pct, limit = lTP1, stop = lStop)
    if execTp2Pct > 0
        strategy.exit("L-TP2", from_entry = "Long", qty_percent = execTp2Pct, limit = lTP2, stop = lStop)
    if execTp3Pct > 0 and not na(lTP3)
        strategy.exit("L-TP3", from_entry = "Long", qty_percent = execTp3Pct, limit = lTP3, stop = lStop)
    strategy.exit("L-RUN", from_entry = "Long", stop = lStop)
    // [doc 101] §4a — the divergence KILL on an OPEN trade. An opposing divergence means  -> docs/mpc_bos_strategy.md
    if bosCloseOppDiv and showDiv and bearDivActive
        strategy.close("Long", comment = "opp div")

if strategy.position_size < 0
    if execTp1Pct > 0
        strategy.exit("S-TP1", from_entry = "Short", qty_percent = execTp1Pct, limit = sTP1, stop = sStop)
    if execTp2Pct > 0
        strategy.exit("S-TP2", from_entry = "Short", qty_percent = execTp2Pct, limit = sTP2, stop = sStop)
    if execTp3Pct > 0 and not na(sTP3)
        strategy.exit("S-TP3", from_entry = "Short", qty_percent = execTp3Pct, limit = sTP3, stop = sStop)
    strategy.exit("S-RUN", from_entry = "Short", stop = sStop)
    if bosCloseOppDiv and showDiv and bullDivActive
        strategy.close("Short", comment = "opp div")

// [doc 102] cat /tmp/blk >> <export>  -> docs/mpc_bos_strategy.md

color _INV = color.new(color.gray, 100)   // transparent — in the CSV, invisible on the chart

// [doc 103] ── STRUCTURE + ARM STATE ───────────────────────────────────────────────  -> docs/mpc_bos_strategy.md
plot((st.bull_bos ? 1 : 0) + (st.bear_bos ? 2 : 0) + (st.bull_sos ? 4 : 0) + (st.bear_sos ? 8 : 0) + (sessionGapBar ? 16 : 0) + (bosFireL ? 32 : 0) + (bosFireS ? 64 : 0), "px_struct", _INV, editable = false)
plot((bosL_on ? 1 : 0) + (bosS_on ? 2 : 0) + (bosRegL ? 4 : 0) + (bosRegS ? 8 : 0) + (longArmed ? 16 : 0) + (shortArmed ? 32 : 0) + (strategy.position_size > 0 ? 64 : 0) + (strategy.position_size < 0 ? 128 : 0) + (strategy.position_size != 0 and strategy.position_size[1] == 0 ? 256 : 0) + (strategy.position_size == 0 and strategy.position_size[1] != 0 ? 512 : 0), "px_arm", _INV, editable = false)

plot(bosL_n,   "px_ord_l", _INV, editable = false)   // the armed leg's BOS ordinal since the SOS
plot(bosS_n,   "px_ord_s", _INV, editable = false)

// The FROZEN break leg, per side. This is what `bosFibAnchor = "Break leg"` prices off.
plot(bosL_high, "px_leg_l_hi", _INV, editable = false)
plot(bosL_low,  "px_leg_l_lo", _INV, editable = false)
plot(bosS_high, "px_leg_s_hi", _INV, editable = false)
plot(bosS_low,  "px_leg_s_lo", _INV, editable = false)

// [doc 104] AGE, never the raw bar index — see the warning at the top of this block.  -> docs/mpc_bos_strategy.md
float _ageL = na
if bosL_on and not na(bosL_bar)
    _ageL := bar_index - bosL_bar
float _ageS = na
if bosS_on and not na(bosS_bar)
    _ageS := bar_index - bosS_bar
plot(_ageL, "px_age_l", _INV, editable = false)
plot(_ageS, "px_age_s", _INV, editable = false)

// [doc 105] ── THE ANCHOR — four numbers that regenerate every level ───────────────  -> docs/mpc_bos_strategy.md
plot(lExt, "px_l_ext", _INV, editable = false)
plot(lOrg, "px_l_org", _INV, editable = false)
plot(sExt, "px_s_ext", _INV, editable = false)
plot(sOrg, "px_s_org", _INV, editable = false)
plot((lFibsReady ? 1 : 0) + (sFibsReady ? 2 : 0) + (bosL_half ? 4 : 0) + (bosS_half ? 8 : 0), "px_ready", _INV, editable = false)

// ── THE ENTRY LADDER — what it chose and what priced it ──────────────────────
//   px_src  1 longFvgOk · 2 longEdgeSz · 4 shortFvgOk · 8 shortEdgeSz
plot(longEdge,  "px_edge_l", _INV, editable = false)
plot(shortEdge, "px_edge_s", _INV, editable = false)
plot(longTier,  "px_tier_l", _INV, editable = false)
plot(shortTier, "px_tier_s", _INV, editable = false)
plot((longFvgOk ? 1 : 0) + (longEdgeSz ? 2 : 0) + (shortFvgOk ? 4 : 0) + (shortEdgeSz ? 8 : 0), "px_src", _INV, editable = false)
plot(array.size(fvgTops), "px_fvg_n", _INV, editable = false)   // live gap count — the cap and the EQ exemption both move it

// [doc 106] ── THE GATES — why a ready setup was refused ───────────────────────────  -> docs/mpc_bos_strategy.md
plot(lBlkCode, "px_blk_l", _INV, editable = false)
plot(sBlkCode, "px_blk_s", _INV, editable = false)
plot((lateDayBlock ? 1 : 0) + (htfBiasBlockLong ? 2 : 0) + (htfBiasBlockShort ? 4 : 0) + (vwapBlockLong ? 8 : 0) + (vwapBlockShort ? 16 : 0) + (bosVetoL ? 32 : 0) + (bosVetoS ? 64 : 0) + (lBlkReady ? 128 : 0) + (sBlkReady ? 256 : 0), "px_gate", _INV, editable = false)

// ── CONTEXT the gates read ───────────────────────────────────────────────────
plot(bosVwap, "px_vwap",  _INV, editable = false)
plot(atr14,   "px_atr14", _INV, editable = false)
// [doc 107] ⚠ THE VOLUME IS PLOTTED, NOT ASSUMED, and this file shipped without it b  -> docs/mpc_bos_strategy.md
plot(volume,  "px_volume", _INV, editable = false)

// [doc 108] ── THE TRADE ───────────────────────────────────────────────────────────  -> docs/mpc_bos_strategy.md
plot(strategy.position_size != 0 ? (strategy.position_size > 0 ? lEntry : sEntry) : na, "px_fill", _INV, editable = false)
plot(strategy.position_size != 0 ? (strategy.position_size > 0 ? lSL  : sSL)  : na, "px_sl",  _INV, editable = false)
plot(strategy.position_size != 0 ? (strategy.position_size > 0 ? lTP1 : sTP1) : na, "px_tp1", _INV, editable = false)
plot(strategy.position_size != 0 ? (strategy.position_size > 0 ? lTP2 : sTP2) : na, "px_tp2", _INV, editable = false)
plot(strategy.position_size != 0 ? (strategy.position_size > 0 ? lTP3 : sTP3) : na, "px_tp3", _INV, editable = false)
plot(strategy.position_size != 0 ? (strategy.position_size > 0 ? lStop : sStop) : na, "px_stop_live", _INV, editable = false)
// ⚠ Same int-against-na trap as the ages above: lStage/sStage are ints.
float _stg = na
if strategy.position_size != 0
    _stg := strategy.position_size > 0 ? lStage : sStage
plot(_stg, "px_stage", _INV, editable = false)
plot(closedR, "px_closed_r", _INV, editable = false)

// [doc 109] ── CONFIG — the run describes ITSELF, which is what stops a green gate l  -> docs/mpc_bos_strategy.md
plot((execLongs ? 1 : 0) + (execShorts ? 2 : 0) + (bosUseFvg ? 4 : 0) + (execReqFVG ? 8 : 0) + (execFvgDeepOnly ? 16 : 0) + (execDeepFib ? 32 : 0) + (execConfSZ2 ? 64 : 0) + (execFvg50 ? 128 : 0) + (bosReqHold ? 256 : 0) + (bosRespectVeto ? 512 : 0) + (execNoLateDay ? 1024 : 0) + (bosTp3Measured ? 2048 : 0) + (bosCloseOppDiv ? 4096 : 0) + (fvgRequireClose ? 8192 : 0) + (fvgKeepUntilBroken ? 16384 : 0) + (eqExemptFvg ? 32768 : 0) + (bosShallow ? 65536 : 0) + (bosExpAnchor ? 131072 : 0) + (bosVwapReq != "Off" ? 262144 : 0) + (useStructTrail ? 524288 : 0), "cfg_bits", _INV, editable = false)

// [doc 110] Enums packed as DECIMAL DIGITS, each field < 10, so decoding is division  -> docs/mpc_bos_strategy.md
plot((bosEntryFib == "0.382" ? 0 : bosEntryFib == "0.5" ? 1 : bosEntryFib == "0.618" ? 2 : bosEntryFib == "0.702" ? 3 : bosEntryFib == "0.786" ? 4 : 5)
   + 10 * (bosWhich == "1st only" ? 0 : bosWhich == "1st + 2nd" ? 1 : 2)
   + 100 * (bosSlModel == "Fib 1.0 (leg origin)" ? 0 : bosSlModel == "Broken swing level" ? 1 : bosSlModel == "Fib 0.886" ? 2 : bosSlModel == "Last confirmed swing" ? 3 : 4)
   + 1000 * (execMinStopMode == "Off" ? 0 : execMinStopMode == "% of price" ? 1 : execMinStopMode == "Fixed $" ? 2 : 3)
   + 10000 * (execMoveStop == "Off" ? 0 : execMoveStop == "$ of price" ? 1 : 2), "cfg_enum1", _INV, editable = false)
plot((execTp2StopMode == "TP1 price" ? 0 : execTp2StopMode == "Breakeven" ? 1 : 2)
   + 10 * (execHtfWeekly == "Ignore" ? 0 : execHtfWeekly == "Must agree" ? 1 : execHtfWeekly == "Must not oppose" ? 2 : 3)
   + 100 * (execHtfDaily == "Ignore" ? 0 : execHtfDaily == "Must agree" ? 1 : execHtfDaily == "Must not oppose" ? 2 : 3), "cfg_enum2", _INV, editable = false)

plot(bosMinDispAtr,        "cfg_min_disp",      _INV, editable = false)
plot(bosMinLegAtr,         "cfg_min_leg",       _INV, editable = false)
plot(bosMaxDays,           "cfg_max_days",      _INV, editable = false)
plot(bosMaxPerRegime,      "cfg_max_regime",    _INV, editable = false)
plot(bosSlAtr,             "cfg_sl_atr",        _INV, editable = false)
plot(execSlBufTk,          "cfg_sl_buf",        _INV, editable = false)
plot(execMinStopVal,       "cfg_min_stop_val",  _INV, editable = false)
plot(execMoveStopVal,      "cfg_move_stop_val", _INV, editable = false)
plot(execTp1Pct,           "cfg_tp1_pct",       _INV, editable = false)
plot(execTp2Pct,           "cfg_tp2_pct",       _INV, editable = false)
plot(execTp3Pct,           "cfg_tp3_pct",       _INV, editable = false)
plot(execBeBufTk,          "cfg_be_buf",        _INV, editable = false)
plot(execStructTrailBufTk, "cfg_struct_buf",    _INV, editable = false)
plot(execTrailStep,        "cfg_trail_step",    _INV, editable = false)
plot(execRiskPct,          "cfg_risk_pct",      _INV, editable = false)
plot(fvgThreshPct,         "cfg_fvg_thresh",    _INV, editable = false)
plot(fvgMaxCount,          "cfg_fvg_max",       _INV, editable = false)
