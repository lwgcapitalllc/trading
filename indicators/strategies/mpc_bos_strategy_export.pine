f_fiboLineStyle(string opt) =>
    opt == "┈" ? line.style_dotted : opt == "╌" ? line.style_dashed : line.style_solid

// [doc 18] MACRO FIB (full-cycle retracement across multiple BOS, locks in on trend  -> docs/mpc_bos_strategy.md
bool   showMacroFibInput      = false
bool showMacroFib = showMacroFibInput
int    macroLineExtend   = 180
int    macroMaxTfMin     = 30

bool   showMacro0        = true
color  macro0Color       = #4caf50
string macro0Style       = "─"

bool   showMacro382      = true
color  macro382Color     = #4caf50
string macro382Style     = "┈"

