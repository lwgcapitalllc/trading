var bool  lIsBLeg = false, var bool sIsBLeg = false   // is the OPEN long/short a B-leg — routes the fixed-R:R toggle
var float lSL = na, var float lTP1 = na, var float lTP2 = na
var float sSL = na, var float sTP1 = na, var float sTP2 = na
var float lEntry = na, var float sEntry = na   // fill price of the open trade (breakeven anchor)
var int   lEntryTime = na, var int sEntryTime = na  // fill TIME of the open trade — drives the time stop
var float lMaxFav = na, var float sMaxFav = na // high-water mark of the open trade, drives the runner ratchet
var int   lStage = 0,  var int   sStage = 0    // 0 = full stop, 1 = BE trigger reached (stop->BE), 2 = TP2 hit (stop->TP1, then runner ratchet)

var float openRiskUsd = na   // $ at risk on the open trade = 1R, used to grade the result
var float netAtEntry  = na   // strategy.netprofit the moment the trade opened
var string pendConfL = "", var string pendConfS = ""   // confluence summary snapshotted while armed, drawn on fill

// [doc 117] Position-box state — one growing box per trade, painted by result on clo  -> docs/mpc_strategy.md
type PosBox
    box   bx       = na
    int   dir      = 0
    int   entryBar = na
    float entry    = na
    float sl       = na
    float t1       = na   // the TP1 price — the bar a fill has to clear to count as a target
    float openNet  = na
    int   seen     = 0    // how many closed trades we have already accounted for
    int   fills    = 0    // TARGET fills banked on THIS trade so far (0-3)
    float f1       = na   // the REAL fill price of the 1st / 2nd / 3rd banked target.
    float f2       = na   // Held rather than drawn as they happen, so every band and
    float f3       = na   // tag can be drawn ON CLOSE and share one right-hand edge.
    float worst    = na   // furthest price went AGAINST the trade while it was open
    float lastFill = na   // price of the most recent fill (the exit that closed it out)
var PosBox pbx = PosBox.new()

// [doc 118] The entry confluence label is kept as a HANDLE rather than fired and for  -> docs/mpc_strategy.md
type TradeLbl
    label  lb   = na
    line   ln   = na
    string head = ""   // "▲ LONG" / "▼ SHORT" — always the top line of the box
    string body = ""
    bool   bLeg = false // this trade came from the B LEG — drawn BLUE, not by-result
var TradeLbl tlbl = TradeLbl.new()

// B-LEG callout colour — blue, so B-leg trades stand out from the A+ grey/green/
// red/orange scheme. Kept even after close (the R is still in the text).
color BLEG_BLUE   = color.new(#2962FF, 12)
color BLEG_BLUE_L = color.new(#2962FF, 0)

float execSlBuf = execSlBufTk * syminfo.mintick

// [doc 119] Stop anchor — the fib price the SL is placed at, per the "Stop fib level  -> docs/mpc_strategy.md
f_slAnchor(float _edge, bool _bull) =>
    float _base = switch execSlLevel
        "0.618" => fiboP3
        "0.702" => fiboP4
        "0.786" => fiboP5
        "0.886" => fiboP6
        => fiboP10
    bool _deep = execSlDeep and not na(_edge) and not na(fiboP5) and (_bull ? _edge <= fiboP5 : _edge >= fiboP5)
    _deep ? fiboP10 : _base

// [doc 120] The minimum-stop floor, in PRICE, for whichever mode is selected. `ta.at  -> docs/mpc_strategy.md
float minStopAtr = ta.atr(14)
f_minStopFloor(float px) =>
    switch execMinStopMode
        "% of price" => px * execMinStopVal / 100.0
        "Fixed $"    => execMinStopVal
        "x ATR(14)"  => execMinStopVal * minStopAtr
        => 0.0
bool  fibsReady = not na(fiboP1) and not na(fiboP2) and not na(fiboP3) and not na(fiboP6) and not na(fiboP7) and not na(fiboP10)

// [doc 121] The FIB-SNAP entry price (2026-08-02) — where a qualifying gap's resting  -> docs/mpc_strategy.md
f_fibEntry(float _gB, float _gT, bool _bull) =>
    float _out = na
    if _bull
        float _near = math.min(_gT, fiboP2)
        float _far  = math.max(_gB, fiboP6)
        float _L = fiboP2 <= _near ? fiboP2 : fiboP3 <= _near ? fiboP3 : fiboP4 <= _near ? fiboP4 : fiboP5 <= _near ? fiboP5 : na
        float _S = fiboP6 > _near ? fiboP6 : fiboP5 > _near ? fiboP5 : fiboP4 > _near ? fiboP4 : fiboP3 > _near ? fiboP3 : fiboP2 > _near ? fiboP2 : na
        float _D = fiboP2 < _far  ? fiboP2 : fiboP3 < _far  ? fiboP3 : fiboP4 < _far  ? fiboP4 : fiboP5 < _far  ? fiboP5 : na
        float _N = na(_D) ? _S : na(_S) ? _D : (_far - _D) < (_S - _near) ? _D : _S
        bool  _in = execFibOverlap and not na(_L) and _L >= _far
        _out := _in ? _L : _near > fiboP3 ? na : execFibDeepEdge ? (_far > fiboP6 ? _far : _S) : execFibNearest ? _N : execDeepFib ? _S : na
    else
        float _near = math.max(_gB, fiboP2)
        float _far  = math.min(_gT, fiboP6)
        float _L = fiboP2 >= _near ? fiboP2 : fiboP3 >= _near ? fiboP3 : fiboP4 >= _near ? fiboP4 : fiboP5 >= _near ? fiboP5 : na
        float _S = fiboP6 < _near ? fiboP6 : fiboP5 < _near ? fiboP5 : fiboP4 < _near ? fiboP4 : fiboP3 < _near ? fiboP3 : fiboP2 < _near ? fiboP2 : na
        float _D = fiboP2 > _far  ? fiboP2 : fiboP3 > _far  ? fiboP3 : fiboP4 > _far  ? fiboP4 : fiboP5 > _far  ? fiboP5 : na
        float _N = na(_D) ? _S : na(_S) ? _D : (_D - _far) < (_near - _S) ? _D : _S
        bool  _in = execFibOverlap and not na(_L) and _L <= _far
        _out := _in ? _L : _near < fiboP3 ? na : execFibDeepEdge ? (_far < fiboP6 ? _far : _S) : execFibNearest ? _N : execDeepFib ? _S : na
    _out

// [doc 122] ── Entry EDGE — the exact price a resting limit sits at ────────────────  -> docs/mpc_strategy.md
float longEdge  = na
float shortEdge = na
if fibsReady and array.size(fvgTops) > 0
    for _i = 0 to array.size(fvgTops) - 1
        float _gT = array.get(fvgTops, _i)
        float _gB = array.get(fvgBots, _i)
        bool  _gBull = array.get(fvgIsBull, _i)
        // Deep-only gate: when on, the WHOLE gap must sit past the 0.5 line —
        // long: gap top at/below 0.5; short: gap bottom at/above 0.5 (no straddle).
        bool _lDeepOk = not execFvgDeepOnly or _gT <= fiboP2
        bool _sDeepOk = not execFvgDeepOnly or _gB >= fiboP2
        // [doc 123] Pre-zone gate: with execFvgPreZone on, a gap the retrace itself printed   -> docs/mpc_strategy.md
        bool _preOk = f_gapPreZone(array.get(fvgBorn, _i))
        if _gBull and fibo_dir == 1 and _gB <= fiboP2 and _gT >= fiboP6 and _lDeepOk and _preOk
            float _df = f_fibEntry(_gB, _gT, true)
            float _e = na(_df) ? math.min(_gT, fiboP2) : _df       // snap override, else shallowest touch
            longEdge := na(longEdge) ? _e : math.max(longEdge, _e) // first one price reaches
        if (not _gBull) and fibo_dir == -1 and _gT >= fiboP2 and _gB <= fiboP6 and _sDeepOk and _preOk
            float _df = f_fibEntry(_gB, _gT, false)
            float _e = na(_df) ? math.max(_gB, fiboP2) : _df
            shortEdge := na(shortEdge) ? _e : math.min(shortEdge, _e)
// [doc 124] ── SNIPER ZONE — the SECOND accepted confirmation ──────────────────────  -> docs/mpc_strategy.md
bool longEdgeSz  = false
bool shortEdgeSz = false
if execConfSZ and fibsReady and not na(sniperZoneTop) and not na(sniperZoneBot) and not na(sz_bar)
    if na(longEdge) and fibo_dir == 1 and sz_bullish and not na(aplusL_sosBar) and sz_bar >= aplusL_sosBar
        float _e = math.min(sniperZoneBot, fiboP2)   // far side of the pocket
        if _e >= fiboP6
            longEdge   := _e
            longEdgeSz := true
    if na(shortEdge) and fibo_dir == -1 and not sz_bullish and not na(aplusS_sosBar) and sz_bar >= aplusS_sosBar
        float _e = math.max(sniperZoneTop, fiboP2)
        if _e <= fiboP6
            shortEdge   := _e
            shortEdgeSz := true

// [doc 125] (The no-FVG fallback — "no qualifying gap, so rest at the 0.618" — used   -> docs/mpc_strategy.md

// [doc 126] (The "FVG TOUCHES 0.5" fallback loop was REMOVED 2026-08-02 with its exe  -> docs/mpc_strategy.md

// [doc 127] ── Arm-source filter — isolate WHICH Stage-1 confluence is allowed to ar  -> docs/mpc_strategy.md
var int  armSwpL  = na,    var int  armSwpS  = na      // last sweep-arm bar, per side
var int  armDivL  = na,    var int  armDivS  = na      // last divergence-arm bar, per side
var int  armSwpLt = na,    var int  armSwpSt = na      // ...and its timestamp
var int  armDivLt = na,    var int  armDivSt = na
var bool sosL_swp = false, var bool sosL_div = false   // sources live at the long SOS
var bool sosS_swp = false, var bool sosS_div = false   // sources live at the short SOS

int aplusWindowMs = aplusWindow * 60000

if newSweepL
    armSwpL := recentSSL_bar, armSwpLt := time
if newDivL
    armDivL := lastBullDivBar, armDivLt := time
if newSweepS
    armSwpS := recentBSL_bar, armSwpSt := time
if newDivS
    armDivS := lastBearDivBar, armDivSt := time

if st.bull_sos
    sosL_swp := not na(armSwpLt) and time - armSwpLt <= aplusWindowMs
    sosL_div := not na(armDivLt) and time - armDivLt <= aplusWindowMs
if st.bear_sos
    sosS_swp := not na(armSwpSt) and time - armSwpSt <= aplusWindowMs
    sosS_div := not na(armDivSt) and time - armDivSt <= aplusWindowMs

// [doc 128] Retro-linked SOS: the snapshot above never ran for it, because on the SO  -> docs/mpc_strategy.md
if retroLinkL
    sosL_div := true
    sosL_swp := not na(armSwpLt) and armSwpLt <= lastBullSosTime and lastBullSosTime - armSwpLt <= aplusWindowMs
if retroLinkS
    sosS_div := true
    sosS_swp := not na(armSwpSt) and armSwpSt <= lastBearSosTime and lastBearSosTime - armSwpSt <= aplusWindowMs

// [doc 129] ── The no-FVG fallback (moved here 2026-08-10 — see the note in the entr  -> docs/mpc_strategy.md
bool noGapOkL = execNoGapArm == "Any" or (sosL_swp and sosL_div)
bool noGapOkS = execNoGapArm == "Any" or (sosS_swp and sosS_div)
if not execReqFVG and fibsReady
    if na(longEdge)  and fibo_dir == 1  and noGapOkL
        longEdge  := fiboP3
    if na(shortEdge) and fibo_dir == -1 and noGapOkS
        shortEdge := fiboP3


// [doc 130] A source only counts if you ENABLED it AND it was live at the SOS. The t  -> docs/mpc_strategy.md
bool useSwpL = execArmSweep and sosL_swp
bool useDivL = execArmDiv   and sosL_div
bool useSwpS = execArmSweep and sosS_swp
bool useDivS = execArmDiv   and sosS_div

bool armOkL = useSwpL or useDivL
bool armOkS = useSwpS or useDivS

// [doc 131] (The missed-setup callout used to fire here. It now lives further down,   -> docs/mpc_strategy.md

// [doc 132] Confluence text — every line is printed because ITS OWN flag is true on   -> docs/mpc_strategy.md
f_conf(bool isLong, bool swp, bool div, string swpName, int sosAge, bool fvg, bool poi, bool liveDiv, bool deep, bool sz, float edgePx, float slPx, float tp1Px, float tp2Px) =>
    string arm = swp and div ? "Sweep + RSI div" : swp ? "Sweep" : "RSI divergence"
    if swp and swpName != ""
        arm := arm + " · " + swpName
    string s = "──────────────"
    s := s + "\nArm     " + arm
    s := s + "\nSOS     " + str.tostring(sosAge) + " bars ago"
    // Which confirmation actually PRICED this entry — SZ only appears when the
    // limit was placed off the Sniper Zone because no gap qualified.
    s := s + "\nZone    " + (sz ? "Sniper Zone (no FVG)" : fvg ? "FVG ✓" : "fib only")
    s := s + "\nPOI     " + (poi ? "✓" : "–")
    s := s + "\nDiv     " + (liveDiv ? "✓" : "–")
    s := s + "\n──────────────"
    s := s + "\nEntry   " + (deep ? "0.618+ deep" : "0.5 shallow") + "   " + str.tostring(edgePx, format.mintick)
    s := s + "\nStop    fib " + execSlLevel + "        " + str.tostring(slPx, format.mintick)
    s := s + "\nTP1     fib " + (deep ? "0.5" : "0.382") + "      " + str.tostring(tp1Px, format.mintick)
    s := s + "\nTP2     fib " + (deep ? "0.382" : "0.0") + "      " + str.tostring(tp2Px, format.mintick)
    s := s + "\nTP3     runner · trailing stop"
    s

// [doc 133] ── Armed conditions — setup to SOS, fib aligned, an edge exists, not vet  -> docs/mpc_strategy.md
bool lateDayBlock = execNoLateDay and nyHour >= 16 and nyHour < 18

// [doc 134] ── HTF exhaustion filter (loss-mitigation test #1) ─────────────────────  -> docs/mpc_strategy.md
bool wBreakUp   = str.contains(wEstDesc, "Close >")
bool wBreakDown = str.contains(wEstDesc, "Close <")
bool dBreakUp   = str.contains(dEstDesc, "Close >")
bool dBreakDown = str.contains(dEstDesc, "Close <")
bool htfBreakUp   = execHtfSource == "Daily" ? dBreakUp   : execHtfSource == "Either" ? (wBreakUp   or dBreakUp)   : wBreakUp
bool htfBreakDown = execHtfSource == "Daily" ? dBreakDown : execHtfSource == "Either" ? (wBreakDown or dBreakDown) : wBreakDown
bool htfBlockLong  = execHtfExhaustOnly and htfBreakDown   // long fades a low → blocked by a fresh breakdown
bool htfBlockShort = execHtfExhaustOnly and htfBreakUp     // short fades a high → blocked by a fresh breakout up

// [doc 135] ── HTF-bias confluence (Daily + Weekly working TOGETHER) ───────────────  -> docs/mpc_strategy.md
f_htfReqBlock(string req, string state, bool isLong) =>
    bool agreeDir  = isLong ? (state == "Bullish") : (state == "Bearish")
    bool opposeDir = isLong ? (state == "Bearish") : (state == "Bullish")
    req == "Must agree"              ? not agreeDir  :
     req == "Must not oppose"        ? opposeDir     :
     req == "Must oppose (reversal)" ? not opposeDir : false

bool htfBiasBlockLong  = f_htfReqBlock(execHtfWeekly, wEstState, true)  or f_htfReqBlock(execHtfDaily, dEstState, true)
bool htfBiasBlockShort = f_htfReqBlock(execHtfWeekly, wEstState, false) or f_htfReqBlock(execHtfDaily, dEstState, false)

bool longArmed  = execAplus and execLongs  and armOkL and not lateDayBlock and not htfBlockLong  and not htfBiasBlockLong  and not na(aplusL_sosBar) and fibo_dir == 1  and not na(longEdge)  and (not longVetoA or not execRespectVeto) and strategy.position_size == 0 and (na(tradedSosL) or aplusL_sosBar != tradedSosL)
bool shortArmed = execAplus and execShorts and armOkS and not lateDayBlock and not htfBlockShort and not htfBiasBlockShort and not na(aplusS_sosBar) and fibo_dir == -1 and not na(shortEdge) and (not shortVetoA or not execRespectVeto) and strategy.position_size == 0 and (na(tradedSosS) or aplusS_sosBar != tradedSosS)

// [doc 136] ── MISSED-DUE-TO-NO-FVG counter ────────────────────────────────────────  -> docs/mpc_strategy.md
var int  missedNoFvgL = 0,       var int  missedNoFvgS = 0
var bool aplusL_fvgMiss = false, var bool aplusS_fvgMiss = false

bool longReadyNoFvg  = execLongs  and armOkL and not lateDayBlock and not na(aplusL_sosBar) and fibo_dir == 1  and na(longEdge)  and aplusL_half and (not longVetoA or not execRespectVeto) and strategy.position_size == 0 and (na(tradedSosL) or aplusL_sosBar != tradedSosL)
bool shortReadyNoFvg = execShorts and armOkS and not lateDayBlock and not na(aplusS_sosBar) and fibo_dir == -1 and na(shortEdge) and aplusS_half and (not shortVetoA or not execRespectVeto) and strategy.position_size == 0 and (na(tradedSosS) or aplusS_sosBar != tradedSosS)

if longReadyNoFvg
    aplusL_fvgMiss := true
if aplusL_fvgMiss and (not na(longEdge) or (not na(tradedSosL) and aplusL_sosBar == tradedSosL))
    aplusL_fvgMiss := false
if aplusL_fvgMiss and na(aplusL_sosBar)
    missedNoFvgL := missedNoFvgL + 1
    aplusL_fvgMiss := false

if shortReadyNoFvg
    aplusS_fvgMiss := true
if aplusS_fvgMiss and (not na(shortEdge) or (not na(tradedSosS) and aplusS_sosBar == tradedSosS))
    aplusS_fvgMiss := false
if aplusS_fvgMiss and na(aplusS_sosBar)
    missedNoFvgS := missedNoFvgS + 1
    aplusS_fvgMiss := false

// [doc 137] ══ MISSED-SETUP CALLOUT ════════════════════════════════════════════════  -> docs/mpc_strategy.md
float _dbg23Atr = ta.atr(14)
float _dbg23Lo  = ta.lowest(low, 60)   - _dbg23Atr * 4
float _dbg23Hi  = ta.highest(high, 60) + _dbg23Atr * 4
bool  _dbgRecent = debugDays == 0 or time >= timenow - debugDays * 86400000

string miss23L = f_w23(mwL, true,  not na(aplusL_sosBar), not na(tradedSosL) and tradedSosL == mwL.sosBar, strategy.position_size <= 0, aplusL_half or aplusL_618, longEdge,  fiboP3, longVetoA  and execRespectVeto, lateDayBlock, htfBlockLong  or htfBiasBlockLong,  execArmSweep and sosL_swp, execArmDiv and sosL_div, execReqFVG, _dbg23Lo, _dbg23Atr * 2, _dbgRecent)
string miss23S = f_w23(mwS, false, not na(aplusS_sosBar), not na(tradedSosS) and tradedSosS == mwS.sosBar, strategy.position_size >= 0, aplusS_half or aplusS_618, shortEdge, fiboP3, shortVetoA and execRespectVeto, lateDayBlock, htfBlockShort or htfBiasBlockShort, execArmSweep and sosS_swp, execArmDiv and sosS_div, execReqFVG, _dbg23Hi, _dbg23Atr * 2, _dbgRecent)

// [doc 138] ══ BLOCKED-TRADE MARKER ════════════════════════════════════════════════  -> docs/mpc_strategy.md

color BLK_PINK  = color.new(#FF2E9A, 12)
color BLK_PINKL = color.new(#FF2E9A, 0)

// [doc 139] Reason PRECEDENCE — the first rule that would refuse the order is the on  -> docs/mpc_strategy.md
f_blkCode(bool dirOff, bool armOff, bool late, bool veto, bool htfBrk, bool htfBias, bool tight) =>
    dirOff ? 1 : armOff ? 2 : late ? 3 : veto ? 4 : htfBrk ? 5 : htfBias ? 6 : tight ? 7 : 0

f_blkWhy(int c) =>
    switch c
        1 => "'Trade longs' / 'Trade shorts' is OFF for this side."
        2 => "Arm source OFF — this setup was armed by the sweep or divergence trigger you disabled."
        3 => "Final-hour rule — no new entries 16:00-18:00 New York, ahead of the daily close."
        4 => "Divergence / extreme-RSI veto — opposing divergence live at the SOS, or RSI at an extreme."
        5 => "HTF exhaustion filter — the higher timeframe just CLOSED through its prior extreme, so this is a fresh breakout rather than an exhaustion fade."
        6 => "HTF bias requirement — your Weekly / Daily bias gate is not satisfied."
        7 => "Minimum stop distance — the stop sits closer to the entry than your floor, so this position would be oversized and noise-sensitive."
        => ""

// [doc 140] ks carries the last (sosBar*10 + code) reported per side — the dedupe ke  -> docs/mpc_strategy.md
f_blkTag(array<int> ks, int slot, bool isLong, bool ready, int code, int sosBar, float edge, float y) =>
    if showBlockTag and ready and code != 0 and not na(sosBar) and not na(edge)
        int key = sosBar * 10 + code
        if key != array.get(ks, slot)
            array.set(ks, slot, key)
            line.new(bar_index, edge, bar_index, y, color = BLK_PINKL, style = line.style_dotted, width = 1)
            label.new(bar_index, y, (isLong ? "▲" : "▼") + " TRADE BLOCKED", tooltip = (isLong ? "▲ LONG" : "▼ SHORT") + " blocked\n──────────────────\n" + f_blkWhy(code) + "\n──────────────────\nLimit would have rested at " + str.tostring(edge, format.mintick), color = BLK_PINK, textcolor = color.new(#101014, 0), style = isLong ? label.style_label_up : label.style_label_down, size = size.small)
    int _blkDone = 0

var array<int> blkKeys = array.from(-1, -1)

// [doc 141] "Ready" deliberately omits every toggle gate — those ARE the blockers we  -> docs/mpc_strategy.md
bool lBlkReady = not na(aplusL_sosBar) and fibo_dir == 1  and not na(longEdge)  and strategy.position_size == 0 and (na(tradedSosL) or aplusL_sosBar != tradedSosL)
bool sBlkReady = not na(aplusS_sosBar) and fibo_dir == -1 and not na(shortEdge) and strategy.position_size == 0 and (na(tradedSosS) or aplusS_sosBar != tradedSosS)
// [doc 142] The min-stop refusal happens at order placement below; it is recomputed   -> docs/mpc_strategy.md
float lBlkDist  = longEdge - (f_slAnchor(longEdge, true) - execSlBuf)
float sBlkDist  = (f_slAnchor(shortEdge, false) + execSlBuf) - shortEdge
bool  lBlkTight = lBlkDist > 0 and lBlkDist < f_minStopFloor(longEdge)
bool  sBlkTight = sBlkDist > 0 and sBlkDist < f_minStopFloor(shortEdge)
int  lBlkCode  = f_blkCode(not execLongs,  not armOkL, lateDayBlock, longVetoA  and execRespectVeto, htfBlockLong,  htfBiasBlockLong,  lBlkTight)
int  sBlkCode  = f_blkCode(not execShorts, not armOkS, lateDayBlock, shortVetoA and execRespectVeto, htfBlockShort, htfBiasBlockShort, sBlkTight)

f_blkTag(blkKeys, 0, true,  lBlkReady, lBlkCode, aplusL_sosBar, longEdge,  _dbg23Lo - _dbg23Atr)
f_blkTag(blkKeys, 1, false, sBlkReady, sBlkCode, aplusS_sosBar, shortEdge, _dbg23Hi + _dbg23Atr)

// [doc 143] ── Ladder select — which rungs this trade gets depends on how DEEP the r  -> docs/mpc_strategy.md
bool longDeep  = not na(longEdge)  and longEdge  <= fiboP3
bool shortDeep = not na(shortEdge) and shortEdge >= fiboP3

// [doc 144] ── B-LEG arm — the frozen SZ band is live, untapped and valid, we're fla  -> docs/mpc_strategy.md
bool bLegLongArm  = execBLeg and execLongs  and not longArmed  and bLegL_on and not bLegL_tap and not lateDayBlock and not na(bLegL_top) and not na(bLegL_inv) and not na(bLegL_tgt) and strategy.position_size == 0 and (na(tradedBLegL) or bLegL_bar != tradedBLegL)
bool bLegShortArm = execBLeg and execShorts and not shortArmed and bLegS_on and not bLegS_tap and not lateDayBlock and not na(bLegS_bot) and not na(bLegS_inv) and not na(bLegS_tgt) and strategy.position_size == 0 and (na(tradedBLegS) or bLegS_bar != tradedBLegS)

// ── Long: rest / refresh a buy-limit at the edge (cancel when disarmed) ──
if longArmed
    lSL  := f_slAnchor(longEdge, true) - execSlBuf
    float slDist = longEdge - lSL
    lTP1 := longDeep ? fiboP2 : fiboP1   // deep → 0.5, shallow → 0.382
    lTP2 := longDeep ? fiboP1 : fiboP7   // deep → 0.382, shallow → 0.0 (swing extreme)
    if slDist > 0 and slDist >= f_minStopFloor(longEdge)
        float qty = (strategy.equity * execRiskPct / 100.0) / slDist
        pendSosL := aplusL_sosBar
        pendIsBLegL := false
        pendConfL := f_conf(true, useSwpL, useDivL, recentSSL, bar_index - aplusL_sosBar, aplusL_fvg, aplusL_poi, bullDivActive, longDeep, longEdgeSz, longEdge, lSL, lTP1, lTP2)
        strategy.entry("Long", strategy.long, qty = qty, limit = longEdge)
    else
        strategy.cancel("Long")
else if strategy.position_size == 0 and not bLegLongArm
    strategy.cancel("Long")

// ── Short: rest / refresh a sell-limit at the edge ──
if shortArmed
    sSL  := f_slAnchor(shortEdge, false) + execSlBuf
    float slDist = sSL - shortEdge
    sTP1 := shortDeep ? fiboP2 : fiboP1
    sTP2 := shortDeep ? fiboP1 : fiboP7
    if slDist > 0 and slDist >= f_minStopFloor(shortEdge)
        float qty = (strategy.equity * execRiskPct / 100.0) / slDist
        pendSosS := aplusS_sosBar
        pendIsBLegS := false
        pendConfS := f_conf(false, useSwpS, useDivS, recentBSL, bar_index - aplusS_sosBar, aplusS_fvg, aplusS_poi, bearDivActive, shortDeep, shortEdgeSz, shortEdge, sSL, sTP1, sTP2)
        strategy.entry("Short", strategy.short, qty = qty, limit = shortEdge)
    else
        strategy.cancel("Short")
else if strategy.position_size == 0 and not bLegShortArm
    strategy.cancel("Short")

// [doc 145] ── B-LEG entries — rest a limit at the frozen band's near (0.5) edge, re  -> docs/mpc_strategy.md
string _bSess = inNY ? "NY" : inLondon ? "Ldn" : inAsia ? "Asia" : "off"
string _bZone = "-"
if macro_origin_locked and not na(macro_origin) and not na(macro_extreme) and macro_extreme > macro_origin
    float _fr = (close - macro_origin) / (macro_extreme - macro_origin)
    _bZone := _fr >= 0.618 ? "premium" : _fr <= 0.382 ? "discount" : "mid"
string _bLegCtx = " · W " + wEstState + " · D " + dEstState + " · " + _bSess + " · cyc " + _bZone
if bLegLongArm
    lSL  := bLegL_inv - execSlBuf
    float slDist = bLegL_top - lSL
    lTP1 := 2 * bLegL_top - bLegL_inv
    lTP2 := bLegL_tgt
    if slDist > 0 and lTP1 > bLegL_top and lTP2 >= lTP1
        float qty = (strategy.equity * execRiskPct / 100.0) / slDist
        pendSosL   := bLegL_bar
        pendIsBLegL := true
        pendConfL  := "B-LEG long · late retrace" + _bLegCtx
        strategy.entry("Long", strategy.long, qty = qty, limit = bLegL_top)
    else
        strategy.cancel("Long")

if bLegShortArm
    sSL  := bLegS_inv + execSlBuf
    float slDist = sSL - bLegS_bot
    sTP1 := 2 * bLegS_bot - bLegS_inv
    sTP2 := bLegS_tgt
    if slDist > 0 and sTP1 < bLegS_bot and sTP2 <= sTP1
        float qty = (strategy.equity * execRiskPct / 100.0) / slDist
        pendSosS   := bLegS_bar
        pendIsBLegS := true
        pendConfS  := "B-LEG short · late retrace" + _bLegCtx
        strategy.entry("Short", strategy.short, qty = qty, limit = bLegS_bot)
    else
        strategy.cancel("Short")

// [doc 146] ── Mark the leg traded once the resting limit FILLS; snapshot the entry   -> docs/mpc_strategy.md
float _cOff = ta.atr(14) * execLabelOff

// [doc 147] While the trade is OPEN the label is grey — the result is not known yet   -> docs/mpc_strategy.md
f_confOpen(TradeLbl t, int dir, float px, float off, string body, bool showIt) =>
    if execShowConfLabel and showIt
        float ly = dir > 0 ? px - off : px + off
        t.head := dir > 0 ? "▲ LONG" : "▼ SHORT"
        t.body := body
        t.ln   := line.new(bar_index, px, bar_index, ly, color = t.bLeg ? BLEG_BLUE_L : color.new(#787B86, 0), width = 1)
        t.lb   := label.new(bar_index, ly, t.head, tooltip = t.head + "\n" + body, color = t.bLeg ? BLEG_BLUE : color.new(#787B86, 12), textcolor = color.new(#101014, 0), style = dir > 0 ? label.style_label_up : label.style_label_down, size = size.small)

// [doc 148] On the bar the trade closes: recolour by RESULT and append the R. Green   -> docs/mpc_strategy.md
f_confClose(TradeLbl t, float tradeR, float band) =>
    if not na(t.lb)
        bool   be   = math.abs(tradeR) <= band
        bool   won  = not be and tradeR > 0
        string res  = be ? "BREAKEVEN" : won ? "WIN" : "LOSS"
        bool   keep = execLabelWhich == "All" or (execLabelWhich == "Wins only" and won) or (execLabelWhich == "Losses only" and not won and not be) or (execLabelWhich == "Losses + breakevens" and not won)
        if keep
            string line1 = t.head + "  ·  " + res + "  " + (tradeR >= 0 ? "+" : "") + str.tostring(tradeR, "#.##") + "R"
            label.set_text(t.lb, line1)
            label.set_tooltip(t.lb, line1 + "\n" + t.body)
            label.set_color(t.lb, t.bLeg ? BLEG_BLUE : be ? color.new(#FF9800, 12) : won ? color.new(#26A69A, 12) : color.new(#EF5350, 12))
            line.set_color(t.ln, t.bLeg ? BLEG_BLUE_L : be ? color.new(#FF9800, 0) : won ? color.new(#26A69A, 0) : color.new(#EF5350, 0))
        else
            label.delete(t.lb)
            line.delete(t.ln)
        t.lb := na
        t.ln := na

if strategy.position_size > 0 and strategy.position_size[1] <= 0
    if pendIsBLegL
        tradedBLegL := pendSosL
    else
        tradedSosL := pendSosL
    lEntry     := strategy.position_avg_price
    lEntryTime := time
    lStage     := 0
    lMaxFav    := lEntry
    openRiskUsd := math.abs(strategy.position_size) * (lEntry - lSL)
    netAtEntry  := strategy.netprofit
    tlbl.bLeg  := pendIsBLegL
    lIsBLeg    := pendIsBLegL
    f_confOpen(tlbl, 1, lEntry, _cOff, pendConfL, execLabelWhich != "None")
if strategy.position_size < 0 and strategy.position_size[1] >= 0
    if pendIsBLegS
        tradedBLegS := pendSosS
    else
        tradedSosS := pendSosS
    sEntry     := strategy.position_avg_price
    sEntryTime := time
    sStage     := 0
    sMaxFav    := sEntry
    openRiskUsd := math.abs(strategy.position_size) * (sSL - sEntry)
    netAtEntry  := strategy.netprofit
    tlbl.bLeg  := pendIsBLegS
    sIsBLeg    := pendIsBLegS
    f_confOpen(tlbl, -1, sEntry, _cOff, pendConfS, execLabelWhich != "None")
if strategy.position_size == 0
    lStage := 0
    sStage := 0

// [doc 149] ── Grade the trade the bar it closes: WIN / LOSS / BREAKEVEN in R, not i  -> docs/mpc_strategy.md
float closedR = strategy.position_size == 0 and strategy.position_size[1] != 0 and not na(openRiskUsd) and openRiskUsd > 0 ? (strategy.netprofit - netAtEntry) / openRiskUsd : na
if not na(closedR)
    f_confClose(tlbl, closedR, execBeBandR)
    openRiskUsd := na

// [doc 150] ── Position box — the trade drawn as STACKED BANDS, not as loose lines ─  -> docs/mpc_strategy.md
color POS_RED    = color.new(#EF5350, 62)
color POS_OPEN   = color.new(#787B86, 80)
color POS_ORANGE = color.new(#FF9800, 0)
color POS_GREENB = color.new(#26A69A, 0)   // solid borders so even a thin box is visible
color POS_REDB   = color.new(#EF5350, 0)
color POS_G1     = color.new(#26A69A, 55)  // one hue, three depths — the gradient IS
color POS_G2     = color.new(#26A69A, 70)  // the legend, so nothing has to be labelled
color POS_G3     = color.new(#26A69A, 82)  // by colour
color POS_DD     = color.new(#EF5350, 88)  // drawdown: behind everything, barely there
color TP_ANNOT   = color.new(#26A69A, 40)  // ONE colour for every tag and its line

// [doc 151] One banked target: its slice of the move, a faint dashed line at the exa  -> docs/mpc_strategy.md
f_tpBand(int x1, int x2, int lx, float yA, float yB, color c, string tag) =>
    box.new(x1, math.max(yA, yB), x2, math.min(yA, yB), bgcolor = c, border_color = color(na))
    if execShowExitLines
        line.new(x1, yB, lx, yB, color = TP_ANNOT, style = line.style_dashed, width = 1)
        label.new(lx, yB, " " + tag, color = color(na), textcolor = TP_ANNOT, style = label.style_label_left, size = size.small)

f_posBox(PosBox p, float lE, float sE, float lS, float sS, float l1, float s1) =>
    if execShowPosBox
        // 1. Fresh fill → open a neutral box anchored at the entry bar
        if strategy.position_size != 0 and strategy.position_size[1] == 0
            p.dir      := strategy.position_size > 0 ? 1 : -1
            p.entryBar := bar_index
            p.entry    := p.dir > 0 ? lE : sE
            p.sl       := p.dir > 0 ? lS : sS
            p.t1       := p.dir > 0 ? l1 : s1
            p.openNet  := strategy.netprofit
            p.lastFill := na
            p.f1       := na
            p.f2       := na
            p.f3       := na
            p.fills    := 0
            p.worst    := p.dir > 0 ? low : high
            p.bx       := box.new(bar_index, math.max(p.entry, close), bar_index, math.min(p.entry, close), bgcolor = POS_OPEN, border_color = color.new(#787B86, 0), border_width = 1)
        // [doc 152] 2. Bank any exits that filled. They are RECORDED here and DRAWN on close  -> docs/mpc_strategy.md
        if strategy.closedtrades > p.seen
            for i = p.seen to strategy.closedtrades - 1
                float xPx  = strategy.closedtrades.exit_price(i)
                int   xDir = strategy.closedtrades.size(i) > 0 ? 1 : -1
                // Only a fill at or beyond TP1 counts as a banked target. This is what
                // stops a breakeven-stop exit (which fills just past entry) painting green.
                if not na(p.t1) and (xDir > 0 ? xPx >= p.t1 : xPx <= p.t1)
                    p.fills := p.fills + 1
                    if p.fills == 1
                        p.f1 := xPx
                    else if p.fills == 2
                        p.f2 := xPx
                    else
                        p.f3 := xPx
                p.lastFill := xPx
            p.seen := strategy.closedtrades
        // 3. While open → grow the box right and track the worst price seen
        if strategy.position_size != 0 and not na(p.bx)
            p.worst := p.dir > 0 ? math.min(p.worst, low) : math.max(p.worst, high)
            box.set_right(p.bx, bar_index)
            box.set_top(p.bx, math.max(p.entry, close))
            box.set_bottom(p.bx, math.min(p.entry, close))
        // 4. Closed this bar → drop the placeholder and paint the real thing
        if strategy.position_size == 0 and strategy.position_size[1] != 0 and not na(p.bx)
            box.delete(p.bx)
            p.bx := na
            int   xr  = bar_index
            int   lx  = xr + 4
            float net = strategy.netprofit - p.openNet
            // Drawdown first so the green bands sit on top of it
            if p.dir > 0 ? p.worst < p.entry : p.worst > p.entry
                box.new(p.entryBar, math.max(p.entry, p.worst), xr, math.min(p.entry, p.worst), bgcolor = POS_DD, border_color = color(na))
            if not na(p.f1)
                f_tpBand(p.entryBar, xr, lx, p.entry, p.f1, POS_G1, "TP1")
                if not na(p.f2)
                    f_tpBand(p.entryBar, xr, lx, p.f1, p.f2, POS_G2, "TP2")
                if not na(p.f3)
                    f_tpBand(p.entryBar, xr, lx, p.f2, p.f3, POS_G3, "TP3")
            else if net < 0
                float redTo = na(p.lastFill) ? p.sl : p.lastFill
                box.new(p.entryBar, math.max(p.entry, redTo), xr, math.min(p.entry, redTo), bgcolor = POS_RED, border_color = POS_REDB)
            else
                line.new(p.entryBar, p.entry, xr, p.entry, color = POS_ORANGE, width = 2)
        // [doc 153] A function's LAST statement is its return value, and the three branches  -> docs/mpc_strategy.md
        int _pbDone = 0

f_posBox(pbx, lEntry, sEntry, lSL, sSL, lTP1, sTP1)

// [doc 154] Always-visible entry markers (the long/short position indicator itself)   -> docs/mpc_strategy.md
plotshape(execShowPosBox and strategy.position_size > 0 and strategy.position_size[1] <= 0, title = "Long entry",  style = shape.triangleup,   location = location.belowbar, color = POS_GREENB, size = size.small)
plotshape(execShowPosBox and strategy.position_size < 0 and strategy.position_size[1] >= 0, title = "Short entry", style = shape.triangledown, location = location.abovebar, color = POS_REDB,   size = size.small)

// [doc 155] ── Advance the stop stage as each target is touched THIS bar, and ratche  -> docs/mpc_strategy.md
float beBuf     = execBeBufTk * syminfo.mintick
float trailStep = execTrailStep

// f_trail — the runner's ratchet. Returns na until price has run a full step past
// tp2, then floors the high-water mark to the step grid anchored on tp2.
f_trail(float maxFav, float tp2, int dir) =>
    float run = dir > 0 ? maxFav - tp2 : tp2 - maxFav
    float out = na
    if not na(run) and run >= trailStep
        float steps = math.floor((run - trailStep) / trailStep)
        out := dir > 0 ? tp2 + steps * trailStep : tp2 - steps * trailStep
    out

// [doc 156] f_swingRatchet — the structure trail that does not stand still. Same anc  -> docs/mpc_strategy.md
f_swingRatchet(float swing, float maxFav, int dir, float buf, float pct) =>
    float anchor = dir > 0 ? swing - buf : swing + buf
    float step   = maxFav * pct / 100.0
    float run    = (maxFav - anchor) * dir
    float out    = anchor
    if step > 0 and not na(run) and run >= step
        float steps = math.floor((run - step) / step)
        out := anchor + steps * step * dir
    out

// [doc 157] lSL / sSL are only ever written while flat (longArmed requires position_  -> docs/mpc_strategy.md
if strategy.position_size > 0 and strategy.position_size[1] > 0
    lMaxFav := na(lMaxFav) ? high : math.max(lMaxFav, high)
    if lStage < 1 and high >= lTP1
        lStage := 1
    if lStage < 2 and high >= lTP2
        lStage := 2
if strategy.position_size < 0 and strategy.position_size[1] < 0
    sMaxFav := na(sMaxFav) ? low : math.min(sMaxFav, low)
    if sStage < 1 and low <= sTP1
        sStage := 1
    if sStage < 2 and low <= sTP2
        sStage := 2

// [doc 158] Runner trail candidate — the fixed-step ratchet, a structure trail parke  -> docs/mpc_strategy.md
float structBuf = execStructTrailBufTk * syminfo.mintick
bool  useStructTrail  = execRunnerTrail == "Structure (swing)"
bool  useSwingRatchet = execRunnerTrail == "Structure + % ratchet"
float lTrail = lStage >= 2 ? (useSwingRatchet ? (not na(st.last_conf_low)  ? f_swingRatchet(st.last_conf_low,  lMaxFav,  1, structBuf, execTrailPct) : na) : useStructTrail ? (not na(st.last_conf_low)  ? st.last_conf_low  - structBuf : na) : f_trail(lMaxFav, lTP2,  1)) : na
float sTrail = sStage >= 2 ? (useSwingRatchet ? (not na(st.last_conf_high) ? f_swingRatchet(st.last_conf_high, sMaxFav, -1, structBuf, execTrailPct) : na) : useStructTrail ? (not na(st.last_conf_high) ? st.last_conf_high + structBuf : na) : f_trail(sMaxFav, sTP2, -1)) : na

// [doc 159] TP2 stop floor — the protective baseline the instant TP2 hits, before th  -> docs/mpc_strategy.md
float lStage2Floor = execTp2StopMode == "Breakeven" ? lEntry + beBuf : execTp2StopMode == "One trail step behind" ? math.max(lEntry + beBuf, lMaxFav - trailStep) : lTP1
float sStage2Floor = execTp2StopMode == "Breakeven" ? sEntry - beBuf : execTp2StopMode == "One trail step behind" ? math.min(sEntry - beBuf, sMaxFav + trailStep) : sTP1

float lStop = lStage >= 2 ? (na(lTrail) ? lStage2Floor : math.max(lStage2Floor, lTrail)) : lStage >= 1 ? lEntry + beBuf : lSL
float sStop = sStage >= 2 ? (na(sTrail) ? sStage2Floor : math.min(sStage2Floor, sTrail)) : sStage >= 1 ? sEntry - beBuf : sSL

// [doc 160] ── The TIME STOP — the one exit lever driven by the clock, not by price   -> docs/mpc_strategy.md

bool lTimeUp = execTimeStopMode != "Off" and strategy.position_size > 0 and not na(lEntryTime) and (execTimeStopMode == "Always" or lStage == 0) and (time - lEntryTime) >= execTimeStopHrs * 3600000
bool sTimeUp = execTimeStopMode != "Off" and strategy.position_size < 0 and not na(sEntryTime) and (execTimeStopMode == "Always" or sStage == 0) and (time - sEntryTime) >= execTimeStopHrs * 3600000

// [doc 161] ── Manage open long: TP1/TP2 scale-outs + runner, staged stop ──  -> docs/mpc_strategy.md
if strategy.position_size > 0
    if execTp1Pct > 0
        strategy.exit("L-TP1", from_entry = "Long", qty_percent = execTp1Pct, limit = lTP1, stop = lStop)
    if execTp2Pct > 0
        strategy.exit("L-TP2", from_entry = "Long", qty_percent = execTp2Pct, limit = lTP2, stop = lStop)
    strategy.exit("L-RUN", from_entry = "Long",                                          stop = lStop)
    if execCloseOppSOS and st.bear_sos
        strategy.close("Long", comment = "opp SOS")
    else if lTimeUp
        strategy.close("Long", comment = "time stop")

// ── Manage open short ──
if strategy.position_size < 0
    if execTp1Pct > 0
        strategy.exit("S-TP1", from_entry = "Short", qty_percent = execTp1Pct, limit = sTP1, stop = sStop)
    if execTp2Pct > 0
        strategy.exit("S-TP2", from_entry = "Short", qty_percent = execTp2Pct, limit = sTP2, stop = sStop)
    strategy.exit("S-RUN", from_entry = "Short",                                          stop = sStop)
    if execCloseOppSOS and st.bull_sos
        strategy.close("Short", comment = "opp SOS")
    else if sTimeUp
        strategy.close("Short", comment = "time stop")
