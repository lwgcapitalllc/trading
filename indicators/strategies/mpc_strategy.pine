// [doc 115] Frozen trade levels — snapshotted while armed so live fib recomputation   -> docs/mpc_strategy.md
var int   tradedSosL = na    // the SOS bar we already took a long on (one entry per leg)
var int   tradedSosS = na
var int   pendSosL   = na    // the SOS bar whose entry limit is currently resting
var int   pendSosS   = na
// [doc 116] B-LEG execution state — a B leg reuses the "Long"/"Short" entry id and a  -> docs/mpc_strategy.md
var int   tradedBLegL = na, var int  tradedBLegS = na
