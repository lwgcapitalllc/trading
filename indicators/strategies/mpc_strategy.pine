// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/ MPL-2.0
//@version=6
// [doc 1] MPC A+ STRATEGY — backtest wrapper around the MPC-JARVIS engine  -> docs/mpc_strategy.md
strategy("MPC A+ Strategy", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500, max_bars_back = 2000, initial_capital = 10000, default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 0, calc_on_every_tick = false, process_orders_on_close = false, commission_type = strategy.commission.cash_per_contract, commission_value = 0, slippage = 0, margin_long = 0.2, margin_short = 0.2)
// [doc 2] THE INPUT PANEL — one consolidated block, twelve numbered sections  -> docs/mpc_strategy.md
var string G1 = "1 · Confirmation table"
var string G2 = "2 · Market structure"
var string G3 = "3 · What trades"
var string G4 = "4 · What arms it"
var string G5 = "5 · Entry"
var string G6 = "6 · Stop & targets"
var string G7 = "7 · Filters"
var string G8 = "8 · Chart annotations"
var string G9 = "9 · Drawing: fibs"
var string G10 = "10 · Drawing: sessions"

// ── 1 · Confirmation table ──────────────────────────────────────
bool showConfTable = input.bool(false, "Show Confirmation Table", group = G1, display = display.none)

// ── 2 · Market structure ────────────────────────────────────────
bool   showExternal     = input.bool(true,      "Show External Structure", group = G2, display = display.none)
bool   showInternal     = input.bool(false,     "Show Internal Structure", group = G2, display = display.none)
bool   showHistoricalInternal = input.bool(false, "Show Historic Internal Structure", group = G2, tooltip = "Keep internal structure labels and lines from previous swing ranges on the chart. Off = only show current swing range internals.", display = display.none)
bool   showSwingLabels  = input.bool(false, "Show Swing Point Labels", group = G2, tooltip = "Off = hide ASH/ASL, HH/HL, LH/LL and the internal swing point labels, leaving only BOS/SOS and iBOS/iSOS on the chart. The structure engine keeps running exactly as before — fibs, order blocks and the confirmation table are unaffected.", display = display.none)

// ── 3 · What trades ─────────────────────────────────────────────
bool  execLongs   = input.bool(true,  "Trade longs",                    group = G3, tooltip = "On = long setups may trade. Off = shorts only.")
bool  execShorts  = input.bool(true,  "Trade shorts",                   group = G3, tooltip = "On = short setups may trade. Off = longs only.")
bool  execAplus   = input.bool(true,  "Trade A+ setups",                group = G3, tooltip = "On = the main reversal setup trades normally. Off = it never fires. Turn it off with B-Leg on to read the B leg on its own.")
bool  execBLeg    = input.bool(false, "Trade B-Leg setups",             group = G3, tooltip = "Adds a second setup: when a reversal never gets its pullback and the market runs on instead, this waits for the pullback to arrive late and buys it there. The main setup has first claim. Off by default.")
float execRiskPct = input.float(10,   "Risk % per trade",              group = G3, tooltip = "How much of the account each trade risks. Position size is worked back from this and the stop distance, so a tighter stop buys a bigger position at the same risk.", minval = 0.1, maxval = 100, step = 0.1)

// ── 4 · What arms it ────────────────────────────────────────────
bool  execArmSweep = input.bool(true, "Arm on liquidity sweep",         group = G4, tooltip = "Lets a run on the stops past a recent high or low start a setup. Turn it off, leaving divergence on, to read divergence-started setups on their own.")
bool  execArmDiv   = input.bool(false, "Arm on RSI divergence",          group = G4, tooltip = "Lets a momentum divergence start a setup. If this and the sweep trigger are both off, nothing ever trades. It does not control the veto — that has its own switch.")
bool showDivInput     = input.bool(true, "Track RSI divergence (REQUIRED — arms setups + veto)", group = G4, tooltip = "Spots momentum running out: price makes a lower low while momentum makes a higher low from oversold, or the mirror at a high. It confirms a few bars after the actual turn. Entries need this — turning it off disables both the divergence trigger and the veto.", display = display.none)
int aplusWindow = input.int(4320, "Max time: sweep → SOS (minutes)", minval = 5, maxval = 20160, group = G4, tooltip = "How long a stop run stays valid while it waits for structure to confirm. In practice a break the other way is what really cancels it, so this only clears out very old ones. 4320 = 3 days.", display = display.none)
float bLegMaxDays = input.float(1.25, "   ↳ B-Leg: days to watch for the late retrace", minval = 1, maxval = 3, step = 0.25, group = G4, active = execBLeg, tooltip = "Only used when B-Leg setups are on. How long a B leg watches its frozen band for the late retrace before it goes stale. Set in days but counted in bars, so weekends and the daily close do not burn it. 1.25 = the original 120 bars on 15m. Sweep 1 to 3.")

// ── 5 · Entry ───────────────────────────────────────────────────
bool  execReqFVG  = input.bool(true,  "Require an FVG in the zone",    group = G5, tooltip = "On = only trade when there is a gap in the pullback zone. Off = trade the pullback on its own, at the 0.618 level. Off does not switch off the gap rules below — a gap still prices the entry when there is one.")
string execNoGapArm = input.string("Any", "   ↳ No-FVG entries need", options = ["Any", "Sweep + RSI div"], group = G5, active = not execReqFVG, tooltip = "Read ONLY when Require an FVG in the zone is OFF. Which no-gap setups may fall back to the 0.618. Any = every one of them, which is what Require-FVG off did before this setting existed. Sweep + RSI div = only setups whose SOS carried BOTH a liquidity sweep and an RSI divergence. It asks what the market did at the SOS, so it is independent of the two Arm on ... toggles above and is NOT a way of saying arm on both. Measured over 6.5 years, the fallback adds 156 trades on Any and 71 on Sweep + RSI div, because the sweep-only half averages +0.007R per trade — the gate keeps the half that pays for itself once spread and commission are charged.")
bool  execFvgDeepOnly = input.bool(true, "Gap must sit fully past 0.5", group = G5, tooltip = "On = the whole gap must sit in the deep half of the pullback. Off = any gap touching the zone counts. On is stricter and takes fewer setups.")
bool  execFvgPreZone = input.bool(false, "Gap must pre-date the zone", group = G5, tooltip = "On = the gap only counts if it was already there before price pulled back this far. A gap left by the reversal candle itself is the move confirming itself.")
bool  execFibOverlap = input.bool(false, "Gap on a fib → enter on the fib", group = G5, tooltip = "Fires when a fib level sits inside the gap. On = rest the order on that level instead of at the edge of the gap, so it sits inside the gap rather than in front of it.")
bool  execFibDeepEdge = input.bool(false, "Floating gap → its own deep edge", group = G5, tooltip = "For a gap that holds no fib level and sits deeper than 0.618. On = rest the order at the far edge of the gap. It is the one deep rule that always fills, and it tested worse than the rule below. It overrides the two rules below.")
bool  execFibNearest = input.bool(true, "Floating gap → nearest fib (either side)", group = G5, active = not execFibDeepEdge, tooltip = "Same gap as the rule above. On = rest on whichever fib level is closest, above or below. It fixes a gap just short of a level being entered way back at the one before. Not free: when the deeper level wins, the order sits past the gap and a setup that only tags the gap never fills.")
bool  execDeepFib = input.bool(false, "Floating gap → nearest fib shallower", group = G5, active = not execFibDeepEdge and not execFibNearest, tooltip = "The older, one-sided version of the two rules above, kept so old results still reproduce. It only ever looks at the level just above the gap, however much closer the one below is. Only used with both rules above off.")
bool  execConfSZ  = input.bool(false, "Allow Sniper Zone as entry confirmation", group = G5, tooltip = "On = the Sniper Zone (the 0.5-0.618 pocket) also counts as entry confirmation, but only on a leg with no qualifying gap. The limit rests at the far side, around 0.618. Existing trades do not change; any new one is a leg that previously logged no FVG.")
float fvgThreshLTF = input.float(0.0, "FVG Min Gap - below 15m (% of price)", minval = 0.0, step = 0.01, group = G5, tooltip = "Minimum gap size on 1m/3m/5m charts, as a percent of price. Default 0.0 = every 3-candle imbalance counts, which is what mpc_assistant.pine does. Raise it only if the low timeframes get too noisy.", display = display.none)
float fvgThreshHTF = input.float(0.1, "FVG Min Gap - 15m and above (% of price)", minval = 0.0, step = 0.01, group = G5, tooltip = "Minimum gap size on 15m and higher, as a percent of price. Default 0.1% — UNCHANGED from before the timeframe split, so every 15m result still reproduces. Note mpc_assistant.pine uses 0.04 here; matching it would move this strategy's baseline, so it is deliberately not matched.", display = display.none)
bool  fvgReqCloseHTF  = input.bool(true, "FVG: middle bar must close past the gap (15m+)", group = G5, tooltip = "The classic FVG needs only that bar A and bar C do not overlap. This adds a stricter test: bar B must also CLOSE past the gap. It has always been on in this file and stays on at 15m and above, so results reproduce and the mpc_sos_fade parity pin still holds. Below 15m it is forced OFF regardless of this setting, matching mpc_assistant.pine.", display = display.none)
int   fvgMaxCount  = input.int(7, "Max Active FVGs", minval = 1, maxval = 20, group = G5, tooltip = "Only the newest gaps up to this count are kept; oldest are dropped first.", display = display.none)
bool  fvgKeepUntilBroken = input.bool(true, "FVG: keep until broken through (not on tap)", group = G5, tooltip = "OFF (default) = a gap is removed the moment price taps its near edge. ON = a tap no longer removes it; the gap stays alive until a candle CLOSES fully through it on the opposite (far) side. A gap that lives longer keeps its resting entry limit alive longer, so flip this to test whether it changes which entries fire.")
bool eqExemptFvg = input.bool(true, "   ↳ A gap on an EQ level survives the FVG cap", group = G5, tooltip = "ON (default) = a fair value gap sitting on an EQH/EQL is exempt from the Max Active FVGs cap and lives until price mitigates it. It is kept IN ADDITION to the newest gaps, never in place of one: the cap counts ordinary gaps only, so you always hold the full Max Active FVGs plus however many are pinned by resting liquidity. A gap backed by a live liquidity pool is worth more than a gap that is merely recent. ⚠ This changes TRADES — it changes which gaps exist, so it changes which entries fire. Every result measured before 2026-08-03 was taken with it OFF.")

// ── 6 · Stop & targets ──────────────────────────────────────────
string execSlLevel = input.string("0.886", "Stop fib level (deep side of 0.5)", options = ["0.618", "0.702", "0.786", "0.886", "1.0"], group = G6, tooltip = "How far back the stop sits. 0.886 is the tested default. 1.0 is the widest and the safest. The three tighter levels can put the stop almost on top of the entry, which blows up the position size, so turn on the minimum stop distance first. Custom takes any level you type.")
bool  execSlDeep  = input.bool(false, "   ↳ Entries at 0.786 or deeper stop at 1.0", group = G6, active = execSlLevel != "1.0", tooltip = "On = an entry that fills at 0.786 or deeper puts its stop right back at the start of the move instead. That gives it room, because those entries otherwise have very little behind them, but it costs money on every trade it touches.")
float execSlBufTk = input.float(0.0,  "Stop buffer beyond the level (ticks)",  group = G6, tooltip = "Extra room beyond the stop level, in ticks, so a wick through it does not take you out.", minval = 0)
float execTp1Pct  = input.float(0,    "TP1 size %",                    group = G6, minval = 0, maxval = 100, tooltip = "How much of the position the first target banks. 0 = bank nothing and ride it all, which tested best. The target still matters at 0 — touching it is what moves the stop to breakeven.")
float execTp2Pct  = input.float(0,    "TP2 size %",                    group = G6, minval = 0, maxval = 100, tooltip = "How much of the position the second target banks. 0 = bank nothing. Touching it still lifts the stop and hands the rest to the trail.")
float execBeBufTk = input.float(30,   "Breakeven buffer (ticks)",      group = G6, minval = 0, tooltip = "The breakeven stop sits this far past the entry, so a scratch still covers costs. It is also why TradingView reports no breakevens — those exits book a few cents, so it files them as wins. The trade label counts them honestly.")
string execRunnerTrail = input.string("Structure + % ratchet", "Runner trail method", options = ["Fixed step", "Structure (swing)", "Structure + % ratchet"], group = G6, tooltip = "How the stop follows the trade once the second target is hit, and which setting below is live. Fixed step is a plain dollar grid. Structure parks the stop at the last swing, which breathes with the trend but hands a lot back at the turn. Structure + ratchet is the default and banks more of each run.")
float execStructTrailBufTk = input.float(20, "   ↳ Structure trail buffer (ticks)", group = G6, minval = 0, active = execRunnerTrail != "Fixed step", tooltip = "Used by both structure methods. The trailing stop sits this many ticks beyond the last swing, so a wick through it does not clip you.")
float execTrailPct = input.float(1.0, "   ↳ Runner ratchet step (% of price)", group = G6, minval = 0.05, step = 0.05, active = execRunnerTrail == "Structure + % ratchet", tooltip = "How big each step of the trailing stop is, as a percent of price. A percent rather than dollars, because gold has run from 1,500 to 3,400 and a fixed amount means something different at each end. Too small and it starts cutting winners short.")
string execTp2StopMode = input.string("TP1 price", "TP2 → stop floor", options = ["TP1 price", "Breakeven", "One trail step behind"], group = G6, tooltip = "Where the stop jumps to the moment the second target is hit, before the trail takes over. TP1 price is tight and can scratch the trade on the first pullback. Breakeven gives it the most room. One trail step behind keeps it just under the best price seen. The trail can still tighten past this.")
float execTrailStep = input.float(5.0, "Runner trail step ($ of price)", group = G6, minval = 0.01, step = 0.5, tooltip = "The step size in dollars. Read by two settings, so it is never greyed out: the fixed-step trail, and the one-step-behind stop floor. On gold 1 pip is 10 cents, so 50 pips = 5.0.")
bool  execCloseOppSOS = input.bool(false, "Close on opposite SOS",      group = G6, tooltip = "On = close the trade early if structure breaks back the other way, on the view that the reversal has failed. Off = let the stop or a target resolve every trade.")
string execTimeStopMode = input.string("Before TP1 only", "Time stop", options = ["Off", "Before TP1 only", "Always"], group = G6, tooltip = "Close a trade that has been open longer than the hours set below. Before TP1 only is the tested setting: it fires only while the trade has never reached the first target, so it never cuts a winner. Always closes on the clock alone, winners included. Off closes nothing.")
float execTimeStopHrs = input.float(36.0, "   ↳ Time stop (hours)", group = G6, minval = 0.25, step = 0.25, active = execTimeStopMode != "Off", tooltip = "How long a trade may stay open, in hours, weekends included. Anything from about 24 to 40 hours gives the same answer, so read it as a range rather than an exact number. Below 16 hours it starts cutting winners, because the losers here die faster than the winners do.")

// ── 7 · Filters ─────────────────────────────────────────────────
bool  execRespectVeto = input.bool(true, "Respect divergence/extreme veto", group = G7, tooltip = "On = entries obey the veto. The veto itself is built in the RSI divergence section — switch it off there and this has nothing to obey.")
bool divVeto      = input.bool(true, "Veto setups on extreme/divergence", group = G7, active = showDivInput, tooltip = "On = block a long while a bearish divergence is live or momentum is extremely overbought, and the mirror for shorts. This is where the veto is built; the entry setting only decides whether entries obey it.", display = display.none)
bool  execHtfExhaustOnly = input.bool(false, "Only fade HTF exhaustion, not breakouts", group = G7, tooltip = "On = skip a reversal that fights a fresh higher-timeframe breakout, while still taking one that fades an exhausted move. Off = no higher-timeframe filter, and the setting below greys out.")
string execHtfSource = input.string("Weekly", "   ↳ HTF exhaustion source", options = ["Weekly", "Daily", "Either"], group = G7, active = execHtfExhaustOnly, tooltip = "Which higher timeframe the breakout check reads. Weekly blocks the fewest trades. Either blocks the most.")
string execHtfWeekly = input.string("Ignore", "Weekly bias requirement", options = ["Ignore", "Must agree", "Must not oppose", "Must oppose (reversal)"], group = G7, tooltip = "Whether the weekly trend has to agree with the trade. Ignore = no filter. Must agree = weekly matches the trade. Must not oppose = neutral is fine. Must oppose = weekly has to be against it.")
string execHtfDaily  = input.string("Ignore", "Daily bias requirement",  options = ["Ignore", "Must agree", "Must not oppose", "Must oppose (reversal)"], group = G7, tooltip = "The same four choices, judged on the daily trend. Ignore = off.")
bool  execNoLateDay = input.bool(true, "No entries in the final hour (16:00-17:00 NY)", group = G7, tooltip = "On = no new entries in the last hour before the daily close. Gold closes at 17:00 New York and reopens at 18:00, so a trade opened late can be gapped out over the break.")
string execMinStopMode = input.string("% of price", "Minimum stop distance", options = ["Off", "% of price", "Fixed $", "x ATR(14)"], group = G7, tooltip = "Skip a setup whose stop sits closer to the entry than the floor below. Size is risk divided by stop distance, so a stop that collapses onto the entry does not risk less — it builds a huge position. Percent of price keeps scaling as gold rises; ATR is the wrong tool here, because the dangerous stops appear on quiet bars.")
float execMinStopVal = input.float(0.08, "   ↳ Minimum stop floor (unit = mode above)", group = G7, minval = 0, step = 0.01, active = execMinStopMode != "Off", tooltip = "The floor itself. The unit follows the setting above — a percent, dollars of price, or an ATR multiple. Higher refuses more setups.")

// ── 8 · Chart annotations ───────────────────────────────────────
bool  execShowConfLabel = input.bool(true, "Show entry confluence label", group = G8, tooltip = "Prints one label per trade, with the full confluence breakdown in its hover tooltip. On close it recolours by result and appends the R the trade made.")
string execLabelWhich = input.string("All", "   ↳ keep labels for which results", options = ["All", "Wins only", "Losses only", "Losses + breakevens", "None"], group = G8, active = execShowConfLabel, tooltip = "Which trades keep their label once the result is known. Every other label is deleted on the bar the trade closes, so the coloured result box and entry marker stay but the annotation goes. Losses + breakevens is the review view.")
float execLabelOff = input.float(6, "   ↳ label distance from price (ATR)", group = G8, minval = 1, maxval = 40, step = 1, active = execShowConfLabel, tooltip = "How far the label sits from the entry, in ATRs. This is the only lever on where the hover tooltip opens — push the label out and the tooltip lands over empty space instead of over the candles. A leader line always connects it back to the entry.")
bool  execShowPosBox = input.bool(true, "Show position box (result)", group = G8, tooltip = "One box per trade, growing right while it is open. On close it paints the result: green from entry to the best price actually filled, red to the stop fill on a loss, an orange line at entry on a breakeven. Replaces TradingView's built-in trade markers.")
bool  execShowExitLines = input.bool(true, "   ↳ Label the TP bands (TP1/TP2/TP3)", group = G8, active = execShowPosBox, tooltip = "Adds a faint dashed line at each partial exit's real fill price, tagged TP1 / TP2 / TP3 at the right edge of the trade. Off = the coloured bands still paint, just untagged.")
float execBeBandR  = input.float(0.15, "Breakeven band (R)",           group = G8, minval = 0, step = 0.05, tooltip = "A closed trade whose net result lands inside +/- this many R counts as a BREAKEVEN — price went out, came back to entry, and the trade was closed for nothing. 0.15R on a 1%-risk account is +/- 0.15% of equity, small enough that it is noise rather than an outcome.")
bool showBlockTag = input.bool(true, "Mark blocked trades on chart (pink)", group = G8, tooltip = "Drops a pink 'TRADE BLOCKED' tag whenever a setup had everything it needed to rest its entry limit and one of YOUR rules stopped it — the final-hour rule, the divergence / extreme-RSI veto, either HTF filter, a disabled direction, or a disabled arm source. Hover the tag for the reason and the price the limit would have rested at. This is how you find out whether a blocking rule is saving you money or costing it: count the tags, flip the rule off, re-run, compare. Purely cosmetic — it never changes a trade.")
bool debugShow23 = input.bool(true, "Show missed setups (2 of 3 or better)", group = G8, tooltip = "Drops one orange callout on every 2-of-3-or-better setup that never became a trade, listing MET / MISSING confluences and the would-be entry price in its tooltip. Which confluences count is read from your inputs. Purely cosmetic — never changes trade results.")
bool debugShow23Disarmed = input.bool(false, "…include ones armed by a disabled source", group = G8, tooltip = "Off (default) = only show missed setups whose arm source you actually have enabled. On = also show setups armed by the source you switched off, so you can see what the other arm trigger would have caught. Expect a lot more boxes with this on.")
string debug23Filter = input.string("Near misses only", "Which misses to draw", options = ["Near misses only", "All misses", "3-of-3 only"], group = G8, tooltip = "Near misses only (default) = reached the zone and failed on the FVG, or met all three and still did not fill. 3-of-3 only = fully qualified but no trade. All misses = everything from 2 of 3 up.")
int    debugDays = input.int(3, "Only draw debug callouts from the last N days (0 = all)", group = G8, minval = 0, maxval = 365, tooltip = "Callouts older than this are not drawn. You are almost never studying a miss from three weeks ago while reading this week's price action, and the old ones are what turn the chart into a wall of boxes. Set 0 to draw the entire history. Applies ONLY to the missed-setup callouts — every real trade always gets its label, however old.")

// ── 9 · Drawing: fibs ───────────────────────────────────────────
bool drawFibs = input.bool(false, "Draw the fib levels", group = G9, tooltip = "Draws the external fib ladder — the entry, stop and target levels — on the chart. OFF by default: the levels are COMPUTED whatever this says, because they price every trade, and this only decides whether you look at them. The old Show External Fib (REQUIRED) checkbox is gone — it gated the calculation, so switching it off stopped the bot trading.")

// ── 10 · Drawing: sessions ──────────────────────────────────────
bool showSessionsInput         = input.bool(false,  "Show Sessions",      group = G10, display = display.none)

// [doc 3] Four corners, not nine (Aaron, 2026-08-04) — synced from mpc_assistant.p  -> docs/mpc_strategy.md
string tablePositionInput = "Top Right"
string tableSizeInput = "Small"

// [doc 4] The `=>` fallback on each is doing real work now that options have been   -> docs/mpc_strategy.md
f_tablePosition(string opt) =>
    switch opt
        "Top Right"     => position.top_right
        "Top Left"      => position.top_left
        "Bottom Right"  => position.bottom_right
        "Bottom Left"   => position.bottom_left
        => position.top_right

f_tableSize(string opt) =>
    switch opt
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        => size.normal


// [doc 5] SMC SETTINGS (hardcoded)  -> docs/mpc_strategy.md
int   majorLength = 15
color bullColor   = color.blue
color bearColor   = color.red
color iBullColor  = bullColor
color iBearColor  = bearColor

// [doc 6] MARKET STRUCTURE LABEL SIZE  -> docs/mpc_strategy.md
string structLabelSize  = "Small"
float  pbBuffer         = 0.0

f_structSize() =>
    not showExternal ? size.auto : structLabelSize == "Tiny" ? size.tiny : structLabelSize == "Normal" ? size.normal : structLabelSize == "Large" ? size.large : structLabelSize == "Huge" ? size.huge : size.small

// [doc 7] Swing-point labels are hidden by making their text transparent, not by s  -> docs/mpc_strategy.md
f_swingCol(color c) =>
    showSwingLabels ? c : color(na)

// [doc 8] (ORDER BLOCKS, VWAP and the Session Volume Profile / MV line were REMOVE  -> docs/mpc_strategy.md
bool showFVG = true   // CALCULATION, permanently on — see the panel contract in CLAUDE.md
bool  fvgDirOnly   = false
color fvgBullColor = color.new(color.gray, 80)
color fvgBearColor = color.new(color.gray, 80)
// [doc 9] Minimum gap size floor: a gap must be at least this % of price to count.  -> docs/mpc_strategy.md
bool  fvgIsLTF     = timeframe.in_seconds() < 900
float fvgThreshPct = fvgIsLTF ? fvgThreshLTF : fvgThreshHTF
// [doc 10] Middle-bar close-cleared test. mpc_assistant.pine has this OFF at every  -> docs/mpc_strategy.md
bool  fvgRequireClose = fvgIsLTF ? false : fvgReqCloseHTF

// [doc 11] A+ SETUP SEQUENCE INPUTS  -> docs/mpc_strategy.md

// [doc 12] A+ DEBUG (bar-replay diagnostics — no effect on trades)  -> docs/mpc_strategy.md

// [doc 13] RSI DIVERGENCE INPUTS  -> docs/mpc_strategy.md
bool showDiv = showDivInput
bool showDivHistory   = true
int  divMaxCount = 10
int  divRsiLen   = 14
int  divPivotLen = 5
int  divOS       = 25
int  divOB       = 75
int  divValidBars = 100
int  divExtremeOB = 80
int  divExtremeOS = 20

// [doc 14] TRADING SESSIONS INPUTS  -> docs/mpc_strategy.md
bool showSessions = showSessionsInput
bool showSessionNames     = false
bool showHistoricSessions = false

bool showSessionOC        = false
bool showSessionTickRange = false
bool showSessionAverage   = false

const string TZ_TOOLTIP_TEXT = "The session's time zone, specified in either GMT notation (e.g., 'GMT-5') or as an IANA time zone database name (e.g., 'America/New_York')."
 + " We recommend the latter since it includes other time-related changes, such as daylight savings."

showFirst         = true
firstSessionName  = "Tokyo"
firstSessionTime  = "0900-1800"
firstSessionTZ    = "Asia/Tokyo"
firstSessionColor = color.new(#FF5252, 92)

showSecond         = true
secondSessionName  = "London"
secondSessionTime  = "0800-1700"
secondSessionTZ    = "Europe/London"
secondSessionColor = color.new(#2962FF, 92)

showThird         = true
thirdSessionName  = "New York"
thirdSessionTime  = "0800-1700"
thirdSessionTZ    = "America/New_York"
thirdSessionColor = color.new(#FFEB3B, 90)

// [doc 15] (Kill Zones & NY Range were REMOVED 2026-07-22 — the script had gone ove  -> docs/mpc_strategy.md

// [doc 16] LIQUIDITY LEVELS INPUTS  -> docs/mpc_strategy.md
bool i_showLiquidity = true   // CALCULATION, permanently on — it arms every sweep
var i_showLabels       = true
string liqLabelSize    = "Small"
bool i_currentDayOnly  = true   // always hide mitigated on new day
bool i_showMitigated   = false  // never show mitigated dotted lines

f_liqSize() =>
    liqLabelSize == "Tiny" ? size.tiny : liqLabelSize == "Normal" ? size.normal : liqLabelSize == "Large" ? size.large : liqLabelSize == "Huge" ? size.huge : size.small

