//@version=6
// [doc 1] MPC D STRATEGY — "D as in dog, the dirty one" (Aaron, 2026-08-06).  -> docs/mpc_d_strategy.md
strategy("MPC D Strategy Export", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500, initial_capital = 100000, default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 0, process_orders_on_close = true, margin_long = 0.2, margin_short = 0.2, max_bars_back = 300)
// [doc 2] THE INPUT PANEL — one consolidated block, twelve numbered sections  -> docs/mpc_d_strategy.md
var string G2 = "2 · Market structure"
var string G3 = "3 · What trades"
var string G4 = "4 · What arms it"
var string G5 = "5 · Entry"
var string G6 = "6 · Stop & targets"
var string G7 = "7 · Filters"
var string G8 = "8 · Chart annotations"

// ── 2 · Market structure ────────────────────────────────────────
bool   showExternal     = input.bool(true,      "Show External Structure", group = G2, display = display.none)
bool   showInternal     = input.bool(false,     "Show Internal Structure", group = G2, display = display.none)
bool   showHistoricalInternal = input.bool(false, "Show Historic Internal Structure", group = G2, tooltip = "On keeps internal labels from past swings. Off shows only the current swing's.", display = display.none)
bool   showSwingLabels  = input.bool(false, "Show Swing Point Labels", group = G2, tooltip = "Off hides the swing point labels, leaving just BOS and SOS. Nothing else changes.", display = display.none)

// ── 3 · What trades ─────────────────────────────────────────────
bool  execLongs   = input.bool(true,  "Trade longs",  group = G3, tooltip = "Lets long setups trade. Off = shorts only. Read at the signal, so a disabled side draws nothing either.")
bool  execShorts  = input.bool(true,  "Trade shorts", group = G3, tooltip = "Lets short setups trade. Off = longs only.")
string execSizeMode = input.string("Risk % of equity", "Position sizing", options = ["Risk % of equity", "Fixed contracts"], group = G3, tooltip = "Risk % sizes every trade so the entry-to-stop distance costs the same fraction of the account. Fixed contracts does not.")
float execRiskPct  = input.float(1.0, "   ↳ Risk % per trade", group = G3, minval = 0.1, maxval = 100, step = 0.1, active = execSizeMode == "Risk % of equity", tooltip = "How much of the account each trade risks. A tighter stop buys a bigger position at the same risk.")
float execFixedQty = input.float(1.0, "   ↳ Contracts", group = G3, minval = 0.01, step = 0.01, active = execSizeMode == "Fixed contracts", tooltip = "A flat position size, ignoring the stop distance.")

// ── 4 · What arms it ────────────────────────────────────────────
int dTrendBosMin = input.int(1, "Trend must have printed at least N BOS", group = G4, minval = 0, maxval = 5, tooltip = "How mature the trend being returned to had to be. 0 accepts a trend that only ever printed its opening break.")
int dCtrBosMax   = input.int(1, "Shakeout may print at most N BOS", group = G4, minval = 0, maxval = 5, tooltip = "How much the shakeout may break in its own direction before it stops being a shakeout and counts as a real new trend.")
int dCtrBarsMax  = input.int(133, "Shakeout max length (bars)", group = G4, minval = 5, tooltip = "How long the shakeout may last before the sequence goes stale. Counted in bars, so it means a different amount of time on every chart.")

// ── 5 · Entry ───────────────────────────────────────────────────
string execEntryMode = input.string("VWAP side", "Entry", options = ["SOS close", "Retrace", "VWAP side"], group = G5, tooltip = "When to enter. VWAP side enters on the first close back on the trend's own side of VWAP, which is earlier and cheaper than waiting for the break.")
float execRetraceFib = input.float(0.5, "   ↳ Retrace level", group = G5, minval = 0.1, maxval = 0.9, step = 0.05, active = execEntryMode == "Retrace", tooltip = "How deep into the reclaim leg the limit rests. 0.5 is the midpoint.")
int   execLimitBars = input.int(20, "   ↳ Cancel an unfilled limit after N bars", group = G5, minval = 1, active = execEntryMode == "Retrace", tooltip = "Cancels a resting order price never came back to, so it cannot fill days later on an unrelated move.")
bool execVwapReclaim = input.bool(true, "   ↳ VWAP side: require the RECLAIM, not just the side", group = G5, active = execEntryMode == "VWAP side", tooltip = "On = price must first close on the wrong side of VWAP, and the close back across it is the entry.")

// ── 6 · Stop & targets ──────────────────────────────────────────
string execSlMode = input.string("Sweep extreme", "Stop anchor", options = ["Sweep extreme", "Counter-SOS line", "Between the two", "% of entry-to-sweep"], group = G6, tooltip = "Where the stop sits. Sweep extreme is widest and the honest invalidation; the counter-SOS line is tighter but sits inside the shakeout.")
float execSlPct   = input.float(50, "   ↳ Stop percent", group = G6, minval = 0, maxval = 100, step = 5, active = execSlMode == "Between the two" or execSlMode == "% of entry-to-sweep", tooltip = "For 'Between the two': 0 = on the counter-SOS line, 100 = at the sweep extreme. For '% of entry-to-sweep': smaller is tighter.")
float execSlBufTk = input.float(0, "Stop buffer beyond the anchor (ticks)", group = G6, minval = 0, tooltip = "Extra room past whichever anchor you chose, so a wick that retests the level does not clip you.")
float execTp1R = input.float(1.0, "TP1 distance (R)", group = G6, minval = 0, step = 0.25, tooltip = "First target, as a multiple of the entry-to-stop distance. The price matters even at 0% size - touching it moves the stop to breakeven.")
float execTp2R = input.float(2.0, "TP2 distance (R)", group = G6, minval = 0, step = 0.25, tooltip = "Second target, in R. Touching it lifts the stop to its floor and hands the runner to the trail.")
float execTp3R = input.float(0, "TP3 distance (R)", group = G6, minval = 0, step = 0.25, tooltip = "Where the runner's limit sits. 0 = no limit at all, so the trailing stop alone resolves the runner.")
float execTp1Pct = input.float(0, "   ↳ TP1 size %", group = G6, minval = 0, maxval = 100, tooltip = "How much of the position the first target banks. 0 = ride the whole position to the runner trail.")
float execTp2Pct = input.float(0, "   ↳ TP2 size %", group = G6, minval = 0, maxval = 100, tooltip = "How much the second target banks, as a percent of the original position. 0 = bank nothing.")
float execBeBufTk = input.float(30, "Breakeven buffer (ticks)", group = G6, minval = 0, tooltip = "How far past the entry the breakeven stop sits, so a scratch still covers costs.")
string execTp2StopMode = input.string("TP1 price", "TP2 → stop floor", options = ["TP1 price", "Breakeven", "One trail step behind"], group = G6, tooltip = "What the stop floor becomes the instant TP2 is reached. TP1 is tight and can scratch the runner; breakeven gives it the most room.")
string execRunnerTrail = input.string("Structure + % ratchet", "Runner trail method", options = ["Fixed step", "Structure (swing)", "Structure + % ratchet"], group = G6, tooltip = "How the runner is trailed once TP2 is reached. Fixed step is a dollar grid; structure parks the stop at the last confirmed swing.")
float execStructTrailBufTk = input.float(20, "   ↳ Structure trail buffer (ticks)", group = G6, minval = 0, active = execRunnerTrail != "Fixed step", tooltip = "The runner stop sits this many ticks beyond the last confirmed swing, so a wick through it does not clip the trade.")
float execTrailPct = input.float(1.0, "   ↳ Runner ratchet step (% of price)", group = G6, minval = 0.05, step = 0.05, active = execRunnerTrail == "Structure + % ratchet", tooltip = "The stop climbs one step of this size per step of favourable move, as a percent of price.")
float execTrailStep = input.float(5.0, "Runner trail step ($ of price)", group = G6, minval = 0.01, step = 0.5, tooltip = "The step size in dollars. On gold 1 pip is 10 cents of price, so 50 pips = 5.0.")
bool  execCloseOppSOS = input.bool(false, "Close on opposite SOS", group = G6, tooltip = "On = force-close the trade if a break fires against it. Off = let the stop or a target resolve every trade.")
string execTimeStopMode = input.string("Before TP1 only", "Time stop", options = ["Off", "Before TP1 only", "Always"], group = G6, tooltip = "Closes a trade that has been open for the hours below. Before TP1 only fires while the trade has never touched TP1.")
float execTimeStopHrs = input.float(36.0, "   ↳ Time stop (hours)", group = G6, minval = 0.25, step = 0.25, active = execTimeStopMode != "Off", tooltip = "Calendar hours since the fill, weekends included - the same clock a swap is charged on.")

// ── 7 · Filters ─────────────────────────────────────────────────
bool execVwapReq = input.bool(false, "Require close on the pro-trend side of VWAP", group = G7, tooltip = "Refuse a setup whose entry bar does not close on the trend's own side of VWAP.")
bool execVwapSlope = input.bool(false, "   ↳ and VWAP itself sloping with the trend", group = G7, active = execVwapReq or execEntryMode == "VWAP side", tooltip = "Also require the VWAP line itself to be rising for a long and falling for a short.")
int execVwapSlopeBars = input.int(4, "   ↳ slope measured over N bars", group = G7, minval = 1, maxval = 200, active = execVwapSlope and (execVwapReq or execEntryMode == "VWAP side"), tooltip = "How far back the slope is measured. 4 is one hour on 15m. In bars, so re-check it when you change timeframe.")
string execMinStopMode = input.string("% of price", "Minimum stop distance", options = ["Off", "% of price", "Fixed $", "x ATR(14)"], group = G7, tooltip = "Skip a setup whose stop sits closer to the entry than the floor below.")
float execMinStopVal = input.float(0.08, "   ↳ Minimum stop floor (unit = mode above)", group = G7, minval = 0, step = 0.01, active = execMinStopMode != "Off", tooltip = "The floor itself. A percent of price, dollars, or an ATR multiple, following the mode above.")

// ── 8 · Chart annotations ───────────────────────────────────────
bool  execShowConfLabel = input.bool(true, "Show entry callout", group = G8, tooltip = "One label per trade with the full breakdown in its hover. It recolours by result and shows the R on close.")
string execLabelWhich = input.string("All", "   ↳ keep callouts for which results", options = ["All", "Wins only", "Losses only", "Losses + breakevens", "None"], group = G8, active = execShowConfLabel, tooltip = "Which trades keep their callout once the result is known. The rest are deleted on the bar they close.")
float execLabelOff = input.float(6, "   ↳ callout distance from price (ATR)", group = G8, minval = 1, maxval = 40, step = 1, active = execShowConfLabel, tooltip = "How far the callout sits from the entry, in ATRs. Push it out so the hover opens over empty space instead of the candles.")
bool  execShowPosBox = input.bool(true, "Show position blocks", group = G8, tooltip = "Draws the red risk block from entry to the live stop, and the green reward blocks out to each target.")
bool  execShowExitLines = input.bool(true, "   ↳ Tag the targets when reached", group = G8, active = execShowPosBox, tooltip = "Marks the bar each target was reached, so which rungs paid is readable straight off the chart.")
bool  execShowShakeout = input.bool(true, "   ↳ Shade the shakeout", group = G8, active = execShowPosBox, tooltip = "Shades the move the tool called a shakeout, so you can see which one it picked.")
bool execShowVwap = input.bool(true, "Draw the VWAP line", group = G8, tooltip = "Plots the session VWAP the entry mode and the filter read. Leave it on whenever VWAP is gating anything.")
float execBeBandR = input.float(0.15, "Breakeven band (R)", group = G8, minval = 0, step = 0.05, tooltip = "A trade finishing within this many R of flat counts as a breakeven rather than a win or a loss.")
bool showBlockTag = input.bool(false, "Mark blocked setups on chart (pink)", group = G8, tooltip = "Drops a pink tag whenever a setup was structurally valid and one of your gates refused it. Hover for the reason.")
bool showStatePanel = input.bool(true, "Show state panel", group = G8, tooltip = "Live read of the gates: how mature the trend is, how far the sequence has got, and what it is waiting for.")
int  debugDays = input.int(0, "   ↳ only tag the last N days (0 = all)", group = G8, minval = 0, maxval = 365, active = showBlockTag, tooltip = "Only tag the last N days. 0 = the whole history. Real trades always keep their callout.")

// [doc 3] SMC SETTINGS (hardcoded)  -> docs/mpc_d_strategy.md
int   majorLength = 15
color bullColor   = color.blue
color bearColor   = color.red
color iBullColor  = bullColor
color iBearColor  = bearColor

// [doc 4] MARKET STRUCTURE — input selection (mirrors mpc_assistant.pine's GRP_STR  -> docs/mpc_d_strategy.md
string structLabelSize  = "Small"
float  pbBuffer         = 0.0

f_structSize() =>
    not showExternal ? size.auto : structLabelSize == "Tiny" ? size.tiny : structLabelSize == "Normal" ? size.normal : structLabelSize == "Large" ? size.large : structLabelSize == "Huge" ? size.huge : size.small

// [doc 5] Swing-point labels are hidden by making their text transparent, not by s  -> docs/mpc_d_strategy.md
f_swingCol(color c) =>
    showSwingLabels ? c : color(na)

// [doc 6] SMC STRUCTURE TYPE  -> docs/mpc_d_strategy.md
type SMCStructure
    int    length
    float  ash             = na
    int    ash_loc         = na
    string ash_type        = ""
    line   ash_line        = na
    label  ash_lbl         = na
    float  asl             = na
    int    asl_loc         = na
    string asl_type        = ""
    line   asl_line        = na
    label  asl_lbl         = na
    float  last_conf_high     = na
    int    last_conf_high_loc = na
    float  last_conf_low      = na
    int    last_conf_low_loc  = na
    int    dir            = 0
    bool   choch_lock     = false
    line   choch_ref      = na
    int    pb_mode        = 0
    int    pb_count       = 0
    float  pb_level       = na
    float  pb_extreme     = na
    int    pb_extreme_loc = na
    line   pb_line        = na
    bool   pb_started     = false
    float  pb_last_qualify_close = na
    float  pb_last_qualify_high  = na
    float  pb_extreme_close      = na
    float  prev_close     = na
    float  prev_high      = na
    float  prev_low       = na
    bool   seeded         = false
    bool   bull_bos       = false
    float  bull_bos_high  = na
    int    bull_bos_h_loc = na
    float  bull_bos_low   = na
    int    bull_bos_l_loc = na
    bool   bear_bos       = false
    float  bear_bos_high  = na
    int    bear_bos_h_loc = na
    float  bear_bos_low   = na
    int    bear_bos_l_loc = na
    bool   new_swing_high = false
    bool   new_swing_low  = false
    bool   bull_sos       = false
    bool   bear_sos       = false

// prefix: "" for external, "i" for internal
// bull_col / bear_col allow per-instance colors
method create_ash(SMCStructure st, float val, int loc, color col, bool solid, string prefix) =>
    if not na(st.ash_line)
        line.delete(st.ash_line)
    if not na(st.ash_lbl)
        label.delete(st.ash_lbl)
        st.ash_lbl := na
    st.ash      := val
    st.ash_loc  := loc
    st.ash_type := ""
    st.ash_lbl  := label.new(loc, val, prefix + "ASH\n", color=color(na), textcolor=f_swingCol(col), style=label.style_label_down, size=f_structSize())
    st.ash_line := line.new(loc, val, bar_index, val, color=col, style=solid ? line.style_solid : line.style_dashed, width=solid ? 2 : 1)

method create_asl(SMCStructure st, float val, int loc, color col, bool solid, string prefix) =>
    if not na(st.asl_line)
        line.delete(st.asl_line)
    if not na(st.asl_lbl)
        label.delete(st.asl_lbl)
        st.asl_lbl := na
    st.asl      := val
    st.asl_loc  := loc
    st.asl_type := ""
    st.asl_lbl  := label.new(loc, val, "\n" + prefix + "ASL", color=color(na), textcolor=f_swingCol(col), style=label.style_label_up, size=f_structSize())
    st.asl_line := line.new(loc, val, bar_index, val, color=col, style=solid ? line.style_solid : line.style_dashed, width=solid ? 2 : 1)

// process() now accepts prefix + bull/bear colors so both instances share one method
method process(SMCStructure st, float ph_val, float pl_val, string prefix, color bull_col, color bear_col) =>

    st.bull_bos := false
    st.bear_bos := false
    st.new_swing_high := false
    st.new_swing_low  := false
    st.bull_sos := false
    st.bear_sos := false

    bool is_inside = false
    if not na(st.prev_high) and not na(st.prev_low)
        is_inside := high < st.prev_high and low > st.prev_low

    if st.choch_lock
        if st.dir == 1 and not na(pl_val)
            st.choch_lock := false
        else if st.dir == -1 and not na(ph_val)
            st.choch_lock := false

    if st.pb_mode == 1
        if not st.pb_started
            st.pb_started            := true
            st.pb_extreme            := high
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_count              := 0
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
        else
            bool extreme_updated_1 = false
            if na(st.pb_extreme) or high > st.pb_extreme
                st.pb_extreme            := high
                st.pb_extreme_loc        := bar_index
                st.pb_extreme_close      := na
                st.pb_count              := 0
                st.pb_last_qualify_close := na
                st.pb_last_qualify_high  := na
                extreme_updated_1        := true
            bool extreme_is_bearish_1 = extreme_updated_1 and close < open
            bool is_candle1_1 = na(st.pb_last_qualify_close) and not extreme_updated_1
            if (not is_inside or is_candle1_1) and (not extreme_updated_1 or extreme_is_bearish_1)
                float threshold = na(st.pb_last_qualify_high) ? st.pb_extreme : st.pb_last_qualify_high
                if close < threshold - pbBuffer
                    st.pb_count              += 1
                    st.pb_last_qualify_close := close
                    st.pb_last_qualify_high  := low
            if st.pb_count >= 3 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
                if not na(st.ash_line)
                    line.delete(st.ash_line)
                if not na(st.ash_lbl)
                    label.delete(st.ash_lbl)
                st.ash      := st.pb_extreme
                st.ash_loc  := st.pb_extreme_loc
                st.ash_type := "LOCKED"
                st.ash_line := line.new(st.pb_extreme_loc, st.pb_extreme, bar_index, st.pb_extreme, color=bear_col, style=line.style_solid, width=1)
                st.ash_lbl  := label.new(st.pb_extreme_loc, st.pb_extreme, prefix + "ASH\n", color=color(na), textcolor=f_swingCol(bear_col), style=label.style_label_down, size=f_structSize())
                st.new_swing_high := true
                st.pb_mode    := 0
                st.pb_count   := 0
                st.choch_lock := false

    else if st.pb_mode == -1
        if not st.pb_started
            st.pb_started            := true
            st.pb_extreme            := low
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_count              := 0
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
        else
            bool extreme_updated_m1 = false
            if na(st.pb_extreme) or low < st.pb_extreme
                st.pb_extreme            := low
                st.pb_extreme_loc        := bar_index
                st.pb_extreme_close      := na
                st.pb_count              := 0
                st.pb_last_qualify_close := na
                st.pb_last_qualify_high  := na
                extreme_updated_m1       := true
            bool extreme_is_bullish_m1 = extreme_updated_m1 and close > open
            bool is_candle1_m1 = na(st.pb_last_qualify_close) and not extreme_updated_m1
            if (not is_inside or is_candle1_m1) and (not extreme_updated_m1 or extreme_is_bullish_m1)
                float threshold = na(st.pb_last_qualify_high) ? st.pb_extreme : st.pb_last_qualify_high
                if close > threshold + pbBuffer
                    st.pb_count              += 1
                    st.pb_last_qualify_close := close
                    st.pb_last_qualify_high  := high
            if st.pb_count >= 3 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
                if not na(st.asl_line)
                    line.delete(st.asl_line)
                if not na(st.asl_lbl)
                    label.delete(st.asl_lbl)
                st.asl      := st.pb_extreme
                st.asl_loc  := st.pb_extreme_loc
                st.asl_type := "LOCKED"
                st.asl_line := line.new(st.pb_extreme_loc, st.pb_extreme, bar_index, st.pb_extreme, color=bull_col, style=line.style_solid, width=1)
                st.asl_lbl  := label.new(st.pb_extreme_loc, st.pb_extreme, "\n" + prefix + "ASL", color=color(na), textcolor=f_swingCol(bull_col), style=label.style_label_up, size=f_structSize())
                st.new_swing_low := true
                st.pb_mode    := 0
                st.pb_count   := 0
                st.choch_lock := false

    st.prev_close := close
    st.prev_high  := high
    st.prev_low   := low

    if na(st.ash) and na(st.asl) and not st.seeded
        if not na(ph_val)
            st.create_ash(ph_val, bar_index[st.length], bear_col, false, prefix)
            st.dir := -1
        else if not na(pl_val)
            st.create_asl(pl_val, bar_index[st.length], bull_col, false, prefix)
            st.dir := 1

    if not st.seeded
        if not na(st.ash) and na(st.asl)
            float seed_low = low
            int   seed_loc = bar_index
            int   lb       = math.min(bar_index, 500)
            for i = 0 to lb
                if low[i] < seed_low
                    seed_low := low[i]
                    seed_loc := bar_index - i
            if seed_low < st.ash
                st.asl      := seed_low
                st.asl_loc  := seed_loc
                st.asl_type := ""
                st.asl_line := line.new(seed_loc, seed_low, bar_index, seed_low, color=bull_col, style=line.style_dashed, width=1)
                st.asl_lbl  := label.new(seed_loc, seed_low, "\n" + prefix + "ASL", color=color(na), textcolor=f_swingCol(bull_col), style=label.style_label_up, size=f_structSize())
                st.seeded := true
        else if not na(st.asl) and na(st.ash)
            float seed_high = high
            int   seed_loc  = bar_index
            int   lb        = math.min(bar_index, 500)
            for i = 0 to lb
                if high[i] > seed_high
                    seed_high := high[i]
                    seed_loc  := bar_index - i
            if seed_high > st.asl
                st.ash      := seed_high
                st.ash_loc  := seed_loc
                st.ash_type := ""
                st.ash_line := line.new(seed_loc, seed_high, bar_index, seed_high, color=bear_col, style=line.style_dashed, width=1)
                st.ash_lbl  := label.new(seed_loc, seed_high, prefix + "ASH\n", color=color(na), textcolor=f_swingCol(bear_col), style=label.style_label_down, size=f_structSize())
                st.seeded := true
        else if not na(st.ash) and not na(st.asl)
            st.seeded := true

    if na(st.last_conf_high) and na(st.last_conf_low)
        if not na(ph_val) and not na(st.ash) and st.ash_type == "" and st.pb_mode == 0
            if ph_val > st.ash
                st.create_ash(ph_val, bar_index[st.length], bear_col, false, prefix)
        if not na(pl_val) and not na(st.asl) and st.asl_type == "" and st.pb_mode == 0
            if pl_val < st.asl
                st.create_asl(pl_val, bar_index[st.length], bull_col, false, prefix)

    bool ash_broken = not na(st.ash) and close > st.ash
    bool asl_broken = not na(st.asl) and close < st.asl

    if ash_broken
        st.bull_bos := true
        st.bull_bos_high  := st.ash
        st.bull_bos_h_loc := st.ash_loc

        bool was_in_bear_pb = st.pb_mode == -1 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
        st.pb_mode  := 0
        st.pb_count := 0

        bool   is_choch    = st.dir == -1
        string brk_lbl_txt = is_choch ? prefix + "SOS" : prefix + "BOS"
        if is_choch
            st.bull_sos := true
        int    mid_x       = math.round((st.ash_loc + bar_index) / 2)
        label.new(mid_x, st.ash, "\n" + brk_lbl_txt, color=color(na), textcolor=bull_col, style=label.style_label_down, size=size.tiny)

        if is_choch
            st.choch_lock := true

        bool brk_already_conf_high = (st.ash == st.last_conf_high and st.ash_loc == st.last_conf_high_loc)
        if not na(st.ash_lbl)
            label.delete(st.ash_lbl)
        if not brk_already_conf_high
            bool   brk_is_hh  = na(st.last_conf_high) or st.ash >= st.last_conf_high
            string brk_high_t = brk_is_hh ? prefix + "HH" : prefix + "LH"
            color  brk_high_c = brk_is_hh ? bull_col : bear_col
            label.new(st.ash_loc, st.ash, brk_high_t + "\n", color=color(na), textcolor=f_swingCol(brk_high_c), style=label.style_label_down, size=f_structSize())

        if not na(st.ash_line)
            line.set_style(st.ash_line, line.style_solid)
            line.set_color(st.ash_line, bull_col)
            line.set_width(st.ash_line, 2)
            line.set_x2(st.ash_line, bar_index)
            st.ash_line := na

        st.last_conf_high     := st.ash
        st.last_conf_high_loc := st.ash_loc
        st.ash_lbl            := na
        st.ash                := na
        st.dir                := 1

        if was_in_bear_pb
            st.bull_bos_low   := st.pb_extreme
            st.bull_bos_l_loc := st.pb_extreme_loc
            if not na(st.asl_line)
                line.delete(st.asl_line)
            if not na(st.asl_lbl)
                label.delete(st.asl_lbl)
            bool   pb_is_hl = is_choch ? false : (na(st.last_conf_low) or st.pb_extreme >= st.last_conf_low)
            // On an SOS (fast reversal) the extreme is only the ACTIVE swing low —
            // it prints as ASL and is confirmed to HL/LL by the NEXT bullish break.
            string pb_low_t = is_choch ? prefix + "ASL" : (pb_is_hl ? prefix + "HL" : prefix + "LL")
            color  pb_low_c = is_choch ? bull_col : (pb_is_hl ? bull_col : bear_col)
            st.asl      := st.pb_extreme
            st.asl_loc  := st.pb_extreme_loc
            st.asl_type := "LOCKED"
            st.asl_line := line.new(st.pb_extreme_loc, st.pb_extreme, bar_index, st.pb_extreme, color=bull_col, style=line.style_solid, width=1)
            st.asl_lbl  := label.new(st.pb_extreme_loc, st.pb_extreme, "\n" + pb_low_t, color=color(na), textcolor=f_swingCol(pb_low_c), style=label.style_label_up, size=f_structSize())
            if not is_choch
                st.last_conf_low     := st.pb_extreme
                st.last_conf_low_loc := st.pb_extreme_loc
            st.pb_extreme            := high
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_mode               := 1
            st.pb_started            := true
        else
            if not na(st.asl)
                bool already_conf_low = (st.asl == st.last_conf_low and st.asl_loc == st.last_conf_low_loc)
                if not already_conf_low
                    bool   old_is_hl = is_choch ? false : (na(st.last_conf_low) or st.asl >= st.last_conf_low)
                    string old_low_t = old_is_hl ? prefix + "HL" : prefix + "LL"
                    color  old_low_c = old_is_hl ? bull_col : bear_col
                    if not na(st.asl_lbl)
                        label.delete(st.asl_lbl)
                    label.new(st.asl_loc, st.asl, "\n" + old_low_t, color=color(na), textcolor=f_swingCol(old_low_c), style=label.style_label_up, size=f_structSize())
                    st.last_conf_low     := st.asl
                    st.last_conf_low_loc := st.asl_loc
                else
                    if not na(st.asl_lbl)
                        label.delete(st.asl_lbl)
                if not na(st.asl_line)
                    line.delete(st.asl_line)
                st.asl_line := na
                st.asl_lbl  := na
                st.asl      := na

            float lowest_val = low
            int   lowest_loc = bar_index
            int   bars_back  = na(st.last_conf_high_loc) ? bar_index : bar_index - st.last_conf_high_loc
            if bars_back > 0
                int max_lb = math.min(math.min(bars_back, 1490), bar_index)
                for i = 0 to max_lb
                    if low[i] < lowest_val
                        lowest_val := low[i]
                        lowest_loc := bar_index - i

            st.bull_bos_low   := lowest_val
            st.bull_bos_l_loc := lowest_loc

            st.asl      := lowest_val
            st.asl_loc  := lowest_loc
            st.asl_type := ""
            st.asl_line := line.new(lowest_loc, lowest_val, bar_index, lowest_val, color=bull_col, style=line.style_solid, width=1)
            if lowest_val != st.last_conf_low
                st.asl_lbl := label.new(lowest_loc, lowest_val, "\n" + prefix + "ASL", color=color(na), textcolor=f_swingCol(bull_col), style=label.style_label_up, size=f_structSize())
            else
                st.asl_lbl := na

            st.pb_mode               := 1
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_extreme            := high
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true

    else if asl_broken
        st.bear_bos := true
        st.bear_bos_low   := st.asl
        st.bear_bos_l_loc := st.asl_loc

        bool was_in_bull_pb = st.pb_mode == 1 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
        st.pb_mode  := 0
        st.pb_count := 0

        bool   is_choch    = st.dir == 1
        string brk_lbl_txt = is_choch ? prefix + "SOS" : prefix + "BOS"
        if is_choch
            st.bear_sos := true
        int    mid_x       = math.round((st.asl_loc + bar_index) / 2)
        label.new(mid_x, st.asl, brk_lbl_txt + "\n", color=color(na), textcolor=bear_col, style=label.style_label_up, size=size.tiny)

        if is_choch
            st.choch_lock := true

        bool brk_already_conf_low = (st.asl == st.last_conf_low and st.asl_loc == st.last_conf_low_loc)
        if not na(st.asl_lbl)
            label.delete(st.asl_lbl)
        if not brk_already_conf_low
            bool   brk_is_hl = na(st.last_conf_low) or st.asl >= st.last_conf_low
            string brk_low_t = brk_is_hl ? prefix + "HL" : prefix + "LL"
            label.new(st.asl_loc, st.asl, "\n" + brk_low_t, color=color(na), textcolor=f_swingCol(bear_col), style=label.style_label_up, size=f_structSize())

        if not na(st.asl_line)
            line.set_style(st.asl_line, line.style_solid)
            line.set_color(st.asl_line, bear_col)
            line.set_width(st.asl_line, 2)
            line.set_x2(st.asl_line, bar_index)
            st.asl_line := na

        st.last_conf_low     := st.asl
        st.last_conf_low_loc := st.asl_loc
        st.asl_lbl           := na
        st.asl               := na
        st.dir               := -1

        if was_in_bull_pb
            st.bear_bos_high  := st.pb_extreme
            st.bear_bos_h_loc := st.pb_extreme_loc
            if not na(st.ash_line)
                line.delete(st.ash_line)
            if not na(st.ash_lbl)
                label.delete(st.ash_lbl)
            bool   pb_is_hh  = na(st.last_conf_high) or st.pb_extreme >= st.last_conf_high
            // On an SOS (fast reversal) the extreme is only the ACTIVE swing high —
            // it prints as ASH and is confirmed to HH/LH by the NEXT bearish break.
            string pb_high_t = is_choch ? prefix + "ASH" : (pb_is_hh ? prefix + "HH" : prefix + "LH")
            color  pb_high_c = is_choch ? bear_col : (pb_is_hh ? bull_col : bear_col)
            st.ash      := st.pb_extreme
            st.ash_loc  := st.pb_extreme_loc
            st.ash_type := "LOCKED"
            st.ash_line := line.new(st.pb_extreme_loc, st.pb_extreme, bar_index, st.pb_extreme, color=bear_col, style=line.style_solid, width=1)
            st.ash_lbl  := label.new(st.pb_extreme_loc, st.pb_extreme, pb_high_t + "\n", color=color(na), textcolor=f_swingCol(pb_high_c), style=label.style_label_down, size=f_structSize())
            if not is_choch
                st.last_conf_high     := st.pb_extreme
                st.last_conf_high_loc := st.pb_extreme_loc
            st.pb_extreme            := low
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_mode               := -1
            st.pb_started            := true
        else
            float highest_val = high
            int   highest_loc = bar_index
            int   bars_back   = na(st.last_conf_low_loc) ? bar_index : bar_index - st.last_conf_low_loc
            if bars_back > 0
                int max_lb = math.min(math.min(bars_back, 1490), bar_index)
                for i = 0 to max_lb
                    if high[i] > highest_val
                        highest_val := high[i]
                        highest_loc := bar_index - i

            if not na(st.ash)
                bool already_conf_high = (st.ash == st.last_conf_high and st.ash_loc == st.last_conf_high_loc)
                if not already_conf_high
                    bool   old_is_hh  = is_choch ? true : (na(st.last_conf_high) or st.ash >= st.last_conf_high)
                    string old_high_t = old_is_hh ? prefix + "HH" : prefix + "LH"
                    color  old_high_c = old_is_hh ? bull_col : bear_col
                    if not na(st.ash_lbl)
                        label.delete(st.ash_lbl)
                    label.new(st.ash_loc, st.ash, old_high_t + "\n", color=color(na), textcolor=f_swingCol(old_high_c), style=label.style_label_down, size=f_structSize())
                    st.last_conf_high     := st.ash
                    st.last_conf_high_loc := st.ash_loc
                else
                    if not na(st.ash_lbl)
                        label.delete(st.ash_lbl)
                if not na(st.ash_line)
                    line.delete(st.ash_line)
                st.ash_line := na
                st.ash_lbl  := na
                st.ash      := na
            else
                // [doc 7] Neither an active pullback high nor a confirmed ASH was available to  -> docs/mpc_d_strategy.md
                bool   fallback_is_hh  = na(st.last_conf_high) or highest_val >= st.last_conf_high
                string fallback_high_t = fallback_is_hh ? prefix + "HH" : prefix + "LH"
                color  fallback_high_c = fallback_is_hh ? bull_col : bear_col
                if highest_val != st.last_conf_high
                    label.new(highest_loc, highest_val, fallback_high_t + "\n", color=color(na), textcolor=f_swingCol(fallback_high_c), style=label.style_label_down, size=f_structSize())
                    st.last_conf_high     := highest_val
                    st.last_conf_high_loc := highest_loc

            st.bear_bos_high  := highest_val
            st.bear_bos_h_loc := highest_loc

            st.ash      := highest_val
            st.ash_loc  := highest_loc
            st.ash_type := ""
            st.ash_line := line.new(highest_loc, highest_val, bar_index, highest_val, color=bear_col, style=line.style_solid, width=1)
            if highest_val != st.last_conf_high
                st.ash_lbl := label.new(highest_loc, highest_val, prefix + "ASH\n", color=color(na), textcolor=f_swingCol(bear_col), style=label.style_label_down, size=f_structSize())
            else
                st.ash_lbl := na

            st.pb_mode               := -1
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_extreme            := low
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true

    if not na(st.ash_line)
        line.set_x2(st.ash_line, bar_index)
        if not showExternal
            line.set_color(st.ash_line, color(na))
    if not na(st.asl_line)
        line.set_x2(st.asl_line, bar_index)
        if not showExternal
            line.set_color(st.asl_line, color(na))
    if not showExternal
        if not na(st.ash_lbl)
            label.set_textcolor(st.ash_lbl, color(na))
        if not na(st.asl_lbl)
            label.set_textcolor(st.asl_lbl, color(na))

// [doc 8] EXECUTION — EXTERNAL STRUCTURE  -> docs/mpc_d_strategy.md
var st = SMCStructure.new(majorLength)
ph = ta.pivothigh(high, majorLength, majorLength)
pl = ta.pivotlow(low,  majorLength, majorLength)
// showExternal off → pass color(na) so ALL lines and labels hidden inside process
// showExternal off but showExternal on → pass color(na) for labels only — handled via ASH/ASL override below
color extBullCol = showExternal ? (showExternal ? bullColor : color(na)) : color(na)
color extBearCol = showExternal ? (showExternal ? bearColor : color(na)) : color(na)
st.process(ph, pl, "", extBullCol, extBearCol)

// After process runs — restore line colors when labels are hidden but structure is visible
if not na(st.ash_line)
    line.set_x2(st.ash_line, bar_index)
    if showExternal and not showExternal
        line.set_color(st.ash_line, bullColor)
if not na(st.asl_line)
    line.set_x2(st.asl_line, bar_index)
    if showExternal and not showExternal
        line.set_color(st.asl_line, bearColor)
if not na(st.ash_lbl)
    label.set_textcolor(st.ash_lbl, showExternal ? f_swingCol(bearColor) : color(na))
if not na(st.asl_lbl)
    label.set_textcolor(st.asl_lbl, showExternal ? f_swingCol(bullColor) : color(na))

// [doc 9] EXECUTION — INTERNAL STRUCTURE  -> docs/mpc_d_strategy.md

// ── State ─────────────────────────────────────────────────
var int   i_mode           = 0
var bool  i_seeded         = false

// Pullback tracking
var float i_pb_extreme     = na
var int   i_pb_extreme_loc = na
var int   i_pb_count       = 0
var bool  i_pb_started     = false
var float i_pb_lqc         = na
var float i_pb_lqh         = na
var float i_prev_high      = na
var float i_prev_low       = na

// Active swing level (iSH or iSL)
var float i_sw_price       = na
var int   i_sw_loc         = na
var line  i_sw_line        = na
var label i_sw_lbl         = na

// Pre-declared locals (Pine v6)
var bool  i_ext_chg        = false
var bool  i_is_inside      = false
var bool  i_ext_dir        = false
var bool  i_is_c1          = false
var float i_thresh         = na

var float i_tracked_ext     = na
var int   i_tracked_ext_loc = na
var int   i_last_mode       = 0   // remembers what mode confirmed the swing
var bool  i_had_bos         = false
var int   i_bos_dir         = 0
var string i_h_lbl          = ""
var color  i_h_col          = color.black
var string i_l_lbl          = ""
var color  i_l_col          = color.black
var int   i_mid             = 0
var int   i_mid2            = 0
var float i_last_hl         = na   // last confirmed iHL price (for iSOS in bullish cycle)

var float i_last_lh         = na   // last confirmed iLH price (for iSOS in bearish cycle)
var int   i_last_hl_loc     = na
var int   i_last_lh_loc     = na

var float i_sos_watch_hh    = na
var int   i_sos_watch_hh_loc= na
var float i_sos_watch_ll    = na
var int   i_sos_watch_ll_loc= na

float i_lbl_y_offset = syminfo.mintick * 20   // vertical offset for iBOS/iSOS (smaller number = closer to the line)

// Internal structure is naturally scoped to the current active external swing —
// it resets on every external SOS/CHoCH (see block right below).
bool internalActive = showInternal

// Tracks every internal-structure label/line drawn during the current external
// swing, so they can be wiped when a new swing starts (unless showHistoricalInternal is on).
var array<label> intHistLabels = array.new<label>()
var array<line>  intHistLines  = array.new<line>()

// ── Stop internal tracking on external SOS ───────────────

if internalActive and (st.bull_bos or st.bear_bos or st.bull_sos or st.bear_sos)
    if not na(i_sw_line)
        line.set_x2(i_sw_line, bar_index)
        i_sw_line := na
    i_sw_lbl          := na
    i_sw_price        := na
    i_mode            := 0
    i_seeded          := false
    i_pb_count        := 0
    i_pb_started      := false
    i_tracked_ext     := na
    i_tracked_ext_loc := na
    i_last_hl         := na
    i_last_lh         := na
    i_had_bos         := false
    i_sos_watch_hh    := na
    i_sos_watch_ll    := na
    // Past swing just ended — wipe its internal structure unless history is enabled
    if not showHistoricalInternal
        if array.size(intHistLabels) > 0
            for i = 0 to array.size(intHistLabels) - 1
                label.delete(array.get(intHistLabels, i))
        if array.size(intHistLines) > 0
            for i = 0 to array.size(intHistLines) - 1
                line.delete(array.get(intHistLines, i))
    array.clear(intHistLabels)
    array.clear(intHistLines)

// ── Track prev bar ────────────────────────────────────────
if internalActive
    i_prev_high := high
    i_prev_low  := low


// ── Seed on new external swing ────────────────────────────
if internalActive
    if st.new_swing_low and not st.bull_sos and not st.bear_sos
        i_mode            := 1
        i_seeded          := true
        i_had_bos         := false
        i_bos_dir         := 0
        i_pb_started      := false
        i_pb_extreme      := na
        i_pb_count        := 0
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_mode       := 1
        i_last_hl         := na
        i_last_lh         := na
        i_sos_watch_hh    := na
        i_sos_watch_ll    := na
    else if st.new_swing_high and not st.bull_sos and not st.bear_sos
        i_mode            := -1
        i_seeded          := true
        i_had_bos         := false
        i_bos_dir         := 0
        i_pb_started      := false
        i_pb_extreme      := na
        i_pb_count        := 0
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_mode       := -1
        i_last_hl         := na
        i_last_lh         := na
        i_sos_watch_hh    := na
        i_sos_watch_ll    := na

// ── Mode 1: track upward move → confirm iSH ──────────────
if internalActive and i_seeded and i_mode == 1
    if not i_pb_started
        i_pb_started     := true
        i_pb_extreme     := high
        i_pb_extreme_loc := bar_index
        i_pb_count       := 0
        i_pb_lqc         := na
        i_pb_lqh         := na
    else
        // Update extreme if new high
        i_ext_chg := false
        if high > i_pb_extreme
            i_pb_extreme     := high
            i_pb_extreme_loc := bar_index
            i_pb_count       := 0
            i_pb_lqc         := na
            i_pb_lqh         := na
            i_ext_chg        := true
        // is_inside and qualifying bar checks (exact external rule)
        i_is_inside := not na(i_prev_high) and not na(i_prev_low) and high < i_prev_high and low > i_prev_low
        i_ext_dir   := i_ext_chg and close < open
        i_is_c1     := na(i_pb_lqc) and not i_ext_chg
        if (not i_is_inside or i_is_c1) and (not i_ext_chg or i_ext_dir)
            i_thresh := na(i_pb_lqh) ? i_pb_extreme : i_pb_lqh
            if close < i_thresh - pbBuffer
                i_pb_count += 1
                i_pb_lqc   := close
                i_pb_lqh   := low
        // 3 bars confirmed → iSH
        if i_pb_count >= 3 and not na(i_pb_extreme)
            if not na(i_sw_line)
                line.set_x2(i_sw_line, bar_index)
            i_sw_line  := na
            i_sw_lbl   := na
            i_sw_price := i_pb_extreme
            i_sw_loc   := i_pb_extreme_loc
            // Label: iSH if first swing, iHH if higher than last, iLH if lower
            i_h_lbl := not i_had_bos ? "iSH" : "iHH"
            i_h_col := not i_had_bos ? iBearColor : iBullColor
            i_sw_line  := line.new(i_sw_loc, i_sw_price, bar_index, i_sw_price, color = showInternal ? color.new(i_h_col, 15) : color(na), style = line.style_dotted, width = 1)
            i_sw_lbl   := label.new(i_sw_loc, i_sw_price, i_h_lbl + "\n", color = color(na), textcolor=f_swingCol(color.new(i_h_col, 15)), style = label.style_label_down, size = size.tiny)
            array.push(intHistLines, i_sw_line)
            array.push(intHistLabels, i_sw_lbl)
            i_mode       := 0
            i_pb_count   := 0
            i_pb_started := false

// ── Mode -1: track downward move → confirm iSL ───────────
if internalActive and i_seeded and i_mode == -1
    if not i_pb_started
        i_pb_started     := true
        i_pb_extreme     := low
        i_pb_extreme_loc := bar_index
        i_pb_count       := 0
        i_pb_lqc         := na
        i_pb_lqh         := na
    else
        // Update extreme if new low
        i_ext_chg := false
        if low < i_pb_extreme
            i_pb_extreme     := low
            i_pb_extreme_loc := bar_index
            i_pb_count       := 0
            i_pb_lqc         := na
            i_pb_lqh         := na
            i_ext_chg        := true
        // is_inside and qualifying bar checks
        i_is_inside := not na(i_prev_high) and not na(i_prev_low) and high < i_prev_high and low > i_prev_low
        i_ext_dir   := i_ext_chg and close > open
        i_is_c1     := na(i_pb_lqc) and not i_ext_chg
        if (not i_is_inside or i_is_c1) and (not i_ext_chg or i_ext_dir)
            i_thresh := na(i_pb_lqh) ? i_pb_extreme : i_pb_lqh
            if close > i_thresh + pbBuffer
                i_pb_count += 1
                i_pb_lqc   := close
                i_pb_lqh   := high
        // 3 bars confirmed → iSL
        if i_pb_count >= 3 and not na(i_pb_extreme)
            if not na(i_sw_line)
                line.set_x2(i_sw_line, bar_index)
            i_sw_line  := na
            i_sw_lbl   := na
            i_sw_price := i_pb_extreme
            i_sw_loc   := i_pb_extreme_loc
            // Label: iSL if first swing, iLL if lower than last, iHL if higher
            i_l_lbl := not i_had_bos ? "iSL" : "iLL"
            i_l_col := not i_had_bos ? iBullColor : iBearColor
            i_sw_line  := line.new(i_sw_loc, i_sw_price, bar_index, i_sw_price, color = showInternal ? color.new(i_l_col, 15) : color(na), style = line.style_dotted, width = 1)
            i_sw_lbl   := label.new(i_sw_loc, i_sw_price, "\n" + i_l_lbl, color = color(na), textcolor=f_swingCol(color.new(i_l_col, 15)), style = label.style_label_up, size = size.tiny)
            array.push(intHistLines, i_sw_line)
            array.push(intHistLabels, i_sw_lbl)
            i_mode       := 0
            i_pb_count   := 0
            i_pb_started := false

// ── Track extreme while watching (mode 0) ────────────────
if internalActive and i_seeded and i_mode == 0
    if i_last_mode == 1
        if na(i_tracked_ext) or low < i_tracked_ext
            i_tracked_ext     := low
            i_tracked_ext_loc := bar_index
    else if i_last_mode == -1
        if na(i_tracked_ext) or high > i_tracked_ext
            i_tracked_ext     := high
            i_tracked_ext_loc := bar_index

// ── iBOS / iSOS detection ────────────────────────────────
bool int_bull_break = false
bool int_bear_break = false
bool int_bull_bos   = false
bool int_bull_sos   = false
bool int_bear_bos   = false
bool int_bear_sos   = false
int  int_break_origin_loc = na

if internalActive and i_mode == 0 and i_seeded and not na(i_sw_price) and barstate.isconfirmed
    if close > i_sw_price and i_last_mode == 1
        i_mid := math.round((i_sw_loc + bar_index) / 2)
        label iBullBOSLbl = label.new(i_mid, i_sw_price + i_lbl_y_offset, "iBOS", color = color(na), textcolor = showInternal ? iBullColor : color(na), style = label.style_none, size = size.tiny, textalign = text.align_center)
        array.push(intHistLabels, iBullBOSLbl)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sw_line := na
        i_sw_lbl := na
        if not na(i_tracked_ext)
            line  iHLLine = line.new(i_tracked_ext_loc, i_tracked_ext, bar_index, i_tracked_ext, color = showInternal ? color.new(iBullColor, 15) : color(na), style = line.style_dotted, width = 1)
            label iHLLbl  = label.new(i_tracked_ext_loc, i_tracked_ext, "\niHL", color = color(na), textcolor=f_swingCol(color.new(iBullColor, 15)), style = label.style_label_up, size = size.tiny)
            array.push(intHistLines, iHLLine)
            array.push(intHistLabels, iHLLbl)
            i_last_hl     := i_tracked_ext
            i_last_hl_loc := i_tracked_ext_loc
        
        int_bull_break := true
        int_bull_bos   := true
        int_break_origin_loc := i_tracked_ext_loc

        i_sw_price       := na
        i_tracked_ext    := na
        i_tracked_ext_loc := na
        i_pb_count       := 0
        i_pb_started     := false
        i_pb_lqc         := na
        i_pb_lqh         := na
        i_had_bos        := true
        i_bos_dir        := 1
        i_last_mode      := 1
        i_mode           := 1
        i_sos_watch_ll   := na

    else if close < i_sw_price and i_last_mode == -1
        i_mid2 := math.round((i_sw_loc + bar_index) / 2)
        label iBearBOSLbl = label.new(i_mid2, i_sw_price, "iBOS", color = color(na), textcolor = showInternal ? iBearColor : color(na), style = label.style_label_up, size = size.tiny, textalign = text.align_center)
        array.push(intHistLabels, iBearBOSLbl)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sw_line := na
        i_sw_lbl := na
        if not na(i_tracked_ext)
            line  iLHLine = line.new(i_tracked_ext_loc, i_tracked_ext, bar_index, i_tracked_ext, color = showInternal ? color.new(iBearColor, 15) : color(na), style = line.style_dotted, width = 1)
            label iLHLbl  = label.new(i_tracked_ext_loc, i_tracked_ext, "iLH\n", color = color(na), textcolor=f_swingCol(color.new(iBearColor, 15)), style = label.style_label_down, size = size.tiny)
            array.push(intHistLines, iLHLine)
            array.push(intHistLabels, iLHLbl)
            i_last_lh     := i_tracked_ext
            i_last_lh_loc := i_tracked_ext_loc
            
        int_bear_break := true
        int_bear_bos   := true
        int_break_origin_loc := i_tracked_ext_loc

        i_sw_price        := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_pb_count        := 0
        i_pb_started      := false
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_had_bos         := true
        i_bos_dir         := -1
        i_last_mode       := -1
        i_mode            := -1
        i_sos_watch_hh    := na



// ── iSOS detection (watches last iHL / iLH) ──────────────
if internalActive and i_seeded and i_had_bos and barstate.isconfirmed
    if i_last_mode == 1 and not na(i_last_hl) and close < i_last_hl and i_mode == 0
        i_mid2 := math.round((i_last_hl_loc + bar_index) / 2)
        label iSOS1Lbl = label.new(i_mid2, i_last_hl, "iSOS", color = color(na), textcolor = showInternal ? iBearColor : color(na), style = label.style_label_up, size = size.tiny, textalign = text.align_center)
        line  iSOS1Line = line.new(i_last_hl_loc, i_last_hl, bar_index, i_last_hl, color = showInternal ? color.new(iBearColor, 15) : color(na), style = line.style_dotted, width = 1)
        array.push(intHistLabels, iSOS1Lbl)
        array.push(intHistLines, iSOS1Line)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sw_line := na
        
        i_sos_watch_hh     := i_sw_price
        i_sos_watch_hh_loc := i_sw_loc
        i_sos_watch_ll     := na
        
        int_bear_break := true
        int_bear_sos   := true
        int_break_origin_loc := i_sw_loc

        i_sw_lbl          := na
        i_sw_price        := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_hl         := na
        i_pb_count        := 0
        i_pb_started      := false
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_last_mode       := -1
        i_mode            := -1

    else if i_last_mode == -1 and not na(i_last_lh) and close > i_last_lh and i_mode == 0
        i_mid := math.round((i_last_lh_loc + bar_index) / 2)
        label iSOS2Lbl = label.new(i_mid, i_last_lh + i_lbl_y_offset, "iSOS", color = color(na), textcolor = showInternal ? iBullColor : color(na), style = label.style_none, size = size.tiny, textalign = text.align_center)
        line  iSOS2Line = line.new(i_last_lh_loc, i_last_lh, bar_index, i_last_lh, color = showInternal ? color.new(iBullColor, 15) : color(na), style = line.style_dotted, width = 1)
        array.push(intHistLabels, iSOS2Lbl)
        array.push(intHistLines, iSOS2Line)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sw_line := na
            
        i_sos_watch_ll     := i_sw_price
        i_sos_watch_ll_loc := i_sw_loc
        i_sos_watch_hh     := na
        
        int_bull_break := true
        int_bull_sos   := true
        int_break_origin_loc := i_sw_loc

        i_sw_lbl          := na
        i_sw_price        := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_lh         := na
        i_pb_count        := 0
        i_pb_started      := false
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_last_mode       := 1
        i_mode            := 1

    else if i_last_mode == -1 and not na(i_sos_watch_hh) and close > i_sos_watch_hh and i_mode == 0
        i_mid := math.round((i_sos_watch_hh_loc + bar_index) / 2)
        label iSOS3Lbl = label.new(i_mid, i_sos_watch_hh + i_lbl_y_offset, "iSOS", color = color(na), textcolor = showInternal ? iBullColor : color(na), style = label.style_none, size = size.tiny, textalign = text.align_center)
        line  iSOS3Line = line.new(i_sos_watch_hh_loc, i_sos_watch_hh, bar_index, i_sos_watch_hh, color = showInternal ? color.new(iBullColor, 15) : color(na), style = line.style_dotted, width = 1)
        array.push(intHistLabels, iSOS3Lbl)
        array.push(intHistLines, iSOS3Line)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sw_line := na
            
        i_sos_watch_ll     := i_sw_price
        i_sos_watch_ll_loc := i_sw_loc
        
        int_bull_break := true
        int_bull_sos   := true
        int_break_origin_loc := i_sw_loc

        i_sw_lbl          := na
        i_sw_price        := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_lh         := na
        i_pb_count        := 0
        i_pb_started      := false
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_last_mode       := 1
        i_mode            := 1
        i_sos_watch_hh    := na

    else if i_last_mode == 1 and not na(i_sos_watch_ll) and close < i_sos_watch_ll and i_mode == 0
        i_mid2 := math.round((i_sos_watch_ll_loc + bar_index) / 2)
        label iSOS4Lbl = label.new(i_mid2, i_sos_watch_ll, "iSOS", color = color(na), textcolor = showInternal ? iBearColor : color(na), style = label.style_label_up, size = size.tiny, textalign = text.align_center)
        line  iSOS4Line = line.new(i_sos_watch_ll_loc, i_sos_watch_ll, bar_index, i_sos_watch_ll, color = showInternal ? color.new(iBearColor, 15) : color(na), style = line.style_dotted, width = 1)
        array.push(intHistLabels, iSOS4Lbl)
        array.push(intHistLines, iSOS4Line)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sw_line := na
            
        i_sos_watch_hh     := i_sw_price
        i_sos_watch_hh_loc := i_sw_loc
        
        int_bear_break := true
        int_bear_sos   := true
        int_break_origin_loc := i_sw_loc

        i_sw_lbl          := na
        i_sw_price        := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_hl         := na
        i_pb_count        := 0
        i_pb_started      := false
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_last_mode       := -1
        i_mode            := -1
        i_sos_watch_ll    := na

// ── Update last_mode when mode changes ───────────────────
if internalActive and i_mode != 0
    i_last_mode := i_mode

// ── Extend active swing line every bar ────────────────────
if internalActive and not na(i_sw_line)
    line.set_x2(i_sw_line, bar_index)

// [doc 10] D SETUP — the sequence gates  -> docs/mpc_d_strategy.md

// [doc 11] STRATEGY EXECUTION  -> docs/mpc_d_strategy.md


// [doc 12] ── WHERE THE STOP GOES. Four anchors, and they are genuinely different t  -> docs/mpc_d_strategy.md

// [doc 13] ⚠ THE MINIMUM STOP GUARD IS ON BY DEFAULT AND MUST STAY THAT WAY WHILE A  -> docs/mpc_d_strategy.md


// [doc 14] ⚠ A RUNG SIZED 0% IS SKIPPED, NEVER PLACED. strategy.exit() reads qty_pe  -> docs/mpc_d_strategy.md

// [doc 15] ── THE RUNNER TRAIL, ported from mpc_strategy.pine's exit ladder ──  -> docs/mpc_d_strategy.md



// [doc 16] D DEBUG  -> docs/mpc_d_strategy.md

// [doc 17] RESULT STATS  -> docs/mpc_d_strategy.md


// [doc 18] VWAP — the pro-trend side test  -> docs/mpc_d_strategy.md

// [doc 19] THE ANNOTATION PALETTE — copied from mpc_strategy.pine, never chosen her  -> docs/mpc_d_strategy.md

// ── Trade results. One hue per verdict, and the transparency is part of the standard. ──
color POS_WIN   = color.new(#26A69A, 12)   // a closed winner's callout
color POS_WINL  = color.new(#26A69A, 0)    // ...and its leader line
color POS_LOSS  = color.new(#EF5350, 12)
color POS_LOSSL = color.new(#EF5350, 0)
color POS_BE    = color.new(#FF9800, 12)   // BREAKEVEN — orange. It was yellow here, and
color POS_BEL   = color.new(#FF9800, 0)    // yellow is the panel's "Armed" colour.
// [doc 20] ⚠ GREY WHILE THE TRADE IS STILL OPEN, and that is a rule rather than a s  -> docs/mpc_d_strategy.md
color POS_OPEN  = color.new(#787B86, 12)
color POS_OPENL = color.new(#787B86, 0)

// ── The position blocks. ──
color POS_DD    = color.new(#EF5350, 88)   // risk / how far it went AGAINST you — sits
                                           // behind everything, barely there
color POS_G1    = color.new(#26A69A, 55)   // one hue, three depths — the gradient IS the
color POS_G2    = color.new(#26A69A, 70)   // legend, so no reward block needs a label
color POS_G3    = color.new(#26A69A, 82)
// [doc 21] ⚠ A+ HAS NO "TARGET NOT REACHED YET" STATE, because it draws its bands a  -> docs/mpc_d_strategy.md
color POS_GHOST  = color.new(#26A69A, 90)
color TP_ANNOT   = color.new(#26A69A, 40)  // ONE colour for every TP tag and its line
// [doc 22] A+'s solid entry-marker pair, and it is DRAWN here as of 2026-08-12 — th  -> docs/mpc_d_strategy.md
color POS_GREENB = color.new(#26A69A, 0)
color POS_REDB   = color.new(#EF5350, 0)
color POS_SHADE  = color.new(#787B86, 88)  // the shakeout — A+'s neutral grey, not #888888

// ── Refusals — already identical to A+, left alone. ──
color BLK_PINK  = color.new(#FF2E9A, 12)
color BLK_PINKL = color.new(#FF2E9A, 0)

// [doc 23] ── The STATE PANEL palette — A+'s JARVIS table colours, and correct wher  -> docs/mpc_d_strategy.md
color D_LONG  = #00E676   // A+ JARVIS_SSL
color D_SHORT = #FF5252   // A+ JARVIS_BSL
color D_MUTED = #94A3B8   // A+ JARVIS_MUTED

// [doc 24] D SEQUENCE — state machine  -> docs/mpc_d_strategy.md
var int   dTrendDir = 0
var int   dTrendBos = 0
var int   dCurBos   = 0     // BOS printed since the current direction was established
var int   dSosBar   = na    // bar of the most recent SOS
// [doc 25] Running extremes of the leg since that SOS. dLegLo/dLegHi are the leg's   -> docs/mpc_d_strategy.md
var float dLegLo = na, var float dLegHi = na
var float dRclHi = na, var float dRclLo = na
// [doc 26] The PRICE the last SOS broke — the horizontal structure line drawn on th  -> docs/mpc_d_strategy.md
var float dSosLvl = na
// [doc 27] ⚠ ONE ENTRY PER SEQUENCE, AND WITHOUT THIS THE VWAP MODE TRADES THE SAME  -> docs/mpc_d_strategy.md
var bool dSeqTaken = false
// [doc 28] Has price CLOSED on the WRONG side of VWAP since the counter-SOS — the f  -> docs/mpc_d_strategy.md
var bool dVwapLost = false

if not na(dSosBar)
    if na(dLegLo) or low < dLegLo
        dLegLo := low
        dRclHi := high
    else
        dRclHi := math.max(nz(dRclHi, high), high)
    if na(dLegHi) or high > dLegHi
        dLegHi := high
        dRclLo := low
    else
        dRclLo := math.min(nz(dRclLo, low), low)

// [doc 29] A BOS that is NOT an SOS. The engine sets bull_bos on every bull_sos bar  -> docs/mpc_d_strategy.md
if (st.bull_bos and not st.bull_sos) or (st.bear_bos and not st.bear_sos)
    dCurBos += 1

float dAtr = ta.atr(14)

// [doc 30] ⚠ THE SESSION VWAP, AND IT IS DELIBERATELY THE ONE ON AARON'S CHART.  -> docs/mpc_d_strategy.md
float dVwap = ta.vwap(hlc3)

// [doc 31] The pro-trend side test, as ONE helper so the entry mode and the filter   -> docs/mpc_d_strategy.md
float dVwapSlope = dVwap - dVwap[execVwapSlopeBars]

// [doc 32] ⚠ The line BREAKS at each trading-day anchor on its own — ta.vwap return  -> docs/mpc_d_strategy.md
plot(execShowVwap ? dVwap : na, title = "VWAP", color = color.new(#00E5FF, 25), linewidth = 1)

f_dVwapOk(int dir) =>
    bool sideOk  = na(dVwap) ? false : (dir == 1 ? close > dVwap : close < dVwap)
    bool slopeOk = not execVwapSlope ? true : (na(dVwapSlope) ? false : (dir == 1 ? dVwapSlope > 0 : dVwapSlope < 0))
    sideOk and slopeOk

// [doc 33] DRAWING — object pools  -> docs/mpc_d_strategy.md
var array<box>   dBoxes = array.new<box>()
var array<label> dLbls  = array.new<label>()
var array<line>  dLines = array.new<line>()

// Handles on the CURRENT trade's objects, so they can be extended and recoloured while it
// runs. The arrays above own them for eviction; these are only pointers.
var box   aShake = na
var box   aRisk  = na
var box   aR1    = na
var box   aR2    = na
var box   aR3    = na
var label aEntry = na
var label aTp1   = na
var label aTp2   = na
var label aTp3   = na
var line  aLead  = na

int D_KEEP = 40

f_dEvict() =>
    while array.size(dBoxes) > D_KEEP * 5
        for _i = 1 to 5
            box.delete(array.shift(dBoxes))
        for _i = 1 to 4
            label.delete(array.shift(dLbls))
        line.delete(array.shift(dLines))
    int _r = 0

// [doc 34] D SEQUENCE — the fire, and why a setup was refused  -> docs/mpc_d_strategy.md
f_dN(float v) => na(v) ? "" : str.tostring(v, format.mintick)
f_dI(int v)   => na(v) ? "" : str.tostring(v)

f_dBlkWhy(int c) =>
    switch c
        1 => "'Trade longs' / 'Trade shorts' is OFF for this side."
        2 => "Trend too young — the trend being returned to printed fewer BOS than your floor, so it was never established enough to be shaken OUT of."
        3 => "Shakeout became a trend — the counter leg broke structure in its own direction more times than you allow, so it is a genuine reversal-and-recovery rather than a shakeout."
        4 => "Shakeout stale — the counter leg ran longer than your bar cap. What came back is a new move, not the same one resuming."
        5 => "Minimum stop distance — the stop sits closer to the entry than your floor, so this position would be oversized and noise-sensitive."
        6 => "Stop on the wrong side — the chosen anchor lands at or past the entry, which is a zero or negative 1R. Nothing can be sized against it."
        7 => "Already in a position — one trade at a time."
        9 => "Wrong side of VWAP — the entry bar did not close on the trend's own side of the session VWAP (or the line was not sloping with the trend, if that sub-gate is on)."
        8 => "Account is bust — equity is at or below zero, so nothing can be sized. Every setup from here reports the same thing; the run is over, not merely quiet."
        => ""

bool  dFired  = false
int   dDir    = 0
float dEntry  = na
float dStop   = na
int   dBlk    = 0     // 0 = nothing refused it
float dBlkPx  = na    // the entry the refused setup would have taken
// [doc 35] The shakeout's own geometry, handed to the execution block so the shaded  -> docs/mpc_d_strategy.md
int   dCtrBar = na
float dCtrHi  = na
float dCtrLo  = na
float dCtrSos = na
// [doc 36] ── The CANDIDATE record, set for EVERY candidate — fired or refused ──  -> docs/mpc_d_strategy.md
int   dCandDir  = 0     // +1 long / -1 short, for EVERY candidate, whatever triggered it
int   dCandTBos = na    // BOS the returned-to trend had printed
int   dCandCBos = na    // BOS the shakeout printed in its own direction
int   dCandBars = na    // how long the shakeout ran, in bars
float dCandCtr  = na    // the shakeout's own extreme (the sweep)
float dCandRcl  = na    // the reclaim leg's extreme
float dCandSos  = na    // the counter-SOS's broken level

if st.bull_sos or st.bear_sos
    int nDir = st.bull_sos ? 1 : -1
    // Read the gates BEFORE the shift at the bottom overwrites them.
    bool okDir   = dTrendDir == nDir
    float ctrExt = nDir == 1 ? dLegLo : dLegHi
    float rclExt = nDir == 1 ? dRclHi : dRclLo
    // [doc 37] "Ready" is okDir ALONE — the one structural fact the sequence is built o  -> docs/mpc_d_strategy.md
    if okDir and execEntryMode != "VWAP side" and not na(ctrExt) and not na(rclExt)
        float e = execEntryMode == "Retrace" ? (nDir == 1 ? rclExt - (rclExt - ctrExt) * execRetraceFib : rclExt + (ctrExt - rclExt) * execRetraceFib) : close
        // [doc 38] The counter-SOS's own broken level, still un-overwritten at this instant  -> docs/mpc_d_strategy.md
        float sAnchor = na(dSosLvl) ? ctrExt : dSosLvl
        float sBase = switch execSlMode
            "Counter-SOS line"    => sAnchor
            "Between the two"     => sAnchor + (ctrExt - sAnchor) * execSlPct / 100.0
            "% of entry-to-sweep" => e - nDir * math.abs(e - ctrExt) * execSlPct / 100.0
            => ctrExt
        float s    = sBase - nDir * execSlBufTk * syminfo.mintick
        float dist = (e - s) * nDir
        // [doc 39] The minimum stop floor. Computed from the COUNT of the distance rather t  -> docs/mpc_d_strategy.md
        float minStop = switch execMinStopMode
            "% of price"  => e * execMinStopVal / 100.0
            "Fixed $"     => execMinStopVal
            "x ATR(14)"   => na(dAtr) ? 0.0 : dAtr * execMinStopVal
            => 0.0
        bool bDir   = nDir == 1 ? not execLongs : not execShorts
        bool bYoung = dTrendBos < dTrendBosMin
        bool bGrew  = dCurBos > dCtrBosMax
        bool bStale = na(dSosBar) or bar_index - dSosBar > dCtrBarsMax
        bool bSide  = dist <= 0
        bool bTight = not bSide and execMinStopMode != "Off" and dist < minStop
        bool bBusy  = strategy.position_size != 0
        // [doc 40] ⚠ THE ACCOUNT CAN BE GONE, AND UNGUARDED THAT KILLS THE WHOLE RUN.  -> docs/mpc_d_strategy.md
        bool bBust  = execSizeMode == "Risk % of equity" and not (strategy.equity > 0)
        // [doc 41] The VWAP FILTER. Read on the entry bar, because that is the bar whose cl  -> docs/mpc_d_strategy.md
        bool bVwap  = execVwapReq and not f_dVwapOk(nDir)
        int  code   = bBust ? 8 : bDir ? 1 : bYoung ? 2 : bGrew ? 3 : bStale ? 4 : bVwap ? 9 : bTight ? 5 : bSide ? 6 : bBusy ? 7 : 0
        dBlk    := code
        dBlkPx  := e
        dCandDir := nDir
        // [doc 42] Every candidate carries its gates and its geometry, whatever the verdict  -> docs/mpc_d_strategy.md
        dCandTBos := dTrendBos
        dCandCBos := dCurBos
        dCandBars := na(dSosBar) ? na : bar_index - dSosBar
        dCandCtr  := ctrExt
        dCandRcl  := rclExt
        dCandSos  := dSosLvl
        if code == 0
            dFired  := true
            dDir    := nDir
            dEntry  := e
            dStop   := s
            dCtrBar := dSosBar
            dCtrHi  := dLegHi
            dCtrLo  := dLegLo
            dCtrSos := dSosLvl
    // The shift. UNCONDITIONAL — it runs whether or not the sequence fired, because the
    // trend this SOS just killed is the candidate for the next one either way.
    dTrendDir := -nDir
    dTrendBos := dCurBos
    dCurBos   := 0
    dSosBar   := bar_index
    dSosLvl   := nDir == 1 ? st.bull_bos_high : st.bear_bos_low
    dLegLo    := low
    dLegHi    := high
    dRclHi    := high
    dRclLo    := low
    // A new SOS is a new sequence, so the once-per-sequence latch is released here and
    // NOWHERE else — same place, same bar, as every other piece of sequence state.
    dSeqTaken := false
    // The reclaim latch is sequence state too, so it clears in the same place. Losing VWAP
    // during the PREVIOUS shakeout says nothing about this one.
    dVwapLost := false

// [doc 43] ── The first half of the reclaim: did price LOSE the line ──  -> docs/mpc_d_strategy.md
if dTrendDir != 0 and not na(dVwap) and (dTrendDir == 1 ? close < dVwap : close > dVwap)
    dVwapLost := true

// [doc 44] ── THE VWAP-SIDE ENTRY: the sequence taken WITHOUT waiting for the with-  -> docs/mpc_d_strategy.md
if execEntryMode == "VWAP side" and not (st.bull_sos or st.bear_sos) and not dSeqTaken and dTrendDir != 0
    int   nDir   = dTrendDir
    float ctrExt = nDir == 1 ? dLegLo : dLegHi
    float rclExt = nDir == 1 ? dRclHi : dRclLo
    // [doc 45] The trigger. Unlike the SOS path there is no event to hang a candidate o  -> docs/mpc_d_strategy.md
    if (not execVwapReclaim or dVwapLost) and f_dVwapOk(nDir) and not na(ctrExt) and not na(rclExt)
        float e     = close
        float sAnch = na(dSosLvl) ? ctrExt : dSosLvl
        float sBase = switch execSlMode
            "Counter-SOS line"    => sAnch
            "Between the two"     => sAnch + (ctrExt - sAnch) * execSlPct / 100.0
            "% of entry-to-sweep" => e - nDir * math.abs(e - ctrExt) * execSlPct / 100.0
            => ctrExt
        float s    = sBase - nDir * execSlBufTk * syminfo.mintick
        float dist = (e - s) * nDir
        float minStop = switch execMinStopMode
            "% of price"  => e * execMinStopVal / 100.0
            "Fixed $"     => execMinStopVal
            "x ATR(14)"   => na(dAtr) ? 0.0 : dAtr * execMinStopVal
            => 0.0
        // [doc 46] ⚠ THE MINIMUM-STOP GUARD MATTERS MORE ON THIS PATH THAN ON ANY OTHER IN   -> docs/mpc_d_strategy.md
        bool bDir   = nDir == 1 ? not execLongs : not execShorts
        bool bYoung = dTrendBos < dTrendBosMin
        bool bGrew  = dCurBos > dCtrBosMax
        bool bStale = na(dSosBar) or bar_index - dSosBar > dCtrBarsMax
        bool bSide  = dist <= 0
        bool bTight = not bSide and execMinStopMode != "Off" and dist < minStop
        bool bBusy  = strategy.position_size != 0
        bool bBust  = execSizeMode == "Risk % of equity" and not (strategy.equity > 0)
        int  code   = bBust ? 8 : bDir ? 1 : bYoung ? 2 : bGrew ? 3 : bStale ? 4 : bTight ? 5 : bSide ? 6 : bBusy ? 7 : 0
        dBlk     := code
        dBlkPx   := e
        dCandDir := nDir
        dCandTBos := dTrendBos
        dCandCBos := dCurBos
        dCandBars := na(dSosBar) ? na : bar_index - dSosBar
        dCandCtr  := ctrExt
        dCandRcl  := rclExt
        dCandSos  := dSosLvl
        if code == 0
            dFired    := true
            dDir      := nDir
            dEntry    := e
            dStop     := s
            dCtrBar   := dSosBar
            dCtrHi    := dLegHi
            dCtrLo    := dLegLo
            dCtrSos   := dSosLvl
            dSeqTaken := true

// [doc 47] ── The blocked-setup tag ──  -> docs/mpc_d_strategy.md
bool dBlkRecent = debugDays == 0 or time >= timenow - debugDays * 86400000
if showBlockTag and dBlk != 0 and not na(dBlkPx) and dBlkRecent and not na(dAtr)
    // dCandDir, NOT st.bull_sos — a VWAP-side candidate arrives on a bar with no SOS on it,
    // where the old test read false and drew every candidate as a short.
    bool bLong = dCandDir == 1
    // `tagY`, NOT `by` — `by` is a Pine KEYWORD (the step in `for i = 0 to n by 2`) and is
    // refused as an identifier with CE10150. Nothing else in this file uses a reserved word.
    float tagY = bLong ? low - dAtr * 2 : high + dAtr * 2
    line.new(bar_index, dBlkPx, bar_index, tagY, color = BLK_PINKL, style = line.style_dotted, width = 1)
    label.new(bar_index, tagY, (bLong ? "▲" : "▼") + " SETUP BLOCKED", tooltip = (bLong ? "▲ LONG" : "▼ SHORT") + " blocked\n──────────────────\n" + f_dBlkWhy(dBlk) + "\n──────────────────\nEntry would have been " + str.tostring(dBlkPx, format.mintick), color = BLK_PINK, textcolor = color.new(#101014, 0), style = bLong ? label.style_label_up : label.style_label_down, size = size.small)

// [doc 48] Plain ASCII, no quotes and no newlines, so it drops straight into a webh  -> docs/mpc_d_strategy.md
if dFired
    alert("MPC D " + syminfo.ticker + " " + (dDir == 1 ? "LONG" : "SHORT") + " entry " + str.tostring(dEntry, format.mintick) + " SL " + str.tostring(dStop, format.mintick), alert.freq_once_per_bar_close)

// [doc 49] EXECUTION  -> docs/mpc_d_strategy.md
var int   tDir      = 0
var float tE        = na
var float tSL       = na    // the ORIGINAL stop. Never moves — every later stop is derived
var float tDist     = na    // 1R, in price
var float tRiskUsd  = na    // 1R, in account currency — what the result is scored against
var float tNpAt     = na    // net profit at the fill, so the trade's own R can be recovered
var int   tStage    = 0     // 0 = open, 1 = TP1 reached, 2 = TP2 reached
var int   tMark     = 0     // how many target markers have been placed (drawing only)
var float tMaxFav   = na    // the favourable extreme since the FILL — drives the trail
// [doc 50] ⚠ tMaxAdv is the mirror of tMaxFav and is READ BY NOTHING except the log  -> docs/mpc_d_strategy.md
var float tMaxAdv   = na
var int   tTBos     = na    // the three gate inputs, frozen at the signal, for the log
var int   tCBos     = na
var int   tBars     = na
var int   tOrdBar   = na    // bar the ORDER was placed (not the fill)
var int   tFillBar  = na    // first bar the position was actually open
var int   tFillTime = na
var int   tSigBar   = na
var int   tCtrBar   = na
var float tCtrHi    = na
var float tCtrLo    = na
var float tCtrSos   = na

string D_L = "D-L"
string D_S = "D-S"

// [doc 51] ── The CLOSE: score the trade in R, repaint the callout, honour the keep  -> docs/mpc_d_strategy.md
if strategy.position_size == 0 and not na(tFillBar)
    float rMade = na(tRiskUsd) or tRiskUsd == 0 ? na : (strategy.netprofit - nz(tNpAt)) / tRiskUsd
    bool  isBe  = not na(rMade) and math.abs(rMade) <= execBeBandR
    bool  isWin = not na(rMade) and rMade > execBeBandR
    string verdict = na(rMade) ? "?" : isBe ? "BE" : isWin ? "WIN" : "LOSS"
    // A+'s three verdict colours, transparency included — set on the label directly rather
    // than re-wrapped in color.new(), so the value here IS the value A+ paints.
    color  vcol    = isBe ? POS_BE : isWin ? POS_WIN : POS_LOSS
    // [doc 52] The LEADER LINE is recoloured with the label, which this file did not do  -> docs/mpc_d_strategy.md
    color  vcolL   = isBe ? POS_BEL : isWin ? POS_WINL : POS_LOSSL
    if not na(aEntry)
        // The keep filter deletes the annotation, never the position blocks — those are the
        // record of what happened and are not an opinion about it.
        bool keep = execShowConfLabel and (execLabelWhich == "All" or (execLabelWhich == "Wins only" and isWin) or (execLabelWhich == "Losses only" and not isWin and not isBe) or (execLabelWhich == "Losses + breakevens" and not isWin))
        if keep
            label.set_text(aEntry, (tDir == 1 ? "D ▲ " : "D ▼ ") + verdict + "  " + (na(rMade) ? "" : str.tostring(rMade, "#.##") + "R"))
            label.set_color(aEntry, vcol)
            line.set_color(aLead, vcolL)
        else
            label.delete(aEntry)
            line.delete(aLead)
        aEntry := na
        aLead  := na
    // [doc 53] ── The TRADE record. ONE line per trade, pipe-delimited, everything on i  -> docs/mpc_d_strategy.md
    float _mfeR = na(tMaxFav) or na(tDist) or tDist == 0 ? na : (tMaxFav - tE) * tDir / tDist
    float _maeR = na(tMaxAdv) or na(tDist) or tDist == 0 ? na : (tMaxAdv - tE) * tDir / tDist
    tFillBar  := na
    tFillTime := na
    tStage    := 0
    tDir      := 0

if dFired
    // [doc 54] Clear any resting order first. A previous Retrace entry may still be on   -> docs/mpc_d_strategy.md
    strategy.cancel(D_L)
    strategy.cancel(D_S)
    float q = execSizeMode == "Fixed contracts" ? execFixedQty : (strategy.equity * execRiskPct / 100.0) / ((dEntry - dStop) * dDir)
    tDir     := dDir
    tE       := dEntry
    tSL      := dStop
    tDist    := (dEntry - dStop) * dDir
    tRiskUsd := tDist * q
    tStage   := 0
    tMark    := 0
    tMaxFav  := na
    tOrdBar  := bar_index
    tSigBar  := bar_index
    tCtrBar  := dCtrBar
    tCtrHi   := dCtrHi
    tCtrLo   := dCtrLo
    tCtrSos  := dCtrSos
    tMaxAdv  := na
    tTBos    := dCandTBos
    tCBos    := dCandCBos
    tBars    := dCandBars
    // [doc 55] Retrace rests a LIMIT at the fib; SOS close is a market order that fills  -> docs/mpc_d_strategy.md
    if q > 0
        if execEntryMode == "Retrace"
            strategy.entry(dDir == 1 ? D_L : D_S, dDir == 1 ? strategy.long : strategy.short, qty = q, limit = dEntry)
        else
            strategy.entry(dDir == 1 ? D_L : D_S, dDir == 1 ? strategy.long : strategy.short, qty = q)

// [doc 56] Kill a resting limit that never filled. Three ways it dies and all three  -> docs/mpc_d_strategy.md
if strategy.position_size == 0 and not na(tOrdBar) and tDir != 0 and bar_index > tOrdBar
    bool ordStale  = bar_index - tOrdBar > execLimitBars
    bool ordKilled = not na(tSL) and (tDir == 1 ? low <= tSL : high >= tSL)
    bool ordSuper  = (st.bull_sos or st.bear_sos) and not dFired
    if ordStale or ordKilled or ordSuper
        strategy.cancel(D_L)
        strategy.cancel(D_S)
        tOrdBar := na
        tDir    := 0

// ── The FILL: create every drawing object for this trade, once ──
if strategy.position_size != 0 and na(tFillBar) and tDir != 0
    tFillBar  := bar_index
    tFillTime := time
    tNpAt     := strategy.netprofit
    tOrdBar   := na
    float ftp1 = tE + tDir * tDist * execTp1R
    float ftp2 = tE + tDir * tDist * execTp2R
    float ftp3 = tE + tDir * tDist * execTp3R
    // [doc 57] No `fdc` any more. The open callout was coloured by DIRECTION here and A  -> docs/mpc_d_strategy.md
    aShake := box.new(nz(tCtrBar, tSigBar), nz(tCtrHi, high), nz(tSigBar, bar_index), nz(tCtrLo, low), bgcolor = execShowPosBox and execShowShakeout ? POS_SHADE : color(na), border_color = execShowPosBox and execShowShakeout ? color.new(#787B86, 55) : color(na), border_width = 1, border_style = line.style_dotted)
    // The position. math.max/min rather than a per-direction branch, so a short is drawn by
    // the same four lines as a long and the two cannot drift apart.
    aRisk := box.new(tFillBar, math.max(tE, tSL), bar_index, math.min(tE, tSL), bgcolor = execShowPosBox ? POS_DD : color(na), border_color = color(na))
    aR1   := box.new(tFillBar, math.max(tE, ftp1), bar_index, math.min(tE, ftp1), bgcolor = execShowPosBox and execTp1R > 0 ? POS_GHOST : color(na), border_color = color(na))
    aR2   := box.new(tFillBar, math.max(ftp1, ftp2), bar_index, math.min(ftp1, ftp2), bgcolor = execShowPosBox and execTp2R > execTp1R ? POS_GHOST : color(na), border_color = color(na))
    aR3   := box.new(tFillBar, math.max(ftp2, ftp3), bar_index, math.min(ftp2, ftp3), bgcolor = execShowPosBox and execTp3R > execTp2R ? POS_GHOST : color(na), border_color = color(na))
    // [doc 58] The callout. One line on the chart so it does not sit on the candles, an  -> docs/mpc_d_strategy.md
    float lblY = tE + tDir * nz(dAtr, tDist) * execLabelOff * -1
    string tip = "MPC D  " + (tDir == 1 ? "LONG" : "SHORT") + "\n"
    tip += "Entry   " + str.tostring(tE, format.mintick) + "\n"
    tip += "Stop    " + str.tostring(tSL, format.mintick) + "   (1R = " + str.tostring(tDist, format.mintick) + ")\n"
    tip += "  anchor: " + execSlMode + "\n"
    tip += "TP1     " + (execTp1R > 0 ? str.tostring(ftp1, format.mintick) + "   " + str.tostring(execTp1R) + "R   " + str.tostring(execTp1Pct) + "%" : "off") + "\n"
    tip += "TP2     " + (execTp2R > 0 ? str.tostring(ftp2, format.mintick) + "   " + str.tostring(execTp2R) + "R   " + str.tostring(execTp2Pct) + "%" : "off") + "\n"
    tip += "TP3     " + (execTp3R > 0 ? str.tostring(ftp3, format.mintick) + "   " + str.tostring(execTp3R) + "R   runner" : "off") + "\n"
    tip += "Trail   " + execRunnerTrail + "\n"
    tip += "\nThe sequence\n"
    tip += "Shakeout extreme  " + str.tostring(tDir == 1 ? tCtrLo : tCtrHi, format.mintick) + "\n"
    tip += "Counter-SOS line  " + (na(tCtrSos) ? "n/a" : str.tostring(tCtrSos, format.mintick)) + "\n"
    tip += "Shakeout ran      " + str.tostring(nz(tSigBar, bar_index) - nz(tCtrBar, bar_index)) + " bars\n"
    tip += "Trend had         " + str.tostring(dTrendBos) + " BOS behind it"
    aLead  := line.new(tFillBar, tE, tFillBar, lblY, color = execShowConfLabel ? POS_OPENL : color(na), style = line.style_dotted, width = 1)
    // textcolor is A+'s near-black #101014, not white: every label in this repo is a bright
    // fill with dark text, and white on the orange breakeven fill is close to unreadable.
    aEntry := label.new(tFillBar, lblY, (tDir == 1 ? "D ▲ " : "D ▼ ") + str.tostring(tE, format.mintick), style = tDir == 1 ? label.style_label_up : label.style_label_down, color = execShowConfLabel ? POS_OPEN : color(na), textcolor = execShowConfLabel ? color.new(#101014, 0) : color(na), size = size.small, tooltip = tip)
    // [doc 59] Created EMPTY and transparent, then filled in on the bar each target is   -> docs/mpc_d_strategy.md
    aTp1 := label.new(tFillBar, ftp1, "", style = label.style_label_left, color = color(na), textcolor = color(na), size = size.tiny)
    aTp2 := label.new(tFillBar, ftp2, "", style = label.style_label_left, color = color(na), textcolor = color(na), size = size.tiny)
    aTp3 := label.new(tFillBar, ftp3, "", style = label.style_label_left, color = color(na), textcolor = color(na), size = size.tiny)
    array.push(dBoxes, aShake), array.push(dBoxes, aRisk), array.push(dBoxes, aR1), array.push(dBoxes, aR2), array.push(dBoxes, aR3)
    array.push(dLbls, aEntry), array.push(dLbls, aTp1), array.push(dLbls, aTp2), array.push(dLbls, aTp3)
    array.push(dLines, aLead)
    f_dEvict()
    // [doc 60] (The ENTRY log line was REMOVED 2026-08-06 and folded into the single T|  -> docs/mpc_d_strategy.md

// [doc 61] ── Entry triangles — the always-visible marker at every fill (ported fro  -> docs/mpc_d_strategy.md
plotshape(execShowPosBox and strategy.position_size > 0 and strategy.position_size[1] == 0, title = "Long entry",  style = shape.triangleup,   location = location.belowbar, color = POS_GREENB, size = size.small)
plotshape(execShowPosBox and strategy.position_size < 0 and strategy.position_size[1] == 0, title = "Short entry", style = shape.triangledown, location = location.abovebar, color = POS_REDB,   size = size.small)

// [doc 62] ── f_dRatchet — ported from mpc_strategy.pine's f_swingRatchet, unchange  -> docs/mpc_d_strategy.md
f_dRatchet(float swing, float maxFav, int dir, float buf, float pct) =>
    float anchor = dir > 0 ? swing - buf : swing + buf
    float step   = maxFav * pct / 100.0
    float run    = (maxFav - anchor) * dir
    float out    = anchor
    if step > 0 and not na(run) and run >= step
        float steps = math.floor((run - step) / step)
        out := anchor + steps * step * dir
    out

// f_dFixedTrail — the dollar-grid alternative, anchored at TP2 rather than at structure.
f_dFixedTrail(float maxFav, float tp2, int dir, float stepSz) =>
    float run = (maxFav - tp2) * dir
    float out = na
    if not na(run) and run >= stepSz
        float steps = math.floor((run - stepSz) / stepSz)
        out := dir > 0 ? tp2 + steps * stepSz : tp2 - steps * stepSz
    out

if strategy.position_size != 0 and tDir != 0
    float tp1 = tE + tDir * tDist * execTp1R
    float tp2 = tE + tDir * tDist * execTp2R
    float tp3 = tE + tDir * tDist * execTp3R
    float beBuf = execBeBufTk * syminfo.mintick
    // [doc 63] ⚠ THE FILL BAR MAY NOT STAGE THE STOP, AND MAY NOT FEED tMaxFav.  -> docs/mpc_d_strategy.md
    if bar_index > tFillBar
        tMaxFav := na(tMaxFav) ? (tDir == 1 ? high : low) : (tDir == 1 ? math.max(tMaxFav, high) : math.min(tMaxFav, low))
        tMaxAdv := na(tMaxAdv) ? (tDir == 1 ? low : high) : (tDir == 1 ? math.min(tMaxAdv, low) : math.max(tMaxAdv, high))
        if tStage < 1 and execTp1R > 0 and (tDir == 1 ? high >= tp1 : low <= tp1)
            tStage := 1
        if tStage < 2 and execTp2R > 0 and (tDir == 1 ? high >= tp2 : low <= tp2)
            tStage := 2
    // ── The runner trail candidate. na = not engaged yet. ──
    float structBuf = execStructTrailBufTk * syminfo.mintick
    float swing = tDir == 1 ? st.last_conf_low : st.last_conf_high
    float trail = na
    if tStage >= 2 and not na(tMaxFav)
        if execRunnerTrail == "Structure + % ratchet"
            trail := na(swing) ? na : f_dRatchet(swing, tMaxFav, tDir, structBuf, execTrailPct)
        else if execRunnerTrail == "Structure (swing)"
            trail := na(swing) ? na : swing - tDir * structBuf
        else
            trail := f_dFixedTrail(tMaxFav, tp2, tDir, execTrailStep)
    // [doc 64] The TP2 stop FLOOR — the protective baseline the instant TP2 is reached,  -> docs/mpc_d_strategy.md
    float floor2 = execTp2StopMode == "Breakeven" ? tE + tDir * beBuf : execTp2StopMode == "One trail step behind" ? (tDir == 1 ? math.max(tE + beBuf, tMaxFav - execTrailStep) : math.min(tE - beBuf, tMaxFav + execTrailStep)) : tp1
    float curStop = tStage >= 2 ? (na(trail) ? floor2 : (tDir == 1 ? math.max(floor2, trail) : math.min(floor2, trail))) : tStage >= 1 ? tE + tDir * beBuf : tSL
    // [doc 65] ── The position drawing, updated live ──  -> docs/mpc_d_strategy.md
    if not na(aRisk)
        box.set_right(aRisk, bar_index)
        box.set_top(aRisk, math.max(tE, curStop))
        box.set_bottom(aRisk, math.min(tE, curStop))
        box.set_right(aR1, bar_index)
        box.set_right(aR2, bar_index)
        box.set_right(aR3, bar_index)
        // A target REACHED gets its marker and brightens its block. tMark only ever climbs,
        // so a marker is written once and never rewritten on a later bar.
        if execShowExitLines and tStage >= 1 and tMark < 1
            tMark := 1
            label.set_xy(aTp1, bar_index, tp1), label.set_text(aTp1, " TP1"), label.set_textcolor(aTp1, TP_ANNOT)
            box.set_bgcolor(aR1, execShowPosBox ? POS_G1 : color(na))
        if execShowExitLines and tStage >= 2 and tMark < 2
            tMark := 2
            label.set_xy(aTp2, bar_index, tp2), label.set_text(aTp2, " TP2"), label.set_textcolor(aTp2, TP_ANNOT)
            box.set_bgcolor(aR2, execShowPosBox ? POS_G2 : color(na))
        if execShowExitLines and tMark < 3 and execTp3R > 0 and (tDir == 1 ? high >= tp3 : low <= tp3)
            tMark := 3
            label.set_xy(aTp3, bar_index, tp3), label.set_text(aTp3, " TP3"), label.set_textcolor(aTp3, TP_ANNOT)
            box.set_bgcolor(aR3, execShowPosBox ? POS_G3 : color(na))
    string eid = tDir == 1 ? D_L : D_S
    // [doc 66] ⚠ A RUNG IS NOT RE-ISSUED ONCE ITS TARGET HAS BEEN TOUCHED. Calling stra  -> docs/mpc_d_strategy.md
    if execTp1Pct > 0 and execTp1R > 0 and tStage < 1
        strategy.exit("D-TP1", from_entry = eid, qty_percent = execTp1Pct, limit = tp1, stop = curStop)
    if execTp2Pct > 0 and execTp2R > 0 and tStage < 2
        strategy.exit("D-TP2", from_entry = eid, qty_percent = execTp2Pct, limit = tp2, stop = curStop)
    // [doc 67] The remainder. Declared as its own float rather than inlined as a ternar  -> docs/mpc_d_strategy.md
    float tp3Lim = execTp3R > 0 ? tp3 : na
    strategy.exit("D-RUN", from_entry = eid, limit = tp3Lim, stop = curStop)
    // The two clock/structure exits, in mpc_strategy's own precedence: an opposite SOS is
    // read as early proof the resumption failed and wins over the timer.
    bool timeUp = execTimeStopMode != "Off" and not na(tFillTime) and (execTimeStopMode == "Always" or tStage == 0) and (time - tFillTime) >= execTimeStopHrs * 3600000
    if execCloseOppSOS and (tDir == 1 ? st.bear_sos : st.bull_sos)
        strategy.close(eid, comment = "opp SOS")
    else if timeUp
        strategy.close(eid, comment = "time stop")

// (The CLOSE block used to sit HERE, at the very bottom, and that ordering was a bug —
//  see the note at its new home above `if dFired`. Do not move it back.)

// [doc 68] ── The REFUSAL record. Same shape as the trade record, so one parser rea  -> docs/mpc_d_strategy.md
var table dTbl = table.new(position.top_right, 2, 7, bgcolor = color.new(#0B0E14, 0), border_color = color.new(#17578e, 70), border_width = 1, frame_color = color.new(#17578e, 70), frame_width = 1)

f_dCell(table t, int row, string k, string v, color c) =>
    table.cell(t, 0, row, k, text_color = D_MUTED, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, row, v, text_color = c, text_size = size.small, text_halign = text.align_right)

if showStatePanel and barstate.islast
    table.cell(dTbl, 0, 0, "MPC D", text_color = #00E5FF, text_size = size.small, text_halign = text.align_left)
    table.cell(dTbl, 1, 0, "", text_color = #00E5FF, text_size = size.small)
    f_dCell(dTbl, 1, "Trend", st.dir == 1 ? "Bullish" : st.dir == -1 ? "Bearish" : "—", st.dir == 1 ? D_LONG : st.dir == -1 ? D_SHORT : D_MUTED)
    f_dCell(dTbl, 2, "BOS in leg", str.tostring(dCurBos), dCurBos <= dCtrBosMax ? D_LONG : D_MUTED)
    // The candidate is the trend TWO SOS back — the one a with-trend SOS would return to. If
    // it is not mature the sequence cannot fire whatever price does next.
    f_dCell(dTbl, 3, "Returns to", dTrendDir == 1 ? "Bullish" : dTrendDir == -1 ? "Bearish" : "—", dTrendBos >= dTrendBosMin ? (dTrendDir == 1 ? D_LONG : D_SHORT) : D_MUTED)
    // [doc 69] The VWAP read, and it reports the ANSWER for the side the sequence would  -> docs/mpc_d_strategy.md
    bool vwapOkNow = dTrendDir == 0 ? false : f_dVwapOk(dTrendDir)
    // [doc 70] "reclaimed" is the state the entry actually needs — price is on the tren  -> docs/mpc_d_strategy.md
    string vwapTxt = na(dVwap) ? "no data" : dTrendDir == 0 ? "—" : (vwapOkNow ? (dVwapLost ? "reclaimed" : "pro-trend") : "wrong side")
    f_dCell(dTbl, 4, "VWAP", vwapTxt, na(dVwap) ? D_MUTED : dTrendDir == 0 ? D_MUTED : vwapOkNow ? D_LONG : D_SHORT)
    // [doc 71] ⚠ The VWAP term is listed LAST in this chain and that mirrors the block-  -> docs/mpc_d_strategy.md
    bool vwapGates = execEntryMode == "VWAP side" or execVwapReq
    // [doc 72] The two VWAP waits are DIFFERENT states and the panel must not merge the  -> docs/mpc_d_strategy.md
    bool needLose = execEntryMode == "VWAP side" and execVwapReclaim and not dVwapLost
    string dWait = dTrendDir == 0 ? "Warming up" : dTrendBos < dTrendBosMin ? "Trend too young" : dCurBos > dCtrBosMax ? "Shakeout became a trend" : not na(dSosBar) and bar_index - dSosBar > dCtrBarsMax ? "Shakeout stale" : needLose ? "Waiting for price to lose VWAP" : (vwapGates and not vwapOkNow) ? (dVwapLost ? "Waiting on VWAP reclaim" : "Waiting on VWAP") : dSeqTaken ? "Sequence already taken" : execEntryMode == "VWAP side" ? (dTrendDir == 1 ? "Armed - long on VWAP reclaim" : "Armed - short on VWAP reclaim") : dTrendDir == 1 ? "Armed - need bull SOS" : "Armed - need bear SOS"
    f_dCell(dTbl, 5, "State", dWait, str.startswith(dWait, "Armed") ? #ffde59 : D_MUTED)
    f_dCell(dTbl, 6, "Position", strategy.position_size == 0 ? "Flat" : (tDir == 1 ? "LONG " : "SHORT ") + "stage " + str.tostring(tStage), strategy.position_size == 0 ? D_MUTED : (tDir == 1 ? D_LONG : D_SHORT))

// [doc 73] PARITY / ANALYSIS EXPORT — per-bar DECISION STREAM  -> docs/mpc_d_strategy.md

color _INV = color.new(color.gray, 100)   // transparent — in the CSV, invisible on the chart

// [doc 74] ── Candidate geometry: DELETED 2026-08-06, and the deletion is the fix ─  -> docs/mpc_d_strategy.md

// [doc 75] ── Trade tracker — export-owned, so the parent's close-bar resets cannot  -> docs/mpc_d_strategy.md
f_xTrade() =>
    var int   _dir = 0
    var float _e = na, var float _d1r = na, var float _risk = na, var float _np = na
    var int   _fb = na
    var float _hi = na, var float _lo = na
    var int   _stg = 0
    float _fill = na, float _cr = na
    bool _isFill  = strategy.position_size != 0 and strategy.position_size[1] == 0
    bool _isClose = strategy.position_size == 0 and strategy.position_size[1] != 0
    if _isFill
        _dir  := tDir
        _e    := tE
        _d1r  := tDist
        _risk := tRiskUsd
        _np   := tNpAt
        _fb   := bar_index
        _hi   := na
        _lo   := na
        _stg  := 0
        _fill := tE
    if strategy.position_size != 0 and not na(_fb) and bar_index > _fb
        _hi  := na(_hi) ? high : math.max(_hi, high)
        _lo  := na(_lo) ? low  : math.min(_lo, low)
        // [doc 76] Ternary, not math.max — math.max returns a float and _stg is an int, whi  -> docs/mpc_d_strategy.md
        _stg := tStage > _stg ? tStage : _stg
    if _isClose and not na(_risk) and _risk != 0
        _cr := (strategy.netprofit - nz(_np)) / _risk
    float _mfe = na, float _mae = na
    if _dir != 0 and not na(_d1r) and _d1r != 0 and not na(_hi)
        _mfe := _dir == 1 ? (_hi - _e) / _d1r : (_e - _lo) / _d1r
        _mae := _dir == 1 ? (_lo - _e) / _d1r : (_e - _hi) / _d1r
    bool _live = strategy.position_size != 0 or _isClose
    // [doc 77] stgOut is declared float FIRST. `_live ? _stg : na` with an int _stg lea  -> docs/mpc_d_strategy.md
    float _stgOut = _live ? _stg : na
    [_fill, _live ? _d1r : na, _stgOut, _live ? _mfe : na, _live ? _mae : na, _cr]

// [doc 78] ── Real exit fills this bar, by rung ───────────────────────────────────  -> docs/mpc_d_strategy.md
f_xExits() =>
    var int _seen = 0
    float _t1 = na, float _t2 = na, float _rn = na
    if strategy.closedtrades > _seen
        for _i = _seen to strategy.closedtrades - 1
            if strategy.closedtrades.exit_bar_index(_i) == bar_index
                string _id = strategy.closedtrades.exit_id(_i)
                float  _px = strategy.closedtrades.exit_price(_i)
                if str.contains(_id, "TP1")
                    _t1 := _px
                else if str.contains(_id, "TP2")
                    _t2 := _px
                else
                    _rn := _px
        _seen := strategy.closedtrades
    [_t1, _t2, _rn]

[_xFill, _xR, _xStg, _xMfe, _xMae, _xClosedR] = f_xTrade()
[_xT1, _xT2, _xRun] = f_xExits()

// [doc 79] ── DECISION STREAM ─────────────────────────────────────────────────────  -> docs/mpc_d_strategy.md
plot((st.bull_sos ? 1 : 0) + (st.bear_sos ? 2 : 0) + (dFired ? 4 : 0) + (strategy.position_size == 0 and not na(tOrdBar) ? 8 : 0) + (strategy.position_size != 0 and strategy.position_size[1] == 0 ? 16 : 0) + (strategy.position_size == 0 and strategy.position_size[1] != 0 ? 32 : 0), "px_sos", _INV, editable = false)
// [doc 80] The refusal code, identical to the pink chart tag and the [BLOCK] log li  -> docs/mpc_d_strategy.md
float _pBlk      = dBlk == 0 ? na : dBlk
float _pDir      = dCandDir == 0 ? na : dCandDir
float _pSosLvl   = dCandDir == 0 ? na : dCandSos
float _pTrendBos = dCandDir == 0 ? na : dCandTBos
float _pCtrBos   = dCandDir == 0 ? na : dCandCBos
float _pCtrBars  = dCandDir == 0 ? na : dCandBars
plot(_pBlk,                      "px_blk",        _INV, editable = false)
plot(_pDir,                      "px_cand_dir",   _INV, editable = false)
plot(dBlkPx,                     "px_cand_entry", _INV, editable = false)   // set for FIRED and BLOCKED alike
plot(dStop,                      "px_sig_stop",   _INV, editable = false)   // fired only
plot(dCandCtr,                   "px_ctr_ext",    _INV, editable = false)   // the shakeout's own extreme (exact)
plot(dCandRcl,                   "px_rcl_ext",    _INV, editable = false)   // the reclaim leg's extreme (exact)
plot(_pSosLvl,                   "px_sos_lvl",    _INV, editable = false)   // the counter-SOS's broken level (exact)
// The three gate INPUTS, exact, at decision time. Every candidate carries them whether it
// fired or not, so a gate can be re-run offline over the whole history from one export.
plot(_pTrendBos,                 "px_gate_trend_bos", _INV, editable = false)
plot(_pCtrBos,                   "px_gate_ctr_bos",   _INV, editable = false)
plot(_pCtrBars,                  "px_gate_ctr_bars",  _INV, editable = false)
// The parent's OWN geometry on fired bars — the cross-check on the reconstruction above.
plot(dFired ? dCtrHi  : na,      "px_fire_ctr_hi",  _INV, editable = false)
plot(dFired ? dCtrLo  : na,      "px_fire_ctr_lo",  _INV, editable = false)
plot(dFired ? dCtrSos : na,      "px_fire_sos_lvl", _INV, editable = false)

// ── TRADE STREAM ────────────────────────────────────────────────────────────
plot(_xFill,    "px_fill",      _INV, editable = false)   // fill price, on the fill bar only
plot(_xR,       "px_1r",        _INV, editable = false)   // 1R in PRICE, so R and dollars are reconcilable
plot(_xStg,     "px_stage",     _INV, editable = false)   // 0 open · 1 TP1 reached · 2 TP2 reached
plot(_xMfe,     "px_mfe_r",     _INV, editable = false)   // running favourable excursion, in R
plot(_xMae,     "px_mae_r",     _INV, editable = false)   // running adverse excursion, in R (negative)
plot(_xT1,      "px_exit_tp1",  _INV, editable = false)
plot(_xT2,      "px_exit_tp2",  _INV, editable = false)
plot(_xRun,     "px_exit_run",  _INV, editable = false)
plot(_xClosedR, "px_closed_r",  _INV, editable = false)   // the trade's own R, on its close bar
plot(strategy.equity, "px_equity", _INV, editable = false)
plot(dAtr,      "px_atr14",     _INV, editable = false)
// [doc 81] ⚠ px_vwap IS PLOTTED ON EVERY BAR, UNGATED, AND IS NOT THE SAME COLUMN A  -> docs/mpc_d_strategy.md
plot(dVwap,     "px_vwap",      _INV, editable = false)

// [doc 82] ── CONFIG ──────────────────────────────────────────────────────────────  -> docs/mpc_d_strategy.md
plot((execLongs ? 1 : 0) + (execShorts ? 2 : 0) + (execCloseOppSOS ? 4 : 0) + (execVwapReq ? 8 : 0) + (execVwapSlope ? 16 : 0), "cfg_bits", _INV, editable = false)
// [doc 83] 🔴 THREE-WAY, NOT TWO-WAY, AND THE OLD FORM WAS ALREADY WRONG THE MOMENT   -> docs/mpc_d_strategy.md
plot((execEntryMode == "SOS close" ? 0 : execEntryMode == "Retrace" ? 1 : 2)
   + (execSlMode == "Sweep extreme" ? 0 : execSlMode == "Counter-SOS line" ? 1 : execSlMode == "Between the two" ? 2 : 3) * 10
   + (execMinStopMode == "Off" ? 0 : execMinStopMode == "% of price" ? 1 : execMinStopMode == "Fixed $" ? 2 : 3) * 100
   + (execSizeMode == "Risk % of equity" ? 0 : 1) * 1000
   + (execTp2StopMode == "TP1 price" ? 0 : execTp2StopMode == "Breakeven" ? 1 : 2) * 10000
   + (execRunnerTrail == "Fixed step" ? 0 : execRunnerTrail == "Structure (swing)" ? 1 : 2) * 100000
   + (execTimeStopMode == "Off" ? 0 : execTimeStopMode == "Before TP1 only" ? 1 : 2) * 1000000, "cfg_modes", _INV, editable = false)
plot(dTrendBosMin,          "cfg_trend_bos_min", _INV, editable = false)
plot(dCtrBosMax,            "cfg_ctr_bos_max",   _INV, editable = false)
plot(dCtrBarsMax,           "cfg_ctr_bars_max",  _INV, editable = false)
plot(execRetraceFib,        "cfg_retrace_fib",   _INV, editable = false)
plot(execLimitBars,         "cfg_limit_bars",    _INV, editable = false)
plot(execSlPct,             "cfg_sl_pct",        _INV, editable = false)
plot(execSlBufTk,           "cfg_sl_buf",        _INV, editable = false)
plot(execMinStopVal,        "cfg_min_stop_val",  _INV, editable = false)
plot(execRiskPct,           "cfg_risk_pct",      _INV, editable = false)
plot(execFixedQty,          "cfg_fixed_qty",     _INV, editable = false)
plot(execTp1R,              "cfg_tp1_r",         _INV, editable = false)
plot(execTp2R,              "cfg_tp2_r",         _INV, editable = false)
plot(execTp3R,              "cfg_tp3_r",         _INV, editable = false)
plot(execTp1Pct,            "cfg_tp1_pct",       _INV, editable = false)
plot(execTp2Pct,            "cfg_tp2_pct",       _INV, editable = false)
plot(execBeBufTk,           "cfg_be_buf",        _INV, editable = false)
plot(execStructTrailBufTk,  "cfg_struct_buf",    _INV, editable = false)
plot(execTrailPct,          "cfg_trail_pct",     _INV, editable = false)
plot(execTrailStep,         "cfg_trail_step",    _INV, editable = false)
plot(execTimeStopHrs,       "cfg_time_stop_hrs", _INV, editable = false)
plot(execBeBandR,           "cfg_scratch_r",     _INV, editable = false)
// [doc 84] Raw, like every other numeric here, and for the same reason. ⚠ It is in   -> docs/mpc_d_strategy.md
plot(execVwapSlopeBars,     "cfg_vwap_slope_bars", _INV, editable = false)
