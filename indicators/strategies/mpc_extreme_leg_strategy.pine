// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/ MPL-2.0
//@version=6
// [doc 1] MPC EXTREME LEG — the run INTO the shift of structure, not the fade after it  -> docs/mpc_extreme_leg_strategy.md
strategy("MPC Extreme Leg", overlay = true, initial_capital = 10000,
  default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 0,
  calc_on_every_tick = false, process_orders_on_close = true,
  max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// [doc 2] RUN THIS ON A 5-MINUTE CHART. The 15-minute half is aggregated in code, so the
// chart timeframe is not a preference — it is the frame the trigger is measured on.
// [doc 3] THE INPUT PANEL — twelve numbered sections, house contract  -> docs/mpc_extreme_leg_strategy.md

G1 = "1 · Confirmation Table"
G2 = "2 · Market Structure"
G3 = "3 · What trades"
G4 = "4 · What arms it"
G5 = "5 · Entry"
G6 = "6 · Stop & targets"
G7 = "7 · Filters"
G8 = "8 · Chart annotations"
G11 = "11 · Drawing: Liquidity"
G12 = "12 · Debug"

// ── 2 · Market structure ────────────────────────────────────────
// [doc 4] ⚠ TWO of the house's four toggles are absent here, deliberately  -> docs/mpc_extreme_leg_strategy.md
bool showExternal    = input.bool(true,  "Show External Structure", group = G2, display = display.none)
bool showSwingLabels = input.bool(false, "Show Swing Point Labels", group = G2, tooltip = "Off hides the swing point labels, leaving just BOS and SOS. Nothing else changes.", display = display.none)
bool showHtfSwing    = input.bool(true,  "Show the 15-minute swing being aimed at", group = G2, tooltip = "Draws the higher-timeframe swing this trade targets. That level is the take profit.")

// ── 3 · What trades ─────────────────────────────────────────────
bool   execLongs  = input.bool(true, "Trade longs",  group = G3, tooltip = "Lets long setups trade. Off = shorts only.")
bool   execShorts = input.bool(true, "Trade shorts", group = G3, tooltip = "Lets short setups trade. Off = longs only.")
string sizeMode   = input.string("Risk % of equity", "Position sizing", options = ["Risk % of equity", "Fixed contracts"], group = G3, tooltip = "Risk % of equity makes every trade exactly 1R, so results compound. Fixed contracts uses the same quantity whatever the stop.")
float  riskPct    = input.float(1.0, "   ↳ Risk % per trade", minval = 0.01, maxval = 100, step = 0.1, group = G3, active = sizeMode == "Risk % of equity", tooltip = "Every trade risks this much of equity, so every trade is 1R and the R numbers mean the same thing throughout.")
float  fixedQty   = input.float(1.0, "   ↳ Contracts", minval = 0.01, step = 0.01, group = G3, active = sizeMode == "Fixed contracts")

// ── 4 · What arms it ────────────────────────────────────────────
int  sweptMinutes = input.int(180, "A level must have been swept within (minutes)", minval = 15, maxval = 1440, step = 15, group = G4, tooltip = "How recently liquidity must have been taken for a change of character to count. Nothing arms without a sweep.")
bool reqCounterTrend = input.bool(true, "Only against the 15-minute trend", group = G4, tooltip = "On = the swing being aimed at must be a change of character rather than a continuation. Off doubles the trade count and halves the quality.")
bool useH4Level      = input.bool(true, "Arm on a 4-hour level", group = G4, tooltip = "The previous 4-hour candle's high and low. The most frequent level, and the weakest of the ones that work.")
bool useSessionLevel = input.bool(true, "Arm on a session level", group = G4, tooltip = "The last completed Asia, London or New York session's high and low. One of the two strongest.")
bool useDailyLevel   = input.bool(true, "Arm on the previous day's level", group = G4, tooltip = "Yesterday's high and low. The strongest single family measured.")
bool useWeeklyLevel  = input.bool(true, "Arm on the previous week's level", group = G4, tooltip = "Last week's high and low. Too rare on its own to have been measured either way.")
int  minFamilies     = input.int(1, "Levels that must agree", minval = 1, maxval = 4, group = G4, tooltip = "How many different kinds of level must have been swept together. Two is better than one and cuts the trade count in half.")

// ── 5 · Entry ───────────────────────────────────────────────────
bool entryOnClose = input.bool(true, "Enter on the change-of-character close", group = G5, tooltip = "On = enter as soon as the 5-minute bar that shifts structure closes. Off waits for the next 15-minute close instead, which is later and worth less.")

// ── 6 · Stop & targets ──────────────────────────────────────────
int   extremeMinutes = input.int(120, "Look back for the extreme (minutes)", minval = 15, maxval = 720, step = 15, group = G6, tooltip = "The stop goes beyond the lowest low (or highest high) of this window. That extreme is what the trade is betting has held.")
float stopBufferAtr  = input.float(0.05, "Stop buffer (ATR)", minval = 0.0, maxval = 1.0, step = 0.01, group = G6, tooltip = "Extra room beyond the extreme, as a fraction of the average range. 0 puts the stop exactly on the extreme.")
bool  useBreakeven   = input.bool(false, "Move the stop to breakeven", group = G6, tooltip = "Off by default. Moving it early converts winners into scratches; moving it late is worth almost nothing.")
float beArmFrac      = input.float(0.7, "   ↳ Arm at this much of the way to the target", minval = 0.1, maxval = 0.99, step = 0.05, group = G6, active = useBreakeven, tooltip = "How far price must travel before the stop moves up. Below about two thirds this costs money.")

// ── 7 · Filters ─────────────────────────────────────────────────
float minR       = input.float(2.0, "Refuse a target nearer than (R)", minval = 0.0, maxval = 20.0, step = 0.5, group = G7, tooltip = "Refuses a setup whose swing is closer than this many stops. Without it most setups have no room to pay.")
float minStopUsd = input.float(0.0, "Minimum stop distance ($)", minval = 0.0, step = 0.1, group = G7, tooltip = "Refuses a stop tighter than this. A tight stop does not make the risk small, it makes the position large. 0 switches it off.")

// ── 8 · Chart annotations ───────────────────────────────────────
bool showEntries = input.bool(true,  "Entry markers", group = G8)
bool showBlocked = input.bool(true,  "Refused setups", group = G8, tooltip = "Tags a setup that armed and was then refused, with the reason.")
bool showSweeps  = input.bool(false, "Mark the sweep that armed it", group = G8)

// ── 11 · Drawing: Liquidity ─────────────────────────────────────
bool showLevels = input.bool(false, "Draw the levels", group = G11, tooltip = "Draws the highs and lows this strategy watches. Drawing only — it changes nothing.")

// ── 12 · Debug ──────────────────────────────────────────────────
bool showDebug = input.bool(false, "Debug labels", group = G12)

// [doc 5] MARKET STRUCTURE — shared settings  -> docs/mpc_extreme_leg_strategy.md
color bullColor  = color.blue
color bearColor  = color.red
int   majorLength = 15
string structLabelSize = "Small"
float  pbBuffer        = 0.0

f_structSize() =>
    not showExternal ? size.auto : structLabelSize == "Tiny" ? size.tiny : structLabelSize == "Normal" ? size.normal : structLabelSize == "Large" ? size.large : structLabelSize == "Huge" ? size.huge : size.small

f_swingCol(color c) =>
    showSwingLabels ? c : color(na)

type SMCStructure
    int    length
    float  ash             = na
    int    ash_loc         = na
    string ash_type        = ""
    line   ash_line        = na
    label  ash_lbl         = na
    float  asl             = na
    int    asl_loc         = na
    string asl_type        = ""
    line   asl_line        = na
    label  asl_lbl         = na
    float  last_conf_high     = na
    int    last_conf_high_loc = na
    float  last_conf_low      = na
    int    last_conf_low_loc  = na
    int    dir            = 0
    bool   choch_lock     = false
    line   choch_ref      = na
    int    pb_mode        = 0
    int    pb_count       = 0
    float  pb_level       = na
    float  pb_extreme     = na
    int    pb_extreme_loc = na
    line   pb_line        = na
    bool   pb_started     = false
    float  pb_last_qualify_close = na
    float  pb_last_qualify_high  = na
    float  pb_extreme_close      = na
    float  prev_close     = na
    float  prev_high      = na
    float  prev_low       = na
    bool   seeded         = false
    bool   bull_bos       = false
    float  bull_bos_high  = na
    int    bull_bos_h_loc = na
    float  bull_bos_low   = na
    int    bull_bos_l_loc = na
    bool   bear_bos       = false
    float  bear_bos_high  = na
    int    bear_bos_h_loc = na
    float  bear_bos_low   = na
    int    bear_bos_l_loc = na
    bool   new_swing_high = false
    bool   new_swing_low  = false
    bool   bull_sos       = false
    bool   bear_sos       = false

// prefix: "" for external, "i" for internal
// bull_col / bear_col allow per-instance colors
method create_ash(SMCStructure st, float val, int loc, color col, bool solid, string prefix) =>
    if not na(st.ash_line)
        line.delete(st.ash_line)
    if not na(st.ash_lbl)
        label.delete(st.ash_lbl)
        st.ash_lbl := na
    st.ash      := val
    st.ash_loc  := loc
    st.ash_type := ""
    st.ash_lbl  := label.new(loc, val, prefix + "ASH\n", color=color(na), textcolor=f_swingCol(col), style=label.style_label_down, size=f_structSize())
    st.ash_line := line.new(loc, val, bar_index, val, color=col, style=solid ? line.style_solid : line.style_dashed, width=solid ? 2 : 1)

method create_asl(SMCStructure st, float val, int loc, color col, bool solid, string prefix) =>
    if not na(st.asl_line)
        line.delete(st.asl_line)
    if not na(st.asl_lbl)
        label.delete(st.asl_lbl)
        st.asl_lbl := na
    st.asl      := val
    st.asl_loc  := loc
    st.asl_type := ""
    st.asl_lbl  := label.new(loc, val, "\n" + prefix + "ASL", color=color(na), textcolor=f_swingCol(col), style=label.style_label_up, size=f_structSize())
    st.asl_line := line.new(loc, val, bar_index, val, color=col, style=solid ? line.style_solid : line.style_dashed, width=solid ? 2 : 1)

// process() now accepts prefix + bull/bear colors so both instances share one method
method process(SMCStructure st, float ph_val, float pl_val, string prefix, color bull_col, color bear_col) =>

    st.bull_bos := false
    st.bear_bos := false
    st.new_swing_high := false
    st.new_swing_low  := false
    st.bull_sos := false
    st.bear_sos := false

    bool is_inside = false
    if not na(st.prev_high) and not na(st.prev_low)
        is_inside := high < st.prev_high and low > st.prev_low

    if st.choch_lock
        if st.dir == 1 and not na(pl_val)
            st.choch_lock := false
        else if st.dir == -1 and not na(ph_val)
            st.choch_lock := false

    if st.pb_mode == 1
        if not st.pb_started
            st.pb_started            := true
            st.pb_extreme            := high
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_count              := 0
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
        else
            bool extreme_updated_1 = false
            if na(st.pb_extreme) or high > st.pb_extreme
                st.pb_extreme            := high
                st.pb_extreme_loc        := bar_index
                st.pb_extreme_close      := na
                st.pb_count              := 0
                st.pb_last_qualify_close := na
                st.pb_last_qualify_high  := na
                extreme_updated_1        := true
            bool extreme_is_bearish_1 = extreme_updated_1 and close < open
            bool is_candle1_1 = na(st.pb_last_qualify_close) and not extreme_updated_1
            if (not is_inside or is_candle1_1) and (not extreme_updated_1 or extreme_is_bearish_1)
                float threshold = na(st.pb_last_qualify_high) ? st.pb_extreme : st.pb_last_qualify_high
                if close < threshold - pbBuffer
                    st.pb_count              += 1
                    st.pb_last_qualify_close := close
                    st.pb_last_qualify_high  := low
            if st.pb_count >= 3 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
                if not na(st.ash_line)
                    line.delete(st.ash_line)
                if not na(st.ash_lbl)
                    label.delete(st.ash_lbl)
                st.ash      := st.pb_extreme
                st.ash_loc  := st.pb_extreme_loc
                st.ash_type := "LOCKED"
                st.ash_line := line.new(st.pb_extreme_loc, st.pb_extreme, bar_index, st.pb_extreme, color=bear_col, style=line.style_solid, width=1)
                st.ash_lbl  := label.new(st.pb_extreme_loc, st.pb_extreme, prefix + "ASH\n", color=color(na), textcolor=f_swingCol(bear_col), style=label.style_label_down, size=f_structSize())
                st.new_swing_high := true
                st.pb_mode    := 0
                st.pb_count   := 0
                st.choch_lock := false

    else if st.pb_mode == -1
        if not st.pb_started
            st.pb_started            := true
            st.pb_extreme            := low
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_count              := 0
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
        else
            bool extreme_updated_m1 = false
            if na(st.pb_extreme) or low < st.pb_extreme
                st.pb_extreme            := low
                st.pb_extreme_loc        := bar_index
                st.pb_extreme_close      := na
                st.pb_count              := 0
                st.pb_last_qualify_close := na
                st.pb_last_qualify_high  := na
                extreme_updated_m1       := true
            bool extreme_is_bullish_m1 = extreme_updated_m1 and close > open
            bool is_candle1_m1 = na(st.pb_last_qualify_close) and not extreme_updated_m1
            if (not is_inside or is_candle1_m1) and (not extreme_updated_m1 or extreme_is_bullish_m1)
                float threshold = na(st.pb_last_qualify_high) ? st.pb_extreme : st.pb_last_qualify_high
                if close > threshold + pbBuffer
                    st.pb_count              += 1
                    st.pb_last_qualify_close := close
                    st.pb_last_qualify_high  := high
            if st.pb_count >= 3 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
                if not na(st.asl_line)
                    line.delete(st.asl_line)
                if not na(st.asl_lbl)
                    label.delete(st.asl_lbl)
                st.asl      := st.pb_extreme
                st.asl_loc  := st.pb_extreme_loc
                st.asl_type := "LOCKED"
                st.asl_line := line.new(st.pb_extreme_loc, st.pb_extreme, bar_index, st.pb_extreme, color=bull_col, style=line.style_solid, width=1)
                st.asl_lbl  := label.new(st.pb_extreme_loc, st.pb_extreme, "\n" + prefix + "ASL", color=color(na), textcolor=f_swingCol(bull_col), style=label.style_label_up, size=f_structSize())
                st.new_swing_low := true
                st.pb_mode    := 0
                st.pb_count   := 0
                st.choch_lock := false

    st.prev_close := close
    st.prev_high  := high
    st.prev_low   := low

    if na(st.ash) and na(st.asl) and not st.seeded
        if not na(ph_val)
            st.create_ash(ph_val, bar_index[st.length], bear_col, false, prefix)
            st.dir := -1
        else if not na(pl_val)
            st.create_asl(pl_val, bar_index[st.length], bull_col, false, prefix)
            st.dir := 1

    if not st.seeded
        if not na(st.ash) and na(st.asl)
            float seed_low = low
            int   seed_loc = bar_index
            int   lb       = math.min(bar_index, 500)
            for i = 0 to lb
                if low[i] < seed_low
                    seed_low := low[i]
                    seed_loc := bar_index - i
            if seed_low < st.ash
                st.asl      := seed_low
                st.asl_loc  := seed_loc
                st.asl_type := ""
                st.asl_line := line.new(seed_loc, seed_low, bar_index, seed_low, color=bull_col, style=line.style_dashed, width=1)
                st.asl_lbl  := label.new(seed_loc, seed_low, "\n" + prefix + "ASL", color=color(na), textcolor=f_swingCol(bull_col), style=label.style_label_up, size=f_structSize())
                st.seeded := true
        else if not na(st.asl) and na(st.ash)
            float seed_high = high
            int   seed_loc  = bar_index
            int   lb        = math.min(bar_index, 500)
            for i = 0 to lb
                if high[i] > seed_high
                    seed_high := high[i]
                    seed_loc  := bar_index - i
            if seed_high > st.asl
                st.ash      := seed_high
                st.ash_loc  := seed_loc
                st.ash_type := ""
                st.ash_line := line.new(seed_loc, seed_high, bar_index, seed_high, color=bear_col, style=line.style_dashed, width=1)
                st.ash_lbl  := label.new(seed_loc, seed_high, prefix + "ASH\n", color=color(na), textcolor=f_swingCol(bear_col), style=label.style_label_down, size=f_structSize())
                st.seeded := true
        else if not na(st.ash) and not na(st.asl)
            st.seeded := true

    if na(st.last_conf_high) and na(st.last_conf_low)
        if not na(ph_val) and not na(st.ash) and st.ash_type == "" and st.pb_mode == 0
            if ph_val > st.ash
                st.create_ash(ph_val, bar_index[st.length], bear_col, false, prefix)
        if not na(pl_val) and not na(st.asl) and st.asl_type == "" and st.pb_mode == 0
            if pl_val < st.asl
                st.create_asl(pl_val, bar_index[st.length], bull_col, false, prefix)

    bool ash_broken = not na(st.ash) and close > st.ash
    bool asl_broken = not na(st.asl) and close < st.asl

    if ash_broken
        st.bull_bos := true
        st.bull_bos_high  := st.ash
        st.bull_bos_h_loc := st.ash_loc

        bool was_in_bear_pb = st.pb_mode == -1 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
        st.pb_mode  := 0
        st.pb_count := 0

        bool   is_choch    = st.dir == -1
        string brk_lbl_txt = is_choch ? prefix + "SOS" : prefix + "BOS"
        if is_choch
            st.bull_sos := true
        int    mid_x       = math.round((st.ash_loc + bar_index) / 2)
        label.new(mid_x, st.ash, "\n" + brk_lbl_txt, color=color(na), textcolor=bull_col, style=label.style_label_down, size=size.tiny)

        if is_choch
            st.choch_lock := true

        bool brk_already_conf_high = (st.ash == st.last_conf_high and st.ash_loc == st.last_conf_high_loc)
        if not na(st.ash_lbl)
            label.delete(st.ash_lbl)
        if not brk_already_conf_high
            bool   brk_is_hh  = na(st.last_conf_high) or st.ash >= st.last_conf_high
            string brk_high_t = brk_is_hh ? prefix + "HH" : prefix + "LH"
            color  brk_high_c = brk_is_hh ? bull_col : bear_col
            label.new(st.ash_loc, st.ash, brk_high_t + "\n", color=color(na), textcolor=f_swingCol(brk_high_c), style=label.style_label_down, size=f_structSize())

        if not na(st.ash_line)
            line.set_style(st.ash_line, line.style_solid)
            line.set_color(st.ash_line, bull_col)
            line.set_width(st.ash_line, 2)
            line.set_x2(st.ash_line, bar_index)
            st.ash_line := na

        st.last_conf_high     := st.ash
        st.last_conf_high_loc := st.ash_loc
        st.ash_lbl            := na
        st.ash                := na
        st.dir                := 1

        if was_in_bear_pb
            st.bull_bos_low   := st.pb_extreme
            st.bull_bos_l_loc := st.pb_extreme_loc
            if not na(st.asl_line)
                line.delete(st.asl_line)
            if not na(st.asl_lbl)
                label.delete(st.asl_lbl)
            bool   pb_is_hl = is_choch ? false : (na(st.last_conf_low) or st.pb_extreme >= st.last_conf_low)
            // On an SOS (fast reversal) the extreme is only the ACTIVE swing low —
            // it prints as ASL and is confirmed to HL/LL by the NEXT bullish break.
            string pb_low_t = is_choch ? prefix + "ASL" : (pb_is_hl ? prefix + "HL" : prefix + "LL")
            color  pb_low_c = is_choch ? bull_col : (pb_is_hl ? bull_col : bear_col)
            st.asl      := st.pb_extreme
            st.asl_loc  := st.pb_extreme_loc
            st.asl_type := "LOCKED"
            st.asl_line := line.new(st.pb_extreme_loc, st.pb_extreme, bar_index, st.pb_extreme, color=bull_col, style=line.style_solid, width=1)
            st.asl_lbl  := label.new(st.pb_extreme_loc, st.pb_extreme, "\n" + pb_low_t, color=color(na), textcolor=f_swingCol(pb_low_c), style=label.style_label_up, size=f_structSize())
            if not is_choch
                st.last_conf_low     := st.pb_extreme
                st.last_conf_low_loc := st.pb_extreme_loc
            st.pb_extreme            := high
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_mode               := 1
            st.pb_started            := true
        else
            if not na(st.asl)
                bool already_conf_low = (st.asl == st.last_conf_low and st.asl_loc == st.last_conf_low_loc)
                if not already_conf_low
                    bool   old_is_hl = is_choch ? false : (na(st.last_conf_low) or st.asl >= st.last_conf_low)
                    string old_low_t = old_is_hl ? prefix + "HL" : prefix + "LL"
                    color  old_low_c = old_is_hl ? bull_col : bear_col
                    if not na(st.asl_lbl)
                        label.delete(st.asl_lbl)
                    label.new(st.asl_loc, st.asl, "\n" + old_low_t, color=color(na), textcolor=f_swingCol(old_low_c), style=label.style_label_up, size=f_structSize())
                    st.last_conf_low     := st.asl
                    st.last_conf_low_loc := st.asl_loc
                else
                    if not na(st.asl_lbl)
                        label.delete(st.asl_lbl)
                if not na(st.asl_line)
                    line.delete(st.asl_line)
                st.asl_line := na
                st.asl_lbl  := na
                st.asl      := na

            float lowest_val = low
            int   lowest_loc = bar_index
            int   bars_back  = na(st.last_conf_high_loc) ? bar_index : bar_index - st.last_conf_high_loc
            if bars_back > 0
                int max_lb = math.min(math.min(bars_back, 1490), bar_index)
                for i = 0 to max_lb
                    if low[i] < lowest_val
                        lowest_val := low[i]
                        lowest_loc := bar_index - i

            // 🔴 KEEP THE ORIGINAL ANCHOR WHEN TWO BARS TIE FOR THE LOW. The scan above runs
            // newest-to-oldest with a strict `<`, so on an identical low it lands on the LATER bar
            // while this swing's label is already anchored on the EARLIER one — `already_conf_low`
            // compares bar index as well as price, misses, and a SECOND label is drawn at the same
            // price. Pine never deletes those, so they stack (the LL beside an HL, 2026-08-20).
            // Full story + measurements: engines/market_structure/CLAUDE.md -> tied-extreme fix.
            // 🔴 …AND THE SAME SNAP WHEN IT IS MORE EXTREME BUT NOT NEWER — A REFUSED WICK
            // (2026-08-21). Structure BREAKS ON A CLOSE, but this scan reads the raw `low` over a
            // window bounded by `last_conf_high_loc` — the OPPOSITE side — which reaches back BEFORE
            // the swing just confirmed. So it can resurrect a bar that pierced the level, closed back
            // inside and was correctly refused, and install it as the new active swing: EARLIER than
            // and LOWER than the swing just labelled. Full mechanism + the measurements:
            // `indicators/engines/mpc_assistant.pine`, same block.
            if not na(st.last_conf_low_loc) and (lowest_val == st.last_conf_low or (lowest_val < st.last_conf_low and lowest_loc <= st.last_conf_low_loc))
                lowest_val := st.last_conf_low
                lowest_loc := st.last_conf_low_loc
            st.bull_bos_low   := lowest_val
            st.bull_bos_l_loc := lowest_loc

            st.asl      := lowest_val
            st.asl_loc  := lowest_loc
            st.asl_type := ""
            st.asl_line := line.new(lowest_loc, lowest_val, bar_index, lowest_val, color=bull_col, style=line.style_solid, width=1)
            if lowest_val != st.last_conf_low
                st.asl_lbl := label.new(lowest_loc, lowest_val, "\n" + prefix + "ASL", color=color(na), textcolor=f_swingCol(bull_col), style=label.style_label_up, size=f_structSize())
            else
                st.asl_lbl := na

            st.pb_mode               := 1
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_extreme            := high
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true

    else if asl_broken
        st.bear_bos := true
        st.bear_bos_low   := st.asl
        st.bear_bos_l_loc := st.asl_loc

        bool was_in_bull_pb = st.pb_mode == 1 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
        st.pb_mode  := 0
        st.pb_count := 0

        bool   is_choch    = st.dir == 1
        string brk_lbl_txt = is_choch ? prefix + "SOS" : prefix + "BOS"
        if is_choch
            st.bear_sos := true
        int    mid_x       = math.round((st.asl_loc + bar_index) / 2)
        label.new(mid_x, st.asl, brk_lbl_txt + "\n", color=color(na), textcolor=bear_col, style=label.style_label_up, size=size.tiny)

        if is_choch
            st.choch_lock := true

        bool brk_already_conf_low = (st.asl == st.last_conf_low and st.asl_loc == st.last_conf_low_loc)
        if not na(st.asl_lbl)
            label.delete(st.asl_lbl)
        if not brk_already_conf_low
            bool   brk_is_hl = na(st.last_conf_low) or st.asl >= st.last_conf_low
            string brk_low_t = brk_is_hl ? prefix + "HL" : prefix + "LL"
            label.new(st.asl_loc, st.asl, "\n" + brk_low_t, color=color(na), textcolor=f_swingCol(bear_col), style=label.style_label_up, size=f_structSize())

        if not na(st.asl_line)
            line.set_style(st.asl_line, line.style_solid)
            line.set_color(st.asl_line, bear_col)
            line.set_width(st.asl_line, 2)
            line.set_x2(st.asl_line, bar_index)
            st.asl_line := na

        st.last_conf_low     := st.asl
        st.last_conf_low_loc := st.asl_loc
        st.asl_lbl           := na
        st.asl               := na
        st.dir               := -1

        if was_in_bull_pb
            st.bear_bos_high  := st.pb_extreme
            st.bear_bos_h_loc := st.pb_extreme_loc
            if not na(st.ash_line)
                line.delete(st.ash_line)
            if not na(st.ash_lbl)
                label.delete(st.ash_lbl)
            bool   pb_is_hh  = na(st.last_conf_high) or st.pb_extreme >= st.last_conf_high
            // On an SOS (fast reversal) the extreme is only the ACTIVE swing high —
            // it prints as ASH and is confirmed to HH/LH by the NEXT bearish break.
            string pb_high_t = is_choch ? prefix + "ASH" : (pb_is_hh ? prefix + "HH" : prefix + "LH")
            color  pb_high_c = is_choch ? bear_col : (pb_is_hh ? bull_col : bear_col)
            st.ash      := st.pb_extreme
            st.ash_loc  := st.pb_extreme_loc
            st.ash_type := "LOCKED"
            st.ash_line := line.new(st.pb_extreme_loc, st.pb_extreme, bar_index, st.pb_extreme, color=bear_col, style=line.style_solid, width=1)
            st.ash_lbl  := label.new(st.pb_extreme_loc, st.pb_extreme, pb_high_t + "\n", color=color(na), textcolor=f_swingCol(pb_high_c), style=label.style_label_down, size=f_structSize())
            if not is_choch
                st.last_conf_high     := st.pb_extreme
                st.last_conf_high_loc := st.pb_extreme_loc
            st.pb_extreme            := low
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_mode               := -1
            st.pb_started            := true
        else
            float highest_val = high
            int   highest_loc = bar_index
            int   bars_back   = na(st.last_conf_low_loc) ? bar_index : bar_index - st.last_conf_low_loc
            if bars_back > 0
                int max_lb = math.min(math.min(bars_back, 1490), bar_index)
                for i = 0 to max_lb
                    if high[i] > highest_val
                        highest_val := high[i]
                        highest_loc := bar_index - i

            if not na(st.ash)
                bool already_conf_high = (st.ash == st.last_conf_high and st.ash_loc == st.last_conf_high_loc)
                if not already_conf_high
                    bool   old_is_hh  = is_choch ? true : (na(st.last_conf_high) or st.ash >= st.last_conf_high)
                    string old_high_t = old_is_hh ? prefix + "HH" : prefix + "LH"
                    color  old_high_c = old_is_hh ? bull_col : bear_col
                    if not na(st.ash_lbl)
                        label.delete(st.ash_lbl)
                    label.new(st.ash_loc, st.ash, old_high_t + "\n", color=color(na), textcolor=f_swingCol(old_high_c), style=label.style_label_down, size=f_structSize())
                    st.last_conf_high     := st.ash
                    st.last_conf_high_loc := st.ash_loc
                else
                    if not na(st.ash_lbl)
                        label.delete(st.ash_lbl)
                if not na(st.ash_line)
                    line.delete(st.ash_line)
                st.ash_line := na
                st.ash_lbl  := na
                st.ash      := na
            else
                // [doc 17] Neither an active pullback high nor a confirmed ASH was available to  -> docs/mpc_h4_sweep_strategy.md
                bool   fallback_is_hh  = na(st.last_conf_high) or highest_val >= st.last_conf_high
                string fallback_high_t = fallback_is_hh ? prefix + "HH" : prefix + "LH"
                color  fallback_high_c = fallback_is_hh ? bull_col : bear_col
                if highest_val != st.last_conf_high
                    label.new(highest_loc, highest_val, fallback_high_t + "\n", color=color(na), textcolor=f_swingCol(fallback_high_c), style=label.style_label_down, size=f_structSize())
                    st.last_conf_high     := highest_val
                    st.last_conf_high_loc := highest_loc

            // 🔴 Mirror of the low-side tie guard above. This side stacks HH on HH rather than LL on
            // HL, which is why it went unnoticed far longer despite being the MORE common of the two.
            // ⚠ IT MUST SIT HERE, AFTER THE PROMOTION, NOT BESIDE THE SCAN — placed by the scan it
            // reads a `last_conf_high` the promotion has not written yet and silently does nothing.
            // 🔴 Mirror of the low side's refused-wick snap (2026-08-21) — see the note there.
            // This side is the `ASH` printed beside an `HH`, and the bogus `HH` that follows once
            // that ASH is broken. Must stay AFTER the promotion, same as the tie guard it replaces.
            if not na(st.last_conf_high_loc) and (highest_val == st.last_conf_high or (highest_val > st.last_conf_high and highest_loc <= st.last_conf_high_loc))
                highest_val := st.last_conf_high
                highest_loc := st.last_conf_high_loc
            st.bear_bos_high  := highest_val
            st.bear_bos_h_loc := highest_loc

            st.ash      := highest_val
            st.ash_loc  := highest_loc
            st.ash_type := ""
            st.ash_line := line.new(highest_loc, highest_val, bar_index, highest_val, color=bear_col, style=line.style_solid, width=1)
            if highest_val != st.last_conf_high
                st.ash_lbl := label.new(highest_loc, highest_val, prefix + "ASH\n", color=color(na), textcolor=f_swingCol(bear_col), style=label.style_label_down, size=f_structSize())
            else
                st.ash_lbl := na

            st.pb_mode               := -1
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_extreme            := low
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true

    if not na(st.ash_line)
        line.set_x2(st.ash_line, bar_index)
        if not showExternal
            line.set_color(st.ash_line, color(na))
    if not na(st.asl_line)
        line.set_x2(st.asl_line, bar_index)
        if not showExternal
            line.set_color(st.asl_line, color(na))
    if not showExternal
        if not na(st.ash_lbl)
            label.set_textcolor(st.ash_lbl, color(na))
        if not na(st.asl_lbl)
            label.set_textcolor(st.asl_lbl, color(na))

type SMCStructure15
    int    length
    float  ash             = na
    int    ash_loc         = na
    string ash_type        = ""
    line   ash_line        = na
    label  ash_lbl         = na
    float  asl             = na
    int    asl_loc         = na
    string asl_type        = ""
    line   asl_line        = na
    label  asl_lbl         = na
    float  last_conf_high     = na
    int    last_conf_high_loc = na
    float  last_conf_low      = na
    int    last_conf_low_loc  = na
    int    dir            = 0
    bool   choch_lock     = false
    line   choch_ref      = na
    int    pb_mode        = 0
    int    pb_count       = 0
    float  pb_level       = na
    float  pb_extreme     = na
    int    pb_extreme_loc = na
    line   pb_line        = na
    bool   pb_started     = false
    float  pb_last_qualify_close = na
    float  pb_last_qualify_high  = na
    float  pb_extreme_close      = na
    float  prev_close     = na
    float  prev_high      = na
    float  prev_low       = na
    bool   seeded         = false
    bool   bull_bos       = false
    float  bull_bos_high  = na
    int    bull_bos_h_loc = na
    float  bull_bos_low   = na
    int    bull_bos_l_loc = na
    bool   bear_bos       = false
    float  bear_bos_high  = na
    int    bear_bos_h_loc = na
    float  bear_bos_low   = na
    int    bear_bos_l_loc = na
    bool   new_swing_high = false
    bool   new_swing_low  = false
    bool   bull_sos       = false
    bool   bear_sos       = false

// prefix: "" for external, "i" for internal
// bull_col / bear_col allow per-instance colors
method create_ash15(SMCStructure15 st, float val, int loc, color col, bool solid, string prefix) =>
    if not na(st.ash_line)
        line.delete(st.ash_line)
    if not na(st.ash_lbl)
        label.delete(st.ash_lbl)
        st.ash_lbl := na
    st.ash      := val
    st.ash_loc  := loc
    st.ash_type := ""
    st.ash_lbl  := label.new(loc, val, prefix + "ASH\n", color=color(na), textcolor=f_swingCol(col), style=label.style_label_down, size=f_structSize())
    st.ash_line := line.new(loc, val, bar_index, val, color=col, style=solid ? line.style_solid : line.style_dashed, width=solid ? 2 : 1)

method create_asl15(SMCStructure15 st, float val, int loc, color col, bool solid, string prefix) =>
    if not na(st.asl_line)
        line.delete(st.asl_line)
    if not na(st.asl_lbl)
        label.delete(st.asl_lbl)
        st.asl_lbl := na
    st.asl      := val
    st.asl_loc  := loc
    st.asl_type := ""
    st.asl_lbl  := label.new(loc, val, "\n" + prefix + "ASL", color=color(na), textcolor=f_swingCol(col), style=label.style_label_up, size=f_structSize())
    st.asl_line := line.new(loc, val, bar_index, val, color=col, style=solid ? line.style_solid : line.style_dashed, width=solid ? 2 : 1)

// process() now accepts prefix + bull/bear colors so both instances share one method
method process15(SMCStructure15 st, float ph_val, float pl_val, string prefix, color bull_col, color bear_col, float _o, float _h, float _l, float _c, int _pbi) =>

    st.bull_bos := false
    st.bear_bos := false
    st.new_swing_high := false
    st.new_swing_low  := false
    st.bull_sos := false
    st.bear_sos := false

    bool is_inside = false
    if not na(st.prev_high) and not na(st.prev_low)
        is_inside := _h < st.prev_high and _l > st.prev_low

    if st.choch_lock
        if st.dir == 1 and not na(pl_val)
            st.choch_lock := false
        else if st.dir == -1 and not na(ph_val)
            st.choch_lock := false

    if st.pb_mode == 1
        if not st.pb_started
            st.pb_started            := true
            st.pb_extreme            := _h
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_count              := 0
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
        else
            bool extreme_updated_1 = false
            if na(st.pb_extreme) or _h > st.pb_extreme
                st.pb_extreme            := _h
                st.pb_extreme_loc        := bar_index
                st.pb_extreme_close      := na
                st.pb_count              := 0
                st.pb_last_qualify_close := na
                st.pb_last_qualify_high  := na
                extreme_updated_1        := true
            bool extreme_is_bearish_1 = extreme_updated_1 and _c < _o
            bool is_candle1_1 = na(st.pb_last_qualify_close) and not extreme_updated_1
            if (not is_inside or is_candle1_1) and (not extreme_updated_1 or extreme_is_bearish_1)
                float threshold = na(st.pb_last_qualify_high) ? st.pb_extreme : st.pb_last_qualify_high
                if _c < threshold - pbBuffer
                    st.pb_count              += 1
                    st.pb_last_qualify_close := _c
                    st.pb_last_qualify_high  := _l
            if st.pb_count >= 3 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
                if not na(st.ash_line)
                    line.delete(st.ash_line)
                if not na(st.ash_lbl)
                    label.delete(st.ash_lbl)
                st.ash      := st.pb_extreme
                st.ash_loc  := st.pb_extreme_loc
                st.ash_type := "LOCKED"
                st.ash_line := line.new(st.pb_extreme_loc, st.pb_extreme, bar_index, st.pb_extreme, color=bear_col, style=line.style_solid, width=1)
                st.ash_lbl  := label.new(st.pb_extreme_loc, st.pb_extreme, prefix + "ASH\n", color=color(na), textcolor=f_swingCol(bear_col), style=label.style_label_down, size=f_structSize())
                st.new_swing_high := true
                st.pb_mode    := 0
                st.pb_count   := 0
                st.choch_lock := false

    else if st.pb_mode == -1
        if not st.pb_started
            st.pb_started            := true
            st.pb_extreme            := _l
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_count              := 0
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
        else
            bool extreme_updated_m1 = false
            if na(st.pb_extreme) or _l < st.pb_extreme
                st.pb_extreme            := _l
                st.pb_extreme_loc        := bar_index
                st.pb_extreme_close      := na
                st.pb_count              := 0
                st.pb_last_qualify_close := na
                st.pb_last_qualify_high  := na
                extreme_updated_m1       := true
            bool extreme_is_bullish_m1 = extreme_updated_m1 and _c > _o
            bool is_candle1_m1 = na(st.pb_last_qualify_close) and not extreme_updated_m1
            if (not is_inside or is_candle1_m1) and (not extreme_updated_m1 or extreme_is_bullish_m1)
                float threshold = na(st.pb_last_qualify_high) ? st.pb_extreme : st.pb_last_qualify_high
                if _c > threshold + pbBuffer
                    st.pb_count              += 1
                    st.pb_last_qualify_close := _c
                    st.pb_last_qualify_high  := _h
            if st.pb_count >= 3 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
                if not na(st.asl_line)
                    line.delete(st.asl_line)
                if not na(st.asl_lbl)
                    label.delete(st.asl_lbl)
                st.asl      := st.pb_extreme
                st.asl_loc  := st.pb_extreme_loc
                st.asl_type := "LOCKED"
                st.asl_line := line.new(st.pb_extreme_loc, st.pb_extreme, bar_index, st.pb_extreme, color=bull_col, style=line.style_solid, width=1)
                st.asl_lbl  := label.new(st.pb_extreme_loc, st.pb_extreme, "\n" + prefix + "ASL", color=color(na), textcolor=f_swingCol(bull_col), style=label.style_label_up, size=f_structSize())
                st.new_swing_low := true
                st.pb_mode    := 0
                st.pb_count   := 0
                st.choch_lock := false

    st.prev_close := _c
    st.prev_high  := _h
    st.prev_low   := _l

    if na(st.ash) and na(st.asl) and not st.seeded
        if not na(ph_val)
            st.create_ash15(ph_val, _pbi, bear_col, false, prefix)
            st.dir := -1
        else if not na(pl_val)
            st.create_asl15(pl_val, _pbi, bull_col, false, prefix)
            st.dir := 1

    if not st.seeded
        if not na(st.ash) and na(st.asl)
            float seed_low = _l
            int   seed_loc = bar_index
            int   lb       = math.min(bar_index, 500)
            for i = 0 to lb
                if low[i] < seed_low
                    seed_low := low[i]
                    seed_loc := bar_index - i
            if seed_low < st.ash
                st.asl      := seed_low
                st.asl_loc  := seed_loc
                st.asl_type := ""
                st.asl_line := line.new(seed_loc, seed_low, bar_index, seed_low, color=bull_col, style=line.style_dashed, width=1)
                st.asl_lbl  := label.new(seed_loc, seed_low, "\n" + prefix + "ASL", color=color(na), textcolor=f_swingCol(bull_col), style=label.style_label_up, size=f_structSize())
                st.seeded := true
        else if not na(st.asl) and na(st.ash)
            float seed_high = _h
            int   seed_loc  = bar_index
            int   lb        = math.min(bar_index, 500)
            for i = 0 to lb
                if high[i] > seed_high
                    seed_high := high[i]
                    seed_loc  := bar_index - i
            if seed_high > st.asl
                st.ash      := seed_high
                st.ash_loc  := seed_loc
                st.ash_type := ""
                st.ash_line := line.new(seed_loc, seed_high, bar_index, seed_high, color=bear_col, style=line.style_dashed, width=1)
                st.ash_lbl  := label.new(seed_loc, seed_high, prefix + "ASH\n", color=color(na), textcolor=f_swingCol(bear_col), style=label.style_label_down, size=f_structSize())
                st.seeded := true
        else if not na(st.ash) and not na(st.asl)
            st.seeded := true

    if na(st.last_conf_high) and na(st.last_conf_low)
        if not na(ph_val) and not na(st.ash) and st.ash_type == "" and st.pb_mode == 0
            if ph_val > st.ash
                st.create_ash15(ph_val, _pbi, bear_col, false, prefix)
        if not na(pl_val) and not na(st.asl) and st.asl_type == "" and st.pb_mode == 0
            if pl_val < st.asl
                st.create_asl15(pl_val, _pbi, bull_col, false, prefix)

    bool ash_broken = not na(st.ash) and _c > st.ash
    bool asl_broken = not na(st.asl) and _c < st.asl

    if ash_broken
        st.bull_bos := true
        st.bull_bos_high  := st.ash
        st.bull_bos_h_loc := st.ash_loc

        bool was_in_bear_pb = st.pb_mode == -1 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
        st.pb_mode  := 0
        st.pb_count := 0

        bool   is_choch    = st.dir == -1
        string brk_lbl_txt = is_choch ? prefix + "SOS" : prefix + "BOS"
        if is_choch
            st.bull_sos := true
        int    mid_x       = math.round((st.ash_loc + bar_index) / 2)
        label.new(mid_x, st.ash, "\n" + brk_lbl_txt, color=color(na), textcolor=bull_col, style=label.style_label_down, size=size.tiny)

        if is_choch
            st.choch_lock := true

        bool brk_already_conf_high = (st.ash == st.last_conf_high and st.ash_loc == st.last_conf_high_loc)
        if not na(st.ash_lbl)
            label.delete(st.ash_lbl)
        if not brk_already_conf_high
            bool   brk_is_hh  = na(st.last_conf_high) or st.ash >= st.last_conf_high
            string brk_high_t = brk_is_hh ? prefix + "HH" : prefix + "LH"
            color  brk_high_c = brk_is_hh ? bull_col : bear_col
            label.new(st.ash_loc, st.ash, brk_high_t + "\n", color=color(na), textcolor=f_swingCol(brk_high_c), style=label.style_label_down, size=f_structSize())

        if not na(st.ash_line)
            line.set_style(st.ash_line, line.style_solid)
            line.set_color(st.ash_line, bull_col)
            line.set_width(st.ash_line, 2)
            line.set_x2(st.ash_line, bar_index)
            st.ash_line := na

        st.last_conf_high     := st.ash
        st.last_conf_high_loc := st.ash_loc
        st.ash_lbl            := na
        st.ash                := na
        st.dir                := 1

        if was_in_bear_pb
            st.bull_bos_low   := st.pb_extreme
            st.bull_bos_l_loc := st.pb_extreme_loc
            if not na(st.asl_line)
                line.delete(st.asl_line)
            if not na(st.asl_lbl)
                label.delete(st.asl_lbl)
            bool   pb_is_hl = is_choch ? false : (na(st.last_conf_low) or st.pb_extreme >= st.last_conf_low)
            // On an SOS (fast reversal) the extreme is only the ACTIVE swing _l —
            // it prints as ASL and is confirmed to HL/LL by the NEXT bullish break.
            string pb_low_t = is_choch ? prefix + "ASL" : (pb_is_hl ? prefix + "HL" : prefix + "LL")
            color  pb_low_c = is_choch ? bull_col : (pb_is_hl ? bull_col : bear_col)
            st.asl      := st.pb_extreme
            st.asl_loc  := st.pb_extreme_loc
            st.asl_type := "LOCKED"
            st.asl_line := line.new(st.pb_extreme_loc, st.pb_extreme, bar_index, st.pb_extreme, color=bull_col, style=line.style_solid, width=1)
            st.asl_lbl  := label.new(st.pb_extreme_loc, st.pb_extreme, "\n" + pb_low_t, color=color(na), textcolor=f_swingCol(pb_low_c), style=label.style_label_up, size=f_structSize())
            if not is_choch
                st.last_conf_low     := st.pb_extreme
                st.last_conf_low_loc := st.pb_extreme_loc
            st.pb_extreme            := _h
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_mode               := 1
            st.pb_started            := true
        else
            if not na(st.asl)
                bool already_conf_low = (st.asl == st.last_conf_low and st.asl_loc == st.last_conf_low_loc)
                if not already_conf_low
                    bool   old_is_hl = is_choch ? false : (na(st.last_conf_low) or st.asl >= st.last_conf_low)
                    string old_low_t = old_is_hl ? prefix + "HL" : prefix + "LL"
                    color  old_low_c = old_is_hl ? bull_col : bear_col
                    if not na(st.asl_lbl)
                        label.delete(st.asl_lbl)
                    label.new(st.asl_loc, st.asl, "\n" + old_low_t, color=color(na), textcolor=f_swingCol(old_low_c), style=label.style_label_up, size=f_structSize())
                    st.last_conf_low     := st.asl
                    st.last_conf_low_loc := st.asl_loc
                else
                    if not na(st.asl_lbl)
                        label.delete(st.asl_lbl)
                if not na(st.asl_line)
                    line.delete(st.asl_line)
                st.asl_line := na
                st.asl_lbl  := na
                st.asl      := na

            float lowest_val = _l
            int   lowest_loc = bar_index
            int   bars_back  = na(st.last_conf_high_loc) ? bar_index : bar_index - st.last_conf_high_loc
            if bars_back > 0
                int max_lb = math.min(math.min(bars_back, 1490), bar_index)
                for i = 0 to max_lb
                    if low[i] < lowest_val
                        lowest_val := low[i]
                        lowest_loc := bar_index - i

            // 🔴 KEEP THE ORIGINAL ANCHOR WHEN TWO BARS TIE FOR THE LOW. The scan above runs
            // newest-to-oldest with a strict `<`, so on an identical _l it lands on the LATER bar
            // while this swing's label is already anchored on the EARLIER one — `already_conf_low`
            // compares bar index as well as price, misses, and a SECOND label is drawn at the same
            // price. Pine never deletes those, so they stack (the LL beside an HL, 2026-08-20).
            // Full story + measurements: engines/market_structure/CLAUDE.md -> tied-extreme fix.
            // 🔴 …AND THE SAME SNAP WHEN IT IS MORE EXTREME BUT NOT NEWER — A REFUSED WICK
            // (2026-08-21). Structure BREAKS ON A CLOSE, but this scan reads the raw `_l` over a
            // window bounded by `last_conf_high_loc` — the OPPOSITE side — which reaches back BEFORE
            // the swing just confirmed. So it can resurrect a bar that pierced the level, closed back
            // inside and was correctly refused, and install it as the new active swing: EARLIER than
            // and LOWER than the swing just labelled. Full mechanism + the measurements:
            // `indicators/engines/mpc_assistant.pine`, same block.
            if not na(st.last_conf_low_loc) and (lowest_val == st.last_conf_low or (lowest_val < st.last_conf_low and lowest_loc <= st.last_conf_low_loc))
                lowest_val := st.last_conf_low
                lowest_loc := st.last_conf_low_loc
            st.bull_bos_low   := lowest_val
            st.bull_bos_l_loc := lowest_loc

            st.asl      := lowest_val
            st.asl_loc  := lowest_loc
            st.asl_type := ""
            st.asl_line := line.new(lowest_loc, lowest_val, bar_index, lowest_val, color=bull_col, style=line.style_solid, width=1)
            if lowest_val != st.last_conf_low
                st.asl_lbl := label.new(lowest_loc, lowest_val, "\n" + prefix + "ASL", color=color(na), textcolor=f_swingCol(bull_col), style=label.style_label_up, size=f_structSize())
            else
                st.asl_lbl := na

            st.pb_mode               := 1
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_extreme            := _h
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true

    else if asl_broken
        st.bear_bos := true
        st.bear_bos_low   := st.asl
        st.bear_bos_l_loc := st.asl_loc

        bool was_in_bull_pb = st.pb_mode == 1 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
        st.pb_mode  := 0
        st.pb_count := 0

        bool   is_choch    = st.dir == 1
        string brk_lbl_txt = is_choch ? prefix + "SOS" : prefix + "BOS"
        if is_choch
            st.bear_sos := true
        int    mid_x       = math.round((st.asl_loc + bar_index) / 2)
        label.new(mid_x, st.asl, brk_lbl_txt + "\n", color=color(na), textcolor=bear_col, style=label.style_label_up, size=size.tiny)

        if is_choch
            st.choch_lock := true

        bool brk_already_conf_low = (st.asl == st.last_conf_low and st.asl_loc == st.last_conf_low_loc)
        if not na(st.asl_lbl)
            label.delete(st.asl_lbl)
        if not brk_already_conf_low
            bool   brk_is_hl = na(st.last_conf_low) or st.asl >= st.last_conf_low
            string brk_low_t = brk_is_hl ? prefix + "HL" : prefix + "LL"
            label.new(st.asl_loc, st.asl, "\n" + brk_low_t, color=color(na), textcolor=f_swingCol(bear_col), style=label.style_label_up, size=f_structSize())

        if not na(st.asl_line)
            line.set_style(st.asl_line, line.style_solid)
            line.set_color(st.asl_line, bear_col)
            line.set_width(st.asl_line, 2)
            line.set_x2(st.asl_line, bar_index)
            st.asl_line := na

        st.last_conf_low     := st.asl
        st.last_conf_low_loc := st.asl_loc
        st.asl_lbl           := na
        st.asl               := na
        st.dir               := -1

        if was_in_bull_pb
            st.bear_bos_high  := st.pb_extreme
            st.bear_bos_h_loc := st.pb_extreme_loc
            if not na(st.ash_line)
                line.delete(st.ash_line)
            if not na(st.ash_lbl)
                label.delete(st.ash_lbl)
            bool   pb_is_hh  = na(st.last_conf_high) or st.pb_extreme >= st.last_conf_high
            // On an SOS (fast reversal) the extreme is only the ACTIVE swing _h —
            // it prints as ASH and is confirmed to HH/LH by the NEXT bearish break.
            string pb_high_t = is_choch ? prefix + "ASH" : (pb_is_hh ? prefix + "HH" : prefix + "LH")
            color  pb_high_c = is_choch ? bear_col : (pb_is_hh ? bull_col : bear_col)
            st.ash      := st.pb_extreme
            st.ash_loc  := st.pb_extreme_loc
            st.ash_type := "LOCKED"
            st.ash_line := line.new(st.pb_extreme_loc, st.pb_extreme, bar_index, st.pb_extreme, color=bear_col, style=line.style_solid, width=1)
            st.ash_lbl  := label.new(st.pb_extreme_loc, st.pb_extreme, pb_high_t + "\n", color=color(na), textcolor=f_swingCol(pb_high_c), style=label.style_label_down, size=f_structSize())
            if not is_choch
                st.last_conf_high     := st.pb_extreme
                st.last_conf_high_loc := st.pb_extreme_loc
            st.pb_extreme            := _l
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_mode               := -1
            st.pb_started            := true
        else
            float highest_val = _h
            int   highest_loc = bar_index
            int   bars_back   = na(st.last_conf_low_loc) ? bar_index : bar_index - st.last_conf_low_loc
            if bars_back > 0
                int max_lb = math.min(math.min(bars_back, 1490), bar_index)
                for i = 0 to max_lb
                    if high[i] > highest_val
                        highest_val := high[i]
                        highest_loc := bar_index - i

            if not na(st.ash)
                bool already_conf_high = (st.ash == st.last_conf_high and st.ash_loc == st.last_conf_high_loc)
                if not already_conf_high
                    bool   old_is_hh  = is_choch ? true : (na(st.last_conf_high) or st.ash >= st.last_conf_high)
                    string old_high_t = old_is_hh ? prefix + "HH" : prefix + "LH"
                    color  old_high_c = old_is_hh ? bull_col : bear_col
                    if not na(st.ash_lbl)
                        label.delete(st.ash_lbl)
                    label.new(st.ash_loc, st.ash, old_high_t + "\n", color=color(na), textcolor=f_swingCol(old_high_c), style=label.style_label_down, size=f_structSize())
                    st.last_conf_high     := st.ash
                    st.last_conf_high_loc := st.ash_loc
                else
                    if not na(st.ash_lbl)
                        label.delete(st.ash_lbl)
                if not na(st.ash_line)
                    line.delete(st.ash_line)
                st.ash_line := na
                st.ash_lbl  := na
                st.ash      := na
            else
                // [doc 17] Neither an active pullback _h nor a confirmed ASH was available to  -> docs/mpc_h4_sweep_strategy.md
                bool   fallback_is_hh  = na(st.last_conf_high) or highest_val >= st.last_conf_high
                string fallback_high_t = fallback_is_hh ? prefix + "HH" : prefix + "LH"
                color  fallback_high_c = fallback_is_hh ? bull_col : bear_col
                if highest_val != st.last_conf_high
                    label.new(highest_loc, highest_val, fallback_high_t + "\n", color=color(na), textcolor=f_swingCol(fallback_high_c), style=label.style_label_down, size=f_structSize())
                    st.last_conf_high     := highest_val
                    st.last_conf_high_loc := highest_loc

            // 🔴 Mirror of the _l-side tie guard above. This side stacks HH on HH rather than LL on
            // HL, which is why it went unnoticed far longer despite being the MORE common of the two.
            // ⚠ IT MUST SIT HERE, AFTER THE PROMOTION, NOT BESIDE THE SCAN — placed by the scan it
            // reads a `last_conf_high` the promotion has not written yet and silently does nothing.
            // 🔴 Mirror of the _l side's refused-wick snap (2026-08-21) — see the note there.
            // This side is the `ASH` printed beside an `HH`, and the bogus `HH` that follows once
            // that ASH is broken. Must stay AFTER the promotion, same as the tie guard it replaces.
            if not na(st.last_conf_high_loc) and (highest_val == st.last_conf_high or (highest_val > st.last_conf_high and highest_loc <= st.last_conf_high_loc))
                highest_val := st.last_conf_high
                highest_loc := st.last_conf_high_loc
            st.bear_bos_high  := highest_val
            st.bear_bos_h_loc := highest_loc

            st.ash      := highest_val
            st.ash_loc  := highest_loc
            st.ash_type := ""
            st.ash_line := line.new(highest_loc, highest_val, bar_index, highest_val, color=bear_col, style=line.style_solid, width=1)
            if highest_val != st.last_conf_high
                st.ash_lbl := label.new(highest_loc, highest_val, prefix + "ASH\n", color=color(na), textcolor=f_swingCol(bear_col), style=label.style_label_down, size=f_structSize())
            else
                st.ash_lbl := na

            st.pb_mode               := -1
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_extreme            := _l
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true

    if not na(st.ash_line)
        line.set_x2(st.ash_line, bar_index)
        if not showExternal
            line.set_color(st.ash_line, color(na))
    if not na(st.asl_line)
        line.set_x2(st.asl_line, bar_index)
        if not showExternal
            line.set_color(st.asl_line, color(na))
    if not showExternal
        if not na(st.ash_lbl)
            label.set_textcolor(st.ash_lbl, color(na))
        if not na(st.asl_lbl)
            label.set_textcolor(st.asl_lbl, color(na))

// [doc 6] EXECUTION — EXTERNAL STRUCTURE ON THE CHART'S OWN BARS
// This instance is the TRIGGER. Its change of character is what arms a trade.
var st = SMCStructure.new(majorLength)
ph = ta.pivothigh(high, majorLength, majorLength)
pl = ta.pivotlow(low,  majorLength, majorLength)
color extBullCol = showExternal ? bullColor : color(na)
color extBearCol = showExternal ? bearColor : color(na)
st.process(ph, pl, "", extBullCol, extBearCol)
if not na(st.ash_line)
    line.set_x2(st.ash_line, bar_index)
if not na(st.asl_line)
    line.set_x2(st.asl_line, bar_index)

// [doc 7] THE 15-MINUTE HALF — aggregated in code, never requested  -> docs/mpc_extreme_leg_strategy.md
// ⚠ Aggregation rather than `request.security` is deliberate. The state machine has to be FED, and
// a security call returns a value; feeding it three closed 5-minute bars at a time is the only way
// it sees the same bars a 15-minute chart would, in the same order, with no lookahead anywhere.
var float aggO = na
var float aggH = na
var float aggL = na
var float aggC = na
int t15 = time("15")
bool newPeriod = na(t15[1]) or t15 != t15[1]
var float doneO = na
var float doneH = na
var float doneL = na
var float doneC = na
bool periodClosed = false
if newPeriod
    if not na(aggO)
        doneO := aggO
        doneH := aggH
        doneL := aggL
        doneC := aggC
        periodClosed := true
    aggO := open
    aggH := high
    aggL := low
    aggC := close
else
    aggH := math.max(aggH, high)
    aggL := math.min(aggL, low)
    aggC := close

// [doc 8] 15-minute pivots, detected over the aggregated series
// `ta.pivothigh` reads the CHART's series, so it cannot be used here — the aggregate is not a
// series. This is the same rule applied by hand over a rolling window of completed 15m bars.
var float[] hh15 = array.new_float()
var float[] ll15 = array.new_float()
var int[]   bi15 = array.new_int()
float ph15 = na
float pl15 = na
int   pivBar = na
if periodClosed
    array.push(hh15, doneH)
    array.push(ll15, doneL)
    array.push(bi15, bar_index)
    int cap = majorLength * 2 + 1
    if array.size(hh15) > cap
        array.shift(hh15)
        array.shift(ll15)
        array.shift(bi15)
    if array.size(hh15) == cap
        float candH = array.get(hh15, majorLength)
        float candL = array.get(ll15, majorLength)
        pivBar := array.get(bi15, majorLength)
        bool isHigh = true
        bool isLow  = true
        for k = 0 to cap - 1
            if k != majorLength
                if array.get(hh15, k) >= candH
                    isHigh := false
                if array.get(ll15, k) <= candL
                    isLow := false
        ph15 := isHigh ? candH : na
        pl15 := isLow  ? candL : na

var st15 = SMCStructure15.new(majorLength)
if periodClosed
    st15.process15(ph15, pl15, "H", showHtfSwing ? bullColor : color(na), showHtfSwing ? bearColor : color(na), doneO, doneH, doneL, doneC, pivBar)
if showHtfSwing
    if not na(st15.ash_line)
        line.set_x2(st15.ash_line, bar_index)
    if not na(st15.asl_line)
        line.set_x2(st15.asl_line, bar_index)

// [doc 9] THE LEVELS — previous period highs and lows, and the last completed session's
// ⚠ `[1]` paired with `lookahead_on` is the non-repainting idiom for a PREVIOUS completed period.
// Either one alone repaints; the pair is what makes it safe.
f_prevHigh(string tf) => request.security(syminfo.tickerid, tf, high[1], lookahead = barmerge.lookahead_on)
f_prevLow(string tf)  => request.security(syminfo.tickerid, tf, low[1],  lookahead = barmerge.lookahead_on)
float h4H = f_prevHigh("240")
float h4L = f_prevLow("240")
float dH  = f_prevHigh("D")
float dL  = f_prevLow("D")
float wH  = f_prevHigh("W")
float wL  = f_prevLow("W")

// The last completed session's extremes, tracked on the chart rather than requested — a session is
// a clock window, not a timeframe, so there is nothing to request.
f_sess(string spec) =>
    bool inSess = not na(time(timeframe.period, spec))
    var float runH = na
    var float runL = na
    var float lastH = na
    var float lastL = na
    if inSess
        runH := na(runH) or not inSess[1] ? high : math.max(runH, high)
        runL := na(runL) or not inSess[1] ? low  : math.min(runL, low)
    else if not inSess and inSess[1]
        lastH := runH
        lastL := runL
        runH := na
        runL := na
    [lastH, lastL]

[asiaH, asiaL] = f_sess("0000-0900")
[ldnH,  ldnL]  = f_sess("0800-1700")
[nyH,   nyL]   = f_sess("1300-2200")

// [doc 10] SWEEP TRACKING — a level counts once, the first time price takes it
// ⚠ A level that has already been taken is dead until it is replaced. Without that, one level
// re-arms the strategy on every bar it sits under, and "a sweep happened" stops meaning anything.
var int lowSweepBar  = na
var int highSweepBar = na
var int lowFamilies  = 0
var int highFamilies = 0

f_track(float lvl, bool isHigh, bool enabled) =>
    var float held = na
    var bool  taken = false
    bool fired = false
    if enabled and not na(lvl)
        if na(held) or lvl != held
            held := lvl
            taken := false
        if not taken
            if isHigh and high > held
                taken := true
                fired := true
            if not isHigh and low < held
                taken := true
                fired := true
    fired

bool swH4H  = f_track(h4H,  true,  useH4Level)
bool swH4L  = f_track(h4L,  false, useH4Level)
bool swDH   = f_track(dH,   true,  useDailyLevel)
bool swDL   = f_track(dL,   false, useDailyLevel)
bool swWH   = f_track(wH,   true,  useWeeklyLevel)
bool swWL   = f_track(wL,   false, useWeeklyLevel)
bool swAsH  = f_track(asiaH, true,  useSessionLevel)
bool swAsL  = f_track(asiaL, false, useSessionLevel)
bool swLdH  = f_track(ldnH,  true,  useSessionLevel)
bool swLdL  = f_track(ldnL,  false, useSessionLevel)
bool swNyH  = f_track(nyH,   true,  useSessionLevel)
bool swNyL  = f_track(nyL,   false, useSessionLevel)

bool sessLowSwept  = swAsL or swLdL or swNyL
bool sessHighSwept = swAsH or swLdH or swNyH
int  lowFamNow  = (swH4L ? 1 : 0) + (sessLowSwept ? 1 : 0) + (swDL ? 1 : 0) + (swWL ? 1 : 0)
int  highFamNow = (swH4H ? 1 : 0) + (sessHighSwept ? 1 : 0) + (swDH ? 1 : 0) + (swWH ? 1 : 0)

int barsBack = math.max(1, math.round(sweptMinutes / math.max(1, timeframe.in_seconds() / 60)))
if lowFamNow > 0
    lowSweepBar := bar_index
    lowFamilies := lowFamNow
else if not na(lowSweepBar) and bar_index - lowSweepBar > barsBack
    lowFamilies := 0
if highFamNow > 0
    highSweepBar := bar_index
    highFamilies := highFamNow
else if not na(highSweepBar) and bar_index - highSweepBar > barsBack
    highFamilies := 0

bool lowArmed  = not na(lowSweepBar)  and bar_index - lowSweepBar  <= barsBack and lowFamilies  >= minFamilies
bool highArmed = not na(highSweepBar) and bar_index - highSweepBar <= barsBack and highFamilies >= minFamilies

if showSweeps and (lowFamNow > 0 or highFamNow > 0)
    label.new(bar_index, lowFamNow > 0 ? low : high, "swept", style = lowFamNow > 0 ? label.style_label_up : label.style_label_down, color = color.new(color.gray, 70), textcolor = color.gray, size = size.tiny)

// [doc 11] THE SETUP  -> docs/mpc_extreme_leg_strategy.md
int lookbackBars = math.max(1, math.round(extremeMinutes / math.max(1, timeframe.in_seconds() / 60)))
float atrNow = ta.atr(50)
float extremeLow  = ta.lowest(low,  lookbackBars)
float extremeHigh = ta.highest(high, lookbackBars)

bool htfBear = st15.dir == -1
bool htfBull = st15.dir == 1

bool rawLong  = st.bull_sos and execLongs  and lowArmed  and (not reqCounterTrend or htfBear)
bool rawShort = st.bear_sos and execShorts and highArmed and (not reqCounterTrend or htfBull)

float tgtLong  = st15.ash
float tgtShort = st15.asl
float entryPx  = close
float stopLong  = extremeLow  - stopBufferAtr * atrNow
float stopShort = extremeHigh + stopBufferAtr * atrNow
float riskLong  = entryPx - stopLong
float riskShort = stopShort - entryPx
float rLong  = riskLong  > 0 and not na(tgtLong)  ? (tgtLong  - entryPx) / riskLong  : na
float rShort = riskShort > 0 and not na(tgtShort) ? (entryPx - tgtShort) / riskShort : na

string blockLong  = na
string blockShort = na
if rawLong
    blockLong := na(tgtLong) ? "no 15m swing to aim at" : tgtLong <= entryPx ? "the swing is already below us" : riskLong <= 0 ? "the extreme is above the entry" : minStopUsd > 0 and riskLong < minStopUsd ? "stop tighter than the floor" : rLong < minR ? "the swing is nearer than " + str.tostring(minR, "#.#") + "R" : na
if rawShort
    blockShort := na(tgtShort) ? "no 15m swing to aim at" : tgtShort >= entryPx ? "the swing is already above us" : riskShort <= 0 ? "the extreme is below the entry" : minStopUsd > 0 and riskShort < minStopUsd ? "stop tighter than the floor" : rShort < minR ? "the swing is nearer than " + str.tostring(minR, "#.#") + "R" : na

bool goLong  = rawLong  and na(blockLong)
bool goShort = rawShort and na(blockShort)

// [doc 12] EXECUTION
// ⚠ ONE POSITION AT A TIME, and it is not a preference. Every number behind this file was measured
// with one slot; allowing a second changes the population the result describes.
f_qty(float risk) =>
    sizeMode == "Fixed contracts" or risk <= 0 ? fixedQty : (strategy.equity * riskPct / 100.0) / risk

var float tStop = na
var float tTgt  = na
var bool  beArmed = false

// [doc 12a] THE BAR THE ENTRY IS PLACED ON STILL READS FLAT, AND THAT COST AN ACCOUNT
// `process_orders_on_close` fills the entry AFTER this script has finished running for the bar,
// so `strategy.position_size` is still 0 everywhere below on the bar that opens the trade. These
// two flags are the only way this bar can tell "flat" from "just entered". Without them the reset
// at the bottom wiped the stop and the target back to na on the very bar they were set, the
// bracket went out empty on the next bar, and the position was never protected and never closed.
// The sibling `mpc_h4_sweep_strategy.pine` has carried the same pair since it was written.
bool tookLong  = false
bool tookShort = false

if goLong and strategy.position_size == 0
    strategy.entry("L", strategy.long, qty = f_qty(riskLong))
    tStop := stopLong
    tTgt  := tgtLong
    beArmed := false
    tookLong := true
if goShort and strategy.position_size == 0
    strategy.entry("S", strategy.short, qty = f_qty(riskShort))
    tStop := stopShort
    tTgt  := tgtShort
    beArmed := false
    tookShort := true

if strategy.position_size != 0 and useBreakeven and not na(tTgt) and not na(tStop)
    float span = math.abs(tTgt - strategy.position_avg_price)
    if span > 0
        bool reached = strategy.position_size > 0 ? high >= strategy.position_avg_price + beArmFrac * span : low <= strategy.position_avg_price - beArmFrac * span
        if reached and not beArmed
            beArmed := true
            tStop := strategy.position_avg_price

// The bracket goes out on the ENTRY bar too, so it is live for the next bar's range rather than
// the one after that. `or tookLong` is what makes that possible — see [doc 12a].
if strategy.position_size > 0 or tookLong
    strategy.exit("L-x", from_entry = "L", stop = tStop, limit = tTgt)
if strategy.position_size < 0 or tookShort
    strategy.exit("S-x", from_entry = "S", stop = tStop, limit = tTgt)
// Flat AND we did not just enter. Dropping the second half is the bug in [doc 12a].
if strategy.position_size == 0 and not tookLong and not tookShort
    tStop := na
    tTgt  := na
    beArmed := false

// [doc 13] ANNOTATIONS
if showEntries and (goLong or goShort)
    label.new(bar_index, goLong ? low : high, goLong ? "▲" : "▼", style = goLong ? label.style_label_up : label.style_label_down, color = color.new(goLong ? bullColor : bearColor, 20), textcolor = color.white, size = size.small, tooltip = "target " + str.tostring(goLong ? tgtLong : tgtShort, format.mintick) + "  ·  " + str.tostring(goLong ? rLong : rShort, "#.##") + "R  ·  " + str.tostring(goLong ? lowFamilies : highFamilies) + " level(s) swept")

if showBlocked and (not na(blockLong) or not na(blockShort))
    label.new(bar_index, not na(blockLong) ? low : high, "REFUSED", style = not na(blockLong) ? label.style_label_up : label.style_label_down, color = color.new(color.orange, 60), textcolor = color.orange, size = size.tiny, tooltip = not na(blockLong) ? blockLong : blockShort)

// ⚠ Declared at top level, not inside the `if`. Pine refuses a function declaration inside a
// conditional block, and the failure is a compile error rather than a quiet no-op.
f_lvl(float p, color c, string txt, bool on) =>
    if on and not na(p)
        line.new(bar_index - 100, p, bar_index + 10, p, color = color.new(c, 60), style = line.style_dotted)
        label.new(bar_index + 10, p, txt, style = label.style_label_left, color = color(na), textcolor = color.new(c, 30), size = size.tiny)

bool drawLevels = showLevels and barstate.islast
f_lvl(h4H, color.gray, "H4 H", drawLevels)
f_lvl(h4L, color.gray, "H4 L", drawLevels)
f_lvl(dH, color.orange, "PDH", drawLevels)
f_lvl(dL, color.orange, "PDL", drawLevels)
f_lvl(wH, color.purple, "PWH", drawLevels)
f_lvl(wL, color.purple, "PWL", drawLevels)

if showDebug and barstate.islast
    label.new(bar_index, high, "15m dir " + str.tostring(st15.dir) + "\n15m swing H " + str.tostring(st15.ash, format.mintick) + "\n15m swing L " + str.tostring(st15.asl, format.mintick), style = label.style_label_down, color = color.new(color.black, 30), textcolor = color.white, size = size.small)
