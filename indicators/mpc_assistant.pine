//============================================================
  // SMC STRUCTURE TYPE
//============================================================
type SMCStructure
    int    length
    float  ash             = na
    int    ash_loc         = na
    string ash_type        = ""
    line   ash_line        = na
    label  ash_lbl         = na
    float  asl             = na
    int    asl_loc         = na
    string asl_type        = ""
    line   asl_line        = na
    label  asl_lbl         = na
    float  last_conf_high     = na
    int    last_conf_high_loc = na
    float  last_conf_low      = na
    int    last_conf_low_loc  = na
    int    dir            = 0
    bool   choch_lock     = false
    line   choch_ref      = na
    int    pb_mode        = 0
    int    pb_count       = 0
    float  pb_level       = na
    float  pb_extreme     = na
    int    pb_extreme_loc = na
    line   pb_line        = na
    bool   pb_started     = false
    float  pb_last_qualify_close = na
    float  pb_last_qualify_high  = na
    float  pb_extreme_close      = na
    float  prev_close     = na
    float  prev_high      = na
    float  prev_low       = na
    bool   seeded         = false
    bool   bull_bos       = false
    float  bull_bos_high  = na
    int    bull_bos_h_loc = na
    float  bull_bos_low   = na
    int    bull_bos_l_loc = na
    bool   bear_bos       = false
    float  bear_bos_high  = na
    int    bear_bos_h_loc = na
    float  bear_bos_low   = na
    int    bear_bos_l_loc = na
    bool   new_swing_high = false
    bool   new_swing_low  = false
    bool   bull_sos       = false
    bool   bear_sos       = false

// prefix: "" for external, "i" for internal
// bull_col / bear_col allow per-instance colors
method create_ash(SMCStructure st, float val, int loc, color col, bool solid, string prefix) =>
    if not na(st.ash_line)
        line.delete(st.ash_line)
    if not na(st.ash_lbl)
        label.delete(st.ash_lbl)
        st.ash_lbl := na
    st.ash      := val
    st.ash_loc  := loc
    st.ash_type := ""
    st.ash_lbl  := label.new(loc, val, prefix + "ASH\n", color=color(na), textcolor=f_swingCol(col), style=label.style_label_down, size=f_structSize())
    st.ash_line := line.new(loc, val, bar_index, val, color=col, style=solid ? line.style_solid : line.style_dashed, width=solid ? 2 : 1)

method create_asl(SMCStructure st, float val, int loc, color col, bool solid, string prefix) =>
    if not na(st.asl_line)
        line.delete(st.asl_line)
    if not na(st.asl_lbl)
        label.delete(st.asl_lbl)
        st.asl_lbl := na
    st.asl      := val
    st.asl_loc  := loc
    st.asl_type := ""
    st.asl_lbl  := label.new(loc, val, "\n" + prefix + "ASL", color=color(na), textcolor=f_swingCol(col), style=label.style_label_up, size=f_structSize())
    st.asl_line := line.new(loc, val, bar_index, val, color=col, style=solid ? line.style_solid : line.style_dashed, width=solid ? 2 : 1)

// process() now accepts prefix + bull/bear colors so both instances share one method
method process(SMCStructure st, float ph_val, float pl_val, string prefix, color bull_col, color bear_col) =>

    st.bull_bos := false
    st.bear_bos := false
    st.new_swing_high := false
    st.new_swing_low  := false
    st.bull_sos := false
    st.bear_sos := false

    bool is_inside = false
    if not na(st.prev_high) and not na(st.prev_low)
        is_inside := high < st.prev_high and low > st.prev_low

    if st.choch_lock
        if st.dir == 1 and not na(pl_val)
            st.choch_lock := false
        else if st.dir == -1 and not na(ph_val)
            st.choch_lock := false

    if st.pb_mode == 1
        if not st.pb_started
            st.pb_started            := true
            st.pb_extreme            := high
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_count              := 0
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
        else
            bool extreme_updated_1 = false
            if na(st.pb_extreme) or high > st.pb_extreme
                st.pb_extreme            := high
                st.pb_extreme_loc        := bar_index
                st.pb_extreme_close      := na
                st.pb_count              := 0
                st.pb_last_qualify_close := na
                st.pb_last_qualify_high  := na
                extreme_updated_1        := true
            bool extreme_is_bearish_1 = extreme_updated_1 and close < open
            bool is_candle1_1 = na(st.pb_last_qualify_close) and not extreme_updated_1
            if (not is_inside or is_candle1_1) and (not extreme_updated_1 or extreme_is_bearish_1)
                float threshold = na(st.pb_last_qualify_high) ? st.pb_extreme : st.pb_last_qualify_high
                if close < threshold - pbBuffer
                    st.pb_count              += 1
                    st.pb_last_qualify_close := close
                    st.pb_last_qualify_high  := low
            if st.pb_count >= 3 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
                if not na(st.ash_line)
                    line.delete(st.ash_line)
                if not na(st.ash_lbl)
                    label.delete(st.ash_lbl)
                st.ash      := st.pb_extreme
                st.ash_loc  := st.pb_extreme_loc
                st.ash_type := "LOCKED"
                st.ash_line := line.new(st.pb_extreme_loc, st.pb_extreme, bar_index, st.pb_extreme, color=bear_col, style=line.style_solid, width=1)
                st.ash_lbl  := label.new(st.pb_extreme_loc, st.pb_extreme, prefix + "ASH\n", color=color(na), textcolor=f_swingCol(bear_col), style=label.style_label_down, size=f_structSize())
                st.new_swing_high := true
                st.pb_mode    := 0
                st.pb_count   := 0
                st.choch_lock := false

    else if st.pb_mode == -1
        if not st.pb_started
            st.pb_started            := true
            st.pb_extreme            := low
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_count              := 0
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
        else
            bool extreme_updated_m1 = false
            if na(st.pb_extreme) or low < st.pb_extreme
                st.pb_extreme            := low
                st.pb_extreme_loc        := bar_index
                st.pb_extreme_close      := na
                st.pb_count              := 0
                st.pb_last_qualify_close := na
                st.pb_last_qualify_high  := na
                extreme_updated_m1       := true
            bool extreme_is_bullish_m1 = extreme_updated_m1 and close > open
            bool is_candle1_m1 = na(st.pb_last_qualify_close) and not extreme_updated_m1
            if (not is_inside or is_candle1_m1) and (not extreme_updated_m1 or extreme_is_bullish_m1)
                float threshold = na(st.pb_last_qualify_high) ? st.pb_extreme : st.pb_last_qualify_high
                if close > threshold + pbBuffer
                    st.pb_count              += 1
                    st.pb_last_qualify_close := close
                    st.pb_last_qualify_high  := high
            if st.pb_count >= 3 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
                if not na(st.asl_line)
                    line.delete(st.asl_line)
                if not na(st.asl_lbl)
                    label.delete(st.asl_lbl)
                st.asl      := st.pb_extreme
                st.asl_loc  := st.pb_extreme_loc
                st.asl_type := "LOCKED"
                st.asl_line := line.new(st.pb_extreme_loc, st.pb_extreme, bar_index, st.pb_extreme, color=bull_col, style=line.style_solid, width=1)
                st.asl_lbl  := label.new(st.pb_extreme_loc, st.pb_extreme, "\n" + prefix + "ASL", color=color(na), textcolor=f_swingCol(bull_col), style=label.style_label_up, size=f_structSize())
                st.new_swing_low := true
                st.pb_mode    := 0
                st.pb_count   := 0
                st.choch_lock := false

    st.prev_close := close
    st.prev_high  := high
    st.prev_low   := low

    if na(st.ash) and na(st.asl) and not st.seeded
        if not na(ph_val)
            st.create_ash(ph_val, bar_index[st.length], bear_col, false, prefix)
            st.dir := -1
        else if not na(pl_val)
            st.create_asl(pl_val, bar_index[st.length], bull_col, false, prefix)
            st.dir := 1

    if not st.seeded
        if not na(st.ash) and na(st.asl)
            float seed_low = low
            int   seed_loc = bar_index
            int   lb       = math.min(bar_index, 500)
            for i = 0 to lb
                if low[i] < seed_low
                    seed_low := low[i]
                    seed_loc := bar_index - i
            if seed_low < st.ash
                st.asl      := seed_low
                st.asl_loc  := seed_loc
                st.asl_type := ""
                st.asl_line := line.new(seed_loc, seed_low, bar_index, seed_low, color=bull_col, style=line.style_dashed, width=1)
                st.asl_lbl  := label.new(seed_loc, seed_low, "\n" + prefix + "ASL", color=color(na), textcolor=f_swingCol(bull_col), style=label.style_label_up, size=f_structSize())
                st.seeded := true
        else if not na(st.asl) and na(st.ash)
            float seed_high = high
            int   seed_loc  = bar_index
            int   lb        = math.min(bar_index, 500)
            for i = 0 to lb
                if high[i] > seed_high
                    seed_high := high[i]
                    seed_loc  := bar_index - i
            if seed_high > st.asl
                st.ash      := seed_high
                st.ash_loc  := seed_loc
                st.ash_type := ""
                st.ash_line := line.new(seed_loc, seed_high, bar_index, seed_high, color=bear_col, style=line.style_dashed, width=1)
                st.ash_lbl  := label.new(seed_loc, seed_high, prefix + "ASH\n", color=color(na), textcolor=f_swingCol(bear_col), style=label.style_label_down, size=f_structSize())
                st.seeded := true
        else if not na(st.ash) and not na(st.asl)
            st.seeded := true

    if na(st.last_conf_high) and na(st.last_conf_low)
        if not na(ph_val) and not na(st.ash) and st.ash_type == "" and st.pb_mode == 0
            if ph_val > st.ash
                st.create_ash(ph_val, bar_index[st.length], bear_col, false, prefix)
        if not na(pl_val) and not na(st.asl) and st.asl_type == "" and st.pb_mode == 0
            if pl_val < st.asl
                st.create_asl(pl_val, bar_index[st.length], bull_col, false, prefix)

    bool ash_broken = not na(st.ash) and close > st.ash
    bool asl_broken = not na(st.asl) and close < st.asl

    if ash_broken
        st.bull_bos := true
        st.bull_bos_high  := st.ash
        st.bull_bos_h_loc := st.ash_loc

        bool was_in_bear_pb = st.pb_mode == -1 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
        st.pb_mode  := 0
        st.pb_count := 0

        bool   is_choch    = st.dir == -1
        string brk_lbl_txt = is_choch ? prefix + "SOS" : prefix + "BOS"
        if is_choch
            st.bull_sos := true
        int    mid_x       = math.round((st.ash_loc + bar_index) / 2)
        label.new(mid_x, st.ash, "\n" + brk_lbl_txt, color=color(na), textcolor=bull_col, style=label.style_label_down, size=size.tiny)

        if is_choch
            st.choch_lock := true

        bool brk_already_conf_high = (st.ash == st.last_conf_high and st.ash_loc == st.last_conf_high_loc)
        if not na(st.ash_lbl)
            label.delete(st.ash_lbl)
        if not brk_already_conf_high
            bool   brk_is_hh  = na(st.last_conf_high) or st.ash >= st.last_conf_high
            string brk_high_t = brk_is_hh ? prefix + "HH" : prefix + "LH"
            color  brk_high_c = brk_is_hh ? bull_col : bear_col
            label.new(st.ash_loc, st.ash, brk_high_t + "\n", color=color(na), textcolor=f_swingCol(brk_high_c), style=label.style_label_down, size=f_structSize())

        if not na(st.ash_line)
            line.set_style(st.ash_line, line.style_solid)
            line.set_color(st.ash_line, bull_col)
            line.set_width(st.ash_line, 2)
            line.set_x2(st.ash_line, bar_index)
            st.ash_line := na

        st.last_conf_high     := st.ash
        st.last_conf_high_loc := st.ash_loc
        st.ash_lbl            := na
        st.ash                := na
        st.dir                := 1

        if was_in_bear_pb
            st.bull_bos_low   := st.pb_extreme
            st.bull_bos_l_loc := st.pb_extreme_loc
            if not na(st.asl_line)
                line.delete(st.asl_line)
            if not na(st.asl_lbl)
                label.delete(st.asl_lbl)
            bool   pb_is_hl = is_choch ? false : (na(st.last_conf_low) or st.pb_extreme >= st.last_conf_low)
            // On an SOS (fast reversal) the extreme is only the ACTIVE swing low —
            // it prints as ASL and is confirmed to HL/LL by the NEXT bullish break.
            string pb_low_t = is_choch ? prefix + "ASL" : (pb_is_hl ? prefix + "HL" : prefix + "LL")
            color  pb_low_c = is_choch ? bull_col : (pb_is_hl ? bull_col : bear_col)
            st.asl      := st.pb_extreme
            st.asl_loc  := st.pb_extreme_loc
            st.asl_type := "LOCKED"
            st.asl_line := line.new(st.pb_extreme_loc, st.pb_extreme, bar_index, st.pb_extreme, color=bull_col, style=line.style_solid, width=1)
            st.asl_lbl  := label.new(st.pb_extreme_loc, st.pb_extreme, "\n" + pb_low_t, color=color(na), textcolor=f_swingCol(pb_low_c), style=label.style_label_up, size=f_structSize())
            if not is_choch
                st.last_conf_low     := st.pb_extreme
                st.last_conf_low_loc := st.pb_extreme_loc
            st.pb_extreme            := high
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_mode               := 1
            st.pb_started            := true
        else
            if not na(st.asl)
                bool already_conf_low = (st.asl == st.last_conf_low and st.asl_loc == st.last_conf_low_loc)
                if not already_conf_low
                    bool   old_is_hl = is_choch ? false : (na(st.last_conf_low) or st.asl >= st.last_conf_low)
                    string old_low_t = old_is_hl ? prefix + "HL" : prefix + "LL"
                    color  old_low_c = old_is_hl ? bull_col : bear_col
                    if not na(st.asl_lbl)
                        label.delete(st.asl_lbl)
                    label.new(st.asl_loc, st.asl, "\n" + old_low_t, color=color(na), textcolor=f_swingCol(old_low_c), style=label.style_label_up, size=f_structSize())
                    st.last_conf_low     := st.asl
                    st.last_conf_low_loc := st.asl_loc
                else
                    if not na(st.asl_lbl)
                        label.delete(st.asl_lbl)
                if not na(st.asl_line)
                    line.delete(st.asl_line)
                st.asl_line := na
                st.asl_lbl  := na
                st.asl      := na

            float lowest_val = low
            int   lowest_loc = bar_index
            int   bars_back  = na(st.last_conf_high_loc) ? bar_index : bar_index - st.last_conf_high_loc
            if bars_back > 0
                int max_lb = math.min(math.min(bars_back, 1490), bar_index)
                for i = 0 to max_lb
                    if low[i] < lowest_val
                        lowest_val := low[i]
                        lowest_loc := bar_index - i

            st.bull_bos_low   := lowest_val
            st.bull_bos_l_loc := lowest_loc

            st.asl      := lowest_val
            st.asl_loc  := lowest_loc
            st.asl_type := ""
            st.asl_line := line.new(lowest_loc, lowest_val, bar_index, lowest_val, color=bull_col, style=line.style_solid, width=1)
            if lowest_val != st.last_conf_low
                st.asl_lbl := label.new(lowest_loc, lowest_val, "\n" + prefix + "ASL", color=color(na), textcolor=f_swingCol(bull_col), style=label.style_label_up, size=f_structSize())
            else
                st.asl_lbl := na

            st.pb_mode               := 1
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_extreme            := high
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true

    else if asl_broken
        st.bear_bos := true
        st.bear_bos_low   := st.asl
        st.bear_bos_l_loc := st.asl_loc

        bool was_in_bull_pb = st.pb_mode == 1 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
        st.pb_mode  := 0
        st.pb_count := 0

        bool   is_choch    = st.dir == 1
        string brk_lbl_txt = is_choch ? prefix + "SOS" : prefix + "BOS"
        if is_choch
            st.bear_sos := true
        int    mid_x       = math.round((st.asl_loc + bar_index) / 2)
        label.new(mid_x, st.asl, brk_lbl_txt + "\n", color=color(na), textcolor=bear_col, style=label.style_label_up, size=size.tiny)

        if is_choch
            st.choch_lock := true

        bool brk_already_conf_low = (st.asl == st.last_conf_low and st.asl_loc == st.last_conf_low_loc)
        if not na(st.asl_lbl)
            label.delete(st.asl_lbl)
        if not brk_already_conf_low
            bool   brk_is_hl = na(st.last_conf_low) or st.asl >= st.last_conf_low
            string brk_low_t = brk_is_hl ? prefix + "HL" : prefix + "LL"
            label.new(st.asl_loc, st.asl, "\n" + brk_low_t, color=color(na), textcolor=f_swingCol(bear_col), style=label.style_label_up, size=f_structSize())

        if not na(st.asl_line)
            line.set_style(st.asl_line, line.style_solid)
            line.set_color(st.asl_line, bear_col)
            line.set_width(st.asl_line, 2)
            line.set_x2(st.asl_line, bar_index)
            st.asl_line := na

        st.last_conf_low     := st.asl
        st.last_conf_low_loc := st.asl_loc
        st.asl_lbl           := na
        st.asl               := na
        st.dir               := -1

        if was_in_bull_pb
            st.bear_bos_high  := st.pb_extreme
            st.bear_bos_h_loc := st.pb_extreme_loc
            if not na(st.ash_line)
                line.delete(st.ash_line)
            if not na(st.ash_lbl)
                label.delete(st.ash_lbl)
            bool   pb_is_hh  = na(st.last_conf_high) or st.pb_extreme >= st.last_conf_high
            // On an SOS (fast reversal) the extreme is only the ACTIVE swing high —
            // it prints as ASH and is confirmed to HH/LH by the NEXT bearish break.
            string pb_high_t = is_choch ? prefix + "ASH" : (pb_is_hh ? prefix + "HH" : prefix + "LH")
            color  pb_high_c = is_choch ? bear_col : (pb_is_hh ? bull_col : bear_col)
            st.ash      := st.pb_extreme
            st.ash_loc  := st.pb_extreme_loc
            st.ash_type := "LOCKED"
            st.ash_line := line.new(st.pb_extreme_loc, st.pb_extreme, bar_index, st.pb_extreme, color=bear_col, style=line.style_solid, width=1)
            st.ash_lbl  := label.new(st.pb_extreme_loc, st.pb_extreme, pb_high_t + "\n", color=color(na), textcolor=f_swingCol(pb_high_c), style=label.style_label_down, size=f_structSize())
            if not is_choch
                st.last_conf_high     := st.pb_extreme
                st.last_conf_high_loc := st.pb_extreme_loc
            st.pb_extreme            := low
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_mode               := -1
            st.pb_started            := true
        else
            float highest_val = high
            int   highest_loc = bar_index
            int   bars_back   = na(st.last_conf_low_loc) ? bar_index : bar_index - st.last_conf_low_loc
            if bars_back > 0
                int max_lb = math.min(math.min(bars_back, 1490), bar_index)
                for i = 0 to max_lb
                    if high[i] > highest_val
                        highest_val := high[i]
                        highest_loc := bar_index - i

            if not na(st.ash)
                bool already_conf_high = (st.ash == st.last_conf_high and st.ash_loc == st.last_conf_high_loc)
                if not already_conf_high
                    bool   old_is_hh  = is_choch ? true : (na(st.last_conf_high) or st.ash >= st.last_conf_high)
                    string old_high_t = old_is_hh ? prefix + "HH" : prefix + "LH"
                    color  old_high_c = old_is_hh ? bull_col : bear_col
                    if not na(st.ash_lbl)
                        label.delete(st.ash_lbl)
                    label.new(st.ash_loc, st.ash, old_high_t + "\n", color=color(na), textcolor=f_swingCol(old_high_c), style=label.style_label_down, size=f_structSize())
                    st.last_conf_high     := st.ash
                    st.last_conf_high_loc := st.ash_loc
                else
                    if not na(st.ash_lbl)
                        label.delete(st.ash_lbl)
                if not na(st.ash_line)
                    line.delete(st.ash_line)
                st.ash_line := na
                st.ash_lbl  := na
                st.ash      := na
            else
                // Neither an active pullback high nor a confirmed ASH was available to
                // promote — use the actual highest point since the last confirmed low so
                // a genuine swing high still gets confirmed instead of silently vanishing.
                bool   fallback_is_hh  = na(st.last_conf_high) or highest_val >= st.last_conf_high
                string fallback_high_t = fallback_is_hh ? prefix + "HH" : prefix + "LH"
                color  fallback_high_c = fallback_is_hh ? bull_col : bear_col
                if highest_val != st.last_conf_high
                    label.new(highest_loc, highest_val, fallback_high_t + "\n", color=color(na), textcolor=f_swingCol(fallback_high_c), style=label.style_label_down, size=f_structSize())
                    st.last_conf_high     := highest_val
                    st.last_conf_high_loc := highest_loc

            st.bear_bos_high  := highest_val
            st.bear_bos_h_loc := highest_loc

            st.ash      := highest_val
            st.ash_loc  := highest_loc
            st.ash_type := ""
            st.ash_line := line.new(highest_loc, highest_val, bar_index, highest_val, color=bear_col, style=line.style_solid, width=1)
            if highest_val != st.last_conf_high
                st.ash_lbl := label.new(highest_loc, highest_val, prefix + "ASH\n", color=color(na), textcolor=f_swingCol(bear_col), style=label.style_label_down, size=f_structSize())
            else
                st.ash_lbl := na

            st.pb_mode               := -1
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_extreme            := low
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true

    if not na(st.ash_line)
        line.set_x2(st.ash_line, bar_index)
        if not showExternal
            line.set_color(st.ash_line, color(na))
    if not na(st.asl_line)
        line.set_x2(st.asl_line, bar_index)
        if not showExternal
            line.set_color(st.asl_line, color(na))
    if not showExternal
        if not na(st.ash_lbl)
            label.set_textcolor(st.ash_lbl, color(na))
        if not na(st.asl_lbl)
            label.set_textcolor(st.asl_lbl, color(na))

//============================================================
  // TRADING SESSIONS TYPES & METHODS
//============================================================
// The session open/close and average lines were removed — their three toggles were
// hardcoded false, so the code was unreachable. Freed compile tokens for the B LEG
// tracker below. The session BOX and its name label are untouched.
type SessionDisplay
    box   sessionBox
    label sessionLabel

type SessionInfo
    color  color
    string name
    string session
    string timezone
    SessionDisplay active = na

method setName(SessionDisplay this, string name) =>
    this.sessionLabel.set_y(this.sessionBox.get_bottom())
    this.sessionLabel.set_text(showSessionNames ? name : "")

method createSessionDisplay(SessionInfo this) =>
    boxColor    = this.color
    opaqueColor = color.new(boxColor, 0)
    dis = SessionDisplay.new(
      sessionBox   = box.new(bar_index, high, bar_index, low, bgcolor = boxColor, border_color = color.new(boxColor, 40), border_width = 1, border_style = line.style_dotted),
      sessionLabel = label.new(bar_index + 2, low, "", style = label.style_label_upper_left, textalign = text.align_left, textcolor = opaqueColor, color = color(na)))
    dis.setName(this.name)
    this.active := dis

method updateSessionDisplay(SessionInfo this) =>
    sessionDisp = this.active
    sessionBox  = sessionDisp.sessionBox
    sessionBox.set_top(math.max(sessionBox.get_top(), high))
    sessionBox.set_bottom(math.min(sessionBox.get_bottom(), low))
    sessionBox.set_right(bar_index)
    sessionDisp.setName(this.name)
    sessionDisp

method update(SessionInfo this) =>
    bool isChange = timeframe.change("1D")
    if not na(time("", this.session, this.timezone))
        if na(this.active) or isChange
            this.createSessionDisplay()
        else
            this.updateSessionDisplay()
    else if not na(this.active)
        this.active := na

getSessionInfos() =>
    array<SessionInfo> sessionInfos = array.new<SessionInfo>()
    if showFirst and showSessions
        sessionInfos.push(SessionInfo.new(firstSessionColor, firstSessionName, firstSessionTime, firstSessionTZ))
    if showSecond and showSessions
        sessionInfos.push(SessionInfo.new(secondSessionColor, secondSessionName, secondSessionTime, secondSessionTZ))
    if showThird and showSessions
        sessionInfos.push(SessionInfo.new(thirdSessionColor, thirdSessionName, thirdSessionTime, thirdSessionTZ))
    sessionInfos

//============================================================
  // SHARED CONSTANTS & SECURITY CALLS
//============================================================
isMondayToFriday = dayofweek(time, "America/New_York") >= dayofweek.monday and dayofweek(time, "America/New_York") <= dayofweek.friday
newDay           = dayofweek(time, "America/New_York") != dayofweek(time[1], "America/New_York")

[dailyTime,   dailyHigh,   dailyLow]   = request.security(syminfo.tickerid, "D", [time, high, low], lookahead = barmerge.lookahead_on)
[pdhOn, pdlOn]   = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pdhOff, pdlOff] = request.security(syminfo.tickerid, "D", [high, low], lookahead = barmerge.lookahead_off)
bool  _pdDayChart = timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly
float pdh = _pdDayChart ? pdhOff : pdhOn
float pdl = _pdDayChart ? pdlOff : pdlOn
[pwhOn, pwlOn]   = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pwhOff, pwlOff] = request.security(syminfo.tickerid, "W", [high, low], lookahead = barmerge.lookahead_off)
bool  _pwWkChart = timeframe.isweekly or timeframe.ismonthly
float pwh = _pwWkChart ? pwhOff : pwhOn
float pwl = _pwWkChart ? pwlOff : pwlOn
pwcSecurity = timeframe.isweekly or timeframe.ismonthly ? request.security(syminfo.tickerid, "W", close, lookahead = barmerge.lookahead_off) : request.security(syminfo.tickerid, "W", close[1], lookahead = barmerge.lookahead_on)
[h4Time, h4PrevHigh, h4PrevLow] = request.security(syminfo.tickerid, "240", [time, high[1], low[1]], lookahead = barmerge.lookahead_on)
h4BarChanged = ta.change(h4Time) != 0

hasDailyTimeChanged   = dailyTime   != dailyTime[1]

// ── HTF Directional Bias (adapted from LuxAlgo's HTF Bias Tracker) ──
// Compares an "action" period's high/low/close against a "context" period's high/low
// to classify Bullish / Bearish / Neutral, with sweep detection.
f_biasState(float highAction, float lowAction, float closeAction, float highContext, float lowContext, string tfPrefix) =>
    string state = "Neutral"
    string desc  = "Inside " + tfPrefix + " Range"

    bool bullishClosure = closeAction > highContext
    bool bearishClosure = closeAction < lowContext
    bool bearishSweep   = highAction > highContext and closeAction <= highContext
    bool bullishSweep   = lowAction < lowContext and closeAction >= lowContext

    if bullishClosure
        state := "Bullish"
        desc  := "Close > Prev " + tfPrefix + " High"
    else if bearishClosure
        state := "Bearish"
        desc  := "Close < Prev " + tfPrefix + " Low"
    else if bearishSweep
        state := "Bearish"
        desc  := "Swept " + tfPrefix + " High"
    else if bullishSweep
        state := "Bullish"
        desc  := "Swept " + tfPrefix + " Low"

    [state, desc]

f_htfBias(string htf, string tfPrefix) =>
    // One security call fetching both closed periods at once. (The old version made
    // three calls and also computed a "current forming" bias that was never consumed.)
    [high1, low1, close1, high2, low2] = request.security(syminfo.tickerid, htf, [high[1], low[1], close[1], high[2], low[2]])

    // Established Context (Closed[1] vs Closed[2])
    [estState, estDesc] = f_biasState(high1, low1, close1, high2, low2, tfPrefix)
    [estState, estDesc]

[dEstState, dEstDesc] = f_htfBias("D", "D")
[wEstState, wEstDesc] = f_htfBias("W", "W")

// ── Multi-Timeframe Structure (1m / 15m / 4H) — direction + shift/expansion/continuation ──
// A DRAWING-FREE port of the main SMCStructure.process() state machine below, so
// the 1m/15m/4H rows use the EXACT SAME pullback engine that draws the SOS/BOS on
// your chart — not an approximation. Every line/label call is stripped; the state
// logic is identical. It runs inside request.security so each timeframe is tracked
// on its own bars, independent of the chart timeframe. The current (forming) bar of
// a higher timeframe can still update until it closes — standard request.security.
   // dir: 1 = bullish (last break up), -1 = bearish, 0 = not yet established.
   // ev : the latest structural event, encoding the video's sequence —
        // 1 = SHIFT       (a break that REVERSED direction — an SOS/CHoCH),
        // 2 = EXPANSION   (the FIRST same-direction break after a shift),
        // 3 = CONTINUATION (any further same-direction break after that).
type MTFStruct
    int    length
    float  ash             = na
    int    ash_loc         = na
    string ash_type        = ""
    float  asl             = na
    int    asl_loc         = na
    string asl_type        = ""
    float  last_conf_high     = na
    int    last_conf_high_loc = na
    float  last_conf_low      = na
    int    last_conf_low_loc  = na
    int    dir            = 0
    bool   choch_lock     = false
    int    pb_mode        = 0
    int    pb_count       = 0
    float  pb_level       = na
    float  pb_extreme     = na
    int    pb_extreme_loc = na
    bool   pb_started     = false
    float  pb_last_qualify_close = na
    float  pb_last_qualify_high  = na
    float  pb_extreme_close      = na
    float  prev_close     = na
    float  prev_high      = na
    float  prev_low       = na
    bool   seeded         = false
    bool   bull_bos       = false
    float  bull_bos_high  = na
    int    bull_bos_h_loc = na
    float  bull_bos_low   = na
    int    bull_bos_l_loc = na
    bool   bear_bos       = false
    float  bear_bos_high  = na
    int    bear_bos_h_loc = na
    float  bear_bos_low   = na
    int    bear_bos_l_loc = na
    bool   new_swing_high = false
    bool   new_swing_low  = false
    bool   bull_sos       = false
    bool   bear_sos       = false

method mtfCreateAsh(MTFStruct st, float val, int loc) =>
    st.ash      := val
    st.ash_loc  := loc
    st.ash_type := ""

method mtfCreateAsl(MTFStruct st, float val, int loc) =>
    st.asl      := val
    st.asl_loc  := loc
    st.asl_type := ""

// Byte-for-byte the state logic of SMCStructure.process(); drawing removed.
method processMTF(MTFStruct st, float ph_val, float pl_val) =>
    st.bull_bos := false
    st.bear_bos := false
    st.new_swing_high := false
    st.new_swing_low  := false
    st.bull_sos := false
    st.bear_sos := false

    bool is_inside = false
    if not na(st.prev_high) and not na(st.prev_low)
        is_inside := high < st.prev_high and low > st.prev_low

    if st.choch_lock
        if st.dir == 1 and not na(pl_val)
            st.choch_lock := false
        else if st.dir == -1 and not na(ph_val)
            st.choch_lock := false

    if st.pb_mode == 1
        if not st.pb_started
            st.pb_started            := true
            st.pb_extreme            := high
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_count              := 0
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
        else
            bool extreme_updated_1 = false
            if na(st.pb_extreme) or high > st.pb_extreme
                st.pb_extreme            := high
                st.pb_extreme_loc        := bar_index
                st.pb_extreme_close      := na
                st.pb_count              := 0
                st.pb_last_qualify_close := na
                st.pb_last_qualify_high  := na
                extreme_updated_1        := true
            bool extreme_is_bearish_1 = extreme_updated_1 and close < open
            bool is_candle1_1 = na(st.pb_last_qualify_close) and not extreme_updated_1
            if (not is_inside or is_candle1_1) and (not extreme_updated_1 or extreme_is_bearish_1)
                float threshold = na(st.pb_last_qualify_high) ? st.pb_extreme : st.pb_last_qualify_high
                if close < threshold - pbBuffer
                    st.pb_count              += 1
                    st.pb_last_qualify_close := close
                    st.pb_last_qualify_high  := low
            if st.pb_count >= 3 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
                st.ash      := st.pb_extreme
                st.ash_loc  := st.pb_extreme_loc
                st.ash_type := "LOCKED"
                st.new_swing_high := true
                st.pb_mode    := 0
                st.pb_count   := 0
                st.choch_lock := false

    else if st.pb_mode == -1
        if not st.pb_started
            st.pb_started            := true
            st.pb_extreme            := low
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_count              := 0
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
        else
            bool extreme_updated_m1 = false
            if na(st.pb_extreme) or low < st.pb_extreme
                st.pb_extreme            := low
                st.pb_extreme_loc        := bar_index
                st.pb_extreme_close      := na
                st.pb_count              := 0
                st.pb_last_qualify_close := na
                st.pb_last_qualify_high  := na
                extreme_updated_m1       := true
            bool extreme_is_bullish_m1 = extreme_updated_m1 and close > open
            bool is_candle1_m1 = na(st.pb_last_qualify_close) and not extreme_updated_m1
            if (not is_inside or is_candle1_m1) and (not extreme_updated_m1 or extreme_is_bullish_m1)
                float threshold = na(st.pb_last_qualify_high) ? st.pb_extreme : st.pb_last_qualify_high
                if close > threshold + pbBuffer
                    st.pb_count              += 1
                    st.pb_last_qualify_close := close
                    st.pb_last_qualify_high  := high
            if st.pb_count >= 3 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
                st.asl      := st.pb_extreme
                st.asl_loc  := st.pb_extreme_loc
                st.asl_type := "LOCKED"
                st.new_swing_low := true
                st.pb_mode    := 0
                st.pb_count   := 0
                st.choch_lock := false

    st.prev_close := close
    st.prev_high  := high
    st.prev_low   := low

    if na(st.ash) and na(st.asl) and not st.seeded
        if not na(ph_val)
            st.mtfCreateAsh(ph_val, bar_index[st.length])
            st.dir := -1
        else if not na(pl_val)
            st.mtfCreateAsl(pl_val, bar_index[st.length])
            st.dir := 1

    if not st.seeded
        if not na(st.ash) and na(st.asl)
            float seed_low = low
            int   seed_loc = bar_index
            int   lb       = math.min(bar_index, 500)
            for i = 0 to lb
                if low[i] < seed_low
                    seed_low := low[i]
                    seed_loc := bar_index - i
            if seed_low < st.ash
                st.asl      := seed_low
                st.asl_loc  := seed_loc
                st.asl_type := ""
                st.seeded := true
        else if not na(st.asl) and na(st.ash)
            float seed_high = high
            int   seed_loc  = bar_index
            int   lb        = math.min(bar_index, 500)
            for i = 0 to lb
                if high[i] > seed_high
                    seed_high := high[i]
                    seed_loc  := bar_index - i
            if seed_high > st.asl
                st.ash      := seed_high
                st.ash_loc  := seed_loc
                st.ash_type := ""
                st.seeded := true
        else if not na(st.ash) and not na(st.asl)
            st.seeded := true

    if na(st.last_conf_high) and na(st.last_conf_low)
        if not na(ph_val) and not na(st.ash) and st.ash_type == "" and st.pb_mode == 0
            if ph_val > st.ash
                st.mtfCreateAsh(ph_val, bar_index[st.length])
        if not na(pl_val) and not na(st.asl) and st.asl_type == "" and st.pb_mode == 0
            if pl_val < st.asl
                st.mtfCreateAsl(pl_val, bar_index[st.length])

    bool ash_broken = not na(st.ash) and close > st.ash
    bool asl_broken = not na(st.asl) and close < st.asl

    if ash_broken
        st.bull_bos := true
        st.bull_bos_high  := st.ash
        st.bull_bos_h_loc := st.ash_loc

        bool was_in_bear_pb = st.pb_mode == -1 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
        st.pb_mode  := 0
        st.pb_count := 0

        bool is_choch = st.dir == -1
        if is_choch
            st.bull_sos := true
            st.choch_lock := true

        st.last_conf_high     := st.ash
        st.last_conf_high_loc := st.ash_loc
        st.ash                := na
        st.dir                := 1

        if was_in_bear_pb
            st.bull_bos_low   := st.pb_extreme
            st.bull_bos_l_loc := st.pb_extreme_loc
            st.asl      := st.pb_extreme
            st.asl_loc  := st.pb_extreme_loc
            st.asl_type := "LOCKED"
            if not is_choch
                st.last_conf_low     := st.pb_extreme
                st.last_conf_low_loc := st.pb_extreme_loc
            st.pb_extreme            := high
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_mode               := 1
            st.pb_started            := true
        else
            if not na(st.asl)
                bool already_conf_low = (st.asl == st.last_conf_low and st.asl_loc == st.last_conf_low_loc)
                if not already_conf_low
                    st.last_conf_low     := st.asl
                    st.last_conf_low_loc := st.asl_loc
                st.asl      := na

            float lowest_val = low
            int   lowest_loc = bar_index
            int   bars_back  = na(st.last_conf_high_loc) ? bar_index : bar_index - st.last_conf_high_loc
            if bars_back > 0
                int max_lb = math.min(math.min(bars_back, 1490), bar_index)
                for i = 0 to max_lb
                    if low[i] < lowest_val
                        lowest_val := low[i]
                        lowest_loc := bar_index - i

            st.bull_bos_low   := lowest_val
            st.bull_bos_l_loc := lowest_loc

            st.asl      := lowest_val
            st.asl_loc  := lowest_loc
            st.asl_type := ""

            st.pb_mode               := 1
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_extreme            := high
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true

    else if asl_broken
        st.bear_bos := true
        st.bear_bos_low   := st.asl
        st.bear_bos_l_loc := st.asl_loc

        bool was_in_bull_pb = st.pb_mode == 1 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
        st.pb_mode  := 0
        st.pb_count := 0

        bool is_choch = st.dir == 1
        if is_choch
            st.bear_sos := true
            st.choch_lock := true

        st.last_conf_low     := st.asl
        st.last_conf_low_loc := st.asl_loc
        st.asl               := na
        st.dir               := -1

        if was_in_bull_pb
            st.bear_bos_high  := st.pb_extreme
            st.bear_bos_h_loc := st.pb_extreme_loc
            st.ash      := st.pb_extreme
            st.ash_loc  := st.pb_extreme_loc
            st.ash_type := "LOCKED"
            if not is_choch
                st.last_conf_high     := st.pb_extreme
                st.last_conf_high_loc := st.pb_extreme_loc
            st.pb_extreme            := low
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_mode               := -1
            st.pb_started            := true
        else
            float highest_val = high
            int   highest_loc = bar_index
            int   bars_back   = na(st.last_conf_low_loc) ? bar_index : bar_index - st.last_conf_low_loc
            if bars_back > 0
                int max_lb = math.min(math.min(bars_back, 1490), bar_index)
                for i = 0 to max_lb
                    if high[i] > highest_val
                        highest_val := high[i]
                        highest_loc := bar_index - i

            if not na(st.ash)
                bool already_conf_high = (st.ash == st.last_conf_high and st.ash_loc == st.last_conf_high_loc)
                if not already_conf_high
                    st.last_conf_high     := st.ash
                    st.last_conf_high_loc := st.ash_loc
                st.ash      := na
            else
                if highest_val != st.last_conf_high
                    st.last_conf_high     := highest_val
                    st.last_conf_high_loc := highest_loc

            st.bear_bos_high  := highest_val
            st.bear_bos_h_loc := highest_loc

            st.ash      := highest_val
            st.ash_loc  := highest_loc
            st.ash_type := ""

            st.pb_mode               := -1
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_extreme            := low
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true

// Runs the real engine on one timeframe and returns [dir, event].
// event: 1 shift (SOS), 2 expansion (first BOS after a shift), 3 continuation.
f_mtfStruct(int len) =>
    var mtf = MTFStruct.new(length = len)
    var int sEv = 0
    var int breaksSinceShift = 0
    float ph = ta.pivothigh(high, len, len)
    float pl = ta.pivotlow(low,  len, len)
    mtf.processMTF(ph, pl)
    if mtf.bull_sos or mtf.bear_sos
        sEv := 1                                   // shift — the break reversed direction
        breaksSinceShift := 0
    else if mtf.bull_bos or mtf.bear_bos
        breaksSinceShift += 1
        sEv := breaksSinceShift == 1 ? 2 : 3       // expansion, then continuation
    [mtf.dir, sEv]

[m1Dir,   m1Ev]   = request.security(syminfo.tickerid, "1",   f_mtfStruct(majorLength))
[m15Dir,  m15Ev]  = request.security(syminfo.tickerid, "15",  f_mtfStruct(majorLength))
[m240Dir, m240Ev] = request.security(syminfo.tickerid, "240", f_mtfStruct(majorLength))

// ── 1-minute FVG feed for the REV SETUP entry ──
// The 15m REV SETUP's entry trigger is a 1-minute FVG (the gap you actually enter on),
// not the 15m gap. This tracks the newest live (unmitigated) 1m bullish and bearish gap
// and returns their bounds via request.security so the entry check works from any chart.
// (One gap per direction — the most recent; older 1m gaps in the zone aren't returned.)
f_latest1mFvg() =>
    var float bTop = na, var float bBot = na
    var float sTop = na, var float sBot = na
    if barstate.isconfirmed and bar_index >= 2
        // ⚠ BOTH sub-15m settings are PINNED here, and the close test had to be pinned
        // explicitly on 2026-08-02. This body runs inside request.security(..., "1", ...),
        // but `fvgRequireClose` is a global resolved at the CHART timeframe — so once it
        // became timeframe-split (false below 15m, true at 15m+), a 15m chart started
        // applying the 15m close test to ONE-MINUTE gaps. That silently tightened the deep
        // REV entry trigger (aplusX_fvgInNow) on the exact chart the setup is traded on.
        // The threshold was already pinned to fvgThreshLTF for the same reason; the close
        // test just had no split to fall foul of until now. Below 15m the split resolves to
        // false anyway, so `false` IS the sub-15m rule, stated rather than inherited.
        bool bull = low > high[2] and (low - high[2]) / high[2] * 100 > fvgThreshLTF
        bool bear = high < low[2] and (low[2] - high) / low[2] * 100 > fvgThreshLTF
        if bull
            bTop := low, bBot := high[2]
        if bear
            sTop := high, sBot := low[2]
    if not na(bBot) and close <= bBot
        bTop := na, bBot := na
    if not na(sTop) and close >= sTop
        sTop := na, sBot := na
    [bTop, bBot, sTop, sBot]

[fvg1BullTop, fvg1BullBot, fvg1BearTop, fvg1BearBot] = request.security(syminfo.tickerid, "1", f_latest1mFvg())

// ── 15m-LOCKED REV SETUP ENGINE (lean) ──
// Runs the reversal setup entirely on 15m data via request.security, so the row shows the
// SAME 15m stage on any chart timeframe. LEAN scope: arm on 15m RSI divergence → 15m SOS
// → fib entry zone → tiers → multi-level scale. The 1m shift and 1m FVG entry gate are
// combined on the chart side below (they can't nest inside this security call).
// Returns [stage, dir, tp50, tp382, tp0, zoneLo, zoneHi, deepCode]:
   // stage: 0 none, 1 armed(div), 2 SOS, 3 early(0.5), 4 deep(0.618+)
   // deepCode: 0=0.5, 1=0.618, 2=0.702, 3=0.786, 4=0.886 (deepest tier reached)
   // zoneLo/zoneHi: the entry zone (0.5–0.886) as ordered prices, for the 1m-FVG check.
f_rev15() =>
    var mtf = MTFStruct.new(length = majorLength)
    float ph = ta.pivothigh(high, majorLength, majorLength)
    float pl = ta.pivotlow(low,  majorLength, majorLength)
    mtf.processMTF(ph, pl)

    // 15m RSI divergence (Stage 1 arm)
    float rsi = ta.rsi(close, 14)
    float plR = ta.pivotlow(rsi, 5, 5)
    float phR = ta.pivothigh(rsi, 5, 5)
    var float dRsiLo = na, var float dPxLo = na
    var float dRsiHi = na, var float dPxHi = na
    var int bullDivBar = na, var int bearDivBar = na
    if not na(plR)
        float pLow = low[5]
        if not na(dRsiLo) and pLow < dPxLo and plR > dRsiLo and math.min(plR, dRsiLo) <= 25
            bullDivBar := bar_index - 5
        dRsiLo := plR, dPxLo := pLow
    if not na(phR)
        float pHigh = high[5]
        if not na(dRsiHi) and pHigh > dPxHi and phR < dRsiHi and math.max(phR, dRsiHi) >= 75
            bearDivBar := bar_index - 5
        dRsiHi := phR, dPxHi := pHigh
    bool newBullDiv = not na(bullDivBar) and bullDivBar != bullDivBar[1]
    bool newBearDiv = not na(bearDivBar) and bearDivBar != bearDivBar[1]

    var int lastBullSos = na, var int lastBearSos = na
    var int lastSosCloseT = na   // close time of the latest 15m SOS candle — the 1m fib must anchor to a SOS AFTER this
    if mtf.bull_sos
        lastBullSos := bar_index
        lastSosCloseT := time_close
    if mtf.bear_sos
        lastBearSos := bar_index
        lastSosCloseT := time_close

    // LONG state
    var int   L_arm = na, var int L_sos = na
    var float L_low = na, var float L_high = na
    var bool  L_half = false, var bool L_618 = false
    var int   L_deep = 0
    var bool  L_tp50 = false, var bool L_tp382 = false, var bool L_tp0 = false
    var bool  L_leftZone = false
    // SHORT state
    var int   S_arm = na, var int S_sos = na
    var float S_low = na, var float S_high = na
    var bool  S_half = false, var bool S_618 = false
    var int   S_deep = 0
    var bool  S_tp50 = false, var bool S_tp382 = false, var bool S_tp0 = false
    var bool  S_leftZone = false
    // Fires on the single bar a re-entry resets the leg. Returned to the chart side, which
    // owns the 1m confirmation flags this function cannot reach.
    bool L_reentryNow = false, bool S_reentryNow = false

    // ── LONG ── death first: opposite SOS, a same-dir continuation BOS once the SOS
    // leg exists (hand off to CONT — a BOS pullback is NOT a reversal entry), a close
    // below the leg low (fib 1.0), or TP3 banked. A stage-1 arm (div/sweep, no SOS yet)
    // is NOT killed by a BOS — REV keeps tracking through the continuation, waiting for
    // the next SOS.
    // ── TP3 KILLS THE LEG (Aaron, 2026-08-04) — the 1m table went on tracking a setup
    // the 15m had already finished ──
    // This engine had three deaths and the 15m chart-side A+ engine has four. The one it
    // was missing is the one that fires on a WIN: `(fibo_dir == 1 and fibo7Touched)`,
    // price returning to the leg origin. So on the 15m chart the REV row read Pass the
    // moment TP3 printed, while the 1m chart — which reads THIS engine through
    // request.security — kept the same leg alive at stage 4 saying TAKE PROFIT, and went
    // on doing it until an opposite SOS or a continuation BOS happened along, which can
    // be hours. Two charts, two answers, one setup.
    // Worse than a stale row: the RE-ENTRY round trip below clears the TP latches when
    // price comes back to 0.618, so a finished trade could hand the 1m a fresh AWAIT and
    // ask for a 1m SOS on a leg the 15m had closed the book on.
    // L_tp0 IS TP3 — p0 is L_high, the leg origin, the same 0.0 the drawn fib calls TP3.
    // ⚠ It kills on the NEXT bar, not the same one: this block runs before the fib block
    // that sets the latch. The 15m side kills on the bar itself, so the 1m row carries a
    // finished setup for one extra 15m bar. Left as is — every other value this engine
    // ships crosses the security boundary a bar late in the same way, and matching that
    // is worth more than the one bar.
    // This retires the whole 1m stack together, not just the row: rStage < 3 drops
    // _m15Retraced, which is what fiboShowAligned, the 1m External Fib, the 1m Sniper
    // Zone and the 1m ENTRY row all hang off.
    if mtf.bear_sos or (not na(L_sos) and mtf.bull_bos and not mtf.bull_sos) or (not na(L_low) and close < L_low) or L_tp0
        L_arm := na, L_sos := na, L_low := na, L_high := na
        L_half := false, L_618 := false, L_deep := 0
        L_tp50 := false, L_tp382 := false, L_tp0 := false
        L_leftZone := false
    if newBullDiv and na(L_arm) and na(L_sos)
        L_arm := bullDivBar
    if mtf.bull_sos and not na(L_arm) and na(L_sos)
        L_sos := bar_index, L_low := mtf.bull_bos_low, L_high := mtf.bull_bos_high
    if newBullDiv and not na(L_arm) and na(L_sos) and not na(lastBullSos) and lastBullSos >= bullDivBar
        L_sos := lastBullSos, L_low := mtf.bull_bos_low, L_high := mtf.bull_bos_high
    if not na(L_sos) and (na(L_high) or high > L_high)
        L_high := high
    if not na(L_sos) and not na(L_low) and not na(L_high) and L_high > L_low
        float rng = L_high - L_low
        float p0 = L_high, float p382 = L_high - rng*0.382, float p50 = L_high - rng*0.5
        float p618 = L_high - rng*0.618, float p702 = L_high - rng*0.702
        float p786 = L_high - rng*0.786, float p886 = L_high - rng*0.886
        if low <= p50
            L_half := true
        if low <= p618
            L_618 := true, L_deep := math.max(L_deep, 1)
        if low <= p702
            L_deep := math.max(L_deep, 2)
        if low <= p786
            L_deep := math.max(L_deep, 3)
        if low <= p886
            L_deep := math.max(L_deep, 4)
        // TP flags are ONE-DIRECTIONAL: once banked they stay banked for the life of the
        // leg. A pullback to 0.5 after TP1/TP2 is NOT a fresh scale — the trade only reads
        // forward (entry → 0.5 → 0.382 → TP3). They clear only on leg death, above.
        if L_618[1] or L_half[1]
            if L_618 and high >= p50
                L_tp50 := true
            // 0.382 is the SECOND scale for a deep entry — only after 0.5 banked on a
            // prior bar; for an early 0.5 entry it's the FIRST scale, so it fires directly.
            if high >= p382 and (not L_618 or L_tp50[1])
                L_tp382 := true
            if high >= p0 and L_tp382[1]
                L_tp0 := true
        // ── RE-ENTRY, round trip ── mirror of the chart-side aplus rule; the full
        // reasoning lives there. ARM once a TP is banked and price is OUTSIDE 0.618,
        // FIRE when it trades back inside. This lives inside the fib block because p618
        // is only in scope here.
        bool L_inZone = low <= p618
        if (L_tp50 or L_tp382 or L_tp0) and not L_inZone
            L_leftZone := true
        else if L_leftZone and L_inZone
            L_leftZone := false
            L_tp50 := false, L_tp382 := false, L_tp0 := false
            L_reentryNow := true

    // ── SHORT ── death first: opposite SOS, a same-dir continuation BOS once the SOS
    // leg exists (hand off to CONT), a close above the leg high (fib 1.0), or TP3 banked.
    // A stage-1 arm with no SOS yet keeps tracking through a BOS.
    // S_tp0 is the mirror of the long's TP3 death — see the note there for why it was
    // missing and what the 1m chart was showing without it.
    if mtf.bull_sos or (not na(S_sos) and mtf.bear_bos and not mtf.bear_sos) or (not na(S_high) and close > S_high) or S_tp0
        S_arm := na, S_sos := na, S_low := na, S_high := na
        S_half := false, S_618 := false, S_deep := 0
        S_tp50 := false, S_tp382 := false, S_tp0 := false
        S_leftZone := false
    if newBearDiv and na(S_arm) and na(S_sos)
        S_arm := bearDivBar
    if mtf.bear_sos and not na(S_arm) and na(S_sos)
        S_sos := bar_index, S_high := mtf.bear_bos_high, S_low := mtf.bear_bos_low
    if newBearDiv and not na(S_arm) and na(S_sos) and not na(lastBearSos) and lastBearSos >= bearDivBar
        S_sos := lastBearSos, S_high := mtf.bear_bos_high, S_low := mtf.bear_bos_low
    if not na(S_sos) and (na(S_low) or low < S_low)
        S_low := low
    if not na(S_sos) and not na(S_low) and not na(S_high) and S_high > S_low
        float rng = S_high - S_low
        float p0 = S_low, float p382 = S_low + rng*0.382, float p50 = S_low + rng*0.5
        float p618 = S_low + rng*0.618, float p702 = S_low + rng*0.702
        float p786 = S_low + rng*0.786, float p886 = S_low + rng*0.886
        if high >= p50
            S_half := true
        if high >= p618
            S_618 := true, S_deep := math.max(S_deep, 1)
        if high >= p702
            S_deep := math.max(S_deep, 2)
        if high >= p786
            S_deep := math.max(S_deep, 3)
        if high >= p886
            S_deep := math.max(S_deep, 4)
        // One-directional, mirror of LONG — banked TPs never clear on a pullback.
        if S_618[1] or S_half[1]
            if S_618 and low <= p50
                S_tp50 := true
            if low <= p382 and (not S_618 or S_tp50[1])
                S_tp382 := true
            if low <= p0 and S_tp382[1]
                S_tp0 := true
        // ── RE-ENTRY, round trip ── mirror of LONG, above.
        bool S_inZone = high >= p618
        if (S_tp50 or S_tp382 or S_tp0) and not S_inZone
            S_leftZone := true
        else if S_leftZone and S_inZone
            S_leftZone := false
            S_tp50 := false, S_tp382 := false, S_tp0 := false
            S_reentryNow := true

    int L_stage = not na(L_sos) ? (L_618 ? 4 : L_half ? 3 : 2) : not na(L_arm) ? 1 : 0
    int S_stage = not na(S_sos) ? (S_618 ? 4 : S_half ? 3 : 2) : not na(S_arm) ? 1 : 0
    bool L_ok = L_stage > 0, bool S_ok = S_stage > 0
    bool isLong = L_ok and (not S_ok or L_stage >= S_stage)
    int   rStage = 0, int rDir = 0, int rDeep = 0
    bool  rTp50 = false, bool rTp382 = false, bool rTp0 = false
    float rZoneLo = na, float rZoneHi = na
    // Only the side that OWNS the row is reported — the other side's reset is not this
    // row's event.
    bool  rReentryNow = false
    if L_ok or S_ok
        if isLong
            rStage := L_stage, rDir := 1, rDeep := L_deep
            rTp50 := L_tp50, rTp382 := L_tp382, rTp0 := L_tp0
            rReentryNow := L_reentryNow
            if not na(L_high) and not na(L_low) and L_high > L_low
                float rng = L_high - L_low
                rZoneLo := L_high - rng*0.886, rZoneHi := L_high - rng*0.5
        else
            rStage := S_stage, rDir := -1, rDeep := S_deep
            rTp50 := S_tp50, rTp382 := S_tp382, rTp0 := S_tp0
            rReentryNow := S_reentryNow
            if not na(S_high) and not na(S_low) and S_high > S_low
                float rng = S_high - S_low
                rZoneLo := S_low + rng*0.5, rZoneHi := S_low + rng*0.886
    // ── CONT (continuation) — DISABLED 2026-07-22 while the setup is refined ──
    // The whole 1m-mirror CONT engine is commented out below, along with the four
    // rCont* values it returned. Commented rather than deleted: Pine does not compile
    // comments, so this frees exactly the tokens a delete would, and restoring it is
    // uncommenting instead of a rewrite. To restore, also re-add the four values to the
    // return tuple and to the destructure at the request.security call.
    // // ── CONT (continuation) — trend-aligned 15m BOS (NOT an SOS) → retrace ──
    // // The 1m mirror of the chart-side contL_/contS_ engine, so the 1m chart shows the SAME
    // // 15m continuation thesis. Arms on a same-direction BOS, dies on the opposite SOS or a
    // // close past the leg 1.0. Stage: 1 BOS, 2 = 0.5 retrace, 3 = 0.618 reached. The 4H gate
    // // is applied on the chart side (this security engine stays gate-agnostic).
    // var int   cL_bos = na, var float cL_lo = na, var float cL_hi = na
    // var bool  cL_half = false, var bool cL_618 = false
    // var int   cS_bos = na, var float cS_hi = na, var float cS_lo = na
    // var bool  cS_half = false, var bool cS_618 = false
    // if mtf.bear_sos
        // cL_bos := na, cL_half := false, cL_618 := false, cL_lo := na, cL_hi := na
    // if mtf.bull_bos and not mtf.bull_sos
        // cL_bos := bar_index, cL_lo := mtf.bull_bos_low, cL_hi := mtf.bull_bos_high, cL_half := false, cL_618 := false
    // if not na(cL_bos) and (na(cL_hi) or high > cL_hi)
        // cL_hi := high
    // if not na(cL_bos) and not na(cL_lo) and not na(cL_hi) and cL_hi > cL_lo
        // float cRngL = cL_hi - cL_lo
        // if low <= cL_hi - cRngL * 0.5
            // cL_half := true
        // if low <= cL_hi - cRngL * 0.618
            // cL_618 := true
        // if close < cL_lo
            // cL_bos := na, cL_half := false, cL_618 := false
    // if mtf.bull_sos
        // cS_bos := na, cS_half := false, cS_618 := false, cS_hi := na, cS_lo := na
    // if mtf.bear_bos and not mtf.bear_sos
        // cS_bos := bar_index, cS_hi := mtf.bear_bos_high, cS_lo := mtf.bear_bos_low, cS_half := false, cS_618 := false
    // if not na(cS_bos) and (na(cS_lo) or low < cS_lo)
        // cS_lo := low
    // if not na(cS_bos) and not na(cS_hi) and not na(cS_lo) and cS_hi > cS_lo
        // float cRngS = cS_hi - cS_lo
        // if high >= cS_lo + cRngS * 0.5
            // cS_half := true
        // if high >= cS_lo + cRngS * 0.618
            // cS_618 := true
        // if close > cS_hi
            // cS_bos := na, cS_half := false, cS_618 := false
    // int cL_stage = na(cL_bos) ? 0 : cL_618 ? 3 : cL_half ? 2 : 1
    // int cS_stage = na(cS_bos) ? 0 : cS_618 ? 3 : cS_half ? 2 : 1
    // int   rContStage = 0, int rContDir = 0
    // float rContZoneLo = na, float rContZoneHi = na
    // if cL_stage > 0 and (cS_stage == 0 or cL_stage >= cS_stage)
        // rContStage := cL_stage, rContDir := 1
        // if not na(cL_hi) and not na(cL_lo) and cL_hi > cL_lo
            // float czRngL = cL_hi - cL_lo
            // rContZoneLo := cL_hi - czRngL * 0.886, rContZoneHi := cL_hi - czRngL * 0.5
    // else if cS_stage > 0
        // rContStage := cS_stage, rContDir := -1
        // if not na(cS_hi) and not na(cS_lo) and cS_hi > cS_lo
            // float czRngS = cS_hi - cS_lo
            // rContZoneLo := cS_lo + czRngS * 0.5, rContZoneHi := cS_lo + czRngS * 0.886
    [rStage, rDir, rTp50, rTp382, rTp0, rZoneLo, rZoneHi, rDeep, lastSosCloseT, rReentryNow]

[rStage, rDir, rTp50, rTp382, rTp0, rZoneLo, rZoneHi, rDeepCode, m15SosCloseT, revReentryNow] = request.security(syminfo.tickerid, "15", f_rev15())

// ── Chart-side 1m confirmation for the 15m REV SETUP (works on any timeframe) ──
// The 15m engine gives the setup skeleton; the entry trigger is combined here from the 1m
// structure shift (deep entries) and the 1m FVG tap in the returned entry zone.
var bool rev1mSawOpp = false
var bool rev1mShift  = false
var bool revDeepFvg  = false
var bool revEarlyFvg = false
// 1m FVG tapping the 15m entry zone right now (chart price taps the 1m gap in-zone)
bool _revFvgTapNow = rDir == 1 ? (not na(fvg1BullTop) and not na(rZoneLo) and fvg1BullBot <= rZoneHi and fvg1BullTop >= rZoneLo and low <= fvg1BullTop and high >= fvg1BullBot) : rDir == -1 ? (not na(fvg1BearTop) and not na(rZoneLo) and fvg1BearBot <= rZoneHi and fvg1BearTop >= rZoneLo and low <= fvg1BearTop and high >= fvg1BearBot) : false
// Latched for the row's wording once the 15m reports a re-entry; cleared with the rest
// of the deep state when the leg leaves stage 4.
var bool revReentry = false
// Reset deep confirmations when out of the deep stage.
if rStage < 4
    rev1mSawOpp := false, rev1mShift := false, revDeepFvg := false
    revReentry := false
// ── RE-ENTRY, chart side ── these three flags live HERE, not in f_rev15, so the 15m
// engine's own reset could never touch them. rStage is the only thing it clears them on,
// and rStage is 4 for the whole life of a deep leg — so on a 1m chart the deep-entry
// confirmation stayed latched from the FIRST entry to the end of the leg, and the row
// never asked for a fresh 1m SOS again. Not even once. The 15m now hands the reset edge
// across the security boundary and it is applied here (Aaron, 2026-07-31).
if revReentryNow
    rev1mSawOpp := false, rev1mShift := false, revDeepFvg := false
    revEarlyFvg := false
    revReentry  := true
if rStage == 4
    if rDir == 1
        if m1Dir == -1
            rev1mSawOpp := true
        if rev1mSawOpp and m1Dir == 1 and not rev1mShift
            rev1mShift := true
    else
        if m1Dir == 1
            rev1mSawOpp := true
        if rev1mSawOpp and m1Dir == -1 and not rev1mShift
            rev1mShift := true
    if rev1mShift and _revFvgTapNow
        revDeepFvg := true
// Early (0.5) entry: a gap tap in the zone, no shift required.
// ARMS at stage 3 only, then HOLDS through stage 4 — the same split the chart-side
// aplusX_fvgTap gate enforces, and for the same two reasons: a gap tapped once price
// is already past 0.618 belongs to the deep tier (which must prove a 1m shift first),
// and an early entry that IS open has to survive price retracing deeper, or the row
// flips back to AWAIT and tells you to wait while you hold the position.
if rStage == 3
    revEarlyFvg := revEarlyFvg or _revFvgTapNow
else if rStage != 4
    revEarlyFvg := false

// ── 1m CONT FVG mirror — DISABLED with the rest of CONT (2026-07-22). Depends on
// rContDir / rContZone*, which no longer come back from f_rev15.
//// ── 1m FVG confirmation for the 15m CONT mirror (mirror of the REV FVG gate above) ──
//// A real 1m gap tapping the 15m CONT entry zone (0.5–0.886) confirms the continuation
//// entry on the 1m chart. Latches while the CONT is at its entry stage; clears otherwise.
//bool _contFvgTapNow = rContDir == 1 ? (not na(fvg1BullTop) and not na(rContZoneLo) and fvg1BullBot <= rContZoneHi and fvg1BullTop >= rContZoneLo and low <= fvg1BullTop and high >= fvg1BullBot) : rContDir == -1 ? (not na(fvg1BearTop) and not na(rContZoneLo) and fvg1BearBot <= rContZoneHi and fvg1BearTop >= rContZoneLo and low <= fvg1BearTop and high >= fvg1BearBot) : false
//var bool revContFvg = false
//revContFvg := rContStage < 3 ? false : (revContFvg or _contFvgTapNow)

var canShowDaily   = i_isDailyEnabled   and i_showLiquidity and (timeframe.isintraday or timeframe.isdaily)
var canShowWeekly  = i_isWeeklyEnabled  and i_showLiquidity and (timeframe.isintraday or timeframe.isdaily or timeframe.isweekly)

color  MITIGATED_COLOR = drawLiq ? color.new(#666666, 25) : color(na)
float  lblOff          = syminfo.mintick * i_lblOffset

var a_lastHighs = array.new_float(2)
var a_lastLows  = array.new_float(2)

f_labelText(string txt) => i_showLabels and drawLiq ? txt : ""

// How far back a liquidity line's origin candle may be searched — and, below, how
// far back its x1 is allowed to sit. Declared here because f_liqMitigate clamps to it.
int LIQ_ORIGIN_CAP = 1500

// Shared by Daily/Weekly/Monthly/Asia/London/NY liquidity levels: checks for
// mitigation, updates the line/label color+style+extent in place, and returns
// the (possibly updated) mitigated/mitigatedBar state.
f_liqMitigate(line lineId, label lblId, bool mit, int mitBar, int barOrigin, bool breachCond, color baseColor, bool enabledFlag, bool showMit) =>
    bool newMit    = mit
    int  newMitBar = mitBar
    if not newMit and breachCond
        newMit    := true
        newMitBar := bar_index
    // Live levels always show (if enabled); broken levels show only when showMit is on.
    bool showLvl = (not newMit or showMit) and i_showLiquidity and enabledFlag
    // A broken level is frozen at its break bar. Once THAT bar ages past the buffer the
    // line can't be addressed at all, so hide it rather than drag it forward — a swept
    // line must never creep right, that would read as a level still being live.
    if newMit and showMit and bar_index - newMitBar > LIQ_ORIGIN_CAP
        showLvl := false
    if showLvl
        // Live → extend right from the origin candle; broken → freeze at the break bar (dotted).
        int x2 = newMit ? newMitBar : bar_index + i_lineExtend
        // Re-anchor x1 within a bounded lookback, and never past x2. A weekly/daily level
        // is redrawn only when its PRICE changes, so on a low timeframe its origin candle
        // ends up many thousands of bars behind. Once x1 falls outside Pine's historical
        // buffer, ANY coordinate write on the line throws "requested historical offset ...
        // beyond the historical buffer's limit". This must run BEFORE set_x2, so the stale
        // x1 is overwritten first. The level's PRICE and mitigation are untouched — only
        // the stub back to its forming candle is trimmed, and only once it is that old.
        line.set_x1(lineId, math.min(x2, math.max(barOrigin, bar_index - LIQ_ORIGIN_CAP)))
        line.set_color(lineId, newMit ? MITIGATED_COLOR : baseColor)
        line.set_style(lineId, newMit ? line.style_dotted : line.style_solid)
        line.set_x2(lineId, x2)
        // Broken levels keep a DIMMED label (was hidden, which made "Show Mitigated
        // Liquidity Lines" look like it did nothing — just a faint unlabeled segment).
        // Now a swept level shows its name in grey at the break bar so it's identifiable.
        label.set_textcolor(lblId, newMit ? MITIGATED_COLOR : baseColor)
        label.set_x(lblId, x2)
    else
        line.set_color(lineId, color(na))
        label.set_textcolor(lblId, color(na))
    [newMit, newMitBar]

// Origin-candle finder — scans back for the most recent bar that reached a level, so a
// liquidity line can start from the candle that formed it instead of the detection bar.
f_originHigh(float lvl, int cap) =>
    int ob = bar_index
    if bar_index >= 1
        for i = 1 to math.min(cap, bar_index)
            if high[i] >= lvl
                ob := bar_index - i
                break
    ob
f_originLow(float lvl, int cap) =>
    int ob = bar_index
    if bar_index >= 1
        for i = 1 to math.min(cap, bar_index)
            if low[i] <= lvl
                ob := bar_index - i
                break
    ob

inAsia   = not na(time("", firstSessionTime,  firstSessionTZ))
inLondon = not na(time("", secondSessionTime, secondSessionTZ))
inNY     = not na(time("", thirdSessionTime,  thirdSessionTZ))

inSession5 = not na(time("5", "0930-0935", "America/New_York"))
inExtend5  = not na(time("5", "0935-1600", "America/New_York"))
[startTime5, high5, low5] = request.security(syminfo.tickerid, "5", [time, high, low], lookahead = barmerge.lookahead_on)

var int nyr_startTime = 0
nyr_startTime := inSession5 and not inSession5[1] and isMondayToFriday ? startTime5 : nyr_startTime[1]

nyMidnightToday   = timestamp("America/New_York", year(timenow, "America/New_York"), month(timenow, "America/New_York"), dayofmonth(timenow, "America/New_York"), 0, 0)

// Kill Zones & NY Range: current NY day only by default (keeps the chart clean),
// or unlimited history when Show All History is enabled.
withinKZDays      = showKZHistoric or time >= nyMidnightToday
withinNYRangeDays = showKZHistoric or time >= nyMidnightToday

// Sessions: current week only by default (from Sunday 00:00 New York), or
// unlimited history when Show All History is on. Anchored to the calendar week
// rather than a rolling 7 days, so mid-week it doesn't bleed into last week.
int  nyDayOfWeek       = dayofweek(timenow, "America/New_York")
int  daysSinceSunday   = nyDayOfWeek - dayofweek.sunday
int  weekStartTime     = nyMidnightToday - daysSinceSunday * 86400000
bool withinSessionDays = showHistoricSessions or time >= weekStartTime

vwapValue = ta.vwap(hlc3)

//============================================================
  // EXECUTION — EXTERNAL + INTERNAL STRUCTURE
//============================================================
// External structure engine always runs — fib, macro fib, OBs all depend on it
var st = SMCStructure.new(majorLength)
ph = ta.pivothigh(high, majorLength, majorLength)
pl = ta.pivotlow(low,  majorLength, majorLength)
// showExternal off → pass color(na) so ALL lines and labels hidden inside process
// showExternal off but showExternal on → pass color(na) for labels only — handled via ASH/ASL override below
color extBullCol = showExternal ? (showExternal ? bullColor : color(na)) : color(na)
color extBearCol = showExternal ? (showExternal ? bearColor : color(na)) : color(na)
st.process(ph, pl, "", extBullCol, extBearCol)

// Chart-timeframe structure event for the MTF table — derived from the LIVE
// on-chart engine (st) so the row matching the chart timeframe is byte-identical
// to the SOS/BOS drawn on the chart. request.security re-runs the engine in a
// separate context whose history/seeding can diverge (it may "see" a break the
// chart engine never drew), so the chart-tf row must come from st, not security.
   // event: 1 shift (SOS), 2 expansion (first BOS after a shift), 3 continuation.
var int stMtfEv = 0
var int stMtfBreaksSinceShift = 0
if st.bull_sos or st.bear_sos
    stMtfEv := 1
    stMtfBreaksSinceShift := 0
else if st.bull_bos or st.bear_bos
    stMtfBreaksSinceShift += 1
    stMtfEv := stMtfBreaksSinceShift == 1 ? 2 : 3

// Chart-aware 1-minute structure read for the REV SETUP deep-entry confirmation.
// On a 1m chart it is the live engine; on the 15m chart (where REV SETUP runs) it
// is the 1m security engine — the standard request.security lower-tf read, so it
// carries the usual forming-bar caveat but drives only the deep-entry gate.
int mtf1Dir = timeframe.in_seconds() == 60 ? st.dir : m1Dir

// After process runs — restore line colors when labels are hidden but structure is visible
if not na(st.ash_line)
    line.set_x2(st.ash_line, bar_index)
    if showExternal and not showExternal
        line.set_color(st.ash_line, bullColor)
if not na(st.asl_line)
    line.set_x2(st.asl_line, bar_index)
    if showExternal and not showExternal
        line.set_color(st.asl_line, bearColor)
if not na(st.ash_lbl)
    label.set_textcolor(st.ash_lbl, showExternal ? f_swingCol(bearColor) : color(na))
if not na(st.asl_lbl)
    label.set_textcolor(st.asl_lbl, showExternal ? f_swingCol(bullColor) : color(na))

// Extend and clean OBs every bar
if showOBs
    activeBullOBs.extendOBs(st.dir)
    activeBearOBs.extendOBs(st.dir)

// ── THE SOS WIPE IS GONE (Aaron, 2026-07-30) — it was fixing the wrong problem ──
// It wiped BOTH sides on every change of character, on the reasoning that an SOS makes
// the old leg's blocks history. It was added this morning for the complaint that the
// blocks were "tracking too far back".
// That complaint's real cause turned out to be the OB DEFINITION — the engulf test plus
// an oldest-first scan meant the box was landing on the wrong candle, often back in the
// PREVIOUS leg. That is why they looked far away. The definition is fixed now (see
// f_obMake), so the wipe is no longer treating anything; it is just deleting the history
// that is wanted.
// It is also the reason Max Order Blocks could never get near its setting: the per-
// direction count RESET TO ZERO on every SOS, and on a 15m chart that is often, so the
// cap of 6 or 10 was never the binding constraint — the wipe was.
// Blocks now persist across structure changes and are removed only by being TAPPED
// (extendOBs) or by the FIFO cap. Restore by uncommenting this and the wipeOBs method.
// if showOBs and (st.bull_sos or st.bear_sos)
//     activeBullOBs.wipeOBs()
//     activeBearOBs.wipeOBs()

// ── Order-block builder — THE KELLY LEWIS / ORTHOSLABS RULE (Aaron, 2026-07-30) ──
// The block is THE LAST OPPOSING CANDLE BEFORE THE IMPULSE that broke structure, inside
// that same break leg — PLUS every engulfed opposing candle deeper in it (see the
// ENGULFED CANDLES COUNT TOO note at the function itself). Several zones per break.
// WHY THIS CHANGED, because it is the whole reason the boxes never lined up with the
// OrthosLabs overlay: the old rule required the opposing candle to be ENGULFED body-for-
// body by the very next bar. That is the makuchaku "Super OrderBlock" definition — the
// purple many-small-boxes indicator — and it is NOT the method being traded. The last
// opposing candle at a swing usually is NOT engulfed, so the leg scan found nothing and
// drew NO BOX AT ALL. That is why whole swings had no order block on them; the zones that
// did print were the minority that happened to satisfy a rule that was never wanted.
// HOW IT SCANS, and this is the other half of the fix. It walks BACKWARD from the break
// bar (i = 1) toward the swing extreme and takes the FIRST opposing candle it meets. The
// impulse is several same-direction candles, so walking back skips straight over them and
// lands on the last opposing one — which is the definition, stated directly.
// The old loop ran the other way, oldest-first from the swing extreme, so even when it
// did find something it took the candle nearest the leg ORIGIN, not the one before the
// impulse. Both halves were wrong; both are fixed here.
// STILL CONFINED TO THE LEG — [swingLoc … bar_index], the swing extreme through the break
// bar. No overshoot into the previous leg, and no box if the leg holds no opposing candle
// at all (a one-way impulse straight off the swing).
// EXPECT TO ITERATE. OrthosLabs is invite-only with no public Pine source, so this is
// match-by-observation, not a port. An attempt on 2026-07-18 (swing-extreme anchoring, a
// size guard against the shift candle's range, pure makuchaku engulf) was reverted because
// none of it matched by eye. Only this ONE rule changed here — tap-mitigation, the SOS
// wipe and merge are all left as they are, so if the zones now sit in the right PLACE but
// disappear too fast, mitigation is the next thing to relax and we will know it was that.
// ── ENGULFED CANDLES COUNT TOO (Aaron, 2026-07-30) ──
// Second half of the same fix, off the OrthosLabs overlay: their red zones were still
// catching MORE blocks than this, because a leg does not hold one order block, it holds
// SEVERAL — the last opposing candle before the impulse, plus every opposing candle
// deeper in the leg that the very next bar ENGULFED.
// The two rules are different things and the leg needs both:
//   ANCHOR  — the last opposing candle before the break impulse. Kelly Lewis's rule.
//             Always qualifies, engulfed or not; it is the block the break was built on.
//   ENGULFED — an opposing candle the next bar swallowed body-for-body. That swallow IS
//             the evidence orders sat there and were taken, which is why it qualifies on
//             its own without needing to be the last one.
// The engulf test alone is the makuchaku rule that was thrown out earlier today, and it
// is still wrong ALONE — the anchor candle usually is not engulfed, so on its own it
// misses the most important block in the leg. As an ADDITION it is exactly right.
// ORDER MATTERS: the scan now runs DEEPEST-FIRST (i = startBack down to 1) so the blocks
// are pushed oldest to newest. manageOBs drops from the FRONT at the cap, so the newest —
// the ones nearest price — are the ones that survive. Scanning the other way would have
// the cap throw away the block closest to price.
// Shared by BOTH creation paths — the structure scan below and the displacement trigger
// after it. `off` is the bar offset of the block's candle, so 1 = the bar before this one.
// The "OB" tag is printed on STRUCTURE blocks only. Displacement blocks are the same
// colour and shape but carry no text, which is the one free way to tell the two apart
// without spending a second hue on a chart that has none to spare.
// ── ONE CANDLE. THE LAST OPPOSING ONE. (Aaron, 2026-07-31) ──
// The BASE-GROUPING experiment from earlier today is REVERTED, and the note is kept
// because the reasoning sounded right and the chart said otherwise.
// The idea was that the zone should cover the whole consolidation price sat in before
// it left — walk back from the anchor collecting every candle that closed inside the
// zone so far, capped at 8. It came off a screenshot where the reference's zones looked
// taller than these.
// On a real chart it was FAR too big: boxes forty dollars deep, spanning a dozen
// candles, because the "closed inside the zone" test is self-feeding — every candle
// added widens the zone, which makes the next candle easier to include, and the walk
// runs to its cap almost every time. A rule that nearly always hits its limit is not
// measuring anything.
// So the block is ONE CANDLE, the last opposing one, and that is the definition as it
// was always stated. If the zones still read small next to the reference, the fix is a
// better ANCHOR — a different candle — not a wider box around the same one.
// ── A BLOCK HAS A CEILING AS WELL AS A FLOOR (Aaron, 2026-07-31) ──
// Measured: a thirty-dollar box across the top of the chart with price ranging INSIDE
// it — "it should not have that big order block where price is currently moving."
// TWO faults compounding, and it is worth separating them because only one is a bug.
//   1. THE SIZE. obBodyOnly is false, so a block is its anchor candle's full WICK-TO-
//      WICK range. The doji filter put a FLOOR under that — the consumed candle must be
//      a real one — but nothing capped the other end. When the anchor happens to be a
//      big impulse candle, its range IS the move, and the "level" spans the whole thing.
//      An order block is the small base BEFORE the impulse; a box the size of the
//      impulse is not a level, it is a redrawing of the move.
//   2. THE PERMANENCE, which is the size fault wearing a disguise. "Closes inside →
//      stays visible until it exits" is the rule as asked for, and it is right for a
//      normal zone. But a thirty-dollar zone is one price can RANGE INSIDE for hours,
//      so it never exits and never dies. Oversized zones are precisely the ones that
//      become immortal — the two faults feed each other.
// So the cure is at the size end, not the mitigation end. A block taller than
// OB_MAX_ATR × ATR(14) is refused outright. Measured against ATR for the same reason
// the push floor is — it travels across instruments and timeframes with no retuning —
// and 2.0 is deliberately loose: it is not trying to pick the best block, only to
// refuse the ones that are plainly the impulse rather than its base.
// ta.atr is read HERE, in global scope, not inside f_obAdd. The function is called
// conditionally (only when a push or turn fires), and a ta.* call on a conditional path
// gets an inconsistent history — the value would be wrong on exactly the bars it is
// asked for. A global series is evaluated every bar and is safe to read from inside.
float obAtr = ta.atr(14)
float OB_MAX_ATR = 2.0
// How much a candidate must overlap a LIVE block before it counts as the same zone
// and is refused — see the dedupe note in f_obAdd. 0.5 = half the candidate's own
// height. Raise it toward 1.0 for more boxes (only near-identical ones collapse),
// lower it for fewer (a graze is enough to be called a duplicate).
float OB_DUPE_OVERLAP = 0.5
// How far price must travel AWAY from a candidate zone before it counts as a level —
// see the displacement note in f_obAdd. 1.0 = a full ATR(14) of departure, measured on
// closes. Raise it for fewer, cleaner blocks (only real impulses qualify); lower it if
// genuine turns are being refused.
float OB_DISP_MULT = 1.0

f_obAdd(array<OrderBlock> arr, int off, int dir, bool vis, bool isBrk) =>
    // ── THE EXTREME-WINDOW SEARCH IS GONE (Aaron, 2026-07-31) ──
    // "It's not capturing the last candle from the turning point accurately."
    // The search walked three bars either side of the nominated candle and moved the
    // anchor onto whichever printed the lowest low (or highest high). It came off the
    // blue-box measurement and it over-fitted that one sample: the box he wanted just
    // happened to be the extreme, so "snap to the extreme" looked like the rule.
    // On a real chart it drags the anchor OFF the turn. The deepest wick in a six-bar
    // window is frequently NOT the candle price turned on — a spike two bars earlier in
    // the consolidation wins the comparison, and the box lands on a bar that has nothing
    // to do with the turn. That is exactly "not accurate".
    // So the anchor is the NOMINATED candle, full stop. The turn source hands over the
    // pivot bar, the push source hands over the candle it consumed, and neither is
    // second-guessed here. "Simply the last candle from every turn" is the rule.
    int OB_MIN_BACK = 3
    float obTop = obBodyOnly ? math.max(open[off], close[off]) : high[off]
    float obBot = obBodyOnly ? math.min(open[off], close[off]) : low[off]
    // The height ceiling — see the note above. na-guarded so the first bars of a chart,
    // where ATR has not warmed up, do not refuse everything.
    bool obHuge = not na(obAtr) and (obTop - obBot) > obAtr * OB_MAX_ATR
    // ── THE TWO-CANDLE ZONE IS REVERTED (Aaron, 2026-07-31) — one sample is not evidence ──
    // It extended the box into the bar that consumed the anchor, taking the combined
    // high/low of the two. It came off ONE measured pair where the reference and this
    // agreed on the left edge and the bottom and differed only at the top, which reads as
    // "right candle, short box".
    // A SECOND measured instance disagreed outright: there the reference's left edge sat
    // TWO BARS EARLIER and a whole zone higher (4083.84–4090.98 against 4079.9–4083.7
    // here), so the two barely overlapped. Widening this box cannot close that gap — it
    // moves the wrong way. Two samples pointing at different fixes means neither is the
    // rule, and stacking a change on the weaker one just buries the real difference.
    // WHAT BOTH INSTANCES DID AGREE ON, and it is the thread worth pulling: the
    // reference's zone sits up at the LEG'S SWING EXTREME, while this one anchors on the
    // last opposing candle immediately before the drop — lower, and later. That points at
    // the ANCHOR rule, not the bounds. Swing-extreme anchoring was tried on 2026-07-18 and
    // reverted for not matching by eye, so it may have been right and thrown out for the
    // wrong reason.
    // ── CATCH-UP: REPLAY THE BARS THIS BLOCK MISSED (Aaron, 2026-07-30) ──
    // A structure block is born LATE. The scan runs on the break bar and reaches back up
    // to OB_SCAN_MAX candles, so several boxes appear at once, all of them anchored to
    // candles that are already history. extendOBs — the thing that watches for enter and
    // leave — only sees a block from the bar AFTER it exists.
    // So every bar between the block's own candle and the break bar was never checked,
    // and that is exactly the stretch where price was busy: the impulse that broke
    // structure ran right through those candles. A block price had ALREADY entered and
    // left was drawn as if it were fresh and untouched. Missed mitigations, every time.
    // The cure is to walk those bars here, at birth, and carry forward WHETHER PRICE HAS
    // BEEN INSIDE — so the block arrives already knowing its own history, and the very
    // next close outside finishes it, exactly as if it had been watched all along.
    // IT DOES NOT CANCEL THE BLOCK, and that limit is deliberate (Aaron, 2026-07-31 —
    // "it messed things up"). The first version suppressed creation outright when the
    // replay found an enter-and-leave in that window, and it wiped out most of the chart:
    // a leg is not a straight line, so price wanders in and out of nearly every candle
    // in it, and the rule read that as "already mitigated" on blocks that had never been
    // in play. Three boxes survived where there should have been a dozen.
    // The honest reading is that a block cannot be mitigated by the move that CREATED it.
    // Its own impulse running back over it is not price returning to a level — the level
    // did not exist yet. Mitigation only starts counting once the block is on the chart.
    // So the replay's job is narrower than it first was: carry the `entered` half, let
    // extendOBs decide the rest from the next bar on.
    // NOTE the impulse bar right after the block does not set it either: for a bullish
    // block (the last bearish candle) the next bar CLOSES above the top — outside.
    // The replay carries the `entered` half, and it ALSO refuses to draw a block that
    // price has already closed clean past the far edge of (Aaron, 2026-07-31). That is
    // the one cancel worth keeping: extendOBs now deletes such a block on the very next
    // bar anyway, so creating it would just flicker one box onto the chart and take it
    // straight back. Deliberately NARROW — only a close beyond the WHOLE zone counts,
    // never the wandering in and out that killed most of the chart when the cancel was
    // wider. A bullish block dies on a close below its bottom, bearish above its top.
    // ── PRICE MUST HAVE LEFT (Aaron, 2026-07-31) — "it's a looking back process" ──
    // A block is not made at the turn. It is made AFTER price has gone, by looking back
    // at where it went from. Until price leaves, that base is not an order block — it is
    // just the candles price is currently standing in, and calling it a level while price
    // is still inside it is drawing a zone around the present.
    // obGone is that test: some bar since the anchor CLOSED clean outside the zone in the
    // direction of the move away — above the base for a bullish block, below it for a
    // bearish one. A close, not a wick, so a poke out and back does not count as leaving.
    // This is what makes the departure the trigger. The turn, the push and the structure
    // break only nominate a candidate; the move away is what confirms it, and no block is
    // ever drawn around price where it currently stands.
    // ── AND IT MUST BE BEHIND, NOT BESIDE (Aaron, 2026-07-31) ──
    // "I don't want clutter on the current candle — make sure it's a look back after
    // price moves away." The departure gate above proved price LEFT, but it did not
    // stop a block being BORN next to the live bar: the push source fires on the push
    // candle itself with its anchor one or two bars behind, so a fresh box could appear
    // right where price is standing. That is not looking back, it is drawing on the now.
    // Two guards, and they are different things:
    //   OB_MIN_BACK — the anchor must be at least this many bars behind the live bar.
    //     Distance in TIME, so the box lands in history where a level belongs and never
    //     crowds the candle being formed.
    //   The departure loop stops at bar 1, NOT bar 0 — the live bar can never be the
    //     close that proves price left. That close has to be on a bar already finished,
    //     which is what makes this a look-BACK rather than a live read.
    // The push source gets its own WAIT below so this guard does not silently starve it:
    // a push anchored one bar back is not refused for ever, it is simply looked at a few
    // bars later, once it is genuinely behind.
    // ── THE REPLAY NO LONGER CARRIES `entered` (Aaron, 2026-07-31) ──
    // Measured: a correct block at an internal swing low, drawn, then GONE a bar or two
    // later while price was rising AWAY from it and never came back.
    // It was mitigated by its own birth move, and the chain is airtight once seen:
    //   1. The replay set `entered` because some bar between the anchor and now CLOSED
    //      inside the zone — which is nearly guaranteed, those are the base candles.
    //   2. obGone REQUIRES price to have closed clean outside before the block is drawn
    //      at all. So every block arrives with price already outside it.
    //   3. extendOBs reads `obMitigated = not obInside and (obTouch or ob.entered)`.
    //      With `entered` true and price outside, that is satisfied on the very next bar.
    // Enter-and-leave, both halves supplied by the move that CREATED the level. The
    // block was dead before price ever returned to it.
    // The principle was already written into the note above — "a block cannot be
    // mitigated by the move that CREATED it; the level did not exist yet" — and then the
    // replay carried `entered` anyway, which is exactly the contradiction. It survived
    // while close-through-the-far-edge was the dominant exit. Under enter-then-leave it
    // is fatal, and every block with a base worth the name dies on arrival.
    // So the block is born CLEAN: entered = false, mitigation counts only from the bar
    // after it exists. The replay still earns its place — it computes obDead (refuse a
    // block price already closed clean past) and obGone (the departure gate). Only the
    // `entered` carry is gone.
    // ── LEAVING IS NOT ENOUGH. IT HAS TO BE A DISPLACEMENT. (Aaron, 2026-07-31) ──
    // "I want the last candle from every turn tracked, but not a consolidation — it must
    // be a displacement."
    // obGone used to be satisfied by ONE close outside the zone, which is a very low bar:
    // in chop price closes just past a candle's range constantly, drifts back, and closes
    // past it again. Every one of those nothing-turns became a level, and that is the
    // consolidation clutter — the turn was real enough as a pivot, but nothing LEFT.
    // A displacement is measured, not assumed: how FAR did price get from the zone before
    // now, in ATR. The loop tracks the furthest close beyond the edge it departed by, and
    // the block is only drawn once that travel clears OB_DISP_MULT × ATR(14).
    // Measured in ATR for the same reason the push floor and the height cap are — it
    // travels across instruments and timeframes with no per-chart retuning. Measured on
    // CLOSES, so a single spike out and back cannot buy a level.
    // This replaces the old boolean entirely: a close outside no longer counts on its own,
    // and that is the whole difference between "price moved off this candle" and "price
    // left this candle behind".
    // ── AND THE REPLAY NOW APPLIES THE WICK RULE — AFTER DEPARTURE (Aaron, 2026-07-31) ──
    // "You are leaving boxes behind that should have been mitigated when a candle wicks
    // into it and pulls back."
    // The hole was real and it is here, not in extendOBs. extendOBs already implements
    // the rule correctly — wick in, close outside, dead — but it only ever sees a block
    // from the bar AFTER it is created, and these blocks are born TEN BARS LATE. Every
    // wick inside that window went unexamined, so a zone that had already been tapped
    // and rejected arrived on the chart looking untouched.
    // WHY THE REPLAY COULD NOT SIMPLY RUN THE TAP RULE FROM BAR ONE, and this is the
    // thing that broke it when it was tried before: the candle right after the anchor is
    // the DRIVE, and a drive starts from inside the base it is leaving. It overlaps the
    // zone by construction and closes outside it — which is the tap rule exactly. Applied
    // from bar one, every block on the chart is mitigated by its own departure.
    // So mitigation starts counting only ONCE PRICE HAS ACTUALLY LEFT — the same
    // displacement the block needed to exist at all. Before that threshold price is still
    // departing, and a bar overlapping the zone is the move away, not a return to it.
    // After it, a bar that reaches in and closes outside is a genuine tap and the block
    // is refused at birth rather than drawn and deleted a bar later.
    // This makes the birth check and extendOBs agree: both say a zone survives exactly
    // one thing — price still being in it at the close.
    bool  obDead   = false
    bool  obLeft   = false
    bool  obTapped = false
    float obTravel = 0.0
    if off >= OB_MIN_BACK
        for j = off - 1 to 1
            if dir == 1 ? close[j] < obBot : close[j] > obTop
                obDead := true
                break
            if obLeft
                if low[j] <= obTop and high[j] >= obBot and (close[j] > obTop or close[j] < obBot)
                    obTapped := true
                    break
            float obAway = dir == 1 ? close[j] - obTop : obBot - close[j]
            if obAway > obTravel
                obTravel := obAway
            if not obLeft and not na(obAtr) and obTravel >= obAtr * OB_DISP_MULT
                obLeft := true
    bool obGone = not na(obAtr) and obTravel >= obAtr * OB_DISP_MULT
    // DEDUPE (Aaron, 2026-07-31). Two pushes in a row will often reach back to the SAME
    // opposing candle — the base bar gets consumed, price ticks on, and the next drive
    // still finds it as the nearest one behind. Without this the identical box is stacked
    // two or three deep: the 94% fill compounds into a solid slab and the cap burns its
    // slots on one level.
    // ── OVERLAP, NOT EQUALITY (Aaron, 2026-07-31) — "there are two blocks here, I only
    // want the one that replicates the blue" ──
    // The test used to be `oX.top == obTop and oX.bottom == obBot`, and the note said two
    // different candles agreeing to the tick was not worth worrying about. That was the
    // wrong worry. The failure is the opposite one: the push source and the turn source
    // fire at the same turn but land on ADJACENT candles, whose highs and lows differ by
    // a few cents — so the equality never matched and BOTH boxes printed, one on top of
    // the other, describing the same zone twice.
    // Equality can only collapse the exact-same-candle case. What is needed is a test for
    // the same ZONE, which is overlap: if a candidate covers OB_DUPE_OVERLAP of its own
    // height inside a block already drawn, it is not a second level, it is the same level
    // found by the other source.
    // FIRST DRAWN WINS. The push source runs before the turn source in this file, so on a
    // turn that also engulfed, the PUSH block is the one kept. That ordering is the whole
    // preference — if the survivor is consistently the wrong one, swapping the two call
    // blocks below is the entire fix.
    // Deliberately a fraction of the CANDIDATE's height, not the older block's: a small
    // candidate sitting wholly inside a big live zone is a duplicate, while a big
    // candidate that merely contains a small old one is not, and would still print.
    bool obDupe = false
    if array.size(arr) > 0
        for k = 0 to array.size(arr) - 1
            OrderBlock oX = array.get(arr, k)
            float obOvH = math.min(obTop, oX.top) - math.max(obBot, oX.bottom)
            if obOvH > 0 and obOvH >= (obTop - obBot) * OB_DUPE_OVERLAP
                obDupe := true
                break
    // RETURNS whether a block was actually drawn (Aaron, 2026-07-31). The turn source
    // reads this to know whether the engulf rule already claimed this turn — see the
    // one-block-per-turn latch at the call sites. Every gate above can refuse, so
    // "the push fired" and "a block exists" are different facts and the caller needs
    // the second one.
    // ── THE "OB" TAG IS BACK ON EVERY BLOCK (Aaron, 2026-07-31) ──
    // It used to be `isBrk ? "OB" : ""` — printed only on STRUCTURE blocks, so the tag
    // told you which SOURCE made the zone. That source is gone (see the f_obMake note),
    // every caller now passes false, and the result was a chart of untagged boxes.
    // With one source left there is nothing to distinguish, so the tag goes back to
    // doing its original job: NAMING the thing. At 94% transparency the fill is a
    // whisper, and beside four other pale rectangles an unlabelled outline is just a
    // shape — "OB" is what says which tool drew it.
    // isBrk is left in the signature rather than removed: it costs nothing, and
    // restoring f_obMake means restoring its meaning too.
    bool obMade = false
    if obGone and not obDead and not obTapped and not obDupe and not obHuge
        box nb = box.new(bar_index - off, obTop, bar_index, obBot, border_color = vis ? OB_EDGE : color(na), border_width = 1, bgcolor = vis ? (dir == 1 ? colBullOB : colBearOB) : color(na), text = "OB", text_color = vis ? (dir == 1 ? obTextBull : obTextBear) : color(na), text_size = size.tiny, text_halign = text.align_right)
        // `false`, not the old obEnt — the block is born clean. See the note above.
        arr.manageOBs(OrderBlock.new(nb, obTop, obBot, dir == 1, isBrk, false))
        obMade := true
    obMade

// ── THE STRUCTURE SOURCE IS GONE (Aaron, 2026-07-31) — it was a THIRD anchor rule ──
// Diagnosed off two screenshots minutes apart: a block sitting correctly at the last
// candle VANISHED and a wrong one printed in its place. Nothing about that block was
// mitigated; what happened in between was an iBOS.
// An internal or external break called f_obMake, and f_obMake did three things none of
// the other sources do:
//   1. RETROACTIVE BATCH. It scanned back up to OB_SCAN_MAX (40) bars and made a block
//      for the anchor PLUS every engulfed opposing candle in that stretch — five or six
//      boxes at once, all anchored to candles already deep in the past.
//   2. EVICTION. That batch overflowed maxActiveOB (6 at the time, 10 now) and manageOBs drops from the
//      FRONT, so the good blocks drawn before the break were pushed out to make room for
//      the retro ones. That is the disappearance, and it is why it looked like
//      mitigation when price had never gone near the zone.
//   3. A DIFFERENT DEFINITION. It never received either of today's fixes — no doji
//      filter, and its anchor is the old "first opposing candle walking back, plus every
//      engulfed one deeper in the leg", NOT the engulf/turn rule. So a break re-drew the
//      chart by the OLD rule and wiped out what the new one had drawn.
// It is deleted rather than repaired because it has nothing left to contribute. The rule
// as stated is "if it's an engulf capture the engulfed candle; if it's not an engulf, at
// the turning point capture the last candle" — the PUSH source owns the first case and
// the TURN source owns the second, and both run on EVERY bar. A structure break is not a
// third kind of order block; it is a break that happens to occur near ones already drawn.
// WHAT GOES WITH IT: the "OB" text tag. isBrk was only ever true on this path, so every
// remaining block is untagged. f_obAdd keeps the parameter — all callers now pass false —
// so restoring is uncommenting this and its four call sites, nothing more.
// Commented, not deleted: Pine does not compile comments, so this costs no tokens.
// f_obMake(array<OrderBlock> arr, int swingLoc, int dir, bool vis) =>
//     int startBack = math.min(bar_index - swingLoc, OB_SCAN_MAX)
//     if startBack >= 1
//         int found = na
//         for i = 1 to startBack
//             bool opp = dir == 1 ? close[i] < open[i] : close[i] > open[i]
//             if opp
//                 found := i
//                 break
//         if not na(found)
//             for i = startBack to 1
//                 bool opp = dir == 1 ? close[i] < open[i] : close[i] > open[i]
//                 bool eng = dir == 1 ? close[i - 1] > open[i] : close[i - 1] < open[i]
//                 if opp and (i == found or eng)
//                     f_obAdd(arr, i, dir, vis, true)
//     int _r = 0

// Process OB creation on External breaks — COMMENTED OUT with f_obMake above.
// if showOBs and (st.bull_bos or st.bull_sos) and showBullOB
//     f_obMake(activeBullOBs, st.bull_bos_l_loc, 1, true)

// if showOBs and (st.bear_bos or st.bear_sos) and showBearOB
//     f_obMake(activeBearOBs, st.bear_bos_h_loc, -1, true)

// ── EVERY IMPULSIVE ENGULFING PUSH MAKES A BLOCK (Aaron, 2026-07-31) ──
// This is now the MAIN source, and it runs on every bar with no structure break needed.
// That is the whole difference against the reference overlay: their zones sit at each
// PUSH, and a push does not wait for a BOS. The structure scan above only fires on a
// break, so on a leg the engine has not broken yet it draws nothing at all — which is
// why whole stretches of chart had no block on them while theirs had four.
// A push is TWO things, and both have to hold:
//   ENGULFING — this candle closes through the previous OPPOSING candle's open. That
//     candle was consumed; it is the block, and it is where the orders sat.
//   IMPULSIVE — the pushing candle's BODY beats ATR(14) × OB_PUSH_MULT. Without this
//     every bar that edges past its neighbour would print a zone and the chart would be
//     solid boxes. Measured against ATR rather than points so it travels across
//     instruments and timeframes with no per-chart retuning.
// Confirmed bars only — a live candle's body grows and shrinks tick by tick, so without
// this a block would appear and vanish intrabar as the bar changed its mind.
// Tagged as NOT-from-break, so these carry no "OB" text: same colour, same shape, and
// the blank tag is the free way to tell a push block from a structure block.
// ── TWO FIXES, 2026-07-31 — the first version of this caught almost nothing ──
// 1. THE BLOCK CANDLE IS NOT ALWAYS THE PREVIOUS BAR. The old test demanded bar[1] be
//    the opposing candle. Real pushes rarely oblige: the base is usually two or three
//    small bars — a doji, a nothing bar, then the drive — so bar[1] is the wrong shape
//    and the whole push was rejected. It now SCANS BACK for the nearest opposing candle
//    within OB_PUSH_LOOK and takes that one. That candle is the block.
// 2. "BODY BEATS ATR(14)" WAS FAR TOO STRICT, and this was the bigger killer. ATR spans
//    the whole candle — wicks, gaps, the lot — so demanding a BODY bigger than a full
//    ATR asks for a bar roughly twice the average range. Almost nothing qualifies, which
//    is exactly why the chart came back with only the two structure blocks on it.
//    What replaces it is what ENGULFING actually means: the push's body must be BIGGER
//    THAN THE BODY IT CONSUMED. That is the real size test and it is self-scaling — no
//    constant involved. The ATR term drops to a small NOISE FLOOR (0.3) whose only job
//    is to stop two microscopic bars qualifying as a push in dead chop.
// OB_PUSH_MULT is still the dial for that floor: raise it for fewer, stronger blocks.
// OB_PUSH_WAIT — the push is read this many bars LATE (Aaron, 2026-07-31, "no clutter
// on the current candle"). Everything below indexes off [OB_PUSH_WAIT] rather than the
// live bar, so the push being examined is one that finished a few candles ago and its
// anchor is already well behind price. Without this the source fired on the push bar
// itself and f_obAdd's OB_MIN_BACK guard would simply REFUSE those blocks — the push
// fires once and never comes round again, so refusing is losing them. Delaying is not:
// the same push, the same anchor candle, just looked at once it is genuinely history.
// ── THE WAIT IS THE DISPLACEMENT WINDOW (Aaron, 2026-07-31) ──
// Measured: one orange box on a whole screen where the reference had six.
// The cause is arithmetic, not definition. f_obAdd's departure loop runs from the
// anchor's offset down to bar 1, so the number of bars price has to displace IN is
// exactly how far back the anchor sits. At WAIT = 3 the push anchor lands 4–8 bars back
// and the turn anchor 3–5, which gives the displacement test a two-to-four bar window to
// find a full ATR of travel. Almost nothing clears that, and each source fires ONCE — so
// a block that had not displaced within those few bars was lost for good, not deferred.
// Raising the WAIT is the whole fix: it is the same push, the same anchor candle, simply
// looked at once enough bars exist for "did price leave" to be a real question. 10 bars
// is 2.5 hours on the 15m — long enough for a genuine displacement to be visible and
// short enough that the box still lands near the turn rather than back in the last leg.
// The two WAITs move together on purpose. They are the same quantity for the two sources,
// and letting them drift apart means the push and turn stop agreeing on the same base,
// which is what the overlap dedupe relies on.
// ── EVERY BLOCK BELONGS TO A TURN (Aaron, 2026-07-31) ──
// "It's capturing candles that have NOTHING to do with the turning points. I only want
// candles from turning points — either an engulfed candle, or the last candle from the
// turning point."
// That is the rule stated completely, and re-reading it exposes what was wrong: BOTH
// cases are AT A TURN. The engulf case is not "an engulf anywhere", it is "was there an
// engulf at this turn". The push source never knew that — it fired on any impulsive
// engulfing candle on the chart, mid-trend included, with no turn anywhere near it.
// That is exactly the box sitting out in the middle of a fall with no reference zone
// beside it, and no amount of anchor tuning could have fixed it: the block should never
// have existed.
// So the pivot is tracked HERE, above both sources, and the push must land at one.
// These two constants moved up from the turn source for the same reason — the pivot is
// now shared state, not the turn source's private business.
int OB_TURN_LEN  = 2
int OB_TURN_SCAN = 8
float obPvLo = ta.pivotlow(low,  OB_TURN_LEN, OB_TURN_LEN)
float obPvHi = ta.pivothigh(high, OB_TURN_LEN, OB_TURN_LEN)
var int obPvLoBar = na
var int obPvHiBar = na
if not na(obPvLo)
    obPvLoBar := bar_index - OB_TURN_LEN
if not na(obPvHi)
    obPvHiBar := bar_index - OB_TURN_LEN
int   OB_PUSH_LOOK = 5
int   OB_PUSH_WAIT = 10
float OB_PUSH_MULT = 0.3
float obPushAtr  = ta.atr(14)[OB_PUSH_WAIT]
float obPushBody = math.abs(close[OB_PUSH_WAIT] - open[OB_PUSH_WAIT])
bool  obPushUp   = close[OB_PUSH_WAIT] > open[OB_PUSH_WAIT]
bool  obPushOk   = barstate.isconfirmed and not na(obPushAtr) and obPushBody > obPushAtr * OB_PUSH_MULT
// Nearest OPPOSING candle BEHIND the push bar — the one it consumed. Offsets are
// absolute (measured from the live bar), so they start one past the push itself.
int obPushIdx = na
if obPushOk
    for j = OB_PUSH_WAIT + 1 to OB_PUSH_WAIT + OB_PUSH_LOOK
        if obPushUp ? close[j] < open[j] : close[j] > open[j]
            obPushIdx := j
            break
// Engulfed = closed through that candle's OPEN, with a bigger body than it had.
// ── AND THE CANDLE CONSUMED MUST BE A REAL ONE (Aaron, 2026-07-31) ──
// The measured case: a straight drop off a turn, and the SECOND box printed around a
// tiny doji three bars into the fall — a four-dollar rectangle drawn around a bar with
// no body at all.
// The hole is in the size test right above. "Bigger body than the one it consumed" is
// meant to be the EVIDENCE that a real candle was taken out, and against a doji it
// proves nothing: a near-zero body is beaten by every bar on the chart, and a close
// through its open is a hair's movement. So any doji sitting in a move is trivially
// "engulfed" and becomes a block. Worse, obBodyOnly is false, so the box is drawn at
// that bar's full WICK-TO-WICK range — an indecision bar prints a bigger zone than the
// candle that actually turned the market.
// So the consumed candle must clear the SAME ATR noise floor the pushing candle does.
// If the push has to be a real candle to count as a push, the thing it ate has to be a
// real candle to count as a level. One test, one constant, both ends.
// It REFUSES rather than scanning deeper on purpose. When the nearest opposing candle
// is a doji, the last opposing candle genuinely IS a doji — there is no order block
// there. Walking further back to find a bigger one would claim a level the push never
// came off, which is the same error in the other direction.
bool obPushEng = false
if not na(obPushIdx)
    float obPushPrev = math.abs(close[obPushIdx] - open[obPushIdx])
    bool  obPushReal = obPushPrev > obPushAtr * OB_PUSH_MULT
    obPushEng := obPushReal and obPushBody > obPushPrev and (obPushUp ? close[OB_PUSH_WAIT] > open[obPushIdx] : close[OB_PUSH_WAIT] < open[obPushIdx])
// ── AND THE PUSH MUST BE AT A TURN (Aaron, 2026-07-31) ──
// The gate that was missing. The anchor candle has to sit AT OR JUST AFTER a pivot in
// the matching direction — a pivot LOW for a bullish block, a pivot HIGH for a bearish
// one — within the same OB_TURN_SCAN window the turn source uses for its base.
// "At or just after", not "anywhere near": a block BEFORE the pivot is in the move that
// was still going down, which is the previous leg, not this turn's base.
// This is what makes the two sources two READINGS OF THE SAME EVENT rather than two
// independent generators. A turn now produces at most one block, by whichever rule
// applies to it — engulf if there was one, last-candle if there wasn't — and a stretch
// of chart with no turn in it produces none at all.
bool obPushAtTurn = false
if not na(obPushIdx)
    int obPushBar = bar_index - obPushIdx
    int obPvBar   = obPushUp ? obPvLoBar : obPvHiBar
    obPushAtTurn := not na(obPvBar) and obPushBar >= obPvBar and obPushBar - obPvBar <= OB_TURN_SCAN
// ── ONE BLOCK PER TURN, AND THE ENGULF RULE WINS IT (Aaron, 2026-07-31) ──
// Measured off the chart: at the same turn the reference drew ONE red zone and this drew
// TWO orange ones bracketing it — a higher, earlier box and a lower, later box. One is
// the push (engulf) reading, one is the turn (last-candle) reading, and both were right
// by their own rule. The zone dedupe in f_obAdd could not collapse them because it
// compares PRICE OVERLAP, and two readings of one turn can land on candles far enough
// apart in price to look like two levels.
// The rule as stated has an either/or in it — "the engulfed candle, OR if there is no
// engulf, the last candle" — so a turn is entitled to exactly one block, and the engulf
// reading is the one that claims it. That is what this latch enforces: the pivot bar a
// push block was drawn from is remembered, and the turn source refuses that pivot.
// Latched on the RETURN of f_obAdd, not on the push firing, because every gate in there
// can still refuse — displacement, height, the wick tap. If the push was refused, no
// block exists and the turn source must still get its chance at that pivot.
// THE ORDERING CAVEAT, stated because it is real: the push source runs first in the file
// but both read ~10 bars back, so on a turn where the turn source confirms FIRST the
// latch is not yet set and both can still draw. The overlap dedupe remains the backstop
// for that case. If pairs keep appearing, this is where to look.
var int obTurnUsedL = na
var int obTurnUsedS = na
if showOBs and obPushEng and obPushAtTurn and obPushUp and showBullOB
    if f_obAdd(activeBullOBs, obPushIdx, 1, true, false)
        obTurnUsedL := obPvLoBar
if showOBs and obPushEng and obPushAtTurn and not obPushUp and showBearOB
    if f_obAdd(activeBearOBs, obPushIdx, -1, true, false)
        obTurnUsedS := obPvHiBar

// ── EVERY TURN IS A POTENTIAL BLOCK (Aaron, 2026-07-31) ──
// "Not only engulfed candles but ALL points where price turns around." That is the
// better definition, and it is why the engulf rule above kept coming up short: an
// engulfing candle is one SYMPTOM of a turn, not the turn itself. Plenty of turns
// happen without one — price stalls, rolls over across two or three bars, and leaves
// no single candle that swallows its neighbour. The reference overlay has a zone at
// those turns; the engulf rule saw nothing there.
// So the trigger is now the TURN, detected as a short pivot:
//   PIVOT LOW  — price turned UP. The orders that turned it are on the last BEARISH
//                candle at or before that pivot → a BULLISH block.
//   PIVOT HIGH — the mirror: last BULLISH candle → a BEARISH block.
// AND THE LOOK-BACK IS THE OTHER HALF ("look back as price moves to capture the
// correct last opposing candle"). The pivot bar itself is usually NOT the block — the
// turn often prints as one or two small candles already going the new way, with the
// real opposing candle sitting a bar or two behind them. Anchoring on the pivot bar
// alone puts the box on the wrong candle, which is what "capture the correct last
// opposing candle" is naming. So the scan walks BACK from the pivot until it meets the
// first candle going the other way, and that is the block.
// OB_TURN_LEN is how sharp a turn has to be — 2 bars either side, so small rolls
// qualify and the chart gets a zone at each one. Raise it for fewer, bigger turns.
// Pivots confirm OB_TURN_LEN bars late, so these are non-repainting by construction.
// The dedupe in f_obAdd is what keeps this honest next to the push source above: a
// turn and a push very often land on the SAME opposing candle, and only one box prints.
// OB_TURN_WAIT — how long price is given to LEAVE before the turn is looked back at.
// The pivot confirms OB_TURN_LEN bars after the low, and at that moment price is usually
// still in the base, so the departure test in f_obAdd would find nothing and the block
// would be refused for ever (the turn fires once and never comes round again). So the
// pivot is read OB_TURN_WAIT bars LATE — obTurnBase is the pivot bar's offset by then,
// and those extra bars are exactly the window f_obAdd's replay walks looking for the
// close that left the zone. The turn nominates; the departure inside that window decides.
// ── TWO CASES, TWO ANCHORS (Aaron, 2026-07-31) — "if it's an engulf capture the
// engulfed candle; if it's not an engulf, at the turning point capture the last
// candle" ──
// That is the rule stated cleanly, and it is what the LOOK-BACK SCAN was getting
// wrong. The scan walked back from the pivot up to OB_TURN_LOOK bars hunting for the
// nearest opposing candle, which is the ENGULF rule's way of finding its anchor — and
// applying it at a turn dragged the box two or three bars behind the actual turn and
// down onto the wrong candle. That is exactly the mismatch the second measured
// instance showed: the reference sat two bars earlier and a whole zone higher.
//   ENGULF     — the push source above owns it. The block is the candle that got
//                CONSUMED (obPushIdx), which is what it already captures.
//   NO ENGULF  — a turn that just rolled over. The block is the LAST CANDLE, which
//                is the pivot candle itself: the one that printed the extreme.
// So there is no scan here any more. The pivot bar IS the anchor, full stop.
// Where the two rules land on the same candle the dedupe in f_obAdd prints one box.
// ── NO ENGULF → THE LAST CANDLE, AND THE LAST ONE IS NOT THE PIVOT (Aaron, 2026-07-31) ──
// "If the candle is not engulfed it's the LAST candle to capture."
// The pivot bar was being used as the anchor, and a pivot bar is the EXTREME — the
// deepest point of the turn. That is not the last candle; it is the FIRST candle of the
// base. Price then usually spends a bar or two more down there before it leaves, and the
// candle it actually left FROM is the later one. That is the measured difference in the
// blue-box pair: the reference sat one candle LATER than this.
// So the pivot only says WHERE the turn is. The anchor is then found by walking FORWARD
// from it — toward the live bar — and taking the LAST OPPOSING candle before the move
// away. For a bullish block that is the last BEARISH candle at the base; bearish is the
// mirror. Opposing, because that is the whole definition of an order block: the side
// that was taken out.
// This is NOT the scan that was removed earlier. That one walked BACKWARD from the pivot
// into the candles before the turn, which dragged the box away from the turn entirely.
// This walks the other way, and only across the base itself.
// OB_TURN_FWD is deliberately 2, which lands the shallowest possible anchor on offset 3 —
// exactly f_obAdd's OB_MIN_BACK. Raising it would let the anchor drift up beside the live
// bar and defeat the look-back guard, so the two constants are coupled: change one and
// check the other.
// If no opposing candle sits in that window the pivot bar stays the anchor — a turn that
// rolled over with no opposing candle at all genuinely has nothing better to point at.
// OB_TURN_WAIT raised 3 → 10 with OB_PUSH_WAIT — see the displacement-window note at the
// push source. obTurnBase becomes 12, so the forward walk still bottoms out at offset 10,
// comfortably past f_obAdd's OB_MIN_BACK of 3, and the departure loop now gets ten bars
// to measure travel in rather than two.
// OB_TURN_LEN and OB_TURN_SCAN moved UP to the push source — the pivot is shared state
// now, because the push has to prove it is at a turn too. See the note there.
// OB_TURN_SCAN is still what it always was for this source: how far forward of the pivot
// the base may run before the search gives up.
int OB_TURN_WAIT = 10
int obTurnBase = OB_TURN_LEN + OB_TURN_WAIT
float obTurnLo = obPvLo[OB_TURN_WAIT]
float obTurnHi = obPvHi[OB_TURN_WAIT]
// ── COLOUR DOES NOT MATTER AT A TURN (Aaron, 2026-07-31) ──
// "If there's no engulfed candle to box, focus on the LAST CANDLE BEFORE THE TURN.
// Doesn't matter the colour of the candle."
// The forward walk used to hunt for the last OPPOSING candle — bearish for a bullish
// block, bullish for a bearish one. That test is the ENGULF rule's way of finding its
// anchor, and it does not belong here: the push source owns the engulf case, and this
// source exists precisely for the turns that have no engulf in them. Requiring an
// opposing candle at a turn that simply rolled over meant skipping past the candle price
// actually left from to find one that happened to be the right colour.
// With the colour test gone the walk has nothing left to choose between — every bar in
// the window qualifies, so it always lands on the shallowest one. So the loop is gone
// too and the anchor is a plain offset.
// ── THE LAST CANDLE IS FOUND, NOT COUNTED (Aaron, 2026-07-31) ──
// "The last candle before the turn should be boxed. You're still boxing the wrong one —
// look at the blue boxes."
// OB_TURN_FWD was a fixed offset past the pivot, and a fixed offset cannot be right:
// how long price spends in the base before it leaves is different at every turn. Set to
// 2 it lands near the extreme on a slow base and past the drive on a fast one. Measured
// against the reference on three separate clusters, the left edges were consistently a
// few bars EARLY — which is what a too-small constant looks like. Raising it would just
// be a different guess with the same defect.
// So the anchor is DERIVED. "The last candle before the turn" means the last candle
// before price LEAVES, so the search walks forward from the pivot, finds the first
// candle where the drive has begun, and takes the bar immediately BEFORE it. That bar
// is the last one of the base by construction, at whatever distance the base happened
// to be — no constant to tune per chart.
// ── THE BASE ENDS WHEN PRICE CLEARS IT, NOT WHEN A BIG CANDLE PRINTS (Aaron, 2026-07-31) ──
// The first version of this search asked for an ATR-sized body in the new direction, and
// that has a failure the size test cannot see: the move away often STARTS on a modest
// candle and only gets big a bar or two later. Asking for size means walking straight
// past the real first drive candle to the larger one behind it, and anchoring one or two
// bars too LATE — the same class of error the fixed offset made, in the other direction.
// So there is no size test any more. The base ends the moment a candle CLOSES CLEAR OF
// EVERY CANDLE IN THE BASE SO FAR — above the running high for a bullish turn, below the
// running low for a bearish one. That is what "the move happened" means geometrically,
// and the anchor is the bar immediately before it: the last candle of the base.
// Measuring against the base's OWN running extreme rather than the pivot candle alone is
// what stops a slow base ending early. One candle poking above the pivot bar while the
// base is still forming is not a departure; clearing everything printed so far is.
// No constant, so nothing to retune per instrument or timeframe — the base sets its own
// threshold as it goes.
// ── THE BASE'S CEILING IS ITS BODIES, NOT ITS WICKS (Aaron, 2026-07-31) ──
// Measured across all three clusters against the reference: every box sat about three
// dollars HIGH, same height, same left region. A uniform offset in ONE direction is not
// three separate misses — it is one systematic error, and the size of it is one candle.
// The cause was using WICK extremes as the base's ceiling. A wick is the highest thing
// in a base by definition, so demanding a close above every spike makes the departure
// test hard to satisfy and it fires a bar LATE — which walks the anchor one bar forward
// onto a candle sitting slightly higher up the turn. That is exactly the observed shift.
// So the running extreme is the BODY extreme: max(open, close) going up, min going down.
// A base's wicks are where price was rejected; its bodies are where it actually traded,
// and clearing where it traded is what leaving the base means. The comparison is still
// close-against-extreme, so both sides of the test are now body-based and consistent.
// Colour is never tested, on the anchor or on the breakout candle. A close that clears
// the whole base is a departure whatever colour the candle happens to be, which is the
// rule as given.
// The two directions still differ and still need their own scans: a bullish base ends on
// a close above its highs, a bearish one on a close below its lows, and at the same turn
// those land on different bars.
// Falls back to the pivot bar if nothing clears inside OB_TURN_SCAN — a base that long
// has not displaced, and f_obAdd's displacement gate will refuse it anyway.
int   obTurnOffL = obTurnBase
int   obTurnOffS = obTurnBase
bool  obTurnFndL = false
bool  obTurnFndS = false
float obTurnRunH = math.max(open[obTurnBase], close[obTurnBase])
float obTurnRunL = math.min(open[obTurnBase], close[obTurnBase])
for j = obTurnBase - 1 to math.max(3, obTurnBase - OB_TURN_SCAN)
    if not obTurnFndL
        if close[j] > obTurnRunH
            obTurnOffL := j + 1
            obTurnFndL := true
        else
            obTurnRunH := math.max(obTurnRunH, open[j], close[j])
    if not obTurnFndS
        if close[j] < obTurnRunL
            obTurnOffS := j + 1
            obTurnFndS := true
        else
            obTurnRunL := math.min(obTurnRunL, open[j], close[j])
// The pivot bar THIS source is reading — compared against the push latch so a turn the
// engulf rule already claimed is not boxed a second time. See the note at the push sites.
int obTurnPvBar = bar_index - obTurnBase
if showOBs and showBullOB and not na(obTurnLo) and obTurnPvBar != obTurnUsedL
    f_obAdd(activeBullOBs, obTurnOffL, 1, true, false)
if showOBs and showBearOB and not na(obTurnHi) and obTurnPvBar != obTurnUsedS
    f_obAdd(activeBearOBs, obTurnOffS, -1, true, false)

// Internal structure — Step 2: pullback tracking to confirm iSH / iSL

// ── State ─────────────────────────────────────────────────
var int   i_mode           = 0
var bool  i_seeded         = false

// Pullback tracking
var float i_pb_extreme     = na
var int   i_pb_extreme_loc = na
var int   i_pb_count       = 0
var bool  i_pb_started     = false
var float i_pb_lqc         = na
var float i_pb_lqh         = na
var float i_prev_high      = na
var float i_prev_low       = na

// Active swing level (iSH or iSL)
var float i_sw_price       = na
var int   i_sw_loc         = na
var line  i_sw_line        = na
var label i_sw_lbl         = na

// Pre-declared locals (Pine v6)
var bool  i_ext_chg        = false
var bool  i_is_inside      = false
var bool  i_ext_dir        = false
var bool  i_is_c1          = false
var float i_thresh         = na

var float i_tracked_ext     = na
var int   i_tracked_ext_loc = na
var int   i_last_mode       = 0   // remembers what mode confirmed the swing
var bool  i_had_bos         = false
var string i_h_lbl          = ""
var color  i_h_col          = color.black
var string i_l_lbl          = ""
var color  i_l_col          = color.black
var int   i_mid             = 0
var int   i_mid2            = 0
var float i_last_hl         = na   // last confirmed iHL price (for iSOS in bullish cycle)

// Captures the latest confirmed internal swing point (price + location), so the
// External Fib can adopt it as its anchor if it's more extreme than the external
// structure's own point — used only for the fib pull, nothing else.
var float i_confirmed_low_price  = na
var int   i_confirmed_low_loc    = na
var float i_confirmed_high_price = na
var int   i_confirmed_high_loc   = na
var float i_last_lh         = na   // last confirmed iLH price (for iSOS in bearish cycle)
var int   i_last_hl_loc     = na
var int   i_last_lh_loc     = na

var float i_sos_watch_hh    = na
var int   i_sos_watch_hh_loc= na
var float i_sos_watch_ll    = na
var int   i_sos_watch_ll_loc= na

// ── Break-line colour handles ──
// A break label (iBOS/iSOS) is printed ON a dotted line that was drawn EARLIER, in
// the colour of whatever that level was at the time — the iSH line is bearish-red,
// the iHL line is bullish-blue, and so on. So a bullish iBOS breaking the first iSH
// used to print a BLUE label on a RED line, and an iSOS printed its label on the
// opposite-coloured iHL/iLH line. The LABEL is the truth (it names the break that
// just happened), so these handles let each break site recolour the line under its
// own label. Cleared with the rest of the internal state on an external break —
// after that wipe the line objects may be deleted, so the handles must not outlive
// them.
var line  i_last_hl_line = na
var line  i_last_lh_line = na
var line  i_sos_hh_line  = na
var line  i_sos_ll_line  = na

// Repaint a break's line in the break label's colour. Silent when the handle is na
// (nothing was drawn at that level yet) or when internal structure is hidden.
f_iBrkCol(line ln, color c) =>
    if not na(ln)
        line.set_color(ln, showInternal ? color.new(c, 15) : color(na))
    int _r = 0

// (Internal Fib anchor + touched-tracking vars removed — feature deleted.)

float i_lbl_y_offset = syminfo.mintick * 20   // vertical offset for iBOS/iSOS (smaller number = closer to the line)

// Internal structure is naturally scoped to the current active external swing —
// it resets on every external SOS/CHoCH (see block right below).
bool internalActive = showInternal

// Tracks every internal-structure label/line drawn during the current external
// swing, so they can be wiped when a new swing starts (unless showHistoricalInternal is on).
var array<label> intHistLabels = array.new<label>()
var array<line>  intHistLines  = array.new<line>()

// ── Stop internal tracking on external SOS ───────────────
// True on any bar where the external structure breaks — the current internal
// swing is finished. Used further down to clear the table's INT row so it can
// never show an iBOS/iSOS whose drawing has already been wiped from the chart.
bool extBreakThisBar = st.bull_bos or st.bear_bos or st.bull_sos or st.bear_sos

if internalActive and (st.bull_bos or st.bear_bos or st.bull_sos or st.bear_sos)
    if not na(i_sw_line)
        line.set_x2(i_sw_line, bar_index)
        i_sw_line := na
    i_sw_lbl          := na
    i_sw_price        := na
    i_mode            := 0
    i_seeded          := false
    i_pb_count        := 0
    i_pb_started      := false
    i_tracked_ext     := na
    i_tracked_ext_loc := na
    i_last_hl         := na
    i_last_lh         := na
    i_had_bos         := false
    i_sos_watch_hh    := na
    i_sos_watch_ll    := na
    i_last_hl_line    := na
    i_last_lh_line    := na
    i_sos_hh_line     := na
    i_sos_ll_line     := na
    // Past swing just ended — wipe its internal structure unless history is enabled
    if not showHistoricalInternal
        if array.size(intHistLabels) > 0
            for i = 0 to array.size(intHistLabels) - 1
                label.delete(array.get(intHistLabels, i))
        if array.size(intHistLines) > 0
            for i = 0 to array.size(intHistLines) - 1
                line.delete(array.get(intHistLines, i))
    array.clear(intHistLabels)
    array.clear(intHistLines)

// ── Track prev bar ────────────────────────────────────────
if internalActive
    i_prev_high := high
    i_prev_low  := low


// ── Seed on new external swing ────────────────────────────
if internalActive
    if st.new_swing_low and not st.bull_sos and not st.bear_sos
        i_mode            := 1
        i_seeded          := true
        i_had_bos         := false
        i_pb_started      := false
        i_pb_extreme      := na
        i_pb_count        := 0
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_mode       := 1
        i_last_hl         := na
        i_last_lh         := na
        i_sos_watch_hh    := na
        i_sos_watch_ll    := na
    else if st.new_swing_high and not st.bull_sos and not st.bear_sos
        i_mode            := -1
        i_seeded          := true
        i_had_bos         := false
        i_pb_started      := false
        i_pb_extreme      := na
        i_pb_count        := 0
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_mode       := -1
        i_last_hl         := na
        i_last_lh         := na
        i_sos_watch_hh    := na
        i_sos_watch_ll    := na

// ── Mode 1: track upward move → confirm iSH ──────────────
if internalActive and i_seeded and i_mode == 1
    if not i_pb_started
        i_pb_started     := true
        i_pb_extreme     := high
        i_pb_extreme_loc := bar_index
        i_pb_count       := 0
        i_pb_lqc         := na
        i_pb_lqh         := na
    else
        // Update extreme if new high
        i_ext_chg := false
        if high > i_pb_extreme
            i_pb_extreme     := high
            i_pb_extreme_loc := bar_index
            i_pb_count       := 0
            i_pb_lqc         := na
            i_pb_lqh         := na
            i_ext_chg        := true
        // is_inside and qualifying bar checks (exact external rule)
        i_is_inside := not na(i_prev_high) and not na(i_prev_low) and high < i_prev_high and low > i_prev_low
        i_ext_dir   := i_ext_chg and close < open
        i_is_c1     := na(i_pb_lqc) and not i_ext_chg
        if (not i_is_inside or i_is_c1) and (not i_ext_chg or i_ext_dir)
            i_thresh := na(i_pb_lqh) ? i_pb_extreme : i_pb_lqh
            if close < i_thresh - pbBuffer
                i_pb_count += 1
                i_pb_lqc   := close
                i_pb_lqh   := low
        // 3 bars confirmed → iSH
        if i_pb_count >= 3 and not na(i_pb_extreme)
            if not na(i_sw_line)
                line.set_x2(i_sw_line, bar_index)
            i_sw_line  := na
            i_sw_lbl   := na
            i_sw_price := i_pb_extreme
            i_sw_loc   := i_pb_extreme_loc
            // Label: iSH if first swing, iHH if higher than last, iLH if lower
            i_h_lbl := not i_had_bos ? "iSH" : "iHH"
            i_h_col := not i_had_bos ? iBearColor : iBullColor
            i_confirmed_high_price := i_sw_price
            i_confirmed_high_loc   := i_sw_loc
            i_sw_line  := line.new(i_sw_loc, i_sw_price, bar_index, i_sw_price, color = showInternal ? color.new(i_h_col, 15) : color(na), style = line.style_dotted, width = 1)
            i_sw_lbl   := label.new(i_sw_loc, i_sw_price, i_h_lbl + "\n", color = color(na), textcolor=f_swingCol(color.new(i_h_col, 15)), style = label.style_label_down, size = size.tiny)
            array.push(intHistLines, i_sw_line)
            array.push(intHistLabels, i_sw_lbl)
            i_mode       := 0
            i_pb_count   := 0
            i_pb_started := false

// ── Mode -1: track downward move → confirm iSL ───────────
if internalActive and i_seeded and i_mode == -1
    if not i_pb_started
        i_pb_started     := true
        i_pb_extreme     := low
        i_pb_extreme_loc := bar_index
        i_pb_count       := 0
        i_pb_lqc         := na
        i_pb_lqh         := na
    else
        // Update extreme if new low
        i_ext_chg := false
        if low < i_pb_extreme
            i_pb_extreme     := low
            i_pb_extreme_loc := bar_index
            i_pb_count       := 0
            i_pb_lqc         := na
            i_pb_lqh         := na
            i_ext_chg        := true
        // is_inside and qualifying bar checks
        i_is_inside := not na(i_prev_high) and not na(i_prev_low) and high < i_prev_high and low > i_prev_low
        i_ext_dir   := i_ext_chg and close > open
        i_is_c1     := na(i_pb_lqc) and not i_ext_chg
        if (not i_is_inside or i_is_c1) and (not i_ext_chg or i_ext_dir)
            i_thresh := na(i_pb_lqh) ? i_pb_extreme : i_pb_lqh
            if close > i_thresh + pbBuffer
                i_pb_count += 1
                i_pb_lqc   := close
                i_pb_lqh   := high
        // 3 bars confirmed → iSL
        if i_pb_count >= 3 and not na(i_pb_extreme)
            if not na(i_sw_line)
                line.set_x2(i_sw_line, bar_index)
            i_sw_line  := na
            i_sw_lbl   := na
            i_sw_price := i_pb_extreme
            i_sw_loc   := i_pb_extreme_loc
            // Label: iSL if first swing, iLL if lower than last, iHL if higher
            i_l_lbl := not i_had_bos ? "iSL" : "iLL"
            i_l_col := not i_had_bos ? iBullColor : iBearColor
            i_confirmed_low_price := i_sw_price
            i_confirmed_low_loc   := i_sw_loc
            i_sw_line  := line.new(i_sw_loc, i_sw_price, bar_index, i_sw_price, color = showInternal ? color.new(i_l_col, 15) : color(na), style = line.style_dotted, width = 1)
            i_sw_lbl   := label.new(i_sw_loc, i_sw_price, "\n" + i_l_lbl, color = color(na), textcolor=f_swingCol(color.new(i_l_col, 15)), style = label.style_label_up, size = size.tiny)
            array.push(intHistLines, i_sw_line)
            array.push(intHistLabels, i_sw_lbl)
            i_mode       := 0
            i_pb_count   := 0
            i_pb_started := false

// ── Track extreme while watching (mode 0) ────────────────
if internalActive and i_seeded and i_mode == 0
    if i_last_mode == 1
        if na(i_tracked_ext) or low < i_tracked_ext
            i_tracked_ext     := low
            i_tracked_ext_loc := bar_index
    else if i_last_mode == -1
        if na(i_tracked_ext) or high > i_tracked_ext
            i_tracked_ext     := high
            i_tracked_ext_loc := bar_index

// ── iBOS / iSOS detection ────────────────────────────────
bool int_bull_break = false
bool int_bear_break = false
bool int_bull_bos   = false
bool int_bull_sos   = false
bool int_bear_bos   = false
bool int_bear_sos   = false
int  int_break_origin_loc = na

if internalActive and i_mode == 0 and i_seeded and not na(i_sw_price) and barstate.isconfirmed
    if close > i_sw_price and i_last_mode == 1
        i_mid := math.round((i_sw_loc + bar_index) / 2)
        label iBullBOSLbl = label.new(i_mid, i_sw_price + i_lbl_y_offset, "iBOS", color = color(na), textcolor = showInternal ? iBullColor : color(na), style = label.style_none, size = size.tiny, textalign = text.align_center)
        array.push(intHistLabels, iBullBOSLbl)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            // The broken swing line carries the iBOS label — repaint it bullish.
            f_iBrkCol(i_sw_line, iBullColor)
            i_sw_line := na
        i_sw_lbl := na
        if not na(i_tracked_ext)
            line  iHLLine = line.new(i_tracked_ext_loc, i_tracked_ext, bar_index, i_tracked_ext, color = showInternal ? color.new(iBullColor, 15) : color(na), style = line.style_dotted, width = 1)
            label iHLLbl  = label.new(i_tracked_ext_loc, i_tracked_ext, "\niHL", color = color(na), textcolor=f_swingCol(color.new(iBullColor, 15)), style = label.style_label_up, size = size.tiny)
            array.push(intHistLines, iHLLine)
            array.push(intHistLabels, iHLLbl)
            i_last_hl      := i_tracked_ext
            i_last_hl_loc  := i_tracked_ext_loc
            i_last_hl_line := iHLLine
        
        int_bull_break := true
        int_bull_bos   := true
        int_break_origin_loc := i_tracked_ext_loc
        i_sw_price       := na
        i_tracked_ext    := na
        i_tracked_ext_loc := na
        i_pb_count       := 0
        i_pb_started     := false
        i_pb_lqc         := na
        i_pb_lqh         := na
        i_had_bos        := true
        i_last_mode      := 1
        i_mode           := 1
        i_sos_watch_ll   := na

    else if close < i_sw_price and i_last_mode == -1
        i_mid2 := math.round((i_sw_loc + bar_index) / 2)
        label iBearBOSLbl = label.new(i_mid2, i_sw_price, "iBOS", color = color(na), textcolor = showInternal ? iBearColor : color(na), style = label.style_label_up, size = size.tiny, textalign = text.align_center)
        array.push(intHistLabels, iBearBOSLbl)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            // The broken swing line carries the iBOS label — repaint it bearish.
            f_iBrkCol(i_sw_line, iBearColor)
            i_sw_line := na
        i_sw_lbl := na
        if not na(i_tracked_ext)
            line  iLHLine = line.new(i_tracked_ext_loc, i_tracked_ext, bar_index, i_tracked_ext, color = showInternal ? color.new(iBearColor, 15) : color(na), style = line.style_dotted, width = 1)
            label iLHLbl  = label.new(i_tracked_ext_loc, i_tracked_ext, "iLH\n", color = color(na), textcolor=f_swingCol(color.new(iBearColor, 15)), style = label.style_label_down, size = size.tiny)
            array.push(intHistLines, iLHLine)
            array.push(intHistLabels, iLHLbl)
            i_last_lh      := i_tracked_ext
            i_last_lh_loc  := i_tracked_ext_loc
            i_last_lh_line := iLHLine
            
        int_bear_break := true
        int_bear_bos   := true
        int_break_origin_loc := i_tracked_ext_loc
        i_sw_price        := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_pb_count        := 0
        i_pb_started      := false
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_had_bos         := true
        i_last_mode       := -1
        i_mode            := -1
        i_sos_watch_hh    := na



// ── iSOS detection (watches last iHL / iLH) ──────────────
if internalActive and i_seeded and i_had_bos and barstate.isconfirmed
    if i_last_mode == 1 and not na(i_last_hl) and close < i_last_hl and i_mode == 0
        i_mid2 := math.round((i_last_hl_loc + bar_index) / 2)
        label iSOS1Lbl = label.new(i_mid2, i_last_hl, "iSOS", color = color(na), textcolor = showInternal ? iBearColor : color(na), style = label.style_label_up, size = size.tiny, textalign = text.align_center)
        line  iSOS1Line = line.new(i_last_hl_loc, i_last_hl, bar_index, i_last_hl, color = showInternal ? color.new(iBearColor, 15) : color(na), style = line.style_dotted, width = 1)
        array.push(intHistLabels, iSOS1Lbl)
        array.push(intHistLines, iSOS1Line)
        // The iHL line already sits at this exact price in bullish blue — repaint it
        // bearish so the level under the red iSOS label is not two clashing colours.
        f_iBrkCol(i_last_hl_line, iBearColor)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            // This swing's line becomes the i_sos_watch_hh level a later iSOS annotates.
            i_sos_hh_line := i_sw_line
            i_sw_line := na

        i_sos_watch_hh     := i_sw_price
        i_sos_watch_hh_loc := i_sw_loc
        i_sos_watch_ll     := na
        
        int_bear_break := true
        int_bear_sos   := true
        int_break_origin_loc := i_sw_loc
        i_sw_lbl          := na
        i_sw_price        := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_hl         := na
        i_pb_count        := 0
        i_pb_started      := false
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_last_mode       := -1
        i_mode            := -1

    else if i_last_mode == -1 and not na(i_last_lh) and close > i_last_lh and i_mode == 0
        i_mid := math.round((i_last_lh_loc + bar_index) / 2)
        label iSOS2Lbl = label.new(i_mid, i_last_lh + i_lbl_y_offset, "iSOS", color = color(na), textcolor = showInternal ? iBullColor : color(na), style = label.style_none, size = size.tiny, textalign = text.align_center)
        line  iSOS2Line = line.new(i_last_lh_loc, i_last_lh, bar_index, i_last_lh, color = showInternal ? color.new(iBullColor, 15) : color(na), style = line.style_dotted, width = 1)
        array.push(intHistLabels, iSOS2Lbl)
        array.push(intHistLines, iSOS2Line)
        // Mirror of iSOS1 — the iLH line at this price is bearish red; repaint bullish.
        f_iBrkCol(i_last_lh_line, iBullColor)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sos_ll_line := i_sw_line
            i_sw_line := na

        i_sos_watch_ll     := i_sw_price
        i_sos_watch_ll_loc := i_sw_loc
        i_sos_watch_hh     := na
        
        int_bull_break := true
        int_bull_sos   := true
        int_break_origin_loc := i_sw_loc
        i_sw_lbl          := na
        i_sw_price        := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_lh         := na
        i_pb_count        := 0
        i_pb_started      := false
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_last_mode       := 1
        i_mode            := 1

    else if i_last_mode == -1 and not na(i_sos_watch_hh) and close > i_sos_watch_hh and i_mode == 0
        i_mid := math.round((i_sos_watch_hh_loc + bar_index) / 2)
        label iSOS3Lbl = label.new(i_mid, i_sos_watch_hh + i_lbl_y_offset, "iSOS", color = color(na), textcolor = showInternal ? iBullColor : color(na), style = label.style_none, size = size.tiny, textalign = text.align_center)
        line  iSOS3Line = line.new(i_sos_watch_hh_loc, i_sos_watch_hh, bar_index, i_sos_watch_hh, color = showInternal ? color.new(iBullColor, 15) : color(na), style = line.style_dotted, width = 1)
        array.push(intHistLabels, iSOS3Lbl)
        array.push(intHistLines, iSOS3Line)
        // The watched-high level's own line was drawn in that swing's colour — repaint
        // it bullish to match this iSOS label.
        f_iBrkCol(i_sos_hh_line, iBullColor)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sos_ll_line := i_sw_line
            i_sw_line := na

        i_sos_watch_ll     := i_sw_price
        i_sos_watch_ll_loc := i_sw_loc
        
        int_bull_break := true
        int_bull_sos   := true
        int_break_origin_loc := i_sw_loc
        i_sw_lbl          := na
        i_sw_price        := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_lh         := na
        i_pb_count        := 0
        i_pb_started      := false
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_last_mode       := 1
        i_mode            := 1
        i_sos_watch_hh    := na

    else if i_last_mode == 1 and not na(i_sos_watch_ll) and close < i_sos_watch_ll and i_mode == 0
        i_mid2 := math.round((i_sos_watch_ll_loc + bar_index) / 2)
        label iSOS4Lbl = label.new(i_mid2, i_sos_watch_ll, "iSOS", color = color(na), textcolor = showInternal ? iBearColor : color(na), style = label.style_label_up, size = size.tiny, textalign = text.align_center)
        line  iSOS4Line = line.new(i_sos_watch_ll_loc, i_sos_watch_ll, bar_index, i_sos_watch_ll, color = showInternal ? color.new(iBearColor, 15) : color(na), style = line.style_dotted, width = 1)
        array.push(intHistLabels, iSOS4Lbl)
        array.push(intHistLines, iSOS4Line)
        // Mirror of iSOS3 — repaint the watched-low level's line bearish.
        f_iBrkCol(i_sos_ll_line, iBearColor)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sos_hh_line := i_sw_line
            i_sw_line := na

        i_sos_watch_hh     := i_sw_price
        i_sos_watch_hh_loc := i_sw_loc
        
        int_bear_break := true
        int_bear_sos   := true
        int_break_origin_loc := i_sw_loc
        i_sw_lbl          := na
        i_sw_price        := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_hl         := na
        i_pb_count        := 0
        i_pb_started      := false
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_last_mode       := -1
        i_mode            := -1
        i_sos_watch_ll    := na

// ── Internal Structure OB Creation — COMMENTED OUT with f_obMake (Aaron, 2026-07-31) ──
// This pair was the actual culprit in the measured case: the iBOS between the two
// screenshots fired THIS block, which ran the 40-bar retro scan and evicted the correct
// zone. See the long note at f_obMake for the full reasoning.
// The trend-aligned filter went with it, and only ever mattered here — an internal break
// can fire against the external trend, an external one cannot. The push and turn sources
// pass vis = true unconditionally, so with this gone the "Trend-Aligned Zones Only"
// switch no longer bites on order blocks at all; it still filters fair value gaps.
// bool obIntVisB = not obDirOnly or st.dir >= 0
// bool obIntVisS = not obDirOnly or st.dir <= 0
// if showOBs and showBullOB and int_bull_break and not na(int_break_origin_loc)
//     f_obMake(activeBullOBs, int_break_origin_loc, 1, obIntVisB)

// if showOBs and showBearOB and int_bear_break and not na(int_break_origin_loc)
//     f_obMake(activeBearOBs, int_break_origin_loc, -1, obIntVisS)


// ── Update last_mode when mode changes ───────────────────
if internalActive and i_mode != 0
    i_last_mode := i_mode

// ── Extend active swing line every bar ────────────────────
if internalActive and not na(i_sw_line)
    line.set_x2(i_sw_line, bar_index)

//============================================================
  // EQUAL HIGHS / LOWS (EQH / EQL)
//============================================================
// EQH = two consecutive swing highs within a tolerance of each other = a stacked
// pool of buy-side liquidity resting just above; EQL is the mirror below. Drawn as a
// horizontal line from the first pivot, extended right, until price CLOSES through it
// (liquidity taken). Their prices also feed the FVG-persistence exemption below.
bool  eqShow = showTradeTools and eqShowInput
float eqAtr  = ta.atr(50)
float eqTol  = na(eqAtr) ? 0.0 : eqAtr * eqAtrMult

var array<line>  eqhLines = array.new<line>()
var array<label> eqhLbls  = array.new<label>()
var array<float> eqhPx    = array.new<float>()
var array<int>   eqhBar   = array.new<int>()
var array<line>  eqlLines = array.new<line>()
var array<label> eqlLbls  = array.new<label>()
var array<float> eqlPx    = array.new<float>()
var array<int>   eqlBar   = array.new<int>()

// True when an FVG (gTop..gBot) overlaps, or sits within `prox` of, any active EQ level.
f_fvgNearEq(float gTop, float gBot, float prox) =>
    bool near = false
    if array.size(eqhPx) > 0
        for i = 0 to array.size(eqhPx) - 1
            float lvl = array.get(eqhPx, i)
            if lvl >= gBot - prox and lvl <= gTop + prox
                near := true
    if array.size(eqlPx) > 0
        for i = 0 to array.size(eqlPx) - 1
            float lvl = array.get(eqlPx, i)
            if lvl >= gBot - prox and lvl <= gTop + prox
                near := true
    near

// Toggled off → clear anything drawn
if not eqShow and (array.size(eqhLines) > 0 or array.size(eqlLines) > 0)
    if array.size(eqhLines) > 0
        for i = 0 to array.size(eqhLines) - 1
            line.delete(array.get(eqhLines, i)), label.delete(array.get(eqhLbls, i))
    if array.size(eqlLines) > 0
        for i = 0 to array.size(eqlLines) - 1
            line.delete(array.get(eqlLines, i)), label.delete(array.get(eqlLbls, i))
    array.clear(eqhLines), array.clear(eqhLbls), array.clear(eqhPx), array.clear(eqhBar)
    array.clear(eqlLines), array.clear(eqlLbls), array.clear(eqlPx), array.clear(eqlBar)

f_processEq() =>
    float eqPh = ta.pivothigh(high, eqPivotLen, eqPivotLen)
    float eqPl = ta.pivotlow(low,  eqPivotLen, eqPivotLen)
    var float eqPrevPh = na, var int eqPrevPhBar = na
    var float eqPrevPl = na, var int eqPrevPlBar = na

    if eqShow and not na(eqPh)
        int phBar = bar_index - eqPivotLen
        if not na(eqPrevPh) and math.abs(eqPh - eqPrevPh) <= eqTol
            float lvl = math.max(eqPh, eqPrevPh)
            line ln = line.new(eqPrevPhBar, lvl, bar_index, lvl, color = eqhColor, style = line.style_solid, width = 1)
            // style_label_left with an INVISIBLE box (color = na), not style_none (Aaron,
            // 2026-08-04): style_none centres its text ON the anchor, so half the glyph
            // sits above the level and it reads as an offset tag floating over the line.
            // style_label_left anchors the label's LEFT edge at the point and centres the
            // text vertically on it — the tag starts exactly where the line ends and sits
            // ON the level, which is what "at the end of the line" means. The na box keeps
            // the plain-text look style_none had.
            label lb = label.new(bar_index, lvl, "EQH", style = label.style_label_left, color = color(na), textcolor = eqhColor, size = f_liqSize(), textalign = text.align_left)
            array.push(eqhLines, ln), array.push(eqhLbls, lb), array.push(eqhPx, lvl), array.push(eqhBar, eqPrevPhBar)
            while array.size(eqhLines) > eqMax
                line.delete(array.shift(eqhLines)), label.delete(array.shift(eqhLbls)), array.shift(eqhPx), array.shift(eqhBar)
        eqPrevPh := eqPh, eqPrevPhBar := phBar

    if eqShow and not na(eqPl)
        int plBar = bar_index - eqPivotLen
        if not na(eqPrevPl) and math.abs(eqPl - eqPrevPl) <= eqTol
            float lvl = math.min(eqPl, eqPrevPl)
            line ln = line.new(eqPrevPlBar, lvl, bar_index, lvl, color = eqlColor, style = line.style_solid, width = 1)
            // Mirror of the EQH label — see the note there for why style_label_left.
            label lb = label.new(bar_index, lvl, "EQL", style = label.style_label_left, color = color(na), textcolor = eqlColor, size = f_liqSize(), textalign = text.align_left)
            array.push(eqlLines, ln), array.push(eqlLbls, lb), array.push(eqlPx, lvl), array.push(eqlBar, eqPrevPlBar)
            while array.size(eqlLines) > eqMax
                line.delete(array.shift(eqlLines)), label.delete(array.shift(eqlLbls)), array.shift(eqlPx), array.shift(eqlBar)
        eqPrevPl := eqPl, eqPrevPlBar := plBar

    // ── A WICK TAKES THE LIQUIDITY (Aaron, 2026-08-04) ──
    // The test was `close > lvl` — a CLOSE above the EQH — so a candle that speared
    // clean through the level and closed back under it left the line drawn. That is the
    // EQH still sitting on the chart with a wick through it.
    // A close test is the wrong question for THIS object, and it is worth saying why
    // rather than just flipping it. An EQH is not a support/resistance level being
    // "broken" — it is a POOL OF RESTING STOPS above two equal highs. Price reaching
    // those stops is what fills them, and price reaches with its WICK. So the sweep IS
    // the wick; whether the candle closed back below is a statement about what happened
    // AFTER the liquidity was taken, not about whether it was taken.
    // This is the same correction the order blocks got on 2026-07-31 ("if an OB is
    // wicked and the candle pulls back it's mitigated"), for the same reason, and it
    // leaves the two tools reading the chart the same way.
    // `high`/`low`, not `close`, also makes the deletion STABLE on the live bar: a bar's
    // high only ever grows within the bar, so once it clears the level it stays cleared.
    // The old close test could delete a level intrabar and put it back on the next tick
    // as the close moved — Pine restores every `var` array on each realtime tick.
    // ⚠ This is now the ONLY copy of the EQ block that reads a wick. `mpc_strategy.pine`
    // and engines/equal_highs_lows/ both still use `close`, so the three have diverged
    // deliberately — see the note handed back with this change.
    if eqShow and array.size(eqhLines) > 0
        for i = array.size(eqhLines) - 1 to 0
            float lvl = array.get(eqhPx, i)
            if high > lvl
                line.delete(array.get(eqhLines, i)), label.delete(array.get(eqhLbls, i))
                array.remove(eqhLines, i), array.remove(eqhLbls, i), array.remove(eqhPx, i), array.remove(eqhBar, i)
            else
                line ehl = array.get(eqhLines, i)
                // x1 clamp — an unmitigated EQ level can outlive its pivot by thousands
                // of bars; keep its origin inside the buffer (see f_liqMitigate). Read the
                // origin from eqhBar, NOT line.get_x1 — querying an already-aged line is
                // the very thing that can throw.
                line.set_x1(ehl, math.max(array.get(eqhBar, i), bar_index - LIQ_ORIGIN_CAP))
                line.set_x2(ehl, bar_index)
                label.set_x(array.get(eqhLbls, i), bar_index)
    if eqShow and array.size(eqlLines) > 0
        for i = array.size(eqlLines) - 1 to 0
            float lvl = array.get(eqlPx, i)
            // Mirror of the EQH wick rule above — an EQL is sell-side liquidity resting
            // BELOW, so the low reaching it is what takes it.
            if low < lvl
                line.delete(array.get(eqlLines, i)), label.delete(array.get(eqlLbls, i))
                array.remove(eqlLines, i), array.remove(eqlLbls, i), array.remove(eqlPx, i), array.remove(eqlBar, i)
            else
                line ell = array.get(eqlLines, i)
                line.set_x1(ell, math.max(array.get(eqlBar, i), bar_index - LIQ_ORIGIN_CAP))
                line.set_x2(ell, bar_index)
                label.set_x(array.get(eqlLbls, i), bar_index)
    int _ret = 0
f_processEq()

//============================================================
  // FAIR VALUE GAPS — persist until mitigated
//============================================================
// A bullish FVG is the void between candle A's high and candle C's low when the
// displacement candle B between them was strong enough that the two never overlap
// (low > high[2]). Bearish is the mirror.
// Lifecycle: gaps are NOT wiped on BOS/SOS — the impulse leg that breaks structure
// is exactly what leaves the gaps, and the retracement back into them is the fib
// entry confluence. A gap is deleted only when a candle CLOSES fully past it (a
// wick into the gap leaves it alive); chart clutter
// is bounded by the Max Active FVGs cap (oldest dropped first). The optional
// directional filter hides (not deletes) gaps that oppose the current external
// structure direction, so they reappear if direction flips back.
var array<box>   fvgBoxes  = array.new<box>()
var array<float> fvgTops   = array.new<float>()
var array<float> fvgBots   = array.new<float>()
var array<bool>  fvgIsBull = array.new<bool>()
var array<int>   fvgBorn   = array.new<int>()

// True when a gap sits in the live fib ENTRY BAND on the trade's own side — the gaps a
// setup is actually entered from. Read by the cap below, both to COUNT and to CHOOSE what
// to drop, so a protected gap never holds a slot and is never the one evicted.
// The band is last bar's (see fvgZoneLo's declaration). That lag is deliberate: this
// decides which gap to THROW AWAY, never which one to trade, and a live leg's band moves
// by a few dollars a bar.
f_fvgZoneKeep(float gTop, float gBot, bool isBull) =>
    fvgExemptZone and fvgZoneDir != 0 and isBull == (fvgZoneDir == 1) and not na(fvgZoneLo)
      and gTop >= fvgZoneLo and gBot <= fvgZoneHi

f_fvgClearAll() =>
    if array.size(fvgBoxes) > 0
        for i = 0 to array.size(fvgBoxes) - 1
            box.delete(array.get(fvgBoxes, i))
        array.clear(fvgBoxes)
        array.clear(fvgTops)
        array.clear(fvgBots)
        array.clear(fvgIsBull)
        array.clear(fvgBorn)

// Toggled off → remove anything on the chart
if not showFVG and array.size(fvgBoxes) > 0
    f_fvgClearAll()

// ── Detection (confirmed bars only, so live wicks can't paint phantom gaps) ──
// The FVG is the 3-candle imbalance itself (LuxAlgo definition): bar A and bar C
// never overlap and the middle bar's close cleared the gap. No "clean impulse"
// body/colour rule — any 3 bars that leave a big-enough gap qualify.
// Threshold is the hardcoded 0.1%-of-price floor (see fvgThreshPct above).
f_processFvg() =>
    float fvgThreshold = fvgThreshPct
    if showFVG and barstate.isconfirmed and bar_index >= 2
        // Bullish: gap between two bars ago's high and this bar's low; middle bar closed above it
        bool bullFvg = low > high[2] and (not fvgRequireClose or close[1] > high[2]) and (low - high[2]) / high[2] * 100 > fvgThreshold
        // Bearish: mirror
        bool bearFvg = high < low[2] and (not fvgRequireClose or close[1] < low[2]) and (low[2] - high) / low[2] * 100 > fvgThreshold
        if bullFvg
            box b = box.new(bar_index - 1, low, bar_index, high[2], bgcolor = fvgBullColor, border_color = color(na), text = "FVG", text_color = color.new(color.green, 0), text_size = size.tiny, text_halign = text.align_right)
            array.push(fvgBoxes, b)
            array.push(fvgTops, low)
            array.push(fvgBots, high[2])
            array.push(fvgIsBull, true)
            array.push(fvgBorn, bar_index)
        // Bearish: gap between two bars ago's low and this bar's high
        if bearFvg
            box b = box.new(bar_index - 1, low[2], bar_index, high, bgcolor = fvgBearColor, border_color = color(na), text = "FVG", text_color = color.new(color.red, 0), text_size = size.tiny, text_halign = text.align_right)
            array.push(fvgBoxes, b)
            array.push(fvgTops, low[2])
            array.push(fvgBots, high)
            array.push(fvgIsBull, false)
            array.push(fvgBorn, bar_index)
        // Cap: drop the oldest NON-EQ gap beyond the limit. A gap behind an EQH/EQL
        // (liquidity) is exempt when eqExemptFvg is on, so it persists until mitigated.
        // ── THE CAP COUNTS NON-EQ GAPS ONLY (Aaron, 2026-08-03) ──
        // The exemption used to be a SWAP, not an addition, and that made it self-cancelling.
        // The cap was measured over EVERY gap while the drop scan skipped the exempt ones, so an
        // EQ-backed gap held a slot: keeping it evicted the newest ordinary gap in its place.
        // Measured on 40,000 real M15 bars, that is exactly what it did — the A+ bot lost 2 setups
        // and gained none, because the gaps it protected cost it the gaps it would have traded.
        // So `fvgMaxCount` now bounds the ORDINARY gaps only and an exempt gap rides ON TOP of
        // them. The count is what a reader already assumes it is: seven recent gaps, plus however
        // many are pinned by resting liquidity, each living until price mitigates it.
        // ⚠ The live total is therefore UNBOUNDED by this input — it is bounded by the EQ engine
        // instead (eqMax levels per side, each dying on a close through it). That is the intended
        // trade: the cap exists to stop clutter, and a gap backed by a live liquidity pool is the
        // opposite of clutter. Turn eqExemptFvg OFF to get the plain FIFO back.
        // TWO exemptions now, and they compose: a gap is protected if it is backed by an
        // EQ pool OR it is sitting in the live entry band on the trade's side. Both must be
        // applied to BOTH loops — the count and the drop scan — or the bug the note above
        // describes comes straight back, with a protected gap holding a slot and evicting
        // an ordinary one in its place.
        int _nonEq = 0
        if array.size(fvgBoxes) > 0
            for _di = 0 to array.size(fvgBoxes) - 1
                if not ((eqExemptFvg and f_fvgNearEq(array.get(fvgTops, _di), array.get(fvgBots, _di), eqTol)) or f_fvgZoneKeep(array.get(fvgTops, _di), array.get(fvgBots, _di), array.get(fvgIsBull, _di)))
                    _nonEq += 1
        while _nonEq > fvgMaxCount
            int _dropIdx = -1
            for _di = 0 to array.size(fvgBoxes) - 1
                if not ((eqExemptFvg and f_fvgNearEq(array.get(fvgTops, _di), array.get(fvgBots, _di), eqTol)) or f_fvgZoneKeep(array.get(fvgTops, _di), array.get(fvgBots, _di), array.get(fvgIsBull, _di)))
                    _dropIdx := _di
                    break
            if _dropIdx == -1
                break
            box.delete(array.get(fvgBoxes, _dropIdx))
            array.remove(fvgBoxes, _dropIdx)
            array.remove(fvgTops, _dropIdx)
            array.remove(fvgBots, _dropIdx)
            array.remove(fvgIsBull, _dropIdx)
            array.remove(fvgBorn, _dropIdx)
            _nonEq -= 1

    // ── Extend live gaps, delete tapped ones, apply directional visibility ──
    if showFVG and array.size(fvgBoxes) > 0
        for i = array.size(fvgBoxes) - 1 to 0
            bool  isBull = array.get(fvgIsBull, i)
            float gTop   = array.get(fvgTops, i)
            float gBot   = array.get(fvgBots, i)
            // Mitigated = a candle CLOSES fully past the gap (through its far edge):
            // a bull gap dies only on a close at/below its bottom, a bear gap on a
            // close at/above its top — a mere wick into the gap no longer removes it.
            // Decided on the confirmed close so a live intrabar print can't delete it,
            // and skipped on the creation bar itself.
            bool closedPast = barstate.isconfirmed and bar_index > array.get(fvgBorn, i) and (isBull ? close <= gBot : close >= gTop)
            if closedPast
                box.delete(array.get(fvgBoxes, i))
                array.remove(fvgBoxes, i)
                array.remove(fvgTops, i)
                array.remove(fvgBots, i)
                array.remove(fvgIsBull, i)
                array.remove(fvgBorn, i)
            else
                box fb = array.get(fvgBoxes, i)
                box.set_right(fb, bar_index)
                // Directional filter: hide misaligned gaps (st.dir 0 = undecided, show all).
                // A gap behind an EQH/EQL is exempt — kept visible as liquidity confluence.
                bool nearEq  = eqExemptFvg and f_fvgNearEq(gTop, gBot, eqTol)
                // The FVG-only bias filter — the trade's own leg, not the chart's structure.
                // ANDed on TOP of everything, with no EQ exemption, so "only gaps with bias"
                // is literally true. `fvgBiasDir == 0` means no fib is live yet, and an
                // undecided direction must show everything rather than hide the chart.
                bool biasOk  = not fvgBiasInput or fvgBiasDir == 0 or isBull == (fvgBiasDir == 1)
                // drawFVG first — the toggle hides every gap; detection above still ran.
                bool visible = drawFVG and biasOk and (nearEq or not fvgDirOnly or st.dir == 0 or (isBull ? st.dir == 1 : st.dir == -1))
                box.set_bgcolor(fb, visible ? (isBull ? fvgBullColor : fvgBearColor) : color(na))
                box.set_text_color(fb, visible ? (isBull ? color.new(color.green, 0) : color.new(color.red, 0)) : color(na))
    int _ret = 0
f_processFvg()

//============================================================
  // RSI DIVERGENCE — regular divergence at the extremes
//============================================================
// Bullish: price prints a LOWER low while RSI prints a HIGHER low, with the RSI
// low coming from oversold. Bearish is the mirror from overbought. Pivots are
// confirmed divPivotLen bars after the extreme (non-repainting by design).
float divRsi = ta.rsi(close, divRsiLen)
float divPlRsi = ta.pivotlow(divRsi, divPivotLen, divPivotLen)
float divPhRsi = ta.pivothigh(divRsi, divPivotLen, divPivotLen)

var float divPrevRsiLow    = na
var float divPrevPriceLow  = na
var int   divPrevLowBar    = na
var float divPrevRsiHigh   = na
var float divPrevPriceHigh = na
var int   divPrevHighBar   = na
var int   lastBullDivBar   = na
var int   lastBearDivBar   = na
var array<line>  bullDivLines  = array.new<line>()
var array<label> bullDivLabels = array.new<label>()
var array<line>  bearDivLines  = array.new<line>()
var array<label> bearDivLabels = array.new<label>()

if showDiv and not na(divPlRsi)
    float _pLow = low[divPivotLen]
    int   _pBar = bar_index - divPivotLen
    bool  _divRecent = showDivHistory or time[divPivotLen] >= time - 259200000
    if not na(divPrevRsiLow) and _divRecent
        // Lower low in price, higher low in RSI, from the oversold extreme
        if _pLow < divPrevPriceLow and divPlRsi > divPrevRsiLow and math.min(divPlRsi, divPrevRsiLow) <= divOS
            lastBullDivBar := _pBar
            array.push(bullDivLines, line.new(divPrevLowBar, divPrevPriceLow, _pBar, _pLow, color = DIV_BULL_COL, style = line.style_dotted, width = 2))
            array.push(bullDivLabels, label.new(_pBar, _pLow, "\nBull Div", color = color(na), textcolor = DIV_BULL_COL, style = label.style_label_up, size = size.tiny))
            // Cap: drop the oldest marker once past the limit — nothing here is
            // deleted for being "stale," only for exceeding the display cap.
            if array.size(bullDivLines) > divMaxCount
                line.delete(array.shift(bullDivLines))
                label.delete(array.shift(bullDivLabels))
    divPrevRsiLow   := divPlRsi
    divPrevPriceLow := _pLow
    divPrevLowBar   := _pBar

if showDiv and not na(divPhRsi)
    float _pHigh = high[divPivotLen]
    int   _pBar  = bar_index - divPivotLen
    bool  _divRecentH = showDivHistory or time[divPivotLen] >= time - 259200000
    if not na(divPrevRsiHigh) and _divRecentH
        // Higher high in price, lower high in RSI, from the overbought extreme
        if _pHigh > divPrevPriceHigh and divPhRsi < divPrevRsiHigh and math.max(divPhRsi, divPrevRsiHigh) >= divOB
            lastBearDivBar := _pBar
            array.push(bearDivLines, line.new(divPrevHighBar, divPrevPriceHigh, _pBar, _pHigh, color = DIV_BEAR_COL, style = line.style_dotted, width = 2))
            array.push(bearDivLabels, label.new(_pBar, _pHigh, "Bear Div\n", color = color(na), textcolor = DIV_BEAR_COL, style = label.style_label_down, size = size.tiny))
            if array.size(bearDivLines) > divMaxCount
                line.delete(array.shift(bearDivLines))
                label.delete(array.shift(bearDivLabels))
    divPrevRsiHigh   := divPhRsi
    divPrevPriceHigh := _pHigh
    divPrevHighBar   := _pBar

// Live confluence flags for the A+ setup row
// Divergence relevance is tied to structure, not just a bar count. A divergence
// that fired several legs ago — with BOS/SOS events since — is stale even if
// still within the bar window: price has already moved on, and citing it as a
// veto reason (e.g. an old bullish divergence from the bottom blocking a fresh
// short at a NEW top with its own current bearish divergence) is misleading.
// So a divergence stays live only until the NEXT external break after it fired,
// with the bar count as an outer safety cap on top of that.
var int lastExtBreakBar = na
if extBreakThisBar
    lastExtBreakBar := bar_index

// A divergence stays LIVE only until the next external break after it fired, with a
// bar count as an outer cap. Read by the CONT setup ONLY: on a with-trend continuation
// a fresh OPPOSING divergence is real reversal risk, so it vetoes the entry. The REV
// setup deliberately NEVER reads these — a divergence at a reversal is part of that
// trade's own confirmation, not a reason to distrust it, so an opposing div can never
// block, warn on, or kill a REV setup at any stage.
// DISABLED 2026-07-22 with CONT — the CONT veto was the ONLY reader of these two
// (the REV setup deliberately never consults them, per the note above), so with CONT
// off they compute nothing anyone looks at. lastExtBreakBar just above feeds only
// these, and is left in place because it is one cheap assignment and the divergence
// drawing still needs the break tracking conceptually. Restore both lines with the
// CONT veto.
// bool bullDivActive = not na(lastBullDivBar) and (na(lastExtBreakBar) or lastExtBreakBar <= lastBullDivBar) and bar_index - lastBullDivBar <= 300
// bool bearDivActive = not na(lastBearDivBar) and (na(lastExtBreakBar) or lastExtBreakBar <= lastBearDivBar) and bar_index - lastBearDivBar <= 300


var array<SessionInfo> sessionInfos = getSessionInfos()
if showSessions and timeframe.isintraday and withinSessionDays
    for info in sessionInfos
        info.update()

//============================================================
  // DAILY LEVELS
//============================================================
var line  d_hLine  = na, var line  d_lLine  = na
var label d_hLbl   = na, var label d_lLbl   = na
var float d_hPrice = na, var float d_lPrice = na
var bool  d_hMit   = false, var bool  d_lMit = false
var int   d_hMitBar = na, var int  d_lMitBar = na
var int   d_hBar   = na, var int   d_lBar   = na

if newDay and i_currentDayOnly and i_showLiquidity and not showMitLiq
    if d_hMit
        line.delete(d_hLine), label.delete(d_hLbl)
        d_hLine := na, d_hLbl := na
    if d_lMit
        line.delete(d_lLine), label.delete(d_lLbl)
        d_lLine := na, d_lLbl := na

if canShowDaily and hasDailyTimeChanged and (not _pdDayChart or barstate.isconfirmed)
    line.delete(d_hLine), line.delete(d_lLine)
    label.delete(d_hLbl), label.delete(d_lLbl)
    d_hBar   := _pdDayChart ? bar_index : f_originHigh(pdh, LIQ_ORIGIN_CAP)
    d_lBar   := _pdDayChart ? bar_index : f_originLow(pdl, LIQ_ORIGIN_CAP)
    d_hLine  := line.new(d_hBar, pdh, bar_index + i_lineExtend, pdh, color = i_dailyColor, style = line.style_solid, width = 1)
    d_lLine  := line.new(d_lBar, pdl,  bar_index + i_lineExtend, pdl,  color = i_dailyColor, style = line.style_solid, width = 1)
    d_hLbl   := label.new(bar_index + i_lineExtend, pdh + lblOff, f_labelText("PDH"), style = label.style_none, textcolor = i_dailyColor, size = f_liqSize(), textalign = text.align_left)
    d_lLbl   := label.new(bar_index + i_lineExtend, pdl  - lblOff, f_labelText("PDL"), style = label.style_none, textcolor = i_dailyColor, size = f_liqSize(), textalign = text.align_left)
    d_hPrice := pdh
    d_lPrice := pdl
    d_hMit   := false
    d_lMit   := false
    array.set(a_lastHighs, 0, pdh)
    array.set(a_lastLows,  0, pdl)

if not na(d_hLine)
    [newd_hMit, newd_hMitBar] = f_liqMitigate(d_hLine, d_hLbl, d_hMit, d_hMitBar, d_hBar, high > d_hPrice, i_dailyColor, i_isDailyEnabled, showMitLiq)
    d_hMit := newd_hMit
    d_hMitBar := newd_hMitBar

if not na(d_lLine)
    [newd_lMit, newd_lMitBar] = f_liqMitigate(d_lLine, d_lLbl, d_lMit, d_lMitBar, d_lBar, low < d_lPrice, i_dailyColor, i_isDailyEnabled, showMitLiq)
    d_lMit := newd_lMit
    d_lMitBar := newd_lMitBar

//============================================================
  // WEEKLY LEVELS
//============================================================
var line  w_hLine  = na, var line  w_lLine  = na
var label w_hLbl   = na, var label w_lLbl   = na
var float w_hPrice = na, var float w_lPrice = na
var bool  w_hMit   = false, var bool  w_lMit = false
var int   w_hMitBar = na, var int  w_lMitBar = na
var int   w_hBar   = na, var int   w_lBar   = na

if newDay and i_currentDayOnly and i_showLiquidity and not showMitLiq
    if w_hMit
        line.delete(w_hLine), label.delete(w_hLbl)
        w_hLine := na, w_hLbl := na
    if w_lMit
        line.delete(w_lLine), label.delete(w_lLbl)
        w_lLine := na, w_lLbl := na

if canShowWeekly and not na(pwh) and not na(pwl) and (not _pwWkChart or barstate.isconfirmed)
    if na(w_hPrice) or pwh != w_hPrice or pwl != w_lPrice
        line.delete(w_hLine), line.delete(w_lLine)
        label.delete(w_hLbl), label.delete(w_lLbl)
        w_hBar   := _pwWkChart ? bar_index : f_originHigh(pwh, LIQ_ORIGIN_CAP)
        w_lBar   := _pwWkChart ? bar_index : f_originLow(pwl, LIQ_ORIGIN_CAP)
        w_hLine  := line.new(w_hBar, pwh, bar_index + i_lineExtend, pwh, color = i_weeklyColor, style = line.style_solid, width = 1)
        w_lLine  := line.new(w_lBar, pwl,  bar_index + i_lineExtend, pwl,  color = i_weeklyColor, style = line.style_solid, width = 1)
        w_hLbl   := label.new(bar_index + i_lineExtend, pwh + lblOff, f_labelText("PWH"), style = label.style_none, textcolor = i_weeklyColor, size = f_liqSize(), textalign = text.align_left)
        w_lLbl   := label.new(bar_index + i_lineExtend, pwl  - lblOff, f_labelText("PWL"), style = label.style_none, textcolor = i_weeklyColor, size = f_liqSize(), textalign = text.align_left)
        w_hPrice := pwh
        w_lPrice := pwl
        w_hMit   := false
        w_lMit   := false
        array.set(a_lastHighs, 1, pwh)
        array.set(a_lastLows,  1, pwl)

if not na(w_hLine)
    [neww_hMit, neww_hMitBar] = f_liqMitigate(w_hLine, w_hLbl, w_hMit, w_hMitBar, w_hBar, close > w_hPrice, i_weeklyColor, i_isWeeklyEnabled, showMitLiq)
    w_hMit := neww_hMit
    w_hMitBar := neww_hMitBar

if not na(w_lLine)
    [neww_lMit, neww_lMitBar] = f_liqMitigate(w_lLine, w_lLbl, w_lMit, w_lMitBar, w_lBar, close < w_lPrice, i_weeklyColor, i_isWeeklyEnabled, showMitLiq)
    w_lMit := neww_lMit
    w_lMitBar := neww_lMitBar

//============================================================
  // PREVIOUS WEEKLY CLOSE (PWC)
//============================================================
var line  pwc_line  = na
var label pwc_lbl   = na
var float pwc_price = na
var int   pwc_bar   = na

if i_showPWC and i_showLiquidity and not na(pwcSecurity) and barstate.isconfirmed
    if na(pwc_price) or pwcSecurity != pwc_price
        if not na(pwc_line)
            line.delete(pwc_line)
        if not na(pwc_lbl)
            label.delete(pwc_lbl)
        pwc_price := pwcSecurity
        pwc_bar   := bar_index
        pwcCol    = not drawLiq ? color(na) : close >= pwc_price ? color.blue : color.red
        pwc_line  := line.new(pwc_bar, pwc_price, pwc_bar + i_lineExtend, pwc_price, color = pwcCol, style = line.style_solid, width = 1)
        pwc_lbl   := label.new(pwc_bar + i_lineExtend, pwc_price + lblOff, f_labelText("PWC"), style = label.style_none, textcolor = pwcCol, size = f_liqSize(), textalign = text.align_left)

if not na(pwc_line) and i_showPWC and i_showLiquidity
    pwcCol = not drawLiq ? color(na) : close >= pwc_price ? color.blue : color.red
    // Same x1 clamp as f_liqMitigate — PWC is redrawn only once a week, so on a low
    // timeframe its origin bar ages out of the historical buffer and any coordinate
    // write on the line would throw. See the note in f_liqMitigate.
    line.set_x1(pwc_line, math.max(pwc_bar, bar_index - LIQ_ORIGIN_CAP))
    line.set_color(pwc_line, pwcCol)
    line.set_x2(pwc_line, bar_index + i_lineExtend)
    label.set_textcolor(pwc_lbl, pwcCol)
    label.set_x(pwc_lbl, bar_index + i_lineExtend)

//============================================================
  // H4 LIQUIDITY SWEEP TRACKER
//============================================================
color H4_ACTIVE_COLOR = drawLiq ? #FF6B35 : color(na)
color H4_SWEPT_COLOR  = drawLiq ? color.new(#999999, 45) : color(na)

var float h4TrackHigh    = na
var float h4TrackLow     = na
var int   h4TrackHighBar = na
var int   h4TrackLowBar  = na
var line  h4HighLine     = na
var label h4HighLbl      = na
var line  h4LowLine      = na
var label h4LowLbl       = na
var bool  h4HighSwept    = false
var bool  h4LowSwept     = false
var label h4SSHLbl       = na
var label h4BSLLbl       = na

if i_showH4Sweep and i_showLiquidity and h4BarChanged and not na(h4PrevHigh) and not na(h4PrevLow)
    line.delete(h4HighLine),  line.delete(h4LowLine)
    label.delete(h4HighLbl), label.delete(h4LowLbl)
    label.delete(h4SSHLbl),  label.delete(h4BSLLbl)
    h4SSHLbl       := na
    h4BSLLbl       := na
    h4TrackHigh    := h4PrevHigh
    h4TrackLow     := h4PrevLow
    h4TrackHighBar := bar_index
    h4TrackLowBar  := bar_index
    h4HighSwept    := false
    h4LowSwept     := false
    h4HighLine := line.new(h4TrackHighBar, h4TrackHigh, bar_index + i_lineExtend, h4TrackHigh, color = H4_ACTIVE_COLOR, style = line.style_solid, width = 1)
    h4HighLbl  := label.new(bar_index + i_lineExtend, h4TrackHigh + lblOff, f_labelText("H4 H"), style = label.style_none, textcolor = H4_ACTIVE_COLOR, size = f_liqSize(), textalign = text.align_left)
    h4LowLine  := line.new(h4TrackLowBar,  h4TrackLow,  bar_index + i_lineExtend, h4TrackLow,  color = H4_ACTIVE_COLOR, style = line.style_solid, width = 1)
    h4LowLbl   := label.new(bar_index + i_lineExtend, h4TrackLow  - lblOff, f_labelText("H4 L"), style = label.style_none, textcolor = H4_ACTIVE_COLOR, size = f_liqSize(), textalign = text.align_left)

if not na(h4HighLine) and i_showH4Sweep and i_showLiquidity
    if not h4HighSwept and high > h4TrackHigh and barstate.isconfirmed
        h4HighSwept := true
        h4SSHLbl    := na
    h4HCol = h4HighSwept ? H4_SWEPT_COLOR : H4_ACTIVE_COLOR
    line.set_color(h4HighLine, h4HCol)
    line.set_style(h4HighLine, h4HighSwept ? line.style_dotted : line.style_solid)
    line.set_x2(h4HighLine, bar_index + i_lineExtend)
    label.set_textcolor(h4HighLbl, h4HCol)
    label.set_x(h4HighLbl, bar_index + i_lineExtend)

if not na(h4LowLine) and i_showH4Sweep and i_showLiquidity
    if not h4LowSwept and low < h4TrackLow and barstate.isconfirmed
        h4LowSwept := true
        h4BSLLbl   := na
    h4LCol = h4LowSwept ? H4_SWEPT_COLOR : H4_ACTIVE_COLOR
    line.set_color(h4LowLine, h4LCol)
    line.set_style(h4LowLine, h4LowSwept ? line.style_dotted : line.style_solid)
    line.set_x2(h4LowLine, bar_index + i_lineExtend)
    label.set_textcolor(h4LowLbl, h4LCol)
    label.set_x(h4LowLbl, bar_index + i_lineExtend)

//============================================================
  // SESSION H/L TRACKING
//============================================================
var float asiaHigh = na, var float asiaLow = na
var float londonHigh = na, var float londonLow = na
var float nyHigh = na, var float nyLow = na
var line  asiaHLine = na, var line  asiaLLine = na
var label asiaHLbl  = na, var label asiaLLbl  = na
var bool  asiaHMit = false, var bool  asiaLMit = false
var int   asiaHMitBar = na, var int  asiaLMitBar = na
var float asiaHPrice = na, var float asiaLPrice = na
var int   asiaHBar = na, var int   asiaLBar = na
var line  londonHLine = na, var line  londonLLine = na
var label londonHLbl  = na, var label londonLLbl  = na
var bool  londonHMit = false, var bool  londonLMit = false
var int   londonHMitBar = na, var int  londonLMitBar = na
var float londonHPrice = na, var float londonLPrice = na
var int   londonHBar = na, var int   londonLBar = na
var line  nyHLine = na, var line  nyLLine = na
var label nyHLbl  = na, var label nyLLbl  = na
var bool  nyHMit = false, var bool  nyLMit = false
var int   nyHMitBar = na, var int  nyLMitBar = na
var float nyHPrice = na, var float nyLPrice = na
var int   nyHBar = na, var int   nyLBar = na

if newDay and i_currentDayOnly and i_showLiquidity and not showMitLiq
    if asiaHMit
        line.delete(asiaHLine), label.delete(asiaHLbl)
        asiaHLine := na, asiaHLbl := na
    if asiaLMit
        line.delete(asiaLLine), label.delete(asiaLLbl)
        asiaLLine := na, asiaLLbl := na
    if londonHMit
        line.delete(londonHLine), label.delete(londonHLbl)
        londonHLine := na, londonHLbl := na
    if londonLMit
        line.delete(londonLLine), label.delete(londonLLbl)
        londonLLine := na, londonLLbl := na
    if nyHMit
        line.delete(nyHLine), label.delete(nyHLbl)
        nyHLine := na, nyHLbl := na
    if nyLMit
        line.delete(nyLLine), label.delete(nyLLbl)
        nyLLine := na, nyLLbl := na

if inAsia
    asiaHigh := (not inAsia[1]) ? high : math.max(asiaHigh, high)
    asiaLow  := (not inAsia[1]) ? low  : math.min(asiaLow,  low)
if inLondon
    londonHigh := (not inLondon[1]) ? high : math.max(londonHigh, high)
    londonLow  := (not inLondon[1]) ? low  : math.min(londonLow,  low)
if inNY
    nyHigh := (not inNY[1]) ? high : math.max(nyHigh, high)
    nyLow  := (not inNY[1]) ? low  : math.min(nyLow,  low)

if not inAsia and inAsia[1] and i_showAsiaHL and i_showLiquidity and not na(asiaHigh)
    line.delete(asiaHLine), line.delete(asiaLLine)
    label.delete(asiaHLbl), label.delete(asiaLLbl)
    asiaHBar   := f_originHigh(asiaHigh, LIQ_ORIGIN_CAP)
    asiaLBar   := f_originLow(asiaLow, LIQ_ORIGIN_CAP)
    asiaHLine  := line.new(asiaHBar, asiaHigh, bar_index + i_lineExtend, asiaHigh, color = i_asiaHLColor, style = line.style_solid, width = 1)
    asiaLLine  := line.new(asiaLBar, asiaLow,  bar_index + i_lineExtend, asiaLow,  color = i_asiaHLColor, style = line.style_solid, width = 1)
    asiaHLbl   := label.new(bar_index + i_lineExtend, asiaHigh + lblOff, f_labelText("Asia H"), style = label.style_none, textcolor = i_asiaHLColor, size = f_liqSize(), textalign = text.align_left)
    asiaLLbl   := label.new(bar_index + i_lineExtend, asiaLow  - lblOff, f_labelText("Asia L"), style = label.style_none, textcolor = i_asiaHLColor, size = f_liqSize(), textalign = text.align_left)
    asiaHPrice := asiaHigh
    asiaLPrice := asiaLow
    asiaHMit   := false
    asiaLMit   := false

if not inLondon and inLondon[1] and i_showLondonHL and i_showLiquidity and not na(londonHigh)
    line.delete(londonHLine), line.delete(londonLLine)
    label.delete(londonHLbl), label.delete(londonLLbl)
    londonHBar   := f_originHigh(londonHigh, LIQ_ORIGIN_CAP)
    londonLBar   := f_originLow(londonLow, LIQ_ORIGIN_CAP)
    londonHLine  := line.new(londonHBar, londonHigh, bar_index + i_lineExtend, londonHigh, color = i_londonHLColor, style = line.style_solid, width = 1)
    londonLLine  := line.new(londonLBar, londonLow,  bar_index + i_lineExtend, londonLow,  color = i_londonHLColor, style = line.style_solid, width = 1)
    londonHLbl   := label.new(bar_index + i_lineExtend, londonHigh + lblOff, f_labelText("Ldn H"), style = label.style_none, textcolor = i_londonHLColor, size = f_liqSize(), textalign = text.align_left)
    londonLLbl   := label.new(bar_index + i_lineExtend, londonLow  - lblOff, f_labelText("Ldn L"), style = label.style_none, textcolor = i_londonHLColor, size = f_liqSize(), textalign = text.align_left)
    londonHPrice := londonHigh
    londonLPrice := londonLow
    londonHMit   := false
    londonLMit   := false

if not inNY and inNY[1] and i_showNYHL and i_showLiquidity and not na(nyHigh)
    line.delete(nyHLine), line.delete(nyLLine)
    label.delete(nyHLbl), label.delete(nyLLbl)
    nyHBar   := f_originHigh(nyHigh, LIQ_ORIGIN_CAP)
    nyLBar   := f_originLow(nyLow, LIQ_ORIGIN_CAP)
    nyHLine  := line.new(nyHBar, nyHigh, bar_index + i_lineExtend, nyHigh, color = i_nyHLColor, style = line.style_solid, width = 1)
    nyLLine  := line.new(nyLBar, nyLow,  bar_index + i_lineExtend, nyLow,  color = i_nyHLColor, style = line.style_solid, width = 1)
    nyHLbl   := label.new(bar_index + i_lineExtend, nyHigh + lblOff, f_labelText("NY H"), style = label.style_none, textcolor = i_nyHLColor, size = f_liqSize(), textalign = text.align_left)
    nyLLbl   := label.new(bar_index + i_lineExtend, nyLow  - lblOff, f_labelText("NY L"), style = label.style_none, textcolor = i_nyHLColor, size = f_liqSize(), textalign = text.align_left)
    nyHPrice := nyHigh
    nyLPrice := nyLow
    nyHMit   := false
    nyLMit   := false

if not na(asiaHLine)
    [newasiaHMit, newasiaHMitBar] = f_liqMitigate(asiaHLine, asiaHLbl, asiaHMit, asiaHMitBar, asiaHBar, high > asiaHPrice, i_asiaHLColor, i_showAsiaHL, showMitLiq)
    asiaHMit := newasiaHMit
    asiaHMitBar := newasiaHMitBar

if not na(asiaLLine)
    [newasiaLMit, newasiaLMitBar] = f_liqMitigate(asiaLLine, asiaLLbl, asiaLMit, asiaLMitBar, asiaLBar, low < asiaLPrice, i_asiaHLColor, i_showAsiaHL, showMitLiq)
    asiaLMit := newasiaLMit
    asiaLMitBar := newasiaLMitBar

if not na(londonHLine)
    [newlondonHMit, newlondonHMitBar] = f_liqMitigate(londonHLine, londonHLbl, londonHMit, londonHMitBar, londonHBar, high > londonHPrice, i_londonHLColor, i_showLondonHL, showMitLiq)
    londonHMit := newlondonHMit
    londonHMitBar := newlondonHMitBar

if not na(londonLLine)
    [newlondonLMit, newlondonLMitBar] = f_liqMitigate(londonLLine, londonLLbl, londonLMit, londonLMitBar, londonLBar, low < londonLPrice, i_londonHLColor, i_showLondonHL, showMitLiq)
    londonLMit := newlondonLMit
    londonLMitBar := newlondonLMitBar

if not na(nyHLine)
    [newnyHMit, newnyHMitBar] = f_liqMitigate(nyHLine, nyHLbl, nyHMit, nyHMitBar, nyHBar, high > nyHPrice, i_nyHLColor, i_showNYHL, showMitLiq)
    nyHMit := newnyHMit
    nyHMitBar := newnyHMitBar

if not na(nyLLine)
    [newnyLMit, newnyLMitBar] = f_liqMitigate(nyLLine, nyLLbl, nyLMit, nyLMitBar, nyLBar, low < nyLPrice, i_nyHLColor, i_showNYHL, showMitLiq)
    nyLMit := newnyLMit
    nyLMitBar := newnyLMitBar

//============================================================
  // LABEL COLLISION DETECTION
//============================================================
if i_showLiquidity and i_showLabels
    liq_y   = array.new_float()
    liq_lbl = array.new_label()

    if not na(d_hLbl)     and i_isDailyEnabled
        array.push(liq_y, d_hPrice + lblOff),    array.push(liq_lbl, d_hLbl)
    if not na(w_hLbl)     and i_isWeeklyEnabled
        array.push(liq_y, w_hPrice + lblOff),    array.push(liq_lbl, w_hLbl)
    if not na(pwc_lbl)    and i_showPWC
        array.push(liq_y, pwc_price + lblOff),   array.push(liq_lbl, pwc_lbl)
    if not na(h4HighLbl)  and i_showH4Sweep
        array.push(liq_y, h4TrackHigh + lblOff), array.push(liq_lbl, h4HighLbl)
    if not na(asiaHLbl)   and i_showAsiaHL
        array.push(liq_y, asiaHPrice + lblOff),  array.push(liq_lbl, asiaHLbl)
    if not na(londonHLbl) and i_showLondonHL
        array.push(liq_y, londonHPrice + lblOff),array.push(liq_lbl, londonHLbl)
    if not na(nyHLbl)     and i_showNYHL
        array.push(liq_y, nyHPrice + lblOff),    array.push(liq_lbl, nyHLbl)

    if not na(d_lLbl)     and i_isDailyEnabled
        array.push(liq_y, d_lPrice - lblOff),    array.push(liq_lbl, d_lLbl)
    if not na(w_lLbl)     and i_isWeeklyEnabled
        array.push(liq_y, w_lPrice - lblOff),    array.push(liq_lbl, w_lLbl)
    if not na(h4LowLbl)   and i_showH4Sweep
        array.push(liq_y, h4TrackLow - lblOff),  array.push(liq_lbl, h4LowLbl)
    if not na(asiaLLbl)   and i_showAsiaHL
        array.push(liq_y, asiaLPrice - lblOff),  array.push(liq_lbl, asiaLLbl)
    if not na(londonLLbl) and i_showLondonHL
        array.push(liq_y, londonLPrice - lblOff),array.push(liq_lbl, londonLLbl)
    if not na(nyLLbl)     and i_showNYHL
        array.push(liq_y, nyLPrice - lblOff),    array.push(liq_lbl, nyLLbl)

    n = array.size(liq_y)
    if n > 1
        sortIdx = array.sort_indices(liq_y, order.ascending)
        float prevY = array.get(liq_y, array.get(sortIdx, 0))
        label.set_y(array.get(liq_lbl, array.get(sortIdx, 0)), prevY)
        for i = 1 to n - 1
            idx   = array.get(sortIdx, i)
            baseY = array.get(liq_y, idx)
            adjY  = math.max(baseY, prevY + lblOff)
            label.set_y(array.get(liq_lbl, idx), adjY)
            prevY := adjY
    else if n == 1
        label.set_y(array.get(liq_lbl, 0), array.get(liq_y, 0))

//============================================================
  // NY RANGE BOX
//============================================================
f_processNyRange() =>
    var line  nyr_lowHLine = na, var line  nyr_topHLine = na
    var line  nyr_leftVLine = na, var line  nyr_rightVLine = na
    var line  nyr_middleHLine = na
    var box   nyr_bgBox = na
    var float nyr_low_val = na, var float nyr_high_val = na

    if showNYRange
        if inSession5 and not inSession5[1] and isMondayToFriday and withinNYRangeDays
            nyr_low_val  := low5
            nyr_high_val := high5
        if inSession5 and isMondayToFriday and withinNYRangeDays
            // ── THE DELETE IS UNCONDITIONAL NOW (Aaron, 2026-08-05) ──
            // It used to be guarded by `if inSession5[1]` — "only if we were already in
            // the session last bar" — which skipped it on the FIRST bar of the window
            // while the six lines below reassigned every handle anyway. Yesterday's box
            // and lines were then unreferenced and could never be deleted by anything:
            // they stayed on the chart until TradingView evicted them at max_lines_count,
            // which is roughly eighty days of them.
            // Worse on a 5m chart, where the whole 0930-0935 window is ONE bar, so
            // `inSession5[1]` is never true and this delete never ran at all.
            // Deleting an `na` handle is a no-op in Pine, so dropping the guard costs
            // nothing on the first bar and closes the leak on every later one.
            line.delete(nyr_lowHLine),  line.delete(nyr_topHLine)
            line.delete(nyr_leftVLine), line.delete(nyr_rightVLine)
            line.delete(nyr_middleHLine)
            box.delete(nyr_bgBox)
            if low5 < nyr_low_val
                nyr_low_val := low5
            if high5 > nyr_high_val
                nyr_high_val := high5
            nyr_bgBox       := box.new(left = nyr_startTime, top = nyr_high_val, right = time, bottom = nyr_low_val, xloc = xloc.bar_time, bgcolor = color.new(color.blue, 80), border_color = color.blue, border_width = 2, border_style = line.style_solid)
            nyr_lowHLine    := line.new(nyr_startTime, nyr_low_val,  time, nyr_low_val,  xloc = xloc.bar_time, color = color.blue, style = line.style_solid, width = 2)
            nyr_topHLine    := line.new(nyr_startTime, nyr_high_val, time, nyr_high_val, xloc = xloc.bar_time, color = color.blue, style = line.style_solid, width = 2)
            nyr_leftVLine   := line.new(nyr_startTime, nyr_high_val, nyr_startTime, nyr_low_val, xloc = xloc.bar_time, color = color.blue, style = line.style_solid, width = 2)
            nyr_rightVLine  := line.new(time, nyr_high_val, time, nyr_low_val, xloc = xloc.bar_time, color = color.blue, style = line.style_solid, width = 2)
            nyr_middleHLine := line.new(nyr_startTime, (nyr_high_val + nyr_low_val) / 2, time, (nyr_high_val + nyr_low_val) / 2, xloc = xloc.bar_time, color = color.red, style = line.style_dotted, width = 2)
        if inExtend5 and not inSession5 and isMondayToFriday and withinNYRangeDays
            if not na(nyr_lowHLine)
                t1 = line.get_x1(nyr_lowHLine), p = line.get_y1(nyr_lowHLine)
                line.delete(nyr_lowHLine)
                nyr_lowHLine := line.new(t1, p, time, p, xloc = xloc.bar_time, color = color.blue, style = line.style_solid, width = 2)
            if not na(nyr_topHLine)
                t1 = line.get_x1(nyr_topHLine), p = line.get_y1(nyr_topHLine)
                line.delete(nyr_topHLine)
                nyr_topHLine := line.new(t1, p, time, p, xloc = xloc.bar_time, color = color.blue, style = line.style_solid, width = 2)
            if not na(nyr_middleHLine)
                t1 = line.get_x1(nyr_middleHLine), p = line.get_y1(nyr_middleHLine)
                line.delete(nyr_middleHLine)
                nyr_middleHLine := line.new(t1, p, time, p, xloc = xloc.bar_time, color = color.red, style = line.style_dotted, width = 2)
    // ── AND IT IS WIPED WHEN THE DAY ENDS (Aaron, 2026-08-05) ──
    // Nothing here ever removed the range. It was only ever deleted from inside the
    // 0930-0935 block above, so after 16:00 NY the box, both verticals, the high/low
    // lines and the red midline simply stopped being touched and sat on the chart
    // through the overnight session and all of the next London — until 09:30 the
    // following morning. That is the "still there when a new day starts" complaint.
    // `inExtend5` bounds the NY day (0935-1600), so its falling edge IS the end of the
    // day and is the honest moment to clear a level that only described that day.
    // ⚠ Deliberately OUTSIDE `if showNYRange`, unlike everything above it. Switching the
    // tool off mid-session used to leave the drawing behind for the same reason — the
    // only delete lived on a path the toggle had already closed. The na guard is what
    // stops this firing on every bar once it has run.
    bool nyrEnded = (not inExtend5 and inExtend5[1]) or (not showNYRange and not na(nyr_bgBox))
    if nyrEnded
        line.delete(nyr_lowHLine),  line.delete(nyr_topHLine)
        line.delete(nyr_leftVLine), line.delete(nyr_rightVLine)
        line.delete(nyr_middleHLine)
        box.delete(nyr_bgBox)
        nyr_lowHLine    := na, nyr_topHLine   := na
        nyr_leftVLine   := na, nyr_rightVLine := na
        nyr_middleHLine := na, nyr_bgBox      := na
        nyr_low_val     := na, nyr_high_val   := na
    int _ret = 0
f_processNyRange()

//============================================================
  // KILL ZONES
//============================================================
nyHour   = hour(time,   "America/New_York")
nyMinute = minute(time, "America/New_York")

inKZ1 = nyHour == 10
inKZ2 = (nyHour == 11 and nyMinute >= 45) or (nyHour == 12 and nyMinute <= 14)
inKZ3 = nyHour == 13 and nyMinute <= 30

f_processKillZones() =>
    isToday = year(time,       "America/New_York") == year(timenow,       "America/New_York") and
              month(time,      "America/New_York") == month(timenow,      "America/New_York") and
              dayofmonth(time, "America/New_York") == dayofmonth(timenow, "America/New_York")

    var box[] kz1Boxes = array.new_box()
    var box[] kz2Boxes = array.new_box()
    var box[] kz3Boxes = array.new_box()
    var bool  kz1Started = false, var bool  kz2Started = false, var bool  kz3Started = false

    var box  kz1TodayBox = na
    var box  kz2TodayBox = na
    var box  kz3TodayBox = na

    // The start-of-zone arrows are GONE (Aaron, 2026-07-30). They were green triangles
    // above the bar that opened each zone; the shaded box already says where the zone
    // is, so they only added clutter. size.tiny was already Pine's smallest label size,
    // so "smaller" was not available — removing them was.
    // History worth keeping: they were plotshape() until 2026-07-29, which is why they
    // used to outlive their kill zone — a plotshape is a series plot with no handle and
    // cannot be deleted, so the box vanished on schedule and the triangle stayed behind
    // on a chart with nothing under it. Converting them to labels is what made them
    // deletable, and is why they could simply be dropped here.

    var bool kz1TodayDeleted = false
    var bool kz2TodayDeleted = false
    var bool kz3TodayDeleted = false

    if newDay
        kz1Started        := false
        kz2Started        := false
        kz3Started        := false
        kz1TodayDeleted   := false
        kz2TodayDeleted   := false
        kz3TodayDeleted   := false
        kz1TodayBox       := na
        kz2TodayBox       := na
        kz3TodayBox       := na

    kzBgColor     = color.new(color.green, 90)
    kzBorderColor = color.new(color.green, 70)

    if showKillZones
        if inKZ1 and withinKZDays and not kz1Started
            kz1Started := true
            newKZ1 = box.new(bar_index, dailyHigh, bar_index + 1, dailyLow, bgcolor = kzBgColor, border_color = kzBorderColor)
            array.push(kz1Boxes, newKZ1)
            if isToday
                kz1TodayBox := newKZ1
        if inKZ1 and withinKZDays and array.size(kz1Boxes) > 0
            box.set_right(array.last(kz1Boxes), bar_index + 1)

        if inKZ2 and withinKZDays and not kz2Started
            kz2Started := true
            newKZ2 = box.new(bar_index, dailyHigh, bar_index + 1, dailyLow, bgcolor = kzBgColor, border_color = kzBorderColor)
            array.push(kz2Boxes, newKZ2)
            if isToday
                kz2TodayBox := newKZ2
        if inKZ2 and withinKZDays and array.size(kz2Boxes) > 0
            box.set_right(array.last(kz2Boxes), bar_index + 1)

        if inKZ3 and withinKZDays and not kz3Started
            kz3Started := true
            newKZ3 = box.new(bar_index, dailyHigh, bar_index + 1, dailyLow, bgcolor = kzBgColor, border_color = kzBorderColor)
            array.push(kz3Boxes, newKZ3)
            if isToday
                kz3TodayBox := newKZ3
        if inKZ3 and withinKZDays and array.size(kz3Boxes) > 0
            box.set_right(array.last(kz3Boxes), bar_index + 1)

    // Today's zone is wiped a few minutes after it closes so the live chart is not
    // cluttered by a window that has already passed. With history ON the user is
    // asking to SEE every zone, and today is a day like any other — so the wipe is
    // switched off, otherwise the one day you are trading is the only one missing.
    if isToday and not kz1TodayDeleted and showKillZones and not showKZHistoric
        if nyHour > 11 or (nyHour == 11 and nyMinute >= 5)
            if not na(kz1TodayBox)
                box.delete(kz1TodayBox)
                kz1TodayBox := na
            kz1TodayDeleted := true

    if isToday and not kz2TodayDeleted and showKillZones and not showKZHistoric
        if nyHour > 12 or (nyHour == 12 and nyMinute >= 20)
            if not na(kz2TodayBox)
                box.delete(kz2TodayBox)
                kz2TodayBox := na
            kz2TodayDeleted := true

    if isToday and not kz3TodayDeleted and showKillZones and not showKZHistoric
        if nyHour > 13 or (nyHour == 13 and nyMinute >= 35)
            if not na(kz3TodayBox)
                box.delete(kz3TodayBox)
                kz3TodayBox := na
            kz3TodayDeleted := true
    int _ret = 0
f_processKillZones()


//============================================================
  // FIBONACCI DRAWING
//============================================================
var line  fibo1Line  = na,  var label fibo1Label  = na
var line  fibo2Line  = na,  var label fibo2Label  = na
var line  fibo3Line  = na,  var label fibo3Label  = na
var line  fibo4Line  = na,  var label fibo4Label  = na
var line  fibo5Line  = na,  var label fibo5Label  = na
var line  fibo6Line  = na,  var label fibo6Label  = na
var line  fibo7Line  = na,  var label fibo7Label  = na
var line  fibo10Line = na,  var label fibo10Label = na

var array<box>   sniperBoxArr    = array.new<box>()
var array<line>  sniper382Arr    = array.new<line>()
var array<line>  sniper50Arr     = array.new<line>()
var array<label> sniperLbl382Arr = array.new<label>()
var float        sniperZoneTop    = na
var float        sniperZoneBot    = na
var bool         sz_bullish       = true

var float fibo_ash     = na
var float fibo_asl     = na
var int   fibo_ash_loc = na
var int   fibo_asl_loc = na
var int   fibo_dir     = 0

// ── Touched tracking: each level goes grey until price reaches it ──
color FIBO_GREY  = color.new(#888888, 0)
color MACRO_GREY = color.new(#888888, 0)
var bool fiboOriginChanged = false
fiboOriginChanged := false   // reset every bar — only true on the specific bar origin changes
var bool fibo1Touched  = false
var bool fibo2Touched  = false
var bool fibo3Touched  = false
var bool fibo4Touched  = false
var bool fibo5Touched  = false
var bool fibo6Touched  = false
var bool fibo7Touched  = false
var bool fibo10Touched = false
var bool fibo618EverReached = false  // persists true once 0.618 was hit — gates TP checks from NEXT bar
var bool fiboResetActive    = false  // true once TP3 has been hit — suppresses drawing until the next new leg
// Inbound touch of the 0.5 level during the RETRACEMENT toward the entry zone —
// the A+ sequence's EARLY entry tier. Distinct from fibo2Touched, which tests the
// same price on the way back OUT (as TP1) and is gated behind 0.618.
var bool fiboHalfReached    = false

// Prices of each level (persistent so touched check works outside the draw block)
var float fiboP1  = na, var float fiboP2  = na, var float fiboP3  = na
var float fiboP4  = na, var float fiboP5  = na, var float fiboP6  = na
var float fiboP7  = na
var float fiboP10 = na
var int   fiboStartIndexPrev = na
var float fiboPrevAsh = na   // detects when the extending anchor (ash/asl) itself
var float fiboPrevAsl = na   // changed this bar — e.g. a live wick during pb_mode —
                              // so touched-checks (esp. TP3) don't self-trigger off it
var int   fiboStartIndex     = na   // persistent — accessible outside if showFibo block

if not na(st.ash)
    fibo_ash     := st.ash
    fibo_ash_loc := st.ash_loc
if not na(st.asl)
    fibo_asl     := st.asl
    fibo_asl_loc := st.asl_loc
if st.dir != 0
    fibo_dir := st.dir

if st.pb_mode == 1 and not na(st.pb_extreme)
    fibo_ash     := st.pb_extreme
    fibo_ash_loc := st.pb_extreme_loc
if st.pb_mode == -1 and not na(st.pb_extreme)
    fibo_asl     := st.pb_extreme
    fibo_asl_loc := st.pb_extreme_loc

// If an internal swing confirmed a more extreme point than the external anchor,
// adopt it for the fib pull only — nothing else about structure changes.
if fibo_dir == 1 and not na(i_confirmed_low_price) and not na(fibo_asl) and i_confirmed_low_price < fibo_asl
    fibo_asl     := i_confirmed_low_price
    fibo_asl_loc := i_confirmed_low_loc
if fibo_dir == -1 and not na(i_confirmed_high_price) and not na(fibo_ash) and i_confirmed_high_price > fibo_ash
    fibo_ash     := i_confirmed_high_price
    fibo_ash_loc := i_confirmed_high_loc

// Shared by External/Internal/Cycle fib: a level is "touched" once it has been
// reached, and stays touched thereafter.
f_checkTouch(bool touched, float lvl, bool breachCond) =>
    touched or (not na(lvl) and breachCond)

f_fiboLabel(float val, string tpLabel, string entryLabel) =>
    sharedLabelMode == "Both"        ? tpLabel + " " + str.tostring(val) + "  (" :
     sharedLabelMode == "TP/Entry"   ? tpLabel    + "  (" :
     str.tostring(val) + "  ("

// Shared by External/Internal/Cycle fib: creates a level's line+label on first use,
// updates them in place on later bars, or deletes+clears them when hidden/reset.
f_fibLevel(bool show, line lineId, label labelId, int x1, float y, int x2, color col, string lstyle, string txt) =>
    line  outLine  = lineId
    label outLabel = labelId
    if show
        if na(outLine)
            outLine  := line.new(x1, y, x2, y, xloc = xloc.bar_index, color = col, style = lstyle, width = 1)
            outLabel := label.new(x2 + 2, y, txt, style = label.style_none, textcolor = col, size = size.small, xloc = xloc.bar_index)
        else
            line.set_xy1(outLine, x1, y)
            line.set_xy2(outLine, x2, y)
            line.set_color(outLine, col)
            line.set_style(outLine, lstyle)
            label.set_xy(outLabel, x2 + 2, y)
            label.set_text(outLabel, txt)
            label.set_textcolor(outLabel, col)
    else
        if not na(outLine)
            line.delete(outLine)
            label.delete(outLabel)
            outLine  := na
            outLabel := na
    [outLine, outLabel]

// 1m external-fib alignment gate. On the 1m entry view the External Fib only prints
// once a SOS fires in the SAME direction as the 15m structure (m15Dir). A COUNTERING
// SOS (opposite the 15m) cancels it; the fib then waits for the next aligned SOS to
// reprint — the 1m can range and fire several SOS before one lines up. The
// fibo_dir == m15Dir guard also hides the fib if the 15m simply flips underneath it.
// No effect on any other timeframe (fiboShowAligned is always true off 1m).
bool _fibOneMin = timeframe.in_seconds() == 60
// GATE (1m only): the External Fib shows ONLY on the aligned-SOS leg — the 1m's current
// leg must have been opened by an SOS (a Shift) whose direction matches the 15m, while the
// 15m is ≥50% into its own leg. Three conditions:
   // • stMtfEv == 1  — the chart's own event classifier says the LAST 1m break was a Shift
     // (SOS), NOT an Expansion/Continuation (a BOS). This is STATE, not a latch: it stays 1
     // from the SOS through the whole retrace until the next break, then flips to 2 on the
     // first BOS — so the fib rides the SOS leg and vanishes the instant a continuation BOS
     // re-anchors. (Same value shown in the table's 1m row: "Shift" vs "Expansion".)
   // • fibo_dir == m15Dir — that SOS was in the 15m's direction (a bear SOS on a 15m short).
   // • _m15Retraced — the 15m has pulled back ≥50% into its leg (REV SETUP stage ≥ 3).
// Deriving from stMtfEv replaced the old oneMinFibArmed latch, which armed only on the exact
// SOS bar and got knocked off by every countering break — leaving a bearish-and-aligned 1m
// showing nothing. A BOS leg must NOT draw a fib (user); only the aligned SOS leg does.
bool _m15Retraced = rStage >= 3 and rDir == m15Dir
// The 1m SOS the fib rides must have CONFIRMED after the 15m SOS candle closed — so the
// fib never anchors to the impulse 1m SOS that mirrors (is the SAME move as) the 15m SOS.
// oneMinSosT = time of the latest 1m SOS on the chart; m15SosCloseT = close time of the
// latest 15m SOS from the security engine. Only a retrace SOS clears m15SosCloseT.
var int oneMinSosT = na
if _fibOneMin and (st.bull_sos or st.bear_sos)
    oneMinSosT := time
bool _1mAfter15 = not na(oneMinSosT) and not na(m15SosCloseT) and oneMinSosT > m15SosCloseT
bool fiboShowAligned = not _fibOneMin or (stMtfEv == 1 and fibo_dir == m15Dir and _m15Retraced and _1mAfter15)

if showFibo and not na(fibo_ash) and not na(fibo_asl) and fibo_dir != 0
    fiboRange      = fibo_ash - fibo_asl
    fiboStartIndex := fibo_dir == 1 ? fibo_asl_loc : fibo_ash_loc

    // Compute all level prices
    fiboP1  := fibo_dir == 1 ? fibo_ash - fiboRange * fibo1Value  : fibo_asl + fiboRange * fibo1Value
    fiboP2  := fibo_dir == 1 ? fibo_ash - fiboRange * fibo2Value  : fibo_asl + fiboRange * fibo2Value
    fiboP3  := fibo_dir == 1 ? fibo_ash - fiboRange * fibo3Value  : fibo_asl + fiboRange * fibo3Value
    fiboP4  := fibo_dir == 1 ? fibo_ash - fiboRange * fibo4Value  : fibo_asl + fiboRange * fibo4Value
    fiboP5  := fibo_dir == 1 ? fibo_ash - fiboRange * fibo5Value  : fibo_asl + fiboRange * fibo5Value
    fiboP6  := fibo_dir == 1 ? fibo_ash - fiboRange * fibo6Value  : fibo_asl + fiboRange * fibo6Value
    fiboP7  := fibo_dir == 1 ? fibo_ash - fiboRange * fibo7Value  : fibo_asl + fiboRange * fibo7Value
    fiboP10 := fibo_dir == 1 ? fibo_ash - fiboRange * fibo10Value : fibo_asl + fiboRange * fibo10Value

    // Reset touched flags when fib origin changes (new leg). MUST be ":=" — a plain
    // "=" declares a block-local shadow, leaving the GLOBAL fiboOriginChanged stuck
    // false, which silently disables the 1m Sniper-Zone orphan-delete (f_sniperExtend)
    // and the 1m REV reset — so the SZ lingers on the old leg after a re-anchoring BOS.
    fiboOriginChanged := fiboStartIndex != fiboStartIndexPrev
    if fiboOriginChanged
        fibo1Touched  := false
        fibo2Touched  := false
        fibo3Touched  := false
        fibo4Touched  := false
        fibo5Touched  := false
        fibo6Touched  := false
        fibo7Touched  := false
        fibo10Touched := false
        fibo618EverReached := false
        fiboResetActive    := false
        fiboHalfReached    := false
        i_confirmed_low_price  := na
        i_confirmed_low_loc    := na
        i_confirmed_high_price := na
        i_confirmed_high_loc   := na
    fiboStartIndexPrev := fiboStartIndex

    // Skip ALL touched checks on the same bar the origin changed, OR the same bar
    // the extending anchor (fibo_ash/fibo_asl) itself moved — that anchor tracks
    // live wicks during a pullback watch, not confirmed closes, so without this
    // guard a fresh wick-high can retroactively satisfy the very TP3 level it
    // just created, hiding the fib with no real BOS/SOS behind it.
    bool fiboExtChanged = (not na(fiboPrevAsh) and fibo_ash != fiboPrevAsh) or (not na(fiboPrevAsl) and fibo_asl != fiboPrevAsl)
    if not fiboOriginChanged and not fiboExtChanged
        // Gate: coloring only activates once 0.618 is reached.
        // fibo618EverReached is only set TRUE at the END of this block (after all checks run),
        // so TP level checks never fire on the same bar that 0.618 was first hit.
        bool fibo618Reached = fibo_dir == 1 ? low <= fiboP3 : high >= fiboP3

        // Inbound 0.5 touch — ungated; A+ EARLY entry tier as price retraces in
        fiboHalfReached := f_checkTouch(fiboHalfReached, fiboP2, fibo_dir == 1 ? low <= fiboP2 : high >= fiboP2)

        if fibo618Reached
            // 0.618 — mark itself on the bar it's first hit
            if not fibo3Touched
                fibo3Touched := true

            // E levels (deeper retracements) — fire immediately when price goes through them
            fibo4Touched  := f_checkTouch(fibo4Touched,  fiboP4,  fibo_dir == 1 ? low <= fiboP4  : high >= fiboP4)
            fibo5Touched  := f_checkTouch(fibo5Touched,  fiboP5,  fibo_dir == 1 ? low <= fiboP5  : high >= fiboP5)
            fibo6Touched  := f_checkTouch(fibo6Touched,  fiboP6,  fibo_dir == 1 ? low <= fiboP6  : high >= fiboP6)
            fibo10Touched := f_checkTouch(fibo10Touched, fiboP10, fibo_dir == 1 ? low <= fiboP10 : high >= fiboP10)

        // TP levels — only checked AFTER 0.618 has been hit on a PREVIOUS bar
        if fibo618EverReached
            fibo2Touched := f_checkTouch(fibo2Touched, fiboP2, fibo_dir == 1 ? high >= fiboP2 : low <= fiboP2)
            fibo1Touched := f_checkTouch(fibo1Touched, fiboP1, fibo_dir == 1 ? high >= fiboP1 : low <= fiboP1)
            fibo7Touched := f_checkTouch(fibo7Touched, fiboP7, fibo_dir == 1 ? high >= fiboP7 : low <= fiboP7)

        // Set persistent flag AFTER all checks — so TP checks only run from NEXT bar
        if fibo618Reached and not fibo618EverReached
            fibo618EverReached := true

    fiboPrevAsh := fibo_ash
    fiboPrevAsl := fibo_asl

    // Retire the 1m fib once its ENTRY job is done — whichever comes first:
    //   • fibo7Touched — price returned to the 1m 0.0/TP3 (the entry played out to the
    //     1m target), OR
    //   • rTp50 — the 15m reached its own 0.5/TP1 (the "bigger 1m fib" case: the entry
    //     window is closed, the 15m take-profits now own the trade).
    // fiboResetActive suppresses all 8 fib levels; it resets to false on a new leg
    // (origin change) above, so a fresh 1m SOS re-draws for a re-entry.
    if _fibOneMin and (fibo7Touched or rTp50)
        fiboResetActive := true

    // ── PUBLISH THE ENTRY BAND FOR THE FVG CAP (Aaron, 2026-08-05) ──
    // Read on the NEXT bar by f_processFvg, which runs ~800 lines above this. It cannot
    // read fiboP1/fiboP6 directly — Pine needs a declaration before its use and those are
    // declared here — so the band is published into globals declared up beside the cap.
    // 0.382 → 0.886, the band a reader marks by hand, ordered so a short's band (which runs
    // the other way) still compares correctly.
    // fibo_dir is what makes the exemption direction-matched; zeroed once the leg has
    // completed (fiboResetActive = TP3 banked) so a finished setup stops pinning gaps and
    // its levels go back into the ordinary FIFO queue.
    fvgZoneLo  := math.min(fiboP1, fiboP6)
    fvgZoneHi  := math.max(fiboP1, fiboP6)
    fvgZoneDir := fiboResetActive ? 0 : fibo_dir
    // Raw, un-zeroed — see fvgBiasDir's declaration for why the two differ.
    fvgBiasDir := fibo_dir

    color c1 = fibo1Touched ? fibo1Color : FIBO_GREY
    string tx1 = f_fiboLabel(fibo1Value, "TP2", "TP2") + str.tostring(fiboP1, format.mintick) + ")"
    [l1, lb1] = f_fibLevel(drawFibo and not fiboResetActive and fiboShowAligned, fibo1Line, fibo1Label, fiboStartIndex, fiboP1, bar_index + fiboLineExtend, c1, f_fiboLineStyle(fibo1Style), tx1)
    fibo1Line := l1
    fibo1Label := lb1

    color c2 = fibo2Touched ? fibo2Color : FIBO_GREY
    string tx2 = (fibo2Touched ? "FFT  (" : f_fiboLabel(fibo2Value, "TP1", "TP1")) + str.tostring(fiboP2, format.mintick) + ")"
    [l2, lb2] = f_fibLevel(drawFibo and not fiboResetActive and fiboShowAligned, fibo2Line, fibo2Label, fiboStartIndex, fiboP2, bar_index + fiboLineExtend, c2, f_fiboLineStyle(fibo2Style), tx2)
    fibo2Line := l2
    fibo2Label := lb2

    color c3 = fibo3Touched ? fibo3Color : FIBO_GREY
    string tx3 = f_fiboLabel(fibo3Value, "E1", "E1") + str.tostring(fiboP3, format.mintick) + ")"
    [l3, lb3] = f_fibLevel(drawFibo and not fiboResetActive and fiboShowAligned, fibo3Line, fibo3Label, fiboStartIndex, fiboP3, bar_index + fiboLineExtend, c3, f_fiboLineStyle(fibo3Style), tx3)
    fibo3Line := l3
    fibo3Label := lb3

    color c4 = fibo4Touched ? fibo4Color : FIBO_GREY
    string tx4 = f_fiboLabel(fibo4Value, "E2", "E2") + str.tostring(fiboP4, format.mintick) + ")"
    [l4, lb4] = f_fibLevel(drawFibo and not fiboResetActive and fiboShowAligned, fibo4Line, fibo4Label, fiboStartIndex, fiboP4, bar_index + fiboLineExtend, c4, f_fiboLineStyle(fibo4Style), tx4)
    fibo4Line := l4
    fibo4Label := lb4

    color c5 = fibo5Touched ? fibo5Color : FIBO_GREY
    string tx5 = f_fiboLabel(fibo5Value, "E3", "E3") + str.tostring(fiboP5, format.mintick) + ")"
    [l5, lb5] = f_fibLevel(drawFibo and not fiboResetActive and fiboShowAligned, fibo5Line, fibo5Label, fiboStartIndex, fiboP5, bar_index + fiboLineExtend, c5, f_fiboLineStyle(fibo5Style), tx5)
    fibo5Line := l5
    fibo5Label := lb5

    color c6 = fibo6Touched ? fibo6Color : FIBO_GREY
    string tx6 = f_fiboLabel(fibo6Value, "E4", "E4") + str.tostring(fiboP6, format.mintick) + ")"
    [l6, lb6] = f_fibLevel(drawFibo and not fiboResetActive and fiboShowAligned, fibo6Line, fibo6Label, fiboStartIndex, fiboP6, bar_index + fiboLineExtend, c6, f_fiboLineStyle(fibo6Style), tx6)
    fibo6Line := l6
    fibo6Label := lb6

    color c10 = fibo10Touched ? fibo10Color : FIBO_GREY
    string tx10 = f_fiboLabel(fibo10Value, "1.0", "1.0") + str.tostring(fiboP10, format.mintick) + ")"
    [l10, lb10] = f_fibLevel(drawFibo and not fiboResetActive and fiboShowAligned, fibo10Line, fibo10Label, fiboStartIndex, fiboP10, bar_index + fiboLineExtend, c10, f_fiboLineStyle(fibo10Style), tx10)
    fibo10Line := l10
    fibo10Label := lb10

    color c7 = fibo7Touched ? fibo7Color : FIBO_GREY
    string tx7 = f_fiboLabel(fibo7Value, "TP3", "TP3") + str.tostring(fiboP7, format.mintick) + ")"
    [l7, lb7] = f_fibLevel(drawFibo and not fiboResetActive and fiboShowAligned, fibo7Line, fibo7Label, fiboStartIndex, fiboP7, bar_index + fiboLineExtend, c7, f_fiboLineStyle(fibo7Style), tx7)
    fibo7Line := l7
    fibo7Label := lb7

// ── THE 1m ENTRY-ZONE FVG FILTER IS GONE (Aaron, 2026-08-05) ──
// `f_fvg1mZone()` used to run on the 1m chart ONLY and blank every gap outside the
// External Fib's entry band. Two consequences, and the second is why it went: an
// out-of-band gap was hidden, and — because the band was derived from the fib — a 1m
// chart with NO aligned REV setup showed no gaps AT ALL. That is most of the session.
// The fib gate behind it needs a retraced 15m setup (`rStage >= 3`) plus a 1m SOS in
// the 15m's direction confirming after the 15m SOS closed, so the bar for drawing
// anything was far higher than "is there a gap here".
// The 1m now draws gaps on exactly the same rules as every other timeframe: the
// sub-15m detection floor (0.0, no middle-bar close test), the `fvgMaxCount` cap plus
// the EQ exemption, `dirOnlyInput` if the reader wants it, and the Fair Value Gaps
// toggle. A gap lives until a candle CLOSES fully through its far edge.
// ⚠ Deleted rather than made inert — this file sits at Pine's compile-token cap
// (CE10117), so a dead branch is not free. Recover from git if the banded 1m view is
// ever wanted back as an option.

f_macroLineStyle(string opt) =>
    opt == "┈" ? line.style_dotted : opt == "╌" ? line.style_dashed : line.style_solid

f_macroLabel(float val, string tpLabel, string entryLabel) =>
    sharedLabelMode == "Both"        ? tpLabel + " " + str.tostring(val) + "  (" :
     sharedLabelMode == "TP/Entry"   ? tpLabel    + "  (" :
     str.tostring(val) + "  ("

// ── 5m Cycle-Fib anchor engine (returns STATE, not edge events) ──
// Runs the drawing-free MTF structure engine on 5m and returns the structure-locked
// cycle's current [origin (1.0 = SOS-leg low), extreme (0.0 = last confirmed high),
// visible]. Buy-cycle only — the SAME rule as the proven native engine: lock on a 5m
// bull SOS, extend the top on each new 5m confirmed HH, reset on a 5m close below the
// origin, hide on a 5m close back above the extreme. Read via request.security so every
// chart up to macroMaxTfMin draws this one 5m-scale cycle instead of its own (which was
// too big on 15m+). STATE is returned (not the bull_sos edge) so the lower-timeframe-in-
// security read on a 15m/30m chart can never drop the lock/HH event on a non-final sub-bar.
f_cycleState() =>
    var mtf = MTFStruct.new(length = majorLength)
    float ph = ta.pivothigh(high, majorLength, majorLength)
    float pl = ta.pivotlow(low,  majorLength, majorLength)
    mtf.processMTF(ph, pl)
    var float m_origin  = na
    var float m_extreme = na
    var bool  m_locked  = false
    var float m_lastCH  = na
    var bool  m_vis     = false
    if m_locked and not na(m_origin) and close < m_origin
        m_origin := na, m_extreme := na, m_locked := false, m_lastCH := na, m_vis := false
    if mtf.bull_sos and not m_locked and not na(mtf.bull_bos_low) and not na(mtf.last_conf_high)
        m_origin := mtf.bull_bos_low, m_extreme := mtf.last_conf_high, m_locked := true, m_lastCH := mtf.last_conf_high, m_vis := true
    if m_locked and not na(mtf.last_conf_high) and not na(m_lastCH) and mtf.last_conf_high > m_lastCH
        m_extreme := mtf.last_conf_high, m_lastCH := mtf.last_conf_high, m_vis := true
    if m_locked and m_vis and not na(m_extreme) and close > m_extreme
        m_vis := false
    [m_origin, m_extreme, m_vis]
[cyc_origin, cyc_extreme, cyc_visible] = request.security(syminfo.tickerid, str.tostring(macroCycleTf), f_cycleState())

// macro_dir tracks the OVERALL trend direction we are currently in.
   // 1  = overall trend is up (we are accumulating the highest high of the whole up-cycle)
  // -1  = overall trend is down (we are accumulating the lowest low of the whole down-cycle)
// The origin (opposite anchor) is fixed only when the trend actually reverses (st.dir flips),
// not on every internal BOS/SOS within the same direction. This lets the fib span multiple
// BOS legs that all belong to the same larger move (e.g. wave 1->2->3 as one up-cycle).
var float macro_origin      = na   // fixed anchor: the extreme of the PRIOR opposite cycle
var float macro_extreme     = na   // running extreme of the CURRENT cycle (keeps extending across multiple BOS)

var line  macroLine0   = na, var label macroLabel0   = na
var line  macroLine382 = na, var label macroLabel382 = na
var line  macroLine50  = na, var label macroLabel50  = na
var line  macroLine618 = na, var label macroLabel618 = na
var line  macroLine702 = na, var label macroLabel702 = na
var line  macroLine786 = na, var label macroLabel786 = na
var line  macroLine886 = na, var label macroLabel886 = na
var line  macroLine100 = na, var label macroLabel100 = na

// ── Macro fib touched tracking ──
var bool macro0Touched    = false   // HH / 0.0
var bool macro382Touched  = false   // TP2
var bool macro50Touched   = false   // TP1 / FFT
var bool macro618Touched  = false   // E1
var bool macro702Touched  = false   // E2
var bool macro786Touched  = false   // E3
var bool macro886Touched  = false   // E4
var bool macro100Touched  = false   // LL / 1.0
var bool macro618EverReached = false  // gates TP checks from next bar after E1 hit
var float macro_prev_extreme = na   // detects when extreme changes (new HH)

// ── EXACT RULE (per latest instructions) ──
// BOTTOM anchor (extreme LL):
//   - Locks the instant st.asl is confirmed as a genuine LL (st.new_swing_low fires and the
//     confirmed low is lower than the prior confirmed low).
//   - Once locked, it NEVER moves again for this cycle -- not even if a deeper low occurs
//     later while the top is still extending.
//   - The ONLY way the bottom changes is if an even deeper confirmed LL prints later --
//     that starts a BRAND NEW cycle (the old fib's top lock is discarded, a new bottom locks
//     on the fresh LL, and the top starts over unlocked).
//
// TOP anchor (extreme HH):
//   - Locks the first time a bearish SOS (st.bear_sos) fires alongside a confirmed HH
//     (st.ash, confirmed via st.new_swing_high, higher than the prior confirmed high).
//   - After that initial lock, it is allowed to extend FURTHER only when a subsequent
//     bullish BOS (st.bull_bos) confirms an even higher high -- i.e. price comes back up,
//     breaks structure again, and makes a new HH beyond the locked one.
//   - It does NOT track every new high live -- only on these specific qualifying events.

var bool  macro_origin_locked  = false
var bool  macro_visible        = false

// Cycle Fib TRACKING always runs (on 5m via security). Only the DRAWING is gated to
// charts up to macroMaxTfMin (default 30 → 15m/30m draw it, 1h+ don't). Lower the input
// to 15 to drop it off 30m too.
bool macroFibAllowed = timeframe.in_seconds() <= macroMaxTfMin * 60

// ── Cycle anchor source: HYBRID, split at macroCycleTf (the "Cycle Fib Timeframe" input) ──
// Charts ABOVE macroCycleTf (e.g. 15m/30m when it's 5): adopt the macroCycleTf cycle via
//   the security state (cyc_*) — the smaller cycle. Lowering macroCycleTf shrinks it.
// Charts AT or BELOW macroCycleTf: that same security read comes back EMPTY at equal-or-
//   faster resolution, so drive the cycle NATIVELY off the chart's own structure engine
//   (st) — the same structure-locked rule, run inline, which renders reliably.
bool _cycNative = timeframe.in_seconds() <= macroCycleTf * 60
var float ncyc_origin = na, var float ncyc_extreme = na
var bool  ncyc_locked = false, var float ncyc_lastCH = na, var bool ncyc_vis = false
if _cycNative
    if ncyc_locked and not na(ncyc_origin) and close < ncyc_origin
        ncyc_origin := na, ncyc_extreme := na, ncyc_locked := false, ncyc_lastCH := na, ncyc_vis := false
    if st.bull_sos and not ncyc_locked and not na(st.bull_bos_low) and not na(st.last_conf_high)
        ncyc_origin := st.bull_bos_low, ncyc_extreme := st.last_conf_high, ncyc_locked := true, ncyc_lastCH := st.last_conf_high, ncyc_vis := true
    if ncyc_locked and not na(st.last_conf_high) and not na(ncyc_lastCH) and st.last_conf_high > ncyc_lastCH
        ncyc_extreme := st.last_conf_high, ncyc_lastCH := st.last_conf_high, ncyc_vis := true
    if ncyc_locked and ncyc_vis and not na(ncyc_extreme) and close > ncyc_extreme
        ncyc_vis := false

macro_origin        := _cycNative ? ncyc_origin  : cyc_origin
macro_extreme       := _cycNative ? ncyc_extreme : cyc_extreme
macro_visible       := _cycNative ? ncyc_vis     : cyc_visible
macro_origin_locked := not na(macro_origin)

// New cycle range (a fresh 5m lock or a new 5m HH moves macro_extreme) → reset touched flags.
bool macroRangeChanged = not na(macro_extreme) and (na(macro_prev_extreme) or macro_extreme != macro_prev_extreme)
if macroRangeChanged
    macro0Touched   := false
    macro382Touched := false
    macro50Touched  := false
    macro618Touched := false
    macro702Touched := false
    macro786Touched := false
    macro886Touched := false
    macro100Touched := false
    macro618EverReached := false

// ── Macro touched tracking (chart high/low vs the adopted 5m anchors) ──
if macro_visible and macro_origin_locked and not na(macro_origin) and not na(macro_extreme) and not macroRangeChanged
    float mH = macro_extreme
    float mL = macro_origin
    float mR = mH - mL
    if mR > 0
        float mP618 = mH - mR * 0.618
        float mP702 = mH - mR * 0.702
        float mP786 = mH - mR * 0.786
        float mP886 = mH - mR * 0.886
        float mP100 = mH - mR * 1.0
        float mP50  = mH - mR * 0.5
        float mP382 = mH - mR * 0.382
        float mP0   = mH - mR * 0.0
        bool macro618Reached = low <= mP618
        if macro618Reached
            macro618Touched := true
            macro702Touched := f_checkTouch(macro702Touched, mP702, low <= mP702)
            macro786Touched := f_checkTouch(macro786Touched, mP786, low <= mP786)
            macro886Touched := f_checkTouch(macro886Touched, mP886, low <= mP886)
            macro100Touched := f_checkTouch(macro100Touched, mP100, low <= mP100)
        if macro618EverReached
            macro50Touched  := f_checkTouch(macro50Touched,  mP50,  high >= mP50)
            macro382Touched := f_checkTouch(macro382Touched, mP382, high >= mP382)
            macro0Touched   := f_checkTouch(macro0Touched,   mP0,   high >= mP0)
        if macro618Reached and not macro618EverReached
            macro618EverReached := true

macro_prev_extreme := macro_extreme

// ── Draw / update the macro fib ──
bool macroDrawable = showMacroFib and macroFibAllowed and macro_visible and macro_origin_locked and not na(macro_origin) and not na(macro_extreme)
// The 5m-adopt path has no per-event delete blocks, so retire the drawn lines here the
// moment the cycle stops being drawable (5m hid it, closed past an anchor, or chart is
// above the draw cap).
if not macroDrawable and not na(macroLine0)
    line.delete(macroLine0),   label.delete(macroLabel0)
    line.delete(macroLine382), label.delete(macroLabel382)
    line.delete(macroLine50),  label.delete(macroLabel50)
    line.delete(macroLine618), label.delete(macroLabel618)
    line.delete(macroLine702), label.delete(macroLabel702)
    line.delete(macroLine786), label.delete(macroLabel786)
    line.delete(macroLine886), label.delete(macroLabel886)
    line.delete(macroLine100), label.delete(macroLabel100)
    macroLine0 := na,   macroLabel0 := na
    macroLine382 := na, macroLabel382 := na
    macroLine50 := na,  macroLabel50 := na
    macroLine618 := na, macroLabel618 := na
    macroLine702 := na, macroLabel702 := na
    macroLine786 := na, macroLabel786 := na
    macroLine886 := na, macroLabel886 := na
    macroLine100 := na, macroLabel100 := na
if macroDrawable
    float mHigh   = macro_extreme
    float mLow    = macro_origin
    float mRange  = mHigh - mLow
    int   mStart  = math.max(0, bar_index - macroLineExtend)
    int   mEnd    = bar_index + macroLineExtend

    if mRange > 0
        float p0 = mHigh - mRange * 0.0
        color cm0 = macro0Touched ? macro0Color : MACRO_GREY
        string txm0 = f_macroLabel(0.0, "TP3", "TP3") + str.tostring(p0, format.mintick) + ")"
        [nml0, nmlb0] = f_fibLevel(showMacro0, macroLine0, macroLabel0, mStart, p0, mEnd, cm0, f_macroLineStyle(macro0Style), txm0)
        macroLine0 := nml0, macroLabel0 := nmlb0

        float p382 = mHigh - mRange * 0.382
        color cm382 = macro382Touched ? macro382Color : MACRO_GREY
        string txm382 = f_macroLabel(0.382, "TP2", "TP2") + str.tostring(p382, format.mintick) + ")"
        [nml382, nmlb382] = f_fibLevel(showMacro382, macroLine382, macroLabel382, mStart, p382, mEnd, cm382, f_macroLineStyle(macro382Style), txm382)
        macroLine382 := nml382, macroLabel382 := nmlb382

        float p50 = mHigh - mRange * 0.5
        color cm50 = macro50Touched ? macro50Color : MACRO_GREY
        string txm50 = (macro50Touched ? "FFT  (" : f_macroLabel(0.5, "TP1", "TP1")) + str.tostring(p50, format.mintick) + ")"
        [nml50, nmlb50] = f_fibLevel(showMacro50, macroLine50, macroLabel50, mStart, p50, mEnd, cm50, f_macroLineStyle(macro50Style), txm50)
        macroLine50 := nml50, macroLabel50 := nmlb50

        float p618 = mHigh - mRange * 0.618
        color cm618 = macro618Touched ? macro618Color : MACRO_GREY
        string txm618 = f_macroLabel(0.618, "E1", "E1") + str.tostring(p618, format.mintick) + ")"
        [nml618, nmlb618] = f_fibLevel(showMacro618, macroLine618, macroLabel618, mStart, p618, mEnd, cm618, f_macroLineStyle(macro618Style), txm618)
        macroLine618 := nml618, macroLabel618 := nmlb618

        float p702 = mHigh - mRange * 0.702
        color cm702 = macro702Touched ? macro702Color : MACRO_GREY
        string txm702 = f_macroLabel(0.702, "E2", "E2") + str.tostring(p702, format.mintick) + ")"
        [nml702, nmlb702] = f_fibLevel(showMacro702, macroLine702, macroLabel702, mStart, p702, mEnd, cm702, f_macroLineStyle(macro702Style), txm702)
        macroLine702 := nml702, macroLabel702 := nmlb702

        float p786 = mHigh - mRange * 0.786
        color cm786 = macro786Touched ? macro786Color : MACRO_GREY
        string txm786 = f_macroLabel(0.786, "E3", "E3") + str.tostring(p786, format.mintick) + ")"
        [nml786, nmlb786] = f_fibLevel(showMacro786, macroLine786, macroLabel786, mStart, p786, mEnd, cm786, f_macroLineStyle(macro786Style), txm786)
        macroLine786 := nml786, macroLabel786 := nmlb786

        float p886 = mHigh - mRange * 0.886
        color cm886 = macro886Touched ? macro886Color : MACRO_GREY
        string txm886 = f_macroLabel(0.886, "E4", "E4") + str.tostring(p886, format.mintick) + ")"
        [nml886, nmlb886] = f_fibLevel(showMacro886, macroLine886, macroLabel886, mStart, p886, mEnd, cm886, f_macroLineStyle(macro886Style), txm886)
        macroLine886 := nml886, macroLabel886 := nmlb886

        float p100 = mHigh - mRange * 1.0
        color cm100 = macro100Touched ? macro100Color : MACRO_GREY
        string txm100 = f_macroLabel(1.0, "1.0", "1.0") + str.tostring(p100, format.mintick) + ")"
        [nml100, nmlb100] = f_fibLevel(showMacro100, macroLine100, macroLabel100, mStart, p100, mEnd, cm100, f_macroLineStyle(macro100Style), txm100)
        macroLine100 := nml100, macroLabel100 := nmlb100
        //============================================================
  // INTERNAL FIB
//============================================================
// (Internal Fib runtime blocks removed — feature deleted to save compile tokens.)

// (Internal Fib drawing block removed — feature deleted to save compile tokens.)

//============================================================
  // SNIPER FIB
//============================================================
// On the 1m entry view the Sniper Zone is restricted to the SOS leg whose direction
// ALIGNS with the 15m structure (m15Dir) — nowhere else. Every other timeframe keeps
// the original per-BOS trigger. (A bull/bear SOS also sets bull_bos_*/bear_bos_*, so
// the leg vars the sniper block reads below are populated on the SOS bar too.)
bool _sn1m = timeframe.in_seconds() == 60
// On the 1m the Sniper Zone only draws on an aligned SOS that fires AFTER the 15m
// has retraced ≥ 50% (_m15Retraced) — same gate as the 1m fib, so nothing on the 1m
// is considered until the 15m reaches its entry zone. Other timeframes: per-BOS as before.
bool _snBearBOS = barstate.isconfirmed and showFibo and (_sn1m ? (st.bear_sos and m15Dir == -1 and _m15Retraced) : st.bear_bos)
bool _snBullBOS = barstate.isconfirmed and showFibo and (_sn1m ? (st.bull_sos and m15Dir == 1 and _m15Retraced) : st.bull_bos)

if _snBearBOS or _snBullBOS
    float _snh   = _snBullBOS ? st.bull_bos_high : st.bear_bos_high
    float _snl   = _snBullBOS ? st.bull_bos_low : st.bear_bos_low
    float _snr   = _snh - _snl
    int   _snS   = _snBullBOS ? st.bull_bos_l_loc : st.bear_bos_h_loc
    int   _snE   = bar_index + 25
    float _sn382 = _snBullBOS ? _snl + _snr * 0.382 : _snh - _snr * 0.382
    float _sn50  = _snBullBOS ? _snl + _snr * 0.500 : _snh - _snr * 0.500
    float _zTop  = math.max(_sn382, _sn50)
    float _zBot  = math.min(_sn382, _sn50)

    // Only keep one sniper zone at a time
    if array.size(sniperBoxArr) > 0
        for i = 0 to array.size(sniperBoxArr) - 1
            box.delete(array.get(sniperBoxArr, i))
            line.delete(array.get(sniper382Arr, i))
            line.delete(array.get(sniper50Arr, i))
            label.delete(array.get(sniperLbl382Arr, i))
        array.clear(sniperBoxArr)
        array.clear(sniper382Arr)
        array.clear(sniper50Arr)
        array.clear(sniperLbl382Arr)

    color _snColor = not drawSniper ? color(na) : _snBullBOS ? color.new(#4caf50, 75) : color.new(#ff4444, 75)
    color _snLineColor = not drawSniper ? color(na) : _snBullBOS ? color.new(#4caf50, 0) : color.new(#ff4444, 0)

    array.push(sniperBoxArr,    box.new(_snS, _zTop, _snE, _zBot, bgcolor = _snColor, border_color = color(na)))
    array.push(sniper382Arr,    line.new(_snS, _sn382, _snE, _sn382, color = _snLineColor, style = line.style_dotted, width = 1))
    array.push(sniper50Arr,     line.new(_snS, _sn50,  _snE, _sn50,  color = _snLineColor, style = line.style_dotted, width = 1))
    array.push(sniperLbl382Arr, label.new(_snE + 2, (_sn382 + _sn50) / 2, "SZ", style = label.style_none, textcolor = _snLineColor, size = size.small, textalign = text.align_center))
    sniperZoneTop    := _zTop
    sniperZoneBot    := _zBot
    sz_bullish       := _snBullBOS

// On the 1m entry view a countering SOS cancels the aligned setup — so clear the
// Sniper Zone the moment the fib is no longer armed; it reprints with the next
// aligned SOS. Other timeframes just extend it as before. Wrapped in a function so
// the cancel branch doesn't grow the main body.
f_sniperExtend() =>
    if showFibo and array.size(sniperBoxArr) > 0
        // 1m: the Sniper Zone belongs to the aligned SOS leg it was drawn on. When the
        // External Fib RE-ANCHORS to a new leg (a continuation BOS, or a countering SOS)
        // WITHOUT a fresh aligned-SOS sniper drawn this same bar, the old zone is orphaned
        // — it has no fib behind it anymore (it lingers up on the prior SOS leg) — so
        // delete it outright. It reprints only on the next aligned SOS.
        bool _snOrphan = _sn1m and fiboOriginChanged and not (_snBearBOS or _snBullBOS)
        if _snOrphan
            for _sni = 0 to array.size(sniperBoxArr) - 1
                box.delete(array.get(sniperBoxArr, _sni))
                line.delete(array.get(sniper382Arr, _sni))
                line.delete(array.get(sniper50Arr, _sni))
                label.delete(array.get(sniperLbl382Arr, _sni))
            array.clear(sniperBoxArr)
            array.clear(sniper382Arr)
            array.clear(sniper50Arr)
            array.clear(sniperLbl382Arr)
        else
            // Otherwise hide/show in LOCKSTEP with the External Fib on the SAME leg: a
            // countering SOS or a 15m flip turns fiboShowAligned off, so the zone hides
            // (by color, not deleted) and reappears if alignment returns. Other timeframes
            // always show it.
            bool  _snHide = not drawSniper or (_sn1m and (not fiboShowAligned or fiboResetActive))
            color _snBoxC = _snHide ? color(na) : (sz_bullish ? color.new(#4caf50, 75) : color.new(#ff4444, 75))
            color _snLnC  = _snHide ? color(na) : (sz_bullish ? color.new(#4caf50, 0)  : color.new(#ff4444, 0))
            for _sni = 0 to array.size(sniperBoxArr) - 1
                box.set_bgcolor(array.get(sniperBoxArr, _sni), _snBoxC)
                box.set_right(array.get(sniperBoxArr,    _sni), bar_index + fiboLineExtend)
                line.set_color(array.get(sniper382Arr, _sni), _snLnC)
                line.set_x2(array.get(sniper382Arr,      _sni), bar_index + fiboLineExtend)
                line.set_color(array.get(sniper50Arr, _sni), _snLnC)
                line.set_x2(array.get(sniper50Arr,       _sni), bar_index + fiboLineExtend)
                label.set_textcolor(array.get(sniperLbl382Arr, _sni), _snLnC)
                label.set_x(array.get(sniperLbl382Arr,   _sni), bar_index + fiboLineExtend + 2)
    int _ret = 0
f_sniperExtend()

//============================================================
  // SESSION VOLUME PROFILE — ASIA POC / MV LINE
//============================================================
f_processSvp() =>
    string SVP_SESSION = "0900-1800"
    string SVP_TZ      = "Asia/Tokyo"

    var array<line>  svp_poc      = array.new<line>()
    var array<label> svp_poc_lbl  = array.new<label>()
    var array<float> svp_poc_px   = array.new<float>()

    var float svp_hi       = na
    var float svp_lo       = na
    var int   svp_startBar = na
    var bool  svp_inSess   = false

    var float svp_range    = na
    var float svp_bHi      = na
    var float svp_bLo      = na
    var float svp_bVol     = na
    var bool  svp_bull     = false
    var int   svp_rLo      = 0
    var int   svp_rHi      = 0
    var int   svp_span     = 0
    var float svp_perRow   = na
    var float svp_rv       = na
    var float svp_total    = 0.0
    var float svp_maxVol   = 0.0
    var int   svp_pocRow   = 0
    var float svp_pocPx    = na
    var int   svp_sLen     = 0
    var int   svp_sBar     = 0
    var array<float> svp_rowUp = array.new<float>()
    var array<float> svp_rowDn = array.new<float>()

    bool inSVP  = not na(time(timeframe.period, SVP_SESSION, SVP_TZ))
    bool svpNew = inSVP and not inSVP[1]
    bool svpEnd = not inSVP and inSVP[1]

    if svpNew and showSVP and timeframe.isintraday
        svp_hi       := high
        svp_lo       := low
        svp_startBar := bar_index
        svp_inSess   := true

    if svp_inSess and inSVP and showSVP and timeframe.isintraday
        if high > svp_hi
            svp_hi := high
        if low < svp_lo
            svp_lo := low

    if svpEnd and svp_inSess and showSVP and timeframe.isintraday and not na(svp_hi) and not na(svp_lo)
        svp_inSess := false
        svp_range  := svp_hi - svp_lo
        if svp_range > 0
            svp_sLen := bar_index - svp_startBar + 1
            array.clear(svp_rowUp)
            array.clear(svp_rowDn)
            for r = 0 to svpRows - 1
                array.push(svp_rowUp, 0.0)
                array.push(svp_rowDn, 0.0)
            for b = 0 to math.min(svp_sLen - 1, 1490)
                svp_bHi  := high[b]
                svp_bLo  := low[b]
                svp_bVol := volume[b]
                svp_bull := close[b] >= open[b]
                svp_rLo  := math.max(0, math.min(math.floor((svp_bLo - svp_lo) / svp_range * svpRows), svpRows - 1))
                svp_rHi  := math.max(0, math.min(math.ceil( (svp_bHi - svp_lo) / svp_range * svpRows) - 1, svpRows - 1))
                svp_span := math.max(1, svp_rHi - svp_rLo + 1)
                svp_perRow := svp_bVol / svp_span
                for r = svp_rLo to svp_rHi
                    if svp_bull
                        array.set(svp_rowUp, r, array.get(svp_rowUp, r) + svp_perRow)
                    else
                        array.set(svp_rowDn, r, array.get(svp_rowDn, r) + svp_perRow)

            svp_total  := 0.0
            svp_maxVol := 0.0
            svp_pocRow := 0
            for r = 0 to svpRows - 1
                svp_rv = array.get(svp_rowUp, r) + array.get(svp_rowDn, r)
                svp_total += svp_rv
                if svp_rv > svp_maxVol
                    svp_maxVol := svp_rv
                    svp_pocRow := r

            svp_pocPx := svp_lo + (svp_pocRow + 0.5) * (svp_range / svpRows)
            svp_sBar  := svp_startBar

            if array.size(svp_poc) >= svpHistory
                line.delete(array.shift(svp_poc))
                label.delete(array.shift(svp_poc_lbl))
                array.shift(svp_poc_px)

            array.push(svp_poc,     line.new(svp_sBar, svp_pocPx, bar_index + i_lineExtend, svp_pocPx, color = svpPOCCol, style = line.style_solid, width = 1))
            array.push(svp_poc_lbl, label.new(bar_index + i_lineExtend, svp_pocPx + lblOff, "MV", style = label.style_none, textcolor = svpPOCCol, size = f_liqSize(), textalign = text.align_left))
            array.push(svp_poc_px,  svp_pocPx)

    var line  svp_ln = na
    var label svp_lb = na
    if showSVP and timeframe.isintraday and array.size(svp_poc) > 0
        for idx = 0 to array.size(svp_poc) - 1
            svp_ln := array.get(svp_poc, idx)
            svp_lb := array.get(svp_poc_lbl, idx)
            line.set_x2(svp_ln, bar_index + i_lineExtend)
            label.set_x(svp_lb, bar_index + i_lineExtend)
    int _ret = 0
f_processSvp()

//============================================================
  // PLOTTING
//============================================================
// VWAP is drawn with plot() rather than a polyline. The old approach rebuilt the
// whole day's polyline on every bar (O(n^2) over the session); plot is O(1) per bar.
// ta.vwap already resets each session, so the line breaks at the day boundary on its own.
plot(showVwap ? vwapValue : na, title = "VWAP", color = vwapColor, linewidth = vwapWidth)


plot(array.get(a_lastHighs, 0), "DH", color.new(i_dailyColor,   100), editable = false, display = display.none)
plot(array.get(a_lastLows,  0), "DL", color.new(i_dailyColor,   100), editable = false, display = display.none)
plot(array.get(a_lastHighs, 1), "WH", color.new(i_weeklyColor,  100), editable = false, display = display.none)
plot(array.get(a_lastLows,  1), "WL", color.new(i_weeklyColor,  100), editable = false, display = display.none)
//============================================================
  // MPC - JARVIS CONFIRMATION TABLE
//============================================================
// ── PALETTE REFRESH (Aaron, 2026-08-04) — appearance only, no row logic touched ──
// The company blue and yellow stay; everything around them was re-picked so the table reads
// as one panel instead of a grid of coloured text. Three changes carry it:
//   1. The BODY is a softened charcoal (#0B0E14) rather than near-black, and the HEADER is
//      the only true black on the table — so the header separates by itself and the frame
//      no longer has to do it with a heavy yellow border.
//   2. The FRAME is the blue at 70%, one pixel, matching the internal borders. The old
//      2px yellow frame outranked the header text it was drawing attention to.
//   3. The INFO column is a muted slate (#94A3B8) rather than white-at-40%. A transparent
//      white takes its tint from whatever is behind it; a solid grey does not, so the third
//      column now reads the same over the chart as it does over the table's own fill.
// The bull/bear pair moved to the brighter modern pair (#00E676 / #FF5252) because they now
// sit on a tinted cell rather than on flat charcoal — see f_jRow4 for that.
color JARVIS_YELLOW = #ffde59
color JARVIS_BLUE   = #17578e
color JARVIS_WHITE  = #ffffff
color JARVIS_BLACK  = #000000
color JARVIS_BG     = color.new(#0B0E14, 0)
color JARVIS_HEADBG = color.new(#000000, 0)
color JARVIS_BORDER = color.new(JARVIS_BLUE, 70)
// The header's own blue — a bright cyan, and the ONLY place it appears. It is what
// separates the branding cell from the two yellow column headings beside it, now that
// they no longer sit in a coloured band.
color JARVIS_GLOW   = #00E5FF
color JARVIS_MUTED  = color.new(#94A3B8, 0)
color JARVIS_BSL    = color.new(#FF5252, 0)
color JARVIS_SSL    = color.new(#00E676, 0)
color JARVIS_NEUTRAL = color.new(#94A3B8, 0)
// The LIQ BSL row's own red — a hotter one than the bearish red, deliberately. A swept pool
// is an EVENT that just happened, not a running bias like the 4H/15m/1m rows, so it should
// not sit at the same visual weight as three rows that are simply describing trend.
color JARVIS_LIQRED = color.new(#FF1744, 0)

// ── 1. LIQUIDITY slots ──
var string liq_h4h = "", var string liq_h4l = ""
var string liq_dh  = "", var string liq_dl  = ""
var string liq_ash = "", var string liq_asl = ""
var string liq_ldh = "", var string liq_ldl = ""
var string liq_nyh = "", var string liq_nyl = ""

// (Per-sweep price vars removed to save compile tokens — they were never read.)
// Bar timestamps for each sweep — used to find most recent BSL/SSL
var int liq_h4h_bar = na, var int liq_h4l_bar = na
var int liq_dh_bar  = na, var int liq_dl_bar  = na
// Timestamp of the DAILY sweep, captured when it fires. The staleness check below
// compares times directly instead of walking back `time[bar_index - sweepBar]` — that
// dynamic offset is unbounded and blows Pine's historical buffer once the sweep is a
// few thousand bars old ("requested historical offset ... beyond the buffer's limit").
var int liq_dh_t    = na, var int liq_dl_t    = na
var int liq_ash_bar = na, var int liq_asl_bar = na
var int liq_ldh_bar = na, var int liq_ldl_bar = na
var int liq_nyh_bar = na, var int liq_nyl_bar = na

// Each tier's sweep memory lives exactly as long as THAT tier's pool is the
// current one — clear it the moment the pool refreshes (its level is redrawn),
// NOT on a fixed clock. This keeps the LIQ BSL/SSL rows tied to the live pool
// for a session/daily/H4 bias read: never stale, and never wiped before the
// pool it belongs to has actually rolled. Aligns with when the drawn levels
// themselves reset. Placed BEFORE the sweep-activation block so a sweep firing
// on the very same refresh bar still registers. (H4 is handled per H4 bar below.)
   // Daily pool rolls at the exchange daily open (hasDailyTimeChanged), NOT NY
   // midnight — for gold that's ~17:00-18:00 NY.
if hasDailyTimeChanged
    liq_dh := "", liq_dh_bar := na, liq_dh_t := na
    liq_dl := "", liq_dl_bar := na, liq_dl_t := na
   // Each session pool rolls when its NEW high/low is established, i.e. on the
   // bar that session closes and the next range starts being tracked.
if not inAsia and inAsia[1]
    liq_ash := "", liq_ash_bar := na
    liq_asl := "", liq_asl_bar := na
if not inLondon and inLondon[1]
    liq_ldh := "", liq_ldh_bar := na
    liq_ldl := "", liq_ldl_bar := na
if not inNY and inNY[1]
    liq_nyh := "", liq_nyh_bar := na
    liq_nyl := "", liq_nyl_bar := na

// ── Activate on sweep — stays active until replaced by next sweep or session reset ──
if barstate.isconfirmed
    if i_showH4Sweep and i_showLiquidity
        if h4HighSwept and not h4HighSwept[1] and not na(h4TrackHigh)
            liq_h4h := "BSL", liq_h4h_bar := bar_index
        if h4LowSwept and not h4LowSwept[1] and not na(h4TrackLow)
            liq_h4l := "SSL", liq_h4l_bar := bar_index
    if i_isDailyEnabled and i_showLiquidity
        if d_hMit and not d_hMit[1]
            liq_dh := "BSL", liq_dh_bar := bar_index, liq_dh_t := time
        if d_lMit and not d_lMit[1]
            liq_dl := "SSL", liq_dl_bar := bar_index, liq_dl_t := time
    if i_showAsiaHL and i_showLiquidity
        if asiaHMit and not asiaHMit[1]
            liq_ash := "BSL", liq_ash_bar := bar_index
        if asiaLMit and not asiaLMit[1]
            liq_asl := "SSL", liq_asl_bar := bar_index
    if i_showLondonHL and i_showLiquidity
        if londonHMit and not londonHMit[1]
            liq_ldh := "BSL", liq_ldh_bar := bar_index
        if londonLMit and not londonLMit[1]
            liq_ldl := "SSL", liq_ldl_bar := bar_index
    if i_showNYHL and i_showLiquidity
        if nyHMit and not nyHMit[1]
            liq_nyh := "BSL", liq_nyh_bar := bar_index
        if nyLMit and not nyLMit[1]
            liq_nyl := "SSL", liq_nyl_bar := bar_index

// H4 resets on new H4 bar
if h4BarChanged
    liq_h4h := "", liq_h4h_bar := na
    liq_h4l := "", liq_h4l_bar := na

// ── 2. STRUCTURE slots — most recent external and internal ──
var string ext_struct = ""
var string int_struct = ""

// External — update on every BOS/SOS, most recent always wins
if st.bull_sos
    ext_struct := "▲ SOS"
else if st.bear_sos
    ext_struct := "▼ SOS"
else if st.bull_bos
    ext_struct := "▲ BOS"
else if st.bear_bos
    ext_struct := "▼ BOS"

// Internal — update on every iBOS/iSOS with correct label
// Internal — track bar index so we can validate it's within current fib range
var int int_struct_bar = na

// An external break ends the current internal swing and (unless historic internals
// are enabled) wipes its drawings from the chart. Clear the table's INT state on the
// same bar so the row can never show an iBOS/iSOS that has no drawing behind it.
if extBreakThisBar
    int_struct     := ""
    int_struct_bar := na

if int_bull_sos
    int_struct := "▲ iSOS", int_struct_bar := bar_index
else if int_bear_sos
    int_struct := "▼ iSOS", int_struct_bar := bar_index
else if int_bull_bos
    int_struct := "▲ iBOS", int_struct_bar := bar_index
else if int_bear_bos
    int_struct := "▼ iBOS", int_struct_bar := bar_index

// Valid whenever a live internal break exists for the CURRENT external swing.
// (The external-break clear above is what scopes it — no fib-origin comparison
// needed, since fiboStartIndex tracks the swing anchor, not the break bar, and
// could sit far enough back to let a stale internal break slip through.)
bool int_struct_valid = int_struct != "" and not na(int_struct_bar)

// ── Draw table ──
// FOUR columns now — GROUP · row · STATUS · INFO (Aaron, 2026-08-04). The first column
// is a spanning tag (SETUP / BIAS / STR / LIQ) printed ONCE on the group's first row and
// blank on the rest, so a dozen rows read as four bands rather than one long list.
// ⚠ THE GRID IS BACK ON (Aaron, 2026-08-04). It was briefly `border_width = 0` on the
// reasoning that a blank group cell still reads as its own box, so a borderless table
// lets a group tag visually own the rows beneath it. That is true and it is not what was
// wanted — the grid is what makes this readable as a TABLE, and with a dozen rows of
// prices and instructions that matters more than the banding does.
// So the grouping now comes from the TAG ALONE: `SETUP` / `BIAS` / `STR` / `LIQ` printed
// once on the group's first row, blank on the rest. A blank cell in a bordered grid still
// groups — it just reads as an indent rather than a merged band.
// Borders are the blue at 70%, the same colour as the frame, so the grid separates
// without competing with the tinted status cells.
var table jarvisTable = table.new(f_tablePosition(tablePositionInput), 4, 18,
  bgcolor      = JARVIS_BG,
  border_color = JARVIS_BORDER,
  border_width = 1,
  frame_color  = JARVIS_BORDER,
  frame_width  = 1)

// ── THE STATUS CELL IS TINTED WITH ITS OWN COLOUR (Aaron, 2026-08-04) ──
// The middle column used to be coloured TEXT on the same flat fill as everything else, so
// a row's state had to be read off the words. It now sits on a wash of its own colour and
// the row's state is visible before a single word is.
// ONE RULE — `color.new(vc, 87)` — rather than a status→background lookup, and that is the
// one deliberate departure from the reference table. Two reasons:
//   The reference keys its tint off the status TEXT ("Bullish" / "Bearish" / "BSL"), and
//   this table's statuses are not a fixed vocabulary: they are "▲ ENTRY LONG", "TAKE PROFIT
//   SHORT", "0.5 ZONE LONG", "Tracking", "Monitor", "✗ INVALID SHORT", "2/3 LONG". A lookup
//   would have to be extended every time a row gains a state, and the one it missed would
//   silently render untinted — the same class of "a label nobody is checking" this repo
//   keeps meeting. Deriving from the colour already passed in cannot fall out of step,
//   because the colour is the thing the row already decided.
//   And the reference's three transparencies (87 / 87 / 84 / 90) read as one value with
//   noise on it rather than four decisions, so collapsing them costs nothing visible.
// It also covers the YELLOW awaiting-states, which the reference has no equivalent of.
// `grp` is the GROUP tag and is passed EMPTY on every row but the first of its group.
// It cannot be latched inside this function — Pine lets a function read a global but
// never write one (CE10088, the error `ob_export.pine` hit on 2026-07-31) — so the
// caller owns the once-only rule. Most groups can hardcode it, because their first row
// is unconditional: REV SETUP always prints on 15m/1m (a stage or "Pass"), Weekly and 4H
// always print. Only LIQ and the market-structure pair need a real latch, since either
// of their two rows can be the one that appears; see the `gLiq` / `gMs` locals there.
f_jRow4(table t, int row, string grp, string sec, string val, color vc, string detail) =>
    table.cell(t, 0, row, grp,
      text_color  = JARVIS_YELLOW,
      text_size   = f_tableSize(tableSizeInput),
      bgcolor     = JARVIS_BG,
      text_halign = text.align_left)
    table.cell(t, 1, row, sec,
      text_color  = JARVIS_WHITE,
      text_size   = f_tableSize(tableSizeInput),
      bgcolor     = JARVIS_BG,
      text_halign = text.align_center)
    table.cell(t, 2, row, val,
      text_color  = vc,
      text_size   = f_tableSize(tableSizeInput),
      bgcolor     = color.new(vc, 87),
      text_halign = text.align_center)
    table.cell(t, 3, row, detail,
      text_color  = JARVIS_MUTED,
      text_size   = f_tableSize(tableSizeInput),
      bgcolor     = JARVIS_BG,
      text_halign = text.align_center)

// Most recent BSL/SSL source — priority: NY > London > Asia > Daily > H4
bool showSessH = liq_dh == ""
bool showSessL = liq_dl == ""

// Find most recent BSL — whichever was swept latest by bar_index
string recentBSL = ""
int    recentBSL_bar = -1
if liq_h4h != "" and not na(liq_h4h_bar) and liq_h4h_bar > recentBSL_bar
    recentBSL := "H4 High",   recentBSL_bar := liq_h4h_bar
if liq_dh != "" and not na(liq_dh_bar) and liq_dh_bar > recentBSL_bar
    recentBSL := "Day High",  recentBSL_bar := liq_dh_bar
if showSessH and liq_ash != "" and not na(liq_ash_bar) and liq_ash_bar > recentBSL_bar
    recentBSL := "Asia High", recentBSL_bar := liq_ash_bar
if showSessH and liq_ldh != "" and not na(liq_ldh_bar) and liq_ldh_bar > recentBSL_bar
    recentBSL := "Ldn High",  recentBSL_bar := liq_ldh_bar
if showSessH and liq_nyh != "" and not na(liq_nyh_bar) and liq_nyh_bar > recentBSL_bar
    recentBSL := "NY High",   recentBSL_bar := liq_nyh_bar

// Find most recent SSL — whichever was swept latest by bar_index
string recentSSL = ""
int    recentSSL_bar = -1
if liq_h4l != "" and not na(liq_h4l_bar) and liq_h4l_bar > recentSSL_bar
    recentSSL := "H4 Low",   recentSSL_bar := liq_h4l_bar
if liq_dl != "" and not na(liq_dl_bar) and liq_dl_bar > recentSSL_bar
    recentSSL := "Day Low",  recentSSL_bar := liq_dl_bar
if showSessL and liq_asl != "" and not na(liq_asl_bar) and liq_asl_bar > recentSSL_bar
    recentSSL := "Asia Low", recentSSL_bar := liq_asl_bar
if showSessL and liq_ldl != "" and not na(liq_ldl_bar) and liq_ldl_bar > recentSSL_bar
    recentSSL := "Ldn Low",  recentSSL_bar := liq_ldl_bar
if showSessL and liq_nyl != "" and not na(liq_nyl_bar) and liq_nyl_bar > recentSSL_bar
    recentSSL := "NY Low",   recentSSL_bar := liq_nyl_bar

//============================================================
  // A+ SETUP SEQUENCE — sweep → SOS → fib entry, IN ORDER
//============================================================
// The A+ model is a sequence, not a checklist. Each stage only counts if the
// previous one is already done:
   // 1. SWEEP — liquidity taken at a tracked HTF pool (H4 / PD / session H-L).
      // Those levels ARE the points of interest, so a sweep firing means price
      // both reached the POI and grabbed the resting stops there.
   // 2. MSS — an external SOS that fires AFTER the sweep, within the window.
   // 3. ENTRY — the SOS leg's fib retracement:
        // 0.5 tapped   -> A+ EARLY  (early entry tier)
        // 0.618 reached -> A+ READY (full entry zone, E1-E3)
      // A live clean FVG overlapping the entry zone is flagged as confluence.
// The sequence dies on: opposite SOS, close past the fib 1.0 (leg invalidated),
// or TP3 hit (cycle complete). It then waits for the next sweep.

var int  aplusL_sweepBar = na
var int  aplusL_sosBar   = na
var int  aplusL_armTime  = na    // timestamp the sweep/div arm fired — window is measured in TIME, not bars
// Per-source arm timestamps — track a live sweep arm and a live divergence arm
// SEPARATELY so the 1/3 row can state which fired (Sweep / Div / Sweep+Div) and each
// can age out on its own window (sweep = aplusSweepWindow, div = aplusWindow). na = that
// source is not currently contributing to the Stage-1 arm.
var int  aplusL_swpArmT  = na
var int  aplusL_divArmT  = na
var int  aplusS_swpArmT  = na
var int  aplusS_divArmT  = na
var bool aplusL_half     = false // A+-owned 0.5 latch — survives fib redraw at session gap
var bool aplusL_618      = false // A+-owned 0.618 latch (E1)
var bool aplusL_702      = false // A+-owned 0.702 latch (E2)
var bool aplusL_786      = false // A+-owned 0.786 latch (E3)
var bool aplusL_886      = false // A+-owned 0.886 latch (E4)
var bool aplusL_fvgTap   = false // price actually traded INTO a matching FVG in the zone
// The SAME tap, UNGATED by depth (Aaron, 2026-07-30). aplusL_fvgTap can only arm in the
// 0.5-to-0.618 window because it means "an early entry was taken"; this one just records
// that a direction-matched gap ANYWHERE in the 0.5–0.886 zone has been traded into. It
// is what lets the DEEP rows name the gap while they are still waiting — the Sniper Zone
// was already reported there and the gap was not, so a deep row could sit on a tapped
// gap and say nothing about it.
var bool aplusL_fvgZone  = false
var bool aplusL_szTap    = false // price actually traded INTO the aligned Sniper Zone
var int  aplusS_sweepBar = na
var int  aplusS_sosBar   = na
var int  aplusS_armTime  = na
var bool aplusS_half     = false
var bool aplusS_618      = false
var bool aplusS_702      = false
var bool aplusS_786      = false
var bool aplusS_886      = false
var bool aplusS_fvgTap   = false
var bool aplusS_fvgZone  = false
var bool aplusS_szTap    = false

// Deep-entry (0.618-0.886) confirmation + scale/stop-profit latches.
   // _1mSawOpp : observed the 1m in the OPPOSITE direction while in the deep zone
               // (needed so the shift is a genuine turn, not an already-aligned 1m).
   // _1mShift  : the 1m then turned into the trade direction — the shift of structure.
   // _deepFvg  : a matching FVG was retested AFTER that 1m shift — the deep-entry trigger.
   // _scaleHit : price reached the scale/stop-profit level (0.382 for an early 0.5 entry,
               // 0.5/TP1 for a deeper entry).
var bool aplusL_1mSawOpp = false
var bool aplusL_1mShift   = false
var bool aplusL_deepFvg   = false
var bool aplusL_tp50      = false   // reached 0.5 going OUT (a TP only for a deep entry)
var bool aplusL_tp382     = false   // reached 0.382 going OUT
var bool aplusL_tp0       = false   // reached 0.0 / TP3 going OUT
var bool aplusS_1mSawOpp = false
var bool aplusS_1mShift   = false
var bool aplusS_deepFvg   = false
var bool aplusS_tp50      = false
var bool aplusS_tp382     = false
var bool aplusS_tp0       = false

// RE-ENTRY state. _leftZone = a TP is banked AND price is currently outside the deep
// entry zone — the return-detector is armed. _reentry = the leg has been reset by a
// return to the zone and is waiting for a fresh 1m SOS. See the reset block below the
// TP tracking for the rule.
//
// This was an int high-water mark (_deepSeen, "the deepest tier reached so far") until
// 2026-07-31. It could only ever fire on a tier price had NEVER visited, and the tier
// latches it read are sticky, so the depth it compared against never fell. A second
// visit to a zone already reached scored equal, not greater, and the reset was skipped:
// the row stayed on TAKE PROFIT with the previous entry's 1m confirmation still latched,
// and never went back to asking for a 1m SOS. A leg could re-enter at most four times,
// each one strictly deeper than the last. A ROUND TRIP is the real event, so that is
// what it detects now — leave the zone, come back, reset. Every time, at any depth.
var bool aplusL_leftZone = false, var bool aplusL_reentry = false
var bool aplusS_leftZone = false, var bool aplusS_reentry = false

// (HTF-POI latch removed to save compile tokens — it was computed but never displayed.)

// Last SOS on each side, remembered so a divergence that confirms LATE can still
// reach it (see the retro-link below).
var int lastBullSosBar = na, var int lastBullSosTime = na
var int lastBearSosBar = na, var int lastBearSosTime = na
if st.bull_sos
    lastBullSosBar := bar_index, lastBullSosTime := time
if st.bear_sos
    lastBearSosBar := bar_index, lastBearSosTime := time

// Stage 1 — arm on the EXACT bar a NEW sweep or NEW divergence fires (true edge
// triggers, not "is this condition currently true"). recentSSL_bar/recentBSL_bar
// are recomputed fresh each bar from the liquidity sources and only CHANGE VALUE
// on the bar a genuinely more recent sweep becomes the newest one; lastBullDivBar/
// lastBearDivBar likewise only change on the bar a new divergence confirms. Edge-
// triggering this way means there is no stale state to accidentally re-arm from —
// the event has to newly happen, not merely still be "active".
// Session-gap detector — first bar after a market close (e.g. daily 17:00-18:00)
// has a time jump much larger than the normal bar spacing.
int  barGap    = na(time[1]) ? 0 : time - time[1]
int  normalGap = na(time[1]) or na(time[2]) ? 0 : time[1] - time[2]
bool sessionGapBar = normalGap > 0 and barGap > normalGap * 2

bool newSweepL = recentSSL != "" and recentSSL_bar != recentSSL_bar[1] and not sessionGapBar
bool newDivL   = not na(lastBullDivBar) and lastBullDivBar != lastBullDivBar[1]

// Daily-level sweeps go stale after one day — a "Day Low" sweep from 3 days ago
// is no longer meaningful fuel for a fresh setup. Only the PREVIOUS day's sweep
// (or newer) counts; H4/session sweeps are inherently short-lived already and
// aren't capped here.
bool dailySweepTooOldL = newSweepL and recentSSL == "Day Low" and not na(liq_dl_t) and time - liq_dl_t > 86400000
if dailySweepTooOldL
    newSweepL := false

// Arm ONLY when nothing is already tracking on this side. Once armed (Stage 1)
// or locked (Stage 2), the arm is frozen — a rotating liquidity source (e.g. the
// daily flipping from Day-Low-swept to Day-High-swept at the session boundary)
// changes recentSSL_bar, but it must NOT overwrite or re-trigger a live arm. The
// arm only clears through a real death: opposite SOS, TP3, or invalidation.
bool aplusL_canArm = na(aplusL_sweepBar) and na(aplusL_sosBar)
// Sweep and divergence each register their own timestamp. The FIRST to fire creates
// the arm (sets sweepBar/armTime); a second, different source firing while still at
// Stage 1 (no SOS yet) joins it — that overlap is what shows as "Sweep+Div".
if newSweepL and not aplusDivOnly and na(aplusL_sosBar)
    if aplusL_canArm
        aplusL_sweepBar := recentSSL_bar
        aplusL_armTime  := time
    aplusL_swpArmT := time
if newDivL and na(aplusL_sosBar)
    if na(aplusL_sweepBar)
        aplusL_sweepBar := lastBullDivBar
        aplusL_armTime  := time
    aplusL_divArmT := time

// Retro-link — a divergence pivot only CONFIRMS divPivotLen bars after the low it
// marks. On a fast V-reversal the SOS fires inside that lag, so by the time the
// divergence arms Stage 1 the SOS has already come and gone and the forward-only
// Stage 2 check below never sees it — the setup sticks at 1/3 forever. If the last
// bull SOS landed at or after the divergence's pivot bar (so the sequence really
// did run div -> SOS) and is still inside the staleness window, adopt it.
if newDivL and not na(aplusL_sweepBar) and na(aplusL_sosBar) and not na(lastBullSosBar) and lastBullSosBar >= lastBullDivBar and (aplusIgnoreWindow or time - lastBullSosTime <= aplusWindow * 60000)
    aplusL_sosBar := lastBullSosBar

bool newSweepS = recentBSL != "" and recentBSL_bar != recentBSL_bar[1] and not sessionGapBar
bool newDivS   = not na(lastBearDivBar) and lastBearDivBar != lastBearDivBar[1]

bool dailySweepTooOldS = newSweepS and recentBSL == "Day High" and not na(liq_dh_t) and time - liq_dh_t > 86400000
if dailySweepTooOldS
    newSweepS := false

bool aplusS_canArm = na(aplusS_sweepBar) and na(aplusS_sosBar)
if newSweepS and not aplusDivOnly and na(aplusS_sosBar)
    if aplusS_canArm
        aplusS_sweepBar := recentBSL_bar
        aplusS_armTime  := time
    aplusS_swpArmT := time
if newDivS and na(aplusS_sosBar)
    if na(aplusS_sweepBar)
        aplusS_sweepBar := lastBearDivBar
        aplusS_armTime  := time
    aplusS_divArmT := time

// Mirror of the bull retro-link above.
if newDivS and not na(aplusS_sweepBar) and na(aplusS_sosBar) and not na(lastBearSosBar) and lastBearSosBar >= lastBearDivBar and (aplusIgnoreWindow or time - lastBearSosTime <= aplusWindow * 60000)
    aplusS_sosBar := lastBearSosBar

// Stage 2 — SOS must fire after the sweep, within the staleness window
if st.bull_sos and not na(aplusL_armTime) and (aplusIgnoreWindow or time - aplusL_armTime <= aplusWindow * 60000)
    aplusL_sosBar := bar_index
if st.bear_sos and not na(aplusS_armTime) and (aplusIgnoreWindow or time - aplusS_armTime <= aplusWindow * 60000)
    aplusS_sosBar := bar_index

// Detect the first bar after a SESSION GAP (e.g. the daily 17:00-18:00 close).
// On that bar `time` jumps by far more than the normal bar spacing, and the
// daily security bar rolls — which was falsely tripping the stale-window clear
// and resetting live arms. Skip the stale check on any bar whose gap from the
// previous bar is more than 2x the normal spacing.

// Clear a stale arm — sweep/div fired but no SOS followed within the window.
// Without this, aplusL_sweepBar stays set FOREVER even after the A+ row has
// already fallen back to "Pass" (the display checks the window; this variable
// didn't), which permanently blocked CONT from ever arming again.
if not aplusIgnoreWindow and not sessionGapBar and not na(aplusL_sweepBar) and na(aplusL_sosBar) and not na(aplusL_armTime) and time - aplusL_armTime > aplusWindow * 60000
    aplusL_sweepBar := na
    aplusL_armTime := na
    aplusL_swpArmT := na, aplusL_divArmT := na
if not aplusIgnoreWindow and not sessionGapBar and not na(aplusS_sweepBar) and na(aplusS_sosBar) and not na(aplusS_armTime) and time - aplusS_armTime > aplusWindow * 60000
    aplusS_sweepBar := na
    aplusS_armTime := na
    aplusS_swpArmT := na, aplusS_divArmT := na

// Per-source staleness caps — ALWAYS enforced (independent of aplusIgnoreWindow).
// A sweep arm ages out after aplusSweepWindow minutes, a divergence arm after
// aplusWindow minutes. Only while still at Stage 1 (no SOS locked). Once BOTH
// sources on a side have aged out with no SOS, the whole arm dies — this is the
// hard "stale fuel" filter: a day-old sweep or a 3-day-old divergence stops arming.
if na(aplusL_sosBar) and not sessionGapBar
    if not na(aplusL_swpArmT) and time - aplusL_swpArmT > aplusSweepWindow * 60000
        aplusL_swpArmT := na
    if not na(aplusL_divArmT) and time - aplusL_divArmT > aplusWindow * 60000
        aplusL_divArmT := na
    if not na(aplusL_sweepBar) and na(aplusL_swpArmT) and na(aplusL_divArmT)
        aplusL_sweepBar := na, aplusL_armTime := na
if na(aplusS_sosBar) and not sessionGapBar
    if not na(aplusS_swpArmT) and time - aplusS_swpArmT > aplusSweepWindow * 60000
        aplusS_swpArmT := na
    if not na(aplusS_divArmT) and time - aplusS_divArmT > aplusWindow * 60000
        aplusS_divArmT := na
    if not na(aplusS_sweepBar) and na(aplusS_swpArmT) and na(aplusS_divArmT)
        aplusS_sweepBar := na, aplusS_armTime := na

// Sequence death. Opposite SOS kills the A+ tracking on that side — the trend
// it was riding just reversed. ANY SOS (either direction) also clears CONT on
// BOTH sides — an SOS is, by definition, a fresh reversal event, never a
// continuation. Without this, a stale CONT armed from an earlier BOS could
// keep showing even after a brand new SOS has since fired on that very side —
// backwards, since once an SOS prints we're back in A+ (reversal) territory
// until a genuine new BOS re-arms CONT on the far side of that fresh leg.
if st.bear_sos and not sessionGapBar
    aplusL_sosBar := na, aplusL_sweepBar := na, aplusL_armTime := na, aplusL_swpArmT := na, aplusL_divArmT := na
if st.bull_sos and not sessionGapBar
    aplusS_sosBar := na, aplusS_sweepBar := na, aplusS_armTime := na, aplusS_swpArmT := na, aplusS_divArmT := na
// A+ leg resolution: completion (TP3), invalidation (close past 1.0 or fib
// flipped), or a CONTINUATION BOS once the SOS stage was already reached. That
// last case is the one you're describing: the SOS fires, price never completes
// the retrace, and instead breaks structure again in the same direction — the
// leg has moved on without ever giving the fib entry, so the A+'s premise is
// over and tracking hands off to CONT. Critically this must exclude the SOS's
// OWN bar: your structure engine flags bull_bos = true on every bull_sos bar
// too (they're not mutually exclusive), so without "not st.bull_sos" here, the
// very bar that arms stage 2 would immediately kill itself.
// B LEG capture — this is the EXACT case the B LEG tracker below owns: the REV is
// about to die on a continuation BOS while still at 2/3 (no retrace yet — neither
// the 0.5 nor the 0.618 latch is set). Must be read HERE, before the death block
// clears aplusL_sosBar/aplusS_sosBar and the latches. A death for any other reason
// (TP3 done, fib flipped, 1.0 broken) is a real failure and does NOT arm a B leg.
bool bLegArmL = not na(aplusL_sosBar) and not sessionGapBar and st.bull_bos and not st.bull_sos and not aplusL_half and not aplusL_618 and fibo_dir == 1 and not fibo7Touched
bool bLegArmS = not na(aplusS_sosBar) and not sessionGapBar and st.bear_bos and not st.bear_sos and not aplusS_half and not aplusS_618 and fibo_dir == -1 and not fibo7Touched
if not na(aplusL_sosBar) and not sessionGapBar
    if (fibo_dir == 1 and fibo7Touched) or fibo_dir == -1 or (fibo_dir == 1 and not na(fiboP10) and close < fiboP10) or (st.bull_bos and not st.bull_sos)
        aplusL_sosBar := na, aplusL_sweepBar := na, aplusL_armTime := na, aplusL_swpArmT := na, aplusL_divArmT := na
if not na(aplusS_sosBar) and not sessionGapBar
    if (fibo_dir == -1 and fibo7Touched) or fibo_dir == 1 or (fibo_dir == -1 and not na(fiboP10) and close > fiboP10) or (st.bear_bos and not st.bear_sos)
        aplusS_sosBar := na, aplusS_sweepBar := na, aplusS_armTime := na, aplusS_swpArmT := na, aplusS_divArmT := na

// (CONT trigger + leg-resolution removed to save compile tokens — the CONT rows are
// currently disabled in the table.)

// Live "tapped into" detection for THIS bar — did price actually trade inside a
// matching FVG in the entry zone, or inside the matching Sniper Zone (not merely
// have one present nearby). Latched below so the table can report exactly which
// confluence price reached, even after the gap is later mitigated.
// Entry FVG = 1-MINUTE only (see f_latest1mFvg / fvg1* above). The entry trigger is the
// newest live 1m gap that overlaps the 15m entry zone (0.5-0.886) with price tapping it —
// the gap you actually enter on, not the 15m gap. Feeds BOTH the early (0.5) and the deep
// (0.618+) entry confirmations below.
bool aplusL_fvgInNow = not na(fvg1BullTop) and not na(fiboP2) and not na(fiboP6) and fibo_dir == 1 and fvg1BullBot <= fiboP2 and fvg1BullTop >= fiboP6 and low <= fvg1BullTop and high >= fvg1BullBot
bool aplusS_fvgInNow = not na(fvg1BearTop) and not na(fiboP2) and not na(fiboP6) and fibo_dir == -1 and fvg1BearTop >= fiboP2 and fvg1BearBot <= fiboP6 and low <= fvg1BearTop and high >= fvg1BearBot
// SZ tap is a PRECISE per-bar geometric test (price range overlaps the sniper
// box THIS bar), not the global sniperZoneActive latch — that latch can already
// be true from a tap that happened before the entry context, which falsely
// stamped "+ SZ" onto setups whose zone was never actually reached on the retrace.
bool _szTapNow = not na(sniperZoneTop) and not na(sniperZoneBot) and low <= sniperZoneTop and high >= sniperZoneBot

// ── 1m entry-zone tracker (drives the REV SETUP row on the 1m chart) ──
// On the 1m chart the row tracks the DRAWN aligned fib directly, so it updates as
// price retraces IN — deep level touched (0.618–0.886), a 1m FVG in the 0.5–0.886
// zone (READY), the aligned Sniper Zone tapped (ULTIMATE) — read from the chart's
// own fib touch flags, NOT the lean 15m security skeleton. These two latches hold
// the FVG/SZ taps while the aligned fib is showing; they reset when it hides
// (countering SOS / no aligned SOS) or a new leg prints.
// Scan the chart's OWN drawn FVGs (up to Max Active) for one matching the trade
// direction inside the 0.5–0.886 entry zone that price is tapping THIS bar. The lean
// 15m security feed only carried the single newest 1m gap and dropped any gap the
// moment price closed past it, so it kept missing the gaps you actually see drawn.
// Direction-matched: a bearish gap for a short, a bullish gap for a long.
// Scans the CHART's own drawn gaps — so on a 15m chart these are 15m FVGs, on a 1m
// chart 1m FVGs. Renamed off "f_fvg1mInZone" 2026-07-30: the old name claimed 1m and
// the A+ early entry now uses it on the 15m, where 1m would have been a lie.
f_fvgInZone(bool wantBull, float zLo, float zHi) =>
    bool hit = false
    if not na(zLo) and not na(zHi) and array.size(fvgBoxes) > 0
        for i = 0 to array.size(fvgBoxes) - 1
            if array.get(fvgIsBull, i) == wantBull
                float gT = array.get(fvgTops, i)
                float gB = array.get(fvgBots, i)
                if gT >= zLo and gB <= zHi and low <= gT and high >= gB
                    hit := true
    hit

var bool rev1mEntryFvg = false, var bool rev1mEntrySz = false
bool _rev1mA = timeframe.in_seconds() == 60 and fiboShowAligned and fibo_dir != 0
// EARLY entry band = 0.382–0.886 (fiboP1..fiboP6): a direction-matched 1m FVG anywhere
// from the 0.382 line down to 0.886, tapped, counts as an entry. The shallow edge is
// nudged 25% PAST 0.382 toward 0.0 (fiboP7) so a gap sitting ON the 0.382 line — its
// body poking a hair above it — still overlaps the band instead of being excluded for
// sitting just above the boundary. Works both directions (0.382→0.0 flips with fibo_dir).
float _rev1mZLo = na, float _rev1mZHi = na
if _rev1mA and not na(fiboP1) and not na(fiboP6) and not na(fiboP7)
    float _rev1mShallow = fiboP1 + (fiboP7 - fiboP1) * 0.25
    _rev1mZLo := math.min(fiboP6, _rev1mShallow)
    _rev1mZHi := math.max(fiboP6, _rev1mShallow)
bool _rev1mReset = not _rev1mA or fiboOriginChanged
rev1mEntryFvg := _rev1mReset ? false : (rev1mEntryFvg or f_fvgInZone(fibo_dir == 1, _rev1mZLo, _rev1mZHi))
rev1mEntrySz  := _rev1mReset ? false : (rev1mEntrySz  or (_szTapNow and (sz_bullish == (fibo_dir == 1))))

// ── EARLY (0.5) entry trigger — the CHART's own gap, not the 1m feed ──
// Aaron's call 2026-07-30, off a live 15m chart showing a gap sitting on 0.5 while the
// row still read AWAIT. The two entry tiers are NOT confirmed the same way, and this is
// the whole asymmetry of the setup:
//   EARLY (0.5)   — a shallow retrace. The 15m gap at the level IS the entry; that is
//                   the gap the trade is taken on and the one drawn in front of you.
//   DEEP (0.618+) — price went further against the idea, so it must prove more: the 1m
//                   turns first (aplusX_1mShift), THEN a 1m gap retests. Unchanged below.
// The old early rule required a 1-MINUTE gap, and worse, the 15m chart only ever sees
// the single newest 1m gap per direction (f_latest1mFvg keeps one and drops it on
// mitigation) — so a genuine 15m gap on 0.5 could never arm the row, and even a valid
// 1m one was forgotten the moment a newer 1m gap printed anywhere.
float _apZLo = na, float _apZHi = na
if not na(fiboP2) and not na(fiboP6)
    _apZLo := math.min(fiboP2, fiboP6)
    _apZHi := math.max(fiboP2, fiboP6)
bool aplusL_fvgEarlyNow = fibo_dir == 1  and f_fvgInZone(true,  _apZLo, _apZHi)
bool aplusS_fvgEarlyNow = fibo_dir == -1 and f_fvgInZone(false, _apZLo, _apZHi)

// Stage 3 — entry zone progress on the SOS leg's fib
// EARLY = 0.5 tapped inbound, READY = 0.618 reached (E1-E3 zone live)
// Latch the A+'s own 0.5/0.618/0.702/0.786/0.886 progress + which confluence was
// actually tapped, while its SOS is live. These persist through a fib-origin
// redraw (session gap) that would otherwise reset the global touched flags.
if not na(aplusL_sosBar)
    aplusL_half   := aplusL_half   or fiboHalfReached
    aplusL_618    := aplusL_618    or fibo618EverReached
    aplusL_702    := aplusL_702    or fibo4Touched
    aplusL_786    := aplusL_786    or fibo5Touched
    aplusL_886    := aplusL_886    or fibo6Touched
    // EARLY tier only — the chart's own (15m) gap. The DEEP tier below still reads
    // aplusL_fvgInNow, the 1m gap, and only after the 1m shift.
    // `not aplusL_618` is what keeps the two tiers separate, and it is load-bearing.
    // The tap zone spans 0.5–0.886, so WITHOUT this gate a gap tapped at 0.7 on a
    // straight run down would latch the EARLY entry — and the deep tier's whole point
    // is that a retrace that far has to prove more than a gap. Gated, the latch can
    // only arm in the 0.5-to-0.618 window, so it means exactly one thing: an early
    // entry was genuinely taken BEFORE price went deep.
    aplusL_fvgTap := aplusL_fvgTap or (not aplusL_618 and aplusL_fvgEarlyNow)
    // Ungated twin — same tap, no depth gate. See aplusL_fvgZone's declaration.
    aplusL_fvgZone := aplusL_fvgZone or aplusL_fvgEarlyNow
    // SZ is latched off the PRECISE per-bar tap (_szTapNow), never off "a zone
    // exists" — see the warning at _szTapNow's own declaration. Until 2026-07-30 the
    // table's +SZ tag read `not na(sniperZoneTop) and sz_bullish == uLong`, which is
    // true whenever an aligned zone is anywhere on the chart, at any price. That is
    // the exact false stamp that comment was written about; the 1m row was fixed for
    // it and this one was missed, so +SZ appeared on setups that never reached a zone.
    aplusL_szTap  := aplusL_szTap  or (_szTapNow and sz_bullish)
else
    aplusL_half := false, aplusL_618 := false
    aplusL_702 := false, aplusL_786 := false, aplusL_886 := false
    aplusL_fvgTap := false, aplusL_szTap := false, aplusL_fvgZone := false
if not na(aplusS_sosBar)
    aplusS_half   := aplusS_half   or fiboHalfReached
    aplusS_618    := aplusS_618    or fibo618EverReached
    aplusS_702    := aplusS_702    or fibo4Touched
    aplusS_786    := aplusS_786    or fibo5Touched
    aplusS_886    := aplusS_886    or fibo6Touched
    aplusS_fvgTap := aplusS_fvgTap or (not aplusS_618 and aplusS_fvgEarlyNow)
    aplusS_fvgZone := aplusS_fvgZone or aplusS_fvgEarlyNow
    aplusS_szTap  := aplusS_szTap  or (_szTapNow and not sz_bullish)
else
    aplusS_half := false, aplusS_618 := false
    aplusS_702 := false, aplusS_786 := false, aplusS_886 := false
    aplusS_fvgTap := false, aplusS_szTap := false, aplusS_fvgZone := false

// Deep-entry confirmation (0.618+): a genuine 1m shift IN the trade direction, then a
// matching FVG retest. Plus multi-level take-profit / scale tracking. Latches clear when
// the leg dies (else branch). TP/scale tracking is ONE-DIRECTIONAL: once 0.5 / 0.382 /
// TP3 are banked they stay banked for the life of the leg. A pullback to 0.5 after TP1 or
// TP2 is NOT a new entry and NOT a new scale — the row only ever reads forward.
if not na(aplusL_sosBar)
    if aplusL_618                                         // price reached the deep zone
        if mtf1Dir == -1
            aplusL_1mSawOpp := true                       // saw the 1m still bearish
        if aplusL_1mSawOpp and mtf1Dir == 1 and not aplusL_1mShift
            aplusL_1mShift := true                        // 1m turned bullish → shift
        if aplusL_1mShift and aplusL_fvgInNow
            aplusL_deepFvg := true                        // FVG retested after the shift
    // Take profits — only AFTER an entry tier was reached on a PRIOR bar (one-bar delay),
    // so a single volatile bar that taps 0.5 and 0.382 together can't skip straight to
    // SCALE and hide the 0.5 early entry. 0.5 is a TP only for a deep entry (it's the
    // entry itself when early).
    if aplusL_618[1] or aplusL_half[1]
        if aplusL_618 and not na(fiboP2) and high >= fiboP2
            aplusL_tp50 := true
        // 0.382 is the SECOND scale for a deep entry (only after 0.5 banked on a prior
        // bar); the FIRST scale for an early 0.5 entry (fires directly).
        if not na(fiboP1) and high >= fiboP1 and (not aplusL_618 or aplusL_tp50[1])
            aplusL_tp382 := true
        if not na(fiboP7) and high >= fiboP7 and aplusL_tp382[1]
            aplusL_tp0 := true
else
    aplusL_1mSawOpp := false, aplusL_1mShift := false, aplusL_deepFvg := false
    aplusL_tp50 := false, aplusL_tp382 := false, aplusL_tp0 := false
    aplusL_leftZone := false, aplusL_reentry := false
if not na(aplusS_sosBar)
    // One-directional, mirror of LONG — banked TPs never clear on a pullback.
    if aplusS_618
        if mtf1Dir == 1
            aplusS_1mSawOpp := true
        if aplusS_1mSawOpp and mtf1Dir == -1 and not aplusS_1mShift
            aplusS_1mShift := true
        if aplusS_1mShift and aplusS_fvgInNow
            aplusS_deepFvg := true
    if aplusS_618[1] or aplusS_half[1]
        if aplusS_618 and not na(fiboP2) and low <= fiboP2
            aplusS_tp50 := true
        if not na(fiboP1) and low <= fiboP1 and (not aplusS_618 or aplusS_tp50[1])
            aplusS_tp382 := true
        if not na(fiboP7) and low <= fiboP7 and aplusS_tp382[1]
            aplusS_tp0 := true
else
    aplusS_1mSawOpp := false, aplusS_1mShift := false, aplusS_deepFvg := false
    aplusS_tp50 := false, aplusS_tp382 := false, aplusS_tp0 := false
    aplusS_leftZone := false, aplusS_reentry := false

// ── RE-ENTRY reset ──
// The case: an entry banks a TP, price runs away, and then price comes BACK into the
// deep entry zone. That is not the shallow pullback the one-directional TP rule exists
// to ignore; it is the market handing the zone back. So the leg RESETS: the banked TPs
// and the 1m entry confirmations clear, and the row goes back to waiting for a fresh 1m
// SOS — tagged RE-ENTRY so it reads as a second bite, not a first one. When price then
// works back out to 0.5 it prints its partial again, exactly as a normal deep entry
// would.
//
// A ROUND TRIP, not a new depth record (Aaron, 2026-07-31). It takes two bars to fire
// and they must be on opposite sides of 0.618:
//   ARM   — a TP is banked and price is OUTSIDE the zone. The trade left.
//   FIRE  — price trades back INSIDE. The zone is available again.
// The out-of-zone half of the arm is what stops a single wide bar that both banks a TP
// and dips to 0.618 from resetting the row, and what stops the two rules ping-ponging
// bar to bar while price sits on the boundary.
//
// This replaces a high-water-mark test (deepest tier ever reached > deepest tier seen).
// That version could only fire on a tier price had never visited, so the SECOND return
// to a zone scored equal, not greater, and was ignored — the row stayed on TAKE PROFIT
// carrying the first entry's 1m confirmation and never asked for a fresh 1m SOS again.
// Round trips have no such ceiling: the zone can be handed back any number of times, at
// any depth, and each one resets.
bool aplusL_inZoneNow = fibo_dir == 1  and not na(fiboP3) and low  <= fiboP3
bool aplusS_inZoneNow = fibo_dir == -1 and not na(fiboP3) and high >= fiboP3
// Set only on the bar the reset fires — the one-way inTrade latch reads it further down,
// where it is declared. It cannot be cleared from here.
bool aplusL_reentryNow = false
bool aplusS_reentryNow = false
if not na(aplusL_sosBar) and (aplusL_tp50 or aplusL_tp382 or aplusL_tp0) and not aplusL_inZoneNow
    aplusL_leftZone := true
else if not na(aplusL_sosBar) and aplusL_leftZone and aplusL_inZoneNow
    aplusL_leftZone := false
    aplusL_tp50 := false, aplusL_tp382 := false, aplusL_tp0 := false
    aplusL_1mSawOpp := false, aplusL_1mShift := false, aplusL_deepFvg := false
    aplusL_fvgTap := false, aplusL_szTap := false, aplusL_fvgZone := false
    aplusL_reentry := true, aplusL_reentryNow := true
if not na(aplusS_sosBar) and (aplusS_tp50 or aplusS_tp382 or aplusS_tp0) and not aplusS_inZoneNow
    aplusS_leftZone := true
else if not na(aplusS_sosBar) and aplusS_leftZone and aplusS_inZoneNow
    aplusS_leftZone := false
    aplusS_tp50 := false, aplusS_tp382 := false, aplusS_tp0 := false
    aplusS_1mSawOpp := false, aplusS_1mShift := false, aplusS_deepFvg := false
    aplusS_fvgTap := false, aplusS_szTap := false, aplusS_fvgZone := false
    aplusS_reentry := true, aplusS_reentryNow := true

// Stage 2+ is defined by SOS presence alone (not fibo_dir, which flickers at
// the daily rollover and was resetting live setups back to 1/3 at the gap).
int aplusL_stage = 0
if not na(aplusL_sosBar)
    aplusL_stage := aplusL_618 ? 4 : aplusL_half ? 3 : 2
else if not na(aplusL_sweepBar)
    aplusL_stage := 1

int aplusS_stage = 0
if not na(aplusS_sosBar)
    aplusS_stage := aplusS_618 ? 4 : aplusS_half ? 3 : 2
else if not na(aplusS_sweepBar)
    aplusS_stage := 1

//============================================================
  // CONTINUATION SETUP — DISABLED 2026-07-22 while the setup is refined
//============================================================
// The chart-side CONT engine is commented out in full. Nothing else reads contL_*/
// contS_*, so the REV, B LEG and 1m ENTRY paths are untouched by its absence. The
// one BEHAVIOUR change is in the table: REV used to be hard-suppressed whenever a
// CONT was live (the hand-off). With no CONT there is nothing to defer to, so REV
// now shows at every stage it reaches. That is the intended effect of turning CONT
// off, not a side effect to fix.
////============================================================
////  CONTINUATION SETUP — trend-aligned BOS → retrace → entry
////============================================================
//// The MIRROR of the reversal sequence, locked to the trend so it NEVER tracks a
//// counter-trend trade. It arms on a trend-aligned continuation BOS — NOT a sweep and
//// NOT an SOS (those belong to REV) — retraces into that leg's 0.5–0.886, and enters on
//// the SAME 1m FVG trigger as REV. Only ONE side can ever arm: a bull BOS only fires
//// while 15m is bullish (a bull break in a bear 15m trend is an SOS → REV), so direction
//// is self-locking — that is the ONLY direction filter. The 4H does NOT gate or annotate
//// this trade: the first continuation BOS tracks on its own merit.
//// 15m-locked, like the REV engine's chart side (aplusL_*/aplusS_*).
//var int  contL_bosBar = na
//var bool contL_half   = false
//var bool contL_618    = false
//var bool contL_fvgTap = false
//var int  contS_bosBar = na
//var bool contS_half   = false
//var bool contS_618    = false
//var bool contS_fvgTap = false

//// Arm / re-anchor on each trend-aligned continuation BOS (clears the retrace latches so
//// CONT follows the newest leg, exactly as the drawn fib re-anchors). An SOS bar never
//// arms it (not st.bull_sos / not st.bear_sos) — that is a REV shift, not a continuation.
//if st.bull_bos and not st.bull_sos
    // contL_bosBar := bar_index
    // contL_half := false, contL_618 := false, contL_fvgTap := false
//if st.bear_bos and not st.bear_sos
    // contS_bosBar := bar_index
    // contS_half := false, contS_618 := false, contS_fvgTap := false

//// Death: opposite SOS (trend changed → REV owns it now), the fib flipping, a close past
//// the fib 1.0 (leg invalid), or TP3 (cycle done).
//if not na(contL_bosBar) and (st.bear_sos or fibo_dir == -1 or (fibo_dir == 1 and fibo7Touched) or (fibo_dir == 1 and not na(fiboP10) and close < fiboP10))
    // contL_bosBar := na, contL_half := false, contL_618 := false, contL_fvgTap := false
//if not na(contS_bosBar) and (st.bull_sos or fibo_dir == 1 or (fibo_dir == -1 and fibo7Touched) or (fibo_dir == -1 and not na(fiboP10) and close > fiboP10))
    // contS_bosBar := na, contS_half := false, contS_618 := false, contS_fvgTap := false

//// Retrace progress — reuse the chart fib touch flags + the 1m FVG entry trigger.
//if not na(contL_bosBar)
    // contL_half   := contL_half   or fiboHalfReached
    // contL_618    := contL_618    or fibo618EverReached
    // contL_fvgTap := contL_fvgTap or aplusL_fvgInNow
//if not na(contS_bosBar)
    // contS_half   := contS_half   or fiboHalfReached
    // contS_618    := contS_618    or fibo618EverReached
    // contS_fvgTap := contS_fvgTap or aplusS_fvgInNow

//int contL_stage = na(contL_bosBar) ? 0 : contL_618 ? 3 : contL_half ? 2 : 1
//int contS_stage = na(contS_bosBar) ? 0 : contS_618 ? 3 : contS_half ? 2 : 1

//============================================================
  // B LEG SETUP — the SOS whose retrace arrived late
//============================================================
// The instance this captures: an SOS fires, price expands and prints a continuation
// BOS BEFORE it ever retraces, so the REV row dies reading "no retracement" and the
// trade looks like a failure. On a higher timeframe that same move is ONE clean leg
// and the retrace DOES arrive — just later.
// The anchor that survives is the SNIPER ZONE drawn at the ORIGINAL SOS (its
// 0.382-0.5 band). The drawn fib re-anchors on the BOS; the SZ band does not. So the
// B leg freezes that band at the SOS and waits for price to trade back into it —
// which is where the retrace lands most of the time.
// Runs fully PARALLEL: it READS the REV/CONT state and never writes to it. Neither
// row changes behaviour — this only adds its own row.
var float bLegL_top = na, var float bLegL_bot = na, var float bLegL_inv = na, var float bLegL_tgt = na
var bool  bLegL_on = false, var bool bLegL_tap = false, var bool bLegL_tp = false
var int   bLegL_bar = na, var int bLegL_sosBar = na
var float bLegS_top = na, var float bLegS_bot = na, var float bLegS_inv = na, var float bLegS_tgt = na
var bool  bLegS_on = false, var bool bLegS_tap = false, var bool bLegS_tp = false
var int   bLegS_bar = na, var int bLegS_sosBar = na

// Freeze the SZ band on every SOS — the SAME 0.382/0.5 maths the drawn Sniper Zone
// uses, so the band IS the box on your chart. inv = the leg origin (fib 1.0): a close
// past it means the reversal failed outright.
// DEEPEST BAND WINS. When a fresh same-side SOS fires while a B leg is live and still
// UNTAPPED, the two candidate bands are compared by how far price has to travel to
// reach them, and the FARTHER one is kept. Distance is measured to the edge price meets
// first — the 0.5 edge either way (price falls into it on a long, rises into it on a
// short).
// This deliberately reads backwards, so the reasoning matters. The B leg exists to wait
// for a retrace that has NOT happened yet. In a downtrend every new bear SOS prints its
// band lower than the last, so a "keep the nearest band" rule walks the level down the
// chart in step with price and it is tapped immediately by the move already in progress
// — a tap that confirms nothing. The band worth watching is the one price has to travel
// BACK to: the premium the move originated from. That is the deeper one, and normally
// the one frozen at the first SOS of the sequence. A later SOS only takes over when it
// prints a band even further away — a bigger retrace target, never a smaller one.
// The unreachable-band risk this creates is handled by the bar cap below, not here.
// When the new band wins while a leg was live, the WATCH MIGRATES rather than resetting:
// bLegX_on carries over so there is no dormant gap, the tap/TP latches clear because
// this is a different band, and the staleness clock restarts from this bar. The target
// (the expansion extreme = the TP reference) is EXTENDED, never rewound — the move's
// true extreme is still the right take-profit no matter which band is being watched.
// A TAPPED leg has already given its entry, so it never blocks a replacement.
if st.bull_sos and not na(st.bull_bos_high) and not na(st.bull_bos_low) and st.bull_bos_high > st.bull_bos_low
    float _bLR   = st.bull_bos_high - st.bull_bos_low
    float _bLnew = st.bull_bos_low + _bLR * 0.5          // near edge of the candidate band
    bool  _bLwas = bLegL_on and not bLegL_tap            // a live watch is in progress
    // Keep the existing band only if it is live, untapped AND FARTHER from price than
    // the candidate — i.e. it is still the deeper retrace target of the two.
    bool  _bLkeep = _bLwas and not na(bLegL_top) and math.abs(_bLnew - close) <= math.abs(bLegL_top - close)
    if not _bLkeep
        bLegL_bot := st.bull_bos_low + _bLR * 0.382
        bLegL_top := _bLnew
        bLegL_inv := st.bull_bos_low
        bLegL_tgt := _bLwas ? math.max(nz(bLegL_tgt, high), high) : high
        bLegL_sosBar := bar_index
        bLegL_tap := false, bLegL_tp := false
        bLegL_on  := _bLwas
        bLegL_bar := _bLwas ? bar_index : na
if st.bear_sos and not na(st.bear_bos_high) and not na(st.bear_bos_low) and st.bear_bos_high > st.bear_bos_low
    float _bSR   = st.bear_bos_high - st.bear_bos_low
    float _bSnew = st.bear_bos_high - _bSR * 0.5
    bool  _bSwas = bLegS_on and not bLegS_tap
    bool  _bSkeep = _bSwas and not na(bLegS_bot) and math.abs(_bSnew - close) <= math.abs(bLegS_bot - close)
    if not _bSkeep
        bLegS_top := st.bear_bos_high - _bSR * 0.382
        bLegS_bot := _bSnew
        bLegS_inv := st.bear_bos_high
        bLegS_tgt := _bSwas ? math.min(nz(bLegS_tgt, low), low) : low
        bLegS_sosBar := bar_index
        bLegS_tap := false, bLegS_tp := false
        bLegS_on  := _bSwas
        bLegS_bar := _bSwas ? bar_index : na

// Target = how far the expansion ran before the retrace started. Tracked only until
// the B leg arms, then frozen — that extreme is the take-profit reference.
if not na(bLegL_top) and not bLegL_on
    bLegL_tgt := math.max(nz(bLegL_tgt, high), high)
if not na(bLegS_top) and not bLegS_on
    bLegS_tgt := math.min(nz(bLegS_tgt, low), low)

// Arm on the REV's death-by-continuation-BOS (captured above, before the death ran).
if bLegArmL and not na(bLegL_top)
    bLegL_on := true, bLegL_bar := bar_index
if bLegArmS and not na(bLegS_top)
    bLegS_on := true, bLegS_bar := bar_index

// Progress, then death. The SZ TAP *IS* the entry — no FVG, no 1m shift, nothing else
// to wait for. Price trading back into the frozen band is the whole trigger, so the row
// goes straight from ACTIVE to ENTRY on the tap. (REV and CONT still require their 1m
// FVG; the B leg deliberately does not — the band itself is the confirmation.)
// Death is ONLY: a close past the leg origin (1.0), or the staleness cap. NO SOS in
// either direction kills an untapped leg. Not the opposite one — on a short B leg the
// retrace UP into the band is frequently the very move that prints a bullish SOS, so
// killing on it would cancel the leg with what it is waiting for. And not a same-side
// one either — that can only ever MIGRATE the watch to a DEEPER band (see the capture
// block above), it never ends it.
// That leaves the bar cap as the PRIMARY way an unfilled leg ends, not a backstop, so
// it is set deliberately rather than generously: 120 bars = 30 hours of 15m trading,
// about a day and a half. Long enough for the late retrace this setup exists to catch
// (the case that motivated it resolved inside one session), short enough that a band
// price has ignored for two full days stops being presented as a live watch level.
// Kept in BARS, not minutes, so weekends and the daily close don't burn the clock —
// what matters is how much TRADING has passed without the retrace arriving.
int BLEG_MAX = 120
if bLegL_on
    if low <= bLegL_top
        bLegL_tap := true
    if bLegL_tap and not na(bLegL_tgt) and high >= bLegL_tgt
        bLegL_tp := true
    if close < bLegL_inv or bar_index - bLegL_bar > BLEG_MAX
        bLegL_on := false
if bLegS_on
    if high >= bLegS_bot
        bLegS_tap := true
    if bLegS_tap and not na(bLegS_tgt) and low <= bLegS_tgt
        bLegS_tp := true
    if close > bLegS_inv or bar_index - bLegS_bar > BLEG_MAX
        bLegS_on := false

// (The bLegL_st / bLegS_st stage codes — 1 active, 2 tapped, 3 target — were dropped
// with the B LEG table row. The tracker's own latches, bLegX_on / _tap / _tp, are the
// real state and are all the chart drawing needs. Recompute the codes from them if the
// row ever comes back.)

// ── BLEG SZ on the chart ──
// The frozen band, drawn so it can actually be watched instead of living only in the
// table. It appears the moment the B leg ARMS — before that the level is just the
// normal Sniper Zone, which already draws itself — starts back at the SOS bar that
// froze it, and extends right every bar for the leg's whole life. Deleted when the
// leg dies or a fresh SOS replaces the band, so a dead level never lingers.
// Box is grey (it is a watch level, not a signal); the LABEL carries the direction —
// green for a long, red for a short. 15m only, matching the row.
bool  bLegDraw = showBLeg and timeframe.in_seconds() == 900
color BLEG_FILL = color.new(#888888, 82)
color BLEG_EDGE = color.new(#888888, 45)
var box   bLegL_box = na, var label bLegL_lbl = na
var box   bLegS_box = na, var label bLegS_lbl = na

f_bLegDraw(box bx, label lb, bool live, float top, float bot, int fromBar, bool isLong) =>
    box   oB = bx
    label oL = lb
    if live
        if na(oB)
            oB := box.new(fromBar, top, bar_index + i_lineExtend, bot, bgcolor = BLEG_FILL, border_color = BLEG_EDGE, border_width = 1)
            oL := label.new(bar_index + i_lineExtend, (top + bot) / 2, "BLEG SZ", style = label.style_none, textcolor = isLong ? JARVIS_SSL : JARVIS_BSL, size = size.small, textalign = text.align_left)
        else
            // Re-state the band's price bounds and left edge every bar, not just the
            // right edge. Under the nearest-band-wins rule a live watch can MIGRATE to a
            // different band mid-leg; extending rightward alone would leave the box
            // frozen on the abandoned band's prices and its old SOS bar.
            box.set_top(oB, top)
            box.set_bottom(oB, bot)
            box.set_left(oB, fromBar)
            box.set_right(oB, bar_index + i_lineExtend)
            label.set_xy(oL, bar_index + i_lineExtend, (top + bot) / 2)
    else if not na(oB)
        box.delete(oB), label.delete(oL)
        oB := na, oL := na
    [oB, oL]

[_bLB, _bLL] = f_bLegDraw(bLegL_box, bLegL_lbl, bLegDraw and bLegL_on, bLegL_top, bLegL_bot, nz(bLegL_sosBar, bar_index), true)
bLegL_box := _bLB, bLegL_lbl := _bLL
[_bSB, _bSL] = f_bLegDraw(bLegS_box, bLegS_lbl, bLegDraw and bLegS_on, bLegS_top, bLegS_bot, nz(bLegS_sosBar, bar_index), false)
bLegS_box := _bSB, bLegS_lbl := _bSL

// ── REV SETUP alert — READY (entry FVG confirmed) ──
// Fires once when the setup reaches READY: the 1m entry FVG has tapped in-zone —
// for a deep (0.618+) entry that's after the 1m shift, for an early 0.5 entry it's
// the straight FVG tap. This is the actual trade trigger. 15m-only (the REV engine's
// live source there). Edge-triggered so it fires on the transition INTO READY.
bool aplusL_ready = (aplusL_stage == 4 and aplusL_deepFvg) or (aplusL_stage == 3 and aplusL_fvgTap)
bool aplusS_ready = (aplusS_stage == 4 and aplusS_deepFvg) or (aplusS_stage == 3 and aplusS_fvgTap)

// ── "You are in" — a ONE-WAY latch per SOS leg, COMMITTED ON BAR CLOSE ──
// The row was seen flipping ENTRY → AWAIT at stage 3 with the fib, the SL and the TP
// all unchanged. The mechanism is Pine's REALTIME ROLLBACK: on the live bar the whole
// script re-runs on EVERY tick, and before each run every `var` is restored to its
// last BAR-CLOSE value. So `x := x or cond` is not a latch on the live bar at all —
// it holds only while cond is still true, and the tick after cond goes false the
// "latch" is gone. That is how an entry gets announced on one tick and taken back on
// the next, with nothing else on the row changing.
// The cure is to commit ONLY on barstate.isconfirmed. At the close the bar's high and
// low span the WHOLE bar, so a gap tapped anywhere inside it is still detected, and a
// value written on a confirmed bar is the one that survives — it is never rolled back.
// From then on the leg reads ENTRY until aplusX_sosBar itself changes, which means a
// different SOS and a genuinely different setup.
// Deliberately monotonic: it can only ever make the row say "you are in" for LONGER,
// never shorter. Telling a trader to wait while they hold a position is the failure
// that costs money; a stale ENTRY is only a nuisance.
var bool aplusL_inTrade = false, var int aplusL_inSos = na
if na(aplusL_sosBar) or aplusL_sosBar != aplusL_inSos
    aplusL_inTrade := false
    aplusL_inSos   := aplusL_sosBar
var bool aplusS_inTrade = false, var int aplusS_inSos = na
if na(aplusS_sosBar) or aplusS_sosBar != aplusS_inSos
    aplusS_inTrade := false
    aplusS_inSos   := aplusS_sosBar
// THE ONE EXCEPTION to "monotonic per SOS leg" (Aaron, 2026-07-31). A re-entry reset
// clears aplusX_deepFvg and aplusX_fvgTap, but this latch used to survive it — and the
// table's deep branch reads `uIn = uInLatch or uDeepFvg or uEarlyFvg`, so the row went
// on printing ENTRY and the RE-ENTRY / "wait 1m SOS" branches were unreachable on any
// leg that had ever confirmed an entry. The reset was doing its work invisibly.
//
// Clearing it here does not weaken what the latch is for. It exists to stop the row
// regressing ENTRY → AWAIT while a position is UNREALISED and going against you — the
// case where being told to wait costs money. A reset only fires after a TP is banked and
// price has made a full round trip out of the zone and back, so by then you are flat or
// on a runner with the stop in profit. That is a different situation and it does not
// need the same guard.
if aplusL_reentryNow
    aplusL_inTrade := false
if aplusS_reentryNow
    aplusS_inTrade := false
if barstate.isconfirmed
    aplusL_inTrade := aplusL_inTrade or aplusL_ready
    aplusS_inTrade := aplusS_inTrade or aplusS_ready
// The two READY alerts that used to sit here are GONE — folded into the alert chain
// below, off the LATCH instead of the raw flag. They fired on `aplusX_ready and not
// aplusX_ready[1]`, and aplusX_ready is not stable across a leg: the RE-ENTRY reset
// clears aplusX_fvgTap / aplusX_deepFvg, so ready goes true → false → true and the
// same setup pinged ENTRY twice. aplusX_inTrade is one-way per SOS leg, so its rising
// edge is exactly one entry alert per setup — the same guarantee the table's row has.


// Deepest fib entry level price has tapped on the retrace — deeper implies the
// shallower ones were already tapped, so this single label names how far in
// price reached (E1=0.618, E2=0.702, E3=0.786, E4=0.886; 0.5 is the early tier).
f_aplusEntryLvl(bool half, bool e618, bool e702, bool e786, bool e886) =>
    e886 ? "0.886" : e786 ? "0.786" : e702 ? "0.702" : e618 ? "0.618" : half ? "0.5" : "entry"

// ── REV SETUP alerts — 2/3, entry zone reached, and setup death ──
// Companion to the READY alert above, which fires only at the trade trigger. These
// three fire EARLIER (and once at the end), so a setup can be watched from the SOS
// rather than found at the moment it's already live.
//
// The tracked side is picked with the SAME rule the JARVIS table uses, so an alert can
// never describe a stage the table isn't showing. Edge-triggered on the stage VALUE, and
// the branches are `else if` on purpose: TradingView CONCATENATES multiple alert() calls
// that fire on one bar into a single newline-joined message, which would break a JSON
// webhook body. Exactly one message per bar, most-advanced state wins.
//
// Every message is PLAIN ASCII with no double quotes and no newlines, so it can be
// dropped straight into a Telegram sendMessage body via {{alert_message}} without a relay.
bool   _alLong = aplusL_stage > 0 and (aplusS_stage == 0 or aplusL_stage >= aplusS_stage)
int    _alStg  = _alLong ? aplusL_stage : aplusS_stage
bool   _alIn   = _alLong ? aplusL_inTrade : aplusS_inTrade
string _alTag  = "MPC A+ " + syminfo.ticker + " " + (_alLong ? "LONG " : "SHORT ")
// PRICES, not ratios — the same rule the LEVELS row exists for, and it binds harder
// here: a phone alert is read AWAY from the chart, so "0.786 tapped" leaves the reader
// with nothing to act on. Entry price is resolved off the deepest tapped tier by the
// SAME expression the LEVELS row uses, so the alert and the table can never quote
// different numbers. The stop is fiboP10 (the 1.0 leg origin) with no partial-banked
// branch, because every alert below fires at a stage TRANSITION — before any rung has
// filled — which is exactly when the LEVELS row would still be quoting fiboP10 too.
string _alLvl = _alLong ? f_aplusEntryLvl(aplusL_half, aplusL_618, aplusL_702, aplusL_786, aplusL_886) : f_aplusEntryLvl(aplusS_half, aplusS_618, aplusS_702, aplusS_786, aplusS_886)
float  _alEnt = _alLvl == "0.886" ? fiboP6 : _alLvl == "0.786" ? fiboP5 : _alLvl == "0.702" ? fiboP4 : _alLvl == "0.618" ? fiboP3 : fiboP2
string _alPx  = na(_alEnt) or na(fiboP10) ? "" : " at " + str.tostring(_alEnt, format.mintick) + " SL " + str.tostring(fiboP10, format.mintick)
if barstate.isconfirmed and timeframe.in_seconds() == 900
    // ENTRY leads the chain — it is the only branch that says DO something now, so it
    // must win any bar where a zone is reached and confirmed together.
    if _alIn and not _alIn[1]
        alert(_alTag + "ENTRY - " + _alLvl + " confirmed" + _alPx, alert.freq_once_per_bar)
    else if _alStg == 4 and _alStg[1] != 4
        alert(_alTag + "DEEP ZONE " + _alLvl + _alPx + " - wait 1m SOS then FVG", alert.freq_once_per_bar)
    else if _alStg >= 3 and _alStg[1] < 3
        // Wording matches the table's "0.5 ZONE / entry on FVG tap" deliberately. The
        // word AWAIT was removed from that row because it reads as "wait" to someone
        // already holding, and an alert repeating it would undo the fix off-chart.
        alert(_alTag + "0.5 ZONE" + _alPx + " - entry on FVG tap", alert.freq_once_per_bar)
    else if _alStg >= 2 and _alStg[1] < 2
        alert(_alTag + "2/3 - SOS confirmed, retrace starting", alert.freq_once_per_bar)
    // Death = the tracked leg dropped out of the SOS stages. Falling BELOW 2 is the test,
    // not falling to 0: an opposite SOS kills this side and arms the other at 1/3 on the
    // same bar, so the value lands on 1, not 0. Direction is read at [1] because by this
    // bar _alLong may already describe the side that replaced it.
    else if _alStg < 2 and _alStg[1] >= 2
        alert("MPC A+ " + syminfo.ticker + " " + (_alLong[1] ? "LONG " : "SHORT ") + "SETUP DEAD - died at stage " + str.tostring(_alStg[1]) + " of 4", alert.freq_once_per_bar)

if showConfTable and barstate.islast
    // Header
    // "JARVIS", not "MPC- JARVIS" (Aaron, 2026-07-30). This cell sits above the SECTION
    // column, whose rows are short tags — REV SETUP, LEVELS, B LEG, 4H. The long form was
    // the widest string in that column, so the branding was setting the width of every
    // section label underneath it. The watermark still carries the full name.
    // SOURCE → INFO (Aaron, 2026-08-04). "Source" was accurate for the three timeframe rows
    // and the LIQ pair, where the column really does name where the read came from — but it
    // was never what the column held on the rows that matter most. On REV SETUP it carries
    // the instruction ("0.886 +1mSOS +FVG → TP1"), on LEVELS the stop and target prices, on
    // 1m ENTRY the validity. "Info" is the honest name for a column that is whatever that
    // row still needs to tell you.
    // Header background is the only true black on the table now — see the palette note. The
    // blue moved to the frame and the borders, where it outlines rather than fills.
    // The branding sits over the GROUP column and column 1's header is deliberately
    // EMPTY — the row labels under it (W, D, 4H, 15m, BSL) are named by their group tag,
    // so a heading there would be inventing a word for a column that does not need one.
    // JARVIS is the one cyan on the table; STATUS and INFO stay yellow, which is what
    // tells the reader the branding is not a column heading like the other two.
    table.cell(jarvisTable, 0, 0, "JARVIS",
      text_color = JARVIS_GLOW, text_size = f_tableSize(tableSizeInput),
      bgcolor = JARVIS_HEADBG, text_halign = text.align_center)
    table.cell(jarvisTable, 1, 0, "",
      bgcolor = JARVIS_HEADBG)
    table.cell(jarvisTable, 2, 0, "STATUS",
      text_color = JARVIS_YELLOW, text_size = f_tableSize(tableSizeInput),
      bgcolor = JARVIS_HEADBG, text_halign = text.align_center)
    table.cell(jarvisTable, 3, 0, "INFO",
      text_color = JARVIS_YELLOW, text_size = f_tableSize(tableSizeInput),
      bgcolor = JARVIS_HEADBG, text_halign = text.align_center)

    int r = 1

    // Everything below (A+ SETUP, CONT, Weekly, Daily, LIQ BSL/SSL) is hidden in
    // Market Structure mode — only EXT/INT print then.
    if not marketStructureOnly
        // A+ SETUP — the reversal sequence ONLY (sweep → SOS → entry). Once TP3
        // completes, this row goes back to Pass; what tracks afterward is the CONT
        // row below — a different trade type, displayed separately so the two can
        // A+ setup is a REVERSAL trade — a Bull/Bear Div at the sweep is usually part
        // of its own confirmation, not a reason to distrust it, so no veto here.
        // (CONT is the one that gets vetoed — see below — since it's riding an
        // established trend where a fresh opposing divergence is real reversal risk.)
        // FVG is a REQUIRED confirmation for READY (not just a tag) — reaching 0.618
        // without a live matching FVG OR a confirmed Sniper Zone holds the row at
        // "awaiting entry" instead of declaring the setup ready — either location
        // confirmation is accepted, same as CONT treats them. POI (Cycle Fib
        // discount/premium) is a separate, optional confirmation on top of this.
        // REV SETUP — 15m-locked. On the 15m chart it reads the REAL drawn fib via the
        // chart A+ engine (aplusL_*/aplusS_* use fiboP1/P2/P7 directly), so entries and
        // scales line up EXACTLY with the FFT / E1-E4 / TP lines on your chart. Off-15m it
        // falls back to the 15m security skeleton (rStage/rDir) for observation only.
        bool   revOn15 = timeframe.in_seconds() == 900
        bool   revOn1m = timeframe.in_seconds() == 60

        // CONT stage resolution — DISABLED 2026-07-22 with the CONT engines.
        // (Restore by uncommenting, alongside the two engine blocks above.)
        // bool   cL      = true
        // int    cStage  = 0
        // bool   cFvg    = false
        // if revOn15
        //     cL      := contL_stage > 0 and (contS_stage == 0 or contL_stage >= contS_stage)
        //     cStage  := cL ? contL_stage : contS_stage
        //     cFvg    := cL ? contL_fvgTap : contS_fvgTap
        // else if revOn1m
        //     cStage  := rContStage
        //     cL      := rContDir == 1
        //     cFvg    := revContFvg

        int    uStage = 0
        bool   uLong = true
        bool   uTp50 = false
        bool   uTp382 = false
        bool   uTp0 = false
        string uDeepLvl = "0.5"
        bool   u1mShift = false
        bool   uDeepFvg = false
        bool   uEarlyFvg = false
        // Which source(s) armed the winning side's Stage 1 — drives the 1/3 text
        // (Sweep / Div / Sweep+Div). Only meaningful on the 15m chart, where the real
        // A+ engine (aplusL_*/aplusS_*) drives the row.
        bool   uArmSwp = false
        bool   uArmDiv = false
        // True once a deeper retrace has RESET this leg — the row says RE-ENTRY instead
        // of AWAIT so it's clear this is a second bite, not the original entry.
        bool   uReentry = false
        // Did price actually TRADE INTO the aligned Sniper Zone on this leg — not
        // "does an aligned zone exist somewhere on the chart", which is what the tag
        // used to ask and why it printed +SZ on setups that never reached one.
        bool   uSz = false
        // Has a matching FVG in the entry zone been tapped on this leg, at ANY depth —
        // see aplusX_fvgZone. Distinct from uEarlyFvg, which means an early 0.5 entry was
        // actually taken; this one is pure location confluence and is what the DEEP rows
        // report while they wait.
        bool   uFvgZone = false
        // The one-way "you are in" latch for this SOS leg — see aplusX_inTrade.
        bool   uInLatch = false
        if revOn15
            bool cLong = aplusL_stage > 0 and (aplusS_stage == 0 or aplusL_stage >= aplusS_stage)
            uStage    := cLong ? aplusL_stage : aplusS_stage
            uLong     := cLong
            uTp50     := cLong ? aplusL_tp50  : aplusS_tp50
            uTp382    := cLong ? aplusL_tp382 : aplusS_tp382
            uTp0      := cLong ? aplusL_tp0   : aplusS_tp0
            uDeepLvl  := cLong ? f_aplusEntryLvl(aplusL_half, aplusL_618, aplusL_702, aplusL_786, aplusL_886) : f_aplusEntryLvl(aplusS_half, aplusS_618, aplusS_702, aplusS_786, aplusS_886)
            u1mShift  := cLong ? aplusL_1mShift : aplusS_1mShift
            uDeepFvg  := cLong ? aplusL_deepFvg : aplusS_deepFvg
            uEarlyFvg := cLong ? aplusL_fvgTap  : aplusS_fvgTap
            uArmSwp   := cLong ? not na(aplusL_swpArmT) : not na(aplusS_swpArmT)
            uArmDiv   := cLong ? not na(aplusL_divArmT) : not na(aplusS_divArmT)
            uReentry  := cLong ? aplusL_reentry : aplusS_reentry
            uSz       := cLong ? aplusL_szTap : aplusS_szTap
            uFvgZone  := cLong ? aplusL_fvgZone : aplusS_fvgZone
            uInLatch  := cLong ? aplusL_inTrade : aplusS_inTrade
        else
            uStage    := rStage
            uLong     := rDir == 1
            uTp50     := rTp50, uTp382 := rTp382, uTp0 := rTp0
            uDeepLvl  := rDeepCode == 4 ? "0.886" : rDeepCode == 3 ? "0.786" : rDeepCode == 2 ? "0.702" : rDeepCode == 1 ? "0.618" : "0.5"
            u1mShift  := rev1mShift
            uDeepFvg  := revDeepFvg
            uEarlyFvg := revEarlyFvg
            // On the 1m the REV row rides the drawn aligned fib, so reuse that row's
            // own tap latches rather than the 15m A+ ones, which aren't computed here.
            uSz       := rev1mEntrySz
            uFvgZone  := rev1mEntryFvg
            uReentry  := revReentry
        // HAND-OFF — once a REV finishes, the FIRST continuation BOS owns the table for its
        // WHOLE lifetime. While a CONT is live the REV row is hard-suppressed at every
        // stage: exactly one setup tracks at a time. The REV row shows Pass and returns
        // only when that CONT completes or dies. (In practice a REV rarely gets past its
        // arm here anyway — reaching stage 2 needs an SOS, and an SOS kills the live CONT
        // in the death logic above, which frees the row on the same bar.)
        // HAND-OFF DISABLED with CONT — with nothing to defer to, REV is no longer
        // suppressed and shows at whatever stage it has reached.
        // if cStage > 0
        //     uStage := 0
        // REV SETUP row only draws on the 15m and 1m — the only timeframes it's used. On any
        // other chart the whole row (stage AND Pass) is skipped so the table stays compact.
        if (revOn15 or revOn1m) and uStage > 0
            color  uCol = uLong ? JARVIS_SSL : JARVIS_BSL
            string uSide = uLong ? "LONG" : "SHORT"
            string uArrow = uLong ? "▲ " : "▼ "
            bool   uDeep = uStage == 4
            bool   uScale = uTp50 or uTp382 or uTp0
            // Confluence present in the entry zone right now, NAMED rather than implied.
            // Every source string that describes an entry is built from these two, so the
            // row always lists what is actually satisfied on this bar — a canned "+FVG+SZ"
            // could not tell the student whether the Sniper Zone was really reached.
            // uConf  = the deep row that is still waiting on its 1m shift: FVG and/or SZ.
            // uDeepC = the deep read once the shift is in — it leads with +1mSOS, the
            //          trigger that has to come FIRST on a deep entry.
            // The early (0.5) rows use neither; they print plain literals with no +SZ.
            // An empty string is information too: the level alone, no confluence yet.
            string uSzT  = uSz ? " +SZ" : ""
            // uFvgZone, not uEarlyFvg (Aaron, 2026-07-30). This string feeds the DEEP row
            // that is still waiting on its 1m shift, and uEarlyFvg is false there by
            // construction — it can only arm above 0.618. So the row named the Sniper Zone
            // and stayed silent about a gap price had already traded into. Reading the
            // ungated latch means both confluences are reported by the same rule.
            string uConf = (uFvgZone ? " +FVG" : "") + uSzT
            // uIn = a live position. Either tier's trigger fired and has not been reset,
            // so the row must never go back to telling you to wait. On the deep branch
            // uEarlyFvg can ONLY be true because an early 0.5 entry was taken and price
            // then carried on deeper — the latch is gated to the pre-0.618 window.
            // uInLatch first — it is the one-way per-leg latch and it is what stops the
            // ENTRY → AWAIT regression. The two live flags stay in the OR so the row can
            // still turn ENTRY on the very bar the trigger fires, before the latch has
            // been through a bar close.
            bool   uIn = uInLatch or uDeepFvg or uEarlyFvg
            // `uIn or uFvgZone` — was `uIn` alone, which meant the middle deep row (shift
            // in, waiting on the gap) could never print +FVG even with a tapped gap sitting
            // in the zone. The two are different gaps and both are worth naming: uIn is the
            // 1m retest that TRIGGERS the deep entry, uFvgZone is the chart's own gap the
            // zone is built around. Which one you have is read off the status column —
            // ENTRY means the trigger fired, AWAIT means it has not.
            string uDeepC = (u1mShift ? " +1mSOS" : "") + (uIn or uFvgZone ? " +FVG" : "") + uSzT
            // Names the deepest TP reached. Two rewrites landed here 2026-07-30, both to
            // remove a meaning the student had to INFER:
            //   "scale" → "partial N". "Scale" reads both ways (scale IN / scale OUT) and
            //     this row only ever means taking money OFF. The NUMBER is the sequence —
            //     which is why 0.382 has two forms: it is partial 2 after a deep entry
            //     (0.5 was partial 1) and partial 1 after an early 0.5 entry, where 0.5 was
            //     the ENTRY and not a target. The gate above guarantees that ordering.
            //   "+stop" → "stop→profit", the SAME words the 1m ENTRY row already uses for
            //     the same action. "+stop" never said whether to set a stop, move it to
            //     breakeven, or move it into profit; and it carried "you already moved it"
            //     by ABSENCE on partial 2, which is invisible. The number carries that now.
            string uScaleDetail = uTp0 ? "TP3 · close the rest" : uTp382 ? (uDeep ? "0.382 partial 2" : "0.382 partial 1 · stop→profit") : "0.5 partial 1 · stop→profit"
            // REV SETUP is the SAME on every chart — it is the 15m thesis. The 1m chart
            // shows this identical row (driven by the 15m security skeleton + the chart-side
            // 1m confirmation flags) and hands the granular entry to the 1m ENTRY row below.
            if uScale
                f_jRow4(jarvisTable, r, "SETUP", "REV", "TAKE PROFIT " + uSide, uCol, uScaleDetail)
            else if uDeep
                // `uIn`, not `uDeepFvg` — an EARLY entry that is still open must keep
                // reading ENTRY once price retraces past 0.618. It used to fall through
                // to the AWAIT branches below, which ask for the 1m shift and gap all
                // over again: the row told you to wait while you were already in the
                // trade, drawn down. A deep retrace after an early fill is the position
                // going against you, not a fresh setup to be confirmed.
                if uIn
                    // "1m CONFIRMED" → "ENTRY" 2026-07-30: the status column answers "what
                    // do I do", and the answer is you are in. WHERE the confirmation came
                    // from now lives in the source column's +1mSOS / +FVG tags, so the
                    // status no longer has to carry it.
                    f_jRow4(jarvisTable, r, "SETUP", "REV", uArrow + "ENTRY " + uSide, uCol, uDeepLvl + uDeepC + " → TP1")
                else if u1mShift
                    f_jRow4(jarvisTable, r, "SETUP", "REV", uArrow + (uReentry ? "RE-ENTRY " : "AWAIT ") + uSide, JARVIS_YELLOW, uDeepLvl + uDeepC + " · wait FVG")
                else
                    f_jRow4(jarvisTable, r, "SETUP", "REV", uArrow + (uReentry ? "RE-ENTRY " : "AWAIT ") + uSide, JARVIS_YELLOW, uDeepLvl + uConf + " · wait 1m SOS")
            else if uStage == 3
                // The early (0.5) rows carry NO +SZ, by Aaron's call 2026-07-30. A shallow
                // retrace is not asked to prove its location twice — the gap is the entry
                // and the Sniper Zone adds nothing to it, so showing the tag here only
                // invites reading the zone as part of the trigger. The DEEP rows above keep
                // it: price went further against the idea there, so where it turned is
                // genuinely worth naming. Both strings are literals now — in this branch
                // uEarlyFvg is already decided, so there is nothing left to compose.
                // `uIn`, NOT `uEarlyFvg` — this is the exact branch that was seen flipping
                // ENTRY → AWAIT at stage 3 with the fib, SL and TP all unchanged, i.e. the
                // raw flag dropped mid-leg. Reading the one-way latch means the row cannot
                // take an entry back, whatever the flag does underneath.
                if uIn
                    // → names the NEXT target, and on an early entry that is TP2, not TP1.
                    // 0.5 IS TP1 here — it was the entry — so the old " → TP1" pointed at
                    // the level price was already standing on. The TP latches above agree:
                    // an early entry never fires the 0.5 rung (it needs aplusL_618), it
                    // fires 0.382 first. The deep branch keeps → TP1, where 0.5 is ahead.
                    f_jRow4(jarvisTable, r, "SETUP", "REV", uArrow + "ENTRY " + uSide, uCol, "0.5 +FVG → TP2")
                else
                    // The word AWAIT is GONE from this branch (Aaron, 2026-07-30, asked
                    // twice). It was wrong twice over. It collided with the 1m ENTRY row's
                    // own EARLY — the two render together on a 1m chart, one meaning wait
                    // and one meaning go. And it is the state the rollback bug lands on, so
                    // any residual flicker printed the single most damaging sentence the
                    // table can print: "wait" to someone already holding the position.
                    // "0.5 ZONE" replaces it because it makes no claim either way. It states
                    // WHERE price is, which is a fact that cannot become false mid-bar, and
                    // the source column carries the one thing still outstanding. Nothing in
                    // this row now contradicts a live trade, whatever the flags do.
                    f_jRow4(jarvisTable, r, "SETUP", "REV", uArrow + "0.5 ZONE " + uSide, JARVIS_YELLOW, "entry on FVG tap")
            else if uStage == 2
                f_jRow4(jarvisTable, r, "SETUP", "REV", "2/3 " + uSide, uCol, "SOS ✓ retrace")
            else
                // Name which source armed Stage 1: a sweep, a divergence, or both
                // overlapping. Off-15m there are no source latches → default to Div.
                string uArmSrc = (uArmSwp and uArmDiv) ? "Sweep+Div" : uArmSwp ? "Sweep" : "Div"
                // "1/3" → "JARVIS TRACKING" (Aaron, 2026-07-30). A fraction reads as a
                // countdown — 1 of 3 done, 2 to go — which promises a trade that does not
                // exist yet and quietly invites getting ready for it. Most stage-1 arms
                // never see an SOS at all; they age out. The honest statement is that the
                // tool is WATCHING and there is nothing for you to do, and that is what
                // this says. 2/3 keeps its fraction: an SOS has fired by then, so the
                // sequence really is running and counting is fair.
                // Just "Tracking" — no JARVIS prefix, no arrow, no side. The prefix came
                // off because the header cell and the watermark already say whose tool
                // this is. The DIRECTION came off because at stage 1 there is no trade to
                // be long or short of: a sweep or a divergence has fired and the SOS that
                // would decide the direction has not. Printing "LONG" there states a side
                // the setup has not earned, and it is the row most likely to be read as
                // "get ready to buy". The other statuses carry a side because by then an
                // SOS has fixed one.
                // Title case, matching the table's other no-side statuses ("Pass",
                // "Monitor") — the uppercase forms are the ones that name a direction.
                f_jRow4(jarvisTable, r, "SETUP", "REV", "Tracking", JARVIS_NEUTRAL, uArmSrc + " ✓ await SOS")
            r := r + 1
            // ── LEVELS — the prices, added 2026-07-30 ──
            // Every other row states RATIOS, and nobody can trade a ratio. A reader who
            // agreed with "0.886 +1mSOS +FVG → TP1" still had to hunt the chart's fib
            // labels to find where to buy, where the stop goes and what TP1 costs. This
            // row is the order ticket: entry, invalidation, next target — as prices.
            //   entry = the fib the row just named (uDeepLvl already resolves it on BOTH
            //           the 15m and the 1m path, so one lookup serves both).
            //   stop  = fiboP10, the 1.0 leg origin. A CLOSE past it is the same
            //           invalidation the 1m ENTRY row reports as "1.0 broken".
            //   next  = what price is working toward NOW, so it advances as rungs fill:
            //           TP3 after partial 2, TP2 after partial 1, and before any partial
            //           it is TP1 for a deep entry but TP2 for an early one — an early
            //           entry was taken AT TP1, so TP1 is behind it, not ahead.
            // Only from stage 3, because before price reaches the zone there is no entry
            // to quote and a number here would read as a live instruction.
            // 15m ONLY (Aaron, 2026-07-30). The 15m is where the thesis and its prices
            // live; the 1m is the execution view and already carries its own entry row.
            // Quoting 15m levels there just competes with what the 1m is telling you.
            if uStage >= 3 and revOn15
                float uEntryP = uDeepLvl == "0.886" ? fiboP6 : uDeepLvl == "0.786" ? fiboP5 : uDeepLvl == "0.702" ? fiboP4 : uDeepLvl == "0.618" ? fiboP3 : fiboP2
                float uNextP  = uTp382 ? fiboP7 : uTp50 ? fiboP1 : (uDeep ? fiboP2 : fiboP1)
                // The word in front of the price says whether you HOLD it or are still
                // WAITING to get it. The row first shipped with no word at all — just
                // "@ 4056.23" at every stage — which read as a fill at a level nobody got.
                // The first attempt used "plan", and that failed for the plain reason that
                // it is not a word a trader uses at a price: it named the row's own status
                // instead of naming the ACTION. So the two states now say what to DO:
                //   IN <price>          — you hold this. The number is your fill.
                //   BUY / SELL <price>  — you do not hold it yet. That is the order to
                //                         place, and it fills when the gap triggers.
                // Colour follows the same split — grey while it is only an order, side-
                // coloured once it is a position — so the row can never outrank the status
                // line above it. uFilled reads the SAME uIn the status row reads, plus
                // uScale (a banked partial is proof of a fill), so the two rows can never
                // disagree about whether you are in.
                bool uFilled = uIn or uScale
                // The stop MOVES once partial 1 banks (Aaron, 2026-07-30). The REV row
                // above says "partial 1 · stop→profit" at that moment, so from then on the
                // stop sits at the ENTRY, not at the 1.0 leg origin — and quoting fiboP10
                // after that describes a risk you are no longer carrying. uScale is exactly
                // "at least one partial banked", which is exactly when the stop moves, so
                // the two rows can never disagree about where the stop is.
                float uStopP = uScale ? uEntryP : fiboP10
                if not na(uEntryP) and not na(uStopP) and not na(uNextP)
                    f_jRow4(jarvisTable, r, "", "LEVELS", (uFilled ? "IN " : (uLong ? "BUY " : "SELL ")) + str.tostring(uEntryP, format.mintick), uFilled ? uCol : JARVIS_NEUTRAL,
                      "SL " + str.tostring(uStopP, format.mintick) + " · TP " + str.tostring(uNextP, format.mintick))
                    r := r + 1
        else if revOn15 or revOn1m
            // "Pass" prints whenever REV is not tracking. The old `and cStage == 0` guard
            // existed to suppress Pass next to a live CONT row; with CONT disabled there is
            // never a competing row, so Pass is always the honest read.
            f_jRow4(jarvisTable, r, "SETUP", "REV", "Pass", JARVIS_NEUTRAL, "No sequence")
            r := r + 1

        // CONT SETUP row — DISABLED 2026-07-22 with the CONT engines.
        // // CONT SETUP — the with-trend continuation (15m-locked). Trend-aligned BOS →
        // // retrace → 1m FVG entry. Only the trend side ever shows — that single-side
        // // display IS the proof it never tracks counter-trend. No Pass row (keeps it
        // // compact): the row appears only while a continuation is actually live.
        // if revOn15 or revOn1m
            // if cStage > 0
                // color  cCol   = cL ? JARVIS_SSL : JARVIS_BSL
                // string cSide  = cL ? "LONG" : "SHORT"
                // string cArrow = cL ? "▲ " : "▼ "
                // // VETO — a live OPPOSING divergence on a with-trend continuation is
                // // reversal risk: hold the row at EXTREME and never print the entry while
                // // it stands. It clears on the next external break (the div goes stale) and
                // // the row resumes at whatever stage the retrace has reached. CONT only —
                // // the REV row above never applies this.
                // bool cVeto = cL ? bearDivActive : bullDivActive
                // if cVeto
                    // f_jRow3(jarvisTable, r, "CONT SETUP", "EXTREME " + cSide, JARVIS_YELLOW, (cL ? "Bear" : "Bull") + " div · reversal risk")
                // else if cStage == 3 and cFvg
                    // f_jRow3(jarvisTable, r, "CONT SETUP", cArrow + "ENTRY " + cSide, cCol, "0.618 +FVG ✓ → TP1")
                // else if cStage == 3
                    // f_jRow3(jarvisTable, r, "CONT SETUP", cArrow + "3/3 " + cSide, JARVIS_YELLOW, "0.618 wait FVG")
                // else if cStage == 2
                    // f_jRow3(jarvisTable, r, "CONT SETUP", "2/3 " + cSide, cCol, "0.5 retrace")
                // else
                    // f_jRow3(jarvisTable, r, "CONT SETUP", "1/3 " + cSide, JARVIS_NEUTRAL, "BOS ✓ await retrace")
                // r := r + 1
        // B LEG — a ONE-LINE "still open" note, not the old three-stage row that was
        // pulled for clutter. The point: after a continuation BOS restarts the REV setup,
        // the B leg keeps watching the frozen SZ, and the trader needs to know the trade
        // can STILL happen — that the drift away from the original setup has not killed it.
        // So this row appears whenever a B leg is live, INDEPENDENT of the REV row above:
        // a fresh REV can be arming on the new leg while this reminds you the missed one
        // is still catchable. Two states only — OPEN (waiting on the SZ tap, drift is fine)
        // and ENTRY (the SZ tapped). It sits right under REV so the pair reads together.
        // 15m only, same as the BLEG SZ box. When a long AND a short B leg are both live,
        // the row shows whichever band price is CLOSER to — the one more likely to fill
        // next. Distance is to the 0.5 edge price meets first (bLegL_top for a long,
        // bLegS_bot for a short); both are non-na whenever their side is on. If only one
        // side is live it wins by default.
        if showBLeg and revOn15 and (bLegL_on or bLegS_on)
            bool   bL    = bLegL_on and (not bLegS_on or math.abs(bLegL_top - close) <= math.abs(bLegS_bot - close))
            color  bCol  = bL ? JARVIS_SSL : JARVIS_BSL
            string bSide = bL ? "LONG" : "SHORT"
            bool   bTap  = bL ? bLegL_tap : bLegS_tap
            if bTap
                f_jRow4(jarvisTable, r, "", "B LEG", "Monitor", bCol, "SZ tap ✓ · still valid")
            else
                f_jRow4(jarvisTable, r, "", "B LEG", "Monitor", JARVIS_YELLOW, "REV missed · SZ can still tap")
            r := r + 1

        // ── 1m ENTRY — the granular entry + a 1m stop-protect (NO scale on the 1m).
        // The 1m can print several SOS before it truly aligns with the 15m, so the moment
        // price reaches 0.5 / TP1 (fibo2Touched, after a real entry) the row flips to
        // STOP→PROFIT: move the stop to profit to protect against a 1m reversal — but do
        // NOT scale here; the 15m REV SETUP owns all take-profits/scaling. It then clears
        // at 0.382 / TP2 (fibo1Touched). The "· valid" tag on an entered state means price
        // has NOT closed past the fib 1.0; a close past 1.0 flips it to ✗ INVALID.
        // Row lives from RETRACE through to ✓ CONFIRMED. It clears entirely once the 15m
        // reaches its own 0.5/TP1 (not rTp50) — past there the 15m scale owns the trade.
        // Otherwise it stays until the fib retires (fiboResetActive), EXCEPT the confirmed
        // state, which is shown precisely so the student sees the entry paid off.
        //   rev1mConfirmed = price returned to the 1m 0.0/TP3 AFTER a real (FVG) entry —
        //   the 1m trade played out to its target. This is the moment the 1m fib retires.
        bool rev1mConfirmed = revOn1m and fibo7Touched and rev1mEntryFvg
        if revOn1m and fibo_dir != 0 and fiboShowAligned and not rTp50 and (not fiboResetActive or rev1mConfirmed)
            bool   e1Long  = fibo_dir == 1
            color  e1Col   = e1Long ? JARVIS_SSL : JARVIS_BSL
            string e1Side  = e1Long ? "LONG" : "SHORT"
            string e1Arrow = e1Long ? "▲ " : "▼ "
            string e1Lvl   = fibo6Touched ? "0.886" : fibo5Touched ? "0.786" : fibo4Touched ? "0.702" : fibo3Touched ? "0.618" : fiboHalfReached ? "0.5" : "0.382"
            // Two entry qualities: EARLY = a matching 1m FVG tapped anywhere in the
            // 0.382–0.886 entry band (FVG only); ULTIMATE = that FVG AND the aligned
            // Sniper Zone. SZ alone is not an entry — it only upgrades EARLY → ULTIMATE.
            bool   e1Ult   = rev1mEntryFvg and rev1mEntrySz
            bool   e1Early = rev1mEntryFvg
            // Invalidation = a CLOSE past the fib 1.0 (the leg origin): below it for a
            // long, above it for a short. Until then the trade is valid.
            bool   e1Broken = not na(fiboP10) and (e1Long ? close < fiboP10 : close > fiboP10)
            // Stop-protect: price reached 0.5/TP1 AFTER a real (FVG) entry → move stop to
            // profit (protect vs a 1m reversal). NO scale here — the 15m owns TPs.
            bool   e1Safety = fibo2Touched and rev1mEntryFvg
            // Same rule as the REV row: name the confluences actually satisfied rather
            // than print the canned pair the status word already implies.
            string e1Conf = (rev1mEntryFvg ? " +FVG" : "") + (rev1mEntrySz ? " +SZ" : "")
            if rev1mConfirmed
                f_jRow4(jarvisTable, r, "", "1m ENTRY", "✓ CONFIRMED " + e1Side, e1Col, "1m target ✓ · 15m runs")
            else if e1Broken
                f_jRow4(jarvisTable, r, "", "1m ENTRY", "✗ INVALID " + e1Side, JARVIS_NEUTRAL, "1.0 broken")
            else if e1Safety
                f_jRow4(jarvisTable, r, "", "1m ENTRY", "STOP→PROFIT " + e1Side, e1Col, "TP1 · protect · 15m takes TP")
            else if e1Ult
                f_jRow4(jarvisTable, r, "", "1m ENTRY", e1Arrow + "ULTIMATE " + e1Side, e1Col, e1Lvl + e1Conf + " · valid")
            else if e1Early
                f_jRow4(jarvisTable, r, "", "1m ENTRY", e1Arrow + "EARLY " + e1Side, e1Col, e1Lvl + e1Conf + " · valid")
            else if fiboHalfReached
                f_jRow4(jarvisTable, r, "", "1m ENTRY", e1Arrow + "AWAIT " + e1Side, JARVIS_YELLOW, e1Lvl + " wait FVG/SZ")
            else
                f_jRow4(jarvisTable, r, "", "1m ENTRY", "RETRACE " + e1Side, JARVIS_NEUTRAL, "SOS ✓ awaiting zone")
            r := r + 1


        // WEEKLY — Established Context (last closed week vs the one before)
        f_jRow4(jarvisTable, r, "BIAS", "W", wEstState, wEstState == "Bullish" ? JARVIS_SSL : wEstState == "Bearish" ? JARVIS_BSL : JARVIS_NEUTRAL, wEstDesc)
        r := r + 1

        // DAILY — Established Context (last closed day vs the one before)
        f_jRow4(jarvisTable, r, "", "D", dEstState, dEstState == "Bullish" ? JARVIS_SSL : dEstState == "Bearish" ? JARVIS_BSL : JARVIS_NEUTRAL, dEstDesc)
        r := r + 1

        // 4H / 15m / 1m STRUCTURE — each timeframe's own last break direction, with the
        // Shift / Expansion / Continuation sequence in the SOURCE column. The row that
        // matches the CHART timeframe is sourced from the live on-chart engine (st) so it
        // is byte-identical to the SOS/BOS on your chart; the other two come from their own
        // request.security engines (reliable for timeframes at or above the chart tf).
        float _mtfSec = timeframe.in_seconds()
        int _d240 = _mtfSec == 14400 ? st.dir : m240Dir
        int _e240 = _mtfSec == 14400 ? stMtfEv : m240Ev
        int _d15  = _mtfSec == 900   ? st.dir : m15Dir
        int _e15  = _mtfSec == 900   ? stMtfEv : m15Ev
        int _d1   = _mtfSec == 60    ? st.dir : m1Dir
        int _e1   = _mtfSec == 60    ? stMtfEv : m1Ev
        f_jRow4(jarvisTable, r, "STR", "4H",  _d240 == 1 ? "Bullish" : _d240 == -1 ? "Bearish" : "—", _d240 == 1 ? JARVIS_SSL : _d240 == -1 ? JARVIS_BSL : JARVIS_NEUTRAL, _e240 == 1 ? "Shift" : _e240 == 2 ? "Expansion" : _e240 == 3 ? "Continuation" : "—")
        r := r + 1
        f_jRow4(jarvisTable, r, "", "15m", _d15 == 1 ? "Bullish" : _d15 == -1 ? "Bearish" : "—", _d15 == 1 ? JARVIS_SSL : _d15 == -1 ? JARVIS_BSL : JARVIS_NEUTRAL, _e15 == 1 ? "Shift" : _e15 == 2 ? "Expansion" : _e15 == 3 ? "Continuation" : "—")
        r := r + 1
        f_jRow4(jarvisTable, r, "", "1m",  _d1 == 1 ? "Bullish" : _d1 == -1 ? "Bearish" : "—", _d1 == 1 ? JARVIS_SSL : _d1 == -1 ? JARVIS_BSL : JARVIS_NEUTRAL, _e1 == 1 ? "Shift" : _e1 == 2 ? "Expansion" : _e1 == 3 ? "Continuation" : "—")
        r := r + 1

        // LIQ — EITHER row can be the one that prints, so the group tag is a real latch
        // rather than a hardcode: it rides on whichever appears first and is blanked after.
        // ⚠ The STATUS column says "Swept", not "BSL"/"SSL". Those words moved to the row
        // label, and leaving them in both places printed `LIQ | BSL | BSL | Day High` —
        // the same word twice with no second meaning. The status column's job is what
        // HAPPENED, and what happened is the pool was taken; WHICH pool is the row label
        // and WHERE it was is the Info column. Nothing is lost, and the colour still
        // carries the side (the hotter red for buy-side, green for sell-side).
        string gLiq = "LIQ"
        if recentBSL != ""
            f_jRow4(jarvisTable, r, gLiq, "BSL", "Swept", JARVIS_LIQRED, recentBSL)
            gLiq := ""
            r := r + 1

        if recentSSL != ""
            f_jRow4(jarvisTable, r, gLiq, "SSL", "Swept", JARVIS_SSL, recentSSL)
            r := r + 1


    // STRUCTURE — only shown in Market Structure mode now
    if marketStructureOnly
        // Same latch as LIQ — either row can be the first to print, so the tag is carried
        // in a local rather than hardcoded onto EXT.
        string gMs = "STR"
        if ext_struct != ""
            f_jRow4(jarvisTable, r, gMs, "EXT", ext_struct, str.contains(ext_struct, "▲") ? JARVIS_SSL : JARVIS_BSL, "External")
            gMs := ""
            r := r + 1
        if int_struct_valid
            f_jRow4(jarvisTable, r, gMs, "INT", int_struct, str.contains(int_struct, "▲") ? JARVIS_SSL : JARVIS_BSL, "Internal")
            r := r + 1

    // Wipe any leftover cells below the last drawn row. Without this, a tick
    // that draws FEWER rows than the previous one leaves the old rows visible
    // (e.g. a ghost duplicate of the final row after a row above disappears).
    // 3, not 2 — the wipe must reach the new fourth column, or a shrinking table leaves a
    // ghost Info cell hanging off the bottom right with no row beside it.
    if r <= 17
        table.clear(jarvisTable, 0, r, 3, 17)

//============================================================
  // MPC- JARVIS WATERMARK
//============================================================
var table watermark = table.new(position.bottom_center, 1, 1)
if barstate.islast
    table.cell(watermark, 0, 0, "MPC- JARVIS",
      text_color  = color.new(#17578e, 20),
      text_size   = size.normal,
      bgcolor     = color.new(JARVIS_BLACK, 100),
      text_halign = text.align_center)
