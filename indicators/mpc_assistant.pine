string fibo7Style    = input.string("┈",   "",              group = GRP_FIBO, inline = "Fibo7",  options = ["─","┈","╌"], display = display.none)

f_fiboLineStyle(string opt) =>
    opt == "┈" ? line.style_dotted : opt == "╌" ? line.style_dashed : line.style_solid

