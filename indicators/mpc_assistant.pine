//@version=6
indicator("MPC- JARVIS", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500, max_bars_back = 2000)

var GRP_MASTER = "Display"
bool showTradeTools = input.bool(true, "Show Chart Tools", group = GRP_MASTER, tooltip = "Master switch for the chart tools below. Off leaves a clean market-structure-only chart.", display = display.none)
bool showFibTool    = input.bool(true, "Show Fibs", group = GRP_MASTER, tooltip = "Master switch for the fib tools.", display = display.none)

var GRP_TABLE = "Confirmation Table"
bool showConfTable = input.bool(true, "Show Confirmation Table", group = GRP_TABLE, display = display.none)
// Four corners, not nine (Aaron, 2026-08-04). The six middle/centre positions parked the
// table over the candles, which is the one place a status panel must never sit. Text size
// loses "Huge" for the same reason and now defaults to Normal — Tiny was set back when the
// table was three rows; it is up to twelve now and had become hard to read at a glance.
string tablePositionInput = input.string("Top Right", "Table Position", group = GRP_TABLE, options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], active = showConfTable, display = display.none)
string tableSizeInput = input.string("Small", "Table Text Size", group = GRP_TABLE, options = ["Tiny", "Small", "Normal", "Large"], active = showConfTable, display = display.none)
// COMPUTE vs DRAW — the rule for the five features the confirmation table feeds off
// (External Fib, FVG, Liquidity, RSI Divergence, Sniper Zone). Their ENGINES always
// run, so every table row works no matter what the student has switched off. Their
// toggles control DRAWING only. Each one below therefore has a show<X> compute flag
// (forced true) and a draw<X> flag wired to the input.
// This replaced the old "Table Priority" input, which forced the FEATURE on rather
// than just its engine — so with it enabled (the default) the External Fib, FVG,
// Liquidity, RSI Divergence and Sniper Zone toggles did nothing at all.

// The `=>` fallback on each is doing real work now that options have been removed: a chart
// saved with "Middle Center" or "Huge" still holds that string, and it lands here rather
// than on a position or size the panel no longer offers.
f_tablePosition(string opt) =>
    switch opt
        "Top Right"     => position.top_right
        "Top Left"      => position.top_left
        "Bottom Right"  => position.bottom_right
        "Bottom Left"   => position.bottom_left
        => position.top_right

f_tableSize(string opt) =>
    switch opt
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        => size.normal


//============================================================
  // SMC SETTINGS (hardcoded)
//============================================================
int   majorLength = 15
color bullColor   = color.blue
color bearColor   = color.red
color iBullColor  = bullColor
color iBearColor  = bearColor

//============================================================
  // MARKET STRUCTURE LABEL SIZE
//============================================================
var GRP_STRUCT = "Market Structure"
bool   marketStructureOnly = not showTradeTools and not showFibTool
string structLabelSize  = input.string("Small", "Structure Label Size",    group = GRP_STRUCT, options = ["Tiny", "Small", "Normal", "Large", "Huge"], display = display.none)
bool   showExternal     = input.bool(true,      "Show External Structure", group = GRP_STRUCT, tooltip = "The major swing structure. ASH/ASL = Active Swing High/Low, the live level being watched. HH/HL = Higher High/Higher Low, LH/LL = Lower High/Lower Low. BOS = Break of Structure, a break that continues the trend. SOS = Shift of Structure, a break that reverses it (also called CHoCH, Change of Character).", display = display.none)
bool   showInternal     = input.bool(true,      "Show Internal Structure", group = GRP_STRUCT, tooltip = "The smaller structure inside the current major swing. Same names with an i prefix: iSH/iSL = internal Swing High/Low, iHH/iHL/iLH/iLL, iBOS = internal Break of Structure, iSOS = internal Shift of Structure.", display = display.none)
bool   showSwingLabels  = input.bool(true, "Show Swing Point Labels", group = GRP_STRUCT, tooltip = "Off hides the swing point labels, leaving only BOS/SOS and iBOS/iSOS on the chart.", display = display.none)
bool   showHistoricalInternal = input.bool(true, "Show Internal Structure History", group = GRP_STRUCT, active = showInternal, tooltip = "On (default) keeps every past swing's internal labels and lines on the chart. Off wipes the internal structure each time the external structure breaks, so only the current swing's internals are drawn.", display = display.none)
int    internalLength   = 5
float  pbBuffer         = 0.0

f_structSize() =>
    not showExternal ? size.auto : structLabelSize == "Tiny" ? size.tiny : structLabelSize == "Normal" ? size.normal : structLabelSize == "Large" ? size.large : structLabelSize == "Huge" ? size.huge : size.small

// Swing-point labels are hidden by making their text transparent, not by skipping
// their creation. The label objects still exist and the engine's state is untouched,
// so structure tracking, fibs, OBs and the table behave identically either way.
f_swingCol(color c) =>
    showSwingLabels ? c : color(na)

//============================================================
  // ORDER BLOCKS
//============================================================
//============================================================
  // CHART TOOLS — one on/off per tool. Every appearance and behaviour setting
  // behind them is locked to the tuned defaults below, so a student can declutter
  // the chart but can never change what a tool detects or how it looks.
//============================================================
var GRP_TOOLS = "Chart Tools"
bool showFVGInput        = input.bool(true,  "Fair Value Gaps",   group = GRP_TOOLS, tooltip = "FVG on the chart. A fair value gap is the price void left by a 3-candle imbalance, where the first and third candles do not overlap.", display = display.none)
// ── FVG-ONLY DIRECTION FILTER (Aaron, 2026-08-05) ──
// Separate from "Trend-Aligned Zones Only" below, and it reads a DIFFERENT direction —
// those are the two reasons it exists rather than being folded into the shared switch.
//   SEPARATE, because gaps and order blocks are not looked at the same way. Filtering
//     the gaps down to the trade's side is an execution decision; the blocks are context
//     and are often worth seeing on both sides. One control could not express that.
//   DIFFERENT DIRECTION, and this is the load-bearing half. The shared filter reads
//     `st.dir` — the CHART's own structure. On a 15m chart that is the 15m trend, which
//     is roughly what a reader means. On a 1m chart it is the 1m structure, which flips
//     several times inside one 15m leg, so a short's gaps would appear and vanish while
//     the setup itself never changed. This one reads the DRAWN FIB's direction, so it is
//     the direction of the leg the trade is actually on and holds for that leg's life.
// ⚠ ABSOLUTE — unlike the shared filter, an EQ-backed gap does NOT get an exemption here.
// "Only gaps with bias" has to mean only gaps with bias, or the switch is a label that
// does not describe what the code does. The EQ exemption still protects a counter-side
// gap from the CAP (it stays alive underneath); this just refuses to draw it.
// ⚠ HIDES, never deletes — same as every other visibility rule here. The gap keeps
// living and mitigating, and reappears if the fib flips direction.
bool fvgBiasInput        = input.bool(false, "    ↳ Trend-Aligned FVGs Only", group = GRP_TOOLS, active = showFVGInput, tooltip = "Off (default) shows fair value gaps in both directions. On draws ONLY the gaps on the same side as the current External Fib's leg — bearish gaps on a bearish setup, bullish on a bullish one. This is the leg the trade is being taken on, so it holds steady for the whole setup instead of flipping with the chart's own structure. Applies to fair value gaps ONLY; order blocks are left alone. Hidden, not deleted: a gap comes back if the fib turns.", display = display.none)
// ── THE FVG COUNT IS LOCKED AGAIN (Aaron, 2026-08-03) ──
// It was exposed on 2026-08-02 as "Max Active FVGs", for the same reason the order-block
// count was exposed the day before: so the number could be tested against a real chart.
// That test is done and it answered a different question than expected — the gap set
// itself was wrong, not its depth. With the three detection settings now synced to
// mpc_strategy.pine (see the FVG block below), the cap is settled at the strategy's 7 and
// there is nothing left for the input to do except let a student set the chart out of step
// with the bot again. Same reasoning, same outcome, same day of the week.
bool showOBsInput        = input.bool(true,  "Order Blocks",      group = GRP_TOOLS, tooltip = "OB on the chart. An order block is the last opposing candle before the move that broke structure.", display = display.none)
// ── THE COUNT IS LOCKED TOO NOW (Aaron, 2026-07-31) ──
// It was the one order-block setting left on the panel, exposed on 2026-07-30 so the
// number could be tested against a real chart. That test is done: TEN blocks per
// direction, and with the count settled there is nothing left for the input to do
// except let a student set it wrong. Every other OB property (what qualifies as one,
// its colour, body-vs-wick) was already locked, so this closes the last hole — nothing
// about the tool can now be altered from the panel.
// Ten is deliberately the OLD MAXIMUM, not a middle value: the FIFO drops from the
// front, so a bigger cap only ever keeps MORE history behind price. It never changes
// which blocks are nearest.
int   maxActiveOB        = 10
// ── ONE direction filter, shared by BOTH zone tools (Aaron, 2026-07-30) ──
// Fair value gaps and order blocks are both drawn in BOTH directions by default: a
// bullish gap and a bearish gap, a bullish block and a bearish block, each capped on
// its own side. This is the switch that narrows them to the way the market is going.
// Deliberately ONE control, not two. The question it answers — "do I want to see the
// zones price is trading AWAY from?" — has one answer per trader, not one per tool, and
// two toggles that are always set the same way are just one toggle with extra clicks.
// HIDES, never deletes. A hidden zone keeps living and mitigating underneath, so when
// structure flips back it is still there, still accurate. Deleting would mean a
// counter-trend zone is destroyed the moment it prints, and the flip back would leave a
// hole where a valid level used to be.
bool dirOnlyInput        = input.bool(false, "Trend-Aligned Zones Only", group = GRP_TOOLS, tooltip = "Off (default) shows every fair value gap and order block, both directions. On hides the ones that oppose the current external structure — in an uptrend only bullish gaps and bullish blocks are drawn, in a downtrend only bearish. Hidden, not deleted: they come back if structure turns. Applies to Fair Value Gaps and Order Blocks together.", display = display.none)
bool eqShowInput         = input.bool(true,  "Equal Highs/Lows",  group = GRP_TOOLS, tooltip = "Tagged EQH and EQL. EQH = Equal Highs, a pair of highs at the same price with buy-side liquidity resting above. EQL = Equal Lows, the mirror below.", display = display.none)
// ── THE EQ DIALS ARE LOCKED AGAIN (Aaron, 2026-08-04) ──
// Three inputs lived here for a few hours — sensitivity, count, and a line extension —
// exposed for the same reason the FVG cap and the order-block count were exposed before
// them: so the numbers could be tested against a real chart rather than argued about.
// That test is done and it settled all three IN ONE SITTING, which is why they go back
// down as constants the same day:
//   SENSITIVITY  0.1 → 0.3 → 0.25
//   COUNT        6   → 18  → 14
//   EXTENSION    50  → 10  → gone entirely (the line ends at the live candle)
// With the numbers settled there is nothing left for the inputs to do except let a
// student set the chart out of step with the tool. Same reasoning, same outcome, and
// the third time this file has run this exact loop.
// The values now live in the EQUAL HIGHS / LOWS block below, next to the rest of the
// locked EQ settings. See the note there for what each one drives.
var i_showLiquidityInput = input.bool(true,  "Liquidity Levels",  group = GRP_TOOLS, tooltip = "The tags down the right edge. PDH/PDL = Previous Day High/Low. PWH/PWL = Previous Week High/Low. PWC = Previous Week Close. H4 H/L = the previous 4-hour candle High/Low. Asia/Ldn/NY H and L = that session High and Low. BSL = Buy-Side Liquidity (above a high), SSL = Sell-Side Liquidity (below a low).", display = display.none)
bool showSessionsInput   = input.bool(true,  "Trading Sessions",  group = GRP_TOOLS, display = display.none)
bool showHistoricSessions = input.bool(true, "    ↳ Session History", group = GRP_TOOLS, active = showSessionsInput, tooltip = "On (default) draws every session in the chart's history. Off draws only the current week's session boxes, from Sunday 00:00 New York.", display = display.none)
bool showKZandNYRInput   = input.bool(true,  "Kill Zones & NY Range", group = GRP_TOOLS, tooltip = "KZ = Kill Zone, the high-activity window at a session open. NY = New York. NY Range = the opening range of the New York session.", display = display.none)
bool showKZHistoric      = input.bool(false, "    ↳ Kill Zone History", group = GRP_TOOLS, active = showKZandNYRInput, tooltip = "Off (default) draws the kill zones and NY range for the current New York day only. On draws them for every day in the chart's history — three green bands per day, stamped at the same clock time, so expect it to cover a lot of chart.", display = display.none)
bool showSVPInput        = input.bool(true,  "MV",                group = GRP_TOOLS, tooltip = "The MV line — where the highest volume of trades occurred during the Asian session.", display = display.none)
bool showVwapInput       = input.bool(true,  "VWAP",              group = GRP_TOOLS, tooltip = "VWAP = Volume Weighted Average Price. The average price paid so far in the session, weighted by how much traded at each price.", display = display.none)
bool showDivInput        = input.bool(true,  "RSI Divergence",    group = GRP_TOOLS, tooltip = "RSI = Relative Strength Index, a momentum oscillator. Divergence = price and RSI disagreeing, one making a new extreme while the other does not. Tagged Bull Div / Bear Div.", display = display.none)

//============================================================
  // ORDER BLOCKS — appearance + cap locked, no panel inputs
//============================================================
bool showOBs = showTradeTools and showOBsInput
// ── OB APPEARANCE — an OUTLINE, in a colour no other box uses (Aaron, 2026-07-30) ──
// The blocks were a pale-blue and pale-red FILL, and on a live chart that was a fifth
// pale rectangle sitting on top of four others: London is a blue wash, Tokyo is a red
// wash, New York yellow, the kill zones green, FVGs grey, the Sniper Zone green/red.
// A bullish OB was visually the same object as a London session box. Directional
// colouring made it worse, not better — it spent the two colours that are ALREADY
// spoken for by the session boxes underneath it.
// Two changes fix that, and the second is the one doing the work:
//   1. ONE colour for both directions — deep orange, the only hue no box on this chart
//      claims. Direction is not what an order block is FOR; where it sits relative to
//      price already says that, and the structure labels say it in words.
//   2. It is drawn as an OUTLINE, not a wash — the fill is a whisper (94) and the
//      BORDER carries the shape (25). Every other zone here is a filled block, so an
//      outlined one is told apart by SHAPE before colour is even processed. That
//      survives what a colour change alone cannot: overlapping zones, a dark theme,
//      and a colour-blind reader.
// The blue/red directional experiment (2026-07-30, to match the OrthosLabs overlay) is
// REVERTED — Aaron kept the orange outline. So the two notes above stand as written and
// this is the live appearance: one deep-orange hue for both directions, drawn as an
// outline. Only the BEHAVIOUR fixes from that pass were kept (see f_obMake and extendOBs).
bool  showBullOB  = true
color OB_ACCENT   = #E65100
color colBullOB   = color.new(OB_ACCENT, 94)
bool  showBearOB  = true
color colBearOB   = color.new(OB_ACCENT, 94)
color OB_EDGE     = color.new(OB_ACCENT, 25)
// The "OB" tag comes back with the outline — at 94% transparency the fill is a whisper,
// so the label is what NAMES the thing. Right-aligned, so it rides beside price in the
// empty space rather than sitting on the candles at the box's left edge.
color obTextBull  = color.new(OB_ACCENT, 0)
color obTextBear  = color.new(OB_ACCENT, 0)
bool  obBodyOnly  = false
// ── THE THREE BOUNDS (Aaron, 2026-07-30) — off the screenshot where the blocks sat
// hundreds of dollars above price and stretched the entire chart width ──
// OB_SCAN_MAX — how far BEFORE the break the leg is searched. This is the big one. The
//   scan was bounded only by the leg itself, and a leg on an hourly chart runs hundreds
//   of bars, so with every engulfing now qualifying it was drawing blocks from the leg's
//   ORIGIN — candles from weeks ago, which is exactly "tracking too far back". An order
//   block belongs to the IMPULSE that broke structure, and an impulse is a handful of
//   candles. Set to 20 at first; raised to 40 the same day because blocks were missing
//   at the deeper pushes of a longer leg — 20 bars cut the scan off before it reached
//   them. 40 still keeps it near the break rather than back at the leg origin.
// OB_MAX_AGE — a block price has walked away from and never returned to. Mitigation
//   freezes rather than deletes now, so without an age cap a block far above price is
//   drawn forever. That is what those four boxes at the top of the chart were.
// (OB_MERGE_BARS is gone with merge itself — see the mergeOBs note.)
// OB_STUB — the box's width while price is AWAY from it. A block used to be redrawn
//   to the live bar on every single bar, so a level from this morning was a rectangle
//   spanning the whole session — five of them and the chart is a wall of boxes. It only
//   needs to be long enough to read as a zone.
// ── 6 → 30 (Aaron, 2026-07-31): "make my boxes the same length as the blue and red
// ones, they are too short." Measured off the reference overlay — every one of its zones
// is about the same width, roughly thirty bars, and the newest ones run PAST the live bar
// into the empty space on the right. Six bars read as a dash next to that.
// Worth noting the width is now uniform by construction, which is what makes a set of
// them scan as one family of levels rather than a ragged row. The reference does the same
// thing: its boxes do not grow or shrink with age or with where price is.
int OB_SCAN_MAX   = 40
int OB_MAX_AGE    = 500
int OB_STUB       = 30
// Wired to the shared filter above. The OB side of it only ever bites on INTERNAL
// blocks, and that is worth knowing before switching it on: an external block is born
// on the break that SETS st.dir, so it is aligned by construction, and an SOS wipes both
// sides anyway. An internal block is born on an iBOS/iSOS, which can fire against the
// external trend — so those are the counter-trend blocks this hides.
bool  obDirOnly   = dirOnlyInput

type OrderBlock
    box   bg
    float top
    float bottom
    bool  isBullish
    // WHICH SOURCE made this block — the two now run side by side (Aaron, 2026-07-30).
    //   true  = a STRUCTURE block, born on a BOS/SOS/iBOS/iSOS. The method's own kind.
    //   false = a DISPLACEMENT block, born on any candle that took out the one before it,
    //           with no structure break required. This is the one that fills the gaps
    //           where the engine has not printed a break yet.
    // Defaulted true so the existing positional OrderBlock.new calls keep their meaning.
    bool  fromBreak = true
    // Has price CLOSED INSIDE this zone yet — the first half of mitigation (Aaron,
    // 2026-07-30). Tracked as state rather than tested per bar because entering and
    // leaving happen on DIFFERENT bars: price closes into the block today and closes
    // back out an hour later, and nothing on that later bar can tell you it was ever
    // in there. Latched once, never cleared.
    bool  entered   = false

var array<OrderBlock> activeBullOBs = array.new<OrderBlock>()
var array<OrderBlock> activeBearOBs = array.new<OrderBlock>()

// PLAIN OLDEST-OUT AT THE CAP. The newest blocks are the ones nearest price, so dropping
// from the front always keeps the levels in play and retires the ones behind the move.
// This USED to protect structure blocks — at the cap it hunted for the oldest push block
// and only dropped a structure block when none was left. That made sense while the push
// source was the supporting cast. It is the MAIN source now (Aaron, 2026-07-31: "capture
// every impulsive engulfing push"), so protecting the rarer kind would spend the cap on
// old structure levels and evict exactly the push zones the chart is meant to show.
// Both kinds queue by AGE, nothing else.
method manageOBs(array<OrderBlock> arr, OrderBlock newOB) =>
    array.push(arr, newOB)
    if array.size(arr) > maxActiveOB
        OrderBlock oldest = array.remove(arr, 0)
        box.delete(oldest.bg)

// Wipe every block on this side. COMMENTED OUT with its only caller, the SOS wipe —
// see the note at the creation site for why that rule went. Kept as a comment rather
// than deleted because Pine does not compile comments, so this costs no tokens and
// restoring it is uncommenting both halves.
// method wipeOBs(array<OrderBlock> arr) =>
//     if array.size(arr) > 0
//         for i = 0 to array.size(arr) - 1
//             box.delete(array.get(arr, i).bg)
//         array.clear(arr)
//     int _r = 0

// ── MERGE OVERLAPPING BLOCKS (Aaron, 2026-07-30) ──
// Absorbs a candidate block into a live one it overlaps, and returns true if it was
// taken. Needed because every engulfing in the leg now makes a block (see f_obMake), so
// a consolidation stretch produced three or four boxes on nearly the same prices —
// stacked 94%-transparent fills compound into a solid wash and the crossing outlines are
// worse than the fill.
// Three overlapping blocks are not three levels. They are ONE area where orders sat, and
// that is how it is read anyway — so the boxes become one zone and the Max Order Blocks
// cap ends up counting ZONES rather than candles, which is the number that matters.
// THE TRADE-OFF, stated because it is real: mitigation is a TAP, so a merged zone is
// tapped at its SHALLOWEST edge. Merging a shallow block into a deep one means the
// shallow edge now kills both. Accepted because heavy overlap is itself evidence that
// stretch was chop rather than impulse, and one zone is the honest reading of chop — in a
// clean impulse the blocks step apart and rarely overlap at all.
// Merges into the FIRST overlapping block found, scanning oldest first. That accretes
// naturally: a later candidate overlapping the now-wider zone merges into the same one.
// Not handled, and accepted: a candidate that BRIDGES two previously separate zones
// merges into the older one and can leave the two touching. That is two boxes instead of
// one — the pre-merge behaviour — never a wrong level.
// ── MERGE IS GONE (Aaron, 2026-07-30) — it was the reason the boxes were oversized ──
// Every merge grew a zone in BOTH axes: the price bounds widened to cover both blocks,
// and the left edge moved back to the earlier origin. Compared side by side with the
// reference overlay that is exactly the difference — theirs draws several SMALL separate
// rectangles where mine drew one tall wide one covering the same stretch.
// Two blocks on nearly the same price are TWO blocks. Merging them was a decluttering
// idea, and the clutter it was solving (stacked near-identical boxes) is better solved by
// the FIFO cap, which drops the oldest and leaves the survivors at their true size.
// Commented rather than deleted — Pine does not compile comments, so this costs nothing
// and restoring it is uncommenting this and its one call site in f_obMake.
// method mergeOBs(array<OrderBlock> arr, float top, float bot, int leftBar) =>
//     bool merged = false
//     if array.size(arr) > 0
//         for i = 0 to array.size(arr) - 1
//             OrderBlock ob = array.get(arr, i)
//             if bot <= ob.top and top >= ob.bottom and math.abs(leftBar - box.get_left(ob.bg)) <= OB_MERGE_BARS
//                 ob.top    := math.max(ob.top, top)
//                 ob.bottom := math.min(ob.bottom, bot)
//                 box.set_top(ob.bg, ob.top)
//                 box.set_bottom(ob.bg, ob.bottom)
//                 box.set_left(ob.bg, math.min(box.get_left(ob.bg), leftBar))
//                 merged := true
//                 break
//     merged

// dir = the external structure direction (st.dir), passed in because st is declared
// hundreds of lines below this method. Only used for the trend-aligned filter.
method extendOBs(array<OrderBlock> arr, int dir) =>
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            OrderBlock ob = array.get(arr, i)
            // ── SHORT STUB, GROWING ONLY WHEN PRICE COMES BACK (Aaron, 2026-07-30) ──
            // A block sits as a SHORT box at its own candle for as long as price is
            // somewhere else. It stretches out to the live bar only once price has
            // travelled back to within one block-height of it — near enough that the
            // zone is in play and the reader wants to see it connect to the candles.
            // The old rule redrew every live block to the live bar on every bar, so a
            // level from this morning was a rectangle spanning the whole session.
            // The proximity tolerance is the BLOCK'S OWN HEIGHT rather than a fixed
            // number of points, so it scales with the instrument and the timeframe and
            // there is no magic constant to retune per chart.
            int   obLeft = box.get_left(ob.bg)
            float obH    = ob.top - ob.bottom
            bool  obNear = ob.isBullish ? low <= ob.top + obH : high >= ob.bottom - obH
            // The OB_STUB width is a FLOOR now, not a ceiling (Aaron, 2026-07-31). Both
            // old branches clamped to the live bar — `bar_index + 1` when near, and
            // math.min against it when away — so a block born ten bars ago was eleven bars
            // wide no matter what OB_STUB said, and raising the constant would have changed
            // nothing for exactly the newest blocks, the ones being looked at.
            // So the box is always at least OB_STUB bars long, running past the live bar
            // into the empty space on the right if it is young. Price coming back only
            // ever EXTENDS it further, never trims it.
            int obRight = obLeft + OB_STUB
            box.set_right(ob.bg, obNear ? math.max(bar_index + 1, obRight) : obRight)
            // Trend-aligned filter — recoloured every bar rather than latched, so a
            // block reappears the moment structure turns back to it. dir 0 = structure
            // undecided, show everything.
            bool obVis = not obDirOnly or dir == 0 or (ob.isBullish ? dir == 1 : dir == -1)
            box.set_bgcolor(ob.bg, obVis ? (ob.isBullish ? colBullOB : colBearOB) : color(na))
            box.set_border_color(ob.bg, obVis ? OB_EDGE : color(na))
            box.set_text_color(ob.bg, obVis ? (ob.isBullish ? obTextBull : obTextBear) : color(na))
            // ── MITIGATION = ENTER, THEN LEAVE (Aaron, 2026-07-30) ──
            // Two events, both measured on the CLOSE, and the block lives until both have
            // happened:
            //   1. ENTER — a candle closes INSIDE the zone. Price is in there, working
            //      the orders.
            //   2. LEAVE — a later candle closes OUTSIDE it. EITHER SIDE. Straight down
            //      through the far edge, or back out the way it came in.
            // WHILE PRICE SITS INSIDE, THE BLOCK STAYS. That is the whole rule, and it is
            // why the exit is not "closed past the far edge": a zone price is parked in is
            // being worked right now, and a zone price entered and then left is finished
            // with — whichever side it left by. A rejection back out of the top of a
            // bullish block mitigates it exactly as a break down through its bottom does.
            // The orders were reached either way.
            // BOTH HALVES ARE CLOSES, and the ENTRY one is the load-bearing choice. If a
            // WICK counted as entering, a single candle that pokes the zone and closes
            // back out would satisfy enter-and-leave on its own bar — which IS the tap
            // rule, the one that was deleting blocks the moment price touched them.
            // Requiring a close in means price genuinely traded there rather than grazing
            // it, so a wick rejection off the zone leaves it alive and untouched.
            // The day's other two rules were each half of this one. Close-through-the-far-
            // edge (the FVG rule) let a zone price entered and rejected out of live for
            // ever. Tap-only killed every block on the touch, deleting exactly the ones
            // that were WORKING — the level held, and the indicator rubbed it off the
            // chart for holding.
            // `entered` is latched on the OB object, so the two halves can land bars or
            // hours apart. Field writes on an array element persist — Pine UDTs are
            // references — which is what makes a per-block latch possible at all.
            // No creation-bar guard is needed: extendOBs runs BEFORE the creation blocks
            // each bar, so a block is never mitigation-checked on the bar it is born.
            // AGE is the other way out, and it carries more weight under this rule than
            // under the tap one. A block price never returns to can never be mitigated —
            // BOTH halves need price at the zone — so the age cap is now the only thing
            // retiring those. Read before any delete, since get_left on a deleted box is
            // not available.
            // THE THIRD WAY OUT, and it is the one that was missing (Aaron, 2026-07-31 —
            // "don't leave any OBs that have been mitigated on the chart"). Enter-then-
            // leave needs a candle to CLOSE INSIDE the zone at some point, and a block is
            // often only a few dollars tall — so price runs clean THROUGH it in one bar,
            // never closing in it, and `entered` stays false for ever. The block is then
            // immortal: fully worked through, still drawn, waiting on a condition that
            // can no longer happen. That is the wide box left sitting under price.
            // So a close fully PAST THE FAR EDGE kills it outright, entered or not. A
            // bullish block sits below price, so its far edge is the bottom; bearish is
            // the mirror. Price closing beyond the whole zone has been through every order
            // in it — there is nothing left there to come back for.
            // ── A WICK COUNTS. A CLOSE INSIDE BUYS TIME. (Aaron, 2026-07-31) ──
            // "If an OB is wicked and the candle pulls back it's mitigated. If the candle
            // enters the OB it stays visible till it exits."
            // Two different events, and the CLOSE is what tells them apart:
            //   WICKED — the bar's range reached into the zone but it CLOSED back outside.
            //     Price went in, took what was there, and left inside one candle. That is
            //     mitigation, and the block goes. This REVERSES the rule written above: a
            //     wick rejection used to leave the zone alive and untouched.
            //   ENTERED — the bar CLOSED inside. Price is parked in there working the
            //     orders, so the block stays visible for as long as that lasts, and dies
            //     on the first later close outside — either side.
            // So the zone survives exactly one thing: price still being in it. Anything
            // that reaches in and is not in it at the close has finished with it.
            // THE COST, stated because the earlier note was written about it: this is the
            // tap rule, and a tap rule kills the blocks that HELD — a level that rejects
            // price cleanly is wicked and closed out of, which is now its death. That is
            // the trade for a chart with no worked-through zones left on it.
            // The catch-up replay in f_obAdd does NOT apply this. It carries `entered`
            // and refuses a block price closed clean past, nothing more — so a wick during
            // the few bars before a block is born will not kill it at birth. Mitigation
            // still starts counting from the bar after creation.
            bool obInside = close <= ob.top and close >= ob.bottom
            bool obTouch  = low <= ob.top and high >= ob.bottom
            if not ob.entered and obInside
                ob.entered := true
            bool obStale   = bar_index - obLeft > OB_MAX_AGE
            bool obThrough = ob.isBullish ? close < ob.bottom : close > ob.top
            bool obMitigated = obThrough or (not obInside and (obTouch or ob.entered))
            if obStale or obMitigated
                box.delete(ob.bg)
                array.remove(arr, i)

//============================================================
  // FAIR VALUE GAPS (FVG) INPUTS
//============================================================
// Detection always runs (the A+ entry check reads the gaps); the toggle hides them.
bool showFVG = true
bool drawFVG = showTradeTools and showFVGInput
// Detection, appearance and cap are LOCKED to the tuned defaults — no panel inputs, so
// nothing about what a gap is or how many are kept can be altered. The cap was briefly
// an input (2026-08-02 → 2026-08-03) while the number was tested against a real chart;
// see the note at its old declaration site in GRP_TOOLS.
// Same shared filter the order blocks use — see dirOnlyInput. The FVG side already had
// this rule wired all the way through; it was just hardcoded off with no way to reach
// it. One exception survives on purpose: a gap sitting behind an EQH/EQL stays visible
// either way, because there it is liquidity confluence rather than a directional read.
bool  fvgDirOnly   = dirOnlyInput
color fvgBullColor = color.new(color.gray, 80)
color fvgBearColor = color.new(color.gray, 80)
// ── SYNCED TO mpc_strategy.pine 2026-08-02 (Aaron's call) ──
// These three were the reason the indicator drew gaps the A+ bot did not see. The
// strategy is the stricter side on all three, so the indicator was drawing a SUPERSET
// and a visible gap beside a "no FVG" block on the bot was expected rather than a bug.
// That is now closed: what is drawn here is what mpc_strategy.pine counts.
//   min gap 15m+     0.04 -> 0.1   (a 0.04% floor on $3,300 gold is $1.32; 0.1% is $3.30)
//   middle-bar close  off -> ON at 15m+, still forced OFF below 15m
//   max active gaps     8 -> 7
// ⚠ Sub-15m is UNCHANGED on all three counts — the floor was already 0.0 there and the
// close test is forced off below 15m in the strategy too, so the low timeframes draw
// exactly what they drew before. Only 15m and above moves.
// ⚠ engines/fair_value_gaps/ still DEFAULTS to the old 8 / 0.04 / False, and its
// docstring still calls those "the mpc_assistant defaults" — that is now stale text.
// It is harmless because every real consumer pins its own values (mpc_sos_fade already
// pins exactly the three below), and fvg_export.pine carries cfg_fvg_* columns so
// compare_fvg.py configures Python FROM the export rather than from a default. Re-export
// at these values before trusting the next parity run.
bool  fvgIsLTF     = timeframe.in_seconds() < 900
float fvgThreshLTF = 0.0
float fvgThreshHTF = 0.1
float fvgThreshPct = fvgIsLTF ? fvgThreshLTF : fvgThreshHTF
bool fvgRequireClose = fvgIsLTF ? false : true
int   fvgMaxCount  = 7
// ── THE ENTRY-ZONE GAPS ARE EXEMPT FROM THE CAP (Aaron, 2026-08-05) ──
// The complaint, and it is the cap working exactly as written: after a bearish SOS price
// drops and prints gap after gap on the way down. Every one takes a slot, the FIFO drops
// from the front, and the gaps it drops are the OLDEST — which on a retrace setup are the
// ones UP IN THE ENTRY ZONE, the only gaps the trade is ever taken from. The chart threw
// away the levels being watched to make room for levels below price that nothing reads.
// So a gap overlapping the live fib's 0.382-0.886 band, ON THE TRADE'S OWN SIDE, no longer
// counts against `fvgMaxCount` and is never chosen for eviction. It rides on top of the
// cap exactly as an EQ-backed gap does, and dies only when price mitigates it.
// ⚠ DIRECTION-MATCHED, deliberately. On a bearish leg only BEARISH gaps are protected —
// the bullish gaps printing inside the same band belong to the move against the setup, and
// the A+ entry rule cannot read them either (it requires `isBull == (fibo_dir == 1)`). So
// this pins the gaps a short is actually taken from and lets the rest queue as before.
// ⚠ 0.382, not 0.5, is the shallow edge — the band the reader marks up by hand. It is one
// rung shallower than the bot's own 0.5-0.886 entry zone, so a gap sitting just above 0.5
// survives to be looked at rather than being evicted for being a hair too shallow.
// The band arrives here from the fib block ~800 lines BELOW, because Pine needs a
// declaration before its use and fiboP* are declared down there. See the publish site.
bool  fvgExemptZone = true
var float fvgZoneLo  = na
var float fvgZoneHi  = na
var int   fvgZoneDir = 0
// The fib's RAW direction, published from the same place and read by `fvgBiasInput`.
// Deliberately NOT fvgZoneDir, which is zeroed once the leg completes so a finished setup
// stops PINNING gaps against the cap. The bias FILTER must keep working after TP3 — the
// leg is still the leg, and a reader who asked to see one side wants one side either way.
// Two globals because they answer two questions; sharing one would tie the filter's life
// to the cap exemption's, which is a coupling nobody asked for.
var int   fvgBiasDir = 0

//============================================================
  // EQUAL HIGHS / LOWS (EQH / EQL) — liquidity pools
//============================================================
// Detection, appearance and cap ALL LOCKED to tuned defaults — no panel inputs, so
// nothing about what an EQ level is, how many are kept, or how they draw can be altered.
// The three settled 2026-08-04 after a few hours on the panel; see the note at their old
// declaration site in GRP_TOOLS for the values they moved through.
// What each one drives, stated once so it does not have to be re-derived from the code:
//   eqAtrMult — the SENSITIVITY. Two consecutive same-side pivots are "equal" when their
//     prices sit within ATR(50) x this. It is the ONLY thing deciding what qualifies.
//     Measured in ATR rather than dollars so it travels across instruments and timeframes.
//     ⚠ It ALSO decides which fair value gaps sit "on" an EQ level, so it is the dial
//     behind the FVG cap exemption too — raising it keeps more gaps on the chart.
//   eqMax — the COUNT, a plain FIFO cap counted PER SIDE. Fourteen EQH and fourteen EQL,
//     not fourteen between them. Past the cap the oldest on that side is dropped. A level
//     already dies on its own when price WICKS through it, so this mostly bites in a
//     choppy range that keeps printing new ones.
//   eqPivotLen — how sharp a turn has to be to count as a pivot at all. Deliberately the
//     quietest of the three: it changes the INPUT to both rules above rather than either
//     rule, so moving it moves everything downstream at once.
// There is no line-extension constant — the line ends at the live candle (x2 = bar_index).
int   eqPivotLen  = 2
float eqAtrMult   = 0.25
int   eqMax       = 14
bool  eqExemptFvg = true
color eqhColor    = color.new(color.black, 0)
color eqlColor    = color.new(color.black, 0)

