var GRP_FIBO = "Fibs"
bool   showFiboInput   = input.bool(true, "Show External Fib", group = GRP_FIBO, tooltip = "The retracement drawn on the current major swing leg. Its lines are tagged TP1/TP2/TP3 (Take Profit) and E1-E4 (Entry levels). FFT = the 0.5 line once price has traded back through it.", display = display.none)
int    fiboLineExtend  = input.int(80, "External Fib Line Extension (bars)", group = GRP_FIBO, minval = 5, maxval = 500, active = showFiboInput, tooltip = "How far the External Fib lines run to the right of the last bar. Set it to suit your screen width.", display = display.none)
// Cycle Fib defaults OFF (Aaron, 2026-07-31). It draws EIGHT more horizontal lines,
// each with its own price tag, over the eight the External Fib is already drawing — the
// same ratios on a bigger leg, so the two ladders interleave and the labels stack down
// the right edge. Everything else on the panel is now on by default, which is exactly
// why this one has to come off: with the full chart showing, it is the tool that makes
// the other tools harder to read. The toggle stays — it is a real read on the bigger
// move — and the engine still tracks either way, so switching it on costs nothing.
bool   showMacroFibInput = input.bool(false, "Show Cycle Fib", group = GRP_FIBO, tooltip = "Off by default — it draws a second full ladder over the External Fib's. The same retracement drawn on the whole cycle rather than one leg — the move from the last major low to the last major high. Same TP and E tags.", display = display.none)
int    macroLineExtend = input.int(180, "Cycle Fib Line Extension (bars)", group = GRP_FIBO, minval = 10, maxval = 500, active = showMacroFibInput, tooltip = "How far the Cycle Fib lines run to the right of the last bar. Set it to suit your screen width.", display = display.none)
bool   showSniperInput = input.bool(true, "Show Sniper Zone", group = GRP_FIBO, active = showFiboInput, tooltip = "SZ = Sniper Zone. A significant area that institutions come back to after a displacement.", display = display.none)
bool   showBLeg        = input.bool(true, "Show BLEG SZ", group = GRP_FIBO, tooltip = "BLEG = B-Leg, a setup whose retrace arrives late. Shows the area it is waiting for price to come back to. 15m only.", display = display.none)

