//============================================================
//  ORDER BLOCKS
//============================================================
var GRP_OB = "Order Blocks"
bool  showOBs       = input.bool(true, "Show Order Blocks", group = GRP_OB, display = display.none)
bool  showBullOB    = input.bool(true, "Show Bullish OB", group = GRP_OB, inline = "BullOB", active = showOBs, display = display.none)
color colBullOB     = input.color(color.new(color.blue, 85), "", group = GRP_OB, inline = "BullOB", display = display.none)
bool  showBearOB    = input.bool(true, "Show Bearish OB", group = GRP_OB, inline = "BearOB", active = showOBs, display = display.none)
color colBearOB     = input.color(color.new(color.red, 85), "", group = GRP_OB, inline = "BearOB", display = display.none)
int   maxActiveOB   = input.int(6, "Max Active OBs (per direction)", group = GRP_OB, minval = 1, maxval = 20, active = showOBs, display = display.none)
bool  obBodyOnly    = input.bool(false, "Use Body Only for OB", group = GRP_OB, active = showOBs, display = display.none)

type OrderBlock
    box   bg
    float top
    float bottom
    bool  isBullish

var array<OrderBlock> activeBullOBs = array.new<OrderBlock>()
var array<OrderBlock> activeBearOBs = array.new<OrderBlock>()

method manageOBs(array<OrderBlock> arr, OrderBlock newOB) =>
    array.push(arr, newOB)
    if array.size(arr) > maxActiveOB
        OrderBlock oldest = array.shift(arr)
        box.delete(oldest.bg)

method extendOBs(array<OrderBlock> arr) =>
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            OrderBlock ob = array.get(arr, i)
            box.set_right(ob.bg, bar_index + 1)
            // Mitigation check
            if ob.isBullish
                if close < ob.bottom
                    box.delete(ob.bg)
                    array.remove(arr, i)
            else
                if close > ob.top
                    box.delete(ob.bg)
                    array.remove(arr, i)

