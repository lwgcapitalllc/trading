indicator("MPC- JARVIS", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500, max_bars_back = 2000)

var GRP_MASTER = "Display"
bool showTradeTools = input.bool(true, "Show Chart Tools", group = GRP_MASTER, tooltip = "Master switch for the chart tools below. Off leaves a clean market-structure-only chart.", display = display.none)
bool showFibTool    = input.bool(true, "Show Fibs", group = GRP_MASTER, tooltip = "Master switch for the fib tools.", display = display.none)

var GRP_TABLE = "Confirmation Table"
bool showConfTable = input.bool(true, "Show Confirmation Table", group = GRP_TABLE, display = display.none)
string tablePositionInput = input.string("Top Right", "Table Position", group = GRP_TABLE, options = ["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], active = showConfTable, display = display.none)
string tableSizeInput = input.string("Tiny", "Table Text Size", group = GRP_TABLE, options = ["Tiny", "Small", "Normal", "Large", "Huge"], active = showConfTable, display = display.none)
// COMPUTE vs DRAW — the rule for the five features the confirmation table feeds off
// (External Fib, FVG, Liquidity, RSI Divergence, Sniper Zone). Their ENGINES always
// run, so every table row works no matter what the student has switched off. Their
// toggles control DRAWING only. Each one below therefore has a show<X> compute flag
// (forced true) and a draw<X> flag wired to the input.
// This replaced the old "Table Priority" input, which forced the FEATURE on rather
// than just its engine — so with it enabled (the default) the External Fib, FVG,
// Liquidity, RSI Divergence and Sniper Zone toggles did nothing at all.

f_tablePosition(string opt) =>
    switch opt
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Top Right"     => position.top_right
        "Middle Left"   => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right"  => position.middle_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        "Bottom Right"  => position.bottom_right
        => position.top_right

f_tableSize(string opt) =>
    switch opt
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge
        => size.tiny


