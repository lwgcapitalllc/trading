indicator("MPC- JARVIS", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500, max_bars_back = 2000)

var GRP_MASTER = "Display"
bool showTradeTools = input.bool(false, "Show FVG, Order Blocks, Sessions & Liquidity", group = GRP_MASTER, tooltip = "Master switch for the discretionary tools: Fair Value Gaps, Order Blocks, Trading Sessions, Kill Zones and Liquidity Levels. Off by default for a clean market-structure-only chart.", display = display.none)
bool showFibTool    = input.bool(false, "Show External Fib", group = GRP_MASTER, tooltip = "Master switch for the External Fibonacci (entry zones / OTE). Off by default.", display = display.none)

var GRP_TABLE = "Confirmation Table"
bool showConfTable = input.bool(true, "Show Confirmation Table", group = GRP_TABLE, display = display.none)
string tablePositionInput = input.string("Top Right", "Table Position", group = GRP_TABLE, options = ["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], display = display.none)
string tableSizeInput = input.string("Tiny", "Table Text Size", group = GRP_TABLE, options = ["Tiny", "Small", "Normal", "Large", "Huge"], display = display.none)

f_tablePosition(string opt) =>
    switch opt
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Top Right"     => position.top_right
        "Middle Left"   => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right"  => position.middle_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        "Bottom Right"  => position.bottom_right
        => position.top_right

f_tableSize(string opt) =>
    switch opt
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge
        => size.tiny


//============================================================
//  SMC SETTINGS (hardcoded)
//============================================================
int   majorLength = 15
color bullColor   = color.blue
color bearColor   = color.red
color iBullColor  = bullColor
color iBearColor  = bearColor

//============================================================
//  MARKET STRUCTURE LABEL SIZE
//============================================================
var GRP_STRUCT = "Market Structure"
bool   marketStructureOnly = not showTradeTools and not showFibTool
string structLabelSize  = input.string("Small", "Structure Label Size",    group = GRP_STRUCT, options = ["Tiny", "Small", "Normal", "Large", "Huge"], display = display.none)
bool   showExternal     = input.bool(true,      "Show External Structure", group = GRP_STRUCT, display = display.none)
bool   showInternal     = input.bool(true,      "Show Internal Structure", group = GRP_STRUCT, display = display.none)
bool   showHistoricalInternal = input.bool(false, "Show Historic Internal Structure", group = GRP_STRUCT, tooltip = "Keep internal structure labels and lines from previous swing ranges on the chart. Off = only show current swing range internals.", display = display.none)
bool   showSwingLabels  = input.bool(true, "Show Swing Point Labels", group = GRP_STRUCT, tooltip = "Off = hide ASH/ASL, HH/HL, LH/LL and the internal swing point labels, leaving only BOS/SOS and iBOS/iSOS on the chart. The structure engine keeps running exactly as before — fibs, order blocks and the confirmation table are unaffected.", display = display.none)
int    internalLength   = 5
float  pbBuffer         = 0.0

f_structSize() =>
    not showExternal ? size.auto : structLabelSize == "Tiny" ? size.tiny : structLabelSize == "Normal" ? size.normal : structLabelSize == "Large" ? size.large : structLabelSize == "Huge" ? size.huge : size.small

// Swing-point labels are hidden by making their text transparent, not by skipping
// their creation. The label objects still exist and the engine's state is untouched,
// so structure tracking, fibs, OBs and the table behave identically either way.
f_swingCol(color c) =>
    showSwingLabels ? c : color(na)

//============================================================
//  ORDER BLOCKS
//============================================================
var GRP_OB = "Order Blocks"
bool  showOBsInput       = input.bool(false, "Show Order Blocks", group = GRP_OB, display = display.none)
bool showOBs = showTradeTools and showOBsInput
bool  showBullOB    = input.bool(true, "Show Bullish OB", group = GRP_OB, inline = "BullOB", active = showOBsInput, display = display.none)
color colBullOB     = input.color(color.new(color.blue, 85), "", group = GRP_OB, inline = "BullOB", display = display.none)
bool  showBearOB    = input.bool(true, "Show Bearish OB", group = GRP_OB, inline = "BearOB", active = showOBsInput, display = display.none)
color colBearOB     = input.color(color.new(color.red, 85), "", group = GRP_OB, inline = "BearOB", display = display.none)
int   maxActiveOB   = input.int(6, "Max Active OBs (per direction)", group = GRP_OB, minval = 1, maxval = 20, active = showOBsInput, display = display.none)
bool  obBodyOnly    = input.bool(false, "Use Body Only for OB", group = GRP_OB, active = showOBsInput, display = display.none)

type OrderBlock
    box   bg
    float top
    float bottom
    bool  isBullish

var array<OrderBlock> activeBullOBs = array.new<OrderBlock>()
var array<OrderBlock> activeBearOBs = array.new<OrderBlock>()

method manageOBs(array<OrderBlock> arr, OrderBlock newOB) =>
    array.push(arr, newOB)
    if array.size(arr) > maxActiveOB
        OrderBlock oldest = array.shift(arr)
        box.delete(oldest.bg)

method extendOBs(array<OrderBlock> arr) =>
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            OrderBlock ob = array.get(arr, i)
            box.set_right(ob.bg, bar_index + 1)
            // Mitigation check
            if ob.isBullish
                if close < ob.bottom
                    box.delete(ob.bg)
                    array.remove(arr, i)
            else
                if close > ob.top
                    box.delete(ob.bg)
                    array.remove(arr, i)

