//@version=6
// ── FIB PARITY-EXPORT BUILD ───────────────────────────────────────────────────
// Instrumented build used ONLY to validate the Python fibs (fibonacci/) against their Pine
// source. All parts are byte-faithful to their sources:
//   1. The EXTERNAL market-structure engine — copied verbatim from structure_engine_export.pine
//      (byte-identical to structure_engine.pine). Produces the st.* the fibs anchor on; validated
//      at 100% Python↔Pine parity.
//   2. The INTERNAL market-structure block — lifted from structure_engine_export.pine (validated
//      internal detection) PLUS the two mpc_assistant.pine captures the fibs need: the confirmed-
//      internal-swing anchors (i_confirmed_high/low_*, used by the Structure fib) and the iFib_*
//      seed anchors at each iBOS/iSOS (used by the Internal fib).
//   3. The four FIB blocks — Structure (GRP_FIBO), Sniper (GRP_SNIPER), Macro (GRP_MACRO) and the
//      new Internal (GRP_IFIB) — lifted from mpc_assistant.pine (compute + touched state machines;
//      drawing removed). These are the source of truth the Python ports are checked against, so the
//      comparison is Python-vs-real-Pine, not Python-vs-a-rewrite.
//
// The plot() columns at the bottom emit each fib's outputs (level prices, first-touch pulses,
// active/dir/origin/reset flags) so a TradingView CSV export can be diffed by
// fibonacci/tools/compare_fib.py. The Internal fib emits touch pulses + state only (no per-level
// price columns) to stay under TradingView's 64-plot limit — its touches validate the geometry
// indirectly (a touch fires exactly when price crosses a computed level). Runs in its own pane
// (overlay=false). Export on a <=5m chart so the Macro fib is exercised. Do NOT trade off this file
// or let any part drift from its source.
indicator("Fib EXPORT", overlay = false, max_labels_count = 500, max_lines_count = 500)

//============================================================
//  SMC SETTINGS (hardcoded)
//============================================================
int   majorLength = 15
color bullColor   = color.blue
color bearColor   = color.red
color iBullColor  = bullColor
color iBearColor  = bearColor

//============================================================
//  MARKET STRUCTURE LABEL SIZE
//============================================================
var GRP_STRUCT = "Market Structure"
string structLabelSize  = input.string("Small", "Structure Label Size",    group = GRP_STRUCT, options = ["Tiny", "Small", "Normal", "Large", "Huge"], display = display.none)
bool   showInternal     = input.bool(true,      "Show Internal Structure", group = GRP_STRUCT, display = display.none)
float  pbBuffer         = 0.0

f_structSize() =>
    structLabelSize == "Tiny" ? size.tiny : structLabelSize == "Normal" ? size.normal : structLabelSize == "Large" ? size.large : structLabelSize == "Huge" ? size.huge : size.small

//============================================================
//  SMC STRUCTURE TYPE
//============================================================
type SMCStructure
    int    length
    float  ash             = na
    int    ash_loc         = na
    string ash_type        = ""
    line   ash_line        = na
    label  ash_lbl         = na
    float  asl             = na
    int    asl_loc         = na
    string asl_type        = ""
    line   asl_line        = na
    label  asl_lbl         = na
    float  last_conf_high     = na
    int    last_conf_high_loc = na
    float  last_conf_low      = na
    int    last_conf_low_loc  = na
    int    dir            = 0
    bool   choch_lock     = false
    line   choch_ref      = na
    int    pb_mode        = 0
    int    pb_count       = 0
    float  pb_level       = na
    float  pb_extreme     = na
    int    pb_extreme_loc = na
    line   pb_line        = na
    bool   pb_started     = false
    float  pb_last_qualify_close = na
    float  pb_last_qualify_high  = na
    float  pb_extreme_close      = na
    float  prev_close     = na
    float  prev_high      = na
    float  prev_low       = na
    bool   seeded         = false
    bool   bull_bos       = false
    float  bull_bos_high  = na
    int    bull_bos_h_loc = na
    float  bull_bos_low   = na
    int    bull_bos_l_loc = na
    bool   bear_bos       = false
    float  bear_bos_high  = na
    int    bear_bos_h_loc = na
    float  bear_bos_low   = na
    int    bear_bos_l_loc = na
    bool   new_swing_high = false
    bool   new_swing_low  = false
    bool   bull_sos       = false
    bool   bear_sos       = false

// prefix: "" for external, "i" for internal
// bull_col / bear_col allow per-instance colors
method create_ash(SMCStructure st, float val, int loc, color col, bool solid, string prefix) =>
    if not na(st.ash_line)
        line.delete(st.ash_line)
    if not na(st.ash_lbl)
        label.delete(st.ash_lbl)
        st.ash_lbl := na
    st.ash      := val
    st.ash_loc  := loc
    st.ash_type := ""
    st.ash_lbl  := label.new(loc, val, prefix + "ASH\n", color=color(na), textcolor=col, style=label.style_label_down, size=f_structSize())
    st.ash_line := line.new(loc, val, bar_index, val, color=col, style=solid ? line.style_solid : line.style_dashed, width=solid ? 2 : 1)

method create_asl(SMCStructure st, float val, int loc, color col, bool solid, string prefix) =>
    if not na(st.asl_line)
        line.delete(st.asl_line)
    if not na(st.asl_lbl)
        label.delete(st.asl_lbl)
        st.asl_lbl := na
    st.asl      := val
    st.asl_loc  := loc
    st.asl_type := ""
    st.asl_lbl  := label.new(loc, val, "\n" + prefix + "ASL", color=color(na), textcolor=col, style=label.style_label_up, size=f_structSize())
    st.asl_line := line.new(loc, val, bar_index, val, color=col, style=solid ? line.style_solid : line.style_dashed, width=solid ? 2 : 1)

// process() now accepts prefix + bull/bear colors so both instances share one method
method process(SMCStructure st, float ph_val, float pl_val, string prefix, color bull_col, color bear_col) =>

    st.bull_bos := false
    st.bear_bos := false
    st.new_swing_high := false
    st.new_swing_low  := false
    st.bull_sos := false
    st.bear_sos := false

    bool is_inside = false
    if not na(st.prev_high) and not na(st.prev_low)
        is_inside := high < st.prev_high and low > st.prev_low

    if st.choch_lock
        if st.dir == 1 and not na(pl_val)
            st.choch_lock := false
        else if st.dir == -1 and not na(ph_val)
            st.choch_lock := false

    if st.pb_mode == 1
        if not st.pb_started
            st.pb_started            := true
            st.pb_extreme            := high
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_count              := 0
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
        else
            bool extreme_updated_1 = false
            if na(st.pb_extreme) or high > st.pb_extreme
                st.pb_extreme            := high
                st.pb_extreme_loc        := bar_index
                st.pb_extreme_close      := na
                st.pb_count              := 0
                st.pb_last_qualify_close := na
                st.pb_last_qualify_high  := na
                extreme_updated_1        := true
            bool extreme_is_bearish_1 = extreme_updated_1 and close < open
            bool is_candle1_1 = na(st.pb_last_qualify_close) and not extreme_updated_1
            if (not is_inside or is_candle1_1) and (not extreme_updated_1 or extreme_is_bearish_1)
                float threshold = na(st.pb_last_qualify_high) ? st.pb_extreme : st.pb_last_qualify_high
                if close < threshold - pbBuffer
                    st.pb_count              += 1
                    st.pb_last_qualify_close := close
                    st.pb_last_qualify_high  := low
            if st.pb_count >= 3 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
                if not na(st.ash_line)
                    line.delete(st.ash_line)
                if not na(st.ash_lbl)
                    label.delete(st.ash_lbl)
                st.ash      := st.pb_extreme
                st.ash_loc  := st.pb_extreme_loc
                st.ash_type := "LOCKED"
                st.ash_line := line.new(st.pb_extreme_loc, st.pb_extreme, bar_index, st.pb_extreme, color=bear_col, style=line.style_solid, width=1)
                st.ash_lbl  := label.new(st.pb_extreme_loc, st.pb_extreme, prefix + "ASH\n", color=color(na), textcolor=bear_col, style=label.style_label_down, size=f_structSize())
                st.new_swing_high := true
                st.pb_mode    := 0
                st.pb_count   := 0
                st.choch_lock := false

    else if st.pb_mode == -1
        if not st.pb_started
            st.pb_started            := true
            st.pb_extreme            := low
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_count              := 0
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
        else
            bool extreme_updated_m1 = false
            if na(st.pb_extreme) or low < st.pb_extreme
                st.pb_extreme            := low
                st.pb_extreme_loc        := bar_index
                st.pb_extreme_close      := na
                st.pb_count              := 0
                st.pb_last_qualify_close := na
                st.pb_last_qualify_high  := na
                extreme_updated_m1       := true
            bool extreme_is_bullish_m1 = extreme_updated_m1 and close > open
            bool is_candle1_m1 = na(st.pb_last_qualify_close) and not extreme_updated_m1
            if (not is_inside or is_candle1_m1) and (not extreme_updated_m1 or extreme_is_bullish_m1)
                float threshold = na(st.pb_last_qualify_high) ? st.pb_extreme : st.pb_last_qualify_high
                if close > threshold + pbBuffer
                    st.pb_count              += 1
                    st.pb_last_qualify_close := close
                    st.pb_last_qualify_high  := high
            if st.pb_count >= 3 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
                if not na(st.asl_line)
                    line.delete(st.asl_line)
                if not na(st.asl_lbl)
                    label.delete(st.asl_lbl)
                st.asl      := st.pb_extreme
                st.asl_loc  := st.pb_extreme_loc
                st.asl_type := "LOCKED"
                st.asl_line := line.new(st.pb_extreme_loc, st.pb_extreme, bar_index, st.pb_extreme, color=bull_col, style=line.style_solid, width=1)
                st.asl_lbl  := label.new(st.pb_extreme_loc, st.pb_extreme, "\n" + prefix + "ASL", color=color(na), textcolor=bull_col, style=label.style_label_up, size=f_structSize())
                st.new_swing_low := true
                st.pb_mode    := 0
                st.pb_count   := 0
                st.choch_lock := false

    st.prev_close := close
    st.prev_high  := high
    st.prev_low   := low

    if na(st.ash) and na(st.asl) and not st.seeded
        if not na(ph_val)
            st.create_ash(ph_val, bar_index[st.length], bear_col, false, prefix)
            st.dir := -1
        else if not na(pl_val)
            st.create_asl(pl_val, bar_index[st.length], bull_col, false, prefix)
            st.dir := 1

    if not st.seeded
        if not na(st.ash) and na(st.asl)
            float seed_low = low
            int   seed_loc = bar_index
            int   lb       = math.min(bar_index, 500)
            for i = 0 to lb
                if low[i] < seed_low
                    seed_low := low[i]
                    seed_loc := bar_index - i
            if seed_low < st.ash
                st.asl      := seed_low
                st.asl_loc  := seed_loc
                st.asl_type := ""
                st.asl_line := line.new(seed_loc, seed_low, bar_index, seed_low, color=bull_col, style=line.style_dashed, width=1)
                st.asl_lbl  := label.new(seed_loc, seed_low, "\n" + prefix + "ASL", color=color(na), textcolor=bull_col, style=label.style_label_up, size=f_structSize())
                st.seeded := true
        else if not na(st.asl) and na(st.ash)
            float seed_high = high
            int   seed_loc  = bar_index
            int   lb        = math.min(bar_index, 500)
            for i = 0 to lb
                if high[i] > seed_high
                    seed_high := high[i]
                    seed_loc  := bar_index - i
            if seed_high > st.asl
                st.ash      := seed_high
                st.ash_loc  := seed_loc
                st.ash_type := ""
                st.ash_line := line.new(seed_loc, seed_high, bar_index, seed_high, color=bear_col, style=line.style_dashed, width=1)
                st.ash_lbl  := label.new(seed_loc, seed_high, prefix + "ASH\n", color=color(na), textcolor=bear_col, style=label.style_label_down, size=f_structSize())
                st.seeded := true
        else if not na(st.ash) and not na(st.asl)
            st.seeded := true

    if na(st.last_conf_high) and na(st.last_conf_low)
        if not na(ph_val) and not na(st.ash) and st.ash_type == "" and st.pb_mode == 0
            if ph_val > st.ash
                st.create_ash(ph_val, bar_index[st.length], bear_col, false, prefix)
        if not na(pl_val) and not na(st.asl) and st.asl_type == "" and st.pb_mode == 0
            if pl_val < st.asl
                st.create_asl(pl_val, bar_index[st.length], bull_col, false, prefix)

    bool ash_broken = not na(st.ash) and close > st.ash
    bool asl_broken = not na(st.asl) and close < st.asl

    if ash_broken
        st.bull_bos := true
        st.bull_bos_high  := st.ash
        st.bull_bos_h_loc := st.ash_loc

        bool was_in_bear_pb = st.pb_mode == -1 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
        st.pb_mode  := 0
        st.pb_count := 0

        bool   is_choch    = st.dir == -1 and not st.choch_lock
        string brk_lbl_txt = is_choch ? prefix + "SOS" : prefix + "BOS"
        if is_choch
            st.bull_sos := true
        int    mid_x       = math.round((st.ash_loc + bar_index) / 2)
        label.new(mid_x, st.ash, "\n" + brk_lbl_txt, color=color(na), textcolor=bull_col, style=label.style_label_down, size=size.tiny)

        if is_choch
            st.choch_lock := true

        bool brk_already_conf_high = (st.ash == st.last_conf_high and st.ash_loc == st.last_conf_high_loc)
        if not na(st.ash_lbl)
            label.delete(st.ash_lbl)
        if not brk_already_conf_high
            bool   brk_is_hh  = na(st.last_conf_high) or st.ash >= st.last_conf_high
            string brk_high_t = brk_is_hh ? prefix + "HH" : prefix + "LH"
            color  brk_high_c = brk_is_hh ? bull_col : bear_col
            label.new(st.ash_loc, st.ash, brk_high_t + "\n", color=color(na), textcolor=brk_high_c, style=label.style_label_down, size=f_structSize())

        if not na(st.ash_line)
            line.set_style(st.ash_line, line.style_solid)
            line.set_color(st.ash_line, bull_col)
            line.set_width(st.ash_line, 2)
            line.set_x2(st.ash_line, bar_index)
            st.ash_line := na

        st.last_conf_high     := st.ash
        st.last_conf_high_loc := st.ash_loc
        st.ash_lbl            := na
        st.ash                := na
        st.dir                := 1

        if was_in_bear_pb
            st.bull_bos_low   := st.pb_extreme
            st.bull_bos_l_loc := st.pb_extreme_loc
            if not na(st.asl_line)
                line.delete(st.asl_line)
            if not na(st.asl_lbl)
                label.delete(st.asl_lbl)
            bool   pb_is_hl = is_choch ? false : (na(st.last_conf_low) or st.pb_extreme >= st.last_conf_low)
            string pb_low_t = pb_is_hl ? prefix + "HL" : prefix + "LL"
            color  pb_low_c = pb_is_hl ? bull_col : bear_col
            st.asl      := st.pb_extreme
            st.asl_loc  := st.pb_extreme_loc
            st.asl_type := "LOCKED"
            st.asl_line := line.new(st.pb_extreme_loc, st.pb_extreme, bar_index, st.pb_extreme, color=bull_col, style=line.style_solid, width=1)
            st.asl_lbl  := label.new(st.pb_extreme_loc, st.pb_extreme, "\n" + pb_low_t, color=color(na), textcolor=pb_low_c, style=label.style_label_up, size=f_structSize())
            st.last_conf_low         := st.pb_extreme
            st.last_conf_low_loc     := st.pb_extreme_loc
            st.pb_extreme            := high
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_mode               := 1
            st.pb_started            := true
        else
            if not na(st.asl)
                bool already_conf_low = (st.asl == st.last_conf_low and st.asl_loc == st.last_conf_low_loc)
                if not already_conf_low
                    bool   old_is_hl = is_choch ? false : (na(st.last_conf_low) or st.asl >= st.last_conf_low)
                    string old_low_t = old_is_hl ? prefix + "HL" : prefix + "LL"
                    color  old_low_c = old_is_hl ? bull_col : bear_col
                    if not na(st.asl_lbl)
                        label.delete(st.asl_lbl)
                    label.new(st.asl_loc, st.asl, "\n" + old_low_t, color=color(na), textcolor=old_low_c, style=label.style_label_up, size=f_structSize())
                    st.last_conf_low     := st.asl
                    st.last_conf_low_loc := st.asl_loc
                else
                    if not na(st.asl_lbl)
                        label.delete(st.asl_lbl)
                if not na(st.asl_line)
                    line.delete(st.asl_line)
                st.asl_line := na
                st.asl_lbl  := na
                st.asl      := na

            float lowest_val = low
            int   lowest_loc = bar_index
            int   bars_back  = na(st.last_conf_high_loc) ? bar_index : bar_index - st.last_conf_high_loc
            if bars_back > 0
                int max_lb = math.min(math.min(bars_back, 1490), bar_index)
                for i = 0 to max_lb
                    if low[i] < lowest_val
                        lowest_val := low[i]
                        lowest_loc := bar_index - i

            st.bull_bos_low   := lowest_val
            st.bull_bos_l_loc := lowest_loc

            st.asl      := lowest_val
            st.asl_loc  := lowest_loc
            st.asl_type := ""
            st.asl_line := line.new(lowest_loc, lowest_val, bar_index, lowest_val, color=bull_col, style=line.style_solid, width=1)
            if lowest_val != st.last_conf_low
                st.asl_lbl := label.new(lowest_loc, lowest_val, "\n" + prefix + "ASL", color=color(na), textcolor=bull_col, style=label.style_label_up, size=f_structSize())
            else
                st.asl_lbl := na

            st.pb_mode               := 1
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_extreme            := high
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true

    else if asl_broken
        st.bear_bos := true
        st.bear_bos_low   := st.asl
        st.bear_bos_l_loc := st.asl_loc

        bool was_in_bull_pb = st.pb_mode == 1 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
        st.pb_mode  := 0
        st.pb_count := 0

        bool   is_choch    = st.dir == 1 and not st.choch_lock
        string brk_lbl_txt = is_choch ? prefix + "SOS" : prefix + "BOS"
        if is_choch
            st.bear_sos := true
        int    mid_x       = math.round((st.asl_loc + bar_index) / 2)
        label.new(mid_x, st.asl, brk_lbl_txt + "\n", color=color(na), textcolor=bear_col, style=label.style_label_up, size=size.tiny)

        if is_choch
            st.choch_lock := true

        bool brk_already_conf_low = (st.asl == st.last_conf_low and st.asl_loc == st.last_conf_low_loc)
        if not na(st.asl_lbl)
            label.delete(st.asl_lbl)
        if not brk_already_conf_low
            bool   brk_is_hl = na(st.last_conf_low) or st.asl >= st.last_conf_low
            string brk_low_t = brk_is_hl ? prefix + "HL" : prefix + "LL"
            label.new(st.asl_loc, st.asl, "\n" + brk_low_t, color=color(na), textcolor=bear_col, style=label.style_label_up, size=f_structSize())

        if not na(st.asl_line)
            line.set_style(st.asl_line, line.style_solid)
            line.set_color(st.asl_line, bear_col)
            line.set_width(st.asl_line, 2)
            line.set_x2(st.asl_line, bar_index)
            st.asl_line := na

        st.last_conf_low     := st.asl
        st.last_conf_low_loc := st.asl_loc
        st.asl_lbl           := na
        st.asl               := na
        st.dir               := -1

        if was_in_bull_pb
            st.bear_bos_high  := st.pb_extreme
            st.bear_bos_h_loc := st.pb_extreme_loc
            if not na(st.ash_line)
                line.delete(st.ash_line)
            if not na(st.ash_lbl)
                label.delete(st.ash_lbl)
            bool   pb_is_hh  = na(st.last_conf_high) or st.pb_extreme >= st.last_conf_high
            string pb_high_t = pb_is_hh ? prefix + "HH" : prefix + "LH"
            color  pb_high_c = pb_is_hh ? bull_col : bear_col
            st.ash      := st.pb_extreme
            st.ash_loc  := st.pb_extreme_loc
            st.ash_type := "LOCKED"
            st.ash_line := line.new(st.pb_extreme_loc, st.pb_extreme, bar_index, st.pb_extreme, color=bear_col, style=line.style_solid, width=1)
            st.ash_lbl  := label.new(st.pb_extreme_loc, st.pb_extreme, pb_high_t + "\n", color=color(na), textcolor=pb_high_c, style=label.style_label_down, size=f_structSize())
            st.last_conf_high        := st.pb_extreme
            st.last_conf_high_loc    := st.pb_extreme_loc
            st.pb_extreme            := low
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_mode               := -1
            st.pb_started            := true
        else
            if not na(st.ash)
                bool already_conf_high = (st.ash == st.last_conf_high and st.ash_loc == st.last_conf_high_loc)
                if not already_conf_high
                    bool   old_is_hh  = is_choch ? true : (na(st.last_conf_high) or st.ash >= st.last_conf_high)
                    string old_high_t = old_is_hh ? prefix + "HH" : prefix + "LH"
                    color  old_high_c = old_is_hh ? bull_col : bear_col
                    if not na(st.ash_lbl)
                        label.delete(st.ash_lbl)
                    label.new(st.ash_loc, st.ash, old_high_t + "\n", color=color(na), textcolor=old_high_c, style=label.style_label_down, size=f_structSize())
                    st.last_conf_high     := st.ash
                    st.last_conf_high_loc := st.ash_loc
                else
                    if not na(st.ash_lbl)
                        label.delete(st.ash_lbl)
                if not na(st.ash_line)
                    line.delete(st.ash_line)
                st.ash_line := na
                st.ash_lbl  := na
                st.ash      := na

            float highest_val = high
            int   highest_loc = bar_index
            int   bars_back   = na(st.last_conf_low_loc) ? bar_index : bar_index - st.last_conf_low_loc
            if bars_back > 0
                int max_lb = math.min(math.min(bars_back, 1490), bar_index)
                for i = 0 to max_lb
                    if high[i] > highest_val
                        highest_val := high[i]
                        highest_loc := bar_index - i

            st.bear_bos_high  := highest_val
            st.bear_bos_h_loc := highest_loc

            st.ash      := highest_val
            st.ash_loc  := highest_loc
            st.ash_type := ""
            st.ash_line := line.new(highest_loc, highest_val, bar_index, highest_val, color=bear_col, style=line.style_solid, width=1)
            if highest_val != st.last_conf_high
                st.ash_lbl := label.new(highest_loc, highest_val, prefix + "ASH\n", color=color(na), textcolor=bear_col, style=label.style_label_down, size=f_structSize())
            else
                st.ash_lbl := na

            st.pb_mode               := -1
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_extreme            := low
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true

    if not na(st.ash_line)
        line.set_x2(st.ash_line, bar_index)
    if not na(st.asl_line)
        line.set_x2(st.asl_line, bar_index)

//============================================================
//  EXECUTION — EXTERNAL STRUCTURE
//============================================================
// External structure — majorLength=15, blue/red, prefix ""
var st = SMCStructure.new(majorLength)
ph = ta.pivothigh(high, majorLength, majorLength)
pl = ta.pivotlow(low,  majorLength, majorLength)
st.process(ph, pl, "", bullColor, bearColor)

//============================================================
//  EXECUTION — INTERNAL STRUCTURE
//  Lifted from structure_engine_export.pine (byte-identical, validated internal detection) PLUS
//  the two mpc_assistant.pine capture additions the Internal fib needs: i_confirmed_high/low_*
//  (at each iSH/iSL confirm) and the iFib_* seed anchors (at each of the six iBOS/iSOS sites).
//  Detection logic is unchanged — only the capture lines and iFib state vars are added.
//============================================================
bool showIFib = true

// ── State ─────────────────────────────────────────────────
var int   i_mode           = 0
var bool  i_seeded         = false

var float i_pb_extreme     = na
var int   i_pb_extreme_loc = na
var int   i_pb_count       = 0
var bool  i_pb_started     = false
var float i_pb_lqc         = na
var float i_pb_lqh         = na
var float i_prev_high      = na
var float i_prev_low       = na

var float i_sw_price       = na
var int   i_sw_loc         = na
var line  i_sw_line        = na
var label i_sw_lbl         = na

var bool  i_ext_chg        = false
var bool  i_is_inside      = false
var bool  i_ext_dir        = false
var bool  i_is_c1          = false
var float i_thresh         = na

var float i_tracked_ext     = na
var int   i_tracked_ext_loc = na
var int   i_last_mode       = 0
var bool  i_had_bos         = false
var int   i_bos_dir         = 0
var string i_h_lbl          = ""
var color  i_h_col          = color.black
var string i_l_lbl          = ""
var color  i_l_col          = color.black
var int   i_mid             = 0
var int   i_mid2            = 0
var float i_last_hl         = na
var float i_last_lh         = na
var int   i_last_hl_loc     = na
var int   i_last_lh_loc     = na

var float i_sos_watch_hh    = na
var int   i_sos_watch_hh_loc= na
var float i_sos_watch_ll    = na
var int   i_sos_watch_ll_loc= na

float i_lbl_y_offset = syminfo.mintick * 100

// ── iFib state (mpc_assistant.pine) — confirmed-internal-swing anchors + the internal fib itself ──
var float i_confirmed_low_price  = na
var int   i_confirmed_low_loc    = na
var float i_confirmed_high_price = na
var int   i_confirmed_high_loc   = na

var float iFib_asl     = na
var int   iFib_asl_loc = na
var float iFib_ash     = na
var int   iFib_ash_loc = na
var int   iFib_dir     = 0
var bool iFib0Touched     = false
var bool iFib382Touched   = false
var bool iFib50Touched    = false
var bool iFib618Touched   = false
var bool iFib702Touched   = false
var bool iFib786Touched   = false
var bool iFib886Touched   = false
var bool iFib100Touched   = false
var bool iFib618EverReached = false
var float iFib_tp3_hit_price = na
var bool  iFibResetActive    = false

// ── Stop internal tracking on external BOS/SOS ───────────
if showInternal and (st.bull_bos or st.bear_bos or st.bull_sos or st.bear_sos)
    if not na(i_sw_line)
        line.set_x2(i_sw_line, bar_index)
        i_sw_line := na
    i_sw_lbl          := na
    i_sw_price        := na
    i_mode            := 0
    i_seeded          := false
    i_pb_count        := 0
    i_pb_started      := false
    i_tracked_ext     := na
    i_tracked_ext_loc := na
    i_last_hl         := na
    i_last_lh         := na
    i_had_bos         := false
    i_sos_watch_hh    := na
    i_sos_watch_ll    := na

// ── Track prev bar ────────────────────────────────────────
if showInternal
    i_prev_high := high
    i_prev_low  := low

// ── Seed on new external swing ────────────────────────────
if showInternal
    if st.new_swing_low and not st.bull_sos and not st.bear_sos
        i_mode            := 1
        i_seeded          := true
        i_had_bos         := false
        i_bos_dir         := 0
        i_pb_started      := false
        i_pb_extreme      := na
        i_pb_count        := 0
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_mode       := 1
        i_last_hl         := na
        i_last_lh         := na
        i_sos_watch_hh    := na
        i_sos_watch_ll    := na
    else if st.new_swing_high and not st.bull_sos and not st.bear_sos
        i_mode            := -1
        i_seeded          := true
        i_had_bos         := false
        i_bos_dir         := 0
        i_pb_started      := false
        i_pb_extreme      := na
        i_pb_count        := 0
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_mode       := -1
        i_last_hl         := na
        i_last_lh         := na
        i_sos_watch_hh    := na
        i_sos_watch_ll    := na

// ── Mode 1: track upward move → confirm iSH ──────────────
if showInternal and i_seeded and i_mode == 1
    if not i_pb_started
        i_pb_started     := true
        i_pb_extreme     := high
        i_pb_extreme_loc := bar_index
        i_pb_count       := 0
        i_pb_lqc         := na
        i_pb_lqh         := na
    else
        i_ext_chg := false
        if high > i_pb_extreme
            i_pb_extreme     := high
            i_pb_extreme_loc := bar_index
            i_pb_count       := 0
            i_pb_lqc         := na
            i_pb_lqh         := na
            i_ext_chg        := true
        i_is_inside := not na(i_prev_high) and not na(i_prev_low) and high < i_prev_high and low > i_prev_low
        i_ext_dir   := i_ext_chg and close < open
        i_is_c1     := na(i_pb_lqc) and not i_ext_chg
        if (not i_is_inside or i_is_c1) and (not i_ext_chg or i_ext_dir)
            i_thresh := na(i_pb_lqh) ? i_pb_extreme : i_pb_lqh
            if close < i_thresh - pbBuffer
                i_pb_count += 1
                i_pb_lqc   := close
                i_pb_lqh   := low
        if i_pb_count >= 3 and not na(i_pb_extreme)
            if not na(i_sw_line)
                line.set_x2(i_sw_line, bar_index)
            i_sw_line  := na
            i_sw_lbl   := na
            i_sw_price := i_pb_extreme
            i_sw_loc   := i_pb_extreme_loc
            i_h_lbl := not i_had_bos ? "iSH" : "iHH"
            i_h_col := not i_had_bos ? iBearColor : iBullColor
            i_confirmed_high_price := i_sw_price
            i_confirmed_high_loc   := i_sw_loc
            i_sw_line  := line.new(i_sw_loc, i_sw_price, bar_index, i_sw_price, color = color.new(i_h_col, 15), style = line.style_dotted, width = 1)
            i_sw_lbl   := label.new(i_sw_loc, i_sw_price, i_h_lbl + "\n", color = color(na), textcolor = color.new(i_h_col, 15), style = label.style_label_down, size = size.tiny)
            i_mode       := 0
            i_pb_count   := 0
            i_pb_started := false

// ── Mode -1: track downward move → confirm iSL ───────────
if showInternal and i_seeded and i_mode == -1
    if not i_pb_started
        i_pb_started     := true
        i_pb_extreme     := low
        i_pb_extreme_loc := bar_index
        i_pb_count       := 0
        i_pb_lqc         := na
        i_pb_lqh         := na
    else
        i_ext_chg := false
        if low < i_pb_extreme
            i_pb_extreme     := low
            i_pb_extreme_loc := bar_index
            i_pb_count       := 0
            i_pb_lqc         := na
            i_pb_lqh         := na
            i_ext_chg        := true
        i_is_inside := not na(i_prev_high) and not na(i_prev_low) and high < i_prev_high and low > i_prev_low
        i_ext_dir   := i_ext_chg and close > open
        i_is_c1     := na(i_pb_lqc) and not i_ext_chg
        if (not i_is_inside or i_is_c1) and (not i_ext_chg or i_ext_dir)
            i_thresh := na(i_pb_lqh) ? i_pb_extreme : i_pb_lqh
            if close > i_thresh + pbBuffer
                i_pb_count += 1
                i_pb_lqc   := close
                i_pb_lqh   := high
        if i_pb_count >= 3 and not na(i_pb_extreme)
            if not na(i_sw_line)
                line.set_x2(i_sw_line, bar_index)
            i_sw_line  := na
            i_sw_lbl   := na
            i_sw_price := i_pb_extreme
            i_sw_loc   := i_pb_extreme_loc
            i_l_lbl := not i_had_bos ? "iSL" : "iLL"
            i_l_col := not i_had_bos ? iBullColor : iBearColor
            i_confirmed_low_price := i_sw_price
            i_confirmed_low_loc   := i_sw_loc
            i_sw_line  := line.new(i_sw_loc, i_sw_price, bar_index, i_sw_price, color = color.new(i_l_col, 15), style = line.style_dotted, width = 1)
            i_sw_lbl   := label.new(i_sw_loc, i_sw_price, "\n" + i_l_lbl, color = color(na), textcolor = color.new(i_l_col, 15), style = label.style_label_up, size = size.tiny)
            i_mode       := 0
            i_pb_count   := 0
            i_pb_started := false

// ── Track extreme while watching (mode 0) ────────────────
if showInternal and i_seeded and i_mode == 0
    if i_last_mode == 1
        if na(i_tracked_ext) or low < i_tracked_ext
            i_tracked_ext     := low
            i_tracked_ext_loc := bar_index
    else if i_last_mode == -1
        if na(i_tracked_ext) or high > i_tracked_ext
            i_tracked_ext     := high
            i_tracked_ext_loc := bar_index

// ── iBOS / iSOS detection ────────────────────────────────
bool int_bull_break = false
bool int_bear_break = false
int  int_break_origin_loc = na

if showInternal and i_mode == 0 and i_seeded and not na(i_sw_price) and barstate.isconfirmed
    if close > i_sw_price and i_last_mode == 1
        i_mid := math.round((i_sw_loc + bar_index) / 2)
        label.new(i_mid, i_sw_price + i_lbl_y_offset, "iBOS", color = color(na), textcolor = iBullColor, style = label.style_none, size = size.tiny, textalign = text.align_center)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sw_line := na
        i_sw_lbl := na
        if not na(i_tracked_ext)
            line.new(i_tracked_ext_loc, i_tracked_ext, bar_index, i_tracked_ext, color = color.new(iBullColor, 15), style = line.style_dotted, width = 1)
            label.new(i_tracked_ext_loc, i_tracked_ext, "\niHL", color = color(na), textcolor = color.new(iBullColor, 15), style = label.style_label_up, size = size.tiny)
            i_last_hl     := i_tracked_ext
            i_last_hl_loc := i_tracked_ext_loc

        int_bull_break := true
        int_break_origin_loc := i_tracked_ext_loc
        // iFib seed — bull iBOS: bottom = i_last_hl, top = i_sw_price, dir 1
        if showIFib and not na(i_last_hl) and not na(i_sw_price)
            iFib_asl := i_last_hl,  iFib_asl_loc := i_last_hl_loc
            iFib_ash := i_sw_price, iFib_ash_loc := i_sw_loc
            iFib_dir := 1
            iFib0Touched := false, iFib382Touched := false, iFib50Touched := false
            iFib618Touched := false, iFib702Touched := false, iFib786Touched := false
            iFib886Touched := false, iFib100Touched := false, iFib618EverReached := false
            iFib_tp3_hit_price := na, iFibResetActive := false

        i_sw_price       := na
        i_tracked_ext    := na
        i_tracked_ext_loc := na
        i_pb_count       := 0
        i_pb_started     := false
        i_pb_lqc         := na
        i_pb_lqh         := na
        i_had_bos        := true
        i_bos_dir        := 1
        i_last_mode      := 1
        i_mode           := 1
        i_sos_watch_ll   := na

    else if close < i_sw_price and i_last_mode == -1
        i_mid2 := math.round((i_sw_loc + bar_index) / 2)
        label.new(i_mid2, i_sw_price - i_lbl_y_offset, "iBOS", color = color(na), textcolor = iBearColor, style = label.style_none, size = size.tiny, textalign = text.align_center)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sw_line := na
        i_sw_lbl := na
        if not na(i_tracked_ext)
            line.new(i_tracked_ext_loc, i_tracked_ext, bar_index, i_tracked_ext, color = color.new(iBearColor, 15), style = line.style_dotted, width = 1)
            label.new(i_tracked_ext_loc, i_tracked_ext, "iLH\n", color = color(na), textcolor = color.new(iBearColor, 15), style = label.style_label_down, size = size.tiny)
            i_last_lh     := i_tracked_ext
            i_last_lh_loc := i_tracked_ext_loc

        int_bear_break := true
        int_break_origin_loc := i_tracked_ext_loc
        // iFib seed — bear iBOS: bottom = i_sw_price, top = i_last_lh, dir -1
        if showIFib and not na(i_sw_price) and not na(i_last_lh)
            iFib_asl := i_sw_price,  iFib_asl_loc := i_sw_loc
            iFib_ash := i_last_lh,   iFib_ash_loc := i_last_lh_loc
            iFib_dir := -1
            iFib0Touched := false, iFib382Touched := false, iFib50Touched := false
            iFib618Touched := false, iFib702Touched := false, iFib786Touched := false
            iFib886Touched := false, iFib100Touched := false, iFib618EverReached := false
            iFib_tp3_hit_price := na, iFibResetActive := false

        i_sw_price        := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_pb_count        := 0
        i_pb_started      := false
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_had_bos         := true
        i_bos_dir         := -1
        i_last_mode       := -1
        i_mode            := -1
        i_sos_watch_hh    := na

// ── iSOS detection (watches last iHL / iLH) ──────────────
if showInternal and i_seeded and i_had_bos and barstate.isconfirmed
    if i_last_mode == 1 and not na(i_last_hl) and close < i_last_hl and i_mode == 0
        i_mid2 := math.round((i_last_hl_loc + bar_index) / 2)
        label.new(i_mid2, i_last_hl - i_lbl_y_offset, "iSOS", color = color(na), textcolor = iBearColor, style = label.style_none, size = size.tiny, textalign = text.align_center)
        line.new(i_last_hl_loc, i_last_hl, bar_index, i_last_hl, color = color.new(iBearColor, 15), style = line.style_dotted, width = 1)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sw_line := na

        i_sos_watch_hh     := i_sw_price
        i_sos_watch_hh_loc := i_sw_loc
        i_sos_watch_ll     := na

        int_bear_break := true
        int_break_origin_loc := i_sw_loc
        // iFib seed — bear iSOS: bottom = i_tracked_ext, top = i_sw_price, dir -1
        if showIFib and not na(i_tracked_ext) and not na(i_sw_price)
            iFib_asl := i_tracked_ext, iFib_asl_loc := i_tracked_ext_loc
            iFib_ash := i_sw_price,    iFib_ash_loc := i_sw_loc
            iFib_dir := -1
            iFib0Touched := false, iFib382Touched := false, iFib50Touched := false
            iFib618Touched := false, iFib702Touched := false, iFib786Touched := false
            iFib886Touched := false, iFib100Touched := false, iFib618EverReached := false
            iFib_tp3_hit_price := na, iFibResetActive := false

        i_sw_lbl          := na
        i_sw_price        := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_hl         := na
        i_pb_count        := 0
        i_pb_started      := false
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_last_mode       := -1
        i_mode            := -1

    else if i_last_mode == -1 and not na(i_last_lh) and close > i_last_lh and i_mode == 0
        i_mid := math.round((i_last_lh_loc + bar_index) / 2)
        label.new(i_mid, i_last_lh + i_lbl_y_offset, "iSOS", color = color(na), textcolor = iBullColor, style = label.style_none, size = size.tiny, textalign = text.align_center)
        line.new(i_last_lh_loc, i_last_lh, bar_index, i_last_lh, color = color.new(iBullColor, 15), style = line.style_dotted, width = 1)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sw_line := na

        i_sos_watch_ll     := i_sw_price
        i_sos_watch_ll_loc := i_sw_loc
        i_sos_watch_hh     := na

        int_bull_break := true
        int_break_origin_loc := i_sw_loc
        // iFib seed — bull iSOS: bottom = i_sw_price, top = i_last_lh, dir 1
        if showIFib and not na(i_sw_price) and not na(i_last_lh)
            iFib_asl := i_sw_price, iFib_asl_loc := i_sw_loc
            iFib_ash := i_last_lh,  iFib_ash_loc := i_last_lh_loc
            iFib_dir := 1
            iFib0Touched := false, iFib382Touched := false, iFib50Touched := false
            iFib618Touched := false, iFib702Touched := false, iFib786Touched := false
            iFib886Touched := false, iFib100Touched := false, iFib618EverReached := false
            iFib_tp3_hit_price := na, iFibResetActive := false

        i_sw_lbl          := na
        i_sw_price        := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_lh         := na
        i_pb_count        := 0
        i_pb_started      := false
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_last_mode       := 1
        i_mode            := 1

    else if i_last_mode == -1 and not na(i_sos_watch_hh) and close > i_sos_watch_hh and i_mode == 0
        i_mid := math.round((i_sos_watch_hh_loc + bar_index) / 2)
        label.new(i_mid, i_sos_watch_hh + i_lbl_y_offset, "iSOS", color = color(na), textcolor = iBullColor, style = label.style_none, size = size.tiny, textalign = text.align_center)
        line.new(i_sos_watch_hh_loc, i_sos_watch_hh, bar_index, i_sos_watch_hh, color = color.new(iBullColor, 15), style = line.style_dotted, width = 1)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sw_line := na

        i_sos_watch_ll     := i_sw_price
        i_sos_watch_ll_loc := i_sw_loc

        int_bull_break := true
        int_break_origin_loc := i_sw_loc
        // iFib seed — bull iSOS (2nd-level watch): bottom = i_sw_price, top = i_sos_watch_hh, dir 1
        if showIFib and not na(i_sw_price) and not na(i_sos_watch_hh)
            iFib_asl := i_sw_price,      iFib_asl_loc := i_sw_loc
            iFib_ash := i_sos_watch_hh,  iFib_ash_loc := i_sos_watch_hh_loc
            iFib_dir := 1
            iFib0Touched := false, iFib382Touched := false, iFib50Touched := false
            iFib618Touched := false, iFib702Touched := false, iFib786Touched := false
            iFib886Touched := false, iFib100Touched := false, iFib618EverReached := false
            iFib_tp3_hit_price := na, iFibResetActive := false

        i_sw_lbl          := na
        i_sw_price        := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_lh         := na
        i_pb_count        := 0
        i_pb_started      := false
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_last_mode       := 1
        i_mode            := 1
        i_sos_watch_hh    := na

    else if i_last_mode == 1 and not na(i_sos_watch_ll) and close < i_sos_watch_ll and i_mode == 0
        i_mid2 := math.round((i_sos_watch_ll_loc + bar_index) / 2)
        label.new(i_mid2, i_sos_watch_ll - i_lbl_y_offset, "iSOS", color = color(na), textcolor = iBearColor, style = label.style_none, size = size.tiny, textalign = text.align_center)
        line.new(i_sos_watch_ll_loc, i_sos_watch_ll, bar_index, i_sos_watch_ll, color = color.new(iBearColor, 15), style = line.style_dotted, width = 1)
        if not na(i_sw_line)
            line.set_x2(i_sw_line, bar_index)
            i_sw_line := na

        i_sos_watch_hh     := i_sw_price
        i_sos_watch_hh_loc := i_sw_loc

        int_bear_break := true
        int_break_origin_loc := i_sw_loc
        // iFib seed — bear iSOS (2nd-level watch): bottom = i_sos_watch_ll, top = i_sw_price, dir -1
        if showIFib and not na(i_sos_watch_ll) and not na(i_sw_price)
            iFib_asl := i_sos_watch_ll,     iFib_asl_loc := i_sos_watch_ll_loc
            iFib_ash := i_sw_price,         iFib_ash_loc := i_sw_loc
            iFib_dir := -1
            iFib0Touched := false, iFib382Touched := false, iFib50Touched := false
            iFib618Touched := false, iFib702Touched := false, iFib786Touched := false
            iFib886Touched := false, iFib100Touched := false, iFib618EverReached := false
            iFib_tp3_hit_price := na, iFibResetActive := false

        i_sw_lbl          := na
        i_sw_price        := na
        i_tracked_ext     := na
        i_tracked_ext_loc := na
        i_last_hl         := na
        i_pb_count        := 0
        i_pb_started      := false
        i_pb_lqc          := na
        i_pb_lqh          := na
        i_last_mode       := -1
        i_mode            := -1
        i_sos_watch_ll    := na

// ── Update last_mode when mode changes ───────────────────
if showInternal and i_mode != 0
    i_last_mode := i_mode

// ── Extend active swing line every bar ────────────────────
if showInternal and not na(i_sw_line)
    line.set_x2(i_sw_line, bar_index)

//============================================================
//  STRUCTURE FIBONACCI  (lifted from mpc_assistant.pine GRP_FIBO, ~2009-2114)
//  Compute + touched state machine ONLY — every line.new/label.new drawing removed. Reads the
//  external structure engine's st.* above (byte-identical to structure_engine.pine). This is the
//  SOURCE-OF-TRUTH fib logic; the Python port in fibonacci/ is validated against the px_fib_*
//  plots at the bottom of this file via fibonacci/tools/compare_fib.py.
//  The ONLY deviation from mpc_assistant.pine is fiboOriginChanged uses ':=' (outer var) instead
//  of '=' so its value is observable by the px_fib_origin plot — this does not change the touched
//  state machine, which reads the same value in the same scope right after.
//============================================================
float fibo1Value  = 0.382
float fibo2Value  = 0.500
float fibo3Value  = 0.618
float fibo4Value  = 0.702
float fibo5Value  = 0.786
float fibo6Value  = 0.886
float fibo7Value  = 0.000
float fibo10Value = 1.000

var float fibo_ash     = na
var float fibo_asl     = na
var int   fibo_ash_loc = na
var int   fibo_asl_loc = na
var int   fibo_dir     = 0

var bool fiboOriginChanged = false
fiboOriginChanged := false
var bool fibo1Touched  = false
var bool fibo2Touched  = false
var bool fibo3Touched  = false
var bool fibo4Touched  = false
var bool fibo5Touched  = false
var bool fibo6Touched  = false
var bool fibo7Touched  = false
var bool fibo10Touched = false
var bool fibo618EverReached = false
var bool fiboResetActive    = false   // TP3 (0.0) hit -> leg spent/hidden until a new leg

var float fiboP1  = na, var float fiboP2  = na, var float fiboP3  = na
var float fiboP4  = na, var float fiboP5  = na, var float fiboP6  = na
var float fiboP7  = na
var float fiboP10 = na
var int   fiboStartIndexPrev = na

if not na(st.ash)
    fibo_ash     := st.ash
    fibo_ash_loc := st.ash_loc
if not na(st.asl)
    fibo_asl     := st.asl
    fibo_asl_loc := st.asl_loc
if st.dir != 0
    fibo_dir := st.dir

if st.pb_mode == 1 and not na(st.pb_extreme)
    fibo_ash     := st.pb_extreme
    fibo_ash_loc := st.pb_extreme_loc
if st.pb_mode == -1 and not na(st.pb_extreme)
    fibo_asl     := st.pb_extreme
    fibo_asl_loc := st.pb_extreme_loc

// Adopt a more-extreme confirmed internal swing for the fib pull only (mpc 2277-2282).
if fibo_dir == 1 and not na(i_confirmed_low_price) and not na(fibo_asl) and i_confirmed_low_price < fibo_asl
    fibo_asl     := i_confirmed_low_price
    fibo_asl_loc := i_confirmed_low_loc
if fibo_dir == -1 and not na(i_confirmed_high_price) and not na(fibo_ash) and i_confirmed_high_price > fibo_ash
    fibo_ash     := i_confirmed_high_price
    fibo_ash_loc := i_confirmed_high_loc

bool fibActive = not na(fibo_ash) and not na(fibo_asl) and fibo_dir != 0

if fibActive
    fiboRange      = fibo_ash - fibo_asl
    fiboStartIndex = fibo_dir == 1 ? fibo_asl_loc : fibo_ash_loc

    fiboP1  := fibo_dir == 1 ? fibo_ash - fiboRange * fibo1Value  : fibo_asl + fiboRange * fibo1Value
    fiboP2  := fibo_dir == 1 ? fibo_ash - fiboRange * fibo2Value  : fibo_asl + fiboRange * fibo2Value
    fiboP3  := fibo_dir == 1 ? fibo_ash - fiboRange * fibo3Value  : fibo_asl + fiboRange * fibo3Value
    fiboP4  := fibo_dir == 1 ? fibo_ash - fiboRange * fibo4Value  : fibo_asl + fiboRange * fibo4Value
    fiboP5  := fibo_dir == 1 ? fibo_ash - fiboRange * fibo5Value  : fibo_asl + fiboRange * fibo5Value
    fiboP6  := fibo_dir == 1 ? fibo_ash - fiboRange * fibo6Value  : fibo_asl + fiboRange * fibo6Value
    fiboP7  := fibo_dir == 1 ? fibo_ash - fiboRange * fibo7Value  : fibo_asl + fiboRange * fibo7Value
    fiboP10 := fibo_dir == 1 ? fibo_ash - fiboRange * fibo10Value : fibo_asl + fiboRange * fibo10Value

    fiboOriginChanged := fiboStartIndex != fiboStartIndexPrev
    if fiboOriginChanged
        fibo1Touched  := false
        fibo2Touched  := false
        fibo3Touched  := false
        fibo4Touched  := false
        fibo5Touched  := false
        fibo6Touched  := false
        fibo7Touched  := false
        fibo10Touched := false
        fibo618EverReached := false
        fiboResetActive    := false
        i_confirmed_low_price  := na
        i_confirmed_low_loc    := na
        i_confirmed_high_price := na
        i_confirmed_high_loc   := na
    fiboStartIndexPrev := fiboStartIndex

    if not fiboOriginChanged
        bool fibo618Reached = fibo_dir == 1 ? low <= fiboP3 : high >= fiboP3

        if fibo618Reached
            if not fibo3Touched
                fibo3Touched := true
            if not fibo4Touched and not na(fiboP4)
                if fibo_dir == 1 ? low <= fiboP4 : high >= fiboP4
                    fibo4Touched := true
            if not fibo5Touched and not na(fiboP5)
                if fibo_dir == 1 ? low <= fiboP5 : high >= fiboP5
                    fibo5Touched := true
            if not fibo6Touched and not na(fiboP6)
                if fibo_dir == 1 ? low <= fiboP6 : high >= fiboP6
                    fibo6Touched := true
            if not fibo10Touched and not na(fiboP10)
                if fibo_dir == 1 ? low <= fiboP10 : high >= fiboP10
                    fibo10Touched := true

        if fibo618EverReached
            if not fibo2Touched and not na(fiboP2)
                if fibo_dir == 1 ? high >= fiboP2 : low <= fiboP2
                    fibo2Touched := true
            if not fibo1Touched and not na(fiboP1)
                if fibo_dir == 1 ? high >= fiboP1 : low <= fiboP1
                    fibo1Touched := true
            if not fibo7Touched and not na(fiboP7)
                if fibo_dir == 1 ? high >= fiboP7 : low <= fiboP7
                    fibo7Touched := true
            // TP3 (0.0) hit -> the leg is spent; hide until a new leg (mpc 2384).
            if fibo7Touched
                fiboResetActive := true

        if fibo618Reached and not fibo618EverReached
            fibo618EverReached := true

//============================================================
//  SNIPER FIB  (lifted from mpc_assistant.pine GRP_SNIPER ~2510-2551 + zone-touch ~2788-2797)
//  Compute + zone-touch state ONLY — every box/line/label draw removed. Reads the external
//  structure engine's st.* above. This is the SOURCE-OF-TRUTH Sniper logic the Python SniperFib
//  in fibonacci/ is validated against, via the px_sniper_* plots below.
//  Two deviations from mpc_assistant.pine, both drawing-only, neither changes zone state:
//    - the box/line/label arrays are gone; only sniperZoneTop/Bot/Active (+ a sniperDir for the
//      export) are kept — those are the whole state machine.
//    - the display string sz_status is replaced by a per-bar bool sniperConfirmedNow so the
//      confirm EVENT (edge) is observable by a plot. The latch sniperZoneActive updates identically.
//============================================================
var float sniperZoneTop    = na
var float sniperZoneBot    = na
var bool  sniperZoneActive = false
var int   sniperDir        = 0

bool _snBearBOS = st.bear_bos
bool _snBullBOS = st.bull_bos
bool sniperCreated = _snBearBOS or _snBullBOS

if _snBearBOS or _snBullBOS
    float _snh   = _snBullBOS ? st.bull_bos_high : st.bear_bos_high
    float _snl   = _snBullBOS ? st.bull_bos_low : st.bear_bos_low
    float _snr   = _snh - _snl
    float _sn382 = _snBullBOS ? _snl + _snr * 0.382 : _snh - _snr * 0.382
    float _sn50  = _snBullBOS ? _snl + _snr * 0.500 : _snh - _snr * 0.500
    sniperZoneTop    := math.max(_sn382, _sn50)
    sniperZoneBot    := math.min(_sn382, _sn50)
    sniperZoneActive := false
    sniperDir        := _snBullBOS ? 1 : -1

bool sniperConfirmedNow = false
if not na(sniperZoneTop) and not na(sniperZoneBot)
    if not sniperZoneActive and high >= sniperZoneBot and low <= sniperZoneTop
        sniperZoneActive   := true
        sniperConfirmedNow := true
if _snBearBOS or _snBullBOS
    sniperConfirmedNow := false

//============================================================
//  MACRO CYCLE FIB  (lifted from mpc_assistant.pine GRP_MACRO ~2290-2432)
//  State machine + touched tracking ONLY — every line/label draw removed. Reads the external
//  structure engine's st.* above. SOURCE OF TRUTH for the Python MacroFib in fibonacci/, checked
//  via the px_macro_* plots below. Deviations from mpc_assistant.pine, all drawing-only, none
//  change state: line/label vars + all line.new/label.new/delete removed; the drawing-only
//  macro_*_time fields dropped (never read by the state machine); showMacroFib hardcoded true.
//  macroFibAllowed is KEPT — export on a <=5m chart or the whole block never runs.
//============================================================
var int   macro_dir                   = 0
var float macro_origin                = na
var int   macro_origin_loc            = na
var float macro_extreme               = na
var int   macro_extreme_loc           = na
var bool  macro_origin_locked         = false
var float macro_last_conf_high        = na
var bool  macro_visible               = false
var float macro_prev_extreme          = na
var int   macro_last_bear_sos_bar     = na
var float macro_ll_since_bear_sos     = na
var int   macro_ll_since_bear_sos_bar = na

var bool macro0Touched   = false
var bool macro382Touched = false
var bool macro50Touched  = false
var bool macro618Touched = false
var bool macro702Touched = false
var bool macro786Touched = false
var bool macro886Touched = false
var bool macro100Touched = false
var bool macro618EverReached = false

bool showMacroFib    = true
bool macroFibAllowed = timeframe.in_seconds() <= 300

var bool macroNewCycle = false
macroNewCycle := false
var bool macroExtended = false
macroExtended := false

if showMacroFib and macroFibAllowed
    if st.bear_sos
        macro_last_bear_sos_bar     := bar_index
        macro_ll_since_bear_sos     := low
        macro_ll_since_bear_sos_bar := bar_index

    if not macro_origin_locked and not na(macro_last_bear_sos_bar)
        if low < macro_ll_since_bear_sos
            macro_ll_since_bear_sos     := low
            macro_ll_since_bear_sos_bar := bar_index

    if macro_origin_locked and not na(macro_origin) and close < macro_origin
        macro_dir             := 0
        macro_origin          := na
        macro_origin_loc      := na
        macro_extreme         := na
        macro_extreme_loc     := na
        macro_origin_locked   := false
        macro_last_conf_high  := na
        macro_visible         := false
        macro_last_bear_sos_bar     := bar_index
        macro_ll_since_bear_sos     := low
        macro_ll_since_bear_sos_bar := bar_index

    // Bottom anchor is ALWAYS the running lowest-low since the last bearish SOS (mpc 2559).
    float macroBottomAnchor    = macro_ll_since_bear_sos
    int   macroBottomAnchorBar = macro_ll_since_bear_sos_bar
    if st.bull_sos and not macro_origin_locked and not na(macroBottomAnchor) and not na(st.last_conf_high)
        macro_dir             := 1
        macro_origin          := macroBottomAnchor
        macro_origin_loc      := macroBottomAnchorBar
        macro_extreme         := st.last_conf_high
        macro_extreme_loc     := st.last_conf_high_loc
        macro_origin_locked   := true
        macro_last_conf_high  := st.last_conf_high
        macro_visible         := true
        macro_prev_extreme    := st.last_conf_high
        macro0Touched   := false
        macro382Touched := false
        macro50Touched  := false
        macro618Touched := false
        macro702Touched := false
        macro786Touched := false
        macro886Touched := false
        macro100Touched := false
        macro618EverReached := false
        macroNewCycle := true

    bool macroNewHH = macro_origin_locked and not na(st.last_conf_high) and st.last_conf_high > macro_last_conf_high
    if macroNewHH
        macro_extreme         := st.last_conf_high
        macro_extreme_loc     := st.last_conf_high_loc
        macro_last_conf_high  := st.last_conf_high
        macro_visible         := true
        macro_prev_extreme    := st.last_conf_high
        macro0Touched   := false
        macro382Touched := false
        macro50Touched  := false
        macro618Touched := false
        macro702Touched := false
        macro786Touched := false
        macro886Touched := false
        macro100Touched := false
        macro618EverReached := false
        macroExtended := true

    if macro_visible and macro_origin_locked and not na(macro_origin) and not na(macro_extreme)
        float mH = macro_extreme
        float mL = macro_origin
        float mR = mH - mL
        if mR > 0
            float mP618 = mH - mR * 0.618
            float mP702 = mH - mR * 0.702
            float mP786 = mH - mR * 0.786
            float mP886 = mH - mR * 0.886
            float mP100 = mH - mR * 1.0
            float mP50  = mH - mR * 0.5
            float mP382 = mH - mR * 0.382
            float mP0   = mH - mR * 0.0

            bool macroExtChanged = macro_extreme != macro_prev_extreme
            bool macro618Reached = low <= mP618

            if not macroExtChanged
                if macro618Reached
                    if not macro618Touched
                        macro618Touched := true
                    if not macro702Touched and low <= mP702
                        macro702Touched := true
                    if not macro786Touched and low <= mP786
                        macro786Touched := true
                    if not macro886Touched and low <= mP886
                        macro886Touched := true
                    if not macro100Touched and low <= mP100
                        macro100Touched := true
                if macro618EverReached
                    if not macro50Touched and high >= mP50
                        macro50Touched  := true
                    if not macro382Touched and high >= mP382
                        macro382Touched := true
                    if not macro0Touched and high >= mP0
                        macro0Touched   := true
                if macro618Reached and not macro618EverReached
                    macro618EverReached := true

    // HIDE when price closes above the locked top — now AFTER extend + touch (mpc 2636). Hide-only
    // (no state wipe): the cycle stays locked and reappears on the next confirmed HH.
    if macro_origin_locked and macro_visible and not na(macro_extreme) and close > macro_extreme
        macro_visible := false

bool  macroActive = macro_visible and macro_origin_locked and not na(macro_origin) and not na(macro_extreme) and (macro_extreme - macro_origin) > 0
float macroH = macroActive ? macro_extreme : na
float macroL = macroActive ? macro_origin  : na
float macroR = macroActive ? macroH - macroL : na

//============================================================
//  INTERNAL FIB  (lifted from mpc_assistant.pine: seed at the six iBOS/iSOS sites above +
//  clear/extend/touched tracking ~2727-2791). Compute + touched state ONLY — drawing removed.
//  SOURCE OF TRUTH for the Python InternalFib in fibonacci/, checked via the px_ifib_* plots.
//  The seed anchors (iFib_asl/ash/dir) are set inside the internal-structure block above.
//============================================================
// Clear the internal fib when an external BOS/SOS fires — wait for a fresh iBOS/iSOS.
if st.bull_bos or st.bear_bos or st.bull_sos or st.bear_sos
    iFib_dir := 0, iFib_asl := na, iFib_asl_loc := na, iFib_ash := na, iFib_ash_loc := na
    iFib0Touched := false, iFib382Touched := false, iFib50Touched := false
    iFib618Touched := false, iFib702Touched := false, iFib786Touched := false
    iFib886Touched := false, iFib100Touched := false, iFib618EverReached := false
    iFib_tp3_hit_price := na, iFibResetActive := false

// Live-extend the moving anchor since the seed.
if iFib_dir == -1 and not na(iFib_ash)
    if na(iFib_asl) or low < iFib_asl
        iFib_asl     := low
        iFib_asl_loc := bar_index
else if iFib_dir == 1 and not na(iFib_asl)
    if na(iFib_ash) or high > iFib_ash
        iFib_ash     := high
        iFib_ash_loc := bar_index

// Touched tracking — same 0.618-gate logic as the other fibs.
if iFib_dir != 0 and not na(iFib_asl) and not na(iFib_ash)
    float iFR  = iFib_ash - iFib_asl
    if iFR > 0
        float iTP618 = iFib_dir == 1 ? iFib_ash - iFR*0.618 : iFib_asl + iFR*0.618
        float iTP702 = iFib_dir == 1 ? iFib_ash - iFR*0.702 : iFib_asl + iFR*0.702
        float iTP786 = iFib_dir == 1 ? iFib_ash - iFR*0.786 : iFib_asl + iFR*0.786
        float iTP886 = iFib_dir == 1 ? iFib_ash - iFR*0.886 : iFib_asl + iFR*0.886
        float iTP50  = iFib_dir == 1 ? iFib_ash - iFR*0.5   : iFib_asl + iFR*0.5
        float iTP382 = iFib_dir == 1 ? iFib_ash - iFR*0.382 : iFib_asl + iFR*0.382
        float iTP0   = iFib_dir == 1 ? iFib_ash              : iFib_asl
        float iTP100 = iFib_dir == 1 ? iFib_asl              : iFib_ash

        bool iGate618 = iFib_dir == 1 ? low <= iTP618 : high >= iTP618
        if iGate618 and not iFib618Touched
            iFib618Touched := true

        if iFib618Touched
            if not iFib702Touched and (iFib_dir == 1 ? low <= iTP702 : high >= iTP702)
                iFib702Touched := true
            if not iFib786Touched and (iFib_dir == 1 ? low <= iTP786 : high >= iTP786)
                iFib786Touched := true
            if not iFib886Touched and (iFib_dir == 1 ? low <= iTP886 : high >= iTP886)
                iFib886Touched := true
            if not iFib100Touched and (iFib_dir == 1 ? low <= iTP100 : high >= iTP100)
                iFib100Touched := true

        if iFib618EverReached
            if not iFib50Touched and (iFib_dir == 1 ? high >= iTP50 : low <= iTP50)
                iFib50Touched := true
            if not iFib382Touched and (iFib_dir == 1 ? high >= iTP382 : low <= iTP382)
                iFib382Touched := true
            bool iFib0WasTouched = iFib0Touched
            if not iFib0Touched and (iFib_dir == 1 ? high >= iTP0 : low <= iTP0)
                iFib0Touched := true
            if iFib0Touched and not iFib0WasTouched
                iFib_tp3_hit_price := iTP0

        if iFib0Touched
            iFibResetActive := true

        if iGate618 and not iFib618EverReached
            iFib618EverReached := true

bool  iFibActive = iFib_dir != 0 and not na(iFib_asl) and not na(iFib_ash)
float iFibR = iFibActive ? iFib_ash - iFib_asl : na

// ═══════════════════════════════════════════════════════════════════════════
//  PARITY-EXPORT PLOTS  (fib) — read AFTER the fib block so each series holds this bar's final
//  value. Colors fully transparent (alpha 100) so they don't clutter the pane but DO export.
//  Column names use the Python level names (E1-E4, 1.0, TP1-TP5) so compare_fib.py lines up.
//  Export: chart menu (…) → Export chart data → CSV, then run
//  fibonacci/tools/compare_fib.py <that file>.
// ═══════════════════════════════════════════════════════════════════════════
plot(fibActive ? 1 : 0,          "px_fib_active", color = color.new(color.gray,  100))
plot(fibActive ? fibo_dir : na,  "px_fib_dir",    color = color.new(color.gray,  100))
plot(fiboOriginChanged ? 1 : 0,  "px_fib_origin", color = color.new(color.gray,  100))

plot(fibActive ? fiboP3  : na, "px_fib_e1_price",  color = color.new(color.blue,  100))
plot(fibActive ? fiboP4  : na, "px_fib_e2_price",  color = color.new(color.blue,  100))
plot(fibActive ? fiboP5  : na, "px_fib_e3_price",  color = color.new(color.blue,  100))
plot(fibActive ? fiboP6  : na, "px_fib_e4_price",  color = color.new(color.blue,  100))
plot(fibActive ? fiboP10 : na, "px_fib_100_price", color = color.new(color.blue,  100))
plot(fibActive ? fiboP2  : na, "px_fib_tp1_price", color = color.new(color.green, 100))
plot(fibActive ? fiboP1  : na, "px_fib_tp2_price", color = color.new(color.green, 100))
plot(fibActive ? fiboP7  : na, "px_fib_tp3_price", color = color.new(color.green, 100))

plot((fibo3Touched  and not fibo3Touched[1])  ? 1 : 0, "px_fib_e1_touch",  color = color.new(color.blue,  100))
plot((fibo4Touched  and not fibo4Touched[1])  ? 1 : 0, "px_fib_e2_touch",  color = color.new(color.blue,  100))
plot((fibo5Touched  and not fibo5Touched[1])  ? 1 : 0, "px_fib_e3_touch",  color = color.new(color.blue,  100))
plot((fibo6Touched  and not fibo6Touched[1])  ? 1 : 0, "px_fib_e4_touch",  color = color.new(color.blue,  100))
plot((fibo10Touched and not fibo10Touched[1]) ? 1 : 0, "px_fib_100_touch", color = color.new(color.blue,  100))
plot((fibo2Touched  and not fibo2Touched[1])  ? 1 : 0, "px_fib_tp1_touch", color = color.new(color.green, 100))
plot((fibo1Touched  and not fibo1Touched[1])  ? 1 : 0, "px_fib_tp2_touch", color = color.new(color.green, 100))
plot((fibo7Touched  and not fibo7Touched[1])  ? 1 : 0, "px_fib_tp3_touch", color = color.new(color.green, 100))
plot(fiboResetActive ? 1 : 0,                          "px_fib_reset_active", color = color.new(color.green, 100))

// ── Sniper fib: zone state + the created/confirmed events ──
plot(not na(sniperZoneTop) ? 1 : 0,           "px_sniper_active",      color = color.new(color.gray,  100))
plot(not na(sniperZoneTop) ? sniperDir : na,  "px_sniper_dir",         color = color.new(color.gray,  100))
plot(sniperCreated ? 1 : 0,                   "px_sniper_created",     color = color.new(color.gray,  100))
plot(sniperConfirmedNow ? 1 : 0,              "px_sniper_confirmed",   color = color.new(color.gray,  100))
plot(sniperZoneActive ? 1 : 0,                "px_sniper_zone_active", color = color.new(color.gray,  100))
plot(sniperZoneTop,                           "px_sniper_top",         color = color.new(color.green, 100))
plot(sniperZoneBot,                           "px_sniper_bot",         color = color.new(color.green, 100))

// ── Macro cycle fib: state + level prices + first-touch pulses (only on <=5m exports) ──
plot(macroActive ? 1 : 0,               "px_macro_active",    color = color.new(color.gray,  100))
plot(macroActive ? macro_dir : na,      "px_macro_dir",       color = color.new(color.gray,  100))
plot(macro_origin_locked ? 1 : 0,       "px_macro_locked",    color = color.new(color.gray,  100))
plot(macro_visible ? 1 : 0,             "px_macro_visible",   color = color.new(color.gray,  100))
plot(macroNewCycle ? 1 : 0,             "px_macro_new_cycle", color = color.new(color.gray,  100))
plot(macroExtended ? 1 : 0,             "px_macro_extended",  color = color.new(color.gray,  100))
plot(macroActive ? macroH : na,         "px_macro_top",       color = color.new(color.green, 100))
plot(macroActive ? macroL : na,         "px_macro_bot",       color = color.new(color.green, 100))

plot(macroActive ? macroH - macroR * 0.618 : na, "px_macro_e1_price",  color = color.new(color.blue,  100))
plot(macroActive ? macroH - macroR * 0.702 : na, "px_macro_e2_price",  color = color.new(color.blue,  100))
plot(macroActive ? macroH - macroR * 0.786 : na, "px_macro_e3_price",  color = color.new(color.blue,  100))
plot(macroActive ? macroH - macroR * 0.886 : na, "px_macro_e4_price",  color = color.new(color.blue,  100))
plot(macroActive ? macroH - macroR * 1.000 : na, "px_macro_ll_price",  color = color.new(color.blue,  100))
plot(macroActive ? macroH - macroR * 0.500 : na, "px_macro_tp1_price", color = color.new(color.green, 100))
plot(macroActive ? macroH - macroR * 0.382 : na, "px_macro_tp2_price", color = color.new(color.green, 100))
plot(macroActive ? macroH - macroR * 0.000 : na, "px_macro_hh_price",  color = color.new(color.green, 100))

plot((macro618Touched and not macro618Touched[1]) ? 1 : 0, "px_macro_e1_touch",  color = color.new(color.blue,  100))
plot((macro702Touched and not macro702Touched[1]) ? 1 : 0, "px_macro_e2_touch",  color = color.new(color.blue,  100))
plot((macro786Touched and not macro786Touched[1]) ? 1 : 0, "px_macro_e3_touch",  color = color.new(color.blue,  100))
plot((macro886Touched and not macro886Touched[1]) ? 1 : 0, "px_macro_e4_touch",  color = color.new(color.blue,  100))
plot((macro100Touched and not macro100Touched[1]) ? 1 : 0, "px_macro_ll_touch",  color = color.new(color.blue,  100))
plot((macro50Touched  and not macro50Touched[1])  ? 1 : 0, "px_macro_tp1_touch", color = color.new(color.green, 100))
plot((macro382Touched and not macro382Touched[1]) ? 1 : 0, "px_macro_tp2_touch", color = color.new(color.green, 100))
plot((macro0Touched   and not macro0Touched[1])   ? 1 : 0, "px_macro_hh_touch",  color = color.new(color.green, 100))

// ── Internal fib: state + first-touch pulses. Level PRICES are validated INDIRECTLY here — a
//    touch fires exactly when price crosses a computed level, so correct touches prove the
//    geometry. (No px_ifib_*_price columns, to stay under TradingView's 64-plot limit.) ──
plot(iFibActive ? 1 : 0,             "px_ifib_active",       color = color.new(color.gray,   100))
plot(iFibActive ? iFib_dir : na,     "px_ifib_dir",          color = color.new(color.gray,   100))
plot(iFibResetActive ? 1 : 0,        "px_ifib_reset_active", color = color.new(color.orange, 100))
plot((iFib618Touched and not iFib618Touched[1]) ? 1 : 0, "px_ifib_e1_touch",  color = color.new(color.blue,  100))
plot((iFib702Touched and not iFib702Touched[1]) ? 1 : 0, "px_ifib_e2_touch",  color = color.new(color.blue,  100))
plot((iFib786Touched and not iFib786Touched[1]) ? 1 : 0, "px_ifib_e3_touch",  color = color.new(color.blue,  100))
plot((iFib886Touched and not iFib886Touched[1]) ? 1 : 0, "px_ifib_e4_touch",  color = color.new(color.blue,  100))
plot((iFib100Touched and not iFib100Touched[1]) ? 1 : 0, "px_ifib_100_touch", color = color.new(color.blue,  100))
plot((iFib50Touched  and not iFib50Touched[1])  ? 1 : 0, "px_ifib_tp1_touch", color = color.new(color.green, 100))
plot((iFib382Touched and not iFib382Touched[1]) ? 1 : 0, "px_ifib_tp2_touch", color = color.new(color.green, 100))
plot((iFib0Touched   and not iFib0Touched[1])   ? 1 : 0, "px_ifib_tp3_touch", color = color.new(color.green, 100))
