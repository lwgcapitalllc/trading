//@version=6
// [doc 1] SMC SESSION SWEEP STRATEGY — five-step session-sweep continuation model,  -> docs/smc_session_sweep_strategy.md

strategy("SMC Session Sweep Strategy", overlay = true, pyramiding = 0,
  initial_capital = 10000, default_qty_type = strategy.fixed, default_qty_value = 1,
  margin_long = 0.2, margin_short = 0.2, slippage = 0,
  max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_bars_back = 2000)

var string G1  = "1 · HIS MODEL — what arms the trade"
var string GS  = "2 · THE SHIFT OF STRUCTURE — everything about it, in one place"
var string G2  = "3 · HIS MODEL — the entry zone"
var string G3  = "4 · HIS MODEL — targets"
var string G4  = "5 · HIS MODEL — execution hours"
var string G5  = "6 · OURS — what trades, and how big"
var string G6  = "7 · OURS — choices his method leaves open"
var string G7  = "8 · OURS — safety filters that REFUSE a setup"
var string G8  = "9 · OURS — chart annotations"
var string G9  = "10 · OURS — drawing: sessions"

string pbDirTf       = input.string("15", "Direction — trend timeframe", options = ["5", "15", "30", "60", "240"], group = G1, tooltip = "Which timeframe decides long or short. Only trades that way. The video uses 15.")
bool   pbTradeLdn    = input.bool(true, "Location — trade London (sweeps the Asian high/low)",   group = G1, tooltip = "London hunts Asia's high and low.")
bool   pbTradeNy     = input.bool(true, "Location — trade New York (sweeps the London high/low)", group = G1, tooltip = "New York hunts London's high and low.")
bool   pbRequireConf = input.bool(false, "Confirmation — require a lower-timeframe change of character", group = GS, tooltip = "On: after the level is taken, wait for the small timeframe to turn our way. Off: enter on the sweep alone, at worse prices. The course has this ON. It ships OFF because that is the setting being traded here - turn it on to compare.")

string pbPoiTf        = input.string("5", "Point of interest — timeframe the zone is found on", options = ["Off", "1", "3", "5", "15"], group = G2, tooltip = "Which timeframe the entry gap is found on. The video uses 5. OFF means no gap is needed at all - you enter at market the moment the confirmation timeframe turns, with the stop behind the sweep. Off does nothing unless confirmation is required, or nothing would be left to trigger on.")
bool   pbPoiUntouched = input.bool(true, "   ↳ Untouched zones only", group = G2, active = pbPoiTf != "Off", tooltip = "On: skip any gap price has already traded back into. Off takes more trades at worse prices.")

string execTp1Mode     = input.string("Fixed R", "Target 1 — what the first target IS", options = ["Fixed R", "Nearest liquidity level"], group = G3, tooltip = "Fixed R puts the first target at a multiple of your risk, which is what the course does. Nearest level uses yesterday's or last week's high or low.")
float  execTp1R        = input.float(3.5, "   ↳ First target (R)", minval = 0.5, maxval = 50.0, step = 0.5, group = G3, active = execTp1Mode == "Fixed R", tooltip = "How many times your risk the first target sits at. 5 is his number; this ships at 3.5, which is the setting being traded here.")
float  execTp1Pct      = input.float(80, "   ↳ % banked at the first target", minval = 0, maxval = 100, step = 5, group = G3, tooltip = "How much you take off at the first target. 0 = take nothing and ride it all to the second. At 80 the runner is a fifth of the position, so the second target moves the result far less than the first one does.")
bool   execUseTp1      = input.bool(true, "Previous day's low / high is a target", group = G3, tooltip = "Use yesterday's high or low as a target.")
bool   execUseTp2      = input.bool(true, "Previous week's low / high is a target", group = G3, tooltip = "Use last week's high or low as a target.")
bool   execBeOnShift   = input.bool(true, "Stop to breakeven when the confirmation timeframe shifts AGAINST the trade", group = GS, tooltip = "Moves the stop to your entry price as soon as the small timeframe turns against you.")

bool   execUseWindows  = input.bool(true, "Only execute inside the course's hours", group = G4, tooltip = "Only take trades during the hours below. Orders waiting outside them are cancelled.")
string execWinLdn      = input.string("0200-0500", "   ↳ London hours (New York clock)", group = G4, active = execUseWindows, tooltip = "New York clock. Our London session starts at 3am, so this really means 3am to 5am.")
string execWinNy       = input.string("0700-1000", "   ↳ New York hours (New York clock)", group = G4, active = execUseWindows, tooltip = "New York clock. Our New York session starts at 8am, so this really means 8am to 10am.")

bool   pbTradeLongs  = input.bool(true,  "Trade longs",  group = G5, inline = "dir", tooltip = "Off means shorts only.")
bool   pbTradeShorts = input.bool(true,  "Trade shorts", group = G5, inline = "dir")
string execSizeMode  = input.string("Risk % of equity", "Position sizing", options = ["Risk % of equity", "Fixed contracts"], group = G5, tooltip = "Risk % makes every trade worth the same. Fixed uses the same size whatever the stop. Use Risk % unless you are copying another script.")
float  execRiskPct   = input.float(4.0, "   ↳ Risk % per trade", minval = 0.01, maxval = 100.0, step = 0.25, group = G5, active = execSizeMode == "Risk % of equity", tooltip = "How much of the account you lose if the stop is hit. This ships at 4, which is an aggressive number - drop it to 1 if you want to read the shape of the equity curve rather than its size.")
float  execFixedQty  = input.float(1.0, "   ↳ Contracts", minval = 0.01, step = 0.01, group = G5, active = execSizeMode == "Fixed contracts")

int    pbStructLen   = input.int(15, "   ↳ Structure pivot length", minval = 2, maxval = 50, group = G6, tooltip = "How the swing highs and lows are first found. Mostly affects warm-up. Leave it alone.")
string pbConfTf      = input.string("1", "Confirmation timeframe", options = ["1", "3", "5", "15"], group = GS, tooltip = "The small timeframe we watch for a change of character. The video uses 1. It stays live even with confirmation switched off, because three other things read it: the breakeven-on-shift rule, the cancel-on-flip rule, and the SOS marker below.")
string pbConfWhen    = input.string("Before the zone (rest a limit)", "   ↳ When the shift must happen", options = ["Before the zone (rest a limit)", "At the zone (enter at market)"], group = GS, active = pbRequireConf, tooltip = "Before: wait for the turn, then leave an order sitting in the gap. At: wait for price to reach the gap, then the turn, then buy at market.")
string execZoneEntry  = input.string("Proximal edge", "Point of interest — where the limit rests in the zone", options = ["Proximal edge", "Midpoint", "Distal edge"], group = G6, active = not (pbRequireConf and pbConfWhen == "At the zone (enter at market)"), tooltip = "Where in the gap your order sits. Near edge fills most often; far edge gets a better price but often misses.")
string execStopFrom   = input.string("The gap", "Stop sits behind…", options = ["The gap", "The sweep extreme"], group = G6, tooltip = "The gap puts the stop just past the gap. The sweep puts it past the high or low the session made, so gap size stops mattering.")
int    execSlBufTk     = input.int(20, "Stop buffer beyond the zone (ticks)", minval = 0, maxval = 500, group = G6, tooltip = "How far past the edge the stop sits. On gold a tick is one cent, so 20 is twenty cents.")
int    execCancelBars = input.int(0, "Cancel an unfilled limit after N bars", minval = 0, maxval = 2000, group = G6, tooltip = "0 keeps the order until the session ends. It is always cancelled at the end of its session anyway.")
bool   execCancelFlip = input.bool(true, "Cancel on a direction flip or an opposite shift", group = G6, tooltip = "Pull a waiting order when the trend turns the other way.")
bool   execBeAtTp1     = input.bool(true, "Stop to breakeven when the first target is reached", group = G6)
int    execBeBufTk     = input.int(20, "   ↳ Breakeven buffer (ticks)", minval = 0, maxval = 500, group = G6, active = execBeAtTp1 or execBeOnShift, tooltip = "How far past your entry the breakeven stop sits, so you bank a few ticks instead of exactly nothing.")
float  execTpFallbackR = input.float(3.0, "Fallback target (R) when no liquidity target is valid", minval = 0.0, maxval = 50.0, step = 0.5, group = G6, active = execTp1Mode == "Nearest liquidity level", tooltip = "If no level works as a target, use this many times risk instead. 0 = skip the trade.")
float  execMinRr       = input.float(1.0, "Minimum reward:risk to the first target", minval = 0.0, maxval = 20.0, step = 0.25, group = G6, tooltip = "A target nearer than this is treated as unusable.")

string execMinStopMode = input.string("Fixed $", "Minimum stop distance", options = ["Off", "% of price", "Fixed $", "x ATR(14)"], group = G7, tooltip = "Refuse a trade whose stop is too close to the entry. A tiny stop means a huge position, not small risk.")
float  execMinStopVal  = input.float(4.0, "   ↳ Minimum stop floor (unit = mode above)", minval = 0.0, maxval = 100.0, step = 0.01, group = G7, active = execMinStopMode != "Off", tooltip = "The smallest stop allowed, in the unit you picked above. $4 of gold, MEASURED: trades whose stop was under $4 averaged -1.43R instead of -1R, and every loss worse than -3R in six years came from that band. Above $4 the average loser flattens out near -1.1R, so a bigger floor just costs you trades.")
float  pbPoiMaxAtr     = input.float(0.0, "Maximum distance to the zone (x ATR14)", minval = 0.0, maxval = 20.0, step = 0.5, group = G7, active = not (pbRequireConf and pbConfWhen == "At the zone (enter at market)"), tooltip = "Refuse a gap further from price than this many average bar ranges. 0 = no limit.")
float  execTimeStopHrs = input.float(0.0, "Time stop (hours, 0 = off)", minval = 0.0, maxval = 240.0, step = 1.0, group = G7, tooltip = "Close a trade open this long that has not reached its first target. 0 = off.")

bool  execShowPosBox = input.bool(true, "Draw the trade (entry, exit, drawdown, how far it ran)", group = G8, tooltip = "One drawing per trade. Dark green is what you made, light green how much further it went, red how far it went against you first.")
bool  execShowLabels = input.bool(false, "   ↳ Label the trade (entry, exit, furthest, deepest, stop, result)", group = G8, active = execShowPosBox, tooltip = "Writes the prices and the R result on the chart. Handy when studying one trade; it also shortens how far the chart goes back.")
float execBeBandR    = input.float(0.15, "   ↳ Breakeven band (R)", minval = 0, step = 0.05, group = G8, active = execShowPosBox, tooltip = "A trade finishing this close to zero is drawn as a breakeven instead of a win or a loss.")
bool  showSetups     = input.bool(true, "Show the gap the order sat in, plus entry, stop and targets", group = G8, tooltip = "Draws the plan for trades that happened: the gap the order sat in, the entry, the stop and the targets.")
bool  showBlockTag   = input.bool(true, "Mark missed setups (orange) and blocked ones (pink)", group = G8, tooltip = "Orange = everything lined up except the gap. Pink = everything lined up and one of your rules said no.")
bool  showBlockDraw  = input.bool(true, "   ↳ Also draw the gap and the stop it was refused on", group = G8, active = showBlockTag, tooltip = "Draws the gap behind a missed or blocked tag, plus where the entry and stop would have been.")
int   debugDays      = input.int(30, "   ↳ Only tag the last N days", minval = 1, maxval = 3650, group = G8, active = showBlockTag)

bool pbShowSess = input.bool(true, "Show sessions", group = G9, tooltip = "Boxes Tokyo, London and New York around their high and low - the levels the next session hunts. Intraday charts only.")

bool   showSosMark = input.bool(false, "Mark the shift of structure next to a setup", group = GS, tooltip = "Draws a line at the exact price the confirmation timeframe broke, labelled SOS. Only for setups that became a trade, a missed tag or a blocked tag. It works with confirmation switched OFF too - that is how you see what requiring it would have cost you.")
string sosCmpTf    = input.string("5", "   ↳ Also mark this timeframe, to compare", options = ["Off", "1", "3", "5", "15"], group = GS, active = showSosMark, tooltip = "Purple dashed line where a second timeframe broke, so you can see if it would confirm better. Marking only - it never changes a trade. Set it to the SAME timeframe as your confirmation and it draws nothing, because it would be the same line twice.")

string sessAsia = "0900-1800"
string tzAsia   = "Asia/Tokyo"
string sessLdn  = "0800-1700"
string tzLdn    = "Europe/London"
string sessNy   = "0800-1700"
string tzNy     = "America/New_York"

color POS_WIN    = color.new(#26A69A, 12)
color POS_WINL   = color.new(#26A69A, 0)
color POS_LOSS   = color.new(#EF5350, 12)
color POS_LOSSL  = color.new(#EF5350, 0)
color POS_BE     = color.new(#FF9800, 12)
color POS_BEL    = color.new(#FF9800, 0)
color POS_OPEN   = color.new(#787B86, 12)
color POS_OPENL  = color.new(#787B86, 0)
color POS_OPENBG = color.new(#787B86, 80)
color POS_GREENB = color.new(#26A69A, 0)
color POS_REDB   = color.new(#EF5350, 0)
color POS_G1     = color.new(#26A69A, 55)
color POS_G2     = color.new(#26A69A, 70)
color POS_DD     = color.new(#EF5350, 88)
color TP_ANNOT   = color.new(#26A69A, 40)
color FVG_ZONE   = color.new(color.gray, 80)
color FVG_DEAD   = color.new(color.gray, 95)
color FVG_EDGE   = color.new(color.gray, 35)
color BLK_PINK   = color.new(#FF2E9A, 12)
color BLK_PINKL  = color.new(#FF2E9A, 0)
color MISS_ORN   = color.new(#FF9800, 12)
color MISS_ORNL  = color.new(#FF9800, 0)
color TXT_DARK   = color.new(#101014, 0)

color SOS_CONF  = color.new(#00BCD4, 0)
color SOS_CMP   = color.new(#AB47BC, 0)

color SESS_ASIA = color.new(#FF5252, 92)
color SESS_LDN  = color.new(#2962FF, 92)
color SESS_NY   = color.new(#FFEB3B, 90)

float pbBuffer = 0.0
float atr14    = ta.atr(14)
float tickSz   = syminfo.mintick

[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)

type MTFStruct
    int    length
    float  ash             = na
    int    ash_loc         = na
    string ash_type        = ""
    float  asl             = na
    int    asl_loc         = na
    string asl_type        = ""
    float  last_conf_high     = na
    int    last_conf_high_loc = na
    float  last_conf_low      = na
    int    last_conf_low_loc  = na
    int    dir            = 0
    bool   choch_lock     = false
    int    pb_mode        = 0
    int    pb_count       = 0
    float  pb_level       = na
    float  pb_extreme     = na
    int    pb_extreme_loc = na
    bool   pb_started     = false
    float  pb_last_qualify_close = na
    float  pb_last_qualify_high  = na
    float  pb_extreme_close      = na
    float  prev_close     = na
    float  prev_high      = na
    float  prev_low       = na
    bool   seeded         = false
    bool   bull_bos       = false
    float  bull_bos_high  = na
    int    bull_bos_h_loc = na
    float  bull_bos_low   = na
    int    bull_bos_l_loc = na
    bool   bear_bos       = false
    float  bear_bos_high  = na
    int    bear_bos_h_loc = na
    float  bear_bos_low   = na
    int    bear_bos_l_loc = na
    bool   new_swing_high = false
    bool   new_swing_low  = false
    bool   bull_sos       = false
    bool   bear_sos       = false

method mtfCreateAsh(MTFStruct st, float val, int loc) =>
    st.ash      := val
    st.ash_loc  := loc
    st.ash_type := ""

method mtfCreateAsl(MTFStruct st, float val, int loc) =>
    st.asl      := val
    st.asl_loc  := loc
    st.asl_type := ""

method processMTF(MTFStruct st, float ph_val, float pl_val) =>
    st.bull_bos := false
    st.bear_bos := false
    st.new_swing_high := false
    st.new_swing_low  := false
    st.bull_sos := false
    st.bear_sos := false

    bool is_inside = false
    if not na(st.prev_high) and not na(st.prev_low)
        is_inside := high < st.prev_high and low > st.prev_low

    if st.choch_lock
        if st.dir == 1 and not na(pl_val)
            st.choch_lock := false
        else if st.dir == -1 and not na(ph_val)
            st.choch_lock := false

    if st.pb_mode == 1
        if not st.pb_started
            st.pb_started            := true
            st.pb_extreme            := high
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_count              := 0
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
        else
            bool extreme_updated_1 = false
            if na(st.pb_extreme) or high > st.pb_extreme
                st.pb_extreme            := high
                st.pb_extreme_loc        := bar_index
                st.pb_extreme_close      := na
                st.pb_count              := 0
                st.pb_last_qualify_close := na
                st.pb_last_qualify_high  := na
                extreme_updated_1        := true
            bool extreme_is_bearish_1 = extreme_updated_1 and close < open
            bool is_candle1_1 = na(st.pb_last_qualify_close) and not extreme_updated_1
            if (not is_inside or is_candle1_1) and (not extreme_updated_1 or extreme_is_bearish_1)
                float threshold = na(st.pb_last_qualify_high) ? st.pb_extreme : st.pb_last_qualify_high
                if close < threshold - pbBuffer
                    st.pb_count              += 1
                    st.pb_last_qualify_close := close
                    st.pb_last_qualify_high  := low
            if st.pb_count >= 3 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
                st.ash      := st.pb_extreme
                st.ash_loc  := st.pb_extreme_loc
                st.ash_type := "LOCKED"
                st.new_swing_high := true
                st.pb_mode    := 0
                st.pb_count   := 0
                st.choch_lock := false

    else if st.pb_mode == -1
        if not st.pb_started
            st.pb_started            := true
            st.pb_extreme            := low
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_count              := 0
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
        else
            bool extreme_updated_m1 = false
            if na(st.pb_extreme) or low < st.pb_extreme
                st.pb_extreme            := low
                st.pb_extreme_loc        := bar_index
                st.pb_extreme_close      := na
                st.pb_count              := 0
                st.pb_last_qualify_close := na
                st.pb_last_qualify_high  := na
                extreme_updated_m1       := true
            bool extreme_is_bullish_m1 = extreme_updated_m1 and close > open
            bool is_candle1_m1 = na(st.pb_last_qualify_close) and not extreme_updated_m1
            if (not is_inside or is_candle1_m1) and (not extreme_updated_m1 or extreme_is_bullish_m1)
                float threshold = na(st.pb_last_qualify_high) ? st.pb_extreme : st.pb_last_qualify_high
                if close > threshold + pbBuffer
                    st.pb_count              += 1
                    st.pb_last_qualify_close := close
                    st.pb_last_qualify_high  := high
            if st.pb_count >= 3 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
                st.asl      := st.pb_extreme
                st.asl_loc  := st.pb_extreme_loc
                st.asl_type := "LOCKED"
                st.new_swing_low := true
                st.pb_mode    := 0
                st.pb_count   := 0
                st.choch_lock := false

    st.prev_close := close
    st.prev_high  := high
    st.prev_low   := low

    if na(st.ash) and na(st.asl) and not st.seeded
        if not na(ph_val)
            st.mtfCreateAsh(ph_val, bar_index[st.length])
            st.dir := -1
        else if not na(pl_val)
            st.mtfCreateAsl(pl_val, bar_index[st.length])
            st.dir := 1

    if not st.seeded
        if not na(st.ash) and na(st.asl)
            float seed_low = low
            int   seed_loc = bar_index
            int   lb       = math.min(bar_index, 500)
            for i = 0 to lb
                if low[i] < seed_low
                    seed_low := low[i]
                    seed_loc := bar_index - i
            if seed_low < st.ash
                st.asl      := seed_low
                st.asl_loc  := seed_loc
                st.asl_type := ""
                st.seeded := true
        else if not na(st.asl) and na(st.ash)
            float seed_high = high
            int   seed_loc  = bar_index
            int   lb        = math.min(bar_index, 500)
            for i = 0 to lb
                if high[i] > seed_high
                    seed_high := high[i]
                    seed_loc  := bar_index - i
            if seed_high > st.asl
                st.ash      := seed_high
                st.ash_loc  := seed_loc
                st.ash_type := ""
                st.seeded := true
        else if not na(st.ash) and not na(st.asl)
            st.seeded := true

    if na(st.last_conf_high) and na(st.last_conf_low)
        if not na(ph_val) and not na(st.ash) and st.ash_type == "" and st.pb_mode == 0
            if ph_val > st.ash
                st.mtfCreateAsh(ph_val, bar_index[st.length])
        if not na(pl_val) and not na(st.asl) and st.asl_type == "" and st.pb_mode == 0
            if pl_val < st.asl
                st.mtfCreateAsl(pl_val, bar_index[st.length])

    bool ash_broken = not na(st.ash) and close > st.ash
    bool asl_broken = not na(st.asl) and close < st.asl

    if ash_broken
        st.bull_bos := true
        st.bull_bos_high  := st.ash
        st.bull_bos_h_loc := st.ash_loc

        bool was_in_bear_pb = st.pb_mode == -1 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
        st.pb_mode  := 0
        st.pb_count := 0

        bool is_choch = st.dir == -1
        if is_choch
            st.bull_sos := true
            st.choch_lock := true

        st.last_conf_high     := st.ash
        st.last_conf_high_loc := st.ash_loc
        st.ash                := na
        st.dir                := 1

        if was_in_bear_pb
            st.bull_bos_low   := st.pb_extreme
            st.bull_bos_l_loc := st.pb_extreme_loc
            st.asl      := st.pb_extreme
            st.asl_loc  := st.pb_extreme_loc
            st.asl_type := "LOCKED"
            if not is_choch
                st.last_conf_low     := st.pb_extreme
                st.last_conf_low_loc := st.pb_extreme_loc
            st.pb_extreme            := high
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_mode               := 1
            st.pb_started            := true
        else
            if not na(st.asl)
                bool already_conf_low = (st.asl == st.last_conf_low and st.asl_loc == st.last_conf_low_loc)
                if not already_conf_low
                    st.last_conf_low     := st.asl
                    st.last_conf_low_loc := st.asl_loc
                st.asl      := na

            float lowest_val = low
            int   lowest_loc = bar_index
            int   bars_back  = na(st.last_conf_high_loc) ? bar_index : bar_index - st.last_conf_high_loc
            if bars_back > 0
                int max_lb = math.min(math.min(bars_back, 1490), bar_index)
                for i = 0 to max_lb
                    if low[i] < lowest_val
                        lowest_val := low[i]
                        lowest_loc := bar_index - i

            // 🔴 KEEP THE ORIGINAL ANCHOR WHEN TWO BARS TIE FOR THE LOW. The scan above runs
            // newest-to-oldest with a strict `<`, so on an identical low it lands on the LATER bar
            // while this swing's label is already anchored on the EARLIER one — `already_conf_low`
            // compares bar index as well as price, misses, and a SECOND label is drawn at the same
            // price. Pine never deletes those, so they stack (the LL beside an HL, 2026-08-20).
            // Full story + measurements: engines/market_structure/CLAUDE.md -> tied-extreme fix.
            // 🔴 …AND THE SAME SNAP WHEN IT IS MORE EXTREME BUT NOT NEWER — A REFUSED WICK
            // (2026-08-21). Structure BREAKS ON A CLOSE, but this scan reads the raw `low` over a
            // window bounded by `last_conf_high_loc` — the OPPOSITE side — which reaches back BEFORE
            // the swing just confirmed. So it can resurrect a bar that pierced the level, closed back
            // inside and was correctly refused, and install it as the new active swing: EARLIER than
            // and LOWER than the swing just labelled. Full mechanism + the measurements:
            // `indicators/engines/mpc_jarvis.pine`, same block.
            if not na(st.last_conf_low_loc) and (lowest_val == st.last_conf_low or (lowest_val < st.last_conf_low and lowest_loc <= st.last_conf_low_loc))
                lowest_val := st.last_conf_low
                lowest_loc := st.last_conf_low_loc
            st.bull_bos_low   := lowest_val
            st.bull_bos_l_loc := lowest_loc

            st.asl      := lowest_val
            st.asl_loc  := lowest_loc
            st.asl_type := ""

            st.pb_mode               := 1
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_extreme            := high
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true

    else if asl_broken
        st.bear_bos := true
        st.bear_bos_low   := st.asl
        st.bear_bos_l_loc := st.asl_loc

        bool was_in_bull_pb = st.pb_mode == 1 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
        st.pb_mode  := 0
        st.pb_count := 0

        bool is_choch = st.dir == 1
        if is_choch
            st.bear_sos := true
            st.choch_lock := true

        st.last_conf_low     := st.asl
        st.last_conf_low_loc := st.asl_loc
        st.asl               := na
        st.dir               := -1

        if was_in_bull_pb
            st.bear_bos_high  := st.pb_extreme
            st.bear_bos_h_loc := st.pb_extreme_loc
            st.ash      := st.pb_extreme
            st.ash_loc  := st.pb_extreme_loc
            st.ash_type := "LOCKED"
            if not is_choch
                st.last_conf_high     := st.pb_extreme
                st.last_conf_high_loc := st.pb_extreme_loc
            st.pb_extreme            := low
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_mode               := -1
            st.pb_started            := true
        else
            float highest_val = high
            int   highest_loc = bar_index
            int   bars_back   = na(st.last_conf_low_loc) ? bar_index : bar_index - st.last_conf_low_loc
            if bars_back > 0
                int max_lb = math.min(math.min(bars_back, 1490), bar_index)
                for i = 0 to max_lb
                    if high[i] > highest_val
                        highest_val := high[i]
                        highest_loc := bar_index - i

            if not na(st.ash)
                bool already_conf_high = (st.ash == st.last_conf_high and st.ash_loc == st.last_conf_high_loc)
                if not already_conf_high
                    st.last_conf_high     := st.ash
                    st.last_conf_high_loc := st.ash_loc
                st.ash      := na
            else
                if highest_val != st.last_conf_high
                    st.last_conf_high     := highest_val
                    st.last_conf_high_loc := highest_loc

            // 🔴 Mirror of the low-side tie guard above. This side stacks HH on HH rather than LL on
            // HL, which is why it went unnoticed far longer despite being the MORE common of the two.
            // ⚠ IT MUST SIT HERE, AFTER THE PROMOTION, NOT BESIDE THE SCAN — placed by the scan it
            // reads a `last_conf_high` the promotion has not written yet and silently does nothing.
            // 🔴 Mirror of the low side's refused-wick snap (2026-08-21) — see the note there.
            // This side is the `ASH` printed beside an `HH`, and the bogus `HH` that follows once
            // that ASH is broken. Must stay AFTER the promotion, same as the tie guard it replaces.
            if not na(st.last_conf_high_loc) and (highest_val == st.last_conf_high or (highest_val > st.last_conf_high and highest_loc <= st.last_conf_high_loc))
                highest_val := st.last_conf_high
                highest_loc := st.last_conf_high_loc
            st.bear_bos_high  := highest_val
            st.bear_bos_h_loc := highest_loc

            st.ash      := highest_val
            st.ash_loc  := highest_loc
            st.ash_type := ""

            st.pb_mode               := -1
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_extreme            := low
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true

f_pbStruct(int len) =>
    var mtf = MTFStruct.new(length = len)
    var int shifts = 0
    var float sosLvl = na
    float ph = ta.pivothigh(high, len, len)
    float pl = ta.pivotlow(low,  len, len)
    mtf.processMTF(ph, pl)
    if mtf.bull_sos or mtf.bear_sos
        shifts += 1
        sosLvl := mtf.bull_sos ? mtf.bull_bos_high : mtf.bear_bos_low
    [mtf.dir, shifts, sosLvl]

[dirDir,  dirShifts,  dirLvl]  = request.security(syminfo.tickerid, pbDirTf,  f_pbStruct(pbStructLen))
[confDir, confShifts, confLvl] = request.security(syminfo.tickerid, pbConfTf, f_pbStruct(pbStructLen))

bool newConfShift = not na(confShifts) and not na(confShifts[1]) and confShifts > confShifts[1]

[cmpDir, cmpShifts, cmpLvl] = request.security(syminfo.tickerid, sosCmpTf == "Off" ? pbConfTf : sosCmpTf, f_pbStruct(pbStructLen))
bool newCmpShift = sosCmpTf != "Off" and sosCmpTf != pbConfTf and not na(cmpShifts) and not na(cmpShifts[1]) and cmpShifts > cmpShifts[1]

bool inAsia = not na(time("", sessAsia, tzAsia))
bool inLdn  = not na(time("", sessLdn,  tzLdn))
bool inNy   = not na(time("", sessNy,   tzNy))

var float asiaHi = na, var float asiaLo = na
var float ldnHi  = na, var float ldnLo  = na
if inAsia
    asiaHi := (not inAsia[1] or na(asiaHi)) ? high : math.max(asiaHi, high)
    asiaLo := (not inAsia[1] or na(asiaLo)) ? low  : math.min(asiaLo, low)
if inLdn
    ldnHi := (not inLdn[1] or na(ldnHi)) ? high : math.max(ldnHi, high)
    ldnLo := (not inLdn[1] or na(ldnLo)) ? low  : math.min(ldnLo, low)

int  rawSess     = inNy ? 2 : inLdn ? 1 : 0
bool sessTradable = rawSess == 2 ? pbTradeNy : rawSess == 1 ? pbTradeLdn : false
bool newLeg      = rawSess != rawSess[1]

var float  poolHi = na, var float poolLo = na
var int    legId  = 0
if newLeg
    legId += 1
    if rawSess == 1
        poolHi := asiaHi
        poolLo := asiaLo
    else if rawSess == 2
        poolHi := ldnHi
        poolLo := ldnLo
    else
        poolHi := na
        poolLo := na

var bool sweptHi = false, var bool sweptLo = false
var float swpHi = na, var float swpLo = na
var bool confShort = false, var bool confLong = false
var bool tookLeg = false
var int   cfBar = na, var int cfDir = 0, var float cfPx = na
var bool  cfUsed = false
var int   cmBar = na, var int cmDir = 0, var float cmPx = na
if newLeg
    sweptHi   := false
    sweptLo   := false
    swpHi     := na
    swpLo     := na
    confShort := false
    confLong  := false
    tookLeg   := false
    cfBar     := na
    cfDir     := 0
    cfPx      := na
    cfUsed    := false
    cmBar     := na
    cmDir     := 0
    cmPx      := na

if rawSess != 0
    if not na(poolHi) and high > poolHi
        sweptHi := true
        swpHi := na(swpHi) ? high : math.max(swpHi, high)
    if not na(poolLo) and low < poolLo
        sweptLo := true
        swpLo := na(swpLo) ? low : math.min(swpLo, low)

if rawSess != 0 and newCmpShift and na(cmBar) and not na(cmpLvl)
    if sweptHi and cmpDir == -1
        cmBar := bar_index
        cmDir := -1
        cmPx  := cmpLvl
    if sweptLo and cmpDir == 1
        cmBar := bar_index
        cmDir := 1
        cmPx  := cmpLvl

bool inWinLdn  = not na(time("", execWinLdn, tzNy))
bool inWinNy   = not na(time("", execWinNy,  tzNy))
bool inExecWin = not execUseWindows or inWinLdn or inWinNy

f_poiScan(bool untouchedOnly) =>
    var array<float> zTop  = array.new<float>()
    var array<float> zBot  = array.new<float>()
    var array<bool>  zBull = array.new<bool>()
    var array<bool>  zTap  = array.new<bool>()
    var array<int>   zBorn = array.new<int>()
    float thr = timeframe.in_seconds() < 900 ? 0.0 : 0.04
    if barstate.isconfirmed and bar_index >= 2
        bool bull = low > high[2] and (low - high[2]) / high[2] * 100 > thr
        bool bear = high < low[2] and (low[2] - high) / low[2] * 100 > thr
        if bull
            array.push(zTop, low)
            array.push(zBot, high[2])
            array.push(zBull, true)
            array.push(zTap, false)
            array.push(zBorn, bar_index)
        if bear
            array.push(zTop, low[2])
            array.push(zBot, high)
            array.push(zBull, false)
            array.push(zTap, false)
            array.push(zBorn, bar_index)
        while array.size(zTop) > 30
            array.shift(zTop)
            array.shift(zBot)
            array.shift(zBull)
            array.shift(zTap)
            array.shift(zBorn)
        if array.size(zTop) > 0
            for i = array.size(zTop) - 1 to 0
                float t   = array.get(zTop, i)
                float b   = array.get(zBot, i)
                bool  isB = array.get(zBull, i)
                bool  aged = bar_index > array.get(zBorn, i)
                if aged and (isB ? close <= b : close >= t)
                    array.remove(zTop, i)
                    array.remove(zBot, i)
                    array.remove(zBull, i)
                    array.remove(zTap, i)
                    array.remove(zBorn, i)
                else if aged and high >= b and low <= t
                    array.set(zTap, i, true)
    float bullT = na
    float bullB = na
    float bearT = na
    float bearB = na
    bool  bullTapped = false
    bool  bearTapped = false
    if array.size(zTop) > 0
        for i = 0 to array.size(zTop) - 1
            float t = array.get(zTop, i)
            float b = array.get(zBot, i)
            bool ok = not untouchedOnly or not array.get(zTap, i)
            if ok
                if array.get(zBull, i) and t < close
                    if na(bullT) or t > bullT
                        bullT := t
                        bullB := b
                        bullTapped := array.get(zTap, i)
                if not array.get(zBull, i) and b > close
                    if na(bearB) or b < bearB
                        bearT := t
                        bearB := b
                        bearTapped := array.get(zTap, i)
    [bullT, bullB, bearT, bearB, bullTapped, bearTapped]

[poiBullTop, poiBullBot, poiBearTop, poiBearBot, poiBullTap, poiBearTap] = request.security(syminfo.tickerid, pbPoiTf == "Off" ? "5" : pbPoiTf, f_poiScan(pbPoiUntouched))

bool confAtZone = pbRequireConf and pbConfWhen == "At the zone (enter at market)"
bool poiOff     = pbPoiTf == "Off" and pbRequireConf

var float armZTop = na, var float armZBot = na
var int   armDir  = 0
var bool  armTouched = false
if newLeg
    armZTop := na
    armZBot := na
    armDir  := 0
    armTouched := false

if confAtZone and rawSess != 0
    if armDir == 0
        if dirDir == -1 and sweptHi and not na(poiBearTop)
            armZTop := poiBearTop
            armZBot := poiBearBot
            armDir  := -1
        else if dirDir == 1 and sweptLo and not na(poiBullTop)
            armZTop := poiBullTop
            armZBot := poiBullBot
            armDir  := 1
    if not na(armZTop) and high >= armZBot and low <= armZTop
        armTouched := true

if rawSess != 0 and newConfShift and not na(confLvl)
    if sweptHi and confDir == -1
        cfBar := bar_index
        cfDir := -1
        cfPx  := confLvl
    if sweptLo and confDir == 1
        cfBar := bar_index
        cfDir := 1
        cfPx  := confLvl

if rawSess != 0 and newConfShift
    bool placeOk = not confAtZone or armTouched
    if sweptHi and confDir == -1 and placeOk
        confShort := true
        cfUsed := true
    if sweptLo and confDir == 1 and placeOk
        confLong := true
        cfUsed := true

bool confOkShort = pbRequireConf ? confShort : sweptHi
bool confOkLong  = pbRequireConf ? confLong  : sweptLo

f_targets(int dir, float entry, float dist) =>
    float a = dir == 1 ? (execUseTp1 ? pdh : na) : (execUseTp1 ? pdl : na)
    float b = dir == 1 ? (execUseTp2 ? pwh : na) : (execUseTp2 ? pwl : na)
    float minDist = execMinRr * dist
    bool aOk = not na(a) and (dir == 1 ? a - entry >= minDist : entry - a >= minDist)
    bool bOk = not na(b) and (dir == 1 ? b - entry >= minDist : entry - b >= minDist)
    float t1 = na
    float t2 = na
    if execTp1Mode == "Fixed R"
        t1 := dir == 1 ? entry + execTp1R * dist : entry - execTp1R * dist
        float far = na
        if aOk and (dir == 1 ? a > t1 : a < t1)
            far := a
        if bOk and (dir == 1 ? b > t1 : b < t1)
            far := na(far) ? b : (dir == 1 ? math.max(far, b) : math.min(far, b))
        t2 := far
    else if aOk and bOk
        float da = math.abs(a - entry)
        float db = math.abs(b - entry)
        t1 := da <= db ? a : b
        t2 := da <= db ? b : a
        if math.abs(t2 - t1) < dist * 0.25
            t2 := na
    else if aOk
        t1 := a
    else if bOk
        t1 := b
    if na(t1) and execTpFallbackR > 0
        t1 := dir == 1 ? entry + execTpFallbackR * dist : entry - execTpFallbackR * dist
    [t1, t2]

var int   pendDir   = 0
var float pendEntry = na, var float pendStop = na
var float pendT1    = na, var float pendT2   = na
var float pendZTop  = na, var float pendZBot = na
var int   pendBar   = na

var int   posDir    = 0
var float posEntry  = na, var float posStop = na
var float posT1     = na, var float posT2   = na
var float posZTop   = na, var float posZBot = na
var float posDist   = na, var float posQty  = na
var int   posTime   = na
var float pnlAtFill = 0.0
var bool  t1Done    = false
var bool  beShiftDone = false
var float posWorst  = na
var float posBest   = na
var float posStop0  = na

float minStopDist = execMinStopMode == "% of price" ? close * execMinStopVal / 100 : execMinStopMode == "Fixed $" ? execMinStopVal : execMinStopMode == "x ATR(14)" ? (na(atr14) ? 0.0 : atr14 * execMinStopVal) : 0.0

bool justCancelled = false
if pendDir != 0 and strategy.position_size == 0
    bool cTtl  = execCancelBars > 0 and not na(pendBar) and bar_index - pendBar > execCancelBars
    bool cLeg  = newLeg
    bool cFlip = execCancelFlip and (pendDir == -1 ? dirDir != -1 : dirDir != 1)
    bool cOpp  = execCancelFlip and newConfShift and confDir == -pendDir
    bool cWin  = not inExecWin
    if cTtl or cLeg or cFlip or cOpp or cWin
        strategy.cancel(pendDir == -1 ? "PB-S" : "PB-L")
        pendDir := 0
        justCancelled := true

bool flat = strategy.position_size == 0
bool busy = not flat or pendDir != 0 or tookLeg

f_zoneEntry(int dir, float zTop, float zBot) =>
    float prox = dir == 1 ? zTop : zBot
    float dist = dir == 1 ? zBot : zTop
    execZoneEntry == "Proximal edge" ? prox : execZoneEntry == "Distal edge" ? dist : (zTop + zBot) / 2

float sZTop  = poiOff ? na : confAtZone ? (armDir == -1 ? armZTop : na) : poiBearTop
float sZBot  = poiOff ? na : confAtZone ? (armDir == -1 ? armZBot : na) : poiBearBot
float sEntry = poiOff ? close : na(sZTop) ? na : confAtZone ? close : f_zoneEntry(-1, sZTop, sZBot)
float sStop  = poiOff ? (na(swpHi) ? na : swpHi + execSlBufTk * tickSz) : na(sZTop) ? na : (execStopFrom == "The sweep extreme" and not na(swpHi) ? math.max(sZTop, swpHi) : sZTop) + execSlBufTk * tickSz
float sDist  = na(sEntry) or na(sStop) ? na : sStop - sEntry
[sT1, sT2]   = f_targets(-1, nz(sEntry, close), nz(sDist, close * 0.001))

int sBlk = 0
if not pbTradeShorts
    sBlk := 1
else if dirDir != -1
    sBlk := 2
else if rawSess == 0 or not sessTradable
    sBlk := 3
else if not inExecWin
    sBlk := 11
else if not sweptHi
    sBlk := 4
else if not confOkShort
    sBlk := 5
else if na(sEntry) or na(sStop) or (not poiOff and not confAtZone and sEntry <= close)
    sBlk := 6
else if not confAtZone and pbPoiMaxAtr > 0 and not na(atr14) and sEntry - close > pbPoiMaxAtr * atr14
    sBlk := 7
else if na(sDist) or sDist <= 0 or sDist < minStopDist
    sBlk := 8
else if na(sT1)
    sBlk := 9
else if busy
    sBlk := 10

float lZTop  = poiOff ? na : confAtZone ? (armDir == 1 ? armZTop : na) : poiBullTop
float lZBot  = poiOff ? na : confAtZone ? (armDir == 1 ? armZBot : na) : poiBullBot
float lEntry = poiOff ? close : na(lZTop) ? na : confAtZone ? close : f_zoneEntry(1, lZTop, lZBot)
float lStop  = poiOff ? (na(swpLo) ? na : swpLo - execSlBufTk * tickSz) : na(lZBot) ? na : (execStopFrom == "The sweep extreme" and not na(swpLo) ? math.min(lZBot, swpLo) : lZBot) - execSlBufTk * tickSz
float lDist  = na(lEntry) or na(lStop) ? na : lEntry - lStop
[lT1, lT2]   = f_targets(1, nz(lEntry, close), nz(lDist, close * 0.001))

int lBlk = 0
if not pbTradeLongs
    lBlk := 1
else if dirDir != 1
    lBlk := 2
else if rawSess == 0 or not sessTradable
    lBlk := 3
else if not inExecWin
    lBlk := 11
else if not sweptLo
    lBlk := 4
else if not confOkLong
    lBlk := 5
else if na(lEntry) or na(lStop) or (not poiOff and not confAtZone and lEntry >= close)
    lBlk := 6
else if not confAtZone and pbPoiMaxAtr > 0 and not na(atr14) and close - lEntry > pbPoiMaxAtr * atr14
    lBlk := 7
else if na(lDist) or lDist <= 0 or lDist < minStopDist
    lBlk := 8
else if na(lT1)
    lBlk := 9
else if busy
    lBlk := 10

f_blkWhy(int code) =>
    switch code
        1  => "that direction is switched off"
        2  => "the direction timeframe is not on this side"
        3  => "outside a session that trades"
        4  => "the previous session's level has not been taken"
        5  => "no change of character on the confirmation timeframe yet"
        6  => "There is no untouched gap left on this side of price."
        7  => "The gap is further from price than your max-distance filter allows."
        8  => "Price reached the gap, but it is too thin — the stop it needs is under your minimum-stop floor."
        9  => "Price reached the gap, but no target was far enough away to be worth the risk."
        10 => "You were already in a trade, already had an order waiting, or had already traded this session."
        11 => "outside the execution hours"
        => ""

bool armShort = sBlk == 0
bool armLong  = lBlk == 0

f_qty(float dist) =>
    execSizeMode == "Fixed contracts" ? execFixedQty : dist > 0 ? (strategy.equity * execRiskPct / 100) / dist : 0.0

if armShort
    float q = f_qty(sDist)
    if q > 0
        if confAtZone or poiOff
            strategy.entry("PB-S", strategy.short, qty = q)
        else
            strategy.entry("PB-S", strategy.short, qty = q, limit = sEntry)
        pendDir   := -1
        pendEntry := sEntry
        pendStop  := sStop
        pendT1    := sT1
        pendT2    := sT2
        pendZTop  := sZTop
        pendZBot  := sZBot
        pendBar   := bar_index

if armLong and pendDir == 0
    float q = f_qty(lDist)
    if q > 0
        if confAtZone or poiOff
            strategy.entry("PB-L", strategy.long, qty = q)
        else
            strategy.entry("PB-L", strategy.long, qty = q, limit = lEntry)
        pendDir   := 1
        pendEntry := lEntry
        pendStop  := lStop
        pendT1    := lT1
        pendT2    := lT2
        pendZTop  := lZTop
        pendZBot  := lZBot
        pendBar   := bar_index

bool justFilled = strategy.position_size != 0 and strategy.position_size[1] == 0
bool justClosed = strategy.position_size == 0 and strategy.position_size[1] != 0

if justFilled
    posDir    := strategy.position_size > 0 ? 1 : -1
    posEntry  := strategy.opentrades.entry_price(strategy.opentrades - 1)
    posStop   := pendStop
    posT1     := pendT1
    posT2     := pendT2
    posZTop   := pendZTop
    posZBot   := pendZBot
    posQty    := math.abs(strategy.position_size)
    posDist   := math.abs(posStop - posEntry)
    posTime   := time
    pnlAtFill := strategy.netprofit
    t1Done    := false
    beShiftDone := false
    tookLeg   := true
    posWorst  := posEntry
    posBest   := posEntry
    posStop0  := pendStop
    pendDir   := 0

if strategy.position_size != 0 and not na(posWorst)
    posWorst := posDir == 1 ? math.min(posWorst, low)  : math.max(posWorst, high)
    posBest  := posDir == 1 ? math.max(posBest, high)  : math.min(posBest,  low)

if strategy.position_size != 0 and strategy.position_size[1] != 0 and not t1Done and not na(posT1)
    if posDir == 1 ? high >= posT1 : low <= posT1
        t1Done := true
        if execBeAtTp1
            posStop := posDir == 1 ? math.max(posStop, posEntry + execBeBufTk * tickSz) : math.min(posStop, posEntry - execBeBufTk * tickSz)

if execBeOnShift and strategy.position_size != 0 and strategy.position_size[1] != 0 and not beShiftDone
    if newConfShift and confDir == -posDir
        beShiftDone := true
        posStop := posDir == 1 ? math.max(posStop, posEntry + execBeBufTk * tickSz) : math.min(posStop, posEntry - execBeBufTk * tickSz)

bool twoLegs  = not na(posT2) and execTp1Pct > 0 and execTp1Pct < 100
float runTgt  = twoLegs ? posT2 : posT1
bool  timeUp  = execTimeStopHrs > 0 and not t1Done and not na(posTime) and time - posTime >= execTimeStopHrs * 3600000

if strategy.position_size > 0
    if twoLegs and not t1Done
        strategy.exit("L-TP1", from_entry = "PB-L", qty_percent = execTp1Pct, limit = posT1, stop = posStop)
    strategy.exit("L-RUN", from_entry = "PB-L", limit = runTgt, stop = posStop)
    if timeUp
        strategy.close("PB-L", comment = "time stop")

if strategy.position_size < 0
    if twoLegs and not t1Done
        strategy.exit("S-TP1", from_entry = "PB-S", qty_percent = execTp1Pct, limit = posT1, stop = posStop)
    strategy.exit("S-RUN", from_entry = "PB-S", limit = runTgt, stop = posStop)
    if timeUp
        strategy.close("PB-S", comment = "time stop")

float closedR = na
if justClosed
    float pnl = strategy.netprofit - pnlAtFill
    float riskUsd = posDist * posQty
    closedR := riskUsd > 0 ? pnl / riskUsd : na

type SessBox
    box   bx     = na
    float hi     = na
    float lo     = na
    bool  active = false

f_sessDraw(SessBox s, bool inSess, color col) =>
    if inSess
        if not s.active
            s.active := true
            s.hi     := high
            s.lo     := low
            s.bx     := box.new(bar_index, high, bar_index, low, bgcolor = col, border_color = color.new(col, 40), border_width = 1, border_style = line.style_dotted)
        else
            s.hi := math.max(s.hi, high)
            s.lo := math.min(s.lo, low)
        box.set_right(s.bx, bar_index)
        box.set_top(s.bx, s.hi)
        box.set_bottom(s.bx, s.lo)
    else
        s.active := false
    int _r = 0

var SessBox sbAsia = SessBox.new()
var SessBox sbLdn  = SessBox.new()
var SessBox sbNy   = SessBox.new()
if pbShowSess and timeframe.isintraday
    f_sessDraw(sbAsia, inAsia, SESS_ASIA)
    f_sessDraw(sbLdn,  inLdn,  SESS_LDN)
    f_sessDraw(sbNy,   inNy,   SESS_NY)

plot(newLeg or rawSess == 0 ? na : poolHi, "Pool high", color = POS_REDB,   style = plot.style_linebr, linewidth = 1)
plot(newLeg or rawSess == 0 ? na : poolLo, "Pool low",  color = POS_GREENB, style = plot.style_linebr, linewidth = 1)

var box   curBox = na
var line  curEnt = na
var line  curStp = na
var line  curT1  = na
var line  curT2  = na
var box   pDD   = na
var box   pRan  = na
var box   pGot  = na
var line  pEnt  = na
var line  pExt  = na
var line  pSl   = na
var label pLbl  = na
bool armedNow   = pendDir != 0 and pendBar == bar_index
bool armedShort = armedNow and pendDir == -1
if showSetups and armedNow
    float zt = pendZTop
    float zb = pendZBot
    curBox := na(zt) or na(zb) ? box(na) : box.new(bar_index, math.max(zt, zb), bar_index + 12, math.min(zt, zb), border_color = color(na), bgcolor = FVG_ZONE)
    curEnt := line.new(bar_index, pendEntry, bar_index + 12, pendEntry, color = POS_OPENL, style = line.style_dashed, width = 1)
    curStp := line.new(bar_index, pendStop,  bar_index + 12, pendStop,  color = POS_REDB,  style = line.style_solid, width = 1)
    curT1  := na(pendT1) ? line(na) : line.new(bar_index, pendT1, bar_index + 12, pendT1, color = TP_ANNOT, style = line.style_solid,  width = 1)
    curT2  := na(pendT2) ? line(na) : line.new(bar_index, pendT2, bar_index + 12, pendT2, color = TP_ANNOT, style = line.style_dotted, width = 1)

if showSetups and justFilled
    if not na(curT1)
        line.set_x1(curT1, bar_index)
    if not na(curT2)
        line.set_x1(curT2, bar_index)

if showSetups and (pendDir != 0 or strategy.position_size != 0) and not na(curEnt)
    if not na(curBox)
        box.set_right(curBox, bar_index)
    line.set_x2(curEnt, bar_index)
    line.set_x2(curStp, bar_index)
    if not na(curT1)
        line.set_x2(curT1, bar_index)
    if not na(curT2)
        line.set_x2(curT2, bar_index)
    if strategy.position_size != 0 and not na(posStop)
        line.set_y1(curStp, posStop)
        line.set_y2(curStp, posStop)

if showSetups and justClosed and not na(curEnt)
    if not na(curBox)
        box.set_right(curBox, bar_index)
    line.set_x2(curEnt, bar_index)
    line.set_x2(curStp, bar_index)
    if not na(curT1)
        line.set_x2(curT1, bar_index)
    if not na(curT2)
        line.set_x2(curT2, bar_index)

if showSetups and justCancelled and not na(curEnt)
    if not na(curBox)
        box.set_bgcolor(curBox, FVG_DEAD)
    line.set_color(curEnt, POS_OPENL)
    line.set_color(curStp, POS_OPENL)
    if not na(curT1)
        line.set_color(curT1, POS_OPENL)
    if not na(curT2)
        line.set_color(curT2, POS_OPENL)
    label.new(bar_index, na(curBox) ? line.get_y1(curEnt) : curBox.get_top(), "✕", style = label.style_label_down, color = POS_OPEN, textcolor = TXT_DARK, size = size.tiny, tooltip = "This setup armed and the order was pulled before it filled.\nIt is NOT the trade drawn near it.")

if execShowPosBox and justFilled and not na(posEntry)
    pRan  := box.new(bar_index, posEntry, bar_index, posEntry, border_color = color(na), bgcolor = POS_OPENBG)
    pDD   := box.new(bar_index, posEntry, bar_index, posEntry, border_color = color(na), bgcolor = POS_DD)
    pGot  := box(na)
    pEnt  := line.new(bar_index, posEntry, bar_index, posEntry, color = POS_OPENL, width = 1)
    pSl   := na(posStop0) ? line(na) : line.new(bar_index, posStop0, bar_index, posStop0, color = POS_REDB, style = line.style_dashed, width = 1)
    pExt  := line(na)
    pLbl  := label(na)

if execShowPosBox and strategy.position_size != 0 and not na(pRan)
    box.set_right(pRan, bar_index)
    box.set_right(pDD,  bar_index)
    box.set_top(pRan,    math.max(posEntry, nz(posBest,  posEntry)))
    box.set_bottom(pRan, math.min(posEntry, nz(posBest,  posEntry)))
    box.set_top(pDD,     math.max(posEntry, nz(posWorst, posEntry)))
    box.set_bottom(pDD,  math.min(posEntry, nz(posWorst, posEntry)))
    line.set_x2(pEnt, bar_index)
    if not na(pSl)
        line.set_x2(pSl, bar_index)

if execShowPosBox and justClosed and not na(pRan)
    float exitPx = strategy.closedtrades > 0 ? strategy.closedtrades.exit_price(strategy.closedtrades - 1) : close
    bool  won    = not na(closedR) and closedR > execBeBandR
    bool  be     = not na(closedR) and math.abs(closedR) <= execBeBandR
    color exCol  = be ? POS_BEL : won ? POS_WINL : POS_LOSSL
    float best   = nz(posBest,  posEntry)
    float worst  = nz(posWorst, posEntry)

    box.set_right(pRan, bar_index)
    box.set_right(pDD,  bar_index)
    box.set_bgcolor(pRan, POS_G2)
    box.set_top(pRan,    math.max(posEntry, best))
    box.set_bottom(pRan, math.min(posEntry, best))
    box.set_top(pDD,     math.max(posEntry, worst))
    box.set_bottom(pDD,  math.min(posEntry, worst))

    if posDir == 1 ? exitPx > posEntry : exitPx < posEntry
        pGot := box.new(line.get_x1(pEnt), math.max(posEntry, exitPx), bar_index, math.min(posEntry, exitPx), border_color = color(na), bgcolor = POS_G1)

    pExt  := line.new(line.get_x1(pEnt), exitPx, bar_index, exitPx, color = exCol, width = 2)
    line.set_width(pEnt, 2)

    if execShowLabels
        int lx = line.get_x1(pEnt)
        label.new(lx, posEntry, "Entry", style = label.style_label_right, color = POS_OPEN,  textcolor = TXT_DARK, size = size.tiny)
        label.new(lx, exitPx,   "Exit",  style = label.style_label_right, color = be ? POS_BE : won ? POS_WIN : POS_LOSS, textcolor = TXT_DARK, size = size.tiny)
        if math.abs(best - posEntry) > tickSz
            label.new(lx, best,  "Furthest", style = label.style_label_right, color = POS_WIN,  textcolor = TXT_DARK, size = size.tiny)
        if math.abs(worst - posEntry) > tickSz
            label.new(lx, worst, "Deepest",  style = label.style_label_right, color = POS_LOSS, textcolor = TXT_DARK, size = size.tiny)
        if not na(posStop0)
            label.new(lx, posStop0, "SL", style = label.style_label_right, color = POS_LOSS, textcolor = TXT_DARK, size = size.tiny)

        int mx = int(math.round((lx + bar_index) / 2.0))
        pLbl := label.new(mx, best, (be ? "Breakeven " : won ? "Won " : "Lost ") + str.tostring(closedR, "#.##") + "R", style = posDir == 1 ? label.style_label_down : label.style_label_up, color = be ? POS_BE : won ? POS_WIN : POS_LOSS, textcolor = TXT_DARK, size = size.small, tooltip = "Entry    " + str.tostring(posEntry, format.mintick) + "\nExit     " + str.tostring(exitPx, format.mintick) + "\nStop     " + str.tostring(posStop0, format.mintick) + "\nFurthest " + str.tostring(best, format.mintick) + "\nDeepest  " + str.tostring(worst, format.mintick) + "\nResult   " + str.tostring(closedR, "#.##") + "R")

var int lastTagKey = -1
int   tagCode  = sBlk >= 6 and sBlk <= 10 ? sBlk : lBlk >= 6 and lBlk <= 10 ? lBlk : 0
bool  tagShort = sBlk >= 6 and sBlk <= 10
float tagEdge  = tagShort ? sEntry : lEntry
float tagZTop  = tagShort ? sZTop : lZTop
float tagZBot  = tagShort ? sZBot : lZBot
float tagStop  = tagShort ? sStop : lStop
float tagDist  = tagShort ? sDist : lDist
bool  tagTap   = confAtZone ? armTouched : (tagShort ? poiBearTap : poiBullTap)
bool  tagFired = false
if showBlockTag and tagCode > 0 and not armedNow and time_close >= timenow - debugDays * 86400000
    int key = legId * 100 + tagCode * 2 + (tagShort ? 1 : 0)
    if key != lastTagKey
        lastTagKey := key
        tagFired := true
        float pad  = na(atr14) ? tickSz * 50 : atr14 * 1.5
        float anch = tagShort ? high + pad : low - pad
        bool  drawZ = showBlockDraw and not na(tagZTop) and not na(tagZBot)
        float aim  = drawZ ? (tagShort ? math.min(tagZTop, tagZBot) : math.max(tagZTop, tagZBot)) : (tagShort ? high : low)
        bool  isMiss = tagCode <= 9
        color tagBg  = isMiss ? MISS_ORN  : BLK_PINK
        color tagLn  = isMiss ? MISS_ORNL : BLK_PINKL
        bool   okDir  = tagShort ? dirDir == -1 : dirDir == 1
        bool   okSwp  = tagShort ? sweptHi : sweptLo
        bool   okConf = tagShort ? confShort : confLong
        int    cfTot = 2 + (pbRequireConf ? 1 : 0) + (poiOff ? 0 : 1)
        int    cfHit = (okDir ? 1 : 0) + (okSwp ? 1 : 0) + (pbRequireConf and okConf ? 1 : 0) + (not poiOff and not isMiss ? 1 : 0)
        string cfMet = str.tostring(cfHit) + " OF " + str.tostring(cfTot)
        string head  = (tagShort ? "▼ SHORT" : "▲ LONG") + " · " + cfMet + (isMiss ? "" : ", NO SLOT")
        if drawZ
            box.new(bar_index, math.max(tagZTop, tagZBot), bar_index + 8, math.min(tagZTop, tagZBot), border_color = FVG_EDGE, border_width = 1, bgcolor = FVG_ZONE)
            line.new(bar_index, tagEdge, bar_index + 8, tagEdge, color = tagBg, style = line.style_dotted, width = 1)
            line.new(bar_index, tagStop, bar_index + 8, tagStop, color = tagLn, style = line.style_dashed, width = 1)
        line.new(bar_index, anch, bar_index, aim, color = tagLn, style = line.style_dotted, width = 1)
        string tipConf = not pbRequireConf ? "\n· Confirmation — not required, you have it switched off" : okConf ? "\n✓ Confirmation — the " + pbConfTf + "-minute changed character" + (na(cfPx) ? "" : " at " + str.tostring(cfPx, format.mintick)) : "\n✗ Confirmation — the " + pbConfTf + "-minute never changed character"
        string tipMet  = (okDir ? "✓" : "✗") + " Direction — the " + pbDirTf + "-minute is on this side\n" + (okSwp ? "✓" : "✗") + " Sweep — the previous session's level was taken" + tipConf + (poiOff ? "\n· Point of interest — not required, you have it switched off" : "\n" + (isMiss ? "✗" : "✓") + " Point of interest — the " + pbPoiTf + "-minute gap")
        bool   hasZone = not na(tagZTop) and not na(tagZBot)
        string tipBusy = strategy.position_size != 0 and not tookLeg ? "A trade from an earlier session was still open, so this setup was refused." : strategy.position_size != 0 ? "This is a SECOND setup on the same session. The trade you can see was already running and holds the only slot, so this one was refused." : pendDir != 0 ? "This is a SECOND setup on the same session. An order from the first one was already waiting, so this one was refused." : "This is a SECOND setup on the same session. The session had already had its trade, so this one was refused."
        string tipWhy  = tagCode == 10 ? tipBusy : poiOff and tagCode == 6 ? "The session never took the previous session's high or low, so there is no sweep extreme to put a stop behind." : not hasZone ? "There was no gap on this side of price." : (tagCode == 7 or tagTap) ? f_blkWhy(tagCode) : "Price never reached the gap. The point of interest was never met."
        string tipFar  = na(tagEdge) ? "" : "\n" + str.tostring(math.abs(close - tagEdge), format.mintick) + " away from price" + (na(atr14) or atr14 <= 0 ? "" : " (" + str.tostring(math.abs(close - tagEdge) / atr14, "#.#") + " average bar ranges)") + "." + (pbPoiMaxAtr > 0 ? "" : "\nYour max-distance filter is OFF, so that distance was never checked.")
        string tipGeom = na(tagStop) or na(tagDist) or na(tagEdge) ? "" : "\n\nTHE TRADE THAT DID NOT HAPPEN\n" + (poiOff ? "You would have gone in at market at " : tagTap ? "Entry would have been " : "Had price reached it: entry ") + str.tostring(tagEdge, format.mintick) + ", stop " + str.tostring(tagStop, format.mintick) + " — " + str.tostring(tagDist, format.mintick) + " apart. Your floor is " + str.tostring(minStopDist, format.mintick) + "."
        string tipGap  = (not hasZone ? "" : "\n\nTHE GAP\n" + str.tostring(math.min(tagZTop, tagZBot), format.mintick) + " to " + str.tostring(math.max(tagZTop, tagZBot), format.mintick) + ", " + str.tostring(math.abs(tagZTop - tagZBot), format.mintick) + " tall." + tipFar) + tipGeom
        label bl = label.new(bar_index, anch, (tagShort ? "▼ " : "▲ ") + (isMiss ? str.tostring(cfHit) + "/" + str.tostring(cfTot) + " MISSED" : "BLOCKED"), style = tagShort ? label.style_label_down : label.style_label_up, color = tagBg, textcolor = TXT_DARK, size = size.small, tooltip = head + "\n──────────────────\n" + tipMet + "\n──────────────────\nWHY THERE WAS NO TRADE\n" + tipWhy + tipGap)

var int cfDrawn = -1
var int cmDrawn = -1
bool sosResolved = justFilled or tagFired
if showSosMark and sosResolved
    float sosPad = na(atr14) ? tickSz * 40 : atr14 * 0.8
    if not na(cfBar) and not na(cfPx) and cfBar != cfDrawn
        cfDrawn := cfBar
        float tip = cfDir == 1 ? cfPx - sosPad : cfPx + sosPad
        line.new(cfBar, cfPx, cfBar + 10, cfPx, color = SOS_CONF, style = line.style_solid, width = 1)
        line.new(cfBar, cfPx, cfBar, tip, color = SOS_CONF, style = line.style_solid, width = 2)
        label.new(cfBar, tip, "SOS " + pbConfTf + "m " + str.tostring(cfPx, format.mintick), style = cfDir == 1 ? label.style_label_up : label.style_label_down, color = SOS_CONF, textcolor = TXT_DARK, size = size.tiny, tooltip = "THIS candle is where the " + pbConfTf + "-minute changed character, by closing through " + str.tostring(cfPx, format.mintick) + ".\n" + (cfUsed ? "It is the shift that confirmed the setup marked nearby." : "It did NOT confirm anything - you have confirmation switched off, or the setup was refused before it mattered. It is the last time this timeframe turned this way after the sweep.") + "\nThe flat line is the level that broke, so a wick cannot confuse it.")
    if not na(cmBar) and not na(cmPx) and cmBar != cmDrawn
        cmDrawn := cmBar
        float tip = cmDir == 1 ? cmPx - sosPad * 2 : cmPx + sosPad * 2
        line.new(cmBar, cmPx, cmBar + 10, cmPx, color = SOS_CMP, style = line.style_dashed, width = 1)
        line.new(cmBar, cmPx, cmBar, tip, color = SOS_CMP, style = line.style_dashed, width = 2)
        label.new(cmBar, tip, "SOS " + sosCmpTf + "m " + str.tostring(cmPx, format.mintick), style = cmDir == 1 ? label.style_label_up : label.style_label_down, color = SOS_CMP, textcolor = TXT_DARK, size = size.tiny, tooltip = "THIS candle is where the " + sosCmpTf + "-minute changed character, by closing through " + str.tostring(cmPx, format.mintick) + " - the first time it turned this way after the sweep.\nMarking only. It changed no trade.")

// ════════════════════════════════════════════════════════════════════════════════════════
// EXPORT TWIN — everything above this line is byte-identical to
// `smc_session_sweep_strategy.pine`. Only this block is added, and it draws nothing: every
// plot is fully transparent and `editable = false`, so the chart is unchanged and these
// series exist only to come out of "Export chart data".
//
// 🔴 THE TWO FILES MOVE TOGETHER OR THE GATE IS COMPARING TWO STRATEGIES. Any edit to the
// parent is copied here in the SAME commit — that is what the editor guard means when it says
// a `.pine` is half of a parity gate.
//
// 🔴 PINE ALLOWS 64 PLOTS PER SCRIPT AND THE PARENT ALREADY SPENDS 2. The first draft of this
// block was 70 and would have failed to compile — a limit you meet on Aaron's screen, not
// here. What got cut is the rule worth keeping: **only things that can MOVE A TRADE are
// exported.** The comparison-timeframe stream (`cmpDir`, `cmpShifts`, `sosCmpTf`), the SOS
// marker price and the confirmation LEVEL are all annotation, so a parity failure over any of
// them would be a failure over a chart drawing. Anything DERIVABLE went too — position size is
// quantity × direction, and the leg id is the `newLeg` bit counted up.
//
// ⚠ A STRING CANNOT CROSS A CSV, so the session and hour windows are exported as the DECISION
// they produced (`inAsia`, `inWinLdn`, …) rather than as their text. That is the better half of
// the trade anyway: the port is gated on what the window DID, not on whether it parses
// "0200-0500" the same way, and a timezone bug then shows up as a disagreeing bit instead of
// hiding behind two strings that match.
// ⚠ TIMEFRAME INPUTS ARE EXPORTED AS NUMBERS, 0 meaning "Off" (`pbPoiTf`).
// ⚠ `execFixedQty` IS ABSENT because a sweep never leaves "Risk % of equity" — `cfg_enum1`
// carries the MODE, so a CSV taken in Fixed-contracts mode is detectable and the harness can
// refuse it rather than silently gate on a size it cannot see.
// ════════════════════════════════════════════════════════════════════════════════════════

color _INV = color.new(color.gray, 100)   // transparent — in the CSV, invisible on the chart

// ── the two structure streams that decide trades. `*_shifts` is a COUNTER, not a flag, and
//    that is load-bearing: a boolean read back through request.security stays true, so "it JUST
//    shifted" is only recoverable by comparing the count with its own previous bar. The port
//    must do the same or it will confirm on every bar after the first.
plot(dirDir,      "px_dir",         _INV, editable = false)
plot(dirShifts,   "px_dir_shifts",  _INV, editable = false)
plot(confDir,     "px_conf_dir",    _INV, editable = false)
plot(confShifts,  "px_conf_shifts", _INV, editable = false)

// ── sessions, the pool, the sweep
plot(rawSess, "px_sess",    _INV, editable = false)
plot(poolHi,  "px_pool_hi", _INV, editable = false)
plot(poolLo,  "px_pool_lo", _INV, editable = false)
plot(swpHi,   "px_swp_hi",  _INV, editable = false)
plot(swpLo,   "px_swp_lo",  _INV, editable = false)
plot((inAsia ? 1 : 0) + (inLdn ? 2 : 0) + (inNy ? 4 : 0) + (sessTradable ? 8 : 0) + (newLeg ? 16 : 0) + (sweptHi ? 32 : 0) + (sweptLo ? 64 : 0) + (confShort ? 128 : 0) + (confLong ? 256 : 0) + (tookLeg ? 512 : 0) + (inWinLdn ? 1024 : 0) + (inWinNy ? 2048 : 0) + (inExecWin ? 4096 : 0) + (newConfShift ? 8192 : 0) + (confAtZone ? 16384 : 0) + (poiOff ? 32768 : 0) + (armTouched ? 65536 : 0) + (busy ? 131072 : 0) + (justCancelled ? 262144 : 0), "px_state", _INV, editable = false)

// ── the point-of-interest scan, with the tap flags the refusal message reads
plot(poiBullTop, "px_poi_bull_t", _INV, editable = false)
plot(poiBullBot, "px_poi_bull_b", _INV, editable = false)
plot(poiBearTop, "px_poi_bear_t", _INV, editable = false)
plot(poiBearBot, "px_poi_bear_b", _INV, editable = false)
plot((poiBullTap ? 1 : 0) + (poiBearTap ? 2 : 0) + (armDir == 1 ? 4 : 0) + (armDir == -1 ? 8 : 0), "px_poi_bits", _INV, editable = false)
plot(armZTop, "px_arm_top", _INV, editable = false)
plot(armZBot, "px_arm_bot", _INV, editable = false)

// ── the geometry BOTH sides would have used, armed or not. Exporting the REFUSED side is the
//    point: a port that agrees on the trades and disagrees on the refusals will diverge the
//    first time an input moves, which is exactly when a sweep is running.
plot(lEntry, "px_ent_l",  _INV, editable = false)
plot(lStop,  "px_stp_l",  _INV, editable = false)
plot(lDist,  "px_dist_l", _INV, editable = false)
plot(lT1,    "px_t1_l",   _INV, editable = false)
plot(lT2,    "px_t2_l",   _INV, editable = false)
plot(sEntry, "px_ent_s",  _INV, editable = false)
plot(sStop,  "px_stp_s",  _INV, editable = false)
plot(sDist,  "px_dist_s", _INV, editable = false)
plot(sT1,    "px_t1_s",   _INV, editable = false)
plot(sT2,    "px_t2_s",   _INV, editable = false)
plot(lBlk,   "px_blk_l",  _INV, editable = false)
plot(sBlk,   "px_blk_s",  _INV, editable = false)
plot(minStopDist, "px_min_stop", _INV, editable = false)

// ── orders and the open position
plot(pendDir, "px_pend_dir", _INV, editable = false)
plot(posDir,  "px_pos_dir",  _INV, editable = false)
plot(strategy.position_size != 0 ? posEntry : na, "px_fill",      _INV, editable = false)
plot(strategy.position_size != 0 ? posStop  : na, "px_stop_live", _INV, editable = false)
plot(strategy.position_size != 0 ? posStop0 : na, "px_sl",        _INV, editable = false)
plot(strategy.position_size != 0 ? posT1    : na, "px_tp1",       _INV, editable = false)
plot(strategy.position_size != 0 ? posT2    : na, "px_tp2",       _INV, editable = false)
plot(strategy.position_size != 0 ? posQty   : na, "px_qty",       _INV, editable = false)
plot((justFilled ? 1 : 0) + (justClosed ? 2 : 0) + (t1Done ? 4 : 0) + (beShiftDone ? 8 : 0) + (twoLegs ? 16 : 0) + (timeUp ? 32 : 0) + (armLong ? 64 : 0) + (armShort ? 128 : 0), "px_exec", _INV, editable = false)
plot(closedR, "px_closed_r", _INV, editable = false)

// ── context the port needs to reproduce the same numbers
plot(atr14, "px_atr14", _INV, editable = false)
plot(pdh,   "px_pdh",   _INV, editable = false)
plot(pdl,   "px_pdl",   _INV, editable = false)
plot(pwh,   "px_pwh",   _INV, editable = false)
plot(pwl,   "px_pwl",   _INV, editable = false)

// ── every input that can move a trade. Display-only toggles are absent on purpose: they cannot
//    change the trade list, so carrying them would invite a parity failure over an annotation.
plot((pbTradeLdn ? 1 : 0) + (pbTradeNy ? 2 : 0) + (pbRequireConf ? 4 : 0) + (pbPoiUntouched ? 8 : 0) + (execUseTp1 ? 16 : 0) + (execUseTp2 ? 32 : 0) + (execBeOnShift ? 64 : 0) + (execUseWindows ? 128 : 0) + (pbTradeLongs ? 256 : 0) + (pbTradeShorts ? 512 : 0) + (execCancelFlip ? 1024 : 0) + (execBeAtTp1 ? 2048 : 0), "cfg_bits", _INV, editable = false)
plot(str.tonumber(pbDirTf),  "cfg_dir_tf",  _INV, editable = false)
plot(str.tonumber(pbConfTf), "cfg_conf_tf", _INV, editable = false)
plot(pbPoiTf == "Off" ? 0.0 : str.tonumber(pbPoiTf), "cfg_poi_tf", _INV, editable = false)
plot((execTp1Mode == "Fixed R" ? 0 : 1)
   + 10 * (execSizeMode == "Risk % of equity" ? 0 : 1)
   + 100 * (pbConfWhen == "Before the zone (rest a limit)" ? 0 : 1)
   + 1000 * (execZoneEntry == "Proximal edge" ? 0 : execZoneEntry == "Midpoint" ? 1 : 2)
   + 10000 * (execStopFrom == "The gap" ? 0 : 1)
   + 100000 * (execMinStopMode == "Off" ? 0 : execMinStopMode == "% of price" ? 1 : execMinStopMode == "Fixed $" ? 2 : 3), "cfg_enum1", _INV, editable = false)
// ⚠ The small INTEGER inputs are packed two to a plot to stay under the 64-plot ceiling. Ranges
//    are bounded by each input's own minval/maxval, so no field can overflow into its neighbour:
//    struct_len ≤ 50, sl_buf ≤ 500, be_buf ≤ 500, tp1_pct ≤ 100, cancel_bars ≤ 2000.
plot(pbStructLen + 100 * execSlBufTk + 100000 * execBeBufTk, "cfg_int1", _INV, editable = false)
plot(execTp1Pct + 1000 * execCancelBars, "cfg_int2", _INV, editable = false)
plot(execTp1R,        "cfg_tp1_r",        _INV, editable = false)
plot(execRiskPct,     "cfg_risk_pct",     _INV, editable = false)
plot(execTpFallbackR, "cfg_tp_fallback",  _INV, editable = false)
plot(execMinRr,       "cfg_min_rr",       _INV, editable = false)
plot(execMinStopVal,  "cfg_min_stop_val", _INV, editable = false)
plot(pbPoiMaxAtr,     "cfg_poi_max_atr",  _INV, editable = false)
plot(execTimeStopHrs, "cfg_time_stop",    _INV, editable = false)
