//@version=6
// [doc 1] Realign — internal-structure realignment after an external false bre  -> docs/realign_strategy.md
strategy("Realign", overlay = true, initial_capital = 10000,
         default_qty_type = strategy.fixed, default_qty_value = 1,
         pyramiding = 0, calc_on_every_tick = false,
         margin_long = 0.2, margin_short = 0.2,
         commission_type = strategy.commission.cash_per_contract, commission_value = 0.0)

// ── THE INPUT PANEL — the repo's numbered contract ───────────────────────────────
// 🔴 BROUGHT ONTO THE CONTRACT 2026-09-16, AND THAT IS A REORDER. TradingView keys a saved
//    chart's input values off DECLARATION ORDER within each type, so moving them RESETS every
//    saved value on any chart already running this script. **Open it and use "Reset settings
//    to defaults" once** — the same treatment every other strategy here needed when it was
//    brought on. Done deliberately BEFORE the first CSV export rather than after, so the
//    export is taken at settings somebody chose rather than at whatever survived the move.
// ⚠ The numbering does not close up. A group this strategy has no use for is simply absent —
//    the NUMBER is the address, so section 6 is Stop & targets in whichever file you open.
var string G2  = "2 · Market structure"
var string G3  = "3 · What trades"
var string G4  = "4 · What arms it"
var string G5  = "5 · Entry"
var string G6  = "6 · Stop & targets"
var string G7  = "7 · Filters"
var string G8  = "8 · Chart annotations"
var string G12 = "12 · Debug"

majorLength = input.int(10, "Structure pivot length", minval = 2, group = G2, tooltip = "Swing detection lookback, on both frames.")

tradeLongs  = input.bool(true,  "Trade longs",  group = G3)
tradeShorts = input.bool(true,  "Trade shorts", group = G3)
riskPct     = input.float(1.0,  "Risk % per trade", minval = 0.01, maxval = 100, group = G3, tooltip = "Percent of equity risked to the stop. Test at 1 - R is scale-free, so the R results come out identical.")

htfTf       = input.timeframe("15", "External timeframe", group = G4, tooltip = "The timeframe the false break is read on. The chart frame is the trigger.")
windowHrs   = input.float(24.0, "Hours the setup stays armed", minval = 0.5, group = G4, tooltip = "How long the setup stays armed after the false break. Chosen, not measured.")

entryMode   = input.string("Market", "Entry", options = ["Market", "Retest"], group = G5, tooltip = "Market takes the close of the bar the realignment confirms on. Retest rests a limit at the level the realignment broke and waits for price to come back to it - a smaller book, entered nearer the stop, paying no entry spread on the way in.")
retestAt    = input.string("Level", "   ↳ Retest price", options = ["Level", "Mid"], group = G5, tooltip = "Level rests at the structure level the realignment broke. Mid rests halfway between the stop and the confirming close. Read only in Retest mode.")
retestBars  = input.int(12, "   ↳ Retest expiry (bars)", minval = 1, group = G5, tooltip = "Cancel an unfilled retest limit after this many bars. It is also cancelled if price reaches the stop first. Read only in Retest mode.")

slBufTk       = input.int(20,    "Stop buffer (ticks)", minval = 0, group = G6, tooltip = "How many ticks beyond the structural low or high the stop sits.")
tp1Pct        = input.float(0,   "TP1 size %", minval = 0, maxval = 100, group = G6, tooltip = "0 banks nothing at the first target but still stages the stop to breakeven when price touches it.")
tp2Pct        = input.float(0,   "TP2 size %", minval = 0, maxval = 100, group = G6, tooltip = "0 banks nothing at the second target but still installs the floor and hands the rest to the trail.")
beBufTk       = input.int(0,     "Breakeven buffer (ticks)", group = G6, tooltip = "Where the stop sits after the first target. Negative gives the trade room below the entry.")
tp2StopMode   = input.string("TP1 price", "Stop floor after TP2", options = ["TP1 price", "Breakeven", "One trail step behind"], group = G6)
runnerTrail   = input.string("Structure + % ratchet", "Runner trail", options = ["Fixed step", "Structure (swing)", "Structure + % ratchet"], group = G6)
trailFrame    = input.string("External", "   ↳ Trail anchor frame", options = ["External", "Chart"], group = G6, tooltip = "Which frame's confirmed swings the runner trail sits behind. WARNING: this file has always used External and the Python port has always used Chart, which is a real divergence found 2026-09-16 and worth tens of R. The input exists so a CSV export can state which one it ran, and the parity gate can settle which is right.")
trailPct      = input.float(1.0, "   ↳ Ratchet step (% of price)", minval = 0.01, group = G6, tooltip = "Read only in Structure + % ratchet mode.")
trailStep     = input.float(1.0, "   ↳ Fixed trail step ($)", minval = 0.01, group = G6, tooltip = "Read only in Fixed step mode.")
structTrailBuf= input.int(20,    "   ↳ Structure trail buffer (ticks)", group = G6)
timeStopMode  = input.string("Before TP1 only", "Time stop", options = ["Off", "Before TP1 only", "Always"], group = G6, tooltip = "Closes a position open this long. Before TP1 never touches a trade that has reached the first target.")
timeStopHrs   = input.float(36.0, "   ↳ Time stop (hours)", minval = 0.5, group = G6)
flatMode      = input.string("Off", "Flat before the close", options = ["Off", "Friday only", "Every day"], group = G6, tooltip = "Close any open trade before the session close. Friday only avoids carrying over the weekend; Every day avoids carrying overnight at all.")
flatMin       = input.int(15, "   ↳ Flat N minutes before the close", minval = 1, group = G6, tooltip = "How long before the session close the position is flattened. Read only when Flat before the close is on.")
closeHrNy     = input.int(17, "   ↳ Daily close hour (New York)", minval = 0, maxval = 23, group = G6, tooltip = "Gold closes 17:00 New York. Changing this moves what Flat before the close means.")

minStopMode = input.string("% of price", "Minimum stop distance", options = ["Off", "% of price", "Fixed $"], group = G7, tooltip = "Refuse a setup whose stop is too close to the entry, which would balloon the position.")
minStopVal  = input.float(0.08, "   ↳ Minimum stop value", minval = 0.0, group = G7, tooltip = "The floor itself - a percent of price or dollars, depending on the mode.")

showMarks     = input.bool(true,  "Mark setups on the chart", group = G8, tooltip = "The trigger triangles and the false-break crosses - the SETUP, not the trade.")
showPosBox    = input.bool(true,  "Show position box (result)", group = G8, tooltip = "One box per trade: how far it ran in your favour, how far it went against you, and where it ended.")
showExcursion = input.bool(true,  "   ↳ Band the excursions (best / worst)", group = G8, tooltip = "Paints the furthest price the trade ever reached either way. Off leaves only the result band.")
showConfLabel = input.bool(true,  "Entry callout, recoloured on close", group = G8, tooltip = "A tag at the fill that turns green, red or orange when the trade closes, with its R.")
labelWhich    = input.string("All", "   ↳ Which callouts to keep", options = ["All", "Wins only", "Losses only", "Losses + breakevens"], group = G8)
beBandR       = input.float(0.1, "   ↳ Breakeven band (R)", minval = 0.0, group = G8, tooltip = "A result inside plus or minus this many R is drawn as BREAKEVEN rather than a win or a loss.")
showBlocked   = input.bool(true,  "Tag refused setups", group = G8, tooltip = "Marks a realignment that fired and was REFUSED, with the reason. This is the only record of a trade the strategy chose not to take.")

showDiag    = input.bool(true, "Diagnostics in the Data Window", group = G12, tooltip = "Running counts of every stage of the setup. Open the Data Window and hover a bar - the first counter reading 0 is where the chain breaks.")

float pbBuffer = 0.0

type MTFStruct
    int    length
    float  ash             = na
    int    ash_loc         = na
    string ash_type        = ""
    float  asl             = na
    int    asl_loc         = na
    string asl_type        = ""
    float  last_conf_high     = na
    int    last_conf_high_loc = na
    float  last_conf_low      = na
    int    last_conf_low_loc  = na
    int    dir            = 0
    bool   choch_lock     = false
    int    pb_mode        = 0
    int    pb_count       = 0
    float  pb_level       = na
    float  pb_extreme     = na
    int    pb_extreme_loc = na
    bool   pb_started     = false
    float  pb_last_qualify_close = na
    float  pb_last_qualify_high  = na
    float  pb_extreme_close      = na
    float  prev_close     = na
    float  prev_high      = na
    float  prev_low       = na
    bool   seeded         = false
    bool   bull_bos       = false
    float  bull_bos_high  = na
    int    bull_bos_h_loc = na
    float  bull_bos_low   = na
    int    bull_bos_l_loc = na
    bool   bear_bos       = false
    float  bear_bos_high  = na
    int    bear_bos_h_loc = na
    float  bear_bos_low   = na
    int    bear_bos_l_loc = na
    bool   new_swing_high = false
    bool   new_swing_low  = false
    bool   bull_sos       = false
    bool   bear_sos       = false

method mtfCreateAsh(MTFStruct st, float val, int loc) =>
    st.ash      := val
    st.ash_loc  := loc
    st.ash_type := ""

method mtfCreateAsl(MTFStruct st, float val, int loc) =>
    st.asl      := val
    st.asl_loc  := loc
    st.asl_type := ""

// Byte-for-byte the state logic of SMCStructure.process(); drawing removed.
method processMTF(MTFStruct st, float ph_val, float pl_val) =>
    st.bull_bos := false
    st.bear_bos := false
    st.new_swing_high := false
    st.new_swing_low  := false
    st.bull_sos := false
    st.bear_sos := false

    bool is_inside = false
    if not na(st.prev_high) and not na(st.prev_low)
        is_inside := high < st.prev_high and low > st.prev_low

    if st.choch_lock
        if st.dir == 1 and not na(pl_val)
            st.choch_lock := false
        else if st.dir == -1 and not na(ph_val)
            st.choch_lock := false

    if st.pb_mode == 1
        if not st.pb_started
            st.pb_started            := true
            st.pb_extreme            := high
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_count              := 0
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
        else
            bool extreme_updated_1 = false
            if na(st.pb_extreme) or high > st.pb_extreme
                st.pb_extreme            := high
                st.pb_extreme_loc        := bar_index
                st.pb_extreme_close      := na
                st.pb_count              := 0
                st.pb_last_qualify_close := na
                st.pb_last_qualify_high  := na
                extreme_updated_1        := true
            bool extreme_is_bearish_1 = extreme_updated_1 and close < open
            bool is_candle1_1 = na(st.pb_last_qualify_close) and not extreme_updated_1
            if (not is_inside or is_candle1_1) and (not extreme_updated_1 or extreme_is_bearish_1)
                float threshold = na(st.pb_last_qualify_high) ? st.pb_extreme : st.pb_last_qualify_high
                if close < threshold - pbBuffer
                    st.pb_count              += 1
                    st.pb_last_qualify_close := close
                    st.pb_last_qualify_high  := low
            if st.pb_count >= 3 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
                st.ash      := st.pb_extreme
                st.ash_loc  := st.pb_extreme_loc
                st.ash_type := "LOCKED"
                st.new_swing_high := true
                st.pb_mode    := 0
                st.pb_count   := 0
                st.choch_lock := false

    else if st.pb_mode == -1
        if not st.pb_started
            st.pb_started            := true
            st.pb_extreme            := low
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_count              := 0
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
        else
            bool extreme_updated_m1 = false
            if na(st.pb_extreme) or low < st.pb_extreme
                st.pb_extreme            := low
                st.pb_extreme_loc        := bar_index
                st.pb_extreme_close      := na
                st.pb_count              := 0
                st.pb_last_qualify_close := na
                st.pb_last_qualify_high  := na
                extreme_updated_m1       := true
            bool extreme_is_bullish_m1 = extreme_updated_m1 and close > open
            bool is_candle1_m1 = na(st.pb_last_qualify_close) and not extreme_updated_m1
            if (not is_inside or is_candle1_m1) and (not extreme_updated_m1 or extreme_is_bullish_m1)
                float threshold = na(st.pb_last_qualify_high) ? st.pb_extreme : st.pb_last_qualify_high
                if close > threshold + pbBuffer
                    st.pb_count              += 1
                    st.pb_last_qualify_close := close
                    st.pb_last_qualify_high  := high
            if st.pb_count >= 3 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
                st.asl      := st.pb_extreme
                st.asl_loc  := st.pb_extreme_loc
                st.asl_type := "LOCKED"
                st.new_swing_low := true
                st.pb_mode    := 0
                st.pb_count   := 0
                st.choch_lock := false

    st.prev_close := close
    st.prev_high  := high
    st.prev_low   := low

    if na(st.ash) and na(st.asl) and not st.seeded
        if not na(ph_val)
            st.mtfCreateAsh(ph_val, bar_index[st.length])
            st.dir := -1
        else if not na(pl_val)
            st.mtfCreateAsl(pl_val, bar_index[st.length])
            st.dir := 1

    if not st.seeded
        if not na(st.ash) and na(st.asl)
            float seed_low = low
            int   seed_loc = bar_index
            int   lb       = math.min(bar_index, 500)
            for i = 0 to lb
                if low[i] < seed_low
                    seed_low := low[i]
                    seed_loc := bar_index - i
            if seed_low < st.ash
                st.asl      := seed_low
                st.asl_loc  := seed_loc
                st.asl_type := ""
                st.seeded := true
        else if not na(st.asl) and na(st.ash)
            float seed_high = high
            int   seed_loc  = bar_index
            int   lb        = math.min(bar_index, 500)
            for i = 0 to lb
                if high[i] > seed_high
                    seed_high := high[i]
                    seed_loc  := bar_index - i
            if seed_high > st.asl
                st.ash      := seed_high
                st.ash_loc  := seed_loc
                st.ash_type := ""
                st.seeded := true
        else if not na(st.ash) and not na(st.asl)
            st.seeded := true

    if na(st.last_conf_high) and na(st.last_conf_low)
        if not na(ph_val) and not na(st.ash) and st.ash_type == "" and st.pb_mode == 0
            if ph_val > st.ash
                st.mtfCreateAsh(ph_val, bar_index[st.length])
        if not na(pl_val) and not na(st.asl) and st.asl_type == "" and st.pb_mode == 0
            if pl_val < st.asl
                st.mtfCreateAsl(pl_val, bar_index[st.length])

    bool ash_broken = not na(st.ash) and close > st.ash
    bool asl_broken = not na(st.asl) and close < st.asl

    if ash_broken
        st.bull_bos := true
        st.bull_bos_high  := st.ash
        st.bull_bos_h_loc := st.ash_loc

        bool was_in_bear_pb = st.pb_mode == -1 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
        st.pb_mode  := 0
        st.pb_count := 0

        bool is_choch = st.dir == -1
        if is_choch
            st.bull_sos := true
            st.choch_lock := true

        st.last_conf_high     := st.ash
        st.last_conf_high_loc := st.ash_loc
        st.ash                := na
        st.dir                := 1

        if was_in_bear_pb
            st.bull_bos_low   := st.pb_extreme
            st.bull_bos_l_loc := st.pb_extreme_loc
            st.asl      := st.pb_extreme
            st.asl_loc  := st.pb_extreme_loc
            st.asl_type := "LOCKED"
            if not is_choch
                st.last_conf_low     := st.pb_extreme
                st.last_conf_low_loc := st.pb_extreme_loc
            st.pb_extreme            := high
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_mode               := 1
            st.pb_started            := true
        else
            if not na(st.asl)
                bool already_conf_low = (st.asl == st.last_conf_low and st.asl_loc == st.last_conf_low_loc)
                if not already_conf_low
                    st.last_conf_low     := st.asl
                    st.last_conf_low_loc := st.asl_loc
                st.asl      := na

            float lowest_val = low
            int   lowest_loc = bar_index
            int   bars_back  = na(st.last_conf_high_loc) ? bar_index : bar_index - st.last_conf_high_loc
            if bars_back > 0
                int max_lb = math.min(math.min(bars_back, 1490), bar_index)
                for i = 0 to max_lb
                    if low[i] < lowest_val
                        lowest_val := low[i]
                        lowest_loc := bar_index - i

            // 🔴 KEEP THE ORIGINAL ANCHOR WHEN TWO BARS TIE FOR THE LOW. The scan above runs
            // newest-to-oldest with a strict `<`, so on an identical low it lands on the LATER bar
            // while this swing's label is already anchored on the EARLIER one — `already_conf_low`
            // compares bar index as well as price, misses, and a SECOND label is drawn at the same
            // price. Pine never deletes those, so they stack (the LL beside an HL, 2026-08-20).
            // Full story + measurements: engines/market_structure/CLAUDE.md -> tied-extreme fix.
            // 🔴 …AND THE SAME SNAP WHEN IT IS MORE EXTREME BUT NOT NEWER — A REFUSED WICK
            // (2026-08-21). Structure BREAKS ON A CLOSE, but this scan reads the raw `low` over a
            // window bounded by `last_conf_high_loc` — the OPPOSITE side — which reaches back BEFORE
            // the swing just confirmed. So it can resurrect a bar that pierced the level, closed back
            // inside and was correctly refused, and install it as the new active swing: EARLIER than
            // and LOWER than the swing just labelled. Full mechanism + the measurements:
            // `indicators/engines/mpc_jarvis.pine`, same block.
            if not na(st.last_conf_low_loc) and (lowest_val == st.last_conf_low or (lowest_val < st.last_conf_low and lowest_loc <= st.last_conf_low_loc))
                lowest_val := st.last_conf_low
                lowest_loc := st.last_conf_low_loc
            st.bull_bos_low   := lowest_val
            st.bull_bos_l_loc := lowest_loc

            st.asl      := lowest_val
            st.asl_loc  := lowest_loc
            st.asl_type := ""

            st.pb_mode               := 1
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_extreme            := high
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true

    else if asl_broken
        st.bear_bos := true
        st.bear_bos_low   := st.asl
        st.bear_bos_l_loc := st.asl_loc

        bool was_in_bull_pb = st.pb_mode == 1 and not na(st.pb_extreme) and not na(st.pb_extreme_loc)
        st.pb_mode  := 0
        st.pb_count := 0

        bool is_choch = st.dir == 1
        if is_choch
            st.bear_sos := true
            st.choch_lock := true

        st.last_conf_low     := st.asl
        st.last_conf_low_loc := st.asl_loc
        st.asl               := na
        st.dir               := -1

        if was_in_bull_pb
            st.bear_bos_high  := st.pb_extreme
            st.bear_bos_h_loc := st.pb_extreme_loc
            st.ash      := st.pb_extreme
            st.ash_loc  := st.pb_extreme_loc
            st.ash_type := "LOCKED"
            if not is_choch
                st.last_conf_high     := st.pb_extreme
                st.last_conf_high_loc := st.pb_extreme_loc
            st.pb_extreme            := low
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_mode               := -1
            st.pb_started            := true
        else
            float highest_val = high
            int   highest_loc = bar_index
            int   bars_back   = na(st.last_conf_low_loc) ? bar_index : bar_index - st.last_conf_low_loc
            if bars_back > 0
                int max_lb = math.min(math.min(bars_back, 1490), bar_index)
                for i = 0 to max_lb
                    if high[i] > highest_val
                        highest_val := high[i]
                        highest_loc := bar_index - i

            if not na(st.ash)
                bool already_conf_high = (st.ash == st.last_conf_high and st.ash_loc == st.last_conf_high_loc)
                if not already_conf_high
                    st.last_conf_high     := st.ash
                    st.last_conf_high_loc := st.ash_loc
                st.ash      := na
            else
                if highest_val != st.last_conf_high
                    st.last_conf_high     := highest_val
                    st.last_conf_high_loc := highest_loc

            // 🔴 Mirror of the low-side tie guard above. This side stacks HH on HH rather than LL on
            // HL, which is why it went unnoticed far longer despite being the MORE common of the two.
            // ⚠ IT MUST SIT HERE, AFTER THE PROMOTION, NOT BESIDE THE SCAN — placed by the scan it
            // reads a `last_conf_high` the promotion has not written yet and silently does nothing.
            // 🔴 Mirror of the low side's refused-wick snap (2026-08-21) — see the note there.
            // This side is the `ASH` printed beside an `HH`, and the bogus `HH` that follows once
            // that ASH is broken. Must stay AFTER the promotion, same as the tie guard it replaces.
            if not na(st.last_conf_high_loc) and (highest_val == st.last_conf_high or (highest_val > st.last_conf_high and highest_loc <= st.last_conf_high_loc))
                highest_val := st.last_conf_high
                highest_loc := st.last_conf_high_loc
            st.bear_bos_high  := highest_val
            st.bear_bos_h_loc := highest_loc

            st.ash      := highest_val
            st.ash_loc  := highest_loc
            st.ash_type := ""

            st.pb_mode               := -1
            st.pb_count              := 0
            st.pb_level              := na
            st.pb_extreme            := low
            st.pb_extreme_loc        := bar_index
            st.pb_extreme_close      := na
            st.pb_last_qualify_close := na
            st.pb_last_qualify_high  := na
            st.pb_started            := true

// [doc 2] THE TWO STRUCTURE READS  -> docs/realign_strategy.md

f_frameStruct(int len) =>
    var MTFStruct st = MTFStruct.new(length = len)
    float ph = ta.pivothigh(high, len, len)
    float pl = ta.pivotlow(low,  len, len)
    st.processMTF(ph, pl)
    // Copied into plain locals FIRST: Pine cannot take the history operator on a UDT
    // field, and the whole point below is to return the PREVIOUS bar's values.
    bool  bb = st.bull_bos
    bool  bs = st.bull_sos
    bool  rb = st.bear_bos
    bool  rs = st.bear_sos
    float ah = st.ash
    float al = st.asl
    float ch = st.last_conf_high
    float cl = st.last_conf_low
    [bb, bs, rb, rs, ah, al, ch, cl]

// [doc 3] The same read, one HTF bar in the PAST. This is the non-repainting idiom  -> docs/realign_strategy.md
f_frameStructPrev(int len) =>
    [bb, bs, rb, rs, ah, al, ch, cl] = f_frameStruct(len)
    [bb[1], bs[1], rb[1], rs[1], ah[1], al[1], ch[1], cl[1]]

// [doc 4] ── the EXTERNAL frame, via security ────────────────────────────────────  -> docs/realign_strategy.md
[hBullBos, hBullSos, hBearBos, hBearSos, hAsh, hAsl, hConfHi, hConfLo] =
     request.security(syminfo.tickerid, htfTf, f_frameStructPrev(majorLength),
                      lookahead = barmerge.lookahead_on)

// [doc 5] A security call REPEATS its value across every chart bar inside one HTF   -> docs/realign_strategy.md
htfStamp  = request.security(syminfo.tickerid, htfTf, time, lookahead = barmerge.lookahead_off)
htfClosed = htfStamp != htfStamp[1]

// ── the CHART frame — the trigger ────────────────────────────────────────────────
var MTFStruct cst = MTFStruct.new(length = majorLength)
float cph = ta.pivothigh(high, majorLength, majorLength)
float cpl = ta.pivotlow(low,  majorLength, majorLength)
cst.processMTF(cph, cpl)

cBullBreak = cst.bull_bos or cst.bull_sos
cBearBreak = cst.bear_bos or cst.bear_sos

// [doc 6] THE SETUP TRACKER  -> docs/realign_strategy.md
var int   htfTrend   = 0        // +1 after a bullish external break, -1 after a bearish one
var bool  armLong    = false
var bool  armShort   = false
var int   armLongMs  = 0
var int   armShortMs = 0
var float tgtLong    = na       // the external high that stood before the deviation
var float tgtShort   = na
var int   stepLong   = 0        // 0 = waiting for the counter break, 1 = waiting for the shift
var int   stepShort  = 0
var float ctrLowL    = na       // extreme since the counter break — the stop
var float ctrHighS   = na
// Display latches. `htfTrend` is UPDATED later in the same bar, so a plot reading it
// would describe the trend the break STARTED rather than the one it ended.
bool markFalseDown = false
bool markFalseUp   = false

if htfClosed
    bool hBull = hBullBos or hBullSos
    bool hBear = hBearBos or hBearSos

    // ARM on a counter-trend SOS that is the first counter break of the trend.
    if hBearSos and htfTrend > 0 and tradeLongs and not na(hAsh)
        armLong       := true
        markFalseDown := true
        armLongMs := time
        tgtLong   := hAsh
        stepLong  := 0
        ctrLowL   := na
    if hBullSos and htfTrend < 0 and tradeShorts and not na(hAsl)
        armShort    := true
        markFalseUp := true
        armShortMs := time
        tgtShort   := hAsl
        stepShort  := 0
        ctrHighS   := na

    // The trend read updates AFTER arming: an SOS both ends the old trend and starts the
    // new one, and the setup is about the trend it ended.
    if hBull
        htfTrend := 1
    else if hBear
        htfTrend := -1

    // A further break AGAINST an armed setup kills it — the deviation has become a trend,
    // which is the one thing this setup bets against.
    if hBearBos and not hBearSos
        armLong := false
    if hBullBos and not hBullSos
        armShort := false

// ── expiry ───────────────────────────────────────────────────────────────────────
int windowMs = int(windowHrs * 3600000)
if armLong and time - armLongMs > windowMs
    armLong := false
if armShort and time - armShortMs > windowMs
    armShort := false

// [doc 7] ── the chart-frame realignment ─────────────────────────────────────────  -> docs/realign_strategy.md
bool trigLong  = false
bool trigShort = false
// The level the REALIGNMENT itself broke, on the bar it fired — the price a retest rests at.
// `na` is a real state: the engine cannot always attribute a break to a stored swing, and a
// retest with no level is REFUSED rather than quietly entered at market.
float trigLvlL = na
float trigLvlS = na

if armLong
    if cBearBreak
        stepLong := 1
        ctrLowL  := low
    else if stepLong == 1
        ctrLowL := na(ctrLowL) ? low : math.min(ctrLowL, low)
    if stepLong == 1 and cst.bull_sos and not na(ctrLowL)
        trigLong := true
        trigLvlL := cst.bull_bos_high

if armShort
    if cBullBreak
        stepShort := 1
        ctrHighS  := high
    else if stepShort == 1
        ctrHighS := na(ctrHighS) ? high : math.max(ctrHighS, high)
    if stepShort == 1 and cst.bear_sos and not na(ctrHighS)
        trigShort := true
        trigLvlS := cst.bear_bos_low

// [doc 8] ENTRY — at MARKET, on the bar the realignment confirms  -> docs/realign_strategy.md

f_minStopOk(float dist, float px) =>
    minStopMode == "Off"        ? true :
     minStopMode == "% of price" ? dist >= px * minStopVal / 100.0 :
     dist >= minStopVal

var float posStop  = na
var float posTp1   = na
var float posTp2   = na
var int   posStage = 0
var int   posMs    = 0
var float posEntry = na
var float trailAnc = na

flat = strategy.position_size == 0

// A resting retest limit: the bar it was placed on, and the levels frozen with it. `na` on
// `pendBar` means nothing is resting. ⚠ Unlike the market entry, placement and FILL are
// different bars, so every level has to be carried rather than read off `close` at the fill.
var int   pendBar   = na
var int   pendDir   = 0
var float pendPx    = na
var float pendSl    = na
var float pendTp1   = na
var float pendTp2   = na

// The refusal record, written where the refusal HAPPENS. See [doc 17].
//   1 stop on the wrong side · 2 minimum stop · 3 target behind entry
//   4 no retest level · 5 retest expired · 6 invalidated before the fill
// ⚠ WRITTEN INLINE, NOT THROUGH A HELPER. A Pine function CANNOT assign to a global, so the
//   obvious `f_refuse(dir, code)` compiles nowhere — it has to be three assignments at the
//   point of refusal. Caught before this reached a chart; left stated so it is not re-tried.
var int refBar  = na
var int refDir  = 0
var int refCode = 0

// The retest price, or `na` when this setup cannot rest one. Long and short mirror exactly.
f_retestPx(int d, float lvl, float ctrExt) =>
    float px = retestAt == "Level" ? lvl : (ctrExt + close) / 2.0
    // A limit at or through the market is not a retest — it would fill on the next bar and
    // quietly become the market entry at a worse price under another name.
    (na(px) or (px - close) * d >= 0) ? na : px

if flat and trigLong and tradeLongs
    float px   = entryMode == "Retest" ? f_retestPx(1, trigLvlL, ctrLowL) : close
    float sl   = ctrLowL - slBufTk * syminfo.mintick
    float dist = px - sl
    int rcL = 0
    if na(px)
        rcL := entryMode == "Retest" ? 4 : 1
    else if dist <= 0
        rcL := 1
    else if not f_minStopOk(dist, px)
        rcL := 2
    else if na(tgtLong) or tgtLong <= px
        rcL := 3
    if rcL != 0
        refBar  := bar_index
        refDir  := 1
        refCode := rcL
    if not na(px) and dist > 0 and f_minStopOk(dist, px) and not na(tgtLong) and tgtLong > px
        float qty = (strategy.equity * riskPct / 100.0) / dist
        float t1  = px + (tgtLong - px) * 0.5
        if entryMode == "Retest"
            strategy.entry("REALIGN L", strategy.long, qty = qty, limit = px)
            pendBar := bar_index
            pendDir := 1
            pendPx  := px
            pendSl  := sl
            pendTp1 := t1
            pendTp2 := tgtLong
        else
            strategy.entry("REALIGN L", strategy.long, qty = qty)
            posStop  := sl
            posTp2   := tgtLong
            posTp1   := t1
            posStage := 0
            posMs    := time
            posEntry := px
            trailAnc := na
        armLong  := false

if flat and trigShort and tradeShorts
    float px   = entryMode == "Retest" ? f_retestPx(-1, trigLvlS, ctrHighS) : close
    float sl   = ctrHighS + slBufTk * syminfo.mintick
    float dist = sl - px
    int rcS = 0
    if na(px)
        rcS := entryMode == "Retest" ? 4 : 1
    else if dist <= 0
        rcS := 1
    else if not f_minStopOk(dist, px)
        rcS := 2
    else if na(tgtShort) or tgtShort >= px
        rcS := 3
    if rcS != 0
        refBar  := bar_index
        refDir  := -1
        refCode := rcS
    if not na(px) and dist > 0 and f_minStopOk(dist, px) and not na(tgtShort) and tgtShort < px
        float qty = (strategy.equity * riskPct / 100.0) / dist
        float t1  = px - (px - tgtShort) * 0.5
        if entryMode == "Retest"
            strategy.entry("REALIGN S", strategy.short, qty = qty, limit = px)
            pendBar := bar_index
            pendDir := -1
            pendPx  := px
            pendSl  := sl
            pendTp1 := t1
            pendTp2 := tgtShort
        else
            strategy.entry("REALIGN S", strategy.short, qty = qty)
            posStop  := sl
            posTp2   := tgtShort
            posTp1   := t1
            posStage := 0
            posMs    := time
            posEntry := px
            trailAnc := na
        armShort := false

// ── the resting retest limit: adopt it on fill, or cancel it ─────────────────────
// 🔴 THE CANCEL IS CHECKED AFTER THE FILL, AND THAT ORDER IS THE CORRECTNESS ARGUMENT.
//    Killing the order on the bar its stop was breached, before that bar could fill it,
//    deletes exactly the trades that would have LOST — price dipping to the limit and
//    carrying on to the stop is a real losing trade — and flatters the result invisibly.
if not na(pendBar)
    if strategy.position_size != 0
        // Filled. Adopt the frozen levels as the open position's.
        posStop  := pendSl
        posTp1   := pendTp1
        posTp2   := pendTp2
        posStage := 0
        posMs    := time
        posEntry := pendPx
        trailAnc := na
        pendBar  := na
    else if bar_index - pendBar >= retestBars or
             (pendDir > 0 ? low <= pendSl : high >= pendSl)
        refBar  := bar_index
        refDir  := pendDir
        refCode := bar_index - pendBar >= retestBars ? 5 : 6
        strategy.cancel("REALIGN L")
        strategy.cancel("REALIGN S")
        pendBar := na

// [doc 9] THE EXIT LADDER  -> docs/realign_strategy.md
isLong  = strategy.position_size > 0
isShort = strategy.position_size < 0
inPos   = isLong or isShort

if inPos
    // ── stage advance ────────────────────────────────────────────────────────────
    if posStage == 0 and ((isLong and high >= posTp1) or (isShort and low <= posTp1))
        posStage := 1
        posStop  := isLong ? posEntry + beBufTk * syminfo.mintick
                           : posEntry - beBufTk * syminfo.mintick
    if posStage == 1 and ((isLong and high >= posTp2) or (isShort and low <= posTp2))
        posStage := 2
        float floorPx = tp2StopMode == "TP1 price" ? posTp1 :
                         tp2StopMode == "Breakeven" ? posEntry :
                         (isLong ? posTp1 - trailStep : posTp1 + trailStep)
        posStop := isLong ? math.max(posStop, floorPx) : math.min(posStop, floorPx)

    // ── the runner trail, past TP2 only ──────────────────────────────────────────
    if posStage == 2
        float cand = na
        if runnerTrail == "Fixed step"
            cand := isLong ? high - trailStep : low + trailStep
        else
            // [doc 10] Structure anchor: a frame's last CONFIRMED swing, buffered.  -> docs/realign_strategy.md
            // 🔴 THE COMMENT HERE READ "the chart frame's" UNTIL 2026-09-16 AND THE CODE HAS
            //    ALWAYS USED THE EXTERNAL FRAME. The Python port was written against the
            //    comment and has always trailed the CHART frame — a real divergence worth
            //    tens of R, found before this file had a parity gate. The frame is now an
            //    input so an export states which one it ran and the gate can settle it.
            float swLo = trailFrame == "Chart" ? cst.last_conf_low  : hConfLo
            float swHi = trailFrame == "Chart" ? cst.last_conf_high : hConfHi
            float anc = isLong ? swLo - structTrailBuf * syminfo.mintick
                               : swHi + structTrailBuf * syminfo.mintick
            cand := anc
            if runnerTrail == "Structure + % ratchet" and not na(anc)
                // Climb one %-of-price step per step of favourable move past the anchor.
                float stepSz = close * trailPct / 100.0
                if stepSz > 0
                    float moved = isLong ? high - anc : anc - low
                    if moved > stepSz
                        float steps = math.floor(moved / stepSz)
                        cand := isLong ? anc + (steps - 1) * stepSz
                                       : anc - (steps - 1) * stepSz
        if not na(cand)
            posStop := isLong ? math.max(posStop, cand) : math.min(posStop, cand)

    // [doc 11] ── the time stop ───────────────────────────────────────────────────────  -> docs/realign_strategy.md
    bool timeOn  = timeStopMode != "Off"
    bool timeOld = (time - posMs) > int(timeStopHrs * 3600000)
    bool timeDue = timeOn and timeOld and (timeStopMode == "Always" or posStage == 0)

    // ── flat before the close ────────────────────────────────────────────────────
    // Minutes until the session close. The minute-of-hour is read off the bar's own time:
    // every New York offset is a whole number of hours, so minutes past the hour are the
    // same in both zones and need no conversion. Only the HOUR needs the NY clock, which
    // `hour(time, "America/New_York")` gives with DST handled.
    int  nyHr    = hour(time, "America/New_York")
    int  minsLeft = (closeHrNy - nyHr) * 60 - minute(time)
    bool inFlatWin = nyHr < closeHrNy and minsLeft > 0 and minsLeft <= flatMin
    // ⚠ Friday is read off the bar's own day in New York, not UTC: the flat window sits at
    //   16:45 NY, which is already the next UTC day in some offsets.
    bool isFri   = dayofweek(time, "America/New_York") == dayofweek.friday
    bool flatDue = inFlatWin and (flatMode == "Every day" or (flatMode == "Friday only" and isFri))

    if timeDue or flatDue
        strategy.close_all(comment = timeDue ? "TIME" : "FLAT")
    else
        float p1 = tp1Pct > 0 ? posTp1 : na
        float p2 = tp2Pct > 0 ? posTp2 : na
        // ⚠ strategy.exit(qty_percent = 0) closes the WHOLE position, so a 0 rung must
        //   skip the call entirely rather than pass a zero through.
        if tp1Pct > 0
            strategy.exit("X1", limit = p1, stop = posStop, qty_percent = tp1Pct)
        if tp2Pct > 0
            strategy.exit("X2", limit = p2, stop = posStop, qty_percent = tp2Pct)
        strategy.exit("XR", stop = posStop)

// ── TRADE ANNOTATIONS ────────────────────────────────────────────────────────────
// The repo-standard layer, and it was MISSING from this file entirely until 2026-09-16 —
// six runs of measurements existed before anything drew a trade on the chart. Every colour
// is copied from `sos_fade_strategy.pine`, which is the standard; none is re-picked here.
// Contract: `strategies/tradingview/CLAUDE.md` -> PHASE 1 and THE ANNOTATION PALETTE.
color POS_RED    = color.new(#EF5350, 62)
color POS_OPEN   = color.new(#787B86, 80)
color POS_ORANGE = color.new(#FF9800, 0)
color POS_GREENB = color.new(#26A69A, 0)   // solid borders so even a thin box is visible
color POS_REDB   = color.new(#EF5350, 0)
color POS_G3     = color.new(#26A69A, 82)  // faintest reward green — the favourable excursion
color POS_DD     = color.new(#EF5350, 88)  // drawdown: behind everything, barely there

type PosBox
    box   bx        = na
    int   dir       = 0
    int   entryBar  = na
    float entry     = na
    float sl        = na
    float worst     = na
    float best      = na
    float openNet   = na
    line  ln        = na
    label lb        = na
    string head     = ""

var PosBox pbx = PosBox.new()

// The trade's own risk in dollars, frozen at the fill — the denominator of its R. Without it
// the callout can only report a dollar amount, which says nothing on a compounding account.
var float openRiskUsd = na

if strategy.position_size != 0 and strategy.position_size[1] == 0
    pbx.dir      := strategy.position_size > 0 ? 1 : -1
    pbx.entryBar := bar_index
    pbx.entry    := posEntry
    pbx.sl       := posStop
    pbx.worst    := pbx.dir > 0 ? low : high
    pbx.best     := pbx.dir > 0 ? high : low
    pbx.openNet  := strategy.netprofit
    openRiskUsd  := math.abs(posEntry - posStop) * math.abs(strategy.position_size) * syminfo.pointvalue
    // [doc 14] The callout opens GREY — the result is not known yet, and colouring it now  -> docs/realign_strategy.md
    if showConfLabel
        float off = ta.atr(14) * 0.6
        float ly  = pbx.dir > 0 ? low - off : high + off
        pbx.head  := pbx.dir > 0 ? "▲ LONG" : "▼ SHORT"
        pbx.ln    := line.new(bar_index, posEntry, bar_index, ly, color = color.new(#787B86, 0), width = 1)
        pbx.lb    := label.new(bar_index, ly, pbx.head, color = color.new(#787B86, 12),
                               textcolor = color.new(#101014, 0),
                               style = pbx.dir > 0 ? label.style_label_up : label.style_label_down,
                               size = size.small)
    if showPosBox
        pbx.bx := box.new(bar_index, math.max(posEntry, close), bar_index, math.min(posEntry, close),
                          bgcolor = POS_OPEN, border_color = color.new(#787B86, 0), border_width = 1)

// While open: grow the box and track BOTH extremes. `best` is the answer to "how far did it
// actually go", which no other drawing on this chart carries.
if strategy.position_size != 0 and pbx.dir != 0
    pbx.worst := pbx.dir > 0 ? math.min(pbx.worst, low)  : math.max(pbx.worst, high)
    pbx.best  := pbx.dir > 0 ? math.max(pbx.best, high) : math.min(pbx.best, low)
    if not na(pbx.bx)
        box.set_right(pbx.bx, bar_index)
        box.set_top(pbx.bx, math.max(pbx.entry, close))
        box.set_bottom(pbx.bx, math.min(pbx.entry, close))

// [doc 15] Closed this bar: grade it in R, recolour the callout, paint the bands.  -> docs/realign_strategy.md
if strategy.position_size == 0 and strategy.position_size[1] != 0 and pbx.dir != 0
    float net = strategy.netprofit - pbx.openNet
    float tradeR = na(openRiskUsd) or openRiskUsd <= 0 ? na : net / openRiskUsd
    int   xr  = bar_index
    if not na(pbx.bx)
        box.delete(pbx.bx)
        pbx.bx := na
    if showPosBox
        // Excursions first, so the result band sits on top of them.
        if showExcursion
            if pbx.dir > 0 ? pbx.worst < pbx.entry : pbx.worst > pbx.entry
                box.new(pbx.entryBar, math.max(pbx.entry, pbx.worst), xr, math.min(pbx.entry, pbx.worst),
                        bgcolor = POS_DD, border_color = color(na))
            if pbx.dir > 0 ? pbx.best > pbx.entry : pbx.best < pbx.entry
                box.new(pbx.entryBar, math.max(pbx.entry, pbx.best), xr, math.min(pbx.entry, pbx.best),
                        bgcolor = POS_G3, border_color = color(na))
        // The RESULT itself. ⚠ This fork banks nothing at its rungs (TP1/TP2 default 0%), so
        //   there are no partial fills to band — every trade ends on the trail, the time stop
        //   or the flat. The result is therefore one band, not a stack.
        bool beRes = not na(tradeR) and math.abs(tradeR) <= beBandR
        if beRes
            line.new(pbx.entryBar, pbx.entry, xr, pbx.entry, color = POS_ORANGE, width = 2)
        else if net < 0
            box.new(pbx.entryBar, math.max(pbx.entry, close), xr, math.min(pbx.entry, close),
                    bgcolor = POS_RED, border_color = POS_REDB)
        else
            box.new(pbx.entryBar, math.max(pbx.entry, close), xr, math.min(pbx.entry, close),
                    bgcolor = color.new(#26A69A, 62), border_color = POS_GREENB)
    if not na(pbx.lb)
        bool   be   = not na(tradeR) and math.abs(tradeR) <= beBandR
        bool   won  = not be and net > 0
        string res  = be ? "BREAKEVEN" : won ? "WIN" : "LOSS"
        bool   keep = labelWhich == "All" or (labelWhich == "Wins only" and won)
                       or (labelWhich == "Losses only" and not won and not be)
                       or (labelWhich == "Losses + breakevens" and not won)
        if keep
            string txt = pbx.head + "  ·  " + res
                          + (na(tradeR) ? "" : "  " + (tradeR >= 0 ? "+" : "") + str.tostring(tradeR, "#.##") + "R")
            label.set_text(pbx.lb, txt)
            label.set_tooltip(pbx.lb, txt + "\nbest " + str.tostring(pbx.best, format.mintick)
                              + "  ·  worst " + str.tostring(pbx.worst, format.mintick))
            label.set_color(pbx.lb, be ? color.new(#FF9800, 12) : won ? color.new(#26A69A, 12) : color.new(#EF5350, 12))
            line.set_color(pbx.ln, be ? color.new(#FF9800, 0) : won ? color.new(#26A69A, 0) : color.new(#EF5350, 0))
        else
            label.delete(pbx.lb)
            line.delete(pbx.ln)
        pbx.lb := na
        pbx.ln := na
    pbx.dir     := 0
    openRiskUsd := na

// [doc 16] Entry triangles. plotshape is GLOBAL SCOPE, so the test is written out here  -> docs/realign_strategy.md
// ⚠ NOT redundant with the box: a scratch paints a band a few pixels tall and reads as no
//   trade at all, which is exactly when you need to see where it opened.
plotshape(showPosBox and strategy.position_size > 0 and strategy.position_size[1] <= 0, title = "Long entry",
          style = shape.triangleup, location = location.belowbar, color = POS_GREENB, size = size.small)
plotshape(showPosBox and strategy.position_size < 0 and strategy.position_size[1] >= 0, title = "Short entry",
          style = shape.triangledown, location = location.abovebar, color = POS_REDB, size = size.small)

// [doc 17] ── REFUSED SETUPS — the only record of a trade the strategy chose not to take  -> docs/realign_strategy.md
// 🔴 THE SIDE AND THE REASON ARE RECORDED AT DECISION TIME, NEVER RE-DERIVED. `d_strategy.pine`
//    already paid for that lesson: its tag read direction off the SOS on the same bar, which
//    was correct only while every candidate arrived on one, and the day a second entry mode
//    existed every candidate drew as a SHORT. `refCode`/`refDir` are written where the refusal
//    happens, so the tag and the reason can never tell different stories.
if showBlocked and refBar == bar_index and refDir != 0
    // ⚠ THE CONTINUATION LINES ARE INDENTED 17, NOT 16, AND THAT IS NOT A TYPO. Pine treats an
    //   indent that is a MULTIPLE OF FOUR as the start of a new block, so a wrapped expression
    //   lined up on 16 is read as a statement and the compiler reports the previous line as
    //   ending without a continuation. Any non-multiple of four works; every other wrapped
    //   expression in this file already sits on 5, 14, 23 or 26 for the same reason.
    string why = refCode == 1 ? "stop on the wrong side"
                 : refCode == 2 ? "stop too tight (minimum stop)"
                 : refCode == 3 ? "target already behind the entry"
                 : refCode == 4 ? "no retest level to rest at"
                 : refCode == 5 ? "retest limit expired unfilled"
                 : "invalidated before the fill"
    label.new(bar_index, refDir > 0 ? low : high,
              "REFUSED", tooltip = (refDir > 0 ? "▲ LONG" : "▼ SHORT") + " refused · " + why,
              color = color.new(#E040FB, 12), textcolor = color.new(#101014, 0),
              style = refDir > 0 ? label.style_label_up : label.style_label_down, size = size.tiny)

// [doc 12] DIAGNOSTICS  -> docs/realign_strategy.md
var int nHtfClose = 0
var int nHtfBreak = 0
var int nBullSos  = 0
var int nBearSos  = 0
var int nArmLong  = 0
var int nArmShort = 0
var int nCtrBreak = 0
var int nTrig     = 0
var int nEntry    = 0

if htfClosed
    nHtfClose += 1
    if hBullBos or hBullSos or hBearBos or hBearSos
        nHtfBreak += 1
    if hBullSos
        nBullSos += 1
    if hBearSos
        nBearSos += 1
if markFalseDown
    nArmLong += 1
if markFalseUp
    nArmShort += 1
if (armLong or armShort) and (cBullBreak or cBearBreak)
    nCtrBreak += 1
if trigLong or trigShort
    nTrig += 1
if inPos and not inPos[1]
    nEntry += 1

plot(showDiag ? nHtfClose : na, "1 HTF bars closed",  display = display.data_window)
plot(showDiag ? nHtfBreak : na, "2 HTF breaks seen",  display = display.data_window)
plot(showDiag ? nBullSos  : na, "3 HTF bull SOS",     display = display.data_window)
plot(showDiag ? nBearSos  : na, "4 HTF bear SOS",     display = display.data_window)
plot(showDiag ? nArmLong  : na, "5 armed LONG",       display = display.data_window)
plot(showDiag ? nArmShort : na, "6 armed SHORT",      display = display.data_window)
plot(showDiag ? nCtrBreak : na, "7 chart breaks while armed", display = display.data_window)
plot(showDiag ? nTrig     : na, "8 TRIGGERS",         display = display.data_window)
plot(showDiag ? nEntry    : na, "9 ENTRIES",          display = display.data_window)
plot(showDiag ? htfTrend  : na, "  htfTrend now",     display = display.data_window)

// [doc 13] MARKS  -> docs/realign_strategy.md
plotshape(showMarks and trigLong,  title = "Realign long",  style = shape.triangleup,
          location = location.belowbar, color = color.new(color.teal, 0), size = size.tiny)
plotshape(showMarks and trigShort, title = "Realign short", style = shape.triangledown,
          location = location.abovebar, color = color.new(color.red, 0),  size = size.tiny)
plotshape(showMarks and markFalseDown, title = "False break down",
          style = shape.xcross, location = location.abovebar, color = color.new(color.orange, 0), size = size.tiny)
plotshape(showMarks and markFalseUp, title = "False break up",
          style = shape.xcross, location = location.belowbar, color = color.new(color.orange, 0), size = size.tiny)
plot(inPos ? posStop : na, title = "Stop", color = color.new(color.red, 0), style = plot.style_linebr)
plot(inPos and posStage < 2 ? posTp2 : na, title = "Target", color = color.new(color.teal, 0), style = plot.style_linebr)
