// [doc 170] EQ/FVG COUPLING (2026-08-06) — `eqExemptFvg`. A gap sitting on an active  -> docs/sos_fade_strategy.md
plot(eqExemptFvg ? 1 : 0,  "cfg_eq_exempt", _INV, editable = false)

// [doc 179] SCALE-IN (2026-08-17) — four columns, because a trade-affecting input with no  -> docs/sos_fade_strategy.md
plot(execScaleIn ? 1 : 0,                        "cfg_scale_in",   _INV, editable = false)
plot(execScaleMode == "Trail" ? 0 : 1,           "cfg_scale_mode", _INV, editable = false)
plot(execScaleAdds,                              "cfg_scale_adds", _INV, editable = false)
plot(execScaleCapX,                              "cfg_scale_cap",  _INV, editable = false)
// [doc 183] ...and a FIFTH, for where the adds bank. Same reason as the four above:
// a trade-affecting input with no cfg_ column is invisible to compare_strategy.py BY
// CONSTRUCTION -- the gate does not go quiet, it goes WRONG, comparing two runs it
// believes are configured the same.
plot(execScaleTpMode == "Ride" ? 0 : execScaleTpMode == "Prev week H/L" ? 1 : execScaleTpMode == "Prev day H/L" ? 2 : 3, "cfg_scale_tp", _INV, editable = false)

// [doc 171] DIAGNOSTIC (temporary — pins the SOS Fade Stage-1 arming gap vs the Python bot  -> docs/sos_fade_strategy.md
