# =============================================================
# Python
# =============================================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# =============================================================
# Models and large binaries
# =============================================================
*.pkl
*.pickle

# =============================================================
# Virtual environments / Node
# =============================================================
.venv/
venv/
env/
node_modules/

# The dev-tool venv (ruff), built by scripts/install_dev_tools.sh from requirements-lint.txt.
# Per-machine and reproducible from that pinned file — which is why `.githooks/pre-commit`
# REFUSES when it is missing rather than skipping: a formatter that silently does nothing on
# one clone leaves the repo formatted on one machine and not the other.
.venv-lint/

# =============================================================
# Secrets — never commit
# =============================================================
.env
credentials.json

# =============================================================
# OS / IDE
# =============================================================
.DS_Store
Thumbs.db
.vscode/
.idea/

# =============================================================
# Logs
# =============================================================
*.log

# ...EXCEPT the live bot's archived daily logs, which are the point of the backup rather than
# scratch. `algos/tools/ledger_sync.py` fetches them off the VPS twice a day, and this `*.log`
# rule silently swallowed them on the first run: the file was copied down, `git status` did not
# list it because it was ignored, and the sync reported success having committed two of three
# streams. ⚠ Nothing anywhere said a stream was missing — an ignored file and a file that was
# never written look identical from the commit side. The sync now NAMES an ignored fetch, and
# `algos/tests/test_ledger_archive_is_committable.py` fails if this negation is removed.
!algos/ledger_archive/**/*.log

# =============================================================
# Misc artefacts
# =============================================================
*.json.bak

# =============================================================
# Smart Money — pipeline data and generated output
# =============================================================
smart-money/data/raw/
smart-money/data/processed/
smart-money/data/smart_money.db
smart-money/data/smart_money.db-shm
smart-money/data/smart_money.db-wal
smart-money/reports/*
!smart-money/reports/.gitkeep

# run_report.py output — per-run trades.csv / setups.csv, regenerable from the
# cache in minutes. Same character as backtest/cache/: data, not source.
backtest/reports/

# =============================================================
# Command Center — lab runtime files
# DB is created on startup via init_db(); reports are per-run
# output. Neither belongs in version control.
# =============================================================
command-center/backend/data/lab.db
command-center/backend/data/lab.db-shm
command-center/backend/data/lab.db-wal
command-center/backend/data/lab_progress.json
# Derived regime maps - a pure function of the bars and the classifier, both of which
# are in the cache key. Rebuilt on demand; committing it would ship one machine's
# fingerprints and go stale the first time either input moved.
command-center/backend/data/regime_cache/
command-center/backend/lab.db
command-center/backend/lab.db-shm
command-center/backend/lab.db-wal
command-center/backend/reports/lab/

# Per-run parameter blobs, named by a content hash (params_<hash>.json). Runtime scratch
# dropped in the backend root by a lab run — one got swept into a commit by `git add -A` on
# 2026-08-04. Ignored rather than chased: I could not find what writes it, and a file that
# regenerates itself is not worth guessing about, but it is definitely not source.
command-center/backend/params_*.json

# =============================================================
# Algos — VPS-only runtime files
# These live only on the VPS. Never overwrite via git pull.
# (Data-backup-to-GitHub feature removed 2026-06-21.)
# =============================================================

# Live bot state
algos/markets/fx/instances/*/bot_state.json
# Hand-taken snapshots that live beside a bot: a settings file copied before an edit, and a
# position captured before a migration. Kept on the box deliberately — the position one is
# live state and cannot be reproduced from git — but they are not source, so they are not
# tracked and must not sit in `git status` looking like work in progress.
algos/markets/fx/instances/*/*.bak
algos/markets/fx/instances/*/position.*.pre-migrate.json
# A convenience launcher for the LAB data agent, hand-written on the box. Nothing in this
# repo references it and no scheduled task runs it, so it is one person's shortcut rather
# than part of any deployable — a rebuild will not restore it.
start_mt5_agent.bat

# The DEPLOYED CODE SNAPSHOT and its record. `algos/tools/promote.py` copies the strategy,
# engines and backtest trees in here so a running bot stops importing from the repo working
# tree — a `git pull` used to rewrite the code under a live bot and then the version pin
# refused to restart it. This is a per-machine build artefact, reproducible from
# `promoted_commit` in deployed.json, and promoting happens ON the VPS: committing either
# would collide with the next pull, which is what makes a safety mechanism get switched off.
algos/markets/fx/instances/*/deployed/
algos/markets/fx/instances/*/deployed.new/
algos/markets/fx/instances/*/deployed.json

# The LIVE ledger the bot is appending to right now. The archived copy that must survive the
# box is committed by `algos/tools/ledger_sync.py` to `algos/ledger_archive/` instead — a
# separate tree, deliberately.
#
# 🔴 This rule exists because the paragraph above was proven right a second time, by the same
# mechanism, on 2026-08-05. Days 07-31 and 08-04 were committed into this path; the VPS still
# held its own untracked copies (it wrote them), and `git pull` on the VPS aborted with
# *"untracked working tree files would be overwritten by merge"*. Every future pull would have
# needed a manual delete first — on the one box that has to stay current for the watchdog, the
# dead-man's switch and the live loop. **A file the VPS WRITES cannot also be a file git
# DELIVERS.** That is the rule; `deployed/` and this are two instances of it.
algos/markets/fx/instances/*/ledger/

# Watchdog + process runtime state. Written by SYS_MONITOR and the Telegram bot on the
# VPS. Per-machine runtime, never source.
algos/monitor_state.json
algos/stop_suppress.json
algos/*.pid

# Zipped raw logs from SYS_LOGBACKUP. VPS-local housekeeping with a 90-day window — the
# artefact that must survive the box is the LEDGER, and ledger_sync.py commits that.
algos/log_archive/

# Telegram runtime
algos/users.json
algos/telegram_offset.json
algos/telegram_start.json
algos/telegram_monitor_state.json
# What the ledger backup's alarm has already said, so it does not repeat itself hourly.
algos/ledgersync_alert_state.json
# The log reviewer's bookmark. Per-machine runtime state, written on the trading box.
algos/log_review_state.json

# MT5 lock
algos/mt5_connect.lock

# The FLEET HALT switch. Per-machine runtime, and committing it would be the worst possible
# artefact in this repo: `git pull` on the VPS would halt every bot on the box, and `git pull`
# on a Mac would put a halt file in a working tree where nobody would think to look for it.
# It is a decision taken on ONE box at ONE moment, never a fact about the code.
algos/FLEET_HALT

# =============================================================
# TradingView exports — real market data, never committed
# (chart-data exports AND Strategy Tester trade lists). They are
# the INPUT to the parity harnesses, not source.
# =============================================================
*VANTAGE_*.csv
*_Strategy_*_20*.csv
tv-exports/

# Playwright browser-test artifacts (command-center/frontend)
test-results/
playwright-report/

# Linter caches. Machine-local by construction (they key on file mtimes), so a checked-in
# cache is a linter skipping files it has never read on THIS machine.
.eslintcache
node_modules/.cache/

# Playwright MCP browser session scratch (console logs, page snapshots, screenshots)
.playwright-mcp/

# generated intermediate — indicators/strategies/tools/derive_htf_structure.py rebuilds it
indicators/strategies/tools/_derived_structure_15.pine
