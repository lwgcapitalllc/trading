# ============================================================
# VPS-ONLY DATA FILES
# These files exist only on the VPS and must NEVER be
# overwritten by git pull. They are backed up to GitHub
# under backup/ by backup.py — do not track them directly.
# ============================================================

# Single source of truth — live bot state
markets/fx/instances/*/bot_state.json

# Trade histories — AI training data
markets/fx/instances/*/smc_trend_trades.json
markets/fx/instances/*/mean_reversion_trades.json
markets/fx/instances/*/scalper_trades.json
markets/fx/instances/*/fft_trades.json
markets/fx/instances/*/fft_model.pkl
markets/fx/instances/*/smc_trend_model.pkl
markets/fx/instances/*/mean_reversion_model.pkl
markets/fx/instances/*/scalper_model.pkl

# Bot activity logs
markets/fx/instances/*/smc_trend_stdout.log
markets/fx/instances/*/mean_reversion_stdout.log
markets/fx/instances/*/scalper_stdout.log
markets/fx/instances/*/fft_stdout.log
markets/fx/instances/*/*.log

# Telegram runtime files
users.json
telegram_offset.json
telegram_start.json
telegram_monitor_state.json

# MT5 connection lock
mt5_connect.lock

# Credentials (never commit)
credentials.json

# Python cache
__pycache__/
*.pyc
*.pyo

# Mac junk
.DS_Store
