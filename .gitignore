# =============================================================
# Python
# =============================================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# =============================================================
# Models and large binaries
# =============================================================
*.pkl
*.pickle

# =============================================================
# Virtual environments / Node
# =============================================================
.venv/
venv/
env/
node_modules/

# =============================================================
# Secrets — never commit
# =============================================================
.env
credentials.json

# =============================================================
# OS / IDE
# =============================================================
.DS_Store
Thumbs.db
.vscode/
.idea/

# =============================================================
# Logs
# =============================================================
*.log

# =============================================================
# Misc artefacts
# =============================================================
*.json.bak

# =============================================================
# Smart Money — pipeline data and generated output
# =============================================================
smart-money/data/raw/
smart-money/data/processed/
smart-money/data/smart_money.db
smart-money/data/smart_money.db-shm
smart-money/data/smart_money.db-wal
smart-money/reports/*
!smart-money/reports/.gitkeep

# =============================================================
# Command Center — lab runtime files
# DB is created on startup via init_db(); reports are per-run
# output. Neither belongs in version control.
# =============================================================
command-center/backend/data/lab.db
command-center/backend/data/lab.db-shm
command-center/backend/data/lab.db-wal
command-center/backend/data/lab_progress.json
command-center/backend/lab.db
command-center/backend/lab.db-shm
command-center/backend/lab.db-wal
command-center/backend/reports/lab/

# =============================================================
# Algos — VPS-only runtime files
# These live only on the VPS and are backed up to the
# `backups` branch via backup.py. Never overwrite via git pull.
# =============================================================

# Algo backup snapshots (backups branch only)
algos/backup/

# Live bot state
algos/markets/fx/instances/*/bot_state.json

# Trade histories
algos/markets/fx/instances/*/smc_trend_trades.json
algos/markets/fx/instances/*/mean_reversion_trades.json
algos/markets/fx/instances/*/scalper_trades.json
algos/markets/fx/instances/*/fft_trades.json

# Equity curves and daily/weekly performance
algos/markets/fx/instances/*/gold_main_equity.json
algos/markets/fx/instances/*/scalper_equity.json
algos/markets/fx/instances/*/fft_equity.json
algos/markets/fx/instances/*/smc_trend_daily.json
algos/markets/fx/instances/*/mean_reversion_daily.json
algos/markets/fx/instances/*/fft_daily.json
algos/markets/fx/instances/*/smc_trend_weekly.json
algos/markets/fx/instances/*/mean_reversion_weekly.json
algos/markets/fx/instances/*/fft_weekly.json

# Telegram runtime
algos/users.json
algos/telegram_offset.json
algos/telegram_start.json
algos/telegram_monitor_state.json

# MT5 lock
algos/mt5_connect.lock
