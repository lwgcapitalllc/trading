<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Author>fxut9200941\trader</Author>
    <URI>\SYS_LEDGERSYNC</URI>
    <Description>Commit and push the bots' decision record to GitHub, hourly. The box owns its own backup; the Mac no longer pushes.</Description>
  </RegistrationInfo>
  <Principals>
    <Principal id="Author">
      <UserId>S-1-5-18</UserId>
      <RunLevel>HighestAvailable</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <!-- A hard ceiling, not a formality. This job shells out to git, and git on this box under
         SYSTEM is exactly what used to BLOCK forever on a credential prompt. `ledger_sync.py`
         disables the credential helper so it cannot happen, and this is the backstop if some
         future git call finds a way to wait on something anyway. -->
    <ExecutionTimeLimit>PT10M</ExecutionTimeLimit>
    <!-- Hourly runs and a slow push must never stack up: a second copy mid-rebase would fight
         the first over the same working tree. -->
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <StartWhenAvailable>true</StartWhenAvailable>
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
  </Settings>
  <Triggers>
    <CalendarTrigger>
      <!-- :20 past, deliberately clear of the other jobs. SYS_LOGBACKUP runs at 00:30 and prunes
           and zips the same files this reads; overlapping them would have one job copying what
           the other is rewriting. -->
      <StartBoundary>2026-01-01T00:20:00</StartBoundary>
      <ScheduleByDay><DaysInterval>1</DaysInterval></ScheduleByDay>
      <Repetition>
        <Interval>PT1H</Interval>
        <Duration>P1D</Duration>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
    </CalendarTrigger>
  </Triggers>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Users\Administrator\AppData\Local\Programs\Python\Python311\python.exe</Command>
      <Arguments>C:\trading\algos\tools\ledger_sync.py --local --alert-on-failure</Arguments>
      <WorkingDirectory>C:\trading</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
