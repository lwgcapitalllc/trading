#!/usr/bin/env bash
#
# Refuse a commit that changes code without touching the CLAUDE.md that owns it.
#
# Why this exists: two people work on this repo from two machines, and the CLAUDE.md
# files are how each of them (and Claude) learns what the other did. A code change
# whose doc never landed is invisible on the other machine until it bites.
#
# The rule: for every changed file, walk UP from its folder to the first CLAUDE.md.
# That file is the owner. It has to be in the same commit.
#
# The escape valve is a LINE IN THE COMMIT MESSAGE, not a flag, so a skip is
# recorded in the history where the other person can read it:
#
#     DOCS: none - typo in a comment, no behaviour change
#
# `git commit --no-verify` also bypasses it and leaves no trace. Don't use it.
#
# Installed by ./go, or by scripts/install_hooks.sh — both just point
# core.hooksPath at this folder, so the hook is versioned like any other file.

set -u

MSG_FILE="$1"
ROOT="$(git rev-parse --show-toplevel)"
GIT_DIR="$(git rev-parse --git-dir)"

# ── Cases that are not somebody writing code ──────────────────────────────────
# A merge, a rebase or a revert carries somebody else's change; asking for a doc
# update there would ask for the same paragraph twice.
if [ -f "$GIT_DIR/MERGE_HEAD" ] || [ -d "$GIT_DIR/rebase-merge" ] || [ -d "$GIT_DIR/rebase-apply" ]; then
  exit 0
fi
if grep -qE '^(Merge |Revert |fixup!|squash!)' "$MSG_FILE"; then
  exit 0
fi

# ── What changed ──────────────────────────────────────────────────────────────
STAGED="$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMRD)"
[ -z "$STAGED" ] && exit 0

# Files that carry no doc obligation of their own.
is_exempt() {
  case "$1" in
    *.meta.json)                                    return 1 ;;  # a real contract, not data
    *.md|*.markdown)                                return 0 ;;  # docs ARE the update
    .gitignore|.gitattributes|*/.gitignore)         return 0 ;;
    *.lock|package-lock.json|yarn.lock|poetry.lock) return 0 ;;
    *.png|*.jpg|*.jpeg|*.gif|*.ico|*.pdf|*.webp)    return 0 ;;
    *.csv|*.parquet|*.db|*.sqlite|*.sqlite3|*.pkl)  return 0 ;;
    .claude/settings.local.json)                    return 0 ;;  # per-machine
    # A live bot's daily record — three per-day files, all RECORDED data of the same character
    # as the .csv above, all committed UNATTENDED by `algos/tools/ledger_sync.py` every 12
    # hours. Without these the backup of the one artefact that must survive the VPS cannot be
    # committed at all.
    #
    # 🔴 This has now bitten TWICE, and the second time is the instructive one. 2026-08-05
    # morning: the sync refused with a day outstanding, and `decisions-` was exempted. The same
    # afternoon the record was split into two streams and the text log went per-day — **and the
    # sync broke again on the first run**, because an exemption enumerates the shapes that
    # existed when it was written. ⚠ **A rule that fires on a robot's commit has no human to
    # read its message: it does not nag, it silently stops the job.** Any new per-day artefact
    # the sync commits has to be added HERE, in the same change.
    #
    # Deliberately PATHS, not `*.jsonl` / `*.log`: those extensions are generic and a future
    # file holding a contract would be waved through, while these shapes can only ever be this.
    */ledger/decisions-*.jsonl)                     return 0 ;;
    */ledger/health-*.jsonl)                        return 0 ;;
    */ledger_archive/*/*-[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].log) return 0 ;;
  esac
  return 1
}

# ── Proof: a change to the money paths has to name its evidence ───────────────
#
# Why this exists: the doc check above proves somebody WROTE something down. It does not
# prove anybody CHECKED anything. The repo's expensive mistakes all shipped with docs and
# green tests - a 54.82-lot order on a $2,000 account, a bot re-anchoring its sizing to a
# stranger's balance, an 82-combination sweep from a port whose parity gate had never run.
#
# So for the paths where a wrong number costs money rather than time, the commit message has
# to name the evidence. One line. It is not graded - the point is that you had to type what
# you actually ran, which is the moment you notice you ran nothing.
#
#     MEASURED: cost_tiers.py, 155,531 M15 bars - ECN 157 trades / +151.39R
#     TESTED:   9 new tests in test_account_identity.py, 5 watched red against HEAD
#     PROOF: none - renamed a local variable, no behaviour change
#
# Deliberately NARROW. A hook that nags on every UI tweak is a hook people learn to bypass,
# and `--no-verify` leaves no trace at all. If you widen it, widen it for a reason you can
# name, and expect the nag to cost you more than the paths you added are worth.
needs_proof() {
  case "$1" in
    engines/*)                 return 0 ;;  # canonical shared libraries - a change moves every consumer
    strategies/*)              return 0 ;;  # what a bot actually trades
    algos/live/*)              return 0 ;;  # the live loop and the order bridge
    algos/shared/*)            return 0 ;;  # order sizing, mt5_ops, account risk
    backtest/*)                return 0 ;;  # fills, costs, replay - decides what every number MEANS
    indicators/*.pine)         return 0 ;;  # the other half of every parity gate
  esac
  return 1
}

PROOF_FILES=""
while IFS= read -r f; do
  [ -z "$f" ] && continue
  is_exempt "$f" && continue
  needs_proof "$f" && PROOF_FILES="$PROOF_FILES$f
"
done <<EOF
$STAGED
EOF

if [ -n "$PROOF_FILES" ]; then
  # A reason of at least ten characters, so the line cannot decay into a rubber stamp -
  # the same shape as the DOCS: none override below.
  if ! grep -qiE '^[[:space:]]*(MEASURED|TESTED|PROOF:[[:space:]]*none)[[:space:]]*[-—:,][[:space:]]*[^[:space:]].{9,}' "$MSG_FILE"; then
    echo ""
    echo "  COMMIT REFUSED - this touches a path where a wrong number costs money,"
    echo "  and the message does not say what you checked."
    echo ""
    printf '%s\n' "$PROOF_FILES" | grep -v '^$' | head -6 | sed 's/^/      /'
    n="$(printf '%s\n' "$PROOF_FILES" | grep -cv '^$')"
    [ "$n" -gt 6 ] && echo "      ... and $((n - 6)) more"
    echo ""
    echo "  Add ONE line to the commit message naming your evidence:"
    echo ""
    echo "      MEASURED: <command, sample size, result>"
    echo "      TESTED:   <how many tests, how many watched RED against HEAD>"
    echo ""
    echo "  A test you have not watched fail proves nothing - run /prove."
    echo "  A number you have not replayed is a guess - run /measure."
    echo ""
    echo "  If this genuinely needs no evidence, say why:"
    echo ""
    echo "      PROOF: none - <reason>"
    echo ""
    exit 1
  fi
fi

# ── The honest override ───────────────────────────────────────────────────────
# `DOCS: none - <reason>`. The reason is required and has to say something, so the
# line cannot decay into a rubber stamp.
if grep -qiE '^[[:space:]]*DOCS:[[:space:]]*none' "$MSG_FILE"; then
  if grep -qiE '^[[:space:]]*DOCS:[[:space:]]*none[[:space:]]*[-—:,][[:space:]]*[^[:space:]].{9,}' "$MSG_FILE"; then
    exit 0
  fi
  echo ""
  echo "  The DOCS: none line needs a reason of its own - at least ten characters."
  echo ""
  echo "      DOCS: none - <why this change needs no CLAUDE.md update>"
  echo ""
  exit 1
fi

# The CLAUDE.md that owns a path: the nearest one walking up to the repo root.
owner_of() {
  d="$(dirname "$1")"
  while :; do
    if [ "$d" = "." ] || [ "$d" = "/" ] || [ -z "$d" ]; then
      echo "CLAUDE.md"
      return
    fi
    if [ -f "$ROOT/$d/CLAUDE.md" ]; then
      echo "$d/CLAUDE.md"
      return
    fi
    d="$(dirname "$d")"
  done
}

# ── Pair every changed file with its owner ────────────────────────────────────
PAIRS=""
while IFS= read -r f; do
  [ -z "$f" ] && continue
  is_exempt "$f" && continue
  PAIRS="$PAIRS$(owner_of "$f")	$f
"
done <<EOF
$STAGED
EOF

[ -z "$PAIRS" ] && exit 0

# Owners not present in this same commit.
MISSING="$(printf '%s' "$PAIRS" | cut -f1 | sort -u | while IFS= read -r owner; do
  printf '%s\n' "$STAGED" | grep -qxF "$owner" || printf '%s\n' "$owner"
done)"

[ -z "$MISSING" ] && exit 0

# ── Refuse, and say exactly which file to open ────────────────────────────────
echo ""
echo "  COMMIT REFUSED - code changed, its CLAUDE.md did not."
echo ""
printf '%s\n' "$MISSING" | while IFS= read -r owner; do
  [ -z "$owner" ] && continue
  files="$(printf '%s' "$PAIRS" | awk -F'\t' -v o="$owner" '$1 == o { print $2 }')"
  echo "    $owner"
  printf '%s\n' "$files" | head -4 | sed 's/^/        /'
  n="$(printf '%s\n' "$files" | wc -l | tr -d ' ')"
  [ "$n" -gt 4 ] && echo "        ... and $((n - 4)) more"
  echo ""
done
echo "  Open the file(s) above, write what this change DID and why it matters to"
echo "  the next person, git add them, and commit again. A line added only to get"
echo "  past this check is worse than nothing - it reads as documented."
echo ""
echo "  If this change genuinely needs no doc update, say so in the message:"
echo ""
echo "      DOCS: none - <reason>"
echo ""

exit 1
