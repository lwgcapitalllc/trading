#!/usr/bin/env bash
#
# Lint and format check before anything leaves this machine. **NOT the test suite.**
#
# 🔴 **THE SUITE USED TO BE HERE AND WAS REMOVED ON 2026-08-14, DELIBERATELY.** MEASURED: 4:21 for
# `engines backtest algos strategies smart-money` (1,725 tests) plus 2:17 for the command-center
# backend (1,014) — ~7 minutes on every push. Aaron's call, and the reasoning is the same one that
# kept the suite off `pre-commit` in the first place: a guard that costs seven minutes is a guard
# people route around, and `LWG_SKIP_TESTS=1` on every push is indistinguishable from having no
# gate while reading like one.
#
# ⚠ **SO NOTHING IN THIS REPO RUNS THE TESTS AUTOMATICALLY ANY MORE. `scripts/run_all_tests.sh`
# still exists and is still the one command; it is now a thing a PERSON runs.** That is a real
# loss and it is stated here rather than left for the next reader to discover: a broken suite can
# now reach `main` and the first person to notice is whoever pulls it. If that happens twice, the
# answer is a faster suite (the three parts are independent and could run concurrently; the root
# suite is single-core on a 12-core box), not a slower hook.
#
# What is left is genuinely worth its ~seconds: `pre-commit` only ever sees STAGED files, so a
# commit made with `--no-verify`, a rebase that resurrected an old file, or an edit from another
# tool can all reach a branch unformatted. This is the repo-wide sweep that catches them.
#
# 🔴 **IT SKIPS A PUSH THAT CARRIES NO CODE, AND THAT IS NOT AN OPTIMISATION.**
# `algos/tools/ledger_sync.py` runs UNATTENDED twice a day on the Mac and pushes the live bot's
# decision record — the only copy of what the bot decided, including every setup it refused, and
# no broker statement contains it. It stages only `algos/ledger_archive/**/*.jsonl` and `*.log`.
# **A rule that fires on a robot's push has no human to read its message**; the docs half of
# `commit-msg` learned that twice (root CLAUDE.md, 2026-08-05) and this hook was built knowing it.
#
# The trigger is therefore POSITIVE — run only when the push carries something a linter reads —
# rather than a list of things to ignore. A new data format added tomorrow is skipped by default,
# which is the safe direction.
#
# Deliberate skip, when you know what you are doing and are prepared to say so:
#
#     LWG_SKIP_PREPUSH=1 git push          (LWG_SKIP_TESTS=1 still works — it is what is in
#                                           everyone's muscle memory and in the docs)
#
# It prints a loud line. There is no silent version on purpose.

set -u

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

REMOTE_SHA_ZERO="0000000000000000000000000000000000000000"
RUFF=".venv-lint/bin/ruff"

# ── The deliberate escape ─────────────────────────────────────────────────────
if [ "${LWG_SKIP_PREPUSH:-}" = "1" ] || [ "${LWG_SKIP_TESTS:-}" = "1" ]; then
  echo ""
  echo "  ⚠ Skipping the pre-push lint/format check."
  echo "    Nothing recorded this anywhere. Say so to whoever pulls it."
  echo ""
  exit 0
fi

# ── What is actually being pushed ─────────────────────────────────────────────
# git feeds pre-push lines of: <local ref> <local sha> <remote ref> <remote sha>
CHANGED=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  # A branch being DELETED pushes an all-zero local sha. There is no tree to check.
  [ "$local_sha" = "$REMOTE_SHA_ZERO" ] && continue

  if [ "$remote_sha" = "$REMOTE_SHA_ZERO" ]; then
    # A brand-new branch on the remote. Diff against whatever the remote already has rather than
    # against the empty tree, or the first push of a branch checks the entire repo's history.
    RANGE="$(git rev-list "$local_sha" --not --remotes | tail -1)"
    if [ -n "$RANGE" ]; then
      FILES="$(git diff --name-only "$RANGE^" "$local_sha" 2>/dev/null || git show --name-only --format= "$local_sha")"
    else
      FILES=""
    fi
  else
    FILES="$(git diff --name-only "$remote_sha" "$local_sha")"
  fi
  CHANGED="$CHANGED
$FILES"
done

# Nothing to push (git still runs the hook for an up-to-date push).
if [ -z "$(printf '%s' "$CHANGED" | tr -d '[:space:]')" ]; then
  exit 0
fi

# ── Does any of it reach a linter? ────────────────────────────────────────────
# ⚠ Narrower than the old test trigger ON PURPOSE: only the languages ruff and prettier actually
# read. A `.pine` or `.mq5` change has no linter here, so it is not a reason to sweep the repo.
PY="$(printf '%s\n' "$CHANGED" | grep -Ei '\.py$' || true)"
FE="$(printf '%s\n' "$CHANGED" | grep -Ei '\.(ts|tsx|css|scss|html|ya?ml)$' \
      | grep -vEi '\.jsonl$' || true)"

if [ -z "$PY" ] && [ -z "$FE" ]; then
  echo "  pre-push: nothing here a linter reads (data, docs or Pine only) - skipping."
  exit 0
fi

FAILED=""
fail() { FAILED="$FAILED
    $1"; }

# ── Python: ruff, repo-wide ───────────────────────────────────────────────────
# ⚠ Repo-wide rather than push-scoped, and it is cheap enough to be: ruff is a Rust binary and
# clears 628 files in about a second. The whole point is catching a file the STAGED-only
# pre-commit never saw.
if [ -n "$PY" ]; then
  if [ ! -x "$RUFF" ]; then
    echo "  pre-push: ruff is not installed - run ./scripts/install_dev_tools.sh"
    exit 1
  fi
  "$RUFF" format --check . >/dev/null 2>&1 || fail "ruff format --check ."
  "$RUFF" check . >/dev/null 2>&1 || fail "ruff check ."
fi

# ── Frontend: prettier + eslint, both CACHED ──────────────────────────────────
# 🔴 **THE CACHE IS WHAT MAKES THIS HOOK SURVIVABLE, AND IT IS ALL ESLINT.** MEASURED 2026-08-14:
# ruff clears all 628 python files in **0.2s**, prettier takes **6.4s**, and eslint takes
# **28s** — 70% of the whole hook — because `typescript-eslint` is type-aware and builds the TS
# program before it can lint a line. With `--cache` that is **1.9s** warm. ⚠ The first run after
# a `git pull` that touched the frontend pays the full 27s again; that is the cache doing its job,
# not a fault.
# ⚠ Both cache files are git-ignored. A cache checked in would be a cache from another machine's
# file mtimes, i.e. a linter that skips files it has never read.
if [ -n "$FE" ] && [ -d "command-center/frontend/node_modules" ]; then
  npx --no-install prettier --cache --check 'command-center/frontend/**/*.{ts,tsx,css,html}' \
      >/dev/null 2>&1 || fail "prettier --check (command-center/frontend)"
  npx --no-install eslint --cache --cache-location .eslintcache \
      'command-center/frontend/**/*.{ts,tsx}' \
      >/dev/null 2>&1 || fail "eslint (command-center/frontend)"
fi

if [ -n "$FAILED" ]; then
  echo ""
  echo "  PUSH REFUSED - a lint or format check failed:"
  printf '%s\n' "$FAILED"
  echo ""
  echo "  Fix it:"
  echo ""
  echo "      $RUFF format . && $RUFF check --fix ."
  echo "      npx prettier --write 'command-center/frontend/**/*.{ts,tsx,css,html}'"
  echo "      npx eslint --fix 'command-center/frontend/**/*.{ts,tsx}'"
  echo ""
  echo "  Or push deliberately and say so:  LWG_SKIP_PREPUSH=1 git push"
  echo ""
  exit 1
fi

echo "  pre-push: lint and format clean."
echo ""
echo "  ⚠ TESTS ARE NOT RUN BY ANY HOOK. Before you push something that matters:"
echo "      ./scripts/run_all_tests.sh"
echo ""
exit 0
