{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "d=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [ -n \"$d\" ] && [ -f \"$d/.claude/hooks/guard_sensitive_paths.py\" ] && python3 \"$d/.claude/hooks/guard_sensitive_paths.py\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "d=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [ -n \"$d\" ] && [ -f \"$d/.claude/hooks/guard_sensitive_paths.py\" ] && python3 \"$d/.claude/hooks/guard_sensitive_paths.py\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [ -n \"$d\" ] && [ -x \"$d/scripts/install_hooks.sh\" ] && \"$d/scripts/install_hooks.sh\" --quiet || true",
            "timeout": 15,
            "statusMessage": "Checking git hooks"
          }
        ]
      }
    ]
  },
